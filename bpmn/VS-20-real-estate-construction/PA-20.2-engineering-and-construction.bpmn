    <bpmn:process id="W_W225" name="W225. Store Construction Management &amp; Supervision" isExecutable="false">
      <bpmn:documentation>Trigger: Notice to Proceed (NTP) issued to contractor
Frequency: Ongoing per active project
Volume: Typically 5–8 stores under construction simultaneously
Owner: Project Manager (Construction)
Participants: General Contractor, Safety Officer, Quality Inspector
Source: workflow W225 — Store Construction Management &amp; Supervision</bpmn:documentation>
      <bpmn:laneSet id="W225_LaneSet4">
        <bpmn:lane id="W225_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W225_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W225_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W225_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W225_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W225_Lane2" name="Project Mgr">
        <bpmn:flowNodeRef>W225_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W225_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W225_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W225_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W225_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W225_Start5" name="Notice to Proceed (NTP) issued to contractor">
        <bpmn:outgoing>W225_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W225_Task6" name="Mobilization">
        <bpmn:documentation>Step 1: Mobilization: Contractor sets up site office, temporary utilities, and safety fencing
Responsible (R): Contractor
Accountable (A): Project Mgr
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W225_Flow15</bpmn:incoming>
        <bpmn:outgoing>W225_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W225_Task7" name="Execution">
        <bpmn:documentation>Step 2: Execution: Foundation, Framing, Shell, and Interiors per project schedule (Gantt)
Responsible (R): Contractor
Accountable (A): —
Duration: 6–9 months</bpmn:documentation>
        <bpmn:incoming>W225_Flow16</bpmn:incoming>
        <bpmn:outgoing>W225_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W225_Task8" name="Supervision">
        <bpmn:documentation>Step 3: Supervision: Weekly site inspections; progress monitoring vs. milestones
Responsible (R): Project Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W225_Flow17</bpmn:incoming>
        <bpmn:outgoing>W225_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W225_Task9" name="Progress Billing">
        <bpmn:documentation>Step 4: Progress Billing: Contractor submits billing based on percentage of completion (W165 linkage)
Responsible (R): Contractor
Accountable (A): Project Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W225_Flow18</bpmn:incoming>
        <bpmn:outgoing>W225_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W225_Task10" name="Change Orders">
        <bpmn:documentation>Step 5: Change Orders: Review and approve any deviations from original BOQ
Responsible (R): Project Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Ad-hoc</bpmn:documentation>
        <bpmn:incoming>W225_Flow19</bpmn:incoming>
        <bpmn:outgoing>W225_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W225_Task11" name="Safety Audit">
        <bpmn:documentation>Step 6: Safety Audit: Weekly HSE check (W52) to ensure zero-accident site
Responsible (R): Safety Officer
Accountable (A): —
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W225_Flow20</bpmn:incoming>
        <bpmn:outgoing>W225_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W225_End12" name="Complete">
        <bpmn:incoming>W225_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W225_Annotation13">
        <bpmn:text>Controls: - CTL-302 (ensure controlled execution — Engineering &amp; Construction (PA-20.2).) | - operational: Project Manager (Construction) review and approval gate
Owner: Project Manager (Construction)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W225_Assoc14" sourceRef="W225_Annotation13" targetRef="W225_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W225_Flow15" sourceRef="W225_Start5" targetRef="W225_Task6" />
      <bpmn:sequenceFlow id="W225_Flow16" sourceRef="W225_Task6" targetRef="W225_Task7" />
      <bpmn:sequenceFlow id="W225_Flow17" sourceRef="W225_Task7" targetRef="W225_Task8" />
      <bpmn:sequenceFlow id="W225_Flow18" sourceRef="W225_Task8" targetRef="W225_Task9" />
      <bpmn:sequenceFlow id="W225_Flow19" sourceRef="W225_Task9" targetRef="W225_Task10" />
      <bpmn:sequenceFlow id="W225_Flow20" sourceRef="W225_Task10" targetRef="W225_Task11" />
      <bpmn:sequenceFlow id="W225_Flow21" sourceRef="W225_Task11" targetRef="W225_End12" />
    </bpmn:process>
