      <bpmn:sequenceFlow id="W223_Flow17" sourceRef="W223_Task8" targetRef="W223_Task9" />
      <bpmn:sequenceFlow id="W223_Flow18" sourceRef="W223_Task9" targetRef="W223_Task10" />
      <bpmn:sequenceFlow id="W223_Flow19" sourceRef="W223_Task10" targetRef="W223_Task11" />
      <bpmn:sequenceFlow id="W223_Flow20" sourceRef="W223_Task11" targetRef="W223_End12" />
    </bpmn:process>
