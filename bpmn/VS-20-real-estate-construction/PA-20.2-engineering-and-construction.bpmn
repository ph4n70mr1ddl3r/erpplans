        <bpmndi:BPMNShape id="W224_Annotation13_di" bpmnElement="W224_Annotation13"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W224_Flow15_di" bpmnElement="W224_Flow15"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Flow16_di" bpmnElement="W224_Flow16"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Flow17_di" bpmnElement="W224_Flow17"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Flow18_di" bpmnElement="W224_Flow18"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Flow19_di" bpmnElement="W224_Flow19"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Flow20_di" bpmnElement="W224_Flow20"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W224_Assoc14_di" bpmnElement="W224_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
