    <bpmn:process id="W_W226" name="W226. Store Renovation &amp; Retrofitting (CAPEX)" isExecutable="false">
      <bpmn:documentation>Trigger: Facility audit finding; or strategic re-layout (Merchandising)
Frequency: ~5–10 major renovations/year
Volume: HVAC replacement, floor re-tiling, LED conversion
Owner: Maintenance Manager
Participants: Store Manager, Engineering, Finance
Source: workflow W226 — Store Renovation &amp; Retrofitting (CAPEX)</bpmn:documentation>
      <bpmn:laneSet id="W226_LaneSet4">
        <bpmn:lane id="W226_Lane1" name="Maint Mgr">
        <bpmn:flowNodeRef>W226_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W226_Lane2" name="Store Mgr">
        <bpmn:flowNodeRef>W226_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W226_Lane3" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W226_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W226_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W226_Start5" name="Facility audit finding; or strategic re-layout (Merchandising)">
        <bpmn:outgoing>W226_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W226_Task6" name="Scope Definition">
        <bpmn:documentation>Step 1: Scope Definition: Identify required repairs or upgrades; estimate CAPEX budget
Responsible (R): Maint Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W226_Flow17</bpmn:incoming>
        <bpmn:outgoing>W226_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task7" name="Store Manager Sign-off">
        <bpmn:documentation>Step 2: Store Manager Sign-off: Store Manager reviews proposed scope against operational impact (trading hours disruption, customer access, safety zones); confirms go/no-go and preferred execution windows
Responsible (R): Store Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W226_Flow18</bpmn:incoming>
        <bpmn:outgoing>W226_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task8" name="Budget Approval">
        <bpmn:documentation>Step 3: Budget Approval: Submit for CAPEX approval per W21 (Finance)
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W226_Flow19</bpmn:incoming>
        <bpmn:outgoing>W226_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task9" name="Contractor Bidding &amp; Selection">
        <bpmn:documentation>Step 4: Contractor Bidding &amp; Selection: Issue mini-RFP to accredited renovation contractors; evaluate bids per W224 process (abbreviated — 3–5 bidders, 1-week turnaround)
Responsible (R): Maint Mgr
Accountable (A): Procurement
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W226_Flow20</bpmn:incoming>
        <bpmn:outgoing>W226_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task10" name="Phased Execution Plan">
        <bpmn:documentation>Step 5: Phased Execution Plan: Develop phased work schedule that maintains store operating hours; define zones and off-hours work windows (typically 9 PM–6 AM); coordinate with Store Manager on customer impact
Responsible (R): Maint Mgr
Accountable (A): Store Mgr
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W226_Flow21</bpmn:incoming>
        <bpmn:outgoing>W226_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task11" name="Execution">
        <bpmn:documentation>Step 6: Execution: Manage contractors during off-hours to minimize store disruption; daily progress check against phased plan
Responsible (R): Maint Mgr
Accountable (A): Store Mgr
Duration: 2–8 weeks</bpmn:documentation>
        <bpmn:incoming>W226_Flow22</bpmn:incoming>
        <bpmn:outgoing>W226_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task12" name="Punch List Inspection">
        <bpmn:documentation>Step 7: Punch List Inspection: Walk-through of completed work with Store Manager to identify defects, incomplete items, and cleanup requirements; issue punch list to contractor for correction before final handover
Responsible (R): Maint Mgr
Accountable (A): Store Mgr
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W226_Flow23</bpmn:incoming>
        <bpmn:outgoing>W226_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W226_Task13" name="Validation &amp; Close-out">
        <bpmn:documentation>Step 8: Validation &amp; Close-out: Inspect punch list corrections; update Fixed Asset register for &quot;Major Improvement&quot; (W39); close CAPEX project in Finance (W21)
Responsible (R): Maint Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W226_Flow24</bpmn:incoming>
        <bpmn:outgoing>W226_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W226_End14" name="Complete">
        <bpmn:incoming>W226_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W226_Annotation15">
        <bpmn:text>Controls: - CTL-302 (ensure controlled execution — Engineering &amp; Construction (PA-20.2).) | - operational: unknowns: existing building systems may have undocumented modifications
Owner: Maintenance Manager</bpmn:text>
      </bpmn:textAnnotation>
