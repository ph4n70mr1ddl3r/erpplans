      <bpmn:sequenceFlow id="W789_Flow18" sourceRef="W789_Task6" targetRef="W789_Task7" />
      <bpmn:sequenceFlow id="W789_Flow19" sourceRef="W789_Task7" targetRef="W789_Task8" />
      <bpmn:sequenceFlow id="W789_Flow20" sourceRef="W789_Task8" targetRef="W789_Task9" />
