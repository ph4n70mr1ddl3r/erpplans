      <bpmn:sequenceFlow id="W789_Flow22" sourceRef="W789_Task10" targetRef="W789_Task11" />
      <bpmn:sequenceFlow id="W789_Flow23" sourceRef="W789_Task11" targetRef="W789_Task12" />
      <bpmn:sequenceFlow id="W789_Flow24" sourceRef="W789_Task12" targetRef="W789_End13" />
    </bpmn:process>
