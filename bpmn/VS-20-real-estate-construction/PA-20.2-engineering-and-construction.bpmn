    <bpmn:process id="W_W227" name="W227. Commissioning &amp; Operational Handover" isExecutable="false">
      <bpmn:documentation>Trigger: Construction completion (95%)
Frequency: Per new store
Volume: All new facilities
Owner: Store Manager (incoming)
Participants: Engineering, Store Ops, IT, HR, Marketing
Source: workflow W227 — Commissioning &amp; Operational Handover</bpmn:documentation>
      <bpmn:laneSet id="W227_LaneSet6">
        <bpmn:lane id="W227_Lane1" name="Project Mgr">
        <bpmn:flowNodeRef>W227_Task8</bpmn:flowNodeRef>
