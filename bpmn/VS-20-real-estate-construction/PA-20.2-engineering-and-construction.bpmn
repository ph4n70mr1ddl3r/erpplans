    <bpmn:process id="W_W789" name="W789. Construction Safety Management &amp; DOLE DO 13 Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Notice to Proceed (NTP) issued to contractor for new store construction or major renovation
Frequency: Per active construction project (5-8 concurrent)
Volume: 10-15 construction projects/year; each project requires continuous safety management
Owner: Construction Safety Officer
Participants: General Contractor Safety Officer, Project Manager, DOLE, Store Safety Officer (for renovations)
Source: workflow W789 — Construction Safety Management &amp; DOLE DO 13 Compliance</bpmn:documentation>
      <bpmn:laneSet id="W789_LaneSet3">
        <bpmn:lane id="W789_Lane1" name="Contractor Safety Officer">
        <bpmn:flowNodeRef>W789_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W789_Lane2" name="Construction Safety Officer">
        <bpmn:flowNodeRef>W789_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W789_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W789_Start4" name="Notice to Proceed (NTP) issued to contractor for new store construction or major…">
        <bpmn:outgoing>W789_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W789_Task5" name="CSHP Development">
        <bpmn:documentation>Step 1: CSHP Development: Before mobilization, General Contractor submits Construction Safety and Health Program (CSHP) to BuildRight Safety Officer for review: includes hazard identification, risk assessment, safety rules, emergency procedures, PPE requirements, safety training schedule, accident/incident reporting procedures; must comply with DOLE DO 13 format requirements
Responsible (R): Contractor Safety Officer
Accountable (A): Construction Safety Officer
Duration: 3-5 days</bpmn:documentation>
        <bpmn:incoming>W789_Flow16</bpmn:incoming>
        <bpmn:outgoing>W789_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task6" name="DOLE Registration">
        <bpmn:documentation>Step 2: DOLE Registration: Construction Safety Officer registers the construction project with DOLE Regional Office per DO 13 Section 4: submits CSHP, project duration, estimated workforce, contractor details; DOLE issues Construction Safety Registration Certificate; construction cannot legally begin without this registration
Responsible (R): Construction Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1-2 weeks</bpmn:documentation>
        <bpmn:incoming>W789_Flow17</bpmn:incoming>
        <bpmn:outgoing>W789_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task7" name="Safety Mobilization">
        <bpmn:documentation>Step 3: Safety Mobilization: Contractor establishes safety infrastructure at site: first aid station with trained first aider, fire extinguishers, safety signage (English and Filipino), PPE dispensing station, safety bulletin board with emergency contacts, toilet and washing facilities per DOLE standards, scaffold tags, confined space permits
Responsible (R): Contractor Safety Officer
Accountable (A): Project Manager
Duration: 3-5 days</bpmn:documentation>
        <bpmn:incoming>W789_Flow18</bpmn:incoming>
        <bpmn:outgoing>W789_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task8" name="Daily Toolbox Talks">
        <bpmn:documentation>Step 4: Daily Toolbox Talks: Each workday begins with 10-15 minute toolbox talk covering: task-specific hazards for the day, PPE requirements, weather alerts (typhoon, extreme heat), recent incidents or near-misses from other BuildRight sites; attendance logged in system
Responsible (R): Contractor Safety Officer
Accountable (A): Project Manager
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W789_Flow19</bpmn:incoming>
        <bpmn:outgoing>W789_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task9" name="Weekly Safety Inspection">
        <bpmn:documentation>Step 5: Weekly Safety Inspection: Construction Safety Officer conducts weekly walk-through: verify PPE usage, scaffolding integrity, electrical safety (temporary wiring), fall protection, excavation safety, crane/lift operations, housekeeping, fire prevention, first aid station readiness; findings documented in safety inspection checklist
Responsible (R): Construction Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2-3 hours/week</bpmn:documentation>
        <bpmn:incoming>W789_Flow20</bpmn:incoming>
        <bpmn:outgoing>W789_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task10" name="Incident Reporting &amp; Investigation">
        <bpmn:documentation>Step 6: Incident Reporting &amp; Investigation: If safety incident occurs: (a) immediate first aid and area isolation; (b) incident report within 24 hours per W140; (c) DOLE notification within 48 hours if serious injury or fatality; (d) root cause analysis within 7 days; (e) corrective actions implemented and tracked to closure
Responsible (R): Construction Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2-8 hours per incident</bpmn:documentation>
        <bpmn:incoming>W789_Flow21</bpmn:incoming>
        <bpmn:outgoing>W789_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task11" name="Monthly Safety Review">
        <bpmn:documentation>Step 7: Monthly Safety Review: Construction Safety Officer compiles monthly safety report: total work hours, incident rate, near-miss reports, safety training hours, open corrective actions, safety inspection findings; submitted to Director, Facilities &amp; Real Estate and CHRO for chain-wide safety trend analysis
Responsible (R): Construction Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W789_Flow22</bpmn:incoming>
        <bpmn:outgoing>W789_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W789_Task12" name="Project Safety Closeout">
        <bpmn:documentation>Step 8: Project Safety Closeout: At substantial completion: (a) final safety inspection; (b) consolidate all incident records into project safety file; (c) safety lessons learned documented for W227 handover; (d) DOLE project safety registration closed; (e) contractor safety performance score for W224 bid evaluation database
Responsible (R): Construction Safety Officer
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W789_Flow23</bpmn:incoming>
        <bpmn:outgoing>W789_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W789_End13" name="Complete">
        <bpmn:incoming>W789_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W789_Annotation14">
        <bpmn:text>Controls: - CTL-302 (ensure controlled execution — Engineering &amp; Construction (PA-20.2).) | - operational: Construction Safety Officer review and approval gate
Owner: Construction Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W789_Assoc15" sourceRef="W789_Annotation14" targetRef="W789_Start4" associationDirection="None" />
