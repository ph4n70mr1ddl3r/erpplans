      <bpmndi:BPMNPlane id="W223_plane" bpmnElement="W_W223">
        <bpmndi:BPMNShape id="W223_Lane1_di" bpmnElement="W223_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
