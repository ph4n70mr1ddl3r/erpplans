        <bpmn:flowNodeRef>W227_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W227_Lane5" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W227_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W227_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W227_Start7" name="Construction completion (95%)">
        <bpmn:outgoing>W227_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W227_Task8" name="Punch Listing">
        <bpmn:documentation>Step 1: Punch Listing: Identify minor defects (snags) for contractor correction
Responsible (R): Project Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W227_Flow17</bpmn:incoming>
        <bpmn:outgoing>W227_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W227_Task9" name="Equipment Testing">
        <bpmn:documentation>Step 2: Equipment Testing: Test HVAC, Fire Sprinklers, Elevators, and Generator Sets
Responsible (R): MEP Engineer
Accountable (A): —
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W227_Flow18</bpmn:incoming>
        <bpmn:outgoing>W227_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W227_Task10" name="IT Setup">
        <bpmn:documentation>Step 3: IT Setup: Install POS, Servers, CCTV, and Network per W48
Responsible (R): IT Field Team
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W227_Flow19</bpmn:incoming>
        <bpmn:outgoing>W227_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W227_Task11" name="Inventory Load">
        <bpmn:documentation>Step 4: Inventory Load: Initial stock delivery and shelving per W16
Responsible (R): DC / Store Team
Accountable (A): Store Mgr
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W227_Flow20</bpmn:incoming>
        <bpmn:outgoing>W227_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W227_Task12" name="Certificate of Occupancy">
        <bpmn:documentation>Step 5: Certificate of Occupancy: Obtain final LGU clearances
Responsible (R): Project Mgr
Accountable (A): —
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W227_Flow21</bpmn:incoming>
        <bpmn:outgoing>W227_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W227_Task13" name="Handover">
        <bpmn:documentation>Step 6: Handover: Engineering signs off to Store Ops; &quot;Grand Opening&quot; (W16)
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W227_Flow22</bpmn:incoming>
        <bpmn:outgoing>W227_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W227_End14" name="Complete">
        <bpmn:incoming>W227_Flow23</bpmn:incoming>
      </bpmn:endEvent>
