    <bpmn:process id="W_W224" name="W224. Construction Bidding &amp; Contractor Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Finalized Design &amp; BOQ (W223)
Frequency: Per new store or major renovation project
Volume: ~15–20 major construction contracts/year
Owner: Procurement Manager (Construction)
Participants: Engineering Team, Finance, Bidders
Source: workflow W224 — Construction Bidding &amp; Contractor Selection</bpmn:documentation>
      <bpmn:laneSet id="W224_LaneSet5">
        <bpmn:lane id="W224_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W224_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W224_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W224_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W224_Lane2" name="Project Mgr">
        <bpmn:flowNodeRef>W224_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W224_Lane3" name="Bidders">
        <bpmn:flowNodeRef>W224_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W224_Lane4" name="Engineering">
        <bpmn:flowNodeRef>W224_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W224_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W224_Start6" name="Finalized Design &amp; BOQ (W223)">
        <bpmn:outgoing>W224_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W224_Task7" name="RFP Issuance">
        <bpmn:documentation>Step 1: RFP Issuance: Send BOQ and specs to accredited general contractors
Responsible (R): Procurement
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W224_Flow15</bpmn:incoming>
        <bpmn:outgoing>W224_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W224_Task8" name="Pre-bid Conference">
        <bpmn:documentation>Step 2: Pre-bid Conference: Site visit and Q&amp;A with bidders
Responsible (R): Project Mgr
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W224_Flow16</bpmn:incoming>
        <bpmn:outgoing>W224_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W224_Task9" name="Bid Submission">
        <bpmn:documentation>Step 3: Bid Submission: Contractors submit technical and financial proposals
Responsible (R): Bidders
Accountable (A): —
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W224_Flow17</bpmn:incoming>
        <bpmn:outgoing>W224_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W224_Task10" name="Bid Evaluation">
        <bpmn:documentation>Step 4: Bid Evaluation: Reconcile bids against internal estimate; check contractor capacity
Responsible (R): Engineering
Accountable (A): Procurement
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W224_Flow18</bpmn:incoming>
        <bpmn:outgoing>W224_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W224_Task11" name="Award">
        <bpmn:documentation>Step 5: Award: Select winner and execute Construction Agreement (W230)
Responsible (R): Procurement
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W224_Flow19</bpmn:incoming>
        <bpmn:outgoing>W224_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W224_End12" name="Complete">
        <bpmn:incoming>W224_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W224_Annotation13">
        <bpmn:text>Controls: - CTL-302 (ensure controlled execution — Engineering &amp; Construction (PA-20.2).) | - operational: expanding accredited list and rotating invitations
Owner: Procurement Manager (Construction)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W224_Assoc14" sourceRef="W224_Annotation13" targetRef="W224_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W224_Flow15" sourceRef="W224_Start6" targetRef="W224_Task7" />
      <bpmn:sequenceFlow id="W224_Flow16" sourceRef="W224_Task7" targetRef="W224_Task8" />
      <bpmn:sequenceFlow id="W224_Flow17" sourceRef="W224_Task8" targetRef="W224_Task9" />
      <bpmn:sequenceFlow id="W224_Flow18" sourceRef="W224_Task9" targetRef="W224_Task10" />
      <bpmn:sequenceFlow id="W224_Flow19" sourceRef="W224_Task10" targetRef="W224_Task11" />
      <bpmn:sequenceFlow id="W224_Flow20" sourceRef="W224_Task11" targetRef="W224_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W224_diag">
      <bpmndi:BPMNPlane id="W224_plane" bpmnElement="W_W224">
        <bpmndi:BPMNShape id="W224_Lane1_di" bpmnElement="W224_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W224_Lane2_di" bpmnElement="W224_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W224_Lane3_di" bpmnElement="W224_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W224_Lane4_di" bpmnElement="W224_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
