      <bpmn:sequenceFlow id="W3384_Flow13" sourceRef="W3384_Task6" targetRef="W3384_Task7" />
      <bpmn:sequenceFlow id="W3384_Flow14" sourceRef="W3384_Task7" targetRef="W3384_End8" />
    </bpmn:process>
