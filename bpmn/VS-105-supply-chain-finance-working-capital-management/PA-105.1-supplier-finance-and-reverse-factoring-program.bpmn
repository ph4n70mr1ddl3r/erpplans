    <bpmn:process id="W_W3383" name="W3383. SCF Vendor Dispute, Pricing Discrepancy &amp; Off-Platform Exception Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor/funder dispute; pricing discrepancy; off-platform invoice; reconciliation break
Frequency: Exception-driven
Volume: ~20–50 exceptions/month
Owner: AP Manager
Participants: AP Manager, Treasury Manager, Vendor, Funder, Procurement
Source: workflow W3383 — SCF Vendor Dispute, Pricing Discrepancy &amp; Off-Platform Exception Handling</bpmn:documentation>
      <bpmn:laneSet id="W3383_LaneSet2">
        <bpmn:lane id="W3383_Lane1" name="AP Manager">
        <bpmn:flowNodeRef>W3383_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3383_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3383_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3383_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3383_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3383_Start3" name="Vendor/funder dispute; pricing discrepancy; off-platform invoice; reconciliation break">
        <bpmn:outgoing>W3383_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3383_Task4" name="AP Manager receive and log the exception (discount/dispute, mis-routed payment…">
        <bpmn:documentation>Step 1: AP Manager receive and log the exception (discount/dispute, mis-routed payment, duplicate funding, off-platform invoice, reconciliation break); classify root cause and assign owner with SLA
Responsible (R): AP Manager
Accountable (A): AP Manager
Duration: Per exception</bpmn:documentation>
        <bpmn:incoming>W3383_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3383_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3383_Task5" name="AP/Treasury/Procurement investigate: validate payable approval (links to…">
        <bpmn:documentation>Step 2: AP/Treasury/Procurement investigate: validate payable approval (links to VS-15.1), discount curve application, vendor enrollment status, and bank settlement (links to VS-18.2); engage funder/vendor as needed; propose resolution (re-process, credit, reversal)
Responsible (R): AP Manager / Treasury Manager
Accountable (A): Treasury Manager
Duration: Per exception</bpmn:documentation>
        <bpmn:incoming>W3383_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3383_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3383_Task6" name="AP Manager execute the resolution, reconcile AP/SCF platform/GL, communicate…">
        <bpmn:documentation>Step 3: AP Manager execute the resolution, reconcile AP/SCF platform/GL, communicate outcome to vendor/funder, and feed systemic issues to program governance (W3384) and continuous improvement
Responsible (R): AP Manager
Accountable (A): AP Manager
Duration: Per exception</bpmn:documentation>
        <bpmn:incoming>W3383_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3383_End7" name="Complete">
        <bpmn:incoming>W3383_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3383_Annotation8">
        <bpmn:text>Controls: - CTL-544 (ensure controlled execution — Supplier Finance &amp; Reverse-Factoring Program Management (PA-105.1).) | - operational: root-cause feed to governance (W3384); operational: SLA and clear escalation
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3383_Assoc9" sourceRef="W3383_Annotation8" targetRef="W3383_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3383_Flow10" sourceRef="W3383_Start3" targetRef="W3383_Task4" />
      <bpmn:sequenceFlow id="W3383_Flow11" sourceRef="W3383_Task4" targetRef="W3383_Task5" />
      <bpmn:sequenceFlow id="W3383_Flow12" sourceRef="W3383_Task5" targetRef="W3383_Task6" />
      <bpmn:sequenceFlow id="W3383_Flow13" sourceRef="W3383_Task6" targetRef="W3383_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3383_diag">
      <bpmndi:BPMNPlane id="W3383_plane" bpmnElement="W_W3383">
        <bpmndi:BPMNShape id="W3383_Lane1_di" bpmnElement="W3383_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
