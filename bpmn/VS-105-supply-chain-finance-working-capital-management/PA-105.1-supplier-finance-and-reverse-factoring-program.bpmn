<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-105.1-supplier-finance-and-reverse-factoring-program" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3377" name="W3377. SCF Strategy, Program Charter &amp; Multi-Funder Facility Design" isExecutable="false">
      <bpmn:documentation>Trigger: Annual treasury/procurement strategy review; working-capital target reset (links to VS-33.1)
Frequency: Annual + as needed
Volume: 1 program covering ~50–100 key vendors (~60% of the ~PHP 43B procurement spend per profile §9.4)
Owner: Treasury Manager
Participants: Treasury Manager, CFO, Procurement Director, FP&amp;A (links to VS-17.4), Bank SCF Partner
Source: workflow W3377 — SCF Strategy, Program Charter &amp; Multi-Funder Facility Design</bpmn:documentation>
      <bpmn:laneSet id="W3377_LaneSet3">
        <bpmn:lane id="W3377_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3377_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3377_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3377_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3377_Lane2" name="CFO">
        <bpmn:flowNodeRef>W3377_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3377_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3377_Start4" name="Annual treasury/procurement strategy review; working-capital target reset (links to…">
        <bpmn:outgoing>W3377_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3377_Task5" name="Treasury Manager develop the SCF strategy and program charter: target…">
        <bpmn:documentation>Step 1: Treasury Manager develop the SCF strategy and program charter: target DPO/working-capital outcome (links to W3393), eligible-spend scope (merchandise vs non-merchandise, import vs local), funder mix (single bank vs multi-funder marketplace), and the build-vs-buy platform decision; align to cash forecast (links to VS-18.1) and capex funding plan (links to VS-40)
Responsible (R): Treasury Manager / Procurement Director
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3377_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3377_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3377_Task6" name="Treasury Manager design the facility structure: reverse-factoring…">
        <bpmn:documentation>Step 2: Treasury Manager design the facility structure: reverse-factoring (BuildRight-payable-backed) vs payables-receivables financing, facility limit, term, early-payment discount/yield curve, FX treatment for import payables (links to VS-18.3), and the true-sale vs assignment legal structure; secure tax/VAT and PFRS off-balance-sheet treatment review with Tax (links to VS-79) and External Audit (links to VS-21)
Responsible (R): Treasury Manager / Finance / Tax
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3377_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3377_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3377_Task7" name="CFO/Board approve the SCF program, facility envelope, and risk appetite…">
        <bpmn:documentation>Step 3: CFO/Board approve the SCF program, facility envelope, and risk appetite; authorize partner selection (W3378) and set the governance cadence (W3384) and KPI reporting (links to W3399)
Responsible (R): CFO
Accountable (A): Board / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3377_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3377_End8" name="Complete">
        <bpmn:incoming>W3377_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3377_Annotation9">
        <bpmn:text>Controls: - CTL-544 (ensure controlled execution — Supplier Finance &amp; Reverse-Factoring Program Management (PA-105.1).) | - operational: tax/audit sign-off (links to VS-79/VS-21); operational: multi-funder design (W3378/W3384)
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3377_Assoc10" sourceRef="W3377_Annotation9" targetRef="W3377_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3377_Flow11" sourceRef="W3377_Start4" targetRef="W3377_Task5" />
      <bpmn:sequenceFlow id="W3377_Flow12" sourceRef="W3377_Task5" targetRef="W3377_Task6" />
      <bpmn:sequenceFlow id="W3377_Flow13" sourceRef="W3377_Task6" targetRef="W3377_Task7" />
      <bpmn:sequenceFlow id="W3377_Flow14" sourceRef="W3377_Task7" targetRef="W3377_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3377_diag">
      <bpmndi:BPMNPlane id="W3377_plane" bpmnElement="W_W3377">
        <bpmndi:BPMNShape id="W3377_Lane1_di" bpmnElement="W3377_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Lane2_di" bpmnElement="W3377_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Task5_di" bpmnElement="W3377_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Task6_di" bpmnElement="W3377_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Task7_di" bpmnElement="W3377_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Start4_di" bpmnElement="W3377_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_End8_di" bpmnElement="W3377_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3377_Annotation9_di" bpmnElement="W3377_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3377_Flow11_di" bpmnElement="W3377_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3377_Flow12_di" bpmnElement="W3377_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3377_Flow13_di" bpmnElement="W3377_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3377_Flow14_di" bpmnElement="W3377_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3377_Assoc10_di" bpmnElement="W3377_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3378" name="W3378. Bank / Fintech SCF Partner Selection, Onboarding &amp; Agreement Management" isExecutable="false">
      <bpmn:documentation>Trigger: Program approval (W3377); funder performance review; facility renewal
Frequency: At program launch + periodic renewal (1–3 yr)
Volume: 1–3 funder partners
Owner: Treasury Manager
Participants: Treasury Manager, CFO, Procurement, Legal (links to VS-100.3), Bank/Fintech Partner
Source: workflow W3378 — Bank / Fintech SCF Partner Selection, Onboarding &amp; Agreement Management</bpmn:documentation>
      <bpmn:laneSet id="W3378_LaneSet3">
        <bpmn:lane id="W3378_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3378_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3378_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3378_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3378_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3378_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3378_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3378_Start4" name="Program approval (W3377); funder performance review; facility renewal">
        <bpmn:outgoing>W3378_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3378_Task5" name="Treasury Manager issue RFP to SCF-capable banks (BDO, BPI, Metrobank, Chinabank…">
        <bpmn:documentation>Step 1: Treasury Manager issue RFP to SCF-capable banks (BDO, BPI, Metrobank, Chinabank per profile §10.4) and fintech platforms; evaluate on funding cost/yield, platform usability, vendor onboarding friction, FX capability, reporting, and integration to ERP/AP (links to VS-15)
Responsible (R): Treasury Manager / Procurement
Accountable (A): CFO
Duration: Per selection</bpmn:documentation>
        <bpmn:incoming>W3378_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3378_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3378_Task6" name="Legal/Treasury negotiate the master SCF agreement: assignment/true-sale terms…">
        <bpmn:documentation>Step 2: Legal/Treasury negotiate the master SCF agreement: assignment/true-sale terms, recourse, repurchase events, pricing mechanics, data-sharing and privacy (links to VS-91), termination, and bank covenants; execute and onboard the funder to the platform
Responsible (R): Legal / Treasury Manager
Accountable (A): CFO
Duration: Per selection</bpmn:documentation>
        <bpmn:incoming>W3378_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3378_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3378_Task7" name="Treasury Manager configure the funder on the SCF platform and ERP integration…">
        <bpmn:documentation>Step 3: Treasury Manager configure the funder on the SCF platform and ERP integration (approved-payable feed, settlement file, GL posting of finance charges), test end-to-end with a pilot vendor cohort, and document the operating runbook
Responsible (R): Treasury Manager / IT (links to VS-27.2)
Accountable (A): Treasury Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W3378_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3378_End8" name="Complete">
        <bpmn:incoming>W3378_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3378_Annotation9">
        <bpmn:text>Controls: - CTL-544 (ensure controlled execution — Supplier Finance &amp; Reverse-Factoring Program Management (PA-105.1).) | - operational: IT integration testing and reconciliation (W3380); operational: privacy review (links to VS-91)
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3378_Assoc10" sourceRef="W3378_Annotation9" targetRef="W3378_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3378_Flow11" sourceRef="W3378_Start4" targetRef="W3378_Task5" />
      <bpmn:sequenceFlow id="W3378_Flow12" sourceRef="W3378_Task5" targetRef="W3378_Task6" />
      <bpmn:sequenceFlow id="W3378_Flow13" sourceRef="W3378_Task6" targetRef="W3378_Task7" />
      <bpmn:sequenceFlow id="W3378_Flow14" sourceRef="W3378_Task7" targetRef="W3378_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3378_diag">
      <bpmndi:BPMNPlane id="W3378_plane" bpmnElement="W_W3378">
        <bpmndi:BPMNShape id="W3378_Lane1_di" bpmnElement="W3378_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Lane2_di" bpmnElement="W3378_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Task5_di" bpmnElement="W3378_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Task6_di" bpmnElement="W3378_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Task7_di" bpmnElement="W3378_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Start4_di" bpmnElement="W3378_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_End8_di" bpmnElement="W3378_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3378_Annotation9_di" bpmnElement="W3378_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3378_Flow11_di" bpmnElement="W3378_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3378_Flow12_di" bpmnElement="W3378_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3378_Flow13_di" bpmnElement="W3378_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3378_Flow14_di" bpmnElement="W3378_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3378_Assoc10_di" bpmnElement="W3378_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3379" name="W3379. Vendor SCF Eligibility, Enrollment &amp; KYC Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor becomes top-spend / strategic; periodic enrollment waves
Frequency: Continuous + wave-based
Volume: ~50–100 eligible vendors (~60% of the ~PHP 43B spend); ~10–20 new enrollments/quarter
Owner: Procurement Director
Participants: Procurement, Treasury Manager, Vendor (links to VS-03.4 portal), Funder
Source: workflow W3379 — Vendor SCF Eligibility, Enrollment &amp; KYC Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W3379_LaneSet3">
        <bpmn:lane id="W3379_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3379_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3379_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3379_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3379_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W3379_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3379_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3379_Start4" name="Vendor becomes top-spend / strategic; periodic enrollment waves">
        <bpmn:outgoing>W3379_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3379_Task5" name="Procurement/Treasury identify eligible vendors from spend analytics (links to…">
        <bpmn:documentation>Step 1: Procurement/Treasury identify eligible vendors from spend analytics (links to VS-67/VS-03.3): spend threshold, payment-term stability, vendor health, strategic importance, and import/local mix; segment into priority enrollment waves
Responsible (R): Procurement / Treasury Manager
Accountable (A): Procurement Director
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3379_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3379_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3379_Task6" name="Procurement invite the vendor to enroll via the supplier portal (links to…">
        <bpmn:documentation>Step 2: Procurement invite the vendor to enroll via the supplier portal (links to VS-03.4); funder completes vendor KYC/AML (links to VS-86.1), credit assessment, and master SCF agreement (vendor-side discount/fee acceptance); vendor configures bank account and notification preferences
Responsible (R): Procurement / Funder / Vendor
Accountable (A): Procurement Director
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3379_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3379_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3379_Task7" name="Treasury Manager/Procurement activate the vendor on the SCF platform, confirm…">
        <bpmn:documentation>Step 3: Treasury Manager/Procurement activate the vendor on the SCF platform, confirm the payable feed and discount curve, run a test early-payment transaction, and add the vendor to the active SCF roster and governance reporting (W3384)
Responsible (R): Treasury Manager / Procurement
Accountable (A): Treasury Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3379_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3379_End8" name="Complete">
        <bpmn:incoming>W3379_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3379_Annotation9">
        <bpmn:text>Controls: - CTL-544 (ensure controlled execution — Supplier Finance &amp; Reverse-Factoring Program Management (PA-105.1).) | - operational: clear value proposition and tiered pricing; operational: funder credit assessment and monitoring (W3384)
Owner: Procurement Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3379_Assoc10" sourceRef="W3379_Annotation9" targetRef="W3379_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3379_Flow11" sourceRef="W3379_Start4" targetRef="W3379_Task5" />
      <bpmn:sequenceFlow id="W3379_Flow12" sourceRef="W3379_Task5" targetRef="W3379_Task6" />
      <bpmn:sequenceFlow id="W3379_Flow13" sourceRef="W3379_Task6" targetRef="W3379_Task7" />
      <bpmn:sequenceFlow id="W3379_Flow14" sourceRef="W3379_Task7" targetRef="W3379_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3379_diag">
      <bpmndi:BPMNPlane id="W3379_plane" bpmnElement="W_W3379">
        <bpmndi:BPMNShape id="W3379_Lane1_di" bpmnElement="W3379_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Lane2_di" bpmnElement="W3379_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Task5_di" bpmnElement="W3379_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Task6_di" bpmnElement="W3379_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Task7_di" bpmnElement="W3379_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Start4_di" bpmnElement="W3379_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_End8_di" bpmnElement="W3379_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3379_Annotation9_di" bpmnElement="W3379_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3379_Flow11_di" bpmnElement="W3379_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3379_Flow12_di" bpmnElement="W3379_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3379_Flow13_di" bpmnElement="W3379_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3379_Flow14_di" bpmnElement="W3379_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3379_Assoc10_di" bpmnElement="W3379_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3380" name="W3380. Approved-Payable Monetization, Invoice Upload &amp; Funder Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Invoice 3-way match approval (links to VS-15.1); vendor early-payment request
Frequency: Daily / transaction-level
Volume: ~3,000–4,500 approved-eligible invoices uploaded/month (the ~60%-of-spend vendor share of the ~6,715 merchandise invoices), of which ~10–25% draw early payment; construction-season peaks add ~10–20%
Owner: AP Manager
Participants: AP Manager, Treasury Manager, Funder, Vendor
Source: workflow W3380 — Approved-Payable Monetization, Invoice Upload &amp; Funder Settlement</bpmn:documentation>
      <bpmn:laneSet id="W3380_LaneSet3">
        <bpmn:lane id="W3380_Lane1" name="AP Manager">
        <bpmn:flowNodeRef>W3380_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3380_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3380_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3380_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W3380_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3380_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3380_Start4" name="Invoice 3-way match approval (links to VS-15.1); vendor early-payment request">
        <bpmn:outgoing>W3380_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3380_Task5" name="AP Manager process invoices through normal 3-way match (links to VS-15.1 W7)…">
        <bpmn:documentation>Step 1: AP Manager process invoices through normal 3-way match (links to VS-15.1 W7); approved, SCF-eligible payables are automatically flagged and uploaded to the SCF platform with vendor, amount, due-date, and PO reference; data reconciled to AP sub-ledger
Responsible (R): AP Manager
Accountable (A): AP Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3380_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3380_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3380_Task6" name="Vendor requests early payment on the platform (or auto-offer per enrollment)…">
        <bpmn:documentation>Step 2: Vendor requests early payment on the platform (or auto-offer per enrollment); funder funds the vendor early at the agreed discount; BuildRight&#x27;s obligation is re-owed to the funder at the original invoice due date; AP/SCF platform records the assignment and updates the payable beneficiary
Responsible (R): AP Manager / Funder / Vendor
Accountable (A): Treasury Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3380_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3380_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3380_Task7" name="Treasury/AP reconcile the SCF settlement: vendor paid, finance charge accrued…">
        <bpmn:documentation>Step 3: Treasury/AP reconcile the SCF settlement: vendor paid, finance charge accrued (links to VS-17.1), payable reclassified to funder, and bank settlement confirmed on due date (links to VS-18.2); resolve exceptions via W3383
Responsible (R): Treasury Manager / AP Manager
Accountable (A): Treasury Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3380_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3380_End8" name="Complete">
        <bpmn:incoming>W3380_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3380_Annotation9">
        <bpmn:text>Controls: - CTL-106 (ensure SCF settlement &amp; covenant compliance.) | - operational: daily reconciliation and exception workflow (W3383); operational: auto-offer thresholds and analytics (W3399)
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3380_Assoc10" sourceRef="W3380_Annotation9" targetRef="W3380_Start4" associationDirection="None" />
