      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3394" name="W3394. Days-Payable-Outstanding (DPO) Improvement Initiative Management" isExecutable="false">
      <bpmn:documentation>Trigger: DWC target (W3393); SCF/term program (W3377/W3381)
Frequency: Continuous + quarterly review
Volume: ~800–1,000 vendors; ~PHP 37B procurement spend
Owner: Treasury Manager
Participants: Treasury Manager, Procurement Director, AP Manager, Category Managers (links to VS-01)
Source: workflow W3394 — Days-Payable-Outstanding (DPO) Improvement Initiative Management</bpmn:documentation>
      <bpmn:laneSet id="W3394_LaneSet3">
        <bpmn:lane id="W3394_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3394_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3394_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3394_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3394_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W3394_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3394_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3394_Start4" name="DWC target (W3393); SCF/term program (W3377/W3381)">
        <bpmn:outgoing>W3394_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3394_Task5" name="Treasury/Procurement analyze DPO by vendor/category/segment: actual vs…">
        <bpmn:documentation>Step 1: Treasury/Procurement analyze DPO by vendor/category/segment: actual vs contracted terms, on-time-payment rate, term-negotiation opportunity, and SCF-eligibility; identify the DPO-improvement backlog (extended terms per W3381, SCF enrollment per W3379, payment-run timing per VS-15.2)
Responsible (R): Treasury Manager / Procurement
Accountable (A): Treasury Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3394_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3394_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3394_Task6" name="Procurement/Category Managers execute the DPO initiatives: renegotiate terms…">
        <bpmn:documentation>Step 2: Procurement/Category Managers execute the DPO initiatives: renegotiate terms (W3381), enroll vendors in SCF (W3379), tighten payment-run timing (links to VS-15.2), and resolve term-master data issues (links to W295); track initiative-by-initiative DPO gain
Responsible (R): Procurement / Category Managers / AP
Accountable (A): Procurement Director
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3394_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3394_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3394_Task7" name="Treasury measure DPO movement vs target, isolate drivers (term change vs…">
        <bpmn:documentation>Step 3: Treasury measure DPO movement vs target, isolate drivers (term change vs payment timing vs SCF), and report to the working-capital review (W3399); re-prioritize the backlog and flag adverse vendor reactions
Responsible (R): Treasury Manager / FP&amp;A
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3394_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3394_End8" name="Complete">
        <bpmn:incoming>W3394_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3394_Annotation9">
        <bpmn:text>Controls: - CTL-546 (ensure controlled execution — Working Capital Analytics &amp; Cash-Conversion-Cycle Governance (PA-105.3).) | - operational: price-for-terms analytics (W3381); operational: SCF access and health screening
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3394_Assoc10" sourceRef="W3394_Annotation9" targetRef="W3394_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3394_Flow11" sourceRef="W3394_Start4" targetRef="W3394_Task5" />
      <bpmn:sequenceFlow id="W3394_Flow12" sourceRef="W3394_Task5" targetRef="W3394_Task6" />
      <bpmn:sequenceFlow id="W3394_Flow13" sourceRef="W3394_Task6" targetRef="W3394_Task7" />
      <bpmn:sequenceFlow id="W3394_Flow14" sourceRef="W3394_Task7" targetRef="W3394_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3394_diag">
      <bpmndi:BPMNPlane id="W3394_plane" bpmnElement="W_W3394">
        <bpmndi:BPMNShape id="W3394_Lane1_di" bpmnElement="W3394_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3394_Lane2_di" bpmnElement="W3394_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3394_Task5_di" bpmnElement="W3394_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
