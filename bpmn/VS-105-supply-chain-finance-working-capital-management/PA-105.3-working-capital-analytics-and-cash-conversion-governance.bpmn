<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-105.3-working-capital-analytics-and-cash-conversion-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3393" name="W3393. Working-Capital KPI Definition, Baseline &amp; Target Setting (DPO/DIO/DSO/DWC)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning (links to VS-33.1); treasury/merchandise strategy refresh
Frequency: Annual + quarterly refresh
Volume: Group + 5-entity + 200-store view
Owner: Treasury Manager
Participants: Treasury Manager, FP&amp;A (links to VS-17.4), Merchandising (links to VS-101), Supply Chain (links to VS-02), AR/Credit (links to VS-16)
Source: workflow W3393 — Working-Capital KPI Definition, Baseline &amp; Target Setting (DPO/DIO/DSO/DWC)</bpmn:documentation>
      <bpmn:laneSet id="W3393_LaneSet3">
        <bpmn:lane id="W3393_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3393_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3393_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3393_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3393_Lane2" name="CFO">
        <bpmn:flowNodeRef>W3393_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3393_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3393_Start4" name="Annual planning (links to VS-33.1); treasury/merchandise strategy refresh">
        <bpmn:outgoing>W3393_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3393_Task5" name="Treasury/FP&amp;A define the working-capital KPI set: DPO (accounts payable days)…">
        <bpmn:documentation>Step 1: Treasury/FP&amp;A define the working-capital KPI set: DPO (accounts payable days), DIO (inventory days), DSO (receivable days), DWC (days working capital = DIO + DSO − DPO), and CCC; establish data sources (AP links to VS-15, inventory links to VS-05, AR links to VS-16) and calculation governance
Responsible (R): Treasury Manager / FP&amp;A
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3393_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3393_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3393_Task6" name="Treasury/FP&amp;A baseline current DWC by entity/category/channel using actuals…">
        <bpmn:documentation>Step 2: Treasury/FP&amp;A baseline current DWC by entity/category/channel using actuals, benchmark against retail/home-improvement norms and the 6–8x inventory-turn target (per profile §12.3), and set improvement targets aligned to the cash-flow/EBITDA plan (links to VS-33.1/VS-18.1)
Responsible (R): Treasury Manager / FP&amp;A
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3393_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3393_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3393_Task7" name="CFO/Executive committee approve the DWC targets, decompose into DPO/DIO/DSO…">
        <bpmn:documentation>Step 3: CFO/Executive committee approve the DWC targets, decompose into DPO/DIO/DSO sub-targets by owner (Treasury-AP for DPO, Merchandising-Supply for DIO, AR-Credit for DSO), and establish the monthly review cadence (W3399) and initiative portfolio (W3398)
Responsible (R): CFO / Exec Committee
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3393_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3393_End8" name="Complete">
        <bpmn:incoming>W3393_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3393_Annotation9">
        <bpmn:text>Controls: - CTL-546 (ensure controlled execution — Working Capital Analytics &amp; Cash-Conversion-Cycle Governance (PA-105.3).) | - operational: single KPI definition and governance; operational: bottom-up validation with Merchandising/Supply/AR
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3393_Assoc10" sourceRef="W3393_Annotation9" targetRef="W3393_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3393_Flow11" sourceRef="W3393_Start4" targetRef="W3393_Task5" />
      <bpmn:sequenceFlow id="W3393_Flow12" sourceRef="W3393_Task5" targetRef="W3393_Task6" />
      <bpmn:sequenceFlow id="W3393_Flow13" sourceRef="W3393_Task6" targetRef="W3393_Task7" />
      <bpmn:sequenceFlow id="W3393_Flow14" sourceRef="W3393_Task7" targetRef="W3393_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3393_diag">
      <bpmndi:BPMNPlane id="W3393_plane" bpmnElement="W_W3393">
        <bpmndi:BPMNShape id="W3393_Lane1_di" bpmnElement="W3393_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Lane2_di" bpmnElement="W3393_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Task5_di" bpmnElement="W3393_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Task6_di" bpmnElement="W3393_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Task7_di" bpmnElement="W3393_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Start4_di" bpmnElement="W3393_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_End8_di" bpmnElement="W3393_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3393_Annotation9_di" bpmnElement="W3393_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
