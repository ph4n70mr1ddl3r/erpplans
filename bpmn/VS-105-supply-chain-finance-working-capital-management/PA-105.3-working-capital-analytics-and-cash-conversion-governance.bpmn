        <bpmndi:BPMNShape id="W3394_Task7_di" bpmnElement="W3394_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3394_Start4_di" bpmnElement="W3394_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3394_End8_di" bpmnElement="W3394_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3394_Annotation9_di" bpmnElement="W3394_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3394_Flow11_di" bpmnElement="W3394_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3394_Flow12_di" bpmnElement="W3394_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3394_Flow13_di" bpmnElement="W3394_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3394_Flow14_di" bpmnElement="W3394_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3394_Assoc10_di" bpmnElement="W3394_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3395" name="W3395. Inventory Days (DIO) Cash-Release &amp; Inventory-Working-Capital Program" isExecutable="false">
      <bpmn:documentation>Trigger: DWC target (W3393); merchandise plan (links to VS-101)
Frequency: Continuous + seasonal
Volume: 35,000 active SKUs; ~PHP 5–7B inventory at cost
Owner: VP Merchandising
Participants: VP Merchandising, Merchandise Planners (links to VS-101), Supply Planning (links to VS-02.1), Inventory (links to VS-05), Treasury Manager
Source: workflow W3395 — Inventory Days (DIO) Cash-Release &amp; Inventory-Working-Capital Program</bpmn:documentation>
      <bpmn:laneSet id="W3395_LaneSet3">
        <bpmn:lane id="W3395_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3395_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3395_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3395_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3395_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W3395_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3395_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3395_Start4" name="DWC target (W3393); merchandise plan (links to VS-101)">
        <bpmn:outgoing>W3395_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3395_Task5" name="Merchandising/Supply analyze DIO by department/category/SKU: weeks-of-supply vs…">
        <bpmn:documentation>Step 1: Merchandising/Supply analyze DIO by department/category/SKU: weeks-of-supply vs target, slow-moving/obsolete (links to VS-05.3/W220), overstock, OTB utilization (links to VS-101 W3283), and import-pipeline inventory (links to VS-02.2); identify the DIO cash-release backlog
Responsible (R): Merchandise Planner / Supply Planning
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3395_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3395_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3395_Task6" name="Merchandising/Supply execute DIO initiatives: tighten OTB (links to VS-101…">
        <bpmn:documentation>Step 2: Merchandising/Supply execute DIO initiatives: tighten OTB (links to VS-101 W3283), reduce safety stock on C-items, accelerate slow-mover clearance (links to VS-64/VS-05.3), optimize import order quantity/lead (links to VS-02.2), and improve forecast accuracy (links to VS-02.1); track inventory-$ release
Responsible (R): Merchandise Planner / Supply Planning / Buyers
Accountable (A): VP Merchandising
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3395_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3395_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3395_Task7" name="Treasury/Merchandising measure DIO movement vs target and the 6–8x turn target…">
        <bpmn:documentation>Step 3: Treasury/Merchandising measure DIO movement vs target and the 6–8x turn target (per profile §12.3), compute inventory-$ released and its cash impact (links to VS-18.1), and report to the working-capital review (W3399); guard against stockout/margin trade-off (links to VS-101.3)
Responsible (R): Treasury Manager / Merchandising
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3395_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3395_End8" name="Complete">
        <bpmn:incoming>W3395_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3395_Annotation9">
        <bpmn:text>Controls: - CTL-546 (ensure controlled execution — Working Capital Analytics &amp; Cash-Conversion-Cycle Governance (PA-105.3).) | - operational: ABC-aware targeting and service-level guardrails; operational: OTB control (links to VS-101 W3283)
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3395_Assoc10" sourceRef="W3395_Annotation9" targetRef="W3395_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3395_Flow11" sourceRef="W3395_Start4" targetRef="W3395_Task5" />
      <bpmn:sequenceFlow id="W3395_Flow12" sourceRef="W3395_Task5" targetRef="W3395_Task6" />
      <bpmn:sequenceFlow id="W3395_Flow13" sourceRef="W3395_Task6" targetRef="W3395_Task7" />
      <bpmn:sequenceFlow id="W3395_Flow14" sourceRef="W3395_Task7" targetRef="W3395_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3395_diag">
      <bpmndi:BPMNPlane id="W3395_plane" bpmnElement="W_W3395">
        <bpmndi:BPMNShape id="W3395_Lane1_di" bpmnElement="W3395_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Lane2_di" bpmnElement="W3395_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Task5_di" bpmnElement="W3395_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Task6_di" bpmnElement="W3395_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Task7_di" bpmnElement="W3395_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Start4_di" bpmnElement="W3395_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_End8_di" bpmnElement="W3395_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3395_Annotation9_di" bpmnElement="W3395_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3395_Flow11_di" bpmnElement="W3395_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3395_Flow12_di" bpmnElement="W3395_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3395_Flow13_di" bpmnElement="W3395_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3395_Flow14_di" bpmnElement="W3395_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3395_Assoc10_di" bpmnElement="W3395_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3396" name="W3396. Days-Sales-Outstanding (DSO) &amp; Receivable Cash-Release Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: DWC target (W3393); AR review (links to VS-16.2)
Frequency: Continuous + monthly
Volume: ~5,200 active AR accounts; ~3,500 AR invoices/month (per profile §10.3)
Owner: AR/Credit Manager
Participants: AR/Credit Manager (links to VS-16), Treasury Manager, Trade Sales (links to VS-11), FP&amp;A
Source: workflow W3396 — Days-Sales-Outstanding (DSO) &amp; Receivable Cash-Release Coordination</bpmn:documentation>
      <bpmn:laneSet id="W3396_LaneSet3">
        <bpmn:lane id="W3396_Lane1" name="AR">
        <bpmn:flowNodeRef>W3396_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3396_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3396_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3396_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W3396_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3396_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3396_Start4" name="DWC target (W3393); AR review (links to VS-16.2)">
        <bpmn:outgoing>W3396_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3396_Task5" name="AR/Credit analyze DSO by customer/segment/channel: actual days vs terms (Net 30…">
        <bpmn:documentation>Step 1: AR/Credit analyze DSO by customer/segment/channel: actual days vs terms (Net 30 trade / Net 60–90 corporate per profile §10.3), aging (links to VS-16.2), dispute volume, and collection effectiveness; identify the DSO cash-release backlog
Responsible (R): AR/Credit Manager / FP&amp;A
Accountable (A): AR/Credit Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3396_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3396_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3396_Task6" name="AR/Trade execute DSO initiatives: tighten credit terms/limits (links to…">
        <bpmn:documentation>Step 2: AR/Trade execute DSO initiatives: tighten credit terms/limits (links to VS-16.1/VS-68), accelerate collections (links to VS-16.2 W108), resolve disputes faster (links to VS-90/W244), promote e-invoicing/electronic payment (links to VS-80/VS-79), and consider selective receivables financing; track DSO-$ release
Responsible (R): AR/Credit Manager / Trade Sales
Accountable (A): AR/Credit Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3396_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3396_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3396_Task7" name="Treasury/AR measure DSO movement vs target, compute receivable-$ released and…">
        <bpmn:documentation>Step 3: Treasury/AR measure DSO movement vs target, compute receivable-$ released and its cash impact (links to VS-18.1), balance against trade-credit-risk appetite (links to VS-68), and report to the working-capital review (W3399)
Responsible (R): Treasury Manager / AR/Credit Manager
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3396_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3396_End8" name="Complete">
        <bpmn:incoming>W3396_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3396_Annotation9">
        <bpmn:text>Controls: - CTL-546 (ensure controlled execution — Working Capital Analytics &amp; Cash-Conversion-Cycle Governance (PA-105.3).) | - operational: risk-segmented policy (links to VS-68); operational: analytics
Owner: AR/Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
