      <bpmndi:BPMNPlane id="W5542_plane" bpmnElement="W_W5542">
        <bpmndi:BPMNShape id="W5542_Lane1_di" bpmnElement="W5542_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
