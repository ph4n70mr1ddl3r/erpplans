    <bpmn:process id="W_W3392" name="W3392. Discount Capture Reconciliation, GL Posting &amp; Audit Trail" isExecutable="false">
      <bpmn:documentation>Trigger: Daily batch close; month-end close (links to VS-17.1/W9A)
Frequency: Daily + monthly
Volume: ~150–400 transactions/month (peak; per W3387)
Owner: AP Manager
Participants: AP Manager, Treasury Manager, Finance/GL (links to VS-17.1), Internal Audit (links to VS-21)
Source: workflow W3392 — Discount Capture Reconciliation, GL Posting &amp; Audit Trail</bpmn:documentation>
      <bpmn:laneSet id="W3392_LaneSet3">
        <bpmn:lane id="W3392_Lane1" name="AP Manager">
        <bpmn:flowNodeRef>W3392_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3392_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3392_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3392_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W3392_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3392_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3392_Start4" name="Daily batch close; month-end close (links to VS-17.1/W9A)">
        <bpmn:outgoing>W3392_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3392_Task5" name="AP/Treasury reconcile daily: dynamic-discounting platform discount capture vs…">
        <bpmn:documentation>Step 1: AP/Treasury reconcile daily: dynamic-discounting platform discount capture vs AP sub-ledger vs bank settlement (links to VS-18.2); validate payable clearance, discount-income posting, and finance-charge posting; resolve breaks via W3383
Responsible (R): AP Manager / Treasury Manager
Accountable (A): AP Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3392_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3392_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3392_Task6" name="Finance/GL post discount income (contra COGS or other income per policy) and…">
        <bpmn:documentation>Step 2: Finance/GL post discount income (contra COGS or other income per policy) and finance charges to the correct entity GL (links to VS-17.1/W9A); reconcile to the cash forecast impact (links to VS-18.1); support the month-end close
Responsible (R): AP Manager / Finance
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3392_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3392_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3392_Task7" name="Treasury/AP maintain the audit trail: offer, acceptance, authorization…">
        <bpmn:documentation>Step 3: Treasury/AP maintain the audit trail: offer, acceptance, authorization, payment, reconciliation evidence; support Internal Audit (links to VS-21) and external audit review of SCF/dynamic-discounting controls, SoD, and off-balance-sheet classification (links to W3377)
Responsible (R): Treasury Manager / AP Manager
Accountable (A): CFO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3392_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3392_End8" name="Complete">
        <bpmn:incoming>W3392_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3392_Annotation9">
        <bpmn:text>Controls: - CTL-545 (ensure controlled execution — Dynamic Discounting &amp; Early-Payment Operations (PA-105.2).) | - operational: daily reconciliation; operational: platform audit-trail and SoD controls
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3392_Assoc10" sourceRef="W3392_Annotation9" targetRef="W3392_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3392_Flow11" sourceRef="W3392_Start4" targetRef="W3392_Task5" />
      <bpmn:sequenceFlow id="W3392_Flow12" sourceRef="W3392_Task5" targetRef="W3392_Task6" />
      <bpmn:sequenceFlow id="W3392_Flow13" sourceRef="W3392_Task6" targetRef="W3392_Task7" />
      <bpmn:sequenceFlow id="W3392_Flow14" sourceRef="W3392_Task7" targetRef="W3392_End8" />
    </bpmn:process>
