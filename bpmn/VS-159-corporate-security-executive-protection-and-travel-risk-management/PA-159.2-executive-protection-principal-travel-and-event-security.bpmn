    <bpmn:process id="W_W4682" name="W4682. Principal (Board/Family/CEO) Travel Security &amp; Advance Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Principal domestic/international trip
Frequency: Per trip
Volume: ~30–60 principal trips/year (domestic inter-island + international)
Owner: EP Lead / Travel Risk Manager
Participants: EP agents (advance + traveling), Travel/Mobility (VS-160), intelligence (W4679), local fixers/security
Source: workflow W4682 — Principal (Board/Family/CEO) Travel Security &amp; Advance Operations</bpmn:documentation>
      <bpmn:laneSet id="W4682_LaneSet4">
        <bpmn:lane id="W4682_Lane1" name="EP Advance">
        <bpmn:flowNodeRef>W4682_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4682_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4682_Lane2" name="Traveling EP">
        <bpmn:flowNodeRef>W4682_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4682_Lane3" name="EP Lead">
        <bpmn:flowNodeRef>W4682_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4682_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4682_Start5" name="Principal domestic/international trip">
        <bpmn:outgoing>W4682_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4682_Task6" name="For each principal trip, conduct the protective advance: destination threat…">
        <bpmn:documentation>Step 1: For each principal trip, conduct the protective advance: destination threat assessment (W4679), lodging/venue/transport vetting, route planning, medical/hospital identification, local security/law-enforcement liaison, and comms plan
Responsible (R): EP Advance / Travel Risk
Accountable (A): CSO
Duration: Per trip</bpmn:documentation>
        <bpmn:incoming>W4682_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4682_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4682_Task7" name="Deploy traveling EP and coordinate with the principal&#x27;s itinerary; maintain…">
        <bpmn:documentation>Step 2: Deploy traveling EP and coordinate with the principal&#x27;s itinerary; maintain GSOC check-in cadence (W4676) and traveler-tracking (W4687); manage deviations and emerging threats
Responsible (R): Traveling EP / GSOC
Accountable (A): CSO
Duration: Per trip</bpmn:documentation>
        <bpmn:incoming>W4682_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4682_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4682_Task8" name="Conduct post-trip debrief; capture intelligence and lessons; adjust…">
        <bpmn:documentation>Step 3: Conduct post-trip debrief; capture intelligence and lessons; adjust destination-risk (W4679) and future advance templates
Responsible (R): EP Lead
Accountable (A): CSO
Duration: Per trip</bpmn:documentation>
        <bpmn:incoming>W4682_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4682_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4682_End9" name="Complete">
        <bpmn:incoming>W4682_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4682_Annotation10">
        <bpmn:text>Controls: - CTL-708 (ensure controlled execution — Executive Protection, Principal Travel &amp; Event Security (PA-159.2).) | - CTL-708: protective advance completed per trip; GSOC check-in maintained; post-trip debrief
Owner: EP Lead / Travel Risk Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4682_Assoc11" sourceRef="W4682_Annotation10" targetRef="W4682_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4682_Flow12" sourceRef="W4682_Start5" targetRef="W4682_Task6" />
