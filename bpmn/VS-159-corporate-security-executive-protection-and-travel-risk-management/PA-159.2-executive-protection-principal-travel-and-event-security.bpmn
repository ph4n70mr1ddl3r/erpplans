      <bpmn:sequenceFlow id="W4681_Flow13" sourceRef="W4681_Task6" targetRef="W4681_Task7" />
      <bpmn:sequenceFlow id="W4681_Flow14" sourceRef="W4681_Task7" targetRef="W4681_End8" />
    </bpmn:process>
