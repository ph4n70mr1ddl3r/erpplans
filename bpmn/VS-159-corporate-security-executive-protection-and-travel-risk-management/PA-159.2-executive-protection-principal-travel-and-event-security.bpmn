    <bpmn:process id="W_W4684" name="W4684. Corporate Event, AGM &amp; High-Profile Appearance Security" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled corporate event / AGM / high-profile public appearance (VS-36 board)
Frequency: Per event
Volume: ~15–25 high-profile events/year (AGM, board meetings, major launches, trade shows VS-139, community events)
Owner: CSO / Event Security Manager
Participants: EP (W4681), Marketing/Events (VS-14/VS-139), Facilities (VS-138), law enforcement, guard force (W4677)
Source: workflow W4684 — Corporate Event, AGM &amp; High-Profile Appearance Security</bpmn:documentation>
      <bpmn:laneSet id="W4684_LaneSet3">
        <bpmn:lane id="W4684_Lane1" name="Event Security Manager">
        <bpmn:flowNodeRef>W4684_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4684_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4684_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4684_Lane2" name="CSO">
        <bpmn:flowNodeRef>W4684_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4684_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4684_Start4" name="Scheduled corporate event / AGM / high-profile public appearance (VS-36 board)">
        <bpmn:outgoing>W4684_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4684_Task5" name="Conduct event threat assessment (W4674) and venue security survey (access…">
        <bpmn:documentation>Step 1: Conduct event threat assessment (W4674) and venue security survey (access control, screening, perimeters, exit routes, medical, comms); coordinate with marketing/events (VS-14/VS-139) and venue/facilities (VS-138)
Responsible (R): Event Security Manager / Protective Intelligence
Accountable (A): CSO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4684_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4684_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4684_Task6" name="Staff and operate event security (screening, crowd management, principal…">
        <bpmn:documentation>Step 2: Staff and operate event security (screening, crowd management, principal protection W4681, protest/civil-unrest readiness W4692); coordinate law-enforcement liaison for high-profile events
Responsible (R): Event Security Manager / Guard Force / EP
Accountable (A): CSO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4684_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4684_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4684_Task7" name="Debrief post-event; capture intelligence, incidents, and lessons; adjust future…">
        <bpmn:documentation>Step 3: Debrief post-event; capture intelligence, incidents, and lessons; adjust future event-security templates
Responsible (R): CSO / Event Security Manager
Accountable (A): CSO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4684_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4684_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4684_End8" name="Complete">
        <bpmn:incoming>W4684_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4684_Annotation9">
        <bpmn:text>Controls: - CTL-708 (ensure controlled execution — Executive Protection, Principal Travel &amp; Event Security (PA-159.2).) | - CTL-708: every high-profile event has a threat assessment + venue survey; crowd/civil-unrest readiness; post-event debrief
Owner: CSO / Event Security Manager</bpmn:text>
      </bpmn:textAnnotation>
