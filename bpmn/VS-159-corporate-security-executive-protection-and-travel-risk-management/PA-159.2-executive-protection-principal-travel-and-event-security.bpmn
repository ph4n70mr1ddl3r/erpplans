        <bpmn:outgoing>W4685_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4685_Task6" name="Design and install residential security: perimeter (fencing, lighting…">
        <bpmn:documentation>Step 1: Design and install residential security: perimeter (fencing, lighting, sensors), access control, CCTV/panic-rooms, safe areas, comms, and guard posting scaled to the principal&#x27;s threat profile (W4678)
Responsible (R): Residential Security Manager / CSO
Accountable (A): CSO
Duration: Per residence</bpmn:documentation>
        <bpmn:incoming>W4685_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4685_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4685_Task7" name="Operate residential security: guard posting, alarm/CCTV monitoring (linked to…">
        <bpmn:documentation>Step 2: Operate residential security: guard posting, alarm/CCTV monitoring (linked to GSOC W4676), household-staff vetting, and household-security briefings; manage privacy of residence location (VS-91)
Responsible (R): Residential Security / Guard Force
Accountable (A): CSO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4685_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4685_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4685_Task8" name="Review residential security periodically and on threat change; coordinate with…">
        <bpmn:documentation>Step 3: Review residential security periodically and on threat change; coordinate with EP arrivals/departures (W4681/W4683) and residence-staff confidentiality
Responsible (R): CSO
Accountable (A): CSO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4685_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4685_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4685_End9" name="Complete">
        <bpmn:incoming>W4685_Flow15</bpmn:incoming>
      </bpmn:endEvent>
