    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4679_diag">
      <bpmndi:BPMNPlane id="W4679_plane" bpmnElement="W_W4679">
        <bpmndi:BPMNShape id="W4679_Lane1_di" bpmnElement="W4679_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
