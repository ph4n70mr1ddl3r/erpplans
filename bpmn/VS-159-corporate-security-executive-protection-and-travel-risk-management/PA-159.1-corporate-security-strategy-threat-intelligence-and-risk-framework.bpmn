    <bpmn:process id="W_W4674" name="W4674. Protective Intelligence &amp; Threat Assessment Program" isExecutable="false">
      <bpmn:documentation>Trigger: Threat indicator; pre-event/pre-travel; periodic principal review; tip from HR/LP/ethics
Frequency: Continuous + per case
Volume: ~dozens of assessments/yr (events, travel, principals, disgruntled-employee flags)
Owner: CSO / Protective Intelligence Lead
Participants: HR (VS-19/VS-84), LP (VS-23), Ethics (VS-119), Legal (VS-100.3), law-enforcement liaison
Source: workflow W4674 — Protective Intelligence &amp; Threat Assessment Program</bpmn:documentation>
      <bpmn:laneSet id="W4674_LaneSet3">
        <bpmn:lane id="W4674_Lane1" name="Protective Intelligence Lead">
        <bpmn:flowNodeRef>W4674_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4674_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4674_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4674_Lane2" name="CSO">
        <bpmn:flowNodeRef>W4674_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4674_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4674_Start4" name="Threat indicator; pre-event/pre-travel; periodic principal review; tip from HR/LP/ethics">
        <bpmn:outgoing>W4674_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4674_Task5" name="Operate the protective-intelligence function: intake threat indicators (from…">
        <bpmn:documentation>Step 1: Operate the protective-intelligence function: intake threat indicators (from OSINT/HUMINT W4675, HR disgruntled-employee flags VS-84/VS-150, LP VS-23, ethics hotline VS-119, social-media monitoring); triage and assess credibility, capability, and proximity
Responsible (R): Protective Intelligence Lead / CSO
Accountable (A): CSO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4674_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4674_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4674_Task6" name="Conduct threat assessments for principals (W4678), high-risk events (W4684)…">
        <bpmn:documentation>Step 2: Conduct threat assessments for principals (W4678), high-risk events (W4684), and pre-travel (W4687); assign a threat level and recommend protective posture (enhanced EP, route change, event cancellation, law-enforcement referral)
Responsible (R): Protective Intelligence Lead
Accountable (A): CSO / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4674_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4674_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4674_Task7" name="Document each assessment and decision; coordinate with Legal…">
        <bpmn:documentation>Step 3: Document each assessment and decision; coordinate with Legal (defamation/privacy limits VS-91/VS-100.3) and law enforcement (PNP/NBI) where a credible threat warrants; close and review the case
Responsible (R): CSO / Legal
Accountable (A): CSO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4674_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4674_End8" name="Complete">
        <bpmn:incoming>W4674_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4674_Annotation9">
        <bpmn:text>Controls: - CTL-707 (ensure controlled execution — Corporate Security Strategy, Threat Intelligence &amp; Risk Framework (PA-159.1).) | - CTL-707: assessments documented and evidence-based; Legal/privacy-compliant (VS-91/VS-100.3); law-enforcement referral where warranted
Owner: CSO / Protective Intelligence Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4674_Assoc10" sourceRef="W4674_Annotation9" targetRef="W4674_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4674_Flow11" sourceRef="W4674_Start4" targetRef="W4674_Task5" />
      <bpmn:sequenceFlow id="W4674_Flow12" sourceRef="W4674_Task5" targetRef="W4674_Task6" />
      <bpmn:sequenceFlow id="W4674_Flow13" sourceRef="W4674_Task6" targetRef="W4674_Task7" />
      <bpmn:sequenceFlow id="W4674_Flow14" sourceRef="W4674_Task7" targetRef="W4674_End8" />
    </bpmn:process>
