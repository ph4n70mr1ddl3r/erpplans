    <bpmn:process id="W_W4679" name="W4679. Travel Risk Intelligence, Geopolitical &amp; Kidnap/Extortion Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Executive/employee travel (W4687); geopolitical event; destination risk change
Frequency: Continuous + per trip
Volume: ~80–150 monitored executive and buyer trips/year (domestic inter-island + international sourcing VS-122)
Owner: Protective Intelligence Lead / Travel Risk Manager
Participants: CSO, Travel/Mobility (VS-160), Treasury (VS-18), Insurance (VS-26 K&amp;R), sourcing (VS-122)
Source: workflow W4679 — Travel Risk Intelligence, Geopolitical &amp; Kidnap/Extortion Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W4679_LaneSet2">
        <bpmn:lane id="W4679_Lane1" name="Travel Risk Manager">
        <bpmn:flowNodeRef>W4679_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4679_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4679_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4679_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4679_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4679_Start3" name="Executive/employee travel (W4687); geopolitical event; destination risk change">
        <bpmn:outgoing>W4679_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4679_Task4" name="Maintain destination-risk intelligence (crime, kidnap, civil-unrest, terrorism…">
        <bpmn:documentation>Step 1: Maintain destination-risk intelligence (crime, kidnap, civil-unrest, terrorism, health, natural-disaster ratings) for domestic Philippine regions and international sourcing destinations; refresh continuously
Responsible (R): Travel Risk Manager / Provider
Accountable (A): CSO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4679_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4679_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4679_Task5" name="For each high-risk trip (executive travel, cash-carrying VS-81, sourcing to…">
        <bpmn:documentation>Step 2: For each high-risk trip (executive travel, cash-carrying VS-81, sourcing to elevated-risk destinations), produce a travel-risk assessment and recommend posture (route/lodging, EP support, tracking, avoidance); brief the traveler (W4687)
Responsible (R): Travel Risk Manager / EP
Accountable (A): CSO
Duration: Per trip</bpmn:documentation>
        <bpmn:incoming>W4679_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4679_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4679_Task6" name="Monitor active-trip travelers for emerging threats (W4676 GSOC); maintain…">
        <bpmn:documentation>Step 3: Monitor active-trip travelers for emerging threats (W4676 GSOC); maintain K&amp;R/extortion response readiness (W4686) and feed travel-risk into mobility policy (VS-160)
Responsible (R): Travel Risk Manager / GSOC
Accountable (A): CSO
Duration: Per active trip</bpmn:documentation>
        <bpmn:incoming>W4679_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4679_End7" name="Complete">
        <bpmn:incoming>W4679_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4679_Annotation8">
        <bpmn:text>Controls: - CTL-166 (ensure executive-protection &amp; travel-risk control.) | - CTL-707: destination intelligence continuously refreshed; high-risk trips assessed and briefed; K&amp;R response readiness maintained
Owner: Protective Intelligence Lead / Travel Risk Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4679_Assoc9" sourceRef="W4679_Annotation8" targetRef="W4679_Start3" associationDirection="None" />
