        <bpmn:flowNodeRef>W5485_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5485_Lane3" name="Freight Analyst">
        <bpmn:flowNodeRef>W5485_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5485_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5485_Start5" name="3PL/ carrier contracting (VS-56/VS-110); RFP; annual carrier review">
        <bpmn:outgoing>W5485_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5485_Task6" name="Define BuildRight&#x27;s green-fleet requirements for carriers/3PLs…">
        <bpmn:documentation>Step 1: Define BuildRight&#x27;s green-fleet requirements for carriers/3PLs: fleet-age/emissions standards, alt-fuel/EV-share expectations over the contract term, driver-behavior/telematics data sharing, and MRV data provision (links W5481).
Responsible (R): Freight Procurement / ESG
Accountable (A): Freight Procurement &amp; Carrier Manager
Duration: per RFP</bpmn:documentation>
        <bpmn:incoming>W5485_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5485_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5485_Task7" name="Embed the green-fleet clauses in carrier/3PL contracts (links…">
        <bpmn:documentation>Step 2: Embed the green-fleet clauses in carrier/3PL contracts (links VS-110/VS-56/VS-161): emission targets, data-provision obligations, preferred-lane/EV assignment, and remedies for non-performance.
Responsible (R): Legal / Freight Procurement
Accountable (A): Freight Procurement &amp; Carrier Manager
Duration: per contract</bpmn:documentation>
        <bpmn:incoming>W5485_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5485_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5485_Task8" name="Collect carrier emissions/alt-fuel data (litres, kWh, tCO₂e per…">
        <bpmn:documentation>Step 3: Collect carrier emissions/alt-fuel data (litres, kWh, tCO₂e per BuildRight-attributed tonne-km) into the MRV (W5481); apply TPRM monitoring (VS-161).
Responsible (R): Freight Procurement / TPRM
Accountable (A): Freight Procurement &amp; Carrier Manager
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5485_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5485_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5485_Task9" name="Score carriers on a green-fleet scorecard (emissions performance, alt-fuel/EV…">
        <bpmn:documentation>Step 4: Score carriers on a green-fleet scorecard (emissions performance, alt-fuel/EV adoption progress, data quality, incidents) alongside the existing carrier scorecard (VS-110).
Responsible (R): Freight Analyst
Accountable (A): Freight Procurement &amp; Carrier Manager
Duration: quarterly</bpmn:documentation>
        <bpmn:incoming>W5485_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5485_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5485_Task10" name="Use the scorecard in carrier allocation and renewal decisions…">
        <bpmn:documentation>Step 5: Use the scorecard in carrier allocation and renewal decisions; recognize/develop leading carriers and remediate or exit poor performers (links VS-110 W3515 freight-audit/contract).
Responsible (R): Freight Procurement
Accountable (A): Freight Procurement &amp; Carrier Manager
Duration: per cycle</bpmn:documentation>
        <bpmn:incoming>W5485_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5485_End11" name="Complete">
        <bpmn:incoming>W5485_Flow19</bpmn:incoming>
      </bpmn:endEvent>
