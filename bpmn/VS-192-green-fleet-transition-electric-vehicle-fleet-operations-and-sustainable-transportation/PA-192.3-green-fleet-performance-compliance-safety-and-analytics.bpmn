    <bpmn:process id="W_W5482" name="W5482. DOE / LTO / LTFRB Green-Fleet Compliance, EV Inspection &amp; Franchise Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: EV/alt-fuel vehicles in service; annual inspection/franchise cycle; regulatory reporting
Frequency: Per inspection cycle; per franchise renewal; per reporting requirement
Volume: Per green-fleet vehicle and per for-hire/goods vehicle franchise
Owner: Regulatory &amp; Compliance Officer (VS-22/VS-166)
Participants: Fleet (VS-06), Legal (VS-100), ESG (VS-25), Maintenance (VS-06.2)
Source: workflow W5482 — DOE / LTO / LTFRB Green-Fleet Compliance, EV Inspection &amp; Franchise Reporting</bpmn:documentation>
      <bpmn:laneSet id="W5482_LaneSet4">
        <bpmn:lane id="W5482_Lane1" name="Fleet">
        <bpmn:flowNodeRef>W5482_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5482_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5482_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5482_Lane2" name="Regulatory Officer">
        <bpmn:flowNodeRef>W5482_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5482_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5482_Lane3" name="Regulatory">
        <bpmn:flowNodeRef>W5482_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5482_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5482_Start5" name="EV/alt-fuel vehicles in service; annual inspection/franchise cycle; regulatory reporting">
        <bpmn:outgoing>W5482_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5482_Task6" name="Maintain EV/alt-fuel vehicle registrations with the LTO under the EV-specific…">
        <bpmn:documentation>Step 1: Maintain EV/alt-fuel vehicle registrations with the LTO under the EV-specific path (W5470) and arrange annual motor-vehicle inspection (private inspection center / LTO) covering EV-specific items (battery/HV integrity where inspected).
Responsible (R): Fleet / Regulatory
Accountable (A): VP Legal &amp; Compliance
Duration: per cycle</bpmn:documentation>
        <bpmn:incoming>W5482_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5482_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5482_Task7" name="For goods/for-hire vehicles and the rental fleet (VS-162), maintain LTFRB…">
        <bpmn:documentation>Step 2: For goods/for-hire vehicles and the rental fleet (VS-162), maintain LTFRB franchise/CPC compliance and any EV-franchise incentives/requirements under EVIDA IRR.
Responsible (R): Fleet / Regulatory
Accountable (A): VP Legal &amp; Compliance
Duration: per renewal</bpmn:documentation>
        <bpmn:incoming>W5482_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5482_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5482_Task8" name="Report to the DOE/EVIDA Implementing Body any fleet-EV-share or program data…">
        <bpmn:documentation>Step 3: Report to the DOE/EVIDA Implementing Body any fleet-EV-share or program data called for under the EVIDA IRR and EV roadmap, and respond to DOE/LTO data calls.
Responsible (R): Regulatory Officer
Accountable (A): VP Legal &amp; Compliance
Duration: per call</bpmn:documentation>
        <bpmn:incoming>W5482_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5482_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5482_Task9" name="Coordinate any LGU EV-parking/charging ordinances (under RA 11697…">
        <bpmn:documentation>Step 4: Coordinate any LGU EV-parking/charging ordinances (under RA 11697 building/parking provisions) at new/remodel sites (VS-37/VS-109), ensuring compliance in the license portfolio (VS-166).
Responsible (R): Regulatory / Real Estate
Accountable (A): VP Legal &amp; Compliance
Duration: per site</bpmn:documentation>
        <bpmn:incoming>W5482_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5482_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5482_Task10" name="Maintain the green-fleet compliance evidence repository (LTO inspection, LTFRB…">
        <bpmn:documentation>Step 5: Maintain the green-fleet compliance evidence repository (LTO inspection, LTFRB franchise, DOE reporting, LGU EV compliance) for audit and VS-21.
Responsible (R): Regulatory Officer
Accountable (A): VP Legal &amp; Compliance
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5482_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5482_End11" name="Complete">
        <bpmn:incoming>W5482_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5482_Annotation12">
        <bpmn:text>Controls: - CTL-808 (ensure controlled execution — Green Fleet Performance, Compliance, Safety &amp; Analytics (PA-192.3).) | - operational: LTO/LTFRB/DOE permit/registration verification with statutory reporting compliance; inspection-before-renewal sequencing; central evidence repository.
Owner: Regulatory &amp; Compliance Officer (VS-22/VS-166)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5482_Assoc13" sourceRef="W5482_Annotation12" targetRef="W5482_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5482_Flow14" sourceRef="W5482_Start5" targetRef="W5482_Task6" />
      <bpmn:sequenceFlow id="W5482_Flow15" sourceRef="W5482_Task6" targetRef="W5482_Task7" />
      <bpmn:sequenceFlow id="W5482_Flow16" sourceRef="W5482_Task7" targetRef="W5482_Task8" />
      <bpmn:sequenceFlow id="W5482_Flow17" sourceRef="W5482_Task8" targetRef="W5482_Task9" />
      <bpmn:sequenceFlow id="W5482_Flow18" sourceRef="W5482_Task9" targetRef="W5482_Task10" />
      <bpmn:sequenceFlow id="W5482_Flow19" sourceRef="W5482_Task10" targetRef="W5482_End11" />
    </bpmn:process>
