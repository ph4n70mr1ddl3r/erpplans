        <bpmndi:BPMNShape id="W5482_Lane1_di" bpmnElement="W5482_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5482_Lane2_di" bpmnElement="W5482_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
