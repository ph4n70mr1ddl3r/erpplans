        <bpmndi:BPMNShape id="W5466_Task10_di" bpmnElement="W5466_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5466_Start5_di" bpmnElement="W5466_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
