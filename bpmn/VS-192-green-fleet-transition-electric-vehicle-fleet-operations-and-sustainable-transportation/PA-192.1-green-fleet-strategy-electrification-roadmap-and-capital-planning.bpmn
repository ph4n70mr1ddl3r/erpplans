      <bpmn:sequenceFlow id="W5465_Flow16" sourceRef="W5465_Task7" targetRef="W5465_Task8" />
      <bpmn:sequenceFlow id="W5465_Flow17" sourceRef="W5465_Task8" targetRef="W5465_Task9" />
      <bpmn:sequenceFlow id="W5465_Flow18" sourceRef="W5465_Task9" targetRef="W5465_Task10" />
      <bpmn:sequenceFlow id="W5465_Flow19" sourceRef="W5465_Task10" targetRef="W5465_End11" />
    </bpmn:process>
