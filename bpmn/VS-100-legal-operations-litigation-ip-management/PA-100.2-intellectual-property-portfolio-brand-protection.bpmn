        <bpmndi:BPMNShape id="W3266_End7_di" bpmnElement="W3266_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3266_Annotation8_di" bpmnElement="W3266_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3266_Flow10_di" bpmnElement="W3266_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3266_Flow11_di" bpmnElement="W3266_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3266_Flow12_di" bpmnElement="W3266_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3266_Flow13_di" bpmnElement="W3266_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3266_Assoc9_di" bpmnElement="W3266_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3267" name="W3267. IP Renewal, Maintenance &amp; Portfolio Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: Renewal deadline (trademark 10th year + every 10 years per RA 8293); portfolio review
Frequency: Continuous + annual review
Volume: Active registered IP portfolio
Owner: Legal Operations Manager
Participants: Legal Ops Mgr, IP Counsel, Finance (links to VS-15), IPOPHL Agent
Source: workflow W3267 — IP Renewal, Maintenance &amp; Portfolio Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W3267_LaneSet3">
        <bpmn:lane id="W3267_Lane1" name="Legal Ops Mgr">
        <bpmn:flowNodeRef>W3267_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3267_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3267_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3267_Lane2" name="IP Counsel">
        <bpmn:flowNodeRef>W3267_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3267_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3267_Start4" name="Renewal deadline (trademark 10th year + every 10 years per RA 8293); portfolio review">
        <bpmn:outgoing>W3267_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3267_Task5" name="Legal Ops Mgr maintain IP docket and renewal calendar: track all registrations…">
        <bpmn:documentation>Step 1: Legal Ops Mgr maintain IP docket and renewal calendar: track all registrations, renewal dates, grace periods, use-in-commerce requirements (Declaration of Actual Use — DAU per IPOPHL); generate renewal reminders with adequate lead time
Responsible (R): Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3267_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3267_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3267_Task6" name="Execute renewals and DAU filings: prepare and file renewals/DAU with IPOPHL via…">
        <bpmn:documentation>Step 2: Execute renewals and DAU filings: prepare and file renewals/DAU with IPOPHL via agent, pay fees (links to VS-15), submit evidence of use; manage international renewals where applicable
Responsible (R): IP Counsel / IPOPHL Agent / Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W3267_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3267_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3267_Task7" name="Portfolio lifecycle decisions: at renewal, assess whether mark/IP still in…">
        <bpmn:documentation>Step 3: Portfolio lifecycle decisions: at renewal, assess whether mark/IP still in use/strategic — renew, allow to lapse (save cost), or divest; update portfolio records and analytics (W3272); manage IP cleanup
Responsible (R): Legal Ops Mgr / IP Counsel / Marketing
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3267_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3267_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3267_End8" name="Complete">
        <bpmn:incoming>W3267_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3267_Annotation9">
        <bpmn:text>Controls: - CTL-154 (ensure legal matter &amp; IP portfolio control.) | - operational: docket calendar and lead-time reminders; operational: lifecycle review
Owner: Legal Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3267_Assoc10" sourceRef="W3267_Annotation9" targetRef="W3267_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3267_Flow11" sourceRef="W3267_Start4" targetRef="W3267_Task5" />
      <bpmn:sequenceFlow id="W3267_Flow12" sourceRef="W3267_Task5" targetRef="W3267_Task6" />
      <bpmn:sequenceFlow id="W3267_Flow13" sourceRef="W3267_Task6" targetRef="W3267_Task7" />
      <bpmn:sequenceFlow id="W3267_Flow14" sourceRef="W3267_Task7" targetRef="W3267_End8" />
    </bpmn:process>
