    <bpmn:process id="W_W3266" name="W3266. Trademark Search, Prosecution &amp; IPOPHL Filing" isExecutable="false">
      <bpmn:documentation>Trigger: New mark/design to protect (W3265)
Frequency: Per asset
Volume: ~5–15 new filings/year
Owner: IP Counsel
Participants: IP Counsel, IPOPHL Agent/External Counsel, Marketing (links to VS-14/VS-41), Finance
Source: workflow W3266 — Trademark Search, Prosecution &amp; IPOPHL Filing</bpmn:documentation>
      <bpmn:laneSet id="W3266_LaneSet2">
        <bpmn:lane id="W3266_Lane1" name="IP Counsel">
        <bpmn:flowNodeRef>W3266_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3266_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3266_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3266_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3266_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3266_Start3" name="New mark/design to protect (W3265)">
        <bpmn:outgoing>W3266_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3266_Task4" name="IP Counsel conduct clearance search: search IPOPHL database (and…">
        <bpmn:documentation>Step 1: IP Counsel conduct clearance search: search IPOPHL database (and Madrid/international where relevant) for identical/confusingly-similar marks in target classes (hardware/retail — classes 6, 7, 8, 19, 20, 35, etc.); assess registrability and infringement risk; advise on adoptability before launch investment
Responsible (R): IP Counsel / External Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Per mark</bpmn:documentation>
        <bpmn:incoming>W3266_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3266_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3266_Task5" name="File and prosecute application: prepare and file trademark/industrial-design…">
        <bpmn:documentation>Step 2: File and prosecute application: prepare and file trademark/industrial-design application with IPOPHL (Republic Act 8293 IP Code), respond to office actions, manage publication/opposition period, overcome oppositions; coordinate international filings (Madrid Protocol) where applicable
Responsible (R): IP Counsel / IPOPHL Agent
Accountable (A): VP Legal &amp; Compliance
Duration: Per mark</bpmn:documentation>
        <bpmn:incoming>W3266_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3266_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3266_Task6" name="Manage registration and recordation: receive certificate of registration…">
        <bpmn:documentation>Step 3: Manage registration and recordation: receive certificate of registration, record in IP portfolio (W3279), set renewal calendar (W3267); coordinate copyright deposit with the National Library where applicable; communicate protected status to Marketing/Merchandising for ® use
Responsible (R): IP Counsel / Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per mark</bpmn:documentation>
        <bpmn:incoming>W3266_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3266_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3266_End7" name="Complete">
        <bpmn:incoming>W3266_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3266_Annotation8">
        <bpmn:text>Controls: - CTL-530 (ensure controlled execution — Intellectual Property Portfolio &amp; Brand Protection (PA-100.2).) | - operational: thorough clearance search; operational: experienced counsel
Owner: IP Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3266_Assoc9" sourceRef="W3266_Annotation8" targetRef="W3266_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3266_Flow10" sourceRef="W3266_Start3" targetRef="W3266_Task4" />
      <bpmn:sequenceFlow id="W3266_Flow11" sourceRef="W3266_Task4" targetRef="W3266_Task5" />
      <bpmn:sequenceFlow id="W3266_Flow12" sourceRef="W3266_Task5" targetRef="W3266_Task6" />
      <bpmn:sequenceFlow id="W3266_Flow13" sourceRef="W3266_Task6" targetRef="W3266_End7" />
    </bpmn:process>
