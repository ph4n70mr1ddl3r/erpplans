        <bpmndi:BPMNShape id="W3267_End8_di" bpmnElement="W3267_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3267_Annotation9_di" bpmnElement="W3267_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3267_Flow11_di" bpmnElement="W3267_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3267_Flow12_di" bpmnElement="W3267_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3267_Flow13_di" bpmnElement="W3267_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3267_Flow14_di" bpmnElement="W3267_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3267_Assoc10_di" bpmnElement="W3267_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3268" name="W3268. IP Enforcement, Cease-and-Desist &amp; Infringement Action" isExecutable="false">
      <bpmn:documentation>Trigger: Infringement/counterfeit detected (links to VS-71); brand misuse; monitoring alert
Frequency: Event-driven
Volume: ~10–40 enforcement actions/year
Owner: IP Counsel
Participants: IP Counsel, VP Legal &amp; Compliance, Loss Prevention (links to VS-23/VS-71), Marketing (links to VS-14), External Counsel, Authorities (IPOPHL, NBI-IPRD, PNP, BOC)
Source: workflow W3268 — IP Enforcement, Cease-and-Desist &amp; Infringement Action</bpmn:documentation>
      <bpmn:laneSet id="W3268_LaneSet2">
        <bpmn:lane id="W3268_Lane1" name="IP Counsel">
        <bpmn:flowNodeRef>W3268_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3268_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3268_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3268_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3268_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3268_Start3" name="Infringement/counterfeit detected (links to VS-71); brand misuse; monitoring alert">
        <bpmn:outgoing>W3268_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3268_Task4" name="Detect and investigate infringement: market monitoring (online marketplaces per…">
        <bpmn:documentation>Step 1: Detect and investigate infringement: market monitoring (online marketplaces per VS-95, physical stores, social media per VS-14.2), anti-counterfeit detection (links to VS-71.2), gather evidence (test purchases, photographs, affidavits); assess scope and target
Responsible (R): IP Counsel / Loss Prevention / External Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3268_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3268_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3268_Task5" name="Enforce: send cease-and-desist/demand letter, file IPOPHL administrative…">
        <bpmn:documentation>Step 2: Enforce: send cease-and-desist/demand letter, file IPOPHL administrative action, or coordinate raid/seizure with NBI-IPRD/PNP/BOC (border measures per VS-87) for counterfeits; file civil infringement suit (W3257) or criminal complaint under RA 8293 where warranted; manage takedown requests with online platforms
Responsible (R): IP Counsel / External Counsel / Loss Prevention
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3268_Flow11</bpmn:incoming>
