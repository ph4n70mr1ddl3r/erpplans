    <bpmn:process id="W_W3265" name="W3265. Trademark, Copyright &amp; Industrial Design Portfolio Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: New brand/product launch (links to VS-41 private label); strategic cycle; expansion
Frequency: Annual + event-driven
Volume: BuildRight master brand + private-label/exclusive-brand marks (links to VS-41) + product packaging/designs + copyrighted materials
Owner: IP Counsel
Participants: IP Counsel, VP Legal &amp; Compliance, Marketing (links to VS-14), Merchandising/Private Label (links to VS-41), Legal Ops Mgr
Source: workflow W3265 — Trademark, Copyright &amp; Industrial Design Portfolio Strategy</bpmn:documentation>
      <bpmn:laneSet id="W3265_LaneSet2">
        <bpmn:lane id="W3265_Lane1" name="IP Counsel">
        <bpmn:flowNodeRef>W3265_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3265_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3265_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3265_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3265_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3265_Start3" name="New brand/product launch (links to VS-41 private label); strategic cycle; expansion">
        <bpmn:outgoing>W3265_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3265_Task4" name="IP Counsel/Marketing (links to VS-14/VS-41) develop IP portfolio strategy…">
        <bpmn:documentation>Step 1: IP Counsel/Marketing (links to VS-14/VS-41) develop IP portfolio strategy: identify protectable assets (word marks, logos, tagline &quot;Your Home Building Partner&quot;, private-label brand names, product designs/packaging, marketing creative, software), geographic scope (PH + export markets if applicable), filing priorities, budget; align with brand and private-label strategy
Responsible (R): IP Counsel / Marketing
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3265_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3265_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3265_Task5" name="Audit existing IP: inventory registered and unregistered IP, coverage gaps…">
        <bpmn:documentation>Step 2: Audit existing IP: inventory registered and unregistered IP, coverage gaps (unprotected marks/creations), renewal status (W3267), infringement exposure (links to VS-71 counterfeits); prioritize protection and cleanup actions
Responsible (R): IP Counsel / Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3265_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3265_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3265_Task6" name="Establish IP policy and ownership: clarify BuildRight ownership of…">
        <bpmn:documentation>Step 3: Establish IP policy and ownership: clarify BuildRight ownership of employee/contractor-created IP (work-for-hire, assignment clauses in employment per VS-19 and contractor per VS-98 and vendor per VS-03), use guidelines, brand-usage standards (links to VS-41.3); integrate to brand guidelines
Responsible (R): IP Counsel / HR / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3265_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3265_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3265_End7" name="Complete">
        <bpmn:incoming>W3265_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3265_Annotation8">
        <bpmn:text>Controls: - CTL-530 (ensure controlled execution — Intellectual Property Portfolio &amp; Brand Protection (PA-100.2).) | - operational: portfolio strategy and audits; operational: assignment clauses
Owner: IP Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3265_Assoc9" sourceRef="W3265_Annotation8" targetRef="W3265_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3265_Flow10" sourceRef="W3265_Start3" targetRef="W3265_Task4" />
      <bpmn:sequenceFlow id="W3265_Flow11" sourceRef="W3265_Task4" targetRef="W3265_Task5" />
      <bpmn:sequenceFlow id="W3265_Flow12" sourceRef="W3265_Task5" targetRef="W3265_Task6" />
      <bpmn:sequenceFlow id="W3265_Flow13" sourceRef="W3265_Task6" targetRef="W3265_End7" />
    </bpmn:process>
