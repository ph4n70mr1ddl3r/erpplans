      <bpmndi:BPMNPlane id="W3265_plane" bpmnElement="W_W3265">
        <bpmndi:BPMNShape id="W3265_Lane1_di" bpmnElement="W3265_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
