      <bpmndi:BPMNPlane id="W3266_plane" bpmnElement="W_W3266">
        <bpmndi:BPMNShape id="W3266_Lane1_di" bpmnElement="W3266_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
