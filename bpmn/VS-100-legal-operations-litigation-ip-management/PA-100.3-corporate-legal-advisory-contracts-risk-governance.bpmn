<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-100.3-corporate-legal-advisory-contracts-risk-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3273" name="W3273. Contract Template, Clause Library &amp; Legal Review Support" isExecutable="false">
      <bpmn:documentation>Trigger: New contract type; legal-review request; template refresh
Frequency: Continuous + annual template refresh
Volume: Hundreds–thousands of contracts/year across commercial/vendor/customer/real-estate
Owner: Legal Operations Manager
Participants: Legal Ops Mgr, In-House Counsel, Procurement (links to VS-03/VS-34), Sales (links to VS-11), VP Legal &amp; Compliance
Source: workflow W3273 — Contract Template, Clause Library &amp; Legal Review Support</bpmn:documentation>
      <bpmn:laneSet id="W3273_LaneSet3">
        <bpmn:lane id="W3273_Lane1" name="Legal Ops Mgr">
        <bpmn:flowNodeRef>W3273_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3273_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3273_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3273_Lane2" name="In-House Counsel">
        <bpmn:flowNodeRef>W3273_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3273_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3273_Start4" name="New contract type; legal-review request; template refresh">
        <bpmn:outgoing>W3273_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3273_Task5" name="Legal Ops Mgr/In-House Counsel maintain contract template library and clause…">
        <bpmn:documentation>Step 1: Legal Ops Mgr/In-House Counsel maintain contract template library and clause library: standard templates by type (vendor MSA per VS-03, customer/trade per VS-11, lease as lessee per VS-42 and lessor per VS-97, NDA per W3270, employment per VS-19, IP license per W3269), approved clause alternatives (limitation of liability, indemnity, termination, governing law, dispute resolution/ADR per W3260); version and publish
Responsible (R): Legal Ops Mgr / In-House Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W3273_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3273_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3273_Task6" name="Provide legal review support for non-standard contracts: triage incoming…">
        <bpmn:documentation>Step 2: Provide legal review support for non-standard contracts: triage incoming contracts (redlines, third-party paper), assess risk (commercial, legal, compliance, data-privacy per VS-91, anti-bribery per VS-86.3), negotiate key clauses, approve or escalate per authority matrix (links to VS-22 contract review W230)
Responsible (R): In-House Counsel / Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3273_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3273_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3273_Task7" name="Capture learnings into templates: incorporate recurring issues, regulatory…">
        <bpmn:documentation>Step 3: Capture learnings into templates: incorporate recurring issues, regulatory changes (links to VS-22.3), and dispute lessons (W3264) into clause library and templates; train business users on self-service of standard templates and escalation triggers
Responsible (R): Legal Ops Mgr / In-House Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3273_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3273_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3273_End8" name="Complete">
        <bpmn:incoming>W3273_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3273_Annotation9">
        <bpmn:text>Controls: - CTL-531 (ensure controlled execution — Corporate Legal Advisory, Contracts &amp; Risk Governance (PA-100.3).) | - operational: review SLA and clause standards; operational: annual refresh and regulatory monitoring (links to VS-22)
Owner: Legal Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3273_Assoc10" sourceRef="W3273_Annotation9" targetRef="W3273_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3273_Flow11" sourceRef="W3273_Start4" targetRef="W3273_Task5" />
      <bpmn:sequenceFlow id="W3273_Flow12" sourceRef="W3273_Task5" targetRef="W3273_Task6" />
      <bpmn:sequenceFlow id="W3273_Flow13" sourceRef="W3273_Task6" targetRef="W3273_Task7" />
      <bpmn:sequenceFlow id="W3273_Flow14" sourceRef="W3273_Task7" targetRef="W3273_End8" />
    </bpmn:process>
