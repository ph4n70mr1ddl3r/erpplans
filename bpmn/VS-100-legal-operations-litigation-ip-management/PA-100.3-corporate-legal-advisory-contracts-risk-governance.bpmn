    <bpmn:process id="W_W3280" name="W3280. Legal Department Performance &amp; Cost Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly legal review; budget cycle; board reporting
Frequency: Quarterly + annual
Volume: Legal department operations
Owner: Legal Operations Manager
Participants: Legal Ops Mgr, VP Legal &amp; Compliance, Finance (links to VS-17.4), Risk (links to VS-21.2), Board (links to VS-36.1)
Source: workflow W3280 — Legal Department Performance &amp; Cost Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3280_LaneSet3">
        <bpmn:lane id="W3280_Lane1" name="Legal Ops Mgr">
        <bpmn:flowNodeRef>W3280_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3280_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3280_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3280_Lane2" name="VP Legal &amp; Compliance">
        <bpmn:flowNodeRef>W3280_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3280_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3280_Start4" name="Quarterly legal review; budget cycle; board reporting">
        <bpmn:outgoing>W3280_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3280_Task5" name="Legal Ops Mgr/Finance compile legal-department analytics: matter portfolio…">
        <bpmn:documentation>Step 1: Legal Ops Mgr/Finance compile legal-department analytics: matter portfolio (W3264), outside-counsel spend and efficiency, in-house productivity (matters/counsel, cycle time), loss-contingency movement (W3277), enforcement outcomes (W3268), contract review throughput (W3273), whistleblower case metrics (W3278)
Responsible (R): Legal Ops Mgr / Finance
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3280_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3280_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3280_Task6" name="Manage legal budget and cost: in-house comp, outside-counsel spend (W3259)…">
        <bpmn:documentation>Step 2: Manage legal budget and cost: in-house comp, outside-counsel spend (W3259), legal-tech (W3279), court/fees, settlements/judgments (W3261); forecast vs budget (links to VS-33/VS-17.4), identify cost drivers and efficiency opportunities (in-source work, fixed-fee, prevention)
Responsible (R): Legal Ops Mgr / Finance
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3280_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3280_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3280_Task7" name="Report to executive committee and board (links to VS-36.1): legal-department…">
        <bpmn:documentation>Step 3: Report to executive committee and board (links to VS-36.1): legal-department performance, cost, risk posture, prevention initiatives, value delivered (recovery, avoidance); drive continuous improvement and preventive legal strategy
Responsible (R): VP Legal &amp; Compliance / Legal Ops Mgr
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3280_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3280_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3280_End8" name="Complete">
        <bpmn:incoming>W3280_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3280_Annotation9">
        <bpmn:text>Controls: - CTL-531 (ensure controlled execution — Corporate Legal Advisory, Contracts &amp; Risk Governance (PA-100.3).) | - operational: e-billing and analytics; operational: prevention analytics and contract/policy improvement
Owner: Legal Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
