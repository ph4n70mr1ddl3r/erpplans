    <bpmn:process id="W_W3274" name="W3274. Contract Lifecycle Support &amp; Obligation Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Contract execution; obligation milestone; renewal/expiry
Frequency: Continuous
Volume: Thousands of active contracts
Owner: Legal Operations Manager
Participants: Legal Ops Mgr, Business Owner, Procurement (links to VS-34), Finance, Records (links to VS-88)
Source: workflow W3274 — Contract Lifecycle Support &amp; Obligation Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3274_LaneSet2">
        <bpmn:lane id="W3274_Lane1" name="Legal Ops Mgr">
        <bpmn:flowNodeRef>W3274_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3274_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3274_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3274_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3274_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3274_Start3" name="Contract execution; obligation milestone; renewal/expiry">
        <bpmn:outgoing>W3274_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3274_Task4" name="Legal Ops Mgr register executed contracts in contract repository: parties…">
        <bpmn:documentation>Step 1: Legal Ops Mgr register executed contracts in contract repository: parties, type, value, term, key obligations, renewal/expiry, governing law, special conditions; link to source documents (links to VS-88) and vendor/customer master (links to VS-29)
Responsible (R): Legal Ops Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3274_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3274_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3274_Task5" name="Track obligations and milestones: automated alerts for renewals…">
        <bpmn:documentation>Step 2: Track obligations and milestones: automated alerts for renewals, price-adjustment windows, notice deadlines, audit rights, insurance-certificate renewals (links to VS-26), compliance certifications; route to responsible business owner for action
Responsible (R): Legal Ops Mgr / Business Owner
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3274_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3274_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3274_Task6" name="Manage contract performance and disputes: monitor performance against terms…">
        <bpmn:documentation>Step 3: Manage contract performance and disputes: monitor performance against terms, flag breaches, manage amendments/change orders, initiate dispute resolution (W3260/W3257) where needed; archive at termination (links to VS-88)
Responsible (R): Legal Ops Mgr / Business Owner
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3274_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3274_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3274_End7" name="Complete">
        <bpmn:incoming>W3274_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3274_Annotation8">
        <bpmn:text>Controls: - CTL-154 (ensure legal matter &amp; IP portfolio control.) | - operational: alerts and calendar; operational: obligation register
Owner: Legal Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3274_Assoc9" sourceRef="W3274_Annotation8" targetRef="W3274_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3274_Flow10" sourceRef="W3274_Start3" targetRef="W3274_Task4" />
      <bpmn:sequenceFlow id="W3274_Flow11" sourceRef="W3274_Task4" targetRef="W3274_Task5" />
      <bpmn:sequenceFlow id="W3274_Flow12" sourceRef="W3274_Task5" targetRef="W3274_Task6" />
      <bpmn:sequenceFlow id="W3274_Flow13" sourceRef="W3274_Task6" targetRef="W3274_End7" />
    </bpmn:process>
