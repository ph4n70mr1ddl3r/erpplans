      <bpmn:startEvent id="W3279_Start3" name="System need; vendor invoice; technology refresh">
        <bpmn:outgoing>W3279_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3279_Task4" name="Legal Ops Mgr/IT (links to VS-27) operate legal-technology stack…">
        <bpmn:documentation>Step 1: Legal Ops Mgr/IT (links to VS-27) operate legal-technology stack: matter-management (W3257), e-billing and spend management (W3259), e-discovery (links to VS-88 W2990), contract lifecycle management (W3273/W3274), IP docket (PA-100.2), legal-hold (W3262), whistleblower/ethics case (W3278); integrate with ERP/document systems (links to VS-88)
Responsible (R): Legal Ops Mgr / IT
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3279_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3279_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3279_Task5" name="Manage e-billing: route outside-counsel invoices through e-billing system…">
        <bpmn:documentation>Step 2: Manage e-billing: route outside-counsel invoices through e-billing system, enforce billing guidelines and rate cards (W3259), automated checks (duplicate, rate, disallowable expenses), approvals, allocation to matter/entity/cost center (links to VS-72), analytics on spend
Responsible (R): Legal Ops Mgr / Finance
Accountable (A): VP Legal &amp; Compliance
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W3279_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3279_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3279_Task6" name="Govern legal-technology: vendor management (W3255-style for legal-tech…">
        <bpmn:documentation>Step 3: Govern legal-technology: vendor management (W3255-style for legal-tech vendors), data privacy/security (links to VS-27.3/VS-91 — legal data is highly sensitive), access controls, periodic review of tech stack for optimization; manage legal-tech budget (W3280)
Responsible (R): Legal Ops Mgr / IT / Security
Accountable (A): VP Legal &amp; Compliance
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W3279_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3279_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3279_End7" name="Complete">
        <bpmn:incoming>W3279_Flow13</bpmn:incoming>
      </bpmn:endEvent>
