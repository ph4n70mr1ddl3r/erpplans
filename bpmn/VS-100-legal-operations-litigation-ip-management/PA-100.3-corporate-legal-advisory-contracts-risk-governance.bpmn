    <bpmn:process id="W_W3279" name="W3279. Legal Operations Technology &amp; e-Billing" isExecutable="false">
      <bpmn:documentation>Trigger: System need; vendor invoice; technology refresh
Frequency: Continuous + project
Volume: Enterprise legal-ops technology
Owner: Legal Operations Manager
Participants: Legal Ops Mgr, IT (links to VS-27/VS-99), Finance, VP Legal &amp; Compliance, Vendors
Source: workflow W3279 — Legal Operations Technology &amp; e-Billing</bpmn:documentation>
      <bpmn:laneSet id="W3279_LaneSet2">
        <bpmn:lane id="W3279_Lane1" name="Legal Ops Mgr">
