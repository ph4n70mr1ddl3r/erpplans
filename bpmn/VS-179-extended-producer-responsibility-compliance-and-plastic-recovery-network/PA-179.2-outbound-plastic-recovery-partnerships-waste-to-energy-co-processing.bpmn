      <bpmn:startEvent id="W5168_Start3" name="EPR logistics / baling operations; DOLE OSH audit (VS-24)">
        <bpmn:outgoing>W5168_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5168_Task4" name="Establish Standard Operating Procedures (SOPs) for operating plastic baling and…">
        <bpmn:documentation>Step 1: Establish Standard Operating Procedures (SOPs) for operating plastic baling and compaction machinery.
Responsible (R): DC Safety Officer / OSH Manager (VS-24)
Accountable (A): DC Safety Officer / OSH Manager (VS-24)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5168_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5168_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5168_Task5" name="Train staff: run mandatory safety training on machine lock-out/tag-out, bale…">
        <bpmn:documentation>Step 2: Train staff: run mandatory safety training on machine lock-out/tag-out, bale handling, and ergonomic lifting.
Responsible (R): DC Safety Officer / OSH Manager (VS-24)
Accountable (A): DC Safety Officer / OSH Manager (VS-24)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5168_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5168_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5168_Task6" name="Enforce PPE compliance: require safety boots, heavy gloves, safety glasses, and…">
        <bpmn:documentation>Step 3: Enforce PPE compliance: require safety boots, heavy gloves, safety glasses, and ear protection around balers (VS-169).
Responsible (R): DC Safety Officer / OSH Manager (VS-24)
Accountable (A): DC Safety Officer / OSH Manager (VS-24)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5168_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5168_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5168_Task7" name="Conduct quarterly fire risk assessments in dry plastic storage zones; verify…">
        <bpmn:documentation>Step 4: Conduct quarterly fire risk assessments in dry plastic storage zones; verify fire extinguishers are serviced and clear.
Responsible (R): DC Safety Officer / OSH Manager (VS-24)
Accountable (A): DC Safety Officer / OSH Manager (VS-24)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5168_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5168_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5168_End8" name="Complete">
        <bpmn:incoming>W5168_Flow15</bpmn:incoming>
      </bpmn:endEvent>
