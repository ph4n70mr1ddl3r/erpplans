    <bpmn:process id="W_W5163" name="W5163. Junk Shop &amp; Informal Waste Collector Network Registration &amp; Incentivization" isExecutable="false">
      <bpmn:documentation>Trigger: EPR local recovery network launch
Frequency: Monthly onboarding
Volume: ~150–200 registered informal waste collectors / junk shops
Owner: EPR Procurement Specialist
Participants: Junk Shop Owners, Waste Collectors, Finance (VS-17.4), CSR Foundation (VS-152)
Source: workflow W5163 — Junk Shop &amp; Informal Waste Collector Network Registration &amp; Incentivization</bpmn:documentation>
      <bpmn:laneSet id="W5163_LaneSet2">
        <bpmn:lane id="W5163_Lane1" name="EPR Procurement Specialist">
        <bpmn:flowNodeRef>W5163_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5163_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5163_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5163_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5163_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5163_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5163_Start3" name="EPR local recovery network launch">
        <bpmn:outgoing>W5163_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5163_Task4" name="Register local junk shops and informal collector cooperatives in BuildRight&#x27;s…">
        <bpmn:documentation>Step 1: Register local junk shops and informal collector cooperatives in BuildRight&#x27;s EPR partner network.
Responsible (R): EPR Procurement Specialist
Accountable (A): EPR Procurement Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5163_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5163_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5163_Task5" name="Provide weighing scales (VS-115) and protective equipment (PPE - VS-169) to…">
        <bpmn:documentation>Step 2: Provide weighing scales (VS-115) and protective equipment (PPE - VS-169) to registered informal collectors.
Responsible (R): EPR Procurement Specialist
Accountable (A): EPR Procurement Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5163_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5163_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5163_Task6" name="Establish the BuildRight Plastic Buying Premium: pay a cash premium above local…">
        <bpmn:documentation>Step 3: Establish the BuildRight Plastic Buying Premium: pay a cash premium above local market rates for targeted plastics delivered to BuildRight stores/DCs.
Responsible (R): EPR Procurement Specialist
Accountable (A): EPR Procurement Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5163_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5163_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5163_Task7" name="Reconcile delivered weights, issue payment receipts, and record collectors&#x27;…">
        <bpmn:documentation>Step 4: Reconcile delivered weights, issue payment receipts, and record collectors&#x27; livelihood metrics (VS-152).
Responsible (R): EPR Procurement Specialist
Accountable (A): EPR Procurement Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5163_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5163_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5163_End8" name="Complete">
        <bpmn:incoming>W5163_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5163_Annotation9">
        <bpmn:text>Controls: - CTL-170 (ensure EPR recovery &amp; registration compliance.) | - CTL-768: Weighing certified on calibrated scales; payout receipts require dual cashier sign-off.
Owner: EPR Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
