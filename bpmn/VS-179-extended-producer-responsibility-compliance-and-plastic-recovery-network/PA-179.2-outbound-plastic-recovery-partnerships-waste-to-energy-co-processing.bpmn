    <bpmn:process id="W_W5168" name="W5168. Multi-Region Recovery Operations Safety &amp; OSH Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: EPR logistics / baling operations; DOLE OSH audit (VS-24)
Frequency: Continuous safety enforcement + quarterly audits
Volume: 4 DCs and 200 store collection zones monitored
Owner: DC Safety Officer / OSH Manager (VS-24)
Participants: Store Managers, Logistics operators, DOLE Representative
Source: workflow W5168 — Multi-Region Recovery Operations Safety &amp; OSH Compliance</bpmn:documentation>
      <bpmn:laneSet id="W5168_LaneSet2">
        <bpmn:lane id="W5168_Lane1" name="DC Safety Officer">
        <bpmn:flowNodeRef>W5168_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5168_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5168_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5168_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5168_Start3</bpmn:flowNodeRef>
