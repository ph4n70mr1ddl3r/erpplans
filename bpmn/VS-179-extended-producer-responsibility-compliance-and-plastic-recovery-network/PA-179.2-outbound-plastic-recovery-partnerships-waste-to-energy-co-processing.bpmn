    <bpmn:process id="W_W5162" name="W5162. LGU/MRF (Materials Recovery Facility) Plastic Waste Recovery Collaboration" isExecutable="false">
      <bpmn:documentation>Trigger: LGU partnership initiative; regional EPR program expansion
Frequency: Continuous per LGU project
Volume: ~40–50 LGU partnerships active across six regions
Owner: EPR Regional Coordinator / Government Affairs Manager (VS-104)
Participants: LGU Solid Waste Management Board, Barangay Captains, CSR team (VS-152)
Source: workflow W5162 — LGU/MRF (Materials Recovery Facility) Plastic Waste Recovery Collaboration</bpmn:documentation>
      <bpmn:laneSet id="W5162_LaneSet2">
        <bpmn:lane id="W5162_Lane1" name="EPR Regional Coordinator">
        <bpmn:flowNodeRef>W5162_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5162_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5162_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5162_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5162_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5162_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5162_Start3" name="LGU partnership initiative; regional EPR program expansion">
        <bpmn:outgoing>W5162_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5162_Task4" name="Identify target municipalities with active Materials Recovery Facilities (MRFs).">
        <bpmn:documentation>Step 1: Identify target municipalities with active Materials Recovery Facilities (MRFs).
Responsible (R): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Accountable (A): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5162_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5162_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5162_Task5" name="Draft MOA for Plastic Waste Sorting &amp; Supply: BuildRight provides sorting…">
        <bpmn:documentation>Step 2: Draft MOA for Plastic Waste Sorting &amp; Supply: BuildRight provides sorting equipment, waste bins, or LGU funding in exchange for clean segregated consumer plastics collected by LGU sweepers.
Responsible (R): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Accountable (A): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5162_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5162_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5162_Task6" name="Establish weekly collection schedule at LGU MRFs; transport collected plastics…">
        <bpmn:documentation>Step 3: Establish weekly collection schedule at LGU MRFs; transport collected plastics to BuildRight consolidation hubs or direct to recovery partners.
Responsible (R): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Accountable (A): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5162_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5162_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5162_Task7" name="Log recovered weights in the LGU partnership dashboard.">
        <bpmn:documentation>Step 4: Log recovered weights in the LGU partnership dashboard.
Responsible (R): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Accountable (A): EPR Regional Coordinator / Government Affairs Manager (VS-104)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5162_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5162_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5162_End8" name="Complete">
        <bpmn:incoming>W5162_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5162_Annotation9">
        <bpmn:text>Controls: - CTL-170 (ensure EPR recovery &amp; registration compliance.) | - CTL-768: MOA approved by Legal and LGU Council; monthly weight receipts verified by LGU Treasurer.
Owner: EPR Regional Coordinator / Government Affairs Manager (VS-104)</bpmn:text>
      </bpmn:textAnnotation>
