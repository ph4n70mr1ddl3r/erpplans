        <bpmn:outgoing>W5167_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5167_Task4" name="Request formal Co-Processing Certificates or Plastic Recovery Certificates…">
        <bpmn:documentation>Step 1: Request formal Co-Processing Certificates or Plastic Recovery Certificates (PRC) from partners for every delivered batch.
Responsible (R): EPR Compliance Manager
Accountable (A): EPR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5167_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5167_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5167_Task5" name="Verify certificates: cross-reference certificate weights against DC dispatch…">
        <bpmn:documentation>Step 2: Verify certificates: cross-reference certificate weights against DC dispatch weight and carrier logs.
Responsible (R): EPR Compliance Manager
Accountable (A): EPR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5167_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5167_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5167_Task6" name="Compile the recovery audit trail folder: weighbridge tickets, delivery…">
        <bpmn:documentation>Step 3: Compile the recovery audit trail folder: weighbridge tickets, delivery receipts, photos of processing, and signed certificates.
Responsible (R): EPR Compliance Manager
Accountable (A): EPR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5167_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5167_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5167_Task7" name="Upload compliance folders to the secure EPR compliance archive (VS-88).">
        <bpmn:documentation>Step 4: Upload compliance folders to the secure EPR compliance archive (VS-88).
Responsible (R): EPR Compliance Manager
Accountable (A): EPR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5167_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5167_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5167_End8" name="Complete">
        <bpmn:incoming>W5167_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5167_Annotation9">
        <bpmn:text>Controls: - CTL-768 (ensure controlled execution — Outbound Plastic Recovery Partnerships &amp; Waste-to-Energy Co-Processing (PA-179.2).) | - CTL-768: Audit trails checked monthly by internal audit; matching verified before payment release.
Owner: EPR Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
