    <bpmn:process id="W_W5161" name="W5161. Retail Store In-Store Plastic Waste Sorting, Collection &amp; Storage" isExecutable="false">
      <bpmn:documentation>Trigger: Store daily operations; store cleanup routines (VS-07)
Frequency: Daily collection
Volume: 200 stores collecting ~2–3 metric tons of plastic waste monthly
Owner: Store Manager / Store LP Officer (VS-23)
Participants: Stock Associates (VS-07), Store Staff, Cleaning Service (VS-98)
Source: workflow W5161 — Retail Store In-Store Plastic Waste Sorting, Collection &amp; Storage</bpmn:documentation>
      <bpmn:laneSet id="W5161_LaneSet2">
        <bpmn:lane id="W5161_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W5161_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5161_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5161_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5161_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5161_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5161_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5161_Start3" name="Store daily operations; store cleanup routines (VS-07)">
        <bpmn:outgoing>W5161_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5161_Task4" name="Set up clearly labeled Customer Recycling Bins at checkout areas and customer…">
        <bpmn:documentation>Step 1: Set up clearly labeled Customer Recycling Bins at checkout areas and customer service counters.
Responsible (R): Store Manager / Store LP Officer (VS-23)
Accountable (A): Store Manager / Store LP Officer (VS-23)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5161_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5161_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5161_Task5" name="Sort packaging waste in receiving area: separate clean LDPE stretch wrap…">
        <bpmn:documentation>Step 2: Sort packaging waste in receiving area: separate clean LDPE stretch wrap, bubble wrap, plastic bands, and PET containers generated during receiving operations.
Responsible (R): Store Manager / Store LP Officer (VS-23)
Accountable (A): Store Manager / Store LP Officer (VS-23)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5161_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5161_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5161_Task6" name="Compact and bale sorted plastics using store compaction equipment; label bales…">
        <bpmn:documentation>Step 3: Compact and bale sorted plastics using store compaction equipment; label bales with store ID, weight, and date.
Responsible (R): Store Manager / Store LP Officer (VS-23)
Accountable (A): Store Manager / Store LP Officer (VS-23)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5161_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5161_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5161_Task7" name="Stage compacted plastic bales in designated dry storage zones to prevent…">
        <bpmn:documentation>Step 4: Stage compacted plastic bales in designated dry storage zones to prevent moisture and fire hazards (VS-24).
Responsible (R): Store Manager / Store LP Officer (VS-23)
Accountable (A): Store Manager / Store LP Officer (VS-23)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5161_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5161_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5161_End8" name="Complete">
        <bpmn:incoming>W5161_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5161_Annotation9">
        <bpmn:text>Controls: - CTL-768 (ensure controlled execution — Outbound Plastic Recovery Partnerships &amp; Waste-to-Energy Co-Processing (PA-179.2).) | - CTL-768: Weekly safety inspection checks storage zones; store weight logs verified by Regional LP (VS-23).
Owner: Store Manager / Store LP Officer (VS-23)</bpmn:text>
      </bpmn:textAnnotation>
