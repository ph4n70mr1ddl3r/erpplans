    <bpmn:process id="W_W5169" name="W5169. EPR Plastic Waste Recovery Certificate (PRC) Verification &amp; Matching" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly compliance close; receipt of PRC from PRO or recovery partners
Frequency: Quarterly
Volume: ~40–50 certificates verified quarterly
Owner: EPR Compliance Manager / Internal Auditor (VS-21)
Participants: PRO Representatives, Finance (VS-17.4)
Source: workflow W5169 — EPR Plastic Waste Recovery Certificate (PRC) Verification &amp; Matching</bpmn:documentation>
      <bpmn:laneSet id="W5169_LaneSet2">
        <bpmn:lane id="W5169_Lane1" name="EPR Compliance Manager">
        <bpmn:flowNodeRef>W5169_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5169_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5169_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5169_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5169_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5169_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5169_Start3" name="Quarterly compliance close; receipt of PRC from PRO or recovery partners">
        <bpmn:outgoing>W5169_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5169_Task4" name="Collect all original PRCs released by partners and the PRO.">
        <bpmn:documentation>Step 1: Collect all original PRCs released by partners and the PRO.
Responsible (R): EPR Compliance Manager / Internal Auditor (VS-21)
Accountable (A): EPR Compliance Manager / Internal Auditor (VS-21)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5169_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5169_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5169_Task5" name="Verify authenticity: match security seals, certificate IDs, and registered…">
        <bpmn:documentation>Step 2: Verify authenticity: match security seals, certificate IDs, and registered signatures against NSWMC registry.
Responsible (R): EPR Compliance Manager / Internal Auditor (VS-21)
Accountable (A): EPR Compliance Manager / Internal Auditor (VS-21)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5169_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5169_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5169_Task6" name="Match certified weights against net distributed plastic footprint (W5157) for…">
        <bpmn:documentation>Step 3: Match certified weights against net distributed plastic footprint (W5157) for the corresponding quarter.
Responsible (R): EPR Compliance Manager / Internal Auditor (VS-21)
Accountable (A): EPR Compliance Manager / Internal Auditor (VS-21)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5169_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5169_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5169_Task7" name="Calculate the net recovery status: determine if target volume (e.g. 20%) is met…">
        <bpmn:documentation>Step 4: Calculate the net recovery status: determine if target volume (e.g. 20%) is met or if a recovery gap exists.
Responsible (R): EPR Compliance Manager / Internal Auditor (VS-21)
Accountable (A): EPR Compliance Manager / Internal Auditor (VS-21)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5169_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5169_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5169_End8" name="Complete">
        <bpmn:incoming>W5169_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5169_Annotation9">
        <bpmn:text>Controls: - CTL-769 (ensure controlled execution — EPR Credit Trading, Compliance Auditing &amp; Annual Reporting (PA-179.3).) | - CTL-769: Dual sign-off (Compliance Manager + Head of Internal Audit &amp; Risk) required for quarterly PRC reconciliation report.
Owner: EPR Compliance Manager / Internal Auditor (VS-21)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5169_Assoc10" sourceRef="W5169_Annotation9" targetRef="W5169_Start3" associationDirection="None" />
