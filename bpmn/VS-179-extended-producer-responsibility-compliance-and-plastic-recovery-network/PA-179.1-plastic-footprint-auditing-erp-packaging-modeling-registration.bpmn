        <bpmn:lane id="W5159_Lane1" name="EPR Compliance Manager">
        <bpmn:flowNodeRef>W5159_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5159_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5159_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5159_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5159_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5159_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5159_Start3" name="Approved EPR strategy; annual compliance program review">
        <bpmn:outgoing>W5159_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5159_Task4" name="Conduct due diligence on accredited Producer Responsibility Organizations…">
        <bpmn:documentation>Step 1: Conduct due diligence on accredited Producer Responsibility Organizations (PROs) in the Philippines.
Responsible (R): EPR Compliance Manager / Sustainability/ESG Manager
Accountable (A): EPR Compliance Manager / Sustainability/ESG Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5159_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5159_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5159_Task5" name="Negotiate PRO Service Level Agreement (SLA): define fee structures, target…">
        <bpmn:documentation>Step 2: Negotiate PRO Service Level Agreement (SLA): define fee structures, target recovery volumes assigned, reporting timelines, and recovery certification audit rules.
Responsible (R): EPR Compliance Manager / Sustainability/ESG Manager
Accountable (A): EPR Compliance Manager / Sustainability/ESG Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5159_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5159_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5159_Task6" name="Submit monthly plastic footprint reports (W5157) to the PRO; coordinate payment…">
        <bpmn:documentation>Step 3: Submit monthly plastic footprint reports (W5157) to the PRO; coordinate payment of PRO admin and recovery fees.
Responsible (R): EPR Compliance Manager / Sustainability/ESG Manager
Accountable (A): EPR Compliance Manager / Sustainability/ESG Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5159_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5159_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5159_Task7" name="Conduct quarterly reviews of PRO performance: track actual recovered volume…">
        <bpmn:documentation>Step 4: Conduct quarterly reviews of PRO performance: track actual recovered volume against contractual targets.
Responsible (R): EPR Compliance Manager / Sustainability/ESG Manager
Accountable (A): EPR Compliance Manager / Sustainability/ESG Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5159_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5159_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5159_End8" name="Complete">
        <bpmn:incoming>W5159_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5159_Annotation9">
        <bpmn:text>Controls: - CTL-767 (ensure controlled execution — Plastic Footprint Auditing, ERP Packaging Modeling &amp; Registration (PA-179.1).) | - CTL-767: PRO contracts approved by VP Legal and COO; payments authorized only upon receipt of accredited recovery audit documents.
Owner: EPR Compliance Manager / Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
