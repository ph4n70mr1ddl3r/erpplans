    <bpmn:process id="W_W5153" name="W5153. Plastic Packaging Footprint Baseline Audit &amp; Material Taxonomy Setup" isExecutable="false">
      <bpmn:documentation>Trigger: EPR program launch; annual compliance planning (VS-25)
Frequency: Annual + strategy refresh
Volume: 1 comprehensive audit of 35,000 active SKUs
Owner: Sustainability/ESG Manager / EPR Compliance Manager
Participants: Merchandising Category Managers (VS-01), Master Data Team (VS-29), Procurement (VS-03), External Auditor
Source: workflow W5153 — Plastic Packaging Footprint Baseline Audit &amp; Material Taxonomy Setup</bpmn:documentation>
      <bpmn:laneSet id="W5153_LaneSet2">
        <bpmn:lane id="W5153_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W5153_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5153_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5153_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5153_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5153_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5153_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5153_Start3" name="EPR program launch; annual compliance planning (VS-25)">
        <bpmn:outgoing>W5153_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5153_Task4" name="Define plastic material categories per RA 11898 (rigid plastic, flexible…">
        <bpmn:documentation>Step 1: Define plastic material categories per RA 11898 (rigid plastic, flexible single-layer, flexible multi-layer, polystyrene).
Responsible (R): Sustainability/ESG Manager / EPR Compliance Manager
Accountable (A): Sustainability/ESG Manager / EPR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5153_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5153_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5153_Task5" name="Audit packaging weight and type for all active SKUs (~35,000; item-master…">
        <bpmn:documentation>Step 2: Audit packaging weight and type for all active SKUs (~35,000; item-master extraction + sample weighing, team-based), focusing on private label products and transit packaging (stretch wraps, bubble wraps).
Responsible (R): Sustainability/ESG Manager / EPR Compliance Manager
Accountable (A): Sustainability/ESG Manager / EPR Compliance Manager
Duration: 2–3 weeks (team-based, within the 4–6-week window)</bpmn:documentation>
        <bpmn:incoming>W5153_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5153_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5153_Task6" name="Establish the BuildRight Plastic Packaging Taxonomy and map SKUs to their…">
        <bpmn:documentation>Step 3: Establish the BuildRight Plastic Packaging Taxonomy and map SKUs to their respective packaging profiles.
Responsible (R): Sustainability/ESG Manager / EPR Compliance Manager
Accountable (A): Sustainability/ESG Manager / EPR Compliance Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5153_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5153_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5153_Task7" name="Calculate the baseline annual plastic footprint (in metric tons) using trailing…">
        <bpmn:documentation>Step 4: Calculate the baseline annual plastic footprint (in metric tons) using trailing 12-month sales and import volumes.
Responsible (R): Sustainability/ESG Manager / EPR Compliance Manager
Accountable (A): Sustainability/ESG Manager / EPR Compliance Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W5153_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5153_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5153_End8" name="Complete">
        <bpmn:incoming>W5153_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5153_Annotation9">
        <bpmn:text>Controls: - CTL-170 (ensure EPR recovery &amp; registration compliance.) | - CTL-767: Baseline footprint signed off by external environmental auditor; taxonomy mapping locked in master data.
Owner: Sustainability/ESG Manager / EPR Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5153_Assoc10" sourceRef="W5153_Annotation9" targetRef="W5153_Start3" associationDirection="None" />
