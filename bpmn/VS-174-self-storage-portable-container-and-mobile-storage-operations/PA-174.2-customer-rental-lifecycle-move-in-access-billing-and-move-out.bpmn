        <bpmn:flowNodeRef>W5045_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5045_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5045_Lane2" name="Driver">
        <bpmn:flowNodeRef>W5045_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5045_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5045_Start4" name="Container rental order (W5041); customer relocation/return request">
        <bpmn:outgoing>W5045_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5045_Task5" name="Schedule &amp; dispatch: confirm delivery address/placement (driveway/jobsite…">
        <bpmn:documentation>Step 1: Schedule &amp; dispatch: confirm delivery address/placement (driveway/jobsite access, permits), dispatch tilt-bed/flatbed (own fleet VS-06 or 3PL VS-56), and brief the driver on safety/placement
Responsible (R): Logistics / Property Mgr
Accountable (A): Logistics Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W5045_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5045_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5045_Task6" name="Deliver/place: place the container level &amp; secure, lock-box the unit, capture…">
        <bpmn:documentation>Step 2: Deliver/place: place the container level &amp; secure, lock-box the unit, capture placement photos &amp; customer acceptance, and activate the rental lease/billing (W5042/W5044)
Responsible (R): Driver / Property Mgr
Accountable (A): Logistics Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W5045_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5045_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5045_Task7" name="Relocate/pickup: on customer request execute relocation or end-of-term pickup…">
        <bpmn:documentation>Step 3: Relocate/pickup: on customer request execute relocation or end-of-term pickup, inspect/damage-assess (W5046), and return the container to depot (W5053)
Responsible (R): Logistics / Property Mgr
Accountable (A): Logistics Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W5045_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5045_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5045_End8" name="Complete">
        <bpmn:incoming>W5045_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5045_Annotation9">
        <bpmn:text>Controls: - CTL-753 (ensure controlled execution — Customer Rental Lifecycle — Move-In, Access, Billing &amp; Move-Out (PA-174.2).) | - CTL-753: placement assessed before delivery; container GPS-tracked; customer acceptance captured; insurance VS-26-confirmed
Owner: Fleet/Logistics (VS-06) / Property Manager (Storage)</bpmn:text>
      </bpmn:textAnnotation>
