<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-174.2-customer-rental-lifecycle-move-in-access-billing-and-move-out" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5041" name="W5041. Customer Storage Inquiry, Reservation &amp; Unit Assignment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquiry (online/phone/store); lead generation
Frequency: Continuous; demand-driven
Volume: ~3,000–6,000 inquiries/month at maturity × conversion ~25–40%
Owner: Property Manager (Storage) / Store Services Lead
Participants: Customer Service (VS-13), Marketing (VS-14), CRM/Loyalty (VS-13), Property Manager, Yield Mgmt (W5039)
Source: workflow W5041 — Customer Storage Inquiry, Reservation &amp; Unit Assignment</bpmn:documentation>
      <bpmn:laneSet id="W5041_LaneSet3">
        <bpmn:lane id="W5041_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W5041_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5041_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5041_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5041_Lane2" name="Property Mgr">
        <bpmn:flowNodeRef>W5041_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5041_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5041_Start4" name="Customer inquiry (online/phone/store); lead generation">
        <bpmn:outgoing>W5041_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5041_Task5" name="Capture the inquiry &amp; assess need: storage size estimate (by room count / item…">
        <bpmn:documentation>Step 1: Capture the inquiry &amp; assess need: storage size estimate (by room count / item list), term, site preference, climate/vehicle/container need, and capture the lead in CRM (VS-13)
Responsible (R): Customer Service / Property Mgr
Accountable (A): Property Manager
Duration: Per inquiry</bpmn:documentation>
        <bpmn:incoming>W5041_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5041_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5041_Task6" name="Reserve the unit &amp; confirm availability: check live availability (vs W5039…">
        <bpmn:documentation>Step 2: Reserve the unit &amp; confirm availability: check live availability (vs W5039 occupancy), hold the unit, quote the street rate + fees (W5035), and collect the reservation deposit
Responsible (R): Property Mgr / O2C
Accountable (A): Property Manager
Duration: Per inquiry</bpmn:documentation>
        <bpmn:incoming>W5041_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5041_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5041_Task7" name="Convert to lease handoff: send the quote/lease-preview, schedule move-in…">
        <bpmn:documentation>Step 3: Convert to lease handoff: send the quote/lease-preview, schedule move-in (W5042), and feed conversion analytics (W5054) and retention (VS-13)
Responsible (R): Customer Service / Property Mgr
Accountable (A): Property Manager
Duration: Per inquiry</bpmn:documentation>
        <bpmn:incoming>W5041_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5041_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5041_End8" name="Complete">
        <bpmn:incoming>W5041_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5041_Annotation9">
        <bpmn:text>Controls: - CTL-753 (ensure controlled execution — Customer Rental Lifecycle — Move-In, Access, Billing &amp; Move-Out (PA-174.2).) | - CTL-753: deposit collected before hold; availability lock prevents double-booking; rate quote RA 7394-compliant (VS-118)
Owner: Property Manager (Storage) / Store Services Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5041_Assoc10" sourceRef="W5041_Annotation9" targetRef="W5041_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5041_Flow11" sourceRef="W5041_Start4" targetRef="W5041_Task5" />
      <bpmn:sequenceFlow id="W5041_Flow12" sourceRef="W5041_Task5" targetRef="W5041_Task6" />
      <bpmn:sequenceFlow id="W5041_Flow13" sourceRef="W5041_Task6" targetRef="W5041_Task7" />
      <bpmn:sequenceFlow id="W5041_Flow14" sourceRef="W5041_Task7" targetRef="W5041_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5041_diag">
      <bpmndi:BPMNPlane id="W5041_plane" bpmnElement="W_W5041">
        <bpmndi:BPMNShape id="W5041_Lane1_di" bpmnElement="W5041_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5041_Lane2_di" bpmnElement="W5041_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
