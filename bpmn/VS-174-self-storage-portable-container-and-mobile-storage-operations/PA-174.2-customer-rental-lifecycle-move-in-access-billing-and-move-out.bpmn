        <bpmndi:BPMNEdge id="W5041_Flow12_di" bpmnElement="W5041_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5041_Flow13_di" bpmnElement="W5041_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5041_Flow14_di" bpmnElement="W5041_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5041_Assoc10_di" bpmnElement="W5041_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5042" name="W5042. Customer Move-In, Lease Execution, Access Credential &amp; Insurance Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Reservation confirmed (W5041); scheduled move-in date
Frequency: Continuous; ~1,000–2,000 move-ins/month at maturity
Volume: 1 move-in per new tenant
Owner: Property Manager (Storage) / Store Services Lead
Participants: Legal (lease — VS-100/W5038), O2C (VS-16), Insurance (VS-26), IT/Security (access — VS-27/VS-23), Compliance (VS-91)
Source: workflow W5042 — Customer Move-In, Lease Execution, Access Credential &amp; Insurance Setup</bpmn:documentation>
      <bpmn:laneSet id="W5042_LaneSet3">
        <bpmn:lane id="W5042_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W5042_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5042_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5042_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5042_Lane2" name="IT">
        <bpmn:flowNodeRef>W5042_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5042_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5042_Start4" name="Reservation confirmed (W5041); scheduled move-in date">
        <bpmn:outgoing>W5042_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5042_Task5" name="Execute the lease &amp; collect setup: e-sign the master lease (W5038), capture…">
        <bpmn:documentation>Step 1: Execute the lease &amp; collect setup: e-sign the master lease (W5038), capture tenant ID &amp; data-privacy consent (RA 10173 — VS-91), collect security deposit + first period, and enroll auto-pay (W5044)
Responsible (R): Property Mgr / O2C / Compliance
Accountable (A): Property Manager
Duration: Per move-in</bpmn:documentation>
        <bpmn:incoming>W5042_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5042_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5042_Task6" name="Issue access credentials &amp; insurance: provision the access-credential (gate…">
        <bpmn:documentation>Step 2: Issue access credentials &amp; insurance: provision the access-credential (gate code/unit lock PIN/RFID — W5043), confirm tenant insurance or sell the damage waiver (W5038), and brief the tenant on rules/prohibited goods (W5051)
Responsible (R): IT/Security / Insurance / Property Mgr
Accountable (A): Property Manager
Duration: Per move-in</bpmn:documentation>
        <bpmn:incoming>W5042_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5042_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5042_Task7" name="Record move-in &amp; activate: log the move-in inspection (empty-unit condition…">
        <bpmn:documentation>Step 3: Record move-in &amp; activate: log the move-in inspection (empty-unit condition photos), activate billing, and feed occupancy (W5039) and analytics (W5054)
Responsible (R): Property Mgr / O2C
Accountable (A): Property Manager
Duration: Per move-in</bpmn:documentation>
        <bpmn:incoming>W5042_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5042_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5042_End8" name="Complete">
        <bpmn:incoming>W5042_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5042_Annotation9">
        <bpmn:text>Controls: - CTL-753 (ensure controlled execution — Customer Rental Lifecycle — Move-In, Access, Billing &amp; Move-Out (PA-174.2).) | - CTL-753: lease executed &amp; deposit collected before access; insurance/waiver mandatory; access per-tenant; RA 10173 consent captured (VS-91)
Owner: Property Manager (Storage) / Store Services Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5042_Assoc10" sourceRef="W5042_Annotation9" targetRef="W5042_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5042_Flow11" sourceRef="W5042_Start4" targetRef="W5042_Task5" />
      <bpmn:sequenceFlow id="W5042_Flow12" sourceRef="W5042_Task5" targetRef="W5042_Task6" />
      <bpmn:sequenceFlow id="W5042_Flow13" sourceRef="W5042_Task6" targetRef="W5042_Task7" />
      <bpmn:sequenceFlow id="W5042_Flow14" sourceRef="W5042_Task7" targetRef="W5042_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5042_diag">
      <bpmndi:BPMNPlane id="W5042_plane" bpmnElement="W_W5042">
        <bpmndi:BPMNShape id="W5042_Lane1_di" bpmnElement="W5042_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Lane2_di" bpmnElement="W5042_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Task5_di" bpmnElement="W5042_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Task6_di" bpmnElement="W5042_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Task7_di" bpmnElement="W5042_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Start4_di" bpmnElement="W5042_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_End8_di" bpmnElement="W5042_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5042_Annotation9_di" bpmnElement="W5042_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5042_Flow11_di" bpmnElement="W5042_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5042_Flow12_di" bpmnElement="W5042_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5042_Flow13_di" bpmnElement="W5042_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5042_Flow14_di" bpmnElement="W5042_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5042_Assoc10_di" bpmnElement="W5042_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5043" name="W5043. Storage Facility Daily Access Control, Security Monitoring &amp; Audit Trail" isExecutable="false">
      <bpmn:documentation>Trigger: Every tenant/visitor site entry; continuous security monitoring
Frequency: Continuous (24/7 access windows common)
Volume: ~10–100 access events/day per site × ~50 sites
Owner: Property Manager (Storage) / Security &amp; LP (VS-23/VS-159)
Participants: Security/LP (VS-23/VS-159), IT (VS-27), Facilities (VS-138), HSE (VS-24)
Source: workflow W5043 — Storage Facility Daily Access Control, Security Monitoring &amp; Audit Trail</bpmn:documentation>
      <bpmn:laneSet id="W5043_LaneSet2">
        <bpmn:lane id="W5043_Lane1" name="Security">
        <bpmn:flowNodeRef>W5043_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5043_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5043_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5043_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5043_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5043_Start3" name="Every tenant/visitor site entry; continuous security monitoring">
        <bpmn:outgoing>W5043_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5043_Task4" name="Control access: validate each entry via gate access-control (credential/plate…">
        <bpmn:documentation>Step 1: Control access: validate each entry via gate access-control (credential/plate reader), log unit-door open/close, and flag anomalies (after-hours, wrong-unit access, loitering)
Responsible (R): Security / Property Mgr
Accountable (A): Property Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5043_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5043_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5043_Task5" name="Monitor CCTV &amp; alarms: live/scheduled CCTV review (VS-23), unit-door-alarm…">
        <bpmn:documentation>Step 2: Monitor CCTV &amp; alarms: live/scheduled CCTV review (VS-23), unit-door-alarm response, and incident escalation to LP (VS-23) or corporate security (VS-159) and police if needed
Responsible (R): Security / LP
Accountable (A): Property Manager / LP Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5043_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5043_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5043_Task6" name="Maintain the audit trail: reconcile access logs to active leases (flag access…">
        <bpmn:documentation>Step 3: Maintain the audit trail: reconcile access logs to active leases (flag access by delinquent/moved-out tenants — links W5044/W5047), and retain CCTV/log evidence (retention VS-88/W5050)
Responsible (R): Security / Property Mgr / Compliance
Accountable (A): Property Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5043_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5043_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5043_End7" name="Complete">
        <bpmn:incoming>W5043_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5043_Annotation8">
        <bpmn:text>Controls: - CTL-99 (ensure storage lien &amp; prohibited-goods control.) | - CTL-753: access per active lease only (reconciled); CCTV/alarm evidence retained (VS-88); incident escalation to LP (VS-23)
Owner: Property Manager (Storage) / Security &amp; LP (VS-23/VS-159)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5043_Assoc9" sourceRef="W5043_Annotation8" targetRef="W5043_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5043_Flow10" sourceRef="W5043_Start3" targetRef="W5043_Task4" />
      <bpmn:sequenceFlow id="W5043_Flow11" sourceRef="W5043_Task4" targetRef="W5043_Task5" />
      <bpmn:sequenceFlow id="W5043_Flow12" sourceRef="W5043_Task5" targetRef="W5043_Task6" />
      <bpmn:sequenceFlow id="W5043_Flow13" sourceRef="W5043_Task6" targetRef="W5043_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5043_diag">
      <bpmndi:BPMNPlane id="W5043_plane" bpmnElement="W_W5043">
        <bpmndi:BPMNShape id="W5043_Lane1_di" bpmnElement="W5043_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_Task4_di" bpmnElement="W5043_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_Task5_di" bpmnElement="W5043_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_Task6_di" bpmnElement="W5043_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_Start3_di" bpmnElement="W5043_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_End7_di" bpmnElement="W5043_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5043_Annotation8_di" bpmnElement="W5043_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5043_Flow10_di" bpmnElement="W5043_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5043_Flow11_di" bpmnElement="W5043_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5043_Flow12_di" bpmnElement="W5043_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5043_Flow13_di" bpmnElement="W5043_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5043_Assoc9_di" bpmnElement="W5043_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5044" name="W5044. Storage Tenant Billing, Auto-Pay, Late-Fee &amp; Delinquency Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly billing cycle; missed payment; delinquency timeline
Frequency: Monthly billing + continuous delinquency follow-up
Volume: ~thousands of active tenants × monthly; ~5–15% delinquency at any time
Owner: O2C / Property Manager (Storage)
Participants: O2C (VS-16), Treasury (VS-18), Property Manager, Legal (lien — VS-100/W5047), Customer Service (VS-13)
Source: workflow W5044 — Storage Tenant Billing, Auto-Pay, Late-Fee &amp; Delinquency Management</bpmn:documentation>
      <bpmn:laneSet id="W5044_LaneSet2">
        <bpmn:lane id="W5044_Lane1" name="O2C">
        <bpmn:flowNodeRef>W5044_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5044_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5044_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5044_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5044_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5044_Start3" name="Monthly billing cycle; missed payment; delinquency timeline">
        <bpmn:outgoing>W5044_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5044_Task4" name="Bill &amp; collect: generate monthly rent invoices, process auto-pay…">
        <bpmn:documentation>Step 1: Bill &amp; collect: generate monthly rent invoices, process auto-pay (card/direct-debit/e-wallet — VS-80), apply street-vs-in-place rates (W5039), and reconcile cash (VS-16)
Responsible (R): O2C / Property Mgr
Accountable (A): O2C Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5044_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5044_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5044_Task5" name="Manage late/delinquent: apply late fees per lease (W5038), send dunning notices…">
        <bpmn:documentation>Step 2: Manage late/delinquent: apply late fees per lease (W5038), send dunning notices (5/15/30-day), suspend gate access at threshold, and pre-qualify for lien (W5047)
Responsible (R): O2C / Property Mgr / Legal
Accountable (A): O2C Manager / Property Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5044_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5044_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5044_Task6" name="Report delinquency &amp; reserve: aged-delinquency reporting, bad-debt provision…">
        <bpmn:documentation>Step 3: Report delinquency &amp; reserve: aged-delinquency reporting, bad-debt provision (VS-17), and hand-off to lien/disposition (W5047) or write-off with FP&amp;A (VS-17.4)
Responsible (R): O2C / FP&amp;A
Accountable (A): O2C Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5044_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5044_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5044_End7" name="Complete">
        <bpmn:incoming>W5044_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5044_Annotation8">
        <bpmn:text>Controls: - CTL-753 (ensure controlled execution — Customer Rental Lifecycle — Move-In, Access, Billing &amp; Move-Out (PA-174.2).) | - CTL-753: late fees per lease; access-suspension tied to verified delinquency; bad-debt provision (VS-17); lien only after legal notice (W5047)
Owner: O2C / Property Manager (Storage)</bpmn:text>
      </bpmn:textAnnotation>
