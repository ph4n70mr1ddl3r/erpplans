    <bpmn:process id="W_W5047" name="W5047. Abandoned-Unit Contents Disposition, Lien Sale &amp; Regulatory Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Tenant delinquency past lien threshold (W5044); abandonment confirmed
Frequency: ~2–8% of move-outs (abandoned); ~hundreds/year at maturity
Volume: 1 lien/disposition per abandoned unit
Owner: Property Manager (Storage) / Legal (VS-100)
Participants: Legal (VS-100), O2C (VS-16), Compliance (VS-22), Security (VS-23), Facilities (VS-138), Privacy (VS-91)
Source: workflow W5047 — Abandoned-Unit Contents Disposition, Lien Sale &amp; Regulatory Compliance</bpmn:documentation>
      <bpmn:laneSet id="W5047_LaneSet3">
        <bpmn:lane id="W5047_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W5047_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5047_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5047_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5047_Lane2" name="O2C">
        <bpmn:flowNodeRef>W5047_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5047_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5047_Start4" name="Tenant delinquency past lien threshold (W5044); abandonment confirmed">
        <bpmn:outgoing>W5047_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5047_Task5" name="Establish abandonment &amp; perfect the lien: verify delinquency past the lease…">
        <bpmn:documentation>Step 1: Establish abandonment &amp; perfect the lien: verify delinquency past the lease threshold (W5038/W5044), serve the statutory/contractual lien notice (Civil Code), and overlock the unit (W5043)
Responsible (R): Property Mgr / Legal
Accountable (A): Property Manager / VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5047_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5047_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5047_Task6" name="Conduct the lien sale/disposition: auction/sell/dispose contents per lease &amp;…">
        <bpmn:documentation>Step 2: Conduct the lien sale/disposition: auction/sell/dispose contents per lease &amp; law, document the sale (bid records, proceeds), and apply proceeds against the owed balance
Responsible (R): Property Mgr / Legal / O2C
Accountable (A): Property Manager / VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5047_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5047_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5047_Task7" name="Settle, document &amp; retain: refund any surplus to the tenant (or escheat…">
        <bpmn:documentation>Step 3: Settle, document &amp; retain: refund any surplus to the tenant (or escheat unclaimed per unclaimed-property rules), document the chain-of-custody/evidence, and retain records (VS-88)
Responsible (R): O2C / Legal / Compliance
Accountable (A): O2C Manager / VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5047_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5047_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5047_End8" name="Complete">
        <bpmn:incoming>W5047_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5047_Annotation9">
        <bpmn:text>Controls: - CTL-99 (ensure storage lien &amp; prohibited-goods control.) | - CTL-753: lien perfected per Civil Code before disposition (Legal); sale documented &amp; evidenced; surplus/escheat handled; personal data secure-shredded (VS-91)
Owner: Property Manager (Storage) / Legal (VS-100)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5047_Assoc10" sourceRef="W5047_Annotation9" targetRef="W5047_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5047_Flow11" sourceRef="W5047_Start4" targetRef="W5047_Task5" />
