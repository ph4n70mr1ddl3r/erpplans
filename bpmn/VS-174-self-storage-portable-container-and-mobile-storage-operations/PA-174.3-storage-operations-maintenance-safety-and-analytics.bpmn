        <bpmn:outgoing>W5053_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5053_Task6" name="Clean, sanitize &amp; repair: pressure-wash/sanitize, deodorize, repair…">
        <bpmn:documentation>Step 2: Clean, sanitize &amp; repair: pressure-wash/sanitize, deodorize, repair doors/lock-box/vents, and certify wind/water-tight before re-rental
Responsible (R): Facilities / Vendor
Accountable (A): Logistics Manager
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W5053_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5053_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5053_Task7" name="Manage lifecycle &amp; redeployment: rebalance across sites per demand (W5055)…">
        <bpmn:documentation>Step 3: Manage lifecycle &amp; redeployment: rebalance across sites per demand (W5055), retire/condemn beyond-economical-repair units, and update the container-asset register (VS-35/VS-111)
Responsible (R): Logistics / Finance
Accountable (A): Logistics Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5053_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5053_Flow14</bpmn:outgoing>
