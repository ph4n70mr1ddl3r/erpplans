    <bpmn:process id="W_W5050" name="W5050. Storage Security Operations, Surveillance, Access System &amp; Incident Response" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous monitoring; alarm/incident event
Frequency: Continuous
Volume: ~50 sites × 24/7 monitoring + incident events
Owner: Security &amp; LP Manager (VS-23/VS-159) / Property Manager
Participants: Security/LP (VS-23/VS-159), IT (VS-27), Property Manager, HSE (VS-24), police liaison
Source: workflow W5050 — Storage Security Operations, Surveillance, Access System &amp; Incident Response</bpmn:documentation>
      <bpmn:laneSet id="W5050_LaneSet3">
        <bpmn:lane id="W5050_Lane1" name="Security">
        <bpmn:flowNodeRef>W5050_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5050_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5050_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5050_Lane2" name="LP">
        <bpmn:flowNodeRef>W5050_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5050_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5050_Start4" name="Continuous monitoring; alarm/incident event">
        <bpmn:outgoing>W5050_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5050_Task5" name="Operate surveillance &amp; access system health: CCTV/VMS uptime…">
        <bpmn:documentation>Step 1: Operate surveillance &amp; access system health: CCTV/VMS uptime, access-control/gate system availability, door-alarm monitoring, and the security-system PM (links VS-27/VS-23)
Responsible (R): Security / IT
Accountable (A): LP Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5050_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5050_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5050_Task6" name="Respond to incidents: theft/break-in, unit-alarm, after-hours loitering…">
        <bpmn:documentation>Step 2: Respond to incidents: theft/break-in, unit-alarm, after-hours loitering, vehicle incident — dispatch guard/LP/police, secure the scene, and document
Responsible (R): Security / LP / Property Mgr
Accountable (A): LP Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5050_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5050_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5050_Task7" name="Investigate &amp; report: LP case management (VS-23), tenant-claim handling with…">
        <bpmn:documentation>Step 3: Investigate &amp; report: LP case management (VS-23), tenant-claim handling with Insurance (VS-26), CCTV evidence retention (VS-88), and recurring-incident analytics
Responsible (R): LP / Security / Insurance
Accountable (A): LP Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5050_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5050_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5050_End8" name="Complete">
        <bpmn:incoming>W5050_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5050_Annotation9">
        <bpmn:text>Controls: - CTL-754 (ensure controlled execution — Storage Operations, Maintenance, Safety &amp; Analytics (PA-174.3).) | - CTL-754: CCTV/access uptime SLA; incident evidence retained (VS-88); LP case managed (VS-23); claims Insurance-coordinated (VS-26)
Owner: Security &amp; LP Manager (VS-23/VS-159) / Property Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5050_Assoc10" sourceRef="W5050_Annotation9" targetRef="W5050_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5050_Flow11" sourceRef="W5050_Start4" targetRef="W5050_Task5" />
      <bpmn:sequenceFlow id="W5050_Flow12" sourceRef="W5050_Task5" targetRef="W5050_Task6" />
      <bpmn:sequenceFlow id="W5050_Flow13" sourceRef="W5050_Task6" targetRef="W5050_Task7" />
      <bpmn:sequenceFlow id="W5050_Flow14" sourceRef="W5050_Task7" targetRef="W5050_End8" />
    </bpmn:process>
