    <bpmn:process id="W_W5051" name="W5051. Stored-Goods Restrictions, Hazardous/Prohibited-Items Inspection &amp; Enforcement" isExecutable="false">
      <bpmn:documentation>Trigger: Move-in (W5042); periodic inspection; suspected prohibited storage
Frequency: At move-in + periodic; complaint-driven
Volume: ~all move-ins + ~periodic per site
Owner: Property Manager (Storage) / HSE (VS-24)
Participants: HSE (VS-24), Property Manager, Legal (VS-100), Security (VS-23), Compliance (VS-22)
Source: workflow W5051 — Stored-Goods Restrictions, Hazardous/Prohibited-Items Inspection &amp; Enforcement</bpmn:documentation>
      <bpmn:laneSet id="W5051_LaneSet3">
        <bpmn:lane id="W5051_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W5051_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5051_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5051_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5051_Lane2" name="HSE">
        <bpmn:flowNodeRef>W5051_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5051_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5051_Start4" name="Move-in (W5042); periodic inspection; suspected prohibited storage">
        <bpmn:outgoing>W5051_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5051_Task5" name="Communicate prohibited-goods policy: at lease execution (W5038/W5042), brief…">
        <bpmn:documentation>Step 1: Communicate prohibited-goods policy: at lease execution (W5038/W5042), brief the tenant on the prohibited list (flammables, explosives, fuels/LPG, perishables, illegal items, hazardous waste) and the inspection right
Responsible (R): Property Mgr / HSE
Accountable (A): Property Manager
Duration: Per move-in</bpmn:documentation>
        <bpmn:incoming>W5051_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5051_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5051_Task6" name="Inspect &amp; enforce: periodic visual inspections, investigate suspected…">
        <bpmn:documentation>Step 2: Inspect &amp; enforce: periodic visual inspections, investigate suspected prohibited storage, and enforce removal/termination per lease for violations
Responsible (R): Property Mgr / HSE / Security
Accountable (A): Property Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W5051_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5051_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5051_Task7" name="Handle hazardous discovery: if hazardous/illegal items found, coordinate safe…">
        <bpmn:documentation>Step 3: Handle hazardous discovery: if hazardous/illegal items found, coordinate safe removal/disposal (DENR/links VS-73), legal termination, and reporting to authorities if required
Responsible (R): HSE / Legal / Property Mgr
Accountable (A): Property Manager / HSE Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5051_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5051_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5051_End8" name="Complete">
        <bpmn:incoming>W5051_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5051_Annotation9">
        <bpmn:text>Controls: - CTL-99 (ensure storage lien &amp; prohibited-goods control.) | - CTL-754: prohibited-goods policy in lease &amp; acknowledged (W5038); inspection right exercised; hazardous disposal per VS-73/VS-114
Owner: Property Manager (Storage) / HSE (VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5051_Assoc10" sourceRef="W5051_Annotation9" targetRef="W5051_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5051_Flow11" sourceRef="W5051_Start4" targetRef="W5051_Task5" />
      <bpmn:sequenceFlow id="W5051_Flow12" sourceRef="W5051_Task5" targetRef="W5051_Task6" />
      <bpmn:sequenceFlow id="W5051_Flow13" sourceRef="W5051_Task6" targetRef="W5051_Task7" />
      <bpmn:sequenceFlow id="W5051_Flow14" sourceRef="W5051_Task7" targetRef="W5051_End8" />
    </bpmn:process>
