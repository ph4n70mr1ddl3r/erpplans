    <bpmn:process id="W_W5049" name="W5049. Storage Facility Daily Operations, Housekeeping &amp; Maintenance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily site open/close; PM cycle; reactive maintenance request
Frequency: Daily operations + scheduled PM
Volume: ~50 storage sites × daily ops + PM backlog
Owner: Property Manager (Storage) / Facilities (VS-138)
Participants: Facilities (VS-138), Property Manager, HSE (VS-24), Security (VS-23), vendor maintenance
Source: workflow W5049 — Storage Facility Daily Operations, Housekeeping &amp; Maintenance Management</bpmn:documentation>
      <bpmn:laneSet id="W5049_LaneSet3">
        <bpmn:lane id="W5049_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W5049_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5049_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5049_Lane2" name="Facilities">
        <bpmn:flowNodeRef>W5049_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5049_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5049_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5049_Start4" name="Daily site open/close; PM cycle; reactive maintenance request">
        <bpmn:outgoing>W5049_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5049_Task5" name="Run daily site operations: open/close, lighting/HVAC/climate-control checks…">
        <bpmn:documentation>Step 1: Run daily site operations: open/close, lighting/HVAC/climate-control checks (climate units), corridor/elevator/lift function, signage, and the daily walk-through
Responsible (R): Property Mgr / Facilities
Accountable (A): Property Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5049_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5049_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5049_Task6" name="Execute housekeeping &amp; PM: cleaning, pest control (links VS-138)…">
        <bpmn:documentation>Step 2: Execute housekeeping &amp; PM: cleaning, pest control (links VS-138), door/lock/roller-door lubrication, lighting replacement, and the scheduled PM cycle on facility assets
Responsible (R): Facilities / Vendor
Accountable (A): Property Manager
Duration: Per PM cycle</bpmn:documentation>
        <bpmn:incoming>W5049_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5049_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5049_Task7" name="Manage reactive maintenance: tenant-reported defects, work-order creation…">
        <bpmn:documentation>Step 3: Manage reactive maintenance: tenant-reported defects, work-order creation, vendor dispatch, and closure verification feeding facilities analytics (VS-138)
Responsible (R): Facilities / Property Mgr
Accountable (A): Property Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W5049_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5049_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5049_End8" name="Complete">
        <bpmn:incoming>W5049_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5049_Annotation9">
        <bpmn:text>Controls: - CTL-754 (ensure controlled execution — Storage Operations, Maintenance, Safety &amp; Analytics (PA-174.3).) | - CTL-754: PM schedule adherence (VS-138); climate-unit temp monitored; work-order closure verified
Owner: Property Manager (Storage) / Facilities (VS-138)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5049_Assoc10" sourceRef="W5049_Annotation9" targetRef="W5049_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5049_Flow11" sourceRef="W5049_Start4" targetRef="W5049_Task5" />
      <bpmn:sequenceFlow id="W5049_Flow12" sourceRef="W5049_Task5" targetRef="W5049_Task6" />
      <bpmn:sequenceFlow id="W5049_Flow13" sourceRef="W5049_Task6" targetRef="W5049_Task7" />
      <bpmn:sequenceFlow id="W5049_Flow14" sourceRef="W5049_Task7" targetRef="W5049_End8" />
    </bpmn:process>
