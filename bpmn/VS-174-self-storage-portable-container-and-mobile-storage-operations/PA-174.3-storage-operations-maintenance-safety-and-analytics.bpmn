    <bpmn:process id="W_W5052" name="W5052. Storage Fire/Life-Safety, BFP Compliance &amp; Emergency Preparedness" isExecutable="false">
      <bpmn:documentation>Trigger: Facility build/commission (W5037); annual FSIC renewal; drill cycle; incident
Frequency: Annual FSIC + quarterly drills + continuous
Volume: ~50 storage sites × annual FSIC + drills
Owner: HSE Manager (VS-24) / Property Manager
Participants: HSE (VS-24), Facilities (VS-138), BFP/fire consultant, Property Manager, Security (VS-23), BC/DR (VS-26)
Source: workflow W5052 — Storage Fire/Life-Safety, BFP Compliance &amp; Emergency Preparedness</bpmn:documentation>
      <bpmn:laneSet id="W5052_LaneSet3">
        <bpmn:lane id="W5052_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W5052_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5052_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5052_Lane2" name="HSE">
        <bpmn:flowNodeRef>W5052_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5052_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5052_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5052_Start4" name="Facility build/commission (W5037); annual FSIC renewal; drill cycle; incident">
        <bpmn:outgoing>W5052_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5052_Task5" name="Maintain fire/life-safety systems: detection/suppression…">
        <bpmn:documentation>Step 1: Maintain fire/life-safety systems: detection/suppression (sprinkler/extinguisher/hydrant), fire-rated partitions, egress, signage, and the annual BFP Fire Safety Inspection &amp; FSIC (links VS-166)
Responsible (R): Facilities / HSE / Fire consultant
Accountable (A): HSE Manager / Property Manager
Duration: Annual + continuous</bpmn:documentation>
        <bpmn:incoming>W5052_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5052_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5052_Task6" name="Run emergency preparedness: evacuation plan, fire/earthquake/typhoon drills…">
        <bpmn:documentation>Step 2: Run emergency preparedness: evacuation plan, fire/earthquake/typhoon drills (links VS-69), and tenant emergency communication
Responsible (R): HSE / Property Mgr / Security
Accountable (A): HSE Manager
Duration: Quarterly drills</bpmn:documentation>
        <bpmn:incoming>W5052_Flow12</bpmn:incoming>
