      </bpmn:userTask>
      <bpmn:userTask id="W5052_Task7" name="Respond &amp; report incidents: fire/smoke/gas incident response…">
        <bpmn:documentation>Step 3: Respond &amp; report incidents: fire/smoke/gas incident response, BFP/DOLE/authority reporting, and BC/DR activation for major events (VS-26)
Responsible (R): HSE / Security / Property Mgr
Accountable (A): HSE Manager / Property Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5052_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5052_Flow14</bpmn:outgoing>
      </bpmn:userTask>
