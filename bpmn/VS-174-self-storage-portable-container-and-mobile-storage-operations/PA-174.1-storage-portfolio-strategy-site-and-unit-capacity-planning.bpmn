<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-174.1-storage-portfolio-strategy-site-and-unit-capacity-planning" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5033" name="W5033. Storage Program Strategy, Product Portfolio &amp; Business-Model Design" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy refresh (VS-33); new business-line approval; site/portfolio review
Frequency: Annual + event-driven
Volume: 1 program across 5 entities; phased rollout across up to ~50 of the 200 stores
Owner: Director, Storage &amp; Rental Services / VP Strategy (VS-33)
Participants: Strategy (VS-33), Real Estate (VS-97), Finance/FP&amp;A (VS-17.4), Legal (VS-100), Store Ops (VS-07), Marketing (VS-14), Risk (VS-21)
Source: workflow W5033 — Storage Program Strategy, Product Portfolio &amp; Business-Model Design</bpmn:documentation>
      <bpmn:laneSet id="W5033_LaneSet2">
        <bpmn:lane id="W5033_Lane1" name="Director Storage">
        <bpmn:flowNodeRef>W5033_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5033_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5033_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5033_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5033_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5033_Start3" name="Strategy refresh (VS-33); new business-line approval; site/portfolio review">
        <bpmn:outgoing>W5033_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5033_Task4" name="Set the storage business strategy &amp; operating model: the product portfolio…">
        <bpmn:documentation>Step 1: Set the storage business strategy &amp; operating model: the product portfolio (on-site self-storage units, drive-up units, climate-controlled, vehicle/boat/RV parking, portable containers, mobile on-demand storage), the make-vs-partner-vs-franchise model, the rollout sequence (which of the 200 stores have the parking/yard footprint and the demand), and the KPIs (occupancy, rate/unit, NOI margin, cross-sell attach)
Responsible (R): Director Storage / Strategy
Accountable (A): VP Strategy / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5033_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5033_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5033_Task5" name="Build the business case &amp; capital model: capex per unit, breakeven occupancy…">
        <bpmn:documentation>Step 2: Build the business case &amp; capital model: capex per unit, breakeven occupancy, payback, cannibalisation check vs BuildRight&#x27;s own backroom space (VS-04), and the recurring-revenue/NOI contribution to the group P&amp;L (links VS-17.4)
Responsible (R): Director Storage / FP&amp;A
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5033_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5033_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5033_Task6" name="Govern &amp; approve: board/leadership sign-off (links VS-36), legal-entity…">
        <bpmn:documentation>Step 3: Govern &amp; approve: board/leadership sign-off (links VS-36), legal-entity placement (which of the 5 entities owns the storage — typically Property Mgmt Inc.), and the regulatory/tax posture (VAT on rentals, percentage-tax vs VAT, LGU business-permit scope) with Legal/Tax (VS-79)
Responsible (R): Director Storage / Legal / Tax
Accountable (A): CFO / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5033_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5033_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5033_End7" name="Complete">
        <bpmn:incoming>W5033_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5033_Annotation8">
        <bpmn:text>Controls: - CTL-752 (ensure controlled execution — Storage Portfolio Strategy, Site Selection &amp; Unit/Container Capacity Planning (PA-174.1).) | - CTL-752: business case board/leadership-approved (VS-36); entity &amp; tax-structure Tax-reviewed (VS-79); capex within VS-35/VS-40 approval matrix
Owner: Director, Storage &amp; Rental Services / VP Strategy (VS-33)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5033_Assoc9" sourceRef="W5033_Annotation8" targetRef="W5033_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5033_Flow10" sourceRef="W5033_Start3" targetRef="W5033_Task4" />
      <bpmn:sequenceFlow id="W5033_Flow11" sourceRef="W5033_Task4" targetRef="W5033_Task5" />
      <bpmn:sequenceFlow id="W5033_Flow12" sourceRef="W5033_Task5" targetRef="W5033_Task6" />
      <bpmn:sequenceFlow id="W5033_Flow13" sourceRef="W5033_Task6" targetRef="W5033_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5033_diag">
      <bpmndi:BPMNPlane id="W5033_plane" bpmnElement="W_W5033">
        <bpmndi:BPMNShape id="W5033_Lane1_di" bpmnElement="W5033_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_Task4_di" bpmnElement="W5033_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_Task5_di" bpmnElement="W5033_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_Task6_di" bpmnElement="W5033_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_Start3_di" bpmnElement="W5033_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_End7_di" bpmnElement="W5033_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5033_Annotation8_di" bpmnElement="W5033_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5033_Flow10_di" bpmnElement="W5033_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5033_Flow11_di" bpmnElement="W5033_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5033_Flow12_di" bpmnElement="W5033_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5033_Flow13_di" bpmnElement="W5033_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5033_Assoc9_di" bpmnElement="W5033_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5034" name="W5034. Storage Site Selection, Real-Estate Acquisition &amp; Unit-Capacity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy approval (W5033); expansion plan; site availability
Frequency: Per candidate site; ~5–10 new storage sites/year at maturity
Volume: ~200 candidate store sites screened; ~10–20% shortlisted
Owner: Director, Storage &amp; Rental Services / Real Estate (VS-97)
Participants: Real Estate (VS-97), Store Ops (VS-07), Strategy (VS-33), Legal (VS-100), Facilities (VS-138), Finance (VS-17.4)
Source: workflow W5034 — Storage Site Selection, Real-Estate Acquisition &amp; Unit-Capacity Planning</bpmn:documentation>
      <bpmn:laneSet id="W5034_LaneSet3">
        <bpmn:lane id="W5034_Lane1" name="Real Estate">
        <bpmn:flowNodeRef>W5034_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5034_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5034_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5034_Lane2" name="Director Storage">
        <bpmn:flowNodeRef>W5034_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5034_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5034_Start4" name="Strategy approval (W5033); expansion plan; site availability">
        <bpmn:outgoing>W5034_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5034_Task5" name="Screen candidate sites against the storage criteria: available…">
        <bpmn:documentation>Step 1: Screen candidate sites against the storage criteria: available parking/yard/side-lot area (vs selling-area need VS-07), access (drive-up vs interior), zoning/LGU allowance for storage use, population &amp; competitor-storage density, and B2B-trade density (contractors needing jobsite staging)
Responsible (R): Real Estate / Director Storage
Accountable (A): Director Storage
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5034_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5034_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5034_Task6" name="Acquire/secure the footprint: own-build on BuildRight land (VS-20), lease…">
        <bpmn:documentation>Step 2: Acquire/secure the footprint: own-build on BuildRight land (VS-20), lease adjacent/under-used land (VS-42), or partner with a third-party facility (W5040); negotiate terms, secure LGU clearance, and confirm BFP/zoning feasibility for a storage occupancy
Responsible (R): Real Estate / Legal
Accountable (A): Director Storage / COO
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5034_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5034_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5034_Task7" name="Plan unit capacity &amp; layout: the unit count and size mix (5&#x27;×5&#x27; to 10&#x27;×30&#x27;+…">
        <bpmn:documentation>Step 3: Plan unit capacity &amp; layout: the unit count and size mix (5&#x27;×5&#x27; to 10&#x27;×30&#x27;+ climate/drive-up/RV), aisle/corridor, office, and the build-out scope handed to facility design (W5037)
Responsible (R): Director Storage / Facilities
Accountable (A): Director Storage
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5034_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5034_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5034_End8" name="Complete">
        <bpmn:incoming>W5034_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5034_Annotation9">
        <bpmn:text>Controls: - CTL-752 (ensure controlled execution — Storage Portfolio Strategy, Site Selection &amp; Unit/Container Capacity Planning (PA-174.1).) | - CTL-752: site acquisition within VS-97 real-estate approval; lease terms Legal-reviewed (VS-42); LGU/BFP feasibility confirmed before capex commit
Owner: Director, Storage &amp; Rental Services / Real Estate (VS-97)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5034_Assoc10" sourceRef="W5034_Annotation9" targetRef="W5034_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5034_Flow11" sourceRef="W5034_Start4" targetRef="W5034_Task5" />
      <bpmn:sequenceFlow id="W5034_Flow12" sourceRef="W5034_Task5" targetRef="W5034_Task6" />
      <bpmn:sequenceFlow id="W5034_Flow13" sourceRef="W5034_Task6" targetRef="W5034_Task7" />
      <bpmn:sequenceFlow id="W5034_Flow14" sourceRef="W5034_Task7" targetRef="W5034_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5034_diag">
      <bpmndi:BPMNPlane id="W5034_plane" bpmnElement="W_W5034">
        <bpmndi:BPMNShape id="W5034_Lane1_di" bpmnElement="W5034_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5034_Lane2_di" bpmnElement="W5034_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5034_Task5_di" bpmnElement="W5034_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5034_Task6_di" bpmnElement="W5034_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5034_Task7_di" bpmnElement="W5034_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
