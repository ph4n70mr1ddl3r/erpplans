        <bpmn:flowNodeRef>W5037_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5037_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5037_Start5" name="Site secured (W5034); capacity plan (W5034); new build/remodel">
        <bpmn:outgoing>W5037_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5037_Task6" name="Design the facility: unit partitions, climate-controlled zone, drive-up doors…">
        <bpmn:documentation>Step 1: Design the facility: unit partitions, climate-controlled zone, drive-up doors, aisle/loading, office, lighting, fencing, and the BFP Fire Code / OSH compliance (fire-rated partitions, detection/suppression, ventilation, egress)
Responsible (R): Construction / Facilities / Fire consultant
Accountable (A): Director Storage / VP Construction
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5037_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5037_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5037_Task7" name="Install the security &amp; access infrastructure: perimeter fencing/lighting/CCTV…">
        <bpmn:documentation>Step 2: Install the security &amp; access infrastructure: perimeter fencing/lighting/CCTV (VS-23), electronic unit-door locks &amp; gate access-control (individual unit alarms), and the access-credential system that gates tenant entry (W5043) — integrated to IT (VS-27) and corporate security (VS-159)
Responsible (R): Security / IT / Facilities
Accountable (A): Director Storage
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5037_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5037_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5037_Task8" name="Commission &amp; certify: BFP Fire Safety Inspection Certificate (FSIC), LGU…">
        <bpmn:documentation>Step 3: Commission &amp; certify: BFP Fire Safety Inspection Certificate (FSIC), LGU occupancy/permit-to-operate (VS-166), HSE sign-off (VS-24), and IT/security-system acceptance before first move-in
Responsible (R): Facilities / HSE / Legal / IT
Accountable (A): Director Storage
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5037_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5037_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5037_End9" name="Complete">
        <bpmn:incoming>W5037_Flow15</bpmn:incoming>
      </bpmn:endEvent>
