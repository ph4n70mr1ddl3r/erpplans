      <bpmn:sequenceFlow id="W5035_Flow11" sourceRef="W5035_Task4" targetRef="W5035_Task5" />
      <bpmn:sequenceFlow id="W5035_Flow12" sourceRef="W5035_Task5" targetRef="W5035_Task6" />
      <bpmn:sequenceFlow id="W5035_Flow13" sourceRef="W5035_Task6" targetRef="W5035_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5035_diag">
      <bpmndi:BPMNPlane id="W5035_plane" bpmnElement="W_W5035">
        <bpmndi:BPMNShape id="W5035_Lane1_di" bpmnElement="W5035_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5035_Task4_di" bpmnElement="W5035_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
