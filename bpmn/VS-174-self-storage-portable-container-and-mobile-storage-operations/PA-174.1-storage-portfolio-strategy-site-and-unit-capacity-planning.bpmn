        <bpmndi:BPMNShape id="W5034_Annotation9_di" bpmnElement="W5034_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5034_Flow11_di" bpmnElement="W5034_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5034_Flow12_di" bpmnElement="W5034_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5034_Flow13_di" bpmnElement="W5034_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5034_Flow14_di" bpmnElement="W5034_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5034_Assoc10_di" bpmnElement="W5034_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5035" name="W5035. Storage Unit-Type Mix, Rate Card &amp; Pricing Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: Site capacity plan (W5034); pricing review; competitor rate change
Frequency: At launch + periodic review (quarterly/biannual)
Volume: ~6–10 unit types per site × ~50 sites
Owner: Director, Storage &amp; Rental Services / Pricing (VS-01.2)
Participants: Pricing (VS-01.2), FP&amp;A (VS-17.4), Marketing (VS-14), Store/Property Manager, Legal (rate-disclosure)
Source: workflow W5035 — Storage Unit-Type Mix, Rate Card &amp; Pricing Strategy</bpmn:documentation>
      <bpmn:laneSet id="W5035_LaneSet2">
        <bpmn:lane id="W5035_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W5035_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5035_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5035_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5035_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5035_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5035_Start3" name="Site capacity plan (W5034); pricing review; competitor rate change">
        <bpmn:outgoing>W5035_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5035_Task4" name="Define the unit-type catalog &amp; dimensions: small (closet/locker), medium…">
        <bpmn:documentation>Step 1: Define the unit-type catalog &amp; dimensions: small (closet/locker), medium (1BR-apt), large (2BR-house), climate-controlled, vehicle/boat/RV parking, and the portable-container equivalents
Responsible (R): Pricing / Director Storage
Accountable (A): Director Storage
Duration: At launch</bpmn:documentation>
        <bpmn:incoming>W5035_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5035_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5035_Task5" name="Set the rate card &amp; pricing architecture: street rate vs in-place rate…">
        <bpmn:documentation>Step 2: Set the rate card &amp; pricing architecture: street rate vs in-place rate, discounts (first-month-free, long-term), auto-pay discount, insurance/coverage options, and the price-integrity/disclosure (RA 7394) compliance of advertised rates
Responsible (R): Pricing / FP&amp;A / Legal
Accountable (A): Director Storage / CFO
Duration: At launch + quarterly</bpmn:documentation>
        <bpmn:incoming>W5035_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5035_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5035_Task6" name="Position vs competitors &amp; link to yield: feed competitor-rate monitoring and…">
        <bpmn:documentation>Step 3: Position vs competitors &amp; link to yield: feed competitor-rate monitoring and the dynamic yield/occupancy engine (W5039), and align promotions with Marketing (VS-14) and trade-pro/member discount (VS-13)
Responsible (R): Pricing / Marketing
Accountable (A): Director Storage
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W5035_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5035_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5035_End7" name="Complete">
        <bpmn:incoming>W5035_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5035_Annotation8">
        <bpmn:text>Controls: - CTL-752 (ensure controlled execution — Storage Portfolio Strategy, Site Selection &amp; Unit/Container Capacity Planning (PA-174.1).) | - CTL-752: rate card FP&amp;A/CFO-approved; advertised rates RA 7394-disclosed (VS-118); discounts margin-controlled
Owner: Director, Storage &amp; Rental Services / Pricing (VS-01.2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5035_Assoc9" sourceRef="W5035_Annotation8" targetRef="W5035_Start3" associationDirection="None" />
