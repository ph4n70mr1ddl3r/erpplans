        <bpmndi:BPMNShape id="W5035_Start3_di" bpmnElement="W5035_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5035_End7_di" bpmnElement="W5035_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5035_Annotation8_di" bpmnElement="W5035_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5035_Flow10_di" bpmnElement="W5035_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5035_Flow11_di" bpmnElement="W5035_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5035_Flow12_di" bpmnElement="W5035_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5035_Flow13_di" bpmnElement="W5035_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5035_Assoc9_di" bpmnElement="W5035_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5036" name="W5036. Portable &amp; Mobile Storage Container-Fleet Strategy, Sizing &amp; Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy approval (W5033); capacity plan; fleet refresh
Frequency: Annual + event-driven
Volume: ~150–300 portable/mobile containers (8&#x27;/16&#x27;/20&#x27;) across the network
Owner: Director, Storage &amp; Rental Services / Fleet (VS-06)
Participants: Fleet/Logistics (VS-06), Procurement (VS-03/VS-34), Finance (VS-35/VS-40), Insurance (VS-26), Legal (VS-100)
Source: workflow W5036 — Portable &amp; Mobile Storage Container-Fleet Strategy, Sizing &amp; Procurement</bpmn:documentation>
      <bpmn:laneSet id="W5036_LaneSet3">
        <bpmn:lane id="W5036_Lane1" name="Fleet">
        <bpmn:flowNodeRef>W5036_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5036_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5036_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5036_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W5036_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5036_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5036_Start4" name="Strategy approval (W5033); capacity plan; fleet refresh">
        <bpmn:outgoing>W5036_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5036_Task5" name="Size the container fleet &amp; set the mix: 8&#x27;/16&#x27;/20&#x27; portable steel containers +…">
        <bpmn:documentation>Step 1: Size the container fleet &amp; set the mix: 8&#x27;/16&#x27;/20&#x27; portable steel containers + tilt-bed/deliverable &quot;mobile&quot; units, the home/jobsite-delivery model (PODS-style), fleet-to-customer ratio, and the depot/return network per DC (VS-04)
Responsible (R): Fleet / Director Storage
Accountable (A): Director Storage
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5036_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5036_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5036_Task6" name="Procure &amp; take delivery: container vendor selection, spec (wind/water-tight…">
        <bpmn:documentation>Step 2: Procure &amp; take delivery: container vendor selection, spec (wind/water-tight, lock-box, ISO/certified), title/asset tagging, and fixed-asset capitalisation (VS-35); plan the delivery flatbed/tilt truck fleet or 3PL (VS-06/VS-56)
Responsible (R): Procurement / Fleet / Finance
Accountable (A): Director Storage
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W5036_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5036_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5036_Task7" name="Govern fleet risk &amp; insurance: container all-risk/CTPL-equivalent for the…">
        <bpmn:documentation>Step 3: Govern fleet risk &amp; insurance: container all-risk/CTPL-equivalent for the delivery vehicle, theft/vandalism coverage, and the customer liability waiver (W5042) with Insurance/Legal (VS-26/VS-100)
Responsible (R): Fleet / Insurance / Legal
Accountable (A): Director Storage
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5036_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5036_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5036_End8" name="Complete">
        <bpmn:incoming>W5036_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5036_Annotation9">
        <bpmn:text>Controls: - CTL-752 (ensure controlled execution — Storage Portfolio Strategy, Site Selection &amp; Unit/Container Capacity Planning (PA-174.1).) | - CTL-752: container capex within VS-35/VS-40 matrix; insurance coverage VS-26-confirmed; asset tagging/reconciliation (links VS-111)
Owner: Director, Storage &amp; Rental Services / Fleet (VS-06)</bpmn:text>
      </bpmn:textAnnotation>
