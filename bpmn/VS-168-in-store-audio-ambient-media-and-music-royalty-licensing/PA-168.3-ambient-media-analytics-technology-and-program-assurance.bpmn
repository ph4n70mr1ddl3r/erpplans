    <bpmn:process id="W_W4905" name="W4905. In-Store Media Performance &amp; Customer-Experience Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Program live (W4889); monthly/quarterly review; campaign close (W4901)
Frequency: Continuous analytics + monthly/quarterly review
Volume: 1 group analytics program × ~205 sites × campaign cycles
Owner: In-Store Media Manager / Analytics (VS-28) / CX (VS-13)
Participants: Analytics (VS-28), CX (VS-13), Marketing (VS-14), Finance (VS-17.4), Store Ops (VS-07)
Source: workflow W4905 — In-Store Media Performance &amp; Customer-Experience Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4905_LaneSet3">
        <bpmn:lane id="W4905_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4905_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4905_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4905_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4905_Lane2" name="In-Store Media Manager">
        <bpmn:flowNodeRef>W4905_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4905_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4905_Start4" name="Program live (W4889); monthly/quarterly review; campaign close (W4901)">
        <bpmn:outgoing>W4905_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4905_Task5" name="Define the in-store-media KPI set: music/signage uptime &amp; compliance…">
        <bpmn:documentation>Step 1: Define the in-store-media KPI set: music/signage uptime &amp; compliance, footfall/dwell (links W1250), footfall-to-basket attribution, campaign lift (W4901), CX/CSAT impact (VS-13/VS-146), VS-48 retail-media slot-fill &amp; vendor-ad performance, and the cost/co-fund recovery ratio
Responsible (R): Analytics / CX / In-Store Media Manager
Accountable (A): VP Marketing
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W4905_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4905_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4905_Task6" name="Build the analytics: integrate footfall/people-counter, POS/basket, CX-survey…">
        <bpmn:documentation>Step 2: Build the analytics: integrate footfall/people-counter, POS/basket, CX-survey, and media-playback data (VS-28/VS-126); isolate ambient-media uplift (control vs test stores, A/B by zone/time); and produce the monthly/quarterly in-store-media dashboard
Responsible (R): Analytics / CX / DAM
Accountable (A): In-Store Media Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4905_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4905_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4905_Task7" name="Review &amp; act: monthly marketing/finance review (links VS-33.2), reallocate…">
        <bpmn:documentation>Step 3: Review &amp; act: monthly marketing/finance review (links VS-33.2), reallocate spend from under- to over-performing media/zones/campaigns, feed learnings to strategy (W4889) and programming (W4890/W4893), and report to the CMO/CFO
Responsible (R): In-Store Media Manager / Marketing Finance / Analytics
Accountable (A): VP Marketing / CFO
Duration: Monthly/quarterly</bpmn:documentation>
        <bpmn:incoming>W4905_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4905_End8" name="Complete">
        <bpmn:incoming>W4905_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4905_Annotation9">
        <bpmn:text>Controls: - CTL-736 (ensure controlled execution — Ambient Media Analytics, Technology &amp; Program Assurance (PA-168.3).) | - CTL-736: balanced KPI set (uptime + CX + basket + cost); A/B isolation; monthly review with finance
Owner: In-Store Media Manager / Analytics (VS-28) / CX (VS-13)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4905_Assoc10" sourceRef="W4905_Annotation9" targetRef="W4905_Start4" associationDirection="None" />
