      <bpmn:sequenceFlow id="W4907_Flow13" sourceRef="W4907_Task6" targetRef="W4907_Task7" />
      <bpmn:sequenceFlow id="W4907_Flow14" sourceRef="W4907_Task7" targetRef="W4907_End8" />
    </bpmn:process>
