      <bpmn:sequenceFlow id="W4905_Flow12" sourceRef="W4905_Task5" targetRef="W4905_Task6" />
      <bpmn:sequenceFlow id="W4905_Flow13" sourceRef="W4905_Task6" targetRef="W4905_Task7" />
      <bpmn:sequenceFlow id="W4905_Flow14" sourceRef="W4905_Task7" targetRef="W4905_End8" />
    </bpmn:process>
