        <bpmn:outgoing>W4911_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4911_Task5" name="Scout emerging in-store-media tech: AI-generated/royalty-free music (lower…">
        <bpmn:documentation>Step 1: Scout emerging in-store-media tech: AI-generated/royalty-free music (lower license cost, IP-clearance care VS-100.2), programmatic/contextual signage (weather/time/footfall-triggered), IoT sensing (occupancy/dwell/queue → adaptive music/signage W4448), voice/analytics, and AR/interactive displays; evaluate via the VS-30 POC pipeline
Responsible (R): Innovation / In-Store Media Manager / EA
Accountable (A): VP Marketing / CIO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4911_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4911_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4911_Task6" name="Run responsible pilots with AI-governance (VS-128): model/IP-risk review for AI…">
        <bpmn:documentation>Step 2: Run responsible pilots with AI-governance (VS-128): model/IP-risk review for AI music, bias/fairness for adaptive content, privacy DPIA for IoT/voice/footfall sensing (VS-91), and clear success criteria; manage as PoCs before scale
Responsible (R): Innovation / AI Governance / Privacy / CX
Accountable (A): VP Marketing
Duration: Per pilot</bpmn:documentation>
        <bpmn:incoming>W4911_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4911_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4911_Task7" name="Scale successful innovation into the program (W4889/W4907): deploy via EA…">
        <bpmn:documentation>Step 3: Scale successful innovation into the program (W4889/W4907): deploy via EA change governance (VS-113), update the asset/architecture (W4906/W4907), track uplift (W4905), and retire pilots that underperform
Responsible (R): In-Store Media Manager / EA / Analytics
Accountable (A): VP Marketing
Duration: Per scale</bpmn:documentation>
        <bpmn:incoming>W4911_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4911_End8" name="Complete">
        <bpmn:incoming>W4911_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4911_Annotation9">
        <bpmn:text>Controls: - CTL-736 (ensure controlled execution — Ambient Media Analytics, Technology &amp; Program Assurance (PA-168.3).) | - CTL-736: AI-music IP-clearance + model-governance (VS-128); IoT/voice DPIA (VS-91); pilot-gated scale with success criteria
Owner: In-Store Media Manager / Innovation (VS-30) / AI Governance (VS-128)</bpmn:text>
      </bpmn:textAnnotation>
