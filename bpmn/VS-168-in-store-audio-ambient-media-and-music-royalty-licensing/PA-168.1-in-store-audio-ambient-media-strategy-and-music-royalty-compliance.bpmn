    <bpmn:process id="W_W4890" name="W4890. Background Music Programming, Playlist Strategy &amp; Brand-Sound Standards" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy set (W4889); seasonal calendar (VS-13.2/VS-64); brand refresh
Frequency: Continuous programming + seasonal refresh
Volume: ~4–6 dayparts × ~12 months × group-wide standard applied to 200 stores
Owner: In-Store Media &amp; Brand-Experience Manager / Brand
Participants: Marketing (VS-14), Store Ops (VS-07), Commercial music provider (W4892)
Source: workflow W4890 — Background Music Programming, Playlist Strategy &amp; Brand-Sound Standards</bpmn:documentation>
      <bpmn:laneSet id="W4890_LaneSet3">
        <bpmn:lane id="W4890_Lane1" name="Brand">
        <bpmn:flowNodeRef>W4890_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4890_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4890_Lane2" name="In-Store Media Manager">
        <bpmn:flowNodeRef>W4890_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4890_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4890_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4890_Start4" name="Strategy set (W4889); seasonal calendar (VS-13.2/VS-64); brand refresh">
        <bpmn:outgoing>W4890_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4890_Task5" name="Define the brand-sound standard: genre/mood/tempo/loudness by zone and daypart…">
        <bpmn:documentation>Step 1: Define the brand-sound standard: genre/mood/tempo/loudness by zone and daypart (e.g., upbeat morning, midafternoon trade-pro-leaning, calmer late-day), lyrics/clean-edit policy (family-friendly, no explicit content), Filipino/OPM content quota supporting local artists, and the playlist-rotation/refresh cadence to prevent staff fatigue
Responsible (R): Brand / In-Store Media Manager
Accountable (A): VP Marketing
Duration: Per refresh</bpmn:documentation>
        <bpmn:incoming>W4890_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4890_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4890_Task6" name="Program playlists via the commercial music service (W4892): build zone/daypart…">
        <bpmn:documentation>Step 2: Program playlists via the commercial music service (W4892): build zone/daypart schedules, the seasonal/ber-months/event overlays (links VS-14/VS-64), the promo interstitials, and the licensed-vs-original music mix; verify all programmed tracks are royalty-covered (W4891)
Responsible (R): In-Store Media Manager / Provider
Accountable (A): In-Store Media Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4890_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4890_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4890_Task7" name="Publish the standard to stores, train store managers on volume/override limits…">
        <bpmn:documentation>Step 3: Publish the standard to stores, train store managers on volume/override limits (links VS-07/W4898), and audit adherence (W4908); manage exceptions (regional/local-store events, contractor-lounge differ-entiation)
Responsible (R): In-Store Media Manager / Store Ops / Training
Accountable (A): VP Marketing
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4890_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4890_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4890_End8" name="Complete">
        <bpmn:incoming>W4890_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4890_Annotation9">
        <bpmn:text>Controls: - CTL-734 (ensure controlled execution — In-Store Audio, Ambient Media Strategy &amp; Music Royalty Compliance (PA-168.1).) | - CTL-734: brand-sound standard published; clean-edit + royalty-cover enforced; store-override limited &amp; audited
Owner: In-Store Media &amp; Brand-Experience Manager / Brand</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4890_Assoc10" sourceRef="W4890_Annotation9" targetRef="W4890_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4890_Flow11" sourceRef="W4890_Start4" targetRef="W4890_Task5" />
      <bpmn:sequenceFlow id="W4890_Flow12" sourceRef="W4890_Task5" targetRef="W4890_Task6" />
      <bpmn:sequenceFlow id="W4890_Flow13" sourceRef="W4890_Task6" targetRef="W4890_Task7" />
      <bpmn:sequenceFlow id="W4890_Flow14" sourceRef="W4890_Task7" targetRef="W4890_End8" />
    </bpmn:process>
