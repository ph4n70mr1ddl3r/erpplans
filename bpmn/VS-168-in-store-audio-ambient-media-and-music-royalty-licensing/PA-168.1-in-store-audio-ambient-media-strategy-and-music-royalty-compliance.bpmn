<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-168.1-in-store-audio-ambient-media-strategy-and-music-royalty-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4889" name="W4889. In-Store Audio, Ambient Media &amp; Customer-Experience Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual CX/brand review (links VS-13/VS-14); format evolution (VS-109)
Frequency: Annual + on launch
Volume: 1 group ambient-media strategy applied across ~205 sites (200 stores + 4 DCs + HQ)
Owner: VP Marketing / In-Store Media &amp; Brand-Experience Manager
Participants: Marketing (VS-14), Store Ops (VS-07), CX (VS-13), IT (VS-27/VS-113), Finance (VS-17.4), Real Estate (VS-97)
Source: workflow W4889 — In-Store Audio, Ambient Media &amp; Customer-Experience Strategy</bpmn:documentation>
      <bpmn:laneSet id="W4889_LaneSet2">
        <bpmn:lane id="W4889_Lane1" name="In-Store Media Manager">
        <bpmn:flowNodeRef>W4889_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4889_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4889_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4889_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4889_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4889_Start3" name="Program launch; annual CX/brand review (links VS-13/VS-14); format evolution (VS-109)">
        <bpmn:outgoing>W4889_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4889_Task4" name="Set the in-store ambient-media strategy &amp; operating model: the channel mix…">
        <bpmn:documentation>Step 1: Set the in-store ambient-media strategy &amp; operating model: the channel mix (background music, PA/paging, in-store digital signage, ambient scent), the brand-sound/sensory identity aligned to the &quot;Your Home Building Partner&quot; positioning, the zone-based experience (sales floor, lumber yard, contractor/pro lounge, customer-service counter, checkout, garden center), and the own-operate vs vendor-managed decision per channel
Responsible (R): In-Store Media Manager / Brand / CX
Accountable (A): VP Marketing
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4889_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4889_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4889_Task5" name="Build the strategic case: footfall/dwell/basket uplift evidence…">
        <bpmn:documentation>Step 2: Build the strategic case: footfall/dwell/basket uplift evidence, brand-consistency across 200 stores, contractor/pro-experience differentiation (links VS-43/W1493), the opex/capex envelope, and KPIs (music-license compliance 100%, signage-uptime, footfall-to-basket attribution, CX/CSAT impact); sequence the multi-year roadmap into capex (VS-40) and the store-remodel/new-store programs (VS-109/VS-37)
Responsible (R): In-Store Media Manager / Finance / Analytics
Accountable (A): VP Marketing / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4889_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4889_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4889_Task6" name="Approve the program charter, operating budget, and governance (W4896)…">
        <bpmn:documentation>Step 3: Approve the program charter, operating budget, and governance (W4896); integrate into the marketing plan (VS-14), store-ops standards (VS-07), and the capex pipeline (VS-40/VS-112)
Responsible (R): In-Store Media Manager / Strategy / PMO
Accountable (A): COO / CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4889_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4889_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4889_End7" name="Complete">
        <bpmn:incoming>W4889_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4889_Annotation8">
        <bpmn:text>Controls: - CTL-734 (ensure controlled execution — In-Store Audio, Ambient Media Strategy &amp; Music Royalty Compliance (PA-168.1).) | - CTL-734: annual business case reviewed by CMO/CFO; channel-mix &amp; zoning documented; capex via VS-40 gate
Owner: VP Marketing / In-Store Media &amp; Brand-Experience Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4889_Assoc9" sourceRef="W4889_Annotation8" targetRef="W4889_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4889_Flow10" sourceRef="W4889_Start3" targetRef="W4889_Task4" />
      <bpmn:sequenceFlow id="W4889_Flow11" sourceRef="W4889_Task4" targetRef="W4889_Task5" />
      <bpmn:sequenceFlow id="W4889_Flow12" sourceRef="W4889_Task5" targetRef="W4889_Task6" />
      <bpmn:sequenceFlow id="W4889_Flow13" sourceRef="W4889_Task6" targetRef="W4889_End7" />
    </bpmn:process>
