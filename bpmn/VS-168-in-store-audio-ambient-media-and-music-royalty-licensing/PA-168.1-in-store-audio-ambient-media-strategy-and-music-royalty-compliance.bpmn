    <bpmn:process id="W_W4891" name="W4891. Music Royalty Licensing — FILSCAP / OPM / IP Compliance &amp; Statutory Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch (W4889); annual license renewal; playlist change (W4890); audit
Frequency: Annual license + continuous playlist-coverage verification
Volume: ~3–6 licensing societies (FILSCAP + sound-recording/mechanical/international) × group-wide coverage across 205 sites
Owner: Legal (VS-100.3) / In-Store Media Manager / Finance
Participants: FILSCAP &amp; other PROs, Commercial music provider (W4892), Legal (VS-100), IP (VS-100.2), Internal Audit (VS-21)
Source: workflow W4891 — Music Royalty Licensing — FILSCAP / OPM / IP Compliance &amp; Statutory Reporting</bpmn:documentation>
      <bpmn:laneSet id="W4891_LaneSet2">
        <bpmn:lane id="W4891_Lane1" name="Legal">
        <bpmn:flowNodeRef>W4891_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4891_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4891_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4891_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4891_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4891_Start3" name="Program launch (W4889); annual license renewal; playlist change (W4890); audit">
        <bpmn:outgoing>W4891_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4891_Task4" name="Identify all required music-public-performance licenses for public performance…">
        <bpmn:documentation>Step 1: Identify all required music-public-performance licenses for public performance of copyrighted musical works and sound recordings in 200 stores under RA 8293 (IP Code): FILSCAP (Filipino + affiliated international societies for musical works), and the sound-recording/mechanical rights where applicable; scope per site-type and confirm the commercial music service&#x27;s blanket-license coverage vs BuildRight&#x27;s direct obligation
Responsible (R): Legal / In-Store Media Manager
Accountable (A): VP Legal / VP Marketing
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4891_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4891_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4891_Task5" name="Obtain/maintain the licenses: complete the FILSCAP establishment survey (no. of…">
        <bpmn:documentation>Step 2: Obtain/maintain the licenses: complete the FILSCAP establishment survey (no. of sites, floor area, ambient vs featured use), negotiate the annual blanket license fee (typically area/no.-of-speakers-based), execute agreements, and pay; retain certificates and renewal calendar (links VS-166)
Responsible (R): Legal / Finance / In-Store Media Manager
Accountable (A): VP Legal / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4891_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4891_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4891_Task6" name="Verify ongoing compliance &amp; statutory reporting: cross-check programmed…">
        <bpmn:documentation>Step 3: Verify ongoing compliance &amp; statutory reporting: cross-check programmed playlists (W4890) against license coverage, submit any required music-use reports to FILSCAP/societies, manage the renewal calendar (W4889 of VS-166) to prevent lapse, and maintain the audit-ready evidence file for VS-21/internal-audit and any FILSCAP inspection (W4908)
Responsible (R): Legal / In-Store Media Manager / Audit
Accountable (A): VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4891_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4891_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4891_End7" name="Complete">
        <bpmn:incoming>W4891_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4891_Annotation8">
        <bpmn:text>Controls: - CTL-96 (ensure music-licensing &amp; audio compliance.) | - CTL-734: FILSCAP blanket license current for all 205 sites; playlist coverage verified before publish; renewal calendar tracked; audit-ready evidence
Owner: Legal (VS-100.3) / In-Store Media Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4891_Assoc9" sourceRef="W4891_Annotation8" targetRef="W4891_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4891_Flow10" sourceRef="W4891_Start3" targetRef="W4891_Task4" />
      <bpmn:sequenceFlow id="W4891_Flow11" sourceRef="W4891_Task4" targetRef="W4891_Task5" />
      <bpmn:sequenceFlow id="W4891_Flow12" sourceRef="W4891_Task5" targetRef="W4891_Task6" />
      <bpmn:sequenceFlow id="W4891_Flow13" sourceRef="W4891_Task6" targetRef="W4891_End7" />
    </bpmn:process>
