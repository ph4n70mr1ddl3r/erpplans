    <bpmn:process id="W_W4898" name="W4898. Background Music Daily Operations, Scheduling &amp; Volume / Zone Control" isExecutable="false">
      <bpmn:documentation>Trigger: Store open (links VS-07.1); daypart change; playlist update (W4890)
Frequency: Daily, continuous during trading hours
Volume: 200 stores × ~12 trading hours/day × zone/daypart playback
Owner: Store Manager / Assistant Store Manager
Participants: In-Store Media Manager (VS-168), Store Ops (VS-07), Commercial music provider (W4892)
Source: workflow W4898 — Background Music Daily Operations, Scheduling &amp; Volume / Zone Control</bpmn:documentation>
      <bpmn:laneSet id="W4898_LaneSet2">
        <bpmn:lane id="W4898_Lane1" name="Assistant SM">
        <bpmn:flowNodeRef>W4898_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4898_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4898_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4898_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4898_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4898_Start3" name="Store open (links VS-07.1); daypart change; playlist update (W4890)">
        <bpmn:outgoing>W4898_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4898_Task4" name="Start/stop the music per opening/closing (links VS-07.1): confirm the player is…">
        <bpmn:documentation>Step 1: Start/stop the music per opening/closing (links VS-07.1): confirm the player is online and on-schedule (W4890), set the trading-hours daypart, and verify the zone coverage (sales floor, pro lounge, garden center; exclude paint/chemical aisles if scent-sensitive W4894)
Responsible (R): Assistant SM
Accountable (A): Store Manager
Duration: Open/close</bpmn:documentation>
        <bpmn:incoming>W4898_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4898_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4898_Task5" name="Monitor volume &amp; zoning: keep volume within the brand standard (audible but…">
        <bpmn:documentation>Step 2: Monitor volume &amp; zoning: keep volume within the brand standard (audible but conversational), auto-duck for PA (W4897), respect quiet hours, and manage zone-specific levels (calmer checkout/pro-lounge); log any override
Responsible (R): Assistant SM / Store Staff
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4898_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4898_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4898_Task6" name="Handle player/content exceptions: offline fallback (local cache per W4892)…">
        <bpmn:documentation>Step 3: Handle player/content exceptions: offline fallback (local cache per W4892), report outages/content issues to IT (VS-27) and the In-Store Media Manager, and confirm royalty-covered content (W4891) is playing
Responsible (R): Assistant SM / IT / In-Store Media Manager
Accountable (A): Store Manager
Duration: Per exception</bpmn:documentation>
        <bpmn:incoming>W4898_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4898_End7" name="Complete">
        <bpmn:incoming>W4898_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4898_Annotation8">
        <bpmn:text>Controls: - CTL-96 (ensure music-licensing &amp; audio compliance.) | - CTL-735: brand-standard volume + zoning; override limited &amp; logged; offline fallback; royalty-covered content verified
Owner: Store Manager / Assistant Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4898_Assoc9" sourceRef="W4898_Annotation8" targetRef="W4898_Start3" associationDirection="None" />
