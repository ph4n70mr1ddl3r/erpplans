    <bpmn:process id="W_W4900" name="W4900. Audio / PA / Digital-Signage Equipment Preventive Maintenance &amp; Health Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: PM schedule; health-alert (offline/faulty screen/speaker); reactive fault
Frequency: Periodic PM + continuous monitoring + reactive
Volume: ~15–25 speakers/amps/mics/screens per store × 205 sites
Owner: Facilities AV Lead (VS-138) / IT Field (VS-27) / In-Store Media Manager
Participants: Facilities (VS-138), IT (VS-27), Asset Mgmt (VS-35), Store Ops (VS-07), Vendor (W4492/W4910)
Source: workflow W4900 — Audio / PA / Digital-Signage Equipment Preventive Maintenance &amp; Health Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W4900_LaneSet3">
        <bpmn:lane id="W4900_Lane1" name="IT">
        <bpmn:flowNodeRef>W4900_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4900_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4900_Lane2" name="Facilities">
        <bpmn:flowNodeRef>W4900_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4900_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4900_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
