    <bpmn:process id="W_W4853" name="W4853. Expiring/Lapsed Permit Remediation &amp; Business-Continuity Workaround" isExecutable="false">
      <bpmn:documentation>Trigger: At-risk renewal (W4845); lapsed permit; regulator notice of lapse/operating-without-permit
Frequency: Ad hoc
Volume: ~rare lapse events; ~any lapse is critical
Owner: Compliance Portfolio Manager / Domain Owner / Legal (VS-100.3)
Participants: COO, Store/DC Ops (VS-07/VS-04), Finance, BCP (VS-26)
Source: workflow W4853 — Expiring/Lapsed Permit Remediation &amp; Business-Continuity Workaround</bpmn:documentation>
      <bpmn:laneSet id="W4853_LaneSet4">
        <bpmn:lane id="W4853_Lane1" name="Compliance Operations">
        <bpmn:flowNodeRef>W4853_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4853_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4853_Lane2" name="Domain Owner">
        <bpmn:flowNodeRef>W4853_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4853_Lane3" name="Compliance Portfolio Manager">
        <bpmn:flowNodeRef>W4853_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4853_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4853_Start5" name="At-risk renewal (W4845); lapsed permit; regulator notice of lapse/operating-without-permit">
        <bpmn:outgoing>W4853_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4853_Task6" name="Detect the lapse/at-risk (calendar alert non-response W4845, regulator notice…">
        <bpmn:documentation>Step 1: Detect the lapse/at-risk (calendar alert non-response W4845, regulator notice, or self-identified); assess business impact (store-closing, bid-blocking, fines, operating-without-permit offense) and escalate to VP Legal &amp; Compliance / COO immediately
Responsible (R): Compliance Operations / Domain Owner / Legal
Accountable (A): Compliance Portfolio Manager / VP Legal &amp; Compliance / COO
Duration: Per event (immediate)</bpmn:documentation>
        <bpmn:incoming>W4853_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4853_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4853_Task7" name="Remediate: expedite the renewal (W4849), engage the regulator for a cure/grace…">
        <bpmn:documentation>Step 2: Remediate: expedite the renewal (W4849), engage the regulator for a cure/grace period where available, and where the lapse is operational (e.g., lapsed LGU business permit) deploy the business-continuity workaround (e.g., temporary-operation permit, adjacent-site fulfillment, BCP VS-26) to sustain operations; manage any penalty (W4858)
Responsible (R): Domain Owner / Legal / Store Ops / BCP
Accountable (A): Compliance Portfolio Manager / COO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4853_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4853_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4853_Task8" name="Reinstate &amp; prevent recurrence: obtain the renewed authorization, reset the…">
        <bpmn:documentation>Step 3: Reinstate &amp; prevent recurrence: obtain the renewed authorization, reset the calendar (W4845), conduct root-cause (ownership failure W4844, calendar failure, provider failure W4854), strengthen controls, and report the incident to governance (W4864) and analytics (W4862)
Responsible (R): Compliance Portfolio Manager / Internal Audit
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4853_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4853_End9" name="Complete">
        <bpmn:incoming>W4853_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4853_Annotation10">
        <bpmn:text>Controls: - CTL-729 (ensure controlled execution — Renewal Execution, Inspection Coordination &amp; Multi-Site Campaigns (PA-166.2).) | - CTL-729: lapse escalated immediately; continuity workaround deployed; reinstatement tracked; root-cause reviewed
Owner: Compliance Portfolio Manager / Domain Owner / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4853_Assoc11" sourceRef="W4853_Annotation10" targetRef="W4853_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4853_Flow12" sourceRef="W4853_Start5" targetRef="W4853_Task6" />
      <bpmn:sequenceFlow id="W4853_Flow13" sourceRef="W4853_Task6" targetRef="W4853_Task7" />
      <bpmn:sequenceFlow id="W4853_Flow14" sourceRef="W4853_Task7" targetRef="W4853_Task8" />
      <bpmn:sequenceFlow id="W4853_Flow15" sourceRef="W4853_Task8" targetRef="W4853_End9" />
    </bpmn:process>
