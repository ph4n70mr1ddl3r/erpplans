<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-166.2-renewal-execution-inspection-coordination-and-multi-site-campaigns" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4849" name="W4849. Renewal-Cycle Execution &amp; Cross-Domain Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Calendar alert (W4845); renewal cycle
Frequency: Continuous (per authorization&#x27;s cycle)
Volume: All renewable authorizations (~thousands/yr)
Owner: Compliance Operations / Domain Renewal Owners
Participants: Domain compliance owners (VS-22/76/79/114/117/138/145/165/46/06), Finance (fees), Legal (VS-100.3)
Source: workflow W4849 — Renewal-Cycle Execution &amp; Cross-Domain Coordination</bpmn:documentation>
      <bpmn:laneSet id="W4849_LaneSet3">
        <bpmn:lane id="W4849_Lane1" name="Domain Owner">
        <bpmn:flowNodeRef>W4849_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4849_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4849_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4849_Lane2" name="Compliance Operations">
        <bpmn:flowNodeRef>W4849_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4849_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4849_Start4" name="Calendar alert (W4845); renewal cycle">
        <bpmn:outgoing>W4849_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4849_Task5" name="On calendar alert (W4845), the domain owner prepares the renewal package…">
        <bpmn:documentation>Step 1: On calendar alert (W4845), the domain owner prepares the renewal package (forms, supporting documents, fee) per the authorization&#x27;s renewal rule and the evidence standard (W4846); coordinate any cross-domain dependencies (e.g., BIR CAS renewal needs current mayor&#x27;s permit)
Responsible (R): Domain Owner / Compliance Operations
Accountable (A): Domain Accountable Owner
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W4849_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4849_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4849_Task6" name="Submit &amp; track: file with the regulator (or via third-party provider W4854)…">
        <bpmn:documentation>Step 2: Submit &amp; track: file with the regulator (or via third-party provider W4854), track processing, respond to queries, and obtain the renewed authorization within the lead-time; coordinate the fee payment (VS-17) and update the register (W4842) on receipt
Responsible (R): Domain Owner / Compliance Operations / Finance
Accountable (A): Domain Accountable Owner
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W4849_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4849_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4849_Task7" name="Close the renewal: record renewed authorization + evidence in the repository…">
        <bpmn:documentation>Step 3: Close the renewal: record renewed authorization + evidence in the repository (W4846), reset the calendar (W4845), and confirm on the dashboard; escalate any delay to remediation (W4853) before lapse
Responsible (R): Compliance Operations / Domain Owner
Accountable (A): Compliance Portfolio Manager
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W4849_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4849_End8" name="Complete">
        <bpmn:incoming>W4849_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4849_Annotation9">
        <bpmn:text>Controls: - CTL-729 (ensure controlled execution — Renewal Execution, Inspection Coordination &amp; Multi-Site Campaigns (PA-166.2).) | - CTL-729: renewal filed within lead-time; cross-domain dependencies resolved; renewed authorization recorded
Owner: Compliance Operations / Domain Renewal Owners</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4849_Assoc10" sourceRef="W4849_Annotation9" targetRef="W4849_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4849_Flow11" sourceRef="W4849_Start4" targetRef="W4849_Task5" />
      <bpmn:sequenceFlow id="W4849_Flow12" sourceRef="W4849_Task5" targetRef="W4849_Task6" />
      <bpmn:sequenceFlow id="W4849_Flow13" sourceRef="W4849_Task6" targetRef="W4849_Task7" />
      <bpmn:sequenceFlow id="W4849_Flow14" sourceRef="W4849_Task7" targetRef="W4849_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4849_diag">
