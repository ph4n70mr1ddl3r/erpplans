    <bpmn:process id="W_W4854" name="W4854. Third-Party Permit/Compliance Service-Provider (Fixer/Consultant/Agent) Management" isExecutable="false">
      <bpmn:documentation>Trigger: Permit-service need (renewal W4849, acquisition W4851, inspection W4852); provider contract; ABC/anti-corruption review
Frequency: Per engagement + contract management
Volume: ~10–15 permit-service providers/agents across regions
Owner: Compliance Portfolio Manager / Procurement (VS-03/VS-34) / Legal (VS-100.3)
Participants: Government Affairs (VS-104), TPRM (VS-161), Finance, ABC (VS-86)
Source: workflow W4854 — Third-Party Permit/Compliance Service-Provider (Fixer/Consultant/Agent) Management</bpmn:documentation>
      <bpmn:laneSet id="W4854_LaneSet4">
        <bpmn:lane id="W4854_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W4854_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4854_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
