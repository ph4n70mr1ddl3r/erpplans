        <bpmndi:BPMNShape id="W4843_Start3_di" bpmnElement="W4843_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4843_End7_di" bpmnElement="W4843_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4843_Annotation8_di" bpmnElement="W4843_Annotation8"><dc:Bounds x="160" y="290" width="360" height="114" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4843_Flow10_di" bpmnElement="W4843_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4843_Flow11_di" bpmnElement="W4843_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4843_Flow12_di" bpmnElement="W4843_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4843_Flow13_di" bpmnElement="W4843_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4843_Assoc9_di" bpmnElement="W4843_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
