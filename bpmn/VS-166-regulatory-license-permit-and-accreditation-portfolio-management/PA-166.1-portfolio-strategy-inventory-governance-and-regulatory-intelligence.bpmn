      <bpmndi:BPMNPlane id="W4842_plane" bpmnElement="W_W4842">
        <bpmndi:BPMNShape id="W4842_Lane1_di" bpmnElement="W4842_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
