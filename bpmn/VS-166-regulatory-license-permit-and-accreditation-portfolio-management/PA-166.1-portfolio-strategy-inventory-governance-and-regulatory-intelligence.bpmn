        <bpmndi:BPMNShape id="W4842_Start3_di" bpmnElement="W4842_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4842_End7_di" bpmnElement="W4842_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4842_Annotation8_di" bpmnElement="W4842_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4842_Flow10_di" bpmnElement="W4842_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4842_Flow11_di" bpmnElement="W4842_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4842_Flow12_di" bpmnElement="W4842_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4842_Flow13_di" bpmnElement="W4842_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4842_Assoc9_di" bpmnElement="W4842_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4843" name="W4843. Regulatory Intelligence — Obligation Mapping by Site/Entity/Activity" isExecutable="false">
      <bpmn:documentation>Trigger: New site/activity (store VS-37, DC, locker VS-164, EV charger VS-163, new service VS-156); regulator change (W4847); annual refresh
Frequency: Per new site/activity + annual
Volume: ~205 sites × activity-mix; new-site onboarding (~10–15/yr)
Owner: Compliance Portfolio Manager / Regulatory Intelligence Analyst
Participants: Government Affairs (VS-104), domain compliance owners, Legal (VS-100.3), Real Estate (VS-97)
Source: workflow W4843 — Regulatory Intelligence — Obligation Mapping by Site/Entity/Activity</bpmn:documentation>
      <bpmn:laneSet id="W4843_LaneSet2">
        <bpmn:lane id="W4843_Lane1" name="Regulatory Intelligence">
        <bpmn:flowNodeRef>W4843_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4843_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4843_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4843_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4843_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4843_Start3" name="New site/activity (store VS-37, DC, locker VS-164, EV charger VS-163, new service…">
        <bpmn:outgoing>W4843_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4843_Task4" name="Maintain the regulatory-obligation map: for each site type…">
        <bpmn:documentation>Step 1: Maintain the regulatory-obligation map: for each site type (store/DC/HQ/locker/EV charger) and activity (retail, installation, B2G, hazmat, VAS/bills-payment, renewable generation), the full set of required authorizations (LGU, BFP, DENR, BIR, DTI, PCAB, FDA/FPA, BSP, NPC, energy, etc.) by geography (region/LGU-specific differences); source from Government Affairs (VS-104) and regulators
Responsible (R): Regulatory Intelligence / Government Affairs / Domain Owners
Accountable (A): Compliance Portfolio Manager
Duration: Continuous + annual</bpmn:documentation>
        <bpmn:incoming>W4843_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4843_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4843_Task5" name="Apply on new site/activity (VS-37 store open, VS-109 remodel, VS-163/VS-164 new…">
        <bpmn:documentation>Step 2: Apply on new site/activity (VS-37 store open, VS-109 remodel, VS-163/VS-164 new asset, VS-156 new service): generate the required-permit checklist for that site/activity/geography, assign owners (W4844), and seed the acquisition campaign (W4851); verify no activity starts before authorizations are in place
Responsible (R): Regulatory Intelligence / Store Ops / Real Estate
Accountable (A): Compliance Portfolio Manager / VP Legal &amp; Compliance
Duration: Per new site/activity</bpmn:documentation>
        <bpmn:incoming>W4843_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4843_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4843_Task6" name="Maintain obligation-coverage gaps: detect activities/sites missing a required…">
        <bpmn:documentation>Step 3: Maintain obligation-coverage gaps: detect activities/sites missing a required authorization (vs the obligation map), prioritize remediation (W4853), and feed obligation changes (W4847) to the map and register
Responsible (R): Regulatory Intelligence / Domain Owners
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4843_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4843_End7" name="Complete">
        <bpmn:incoming>W4843_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4843_Annotation8">
        <bpmn:text>Controls: - CTL-728 (ensure controlled execution — Portfolio Strategy, Inventory, Governance &amp; Regulatory Intelligence (PA-166.1).); CTL-729 (ensure controlled execution — Renewal Execution, Inspection Coordination &amp; Multi-Site Campaigns (PA-166.2).) | - CTL-728: obligation map applied at every new site/activity; no activity before authorizations in place; coverage gaps remediated
Owner: Compliance Portfolio Manager / Regulatory Intelligence Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4843_Assoc9" sourceRef="W4843_Annotation8" targetRef="W4843_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4843_Flow10" sourceRef="W4843_Start3" targetRef="W4843_Task4" />
      <bpmn:sequenceFlow id="W4843_Flow11" sourceRef="W4843_Task4" targetRef="W4843_Task5" />
      <bpmn:sequenceFlow id="W4843_Flow12" sourceRef="W4843_Task5" targetRef="W4843_Task6" />
      <bpmn:sequenceFlow id="W4843_Flow13" sourceRef="W4843_Task6" targetRef="W4843_End7" />
    </bpmn:process>
