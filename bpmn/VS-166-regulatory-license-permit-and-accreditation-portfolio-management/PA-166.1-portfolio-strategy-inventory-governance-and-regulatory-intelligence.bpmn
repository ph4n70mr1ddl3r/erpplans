        <bpmn:outgoing>W4845_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4845_Task4" name="Operate the renewal calendar from the register (W4842): every authorization&#x27;s…">
        <bpmn:documentation>Step 1: Operate the renewal calendar from the register (W4842): every authorization&#x27;s expiry, renewal lead-time, required documents, fee, and owner; tiered alerts (90/60/30/7 days) routed to the owner (W4844); reconcile expiries monthly
Responsible (R): Compliance Operations
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4845_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4845_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4845_Task5" name="Run the expiry-risk engine: prioritize by business impact (store-closing…">
        <bpmn:documentation>Step 2: Run the expiry-risk engine: prioritize by business impact (store-closing LGU/BFP/BIR, bid-blocking PhilGEPS/PCAB, service-blocking BSP/PCAB, fleet-blocking LTO/LTFRB), flag at-risk renewals (owner non-response, document gaps, regulator backlog), and escalate critical-risk items to the VP Legal &amp; Compliance / COO
Responsible (R): Compliance Operations / Domain Owners
Accountable (A): Compliance Portfolio Manager / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4845_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4845_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4845_Task6" name="Maintain the compliance dashboard: coverage %, on-time-renewal %…">
        <bpmn:documentation>Step 3: Maintain the compliance dashboard: coverage %, on-time-renewal %, expiring-soon, at-risk, lapse/penalty incidents, inspection findings, by entity/site/domain; distribute to owners, executives, and the board (VS-36)
Responsible (R): Compliance Operations / Analytics
Accountable (A): Compliance Portfolio Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4845_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4845_End7" name="Complete">
        <bpmn:incoming>W4845_Flow13</bpmn:incoming>
      </bpmn:endEvent>
