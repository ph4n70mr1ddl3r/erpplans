      <bpmn:sequenceFlow id="W4848_Flow11" sourceRef="W4848_Task4" targetRef="W4848_Task5" />
      <bpmn:sequenceFlow id="W4848_Flow12" sourceRef="W4848_Task5" targetRef="W4848_Task6" />
      <bpmn:sequenceFlow id="W4848_Flow13" sourceRef="W4848_Task6" targetRef="W4848_End7" />
    </bpmn:process>
