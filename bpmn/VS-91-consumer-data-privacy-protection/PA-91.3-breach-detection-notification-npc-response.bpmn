    <bpmn:process id="W_W3057" name="W3057. Personal Data Breach Detection, Triage &amp; Incident Activation" isExecutable="false">
      <bpmn:documentation>Trigger: Suspected breach signal (SIEM alert, report, anomaly)
Frequency: Event-driven
Volume: Varies; majority false-positive
Owner: IT Security Manager
Participants: IT Security, DPO, SOC, Customer Service, LP
Source: workflow W3057 — Personal Data Breach Detection, Triage &amp; Incident Activation</bpmn:documentation>
      <bpmn:laneSet id="W3057_LaneSet3">
        <bpmn:lane id="W3057_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W3057_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3057_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3057_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3057_Lane2" name="DPO">
        <bpmn:flowNodeRef>W3057_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3057_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3057_Start4" name="Suspected breach signal (SIEM alert, report, anomaly)">
        <bpmn:outgoing>W3057_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3057_Task5" name="IT Security/SOC detect potential breach via monitoring (links to VS-27); log…">
        <bpmn:documentation>Step 1: IT Security/SOC detect potential breach via monitoring (links to VS-27); log incident; perform initial triage and severity scoring
Responsible (R): IT Security / SOC
Accountable (A): IT Security Manager
Duration: &lt;1 hr</bpmn:documentation>
        <bpmn:incoming>W3057_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3057_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3057_Task6" name="IT Security/DPO assess whether incident constitutes a reportable personal-data…">
        <bpmn:documentation>Step 2: IT Security/DPO assess whether incident constitutes a reportable personal-data breach (confidentiality/integrity/availability of personal data); activate incident response if yes
Responsible (R): IT Security / DPO
Accountable (A): DPO
Duration: &lt;24 hr</bpmn:documentation>
        <bpmn:incoming>W3057_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3057_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3057_Task7" name="DPO activates breach response team (IT Security, Legal, Comms, HR, Customer…">
        <bpmn:documentation>Step 3: DPO activates breach response team (IT Security, Legal, Comms, HR, Customer Service, executive); appoint incident commander; start 72-hour clock for NPC notification (W3059)
Responsible (R): DPO
Accountable (A): DPO
Duration: Per activation</bpmn:documentation>
        <bpmn:incoming>W3057_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3057_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3057_End8" name="Complete">
        <bpmn:incoming>W3057_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3057_Annotation9">
        <bpmn:text>Controls: - CTL-504 (ensure controlled execution — Breach Detection, Notification &amp; NPC Regulatory Response (PA-91.3).) | - operational: monitoring and triage SLA
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3057_Assoc10" sourceRef="W3057_Annotation9" targetRef="W3057_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3057_Flow11" sourceRef="W3057_Start4" targetRef="W3057_Task5" />
      <bpmn:sequenceFlow id="W3057_Flow12" sourceRef="W3057_Task5" targetRef="W3057_Task6" />
      <bpmn:sequenceFlow id="W3057_Flow13" sourceRef="W3057_Task6" targetRef="W3057_Task7" />
      <bpmn:sequenceFlow id="W3057_Flow14" sourceRef="W3057_Task7" targetRef="W3057_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3057_diag">
      <bpmndi:BPMNPlane id="W3057_plane" bpmnElement="W_W3057">
        <bpmndi:BPMNShape id="W3057_Lane1_di" bpmnElement="W3057_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
