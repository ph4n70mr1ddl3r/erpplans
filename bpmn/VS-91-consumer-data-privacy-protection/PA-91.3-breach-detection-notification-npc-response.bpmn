        <bpmndi:BPMNShape id="W3058_End9_di" bpmnElement="W3058_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3058_Annotation10_di" bpmnElement="W3058_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3058_Flow12_di" bpmnElement="W3058_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3058_Flow13_di" bpmnElement="W3058_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3058_Flow14_di" bpmnElement="W3058_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3058_Flow15_di" bpmnElement="W3058_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3058_Assoc11_di" bpmnElement="W3058_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3059" name="W3059. NPC Breach Notification (72-Hour) &amp; Regulatory Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Reportable breach confirmed
Frequency: Per reportable breach
Volume: Subset of incidents
Owner: Data Protection Officer (DPO)
Participants: DPO, Legal, IT Security, Compliance, Records
Source: workflow W3059 — NPC Breach Notification (72-Hour) &amp; Regulatory Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3059_LaneSet3">
        <bpmn:lane id="W3059_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3059_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3059_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3059_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3059_Lane2" name="Records">
        <bpmn:flowNodeRef>W3059_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3059_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3059_Start4" name="Reportable breach confirmed">
        <bpmn:outgoing>W3059_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3059_Task5" name="DPO/Legal prepare NPC breach notification (nature, data categories, approximate…">
        <bpmn:documentation>Step 1: DPO/Legal prepare NPC breach notification (nature, data categories, approximate subjects, likely harm, measures taken) within 72 hours of knowledge where required
Responsible (R): DPO / Legal
Accountable (A): DPO
Duration: &lt;72 hr</bpmn:documentation>
        <bpmn:incoming>W3059_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3059_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3059_Task6" name="DPO submits notification to NPC per prescribed format/channel; coordinates any…">
        <bpmn:documentation>Step 2: DPO submits notification to NPC per prescribed format/channel; coordinates any law-enforcement notification (cybercrime, PNP-ACG) where applicable
Responsible (R): DPO
Accountable (A): DPO
Duration: &lt;72 hr</bpmn:documentation>
        <bpmn:incoming>W3059_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3059_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3059_Task7" name="Records/Legal retain breach documentation per VS-88; support NPC follow-up…">
        <bpmn:documentation>Step 3: Records/Legal retain breach documentation per VS-88; support NPC follow-up inquiries and supplementary reports as scope refines
Responsible (R): Records / Legal
Accountable (A): DPO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3059_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3059_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3059_End8" name="Complete">
        <bpmn:incoming>W3059_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3059_Annotation9">
        <bpmn:text>Controls: - CTL-504 (ensure controlled execution — Breach Detection, Notification &amp; NPC Regulatory Response (PA-91.3).) | - operational: activation-to-notification playbook and templates
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3059_Assoc10" sourceRef="W3059_Annotation9" targetRef="W3059_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3059_Flow11" sourceRef="W3059_Start4" targetRef="W3059_Task5" />
      <bpmn:sequenceFlow id="W3059_Flow12" sourceRef="W3059_Task5" targetRef="W3059_Task6" />
      <bpmn:sequenceFlow id="W3059_Flow13" sourceRef="W3059_Task6" targetRef="W3059_Task7" />
      <bpmn:sequenceFlow id="W3059_Flow14" sourceRef="W3059_Task7" targetRef="W3059_End8" />
    </bpmn:process>
