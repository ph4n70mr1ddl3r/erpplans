      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3058" name="W3058. Breach Containment, Forensic Investigation &amp; Scope Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Breach confirmed
Frequency: Per incident
Volume: Per incident
Owner: IT Security Manager
Participants: IT Security, DPO, Legal, Forensics, affected Business Process Owners
Source: workflow W3058 — Breach Containment, Forensic Investigation &amp; Scope Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3058_LaneSet4">
        <bpmn:lane id="W3058_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W3058_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3058_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3058_Lane2" name="Forensics">
        <bpmn:flowNodeRef>W3058_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3058_Lane3" name="DPO">
        <bpmn:flowNodeRef>W3058_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3058_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3058_Start5" name="Breach confirmed">
        <bpmn:outgoing>W3058_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3058_Task6" name="IT Security contains breach (isolate systems, revoke access, reset credentials…">
        <bpmn:documentation>Step 1: IT Security contains breach (isolate systems, revoke access, reset credentials, patch); preserves forensic evidence and logs
Responsible (R): IT Security
Accountable (A): IT Security Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W3058_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3058_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3058_Task7" name="Forensics/IT Security investigate root cause, entry vector, and timeline…">
        <bpmn:documentation>Step 2: Forensics/IT Security investigate root cause, entry vector, and timeline; determine data categories, volume, and subjects affected
Responsible (R): Forensics / IT Security
Accountable (A): IT Security Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3058_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3058_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3058_Task8" name="DPO/Business Process Owners assess scope using ROPA (W3042): which data, how…">
        <bpmn:documentation>Step 3: DPO/Business Process Owners assess scope using ROPA (W3042): which data, how many subjects, sensitivity, and likely harm; feeds notification decisions
Responsible (R): DPO / Process Owners
Accountable (A): DPO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3058_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3058_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3058_End9" name="Complete">
        <bpmn:incoming>W3058_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3058_Annotation10">
        <bpmn:text>Controls: - CTL-504 (ensure controlled execution — Breach Detection, Notification &amp; NPC Regulatory Response (PA-91.3).) | - operational: ROPA-driven scoping and forensics
Owner: IT Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3058_Assoc11" sourceRef="W3058_Annotation10" targetRef="W3058_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3058_Flow12" sourceRef="W3058_Start5" targetRef="W3058_Task6" />
      <bpmn:sequenceFlow id="W3058_Flow13" sourceRef="W3058_Task6" targetRef="W3058_Task7" />
      <bpmn:sequenceFlow id="W3058_Flow14" sourceRef="W3058_Task7" targetRef="W3058_Task8" />
      <bpmn:sequenceFlow id="W3058_Flow15" sourceRef="W3058_Task8" targetRef="W3058_End9" />
    </bpmn:process>
