        <bpmndi:BPMNShape id="W3059_Start4_di" bpmnElement="W3059_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3059_End8_di" bpmnElement="W3059_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3059_Annotation9_di" bpmnElement="W3059_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3059_Flow11_di" bpmnElement="W3059_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3059_Flow12_di" bpmnElement="W3059_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3059_Flow13_di" bpmnElement="W3059_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3059_Flow14_di" bpmnElement="W3059_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3059_Assoc10_di" bpmnElement="W3059_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3060" name="W3060. Affected Data Subject Notification &amp; Remediation" isExecutable="false">
      <bpmn:documentation>Trigger: Breach likely to cause harm to subjects
Frequency: Per qualifying breach
Volume: Up to affected subjects (could be large for loyalty/ecommerce breach)
Owner: Data Protection Officer (DPO)
Participants: DPO, Comms, Customer Service, Legal, IT
Source: workflow W3060 — Affected Data Subject Notification &amp; Remediation</bpmn:documentation>
      <bpmn:laneSet id="W3060_LaneSet4">
        <bpmn:lane id="W3060_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3060_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3060_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3060_Lane2" name="Comms">
        <bpmn:flowNodeRef>W3060_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3060_Lane3" name="IT">
        <bpmn:flowNodeRef>W3060_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3060_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3060_Start5" name="Breach likely to cause harm to subjects">
        <bpmn:outgoing>W3060_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3060_Task6" name="DPO/Comms draft subject notification (what happened, data involved, harm…">
        <bpmn:documentation>Step 1: DPO/Comms draft subject notification (what happened, data involved, harm, remediation, contact); Legal reviews; calibrate to NPC guidance
Responsible (R): DPO / Comms / Legal
Accountable (A): DPO
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W3060_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3060_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3060_Task7" name="Comms/Customer Service deliver notification to affected subjects via…">
        <bpmn:documentation>Step 2: Comms/Customer Service deliver notification to affected subjects via appropriate channel; staff dedicated support hotline/chat; log inquiries
Responsible (R): Comms / Customer Service
Accountable (A): Marketing Communications Manager
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W3060_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3060_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3060_Task8" name="IT/DPO provide remediation (credit-monitoring equivalent, password reset…">
        <bpmn:documentation>Step 3: IT/DPO provide remediation (credit-monitoring equivalent, password reset, fraud-alert guidance, free identity-protection where offered); track remediation uptake
Responsible (R): IT / DPO
Accountable (A): DPO
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W3060_Flow14</bpmn:incoming>
