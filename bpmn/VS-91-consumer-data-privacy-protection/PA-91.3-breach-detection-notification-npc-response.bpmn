    <bpmn:process id="W_W3061" name="W3061. Cyber Insurance Coordination &amp; Breach Cost Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Breach with covered costs
Frequency: Per qualifying breach
Volume: Subset of breaches
Owner: Risk &amp; Insurance Manager
Participants: Risk/Insurance, Finance, Legal, DPO, Broker
Source: workflow W3061 — Cyber Insurance Coordination &amp; Breach Cost Recovery</bpmn:documentation>
