Responsible (R): Finance / Risk
Accountable (A): Risk &amp; Insurance Manager
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W3061_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3061_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3061_Task7" name="Risk/Finance negotiate settlement; post recovery; reconcile to incident case…">
