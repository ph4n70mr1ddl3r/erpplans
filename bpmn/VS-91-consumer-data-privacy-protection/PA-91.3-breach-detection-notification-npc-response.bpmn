    <bpmn:process id="W_W3064" name="W3064. Data Privacy Audit, NPC Investigation Response &amp; Remediation" isExecutable="false">
      <bpmn:documentation>Trigger: NPC investigation, complaint, or scheduled audit
Frequency: Event-driven + scheduled
Volume: Per investigation/complaint
Owner: Data Protection Officer (DPO)
Participants: DPO, Legal, Internal Audit, Compliance, Records, IT Security
Source: workflow W3064 — Data Privacy Audit, NPC Investigation Response &amp; Remediation</bpmn:documentation>
      <bpmn:laneSet id="W3064_LaneSet3">
        <bpmn:lane id="W3064_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3064_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3064_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3064_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3064_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W3064_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3064_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3064_Start4" name="NPC investigation, complaint, or scheduled audit">
        <bpmn:outgoing>W3064_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3064_Task5" name="DPO/Legal coordinate NPC investigation or complaint response; assemble evidence…">
        <bpmn:documentation>Step 1: DPO/Legal coordinate NPC investigation or complaint response; assemble evidence (ROPA, consent records, DPIAs, incident files) per VS-88
Responsible (R): DPO / Legal / Records
Accountable (A): DPO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3064_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3064_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3064_Task6" name="Internal Audit/Compliance support with control evidence, interviews, and…">
        <bpmn:documentation>Step 2: Internal Audit/Compliance support with control evidence, interviews, and walkthroughs; Legal manages privileged content and regulator communication
Responsible (R): Internal Audit / Compliance / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3064_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3064_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3064_Task7" name="DPO executes remediation per NPC directive or finding; reports closure; updates…">
        <bpmn:documentation>Step 3: DPO executes remediation per NPC directive or finding; reports closure; updates risk register and controls (links to VS-21/VS-22)
Responsible (R): DPO
Accountable (A): DPO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3064_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3064_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3064_End8" name="Complete">
        <bpmn:incoming>W3064_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3064_Annotation9">
        <bpmn:text>Controls: - CTL-504 (ensure controlled execution — Breach Detection, Notification &amp; NPC Regulatory Response (PA-91.3).) | - operational: complete ROPA/DPIA/consent records and audit readiness
Owner: Data Protection Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
