      </bpmn:startEvent>
      <bpmn:userTask id="W3061_Task5" name="Risk/Insurance review cyber-liability / breach-response policy for coverage…">
        <bpmn:documentation>Step 1: Risk/Insurance review cyber-liability / breach-response policy for coverage, deductibles, panel-vendor requirements; notify insurer/broker within policy window
Responsible (R): Risk / Insurance
Accountable (A): Risk &amp; Insurance Manager
Duration: Per breach (&lt;window)</bpmn:documentation>
        <bpmn:incoming>W3061_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3061_Flow12</bpmn:outgoing>
      </bpmn:userTask>
