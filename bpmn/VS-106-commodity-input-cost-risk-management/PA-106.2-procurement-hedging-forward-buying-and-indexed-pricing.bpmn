        <bpmn:flowNodeRef>W3413_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3413_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3413_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3413_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3413_Start3" name="Hedge execution (W3412); month-end close (links to VS-17.1/W9A)">
        <bpmn:outgoing>W3413_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3413_Task4" name="Finance/Treasury prepare PFRS 9 hedge documentation at inception: hedge…">
        <bpmn:documentation>Step 1: Finance/Treasury prepare PFRS 9 hedge documentation at inception: hedge relationship, risk-management objective, designated hedged item (purchase plan links to VS-101 W3284), hedge instrument (W3412), effectiveness test method, and accounting designation (cash-flow/fair-value hedge); obtain audit pre-clearance (links to VS-21)
Responsible (R): Finance / Treasury
Accountable (A): Finance Controller
Duration: At inception</bpmn:documentation>
        <bpmn:incoming>W3413_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3413_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3413_Task5" name="Finance perform periodic (monthly) effectiveness testing and MTM: compute hedge…">
        <bpmn:documentation>Step 2: Finance perform periodic (monthly) effectiveness testing and MTM: compute hedge effectiveness, post hedge MTM and effective/ineffective portions to GL (links to VS-17.1/W9A), reclassify to COGS/margin when the hedged purchase occurs, and document for audit; handle de-designation/discontinuance per PFRS 9
Responsible (R): Finance / Treasury
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3413_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3413_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3413_Task6" name="Finance/Treasury report hedge MTM, effectiveness, P&amp;L impact, and OCI movement…">
        <bpmn:documentation>Step 3: Finance/Treasury report hedge MTM, effectiveness, P&amp;L impact, and OCI movement to FP&amp;A (links to VS-17.4), executives (links to VS-33.2), and audit (links to VS-21); ensure disclosure consistency (links to VS-17) and reconcile to physical purchase/price outcome (W3416)
Responsible (R): Finance / Treasury
Accountable (A): CFO
Duration: Monthly/Quarterly</bpmn:documentation>
        <bpmn:incoming>W3413_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3413_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3413_End7" name="Complete">
        <bpmn:incoming>W3413_Flow13</bpmn:incoming>
      </bpmn:endEvent>
