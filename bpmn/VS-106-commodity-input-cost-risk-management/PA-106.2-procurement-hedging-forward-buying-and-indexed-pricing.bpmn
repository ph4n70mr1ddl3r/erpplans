    <bpmn:process id="W_W3410" name="W3410. Forward Buying, Strategic Inventory &amp; Physical Hedge Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Market outlook (W3407) signaling price rise; supply-disruption risk (links to VS-69/VS-02.3)
Frequency: Opportunity-driven + seasonal
Volume: Top commodity-intensive A-items; ~5–15% incremental inventory in selected SKUs
Owner: VP Merchandising
Participants: VP Merchandising, Buyers (links to VS-03.2), Supply Planning (links to VS-02.1), Treasury Manager, Finance (links to VS-101)
Source: workflow W3410 — Forward Buying, Strategic Inventory &amp; Physical Hedge Execution</bpmn:documentation>
      <bpmn:laneSet id="W3410_LaneSet4">
        <bpmn:lane id="W3410_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3410_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3410_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3410_Lane2" name="Buyers">
        <bpmn:flowNodeRef>W3410_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3410_Lane3" name="Merchandising">
        <bpmn:flowNodeRef>W3410_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3410_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3410_Start5" name="Market outlook (W3407) signaling price rise; supply-disruption risk (links to…">
        <bpmn:outgoing>W3410_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3410_Task6" name="Procurement/Merchandising identify forward-buy opportunities from the market…">
        <bpmn:documentation>Step 1: Procurement/Merchandising identify forward-buy opportunities from the market outlook (W3407): commodities/SKUs with high price-rise probability, supply-allocation risk, or strategic importance; quantify the buy (volume, $, storage capacity links to VS-04, OTB impact links to VS-101 W3283) and the carrying-cost vs expected price-gain trade-off
Responsible (R): Procurement / Merchandising / Treasury
Accountable (A): VP Merchandising
Duration: Opportunity-driven</bpmn:documentation>
        <bpmn:incoming>W3410_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3410_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3410_Task7" name="Buyers/Merchandising execute the forward buy via PO/blanket (links to VS-03.2…">
        <bpmn:documentation>Step 2: Buyers/Merchandising execute the forward buy via PO/blanket (links to VS-03.2 W2C) or pre-buy agreement; coordinate storage at DC (links to VS-04) and financing/cash (links to VS-18/VS-105 WC impact); respect OTB and markdown-budget controls (links to VS-101 W3283/W3285) and inventory-turn guardrails (per profile §12.3)
Responsible (R): Buyers / Supply Planning
Accountable (A): VP Merchandising
Duration: Per buy</bpmn:documentation>
        <bpmn:incoming>W3410_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3410_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3410_Task8" name="Merchandising/Treasury track the forward-buy outcome vs market (W3403), realize…">
        <bpmn:documentation>Step 3: Merchandising/Treasury track the forward-buy outcome vs market (W3403), realize the margin protection (W3417), manage aged strategic inventory (links to VS-05.3), and report physical-hedge performance to the review (W3416); clear residual stock via normal channels (links to VS-64/VS-05.3) if the thesis invalidates
Responsible (R): Merchandising / Treasury
Accountable (A): VP Merchandising
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3410_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3410_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3410_End9" name="Complete">
        <bpmn:incoming>W3410_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3410_Annotation10">
        <bpmn:text>Controls: - CTL-548 (ensure controlled execution — Procurement Hedging, Forward Buying &amp; Indexed-Pricing Strategy (PA-106.2).) | - operational: OTB control and carrying-cost analysis; operational: capacity check (links to VS-04) and 3PL option
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3410_Assoc11" sourceRef="W3410_Annotation10" targetRef="W3410_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3410_Flow12" sourceRef="W3410_Start5" targetRef="W3410_Task6" />
      <bpmn:sequenceFlow id="W3410_Flow13" sourceRef="W3410_Task6" targetRef="W3410_Task7" />
      <bpmn:sequenceFlow id="W3410_Flow14" sourceRef="W3410_Task7" targetRef="W3410_Task8" />
      <bpmn:sequenceFlow id="W3410_Flow15" sourceRef="W3410_Task8" targetRef="W3410_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3410_diag">
      <bpmndi:BPMNPlane id="W3410_plane" bpmnElement="W_W3410">
        <bpmndi:BPMNShape id="W3410_Lane1_di" bpmnElement="W3410_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3410_Lane2_di" bpmnElement="W3410_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3410_Lane3_di" bpmnElement="W3410_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3410_Task6_di" bpmnElement="W3410_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
