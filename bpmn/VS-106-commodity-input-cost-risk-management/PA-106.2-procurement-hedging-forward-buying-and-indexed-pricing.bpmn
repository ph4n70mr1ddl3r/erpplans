        <bpmndi:BPMNEdge id="W3410_Flow12_di" bpmnElement="W3410_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3410_Flow13_di" bpmnElement="W3410_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3410_Flow14_di" bpmnElement="W3410_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3410_Flow15_di" bpmnElement="W3410_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3410_Assoc11_di" bpmnElement="W3410_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3411" name="W3411. Indexed / Formula / Floating Vendor Contract Structuring" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic-vendor contract (links to VS-03.3); commodity exposure (W3401)
Frequency: Per contract + periodic
Volume: Top ~50–100 commodity-exposed vendors
Owner: Procurement Director
Participants: Procurement Director, Category Managers, Vendor (links to VS-03.3), Legal (links to VS-100.3), Finance
Source: workflow W3411 — Indexed / Formula / Floating Vendor Contract Structuring</bpmn:documentation>
      <bpmn:laneSet id="W3411_LaneSet3">
        <bpmn:lane id="W3411_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W3411_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3411_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3411_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3411_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W3411_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3411_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3411_Start4" name="Strategic-vendor contract (links to VS-03.3); commodity exposure (W3401)">
        <bpmn:outgoing>W3411_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3411_Task5" name="Category Managers/Procurement design the indexed/floating contract structure…">
        <bpmn:documentation>Step 1: Category Managers/Procurement design the indexed/floating contract structure per vendor/commodity: select the index (W3403), pricing formula (base + index multiplier), adjustment frequency (monthly/quarterly), cap/floor/collar, raw-material component weight (W3402), and notice/audit rights; benchmark to market practice (links to VS-03.3)
Responsible (R): Category Managers / Procurement / Finance
Accountable (A): Procurement Director
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3411_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3411_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3411_Task6" name="Procurement/Legal negotiate and execute the indexed contract clause (links to…">
        <bpmn:documentation>Step 2: Procurement/Legal negotiate and execute the indexed contract clause (links to VS-100.3/W230), ensure it is enforceable, audit-able, and consistent with the exposure map (W3401) and pass-through strategy (W3414); document the formula and index in the contract master (links to W402)
Responsible (R): Procurement / Legal
Accountable (A): Procurement Director
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3411_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3411_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3411_Task7" name="Category Managers/Finance load the indexed formula into the price/cost master…">
        <bpmn:documentation>Step 3: Category Managers/Finance load the indexed formula into the price/cost master (links to W289 pricing master, W296 service/non-stock master), validate initial price, and set up the periodic re-price process (W3414); monitor formula integrity over the contract life
Responsible (R): Category Managers / Finance
Accountable (A): Procurement Director
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3411_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3411_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3411_End8" name="Complete">
        <bpmn:incoming>W3411_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3411_Annotation9">
        <bpmn:text>Controls: - CTL-548 (ensure controlled execution — Procurement Hedging, Forward Buying &amp; Indexed-Pricing Strategy (PA-106.2).) | - operational: simplicity and clear indices; operational: symmetric design and benchmarking (W3403)
Owner: Procurement Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3411_Assoc10" sourceRef="W3411_Annotation9" targetRef="W3411_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3411_Flow11" sourceRef="W3411_Start4" targetRef="W3411_Task5" />
      <bpmn:sequenceFlow id="W3411_Flow12" sourceRef="W3411_Task5" targetRef="W3411_Task6" />
      <bpmn:sequenceFlow id="W3411_Flow13" sourceRef="W3411_Task6" targetRef="W3411_Task7" />
      <bpmn:sequenceFlow id="W3411_Flow14" sourceRef="W3411_Task7" targetRef="W3411_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3411_diag">
      <bpmndi:BPMNPlane id="W3411_plane" bpmnElement="W_W3411">
        <bpmndi:BPMNShape id="W3411_Lane1_di" bpmnElement="W3411_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Lane2_di" bpmnElement="W3411_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Task5_di" bpmnElement="W3411_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Task6_di" bpmnElement="W3411_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Task7_di" bpmnElement="W3411_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Start4_di" bpmnElement="W3411_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_End8_di" bpmnElement="W3411_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3411_Annotation9_di" bpmnElement="W3411_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3411_Flow11_di" bpmnElement="W3411_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3411_Flow12_di" bpmnElement="W3411_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3411_Flow13_di" bpmnElement="W3411_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3411_Flow14_di" bpmnElement="W3411_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3411_Assoc10_di" bpmnElement="W3411_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3412" name="W3412. Financial Commodity Hedge Execution, Broker &amp; Counterparty Management" isExecutable="false">
      <bpmn:documentation>Trigger: Approved hedge program (W3409); market trigger
Frequency: Per hedge + periodic rolling
Volume: ~5–10 hedged commodities; rolling tenors
Owner: Treasury Manager
Participants: Treasury Manager, CFO, Broker/Bank, Risk (links to VS-21.2), Finance (links to VS-17)
Source: workflow W3412 — Financial Commodity Hedge Execution, Broker &amp; Counterparty Management</bpmn:documentation>
      <bpmn:laneSet id="W3412_LaneSet2">
        <bpmn:lane id="W3412_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3412_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3412_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3412_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3412_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3412_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3412_Start3" name="Approved hedge program (W3409); market trigger">
        <bpmn:outgoing>W3412_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3412_Task4" name="Treasury execute the financial hedge (futures/forward/swap) per the program…">
        <bpmn:documentation>Step 1: Treasury execute the financial hedge (futures/forward/swap) per the program (W3409): select instrument/tenor matching the purchase plan (links to VS-101 W3284), obtain quotes from brokers/banks, transact within authority (links to W3406), and capture trade details (counterparty, notional, strike/fix, maturity, premium)
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: Per hedge</bpmn:documentation>
        <bpmn:incoming>W3412_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3412_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3412_Task5" name="Treasury manage counterparty risk: select approved broker/bank counterparties…">
        <bpmn:documentation>Step 2: Treasury manage counterparty risk: select approved broker/bank counterparties, set exposure limits, monitor credit, and diversify; coordinate with FX hedge counterparties (links to VS-18.3/W317) to avoid concentration; document ISDA/master agreements (links to VS-100.3)
Responsible (R): Treasury Manager / Risk
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3412_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3412_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3412_Task6" name="Treasury roll/settle hedges at maturity, post cash collateral/margin as…">
        <bpmn:documentation>Step 3: Treasury roll/settle hedges at maturity, post cash collateral/margin as required, reconcile settlements to GL (links to VS-17.1/W9A), and capture MTM for hedge accounting (W3413); feed hedge performance to the review (W3416)
Responsible (R): Treasury Manager / Finance
Accountable (A): Treasury Manager
Duration: Per maturity</bpmn:documentation>
        <bpmn:incoming>W3412_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3412_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3412_End7" name="Complete">
        <bpmn:incoming>W3412_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3412_Annotation8">
        <bpmn:text>Controls: - CTL-548 (ensure controlled execution — Procurement Hedging, Forward Buying &amp; Indexed-Pricing Strategy (PA-106.2).) | - operational: approved-list, limits, and diversification; operational: liquidity planning and authority limits
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3412_Assoc9" sourceRef="W3412_Annotation8" targetRef="W3412_Start3" associationDirection="None" />
