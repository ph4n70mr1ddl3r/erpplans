<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-106.2-procurement-hedging-forward-buying-and-indexed-pricing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3409" name="W3409. Commodity Mitigation Strategy Selection &amp; Hedge Program Design" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program design (links to W3406); exposure review (W3404)
Frequency: Annual + periodic
Volume: ~5–10 hedged/mitigated commodities
Owner: CFO
Participants: CFO, Treasury Manager, Procurement Director, Category Managers (links to VS-01), Risk (links to VS-21.2)
Source: workflow W3409 — Commodity Mitigation Strategy Selection &amp; Hedge Program Design</bpmn:documentation>
      <bpmn:laneSet id="W3409_LaneSet3">
        <bpmn:lane id="W3409_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3409_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3409_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3409_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3409_Lane2" name="CFO">
        <bpmn:flowNodeRef>W3409_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3409_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3409_Start4" name="Annual program design (links to W3406); exposure review (W3404)">
        <bpmn:outgoing>W3409_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3409_Task5" name="Treasury/Procurement evaluate mitigation options per commodity: financial hedge…">
        <bpmn:documentation>Step 1: Treasury/Procurement evaluate mitigation options per commodity: financial hedge (futures/forwards/swaps), physical hedge / strategic inventory (W3410), indexed/floating contract (W3411), vendor pass-through clause (W3414), long-term supply agreement (W3415), or accept (self-insure); select based on exposure size (W3404), market liquidity, cost, accounting (W3413), and risk appetite (W3406)
Responsible (R): Treasury Manager / Procurement
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3409_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3409_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3409_Task6" name="Treasury design the hedge/mitigation program per selected commodity: hedge…">
        <bpmn:documentation>Step 2: Treasury design the hedge/mitigation program per selected commodity: hedge ratio (% of exposure covered), instrument, tenor matching the purchase plan (links to VS-101 W3284 receipts), trigger/threshold for activation, and the board authority limit (links to W3406); coordinate FX hedges (links to VS-18.3/W321) to avoid interaction gaps (W3408)
Responsible (R): Treasury Manager / Risk
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3409_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3409_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3409_Task7" name="CFO/Board approve the mitigation program, authority matrix, and accounting…">
        <bpmn:documentation>Step 3: CFO/Board approve the mitigation program, authority matrix, and accounting designation (links to W3413); document the hedge strategy and rationale for audit (links to VS-21) and PFRS 9 hedge documentation (W3413)
Responsible (R): CFO
Accountable (A): Board / Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3409_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3409_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3409_End8" name="Complete">
        <bpmn:incoming>W3409_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3409_Annotation9">
        <bpmn:text>Controls: - CTL-548 (ensure controlled execution — Procurement Hedging, Forward Buying &amp; Indexed-Pricing Strategy (PA-106.2).) | - operational: tenor matching and basis analysis; operational: hedge-ratio policy and board limit
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3409_Assoc10" sourceRef="W3409_Annotation9" targetRef="W3409_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3409_Flow11" sourceRef="W3409_Start4" targetRef="W3409_Task5" />
      <bpmn:sequenceFlow id="W3409_Flow12" sourceRef="W3409_Task5" targetRef="W3409_Task6" />
      <bpmn:sequenceFlow id="W3409_Flow13" sourceRef="W3409_Task6" targetRef="W3409_Task7" />
      <bpmn:sequenceFlow id="W3409_Flow14" sourceRef="W3409_Task7" targetRef="W3409_End8" />
    </bpmn:process>
