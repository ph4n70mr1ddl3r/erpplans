<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-106.1-commodity-exposure-identification-and-market-intelligence" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3401" name="W3401. Commodity Exposure Mapping by SKU / Category / Vendor" isExecutable="false">
      <bpmn:documentation>Trigger: Annual commodity-risk review; category strategy refresh
Frequency: Annual + quarterly refresh
Volume: 35,000 active SKUs across 13 departments; ~800–1,000 vendors
Owner: Procurement Director
Participants: Procurement Director, Category Managers (links to VS-01), Supply Planning (links to VS-02), Finance (links to VS-17.4), Treasury (links to VS-18)
Source: workflow W3401 — Commodity Exposure Mapping by SKU / Category / Vendor</bpmn:documentation>
      <bpmn:laneSet id="W3401_LaneSet3">
        <bpmn:lane id="W3401_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W3401_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3401_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3401_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W3401_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3401_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3401_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3401_Start4" name="Annual commodity-risk review; category strategy refresh">
        <bpmn:outgoing>W3401_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3401_Task5" name="Procurement/Category Managers map each category&#x27;s commodity exposure: identify…">
        <bpmn:documentation>Step 1: Procurement/Category Managers map each category&#x27;s commodity exposure: identify the dominant input commodities (steel/rebar/cement/lumber for building materials; copper for electrical/plumbing; titanium dioxide/resins/solvents for paint; oil-derived plastics for tools/appliances), the exposure weight (% of COGS tied to each commodity), and the import-vs-local sourcing split (links to VS-02.2/VS-87)
Responsible (R): Category Managers / Procurement
Accountable (A): Procurement Director
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3401_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3401_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3401_Task6" name="Procurement tag SKUs and vendors with commodity exposure attributes in the…">
        <bpmn:documentation>Step 2: Procurement tag SKUs and vendors with commodity exposure attributes in the item/vendor master (links to VS-29/W287), compute commodity-weighted spend by vendor/category/quarter using actuals, and rank the top commodity exposures by PHP impact (e.g., steel, copper, cement, lumber, resins, plastics)
Responsible (R): Procurement / Finance
Accountable (A): Procurement Director
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3401_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3401_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3401_Task7" name="Procurement/Treasury validate the exposure map against the merchandise plan…">
        <bpmn:documentation>Step 3: Procurement/Treasury validate the exposure map against the merchandise plan (links to VS-101) and import pipeline (links to VS-02.2), publish the commodity-exposure heatmap, and feed it to sensitivity analysis (W3404) and mitigation planning (PA-106.2)
Responsible (R): Procurement / Treasury
Accountable (A): Procurement Director
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3401_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3401_End8" name="Complete">
        <bpmn:incoming>W3401_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3401_Annotation9">
        <bpmn:text>Controls: - CTL-547 (ensure controlled execution — Commodity Exposure Identification &amp; Market Intelligence (PA-106.1).) | - operational: quarterly refresh and vendor transparency (W3405); operational: landed-cost analysis (W3408)
Owner: Procurement Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3401_Assoc10" sourceRef="W3401_Annotation9" targetRef="W3401_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3401_Flow11" sourceRef="W3401_Start4" targetRef="W3401_Task5" />
      <bpmn:sequenceFlow id="W3401_Flow12" sourceRef="W3401_Task5" targetRef="W3401_Task6" />
      <bpmn:sequenceFlow id="W3401_Flow13" sourceRef="W3401_Task6" targetRef="W3401_Task7" />
      <bpmn:sequenceFlow id="W3401_Flow14" sourceRef="W3401_Task7" targetRef="W3401_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3401_diag">
      <bpmndi:BPMNPlane id="W3401_plane" bpmnElement="W_W3401">
        <bpmndi:BPMNShape id="W3401_Lane1_di" bpmnElement="W3401_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Lane2_di" bpmnElement="W3401_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Task5_di" bpmnElement="W3401_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Task6_di" bpmnElement="W3401_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Task7_di" bpmnElement="W3401_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Start4_di" bpmnElement="W3401_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_End8_di" bpmnElement="W3401_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3401_Annotation9_di" bpmnElement="W3401_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3401_Flow11_di" bpmnElement="W3401_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3401_Flow12_di" bpmnElement="W3401_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3401_Flow13_di" bpmnElement="W3401_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3401_Flow14_di" bpmnElement="W3401_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3401_Assoc10_di" bpmnElement="W3401_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3402" name="W3402. Bill-of-Material (BOM) &amp; Input-Cost Decomposition Modeling" isExecutable="false">
      <bpmn:documentation>Trigger: Exposure mapping (W3401); vendor cost-transparency initiative; private-label (links to VS-41)
Frequency: Periodic + on key-vendor review
Volume: Top ~200–500 commodity-intensive SKUs (A-items per profile §6.6 ABC)
Owner: Category Manager
Participants: Category Manager, Procurement, Vendor (links to VS-03.3/VS-41), Finance (links to VS-17.4/VS-85)
Source: workflow W3402 — Bill-of-Material (BOM) &amp; Input-Cost Decomposition Modeling</bpmn:documentation>
      <bpmn:laneSet id="W3402_LaneSet3">
        <bpmn:lane id="W3402_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W3402_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3402_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3402_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3402_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3402_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3402_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3402_Start4" name="Exposure mapping (W3401); vendor cost-transparency initiative; private-label (links to…">
        <bpmn:outgoing>W3402_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3402_Task5" name="Category Managers/Procurement build a BOM/input-cost decomposition for…">
        <bpmn:documentation>Step 1: Category Managers/Procurement build a BOM/input-cost decomposition for commodity-intensive SKUs (esp. private-label per VS-41): break the unit cost into raw-material commodity components (e.g., a power drill = motor copper + steel + plastic housing + battery + labor/overhead), with commodity weight and unit-of-measure per component
Responsible (R): Category Managers / Procurement
Accountable (A): Procurement Director
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W3402_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3402_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3402_Task6" name="Category Managers/Vendor obtain vendor cost-transparency (open-book costing for…">
        <bpmn:documentation>Step 2: Category Managers/Vendor obtain vendor cost-transparency (open-book costing for strategic/private-label vendors per VS-03.3/VS-41), validate the BOM against vendor quotes and landed cost (links to VS-02.2/VS-87), and identify cost-driver concentration and negotiable vs fixed components
Responsible (R): Category Managers / Vendor
Accountable (A): Procurement Director
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W3402_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3402_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3402_Task7" name="Finance/Category Managers load the decomposition into cost/margin analytics…">
        <bpmn:documentation>Step 3: Finance/Category Managers load the decomposition into cost/margin analytics (links to VS-85/W85, VS-101.3), compute commodity-cost elasticity (how unit cost moves with commodity index), and feed to sensitivity (W3404) and indexed-pricing design (W3412)
Responsible (R): Finance / Category Managers
Accountable (A): Procurement Director
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3402_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3402_End8" name="Complete">
        <bpmn:incoming>W3402_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3402_Annotation9">
        <bpmn:text>Controls: - CTL-547 (ensure controlled execution — Commodity Exposure Identification &amp; Market Intelligence (PA-106.1).) | - operational: strategic/private-label leverage and open-book clauses (links to VS-41/VS-03); operational: vendor validation and periodic re-baselining
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3402_Assoc10" sourceRef="W3402_Annotation9" targetRef="W3402_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3402_Flow11" sourceRef="W3402_Start4" targetRef="W3402_Task5" />
      <bpmn:sequenceFlow id="W3402_Flow12" sourceRef="W3402_Task5" targetRef="W3402_Task6" />
      <bpmn:sequenceFlow id="W3402_Flow13" sourceRef="W3402_Task6" targetRef="W3402_Task7" />
      <bpmn:sequenceFlow id="W3402_Flow14" sourceRef="W3402_Task7" targetRef="W3402_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3402_diag">
      <bpmndi:BPMNPlane id="W3402_plane" bpmnElement="W_W3402">
        <bpmndi:BPMNShape id="W3402_Lane1_di" bpmnElement="W3402_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Lane2_di" bpmnElement="W3402_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Task5_di" bpmnElement="W3402_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Task6_di" bpmnElement="W3402_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Task7_di" bpmnElement="W3402_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Start4_di" bpmnElement="W3402_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_End8_di" bpmnElement="W3402_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3402_Annotation9_di" bpmnElement="W3402_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3402_Flow11_di" bpmnElement="W3402_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3402_Flow12_di" bpmnElement="W3402_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3402_Flow13_di" bpmnElement="W3402_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3402_Flow14_di" bpmnElement="W3402_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3402_Assoc10_di" bpmnElement="W3402_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3403" name="W3403. Commodity Market-Price Intelligence &amp; Benchmark Data Management" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous monitoring; weekly/monthly briefing (W3407)
Frequency: Daily data + weekly/monthly analysis
Volume: ~10–15 tracked commodities/indices
Owner: Procurement Director
Participants: Procurement, Treasury (links to VS-18), Category Managers (links to VS-01), BI (links to VS-28.1)
Source: workflow W3403 — Commodity Market-Price Intelligence &amp; Benchmark Data Management</bpmn:documentation>
      <bpmn:laneSet id="W3403_LaneSet3">
        <bpmn:lane id="W3403_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3403_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3403_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3403_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3403_Lane2" name="BI">
        <bpmn:flowNodeRef>W3403_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3403_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3403_Start4" name="Continuous monitoring; weekly/monthly briefing (W3407)">
        <bpmn:outgoing>W3403_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3403_Task5" name="Procurement/Treasury define the commodity benchmark set: LME…">
        <bpmn:documentation>Step 1: Procurement/Treasury define the commodity benchmark set: LME steel/copper/nickel/aluminum, regional cement/clinker index, lumber/timber index, oil/brent (for plastics/solvents/transport), titanium dioxide/resin indices, and the PHP/USD and PHP/CNY rates (links to VS-18.3/W307); source data feeds (subscriptions, vendor indices, exchange data)
Responsible (R): Procurement / Treasury
Accountable (A): Procurement Director
Duration: Setup + ongoing</bpmn:documentation>
        <bpmn:incoming>W3403_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3403_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3403_Task6" name="BI/Procurement integrate commodity-benchmark data into the analytics platform…">
        <bpmn:documentation>Step 2: BI/Procurement integrate commodity-benchmark data into the analytics platform (links to VS-28.1), maintain history and seasonality, normalize units/currency, and compute price-change metrics (MoM, YoY, vs moving average); quality-check feeds
Responsible (R): BI / Procurement
Accountable (A): Procurement Director
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3403_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3403_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3403_Task7" name="Procurement/Category Managers benchmark vendor-quoted prices and landed costs…">
        <bpmn:documentation>Step 3: Procurement/Category Managers benchmark vendor-quoted prices and landed costs (links to VS-02.2/VS-87/W239) against market indices to detect over-pricing or lagging pass-through; feed deviations to vendor negotiation (links to VS-03.3) and pass-through governance (W3417)
Responsible (R): Procurement / Category Managers
Accountable (A): Procurement Director
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3403_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3403_End8" name="Complete">
        <bpmn:incoming>W3403_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3403_Annotation9">
        <bpmn:text>Controls: - CTL-547 (ensure controlled execution — Commodity Exposure Identification &amp; Market Intelligence (PA-106.1).) | - operational: careful index selection and normalization; operational: multi-source cross-check and quality monitoring
Owner: Procurement Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3403_Assoc10" sourceRef="W3403_Annotation9" targetRef="W3403_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3403_Flow11" sourceRef="W3403_Start4" targetRef="W3403_Task5" />
      <bpmn:sequenceFlow id="W3403_Flow12" sourceRef="W3403_Task5" targetRef="W3403_Task6" />
      <bpmn:sequenceFlow id="W3403_Flow13" sourceRef="W3403_Task6" targetRef="W3403_Task7" />
      <bpmn:sequenceFlow id="W3403_Flow14" sourceRef="W3403_Task7" targetRef="W3403_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3403_diag">
      <bpmndi:BPMNPlane id="W3403_plane" bpmnElement="W_W3403">
        <bpmndi:BPMNShape id="W3403_Lane1_di" bpmnElement="W3403_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Lane2_di" bpmnElement="W3403_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Task5_di" bpmnElement="W3403_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Task6_di" bpmnElement="W3403_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Task7_di" bpmnElement="W3403_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Start4_di" bpmnElement="W3403_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_End8_di" bpmnElement="W3403_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3403_Annotation9_di" bpmnElement="W3403_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3403_Flow11_di" bpmnElement="W3403_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3403_Flow12_di" bpmnElement="W3403_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3403_Flow13_di" bpmnElement="W3403_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3403_Flow14_di" bpmnElement="W3403_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3403_Assoc10_di" bpmnElement="W3403_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3404" name="W3404. Commodity Sensitivity, Value-at-Risk (VaR) &amp; Exposure Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly risk review; exposure map update (W3401)
Frequency: Monthly + scenario-driven
Volume: Top commodities × categories × forecast horizon
Owner: Treasury Manager
Participants: Treasury Manager, Procurement, FP&amp;A (links to VS-17.4), Risk (links to VS-21.2)
Source: workflow W3404 — Commodity Sensitivity, Value-at-Risk (VaR) &amp; Exposure Measurement</bpmn:documentation>
      <bpmn:laneSet id="W3404_LaneSet2">
        <bpmn:lane id="W3404_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3404_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3404_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3404_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3404_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3404_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3404_Start3" name="Monthly risk review; exposure map update (W3401)">
        <bpmn:outgoing>W3404_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3404_Task4" name="Treasury/Procurement compute commodity sensitivity: for each top commodity, the…">
        <bpmn:documentation>Step 1: Treasury/Procurement compute commodity sensitivity: for each top commodity, the PHP impact of a ±5/10/20% price move on the forward purchase plan (links to VS-02.1/VS-101 receipt plan), using the BOM decomposition (W3402) and exposure map (W3401); produce a sensitivity matrix
Responsible (R): Treasury Manager / Procurement
Accountable (A): Treasury Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3404_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3404_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3404_Task5" name="Treasury/Risk measure commodity Value-at-Risk (VaR) and stress scenarios…">
        <bpmn:documentation>Step 2: Treasury/Risk measure commodity Value-at-Risk (VaR) and stress scenarios: probability-weighted exposure over the planning horizon, stress tests (e.g., +30% steel, oil shock, supply disruption links to VS-69/VS-02.3), and the combined commodity+FX impact (W3408); reconcile to the ERM risk register (links to VS-21.2)
Responsible (R): Treasury Manager / Risk
Accountable (A): Treasury Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3404_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3404_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3404_Task6" name="Treasury/Procurement publish the commodity-exposure and VaR report, set the…">
        <bpmn:documentation>Step 3: Treasury/Procurement publish the commodity-exposure and VaR report, set the hedge/mitigation priority (links to PA-106.2), and report to the commodity-risk governance (W3406) and FP&amp;A margin plan (links to VS-101.3/VS-17.4)
Responsible (R): Treasury Manager / Procurement
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3404_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3404_End7" name="Complete">
        <bpmn:incoming>W3404_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3404_Annotation8">
        <bpmn:text>Controls: - CTL-70 (ensure commodity exposure &amp; hedge accounting accuracy.) | - operational: validation and back-testing; operational: granular decomposition
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
