    <bpmn:process id="W_W3420" name="W3420. Competitor Price-Sensitivity &amp; Pass-Through Feasibility Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Pass-through decision (W3417); quarterly competitive review (links to VS-57)
Frequency: Quarterly + on decision
Volume: Top commodity-exposed categories
Owner: Pricing Manager
Participants: Pricing Manager, Category Managers, Competitive Intelligence (links to VS-57/VS-33.3), Merchandising Finance
Source: workflow W3420 — Competitor Price-Sensitivity &amp; Pass-Through Feasibility Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3420_LaneSet3">
        <bpmn:lane id="W3420_Lane1" name="Pricing Manager">
        <bpmn:flowNodeRef>W3420_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3420_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3420_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
