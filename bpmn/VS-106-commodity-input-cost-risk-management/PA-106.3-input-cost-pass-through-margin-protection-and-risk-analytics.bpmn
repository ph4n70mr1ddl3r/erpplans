    <bpmn:process id="W_W3423" name="W3423. Input-Cost Risk Dashboard &amp; Executive/Board Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly cycle; market event
Frequency: Monthly + quarterly + event-driven
Volume: Group + category/commodity
Owner: Treasury Manager
Participants: Treasury Manager, Procurement, Merchandising Finance, FP&amp;A (links to VS-17.4), BI (links to VS-28.1), CFO
Source: workflow W3423 — Input-Cost Risk Dashboard &amp; Executive/Board Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3423_LaneSet3">
        <bpmn:lane id="W3423_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W3423_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3423_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
