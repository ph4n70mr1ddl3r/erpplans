      <bpmn:sequenceFlow id="W3417_Flow13" sourceRef="W3417_Task6" targetRef="W3417_Task7" />
      <bpmn:sequenceFlow id="W3417_Flow14" sourceRef="W3417_Task7" targetRef="W3417_End8" />
    </bpmn:process>
