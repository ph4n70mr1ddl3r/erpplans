<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-124.3-selling-performance-attachment-and-clienteling-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3849" name="W3849. Selling-Effectiveness KPI Framework &amp; Associate/Store Performance Scorecard" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W3833); reporting cycle
Frequency: Maintained + monthly/quarterly
Volume: Enterprise selling-effectiveness scorecard
Owner: Sales Enablement / Analytics
Participants: Sales Enablement, Analytics (links to VS-28.1), Store Ops (links to VS-07), Merchandising (links to VS-01), Finance (links to VS-17.4), People Analytics (links to VS-103.3), HR (links to VS-19)
Source: workflow W3849 — Selling-Effectiveness KPI Framework &amp; Associate/Store Performance Scorecard</bpmn:documentation>
      <bpmn:laneSet id="W3849_LaneSet2">
        <bpmn:lane id="W3849_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3849_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3849_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3849_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3849_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3849_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3849_Start3" name="Strategy (W3833); reporting cycle">
        <bpmn:outgoing>W3849_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3849_Task4" name="Sales Enablement/Analytics define the selling-effectiveness KPI framework…">
        <bpmn:documentation>Step 1: Sales Enablement/Analytics define the selling-effectiveness KPI framework: basket size/units, conversion, attach rate (service/accessory/link-sell), trade-pro identification, loyalty enrollment/identification, product-knowledge certification coverage (links to W3842), and selling-quality score (links to W3847), at store/department/associate level where data permits
Responsible (R): Sales Enablement / Analytics / Store Ops
Accountable (A): Sales Enablement Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3849_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3849_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3849_Task5" name="Sales Enablement/Analytics produce store/department/associate selling…">
        <bpmn:documentation>Step 2: Sales Enablement/Analytics produce store/department/associate selling scorecards (with appropriate fairness, data-quality, and privacy controls — links to VS-91), and feed into coaching (links to W3836) and recognition/incentive (links to W3838)
Responsible (R): Sales Enablement / Analytics / HR
Accountable (A): Sales Enablement Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3849_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3849_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3849_Task6" name="Sales Enablement/Store-Ops run performance conversations using the scorecard…">
        <bpmn:documentation>Step 3: Sales Enablement/Store-Ops run performance conversations using the scorecard (recognize top performers, coach middle, improve bottom), with fairness and lawful handling of associate-level data (links to VS-84/VS-91)
Responsible (R): Sales Enablement / Store Ops / HR
Accountable (A): Sales Enablement Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3849_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3849_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3849_End7" name="Complete">
        <bpmn:incoming>W3849_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3849_Annotation8">
        <bpmn:text>Controls: - CTL-603 (ensure controlled execution — Selling Performance, Attachment &amp; Clienteling Analytics (PA-124.3).) | - operational: balanced scorecard; operational: fairness controls and RA 10173 (links to VS-91)
Owner: Sales Enablement / Analytics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3849_Assoc9" sourceRef="W3849_Annotation8" targetRef="W3849_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3849_Flow10" sourceRef="W3849_Start3" targetRef="W3849_Task4" />
      <bpmn:sequenceFlow id="W3849_Flow11" sourceRef="W3849_Task4" targetRef="W3849_Task5" />
      <bpmn:sequenceFlow id="W3849_Flow12" sourceRef="W3849_Task5" targetRef="W3849_Task6" />
      <bpmn:sequenceFlow id="W3849_Flow13" sourceRef="W3849_Task6" targetRef="W3849_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3849_diag">
      <bpmndi:BPMNPlane id="W3849_plane" bpmnElement="W_W3849">
        <bpmndi:BPMNShape id="W3849_Lane1_di" bpmnElement="W3849_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
