        <bpmndi:BPMNEdge id="W3850_Assoc9_di" bpmnElement="W3850_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3851" name="W3851. Clienteling &amp; Customer-360 Effectiveness Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Clienteling rollout (W3844); reporting cycle
Frequency: Monthly + quarterly
Volume: Clienteling &amp; identified-customer analytics
Owner: Sales Enablement / Analytics / CRM
Participants: Sales Enablement, Analytics (links to VS-28.1), CRM/Loyalty (links to VS-13.3), Store Ops (links to VS-07), IT (links to VS-27), Data Privacy (links to VS-91)
Source: workflow W3851 — Clienteling &amp; Customer-360 Effectiveness Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3851_LaneSet2">
        <bpmn:lane id="W3851_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3851_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3851_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3851_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3851_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3851_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3851_Start3" name="Clienteling rollout (W3844); reporting cycle">
        <bpmn:outgoing>W3851_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3851_Task4" name="Sales Enablement/Analytics/CRM measure clienteling effectiveness…">
        <bpmn:documentation>Step 1: Sales Enablement/Analytics/CRM measure clienteling effectiveness: customer-identification rate (loyalty-identified transactions %), associate adoption of the clienteling tool (links to W3844), identified-customer basket/attach/frequency uplift vs anonymous, and tool usage
Responsible (R): Sales Enablement / Analytics / CRM
Accountable (A): Sales Enablement Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3851_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3851_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3851_Task5" name="Sales Enablement/Store-Ops translate clienteling analytics into adoption…">
        <bpmn:documentation>Step 2: Sales Enablement/Store-Ops translate clienteling analytics into adoption actions (coaching links to W3836, tool UX fixes links to W3855, identification enablement links to W3845)
Responsible (R): Sales Enablement / Store Ops / IT
Accountable (A): Sales Enablement Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3851_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3851_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3851_Task6" name="Sales Enablement/Analytics report clienteling ROI (revenue uplift from…">
        <bpmn:documentation>Step 3: Sales Enablement/Analytics report clienteling ROI (revenue uplift from identified customers vs program/tool cost) and ensure lawful data handling throughout (links to VS-91)
Responsible (R): Sales Enablement / Analytics
Accountable (A): Sales Enablement Lead / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3851_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3851_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3851_End7" name="Complete">
        <bpmn:incoming>W3851_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3851_Annotation8">
        <bpmn:text>Controls: - CTL-603 (ensure controlled execution — Selling Performance, Attachment &amp; Clienteling Analytics (PA-124.3).) | - operational: adoption analytics and coaching; operational: RA 10173 governance (links to VS-91)
Owner: Sales Enablement / Analytics / CRM</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3851_Assoc9" sourceRef="W3851_Annotation8" targetRef="W3851_Start3" associationDirection="None" />
