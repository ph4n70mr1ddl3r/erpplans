    <bpmn:process id="W_W3856" name="W3856. Executive Selling-Performance Review &amp; Commercial Linkage" isExecutable="false">
      <bpmn:documentation>Trigger: Executive cycle (links to VS-33.2); board (links to VS-36)
Frequency: Quarterly + annual
Volume: Enterprise selling-performance review
Owner: Sales Enablement / Store Ops / COO
Participants: Sales Enablement, Store Ops, Merchandising (links to VS-01), Marketing (links to VS-14), Trade Sales (links to VS-11/VS-107), Loyalty (links to VS-13), Finance (links to VS-17.4/VS-101), Analytics (links to VS-28.1), Executive (links to VS-36)
Source: workflow W3856 — Executive Selling-Performance Review &amp; Commercial Linkage</bpmn:documentation>
      <bpmn:laneSet id="W3856_LaneSet3">
        <bpmn:lane id="W3856_Lane1" name="Sales Enablement">
        <bpmn:flowNodeRef>W3856_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3856_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3856_Lane2" name="COO">
        <bpmn:flowNodeRef>W3856_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3856_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3856_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3856_Start4" name="Executive cycle (links to VS-33.2); board (links to VS-36)">
        <bpmn:outgoing>W3856_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3856_Task5" name="Sales Enablement/Store-Ops compile the selling-performance review…">
        <bpmn:documentation>Step 1: Sales Enablement/Store-Ops compile the selling-performance review: basket/conversion/attach (links to W3850), clienteling (links to W3851), trade-pro/B2B (links to W3852), loyalty (links to W3853), enablement ROI (links to W3854), and selling quality (links to W3847), by store/region/category
Responsible (R): Sales Enablement / Store Ops / Analytics
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3856_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3856_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3856_Task6" name="COO/Sales-Enablement translate the review into commercial actions…">
        <bpmn:documentation>Step 2: COO/Sales-Enablement translate the review into commercial actions: merchandising (links to VS-01), pricing/promo (links to VS-01.2/VS-14/VS-57), trade-pro/loyalty programs (links to VS-43/VS-13), store-ops priorities (links to VS-07), and enablement investment (links to W3840) — aligned to the merchandise/commercial plan (links to VS-101/VS-33)
Responsible (R): COO / Sales Enablement / Merchandising
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3856_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3856_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3856_Task7" name="COO report selling performance and the customer-experience/selling-quality…">
        <bpmn:documentation>Step 3: COO report selling performance and the customer-experience/selling-quality posture to the executive committee and board (links to VS-36/VS-33.2), including the link to brand and CX (links to VS-14.3/VS-13)
Responsible (R): COO
Accountable (A): CEO / Board
Duration: Quarterly/annual</bpmn:documentation>
        <bpmn:incoming>W3856_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3856_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3856_End8" name="Complete">
        <bpmn:incoming>W3856_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3856_Annotation9">
        <bpmn:text>Controls: - CTL-603 (ensure controlled execution — Selling Performance, Attachment &amp; Clienteling Analytics (PA-124.3).) | - operational: review and linkage; operational: board reporting
Owner: Sales Enablement / Store Ops / COO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3856_Assoc10" sourceRef="W3856_Annotation9" targetRef="W3856_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3856_Flow11" sourceRef="W3856_Start4" targetRef="W3856_Task5" />
      <bpmn:sequenceFlow id="W3856_Flow12" sourceRef="W3856_Task5" targetRef="W3856_Task6" />
      <bpmn:sequenceFlow id="W3856_Flow13" sourceRef="W3856_Task6" targetRef="W3856_Task7" />
      <bpmn:sequenceFlow id="W3856_Flow14" sourceRef="W3856_Task7" targetRef="W3856_End8" />
    </bpmn:process>
