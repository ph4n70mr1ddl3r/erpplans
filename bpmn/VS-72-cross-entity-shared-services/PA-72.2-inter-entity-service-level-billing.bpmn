        <bpmndi:BPMNShape id="W2582_End9_di" bpmnElement="W2582_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Annotation10_di" bpmnElement="W2582_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2582_Flow12_di" bpmnElement="W2582_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2582_Flow13_di" bpmnElement="W2582_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2582_Flow14_di" bpmnElement="W2582_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2582_Flow15_di" bpmnElement="W2582_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2582_Assoc11_di" bpmnElement="W2582_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2583" name="W2583. Monthly IC Invoice Generation &amp; Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly IC billing cycle
Frequency: Monthly
Volume: ~60–80 IC invoices/month incl. per-DC/per-entity splits (per PA-17.2 W1293)
Owner: Finance Analyst
Participants: Finance Analyst, Entity Accountants, Finance Controller
Source: workflow W2583 — Monthly IC Invoice Generation &amp; Settlement</bpmn:documentation>
      <bpmn:laneSet id="W2583_LaneSet3">
        <bpmn:lane id="W2583_Lane1" name="System">
        <bpmn:flowNodeRef>W2583_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2583_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2583_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2583_Lane2" name="Entity Accountants">
        <bpmn:flowNodeRef>W2583_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2583_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2583_Start4" name="Monthly IC billing cycle">
        <bpmn:outgoing>W2583_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2583_Task5" name="System auto-generates monthly IC invoices based on service agreements…">
        <bpmn:documentation>Step 1: System auto-generates monthly IC invoices based on service agreements: warehouse fees (per-pallet + per-order), ecommerce platform fees (per-order), rent (fixed monthly per lease), management fees (allocated per methodology); Finance Analyst reviews and validates each invoice
Responsible (R): System / Finance Analyst
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2583_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2583_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2583_Task6" name="Entity accountants verify IC invoices against internal records: Depot Inc…">
        <bpmn:documentation>Step 2: Entity accountants verify IC invoices against internal records: Depot Inc. confirms warehouse usage, Digital Commerce confirms order count, Property Inc. confirms lease terms; disputes resolved within 5 business days
Responsible (R): Entity Accountants
Accountable (A): Entity CFOs
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2583_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2583_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2583_Task7" name="System posts IC settlement: offsetting AP/AR entries between entities; net…">
        <bpmn:documentation>Step 3: System posts IC settlement: offsetting AP/AR entries between entities; net settlement for intercompany dividends and management fees; Finance Controller reviews net IC position; Treasury executes any required cash settlement between entity bank accounts
Responsible (R): System / Treasury
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2583_Flow13</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2583_End8" name="Complete">
        <bpmn:incoming>W2583_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2583_Annotation9">
        <bpmn:text>Controls: - CTL-446 (ensure controlled execution — Inter-Entity Service Level &amp; Billing (PA-72.2).) — IC-settlement accuracy, links to VS-17 / W14; operational: Finance Controller net-position sign-off
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2583_Assoc10" sourceRef="W2583_Annotation9" targetRef="W2583_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2583_Flow11" sourceRef="W2583_Start4" targetRef="W2583_Task5" />
      <bpmn:sequenceFlow id="W2583_Flow12" sourceRef="W2583_Task5" targetRef="W2583_Task6" />
      <bpmn:sequenceFlow id="W2583_Flow13" sourceRef="W2583_Task6" targetRef="W2583_Task7" />
      <bpmn:sequenceFlow id="W2583_Flow14" sourceRef="W2583_Task7" targetRef="W2583_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2583_diag">
      <bpmndi:BPMNPlane id="W2583_plane" bpmnElement="W_W2583">
        <bpmndi:BPMNShape id="W2583_Lane1_di" bpmnElement="W2583_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Lane2_di" bpmnElement="W2583_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Task5_di" bpmnElement="W2583_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Task6_di" bpmnElement="W2583_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Task7_di" bpmnElement="W2583_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Start4_di" bpmnElement="W2583_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_End8_di" bpmnElement="W2583_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2583_Annotation9_di" bpmnElement="W2583_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2583_Flow11_di" bpmnElement="W2583_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2583_Flow12_di" bpmnElement="W2583_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2583_Flow13_di" bpmnElement="W2583_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2583_Flow14_di" bpmnElement="W2583_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2583_Assoc10_di" bpmnElement="W2583_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2584" name="W2584. IC Pricing Dispute Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Entity disputes IC service pricing
Frequency: Ad-hoc; 3–5 per year
Volume: 5 entities
Owner: Finance Controller
Participants: Finance Controller, Entity CFOs, CFO, External Advisor
Source: workflow W2584 — IC Pricing Dispute Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2584_LaneSet4">
        <bpmn:lane id="W2584_Lane1" name="Entity CFO">
        <bpmn:flowNodeRef>W2584_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2584_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2584_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2584_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2584_Lane3" name="CFO">
        <bpmn:flowNodeRef>W2584_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2584_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2584_Start5" name="Entity disputes IC service pricing">
        <bpmn:outgoing>W2584_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2584_Task6" name="Receiving entity CFO disputes IC charge: documents basis for dispute (volume…">
        <bpmn:documentation>Step 1: Receiving entity CFO disputes IC charge: documents basis for dispute (volume variance, service quality issue, pricing methodology concern); submits formal dispute to Finance Controller within 10 business days of invoice receipt
Responsible (R): Entity CFO
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2584_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2584_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2584_Task7" name="Finance Controller investigates: reviews allocation methodology, verifies data…">
        <bpmn:documentation>Step 2: Finance Controller investigates: reviews allocation methodology, verifies data accuracy, benchmarks against external market rates; engages external transfer pricing advisor if methodology dispute; proposes resolution
Responsible (R): Finance Controller / External Advisor
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2584_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2584_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2584_Task8" name="CFO renders decision: adjusts pricing prospectively, issues credit note for…">
        <bpmn:documentation>Step 3: CFO renders decision: adjusts pricing prospectively, issues credit note for disputed amount if warranted, updates service agreement if methodology change required; documents resolution for transfer pricing file
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2584_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2584_End9" name="Complete">
        <bpmn:incoming>W2584_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2584_Annotation10">
        <bpmn:text>Controls: - CTL-48: dispute resolution — links to VS-39; CTL-18 (TP arm&#x27;s-length — links to W235); operational: CFO decision sign-off
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2584_Assoc11" sourceRef="W2584_Annotation10" targetRef="W2584_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2584_Flow12" sourceRef="W2584_Start5" targetRef="W2584_Task6" />
      <bpmn:sequenceFlow id="W2584_Flow13" sourceRef="W2584_Task6" targetRef="W2584_Task7" />
      <bpmn:sequenceFlow id="W2584_Flow14" sourceRef="W2584_Task7" targetRef="W2584_Task8" />
      <bpmn:sequenceFlow id="W2584_Flow15" sourceRef="W2584_Task8" targetRef="W2584_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2584_diag">
      <bpmndi:BPMNPlane id="W2584_plane" bpmnElement="W_W2584">
        <bpmndi:BPMNShape id="W2584_Lane1_di" bpmnElement="W2584_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Lane2_di" bpmnElement="W2584_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Lane3_di" bpmnElement="W2584_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Task6_di" bpmnElement="W2584_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Task7_di" bpmnElement="W2584_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Task8_di" bpmnElement="W2584_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Start5_di" bpmnElement="W2584_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_End9_di" bpmnElement="W2584_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2584_Annotation10_di" bpmnElement="W2584_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2584_Flow12_di" bpmnElement="W2584_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2584_Flow13_di" bpmnElement="W2584_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2584_Flow14_di" bpmnElement="W2584_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2584_Flow15_di" bpmnElement="W2584_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2584_Assoc11_di" bpmnElement="W2584_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2585" name="W2585. IC Billing Accuracy Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly audit cycle
Frequency: Quarterly
Volume: ~20 IC billing streams
Owner: Internal Auditor
Participants: Internal Auditor, Finance Controller
Source: workflow W2585 — IC Billing Accuracy Audit</bpmn:documentation>
      <bpmn:laneSet id="W2585_LaneSet3">
        <bpmn:lane id="W2585_Lane1" name="Internal Auditor">
        <bpmn:flowNodeRef>W2585_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2585_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2585_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2585_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2585_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2585_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2585_Start4" name="Quarterly audit cycle">
        <bpmn:outgoing>W2585_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2585_Task5" name="Internal Auditor samples IC invoices: verifies calculation accuracy (rate ×…">
        <bpmn:documentation>Step 1: Internal Auditor samples IC invoices: verifies calculation accuracy (rate × volume = charge), confirms billing matches service agreement terms, tests volume data against operational records (warehouse pallets stored, ecommerce orders processed)
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2585_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2585_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2585_Task6" name="Auditor identifies discrepancies: over/under billing, incorrect rates applied…">
        <bpmn:documentation>Step 2: Auditor identifies discrepancies: over/under billing, incorrect rates applied, missing invoices for services rendered, late billing; quantifies financial impact; reports findings to Finance Controller and Head of Internal Audit
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2585_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2585_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2585_Task7" name="Finance Controller implements corrections: issues adjusting entries, corrects…">
        <bpmn:documentation>Step 3: Finance Controller implements corrections: issues adjusting entries, corrects billing templates, strengthens automated validation rules; prevents recurrence through system controls
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2585_Flow13</bpmn:incoming>
      </bpmn:userTask>
