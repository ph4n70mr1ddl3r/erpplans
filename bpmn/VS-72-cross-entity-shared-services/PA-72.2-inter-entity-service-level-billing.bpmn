    <bpmn:process id="W_W2588" name="W2588. New Entity IC Service Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New entity establishment or entity restructuring
Frequency: Ad-hoc; rare
Volume: 5 entities
Owner: Finance Controller
Participants: Finance Controller, Legal, IT, Entity CFO
Source: workflow W2588 — New Entity IC Service Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W2588_LaneSet3">
        <bpmn:lane id="W2588_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2588_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2588_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2588_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2588_Lane2" name="IT">
        <bpmn:flowNodeRef>W2588_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2588_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2588_Start4" name="New entity establishment or entity restructuring">
        <bpmn:outgoing>W2588_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2588_Task5" name="Finance Controller establishes IC service framework for new/restructured…">
        <bpmn:documentation>Step 1: Finance Controller establishes IC service framework for new/restructured entity: identifies required shared services, negotiates service scope and pricing with entity head, drafts intercompany service agreement with Legal
Responsible (R): Finance Controller / Legal
Accountable (A): CFO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2588_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2588_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2588_Task6" name="IT configures entity in ERP: creates entity GL, IC account pairs, cost center…">
        <bpmn:documentation>Step 2: IT configures entity in ERP: creates entity GL, IC account pairs, cost center structure, billing templates; tests IC posting rules in sandbox; Finance Controller validates parallel run
Responsible (R): IT / Finance Controller
Accountable (A): CIO / CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2588_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2588_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2588_Task7" name="Finance Controller activates IC billing for new entity; monitors first 3 months…">
        <bpmn:documentation>Step 3: Finance Controller activates IC billing for new entity; monitors first 3 months for accuracy; adjusts allocation methodology based on actual volumes; external advisor updates transfer pricing documentation
Responsible (R): Finance Controller / External Advisor
Accountable (A): CFO
Duration: 1–3 months</bpmn:documentation>
        <bpmn:incoming>W2588_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2588_End8" name="Complete">
        <bpmn:incoming>W2588_Flow14</bpmn:incoming>
      </bpmn:endEvent>
