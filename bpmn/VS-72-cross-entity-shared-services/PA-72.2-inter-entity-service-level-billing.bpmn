<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-72.2-inter-entity-service-level-billing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2582" name="W2582. Intercompany Service Agreement Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or new service establishment
Frequency: Annual; event-driven
Volume: 5 entities; ~20 IC service agreements
Owner: Finance Controller
Participants: Finance Controller, Legal, Entity CFOs
Source: workflow W2582 — Intercompany Service Agreement Management</bpmn:documentation>
      <bpmn:laneSet id="W2582_LaneSet4">
        <bpmn:lane id="W2582_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2582_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2582_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2582_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2582_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2582_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2582_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2582_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2582_Start5" name="Annual review or new service establishment">
        <bpmn:outgoing>W2582_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2582_Task6" name="Finance Controller maintains intercompany service agreement registry…">
        <bpmn:documentation>Step 1: Finance Controller maintains intercompany service agreement registry: warehousing services (Logistics Inc. → Depot Inc.), ecommerce platform services (Digital Commerce Inc. → Depot Inc.), property leasing (Property Inc. → Depot Inc.), management services (Holdings → all subsidiaries)
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2582_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2582_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2582_Task7" name="Legal reviews each agreement annually: confirms scope and pricing reflect…">
        <bpmn:documentation>Step 2: Legal reviews each agreement annually: confirms scope and pricing reflect actual services, verifies compliance with transfer pricing regulations (BIR Revenue Regulations), updates for any service changes; CFO signs off on renewals
Responsible (R): Legal / Finance Controller
Accountable (A): CFO
Duration: 1–2 weeks/year</bpmn:documentation>
        <bpmn:incoming>W2582_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2582_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2582_Task8" name="System stores IC service agreements with auto-renewal alerts; tracks billing…">
        <bpmn:documentation>Step 3: System stores IC service agreements with auto-renewal alerts; tracks billing milestones and payment terms; generates IC invoice templates per agreement; flags agreements approaching expiration for review
Responsible (R): Finance / IT
Accountable (A): Finance Controller
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2582_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2582_End9" name="Complete">
        <bpmn:incoming>W2582_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2582_Annotation10">
        <bpmn:text>Controls: - CTL-446 (ensure controlled execution — Inter-Entity Service Level &amp; Billing (PA-72.2).) | - CTL-446 (transfer-pricing arm&#x27;s-length — links to W235); operational: CFO sign-off on annual renewals
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2582_Assoc11" sourceRef="W2582_Annotation10" targetRef="W2582_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2582_Flow12" sourceRef="W2582_Start5" targetRef="W2582_Task6" />
      <bpmn:sequenceFlow id="W2582_Flow13" sourceRef="W2582_Task6" targetRef="W2582_Task7" />
      <bpmn:sequenceFlow id="W2582_Flow14" sourceRef="W2582_Task7" targetRef="W2582_Task8" />
      <bpmn:sequenceFlow id="W2582_Flow15" sourceRef="W2582_Task8" targetRef="W2582_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2582_diag">
      <bpmndi:BPMNPlane id="W2582_plane" bpmnElement="W_W2582">
        <bpmndi:BPMNShape id="W2582_Lane1_di" bpmnElement="W2582_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Lane2_di" bpmnElement="W2582_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Lane3_di" bpmnElement="W2582_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Task6_di" bpmnElement="W2582_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Task7_di" bpmnElement="W2582_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2582_Task8_di" bpmnElement="W2582_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
