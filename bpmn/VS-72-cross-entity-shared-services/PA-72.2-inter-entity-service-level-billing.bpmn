    <bpmn:process id="W_W2589" name="W2589. IC Service Agreement Renewal &amp; Renegotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual renewal cycle or service change trigger
Frequency: Annual
Volume: ~20 agreements
Owner: Finance Controller
Participants: Finance Controller, Entity CFOs, Legal, CFO
Source: workflow W2589 — IC Service Agreement Renewal &amp; Renegotiation</bpmn:documentation>
      <bpmn:laneSet id="W2589_LaneSet4">
        <bpmn:lane id="W2589_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2589_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2589_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2589_Lane2" name="Entity CFOs">
        <bpmn:flowNodeRef>W2589_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2589_Lane3" name="Legal">
        <bpmn:flowNodeRef>W2589_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2589_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2589_Start5" name="Annual renewal cycle or service change trigger">
        <bpmn:outgoing>W2589_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2589_Task6" name="Finance Controller prepares renewal analysis: actual vs. budgeted service…">
        <bpmn:documentation>Step 1: Finance Controller prepares renewal analysis: actual vs. budgeted service volumes, cost trend per service, market rate benchmarking, SLA performance summary, transfer pricing compliance status; proposes renewal terms (maintain, adjust pricing, modify scope)
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2589_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2589_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2589_Task7" name="Entity CFOs review renewal proposals: negotiate pricing adjustments (typically…">
        <bpmn:documentation>Step 2: Entity CFOs review renewal proposals: negotiate pricing adjustments (typically ±5% annually based on cost changes), request scope modifications, raise service quality concerns; CFO mediates if agreement cannot be reached
Responsible (R): Entity CFOs / Finance Controller
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2589_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2589_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2589_Task8" name="Legal updates executed agreements; Finance Controller updates ERP billing…">
        <bpmn:documentation>Step 3: Legal updates executed agreements; Finance Controller updates ERP billing templates and allocation rules; communicates changes to entity accounting teams; documents in transfer pricing file for BIR audit readiness
Responsible (R): Legal / Finance Controller / IT
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2589_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2589_End9" name="Complete">
        <bpmn:incoming>W2589_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2589_Annotation10">
        <bpmn:text>Controls: - CTL-446 (ensure controlled execution — Inter-Entity Service Level &amp; Billing (PA-72.2).) | - CTL-446 (transfer-pricing arm&#x27;s-length — links to W235); operational: CFO sign-off on renewal terms
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2589_Assoc11" sourceRef="W2589_Annotation10" targetRef="W2589_Start5" associationDirection="None" />
