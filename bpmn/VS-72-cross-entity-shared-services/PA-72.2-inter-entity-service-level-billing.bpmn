    <bpmn:process id="W_W2587" name="W2587. IC Service Level Performance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly SLA review cycle
Frequency: Monthly
Volume: ~20 IC service agreements
Owner: Finance Analyst
Participants: Finance Analyst, Service Providers, Entity CFOs
Source: workflow W2587 — IC Service Level Performance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2587_LaneSet4">
        <bpmn:lane id="W2587_Lane1" name="System">
        <bpmn:flowNodeRef>W2587_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2587_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2587_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W2587_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2587_Lane3" name="Finance Controller">
        <bpmn:flowNodeRef>W2587_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2587_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2587_Start5" name="Monthly SLA review cycle">
        <bpmn:outgoing>W2587_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2587_Task6" name="System collects SLA metrics: Logistics Inc. — warehouse throughput, order…">
        <bpmn:documentation>Step 1: System collects SLA metrics: Logistics Inc. — warehouse throughput, order accuracy, delivery timeliness; Digital Commerce Inc. — platform uptime, order processing time; Property Inc. — facility response time, maintenance completion; generates SLA performance scorecards
Responsible (R): System / Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2587_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2587_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2587_Task7" name="Finance Analyst reviews SLA performance vs. contractual targets: identifies SLA…">
        <bpmn:documentation>Step 2: Finance Analyst reviews SLA performance vs. contractual targets: identifies SLA breaches; calculates penalty credits per agreement terms (e.g., 2% credit for warehouse accuracy &lt;99%); adjusts IC invoices for SLA penalties
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2587_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2587_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2587_Task8" name="Quarterly: Finance Controller convenes IC service review meeting with entity…">
        <bpmn:documentation>Step 3: Quarterly: Finance Controller convenes IC service review meeting with entity heads; discusses SLA trends, service improvement opportunities, pricing adjustments; documents decisions for transfer pricing file
Responsible (R): Finance Controller / Entity Heads
Accountable (A): CFO
Duration: Half day/quarter</bpmn:documentation>
        <bpmn:incoming>W2587_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2587_End9" name="Complete">
        <bpmn:incoming>W2587_Flow15</bpmn:incoming>
      </bpmn:endEvent>
