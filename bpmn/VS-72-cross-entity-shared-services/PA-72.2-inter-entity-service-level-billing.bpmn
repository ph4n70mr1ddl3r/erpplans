    <bpmn:process id="W_W2586" name="W2586. Intercompany Cash Settlement &amp; Netting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly IC settlement cycle
Frequency: Monthly
Volume: 5 entities; ~PHP 150–250M in monthly IC flows (≈PHP 2–3B/year, per PA-17.2 W1299/W1293)
Owner: Treasury Manager
Participants: Treasury Mgr, Finance Controller, Entity CFOs
Source: workflow W2586 — Intercompany Cash Settlement &amp; Netting</bpmn:documentation>
      <bpmn:laneSet id="W2586_LaneSet3">
        <bpmn:lane id="W2586_Lane1" name="Treasury Manager">
        <bpmn:flowNodeRef>W2586_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2586_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2586_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2586_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2586_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2586_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2586_Start4" name="Monthly IC settlement cycle">
        <bpmn:outgoing>W2586_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2586_Task5" name="Treasury Manager compiles monthly IC net position per entity: aggregates all IC…">
        <bpmn:documentation>Step 1: Treasury Manager compiles monthly IC net position per entity: aggregates all IC receivables and payables; calculates net settlement amount per entity pair; prepares netting statement
Responsible (R): Treasury Manager
Accountable (A): Finance Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2586_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2586_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2586_Task6" name="Finance Controller verifies netting statement against GL IC sub-ledgers…">
        <bpmn:documentation>Step 2: Finance Controller verifies netting statement against GL IC sub-ledgers; confirms elimination entries in consolidated GL; Treasury executes cash movements for net settlement positions
Responsible (R): Finance Controller / Treasury
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2586_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2586_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2586_Task7" name="Treasury ensures IC cash settlements are executed within 5 business days of…">
        <bpmn:documentation>Step 3: Treasury ensures IC cash settlements are executed within 5 business days of month-end; monitors aging of IC balances; escalates overdue IC settlements; maintains IC cash settlement audit trail
Responsible (R): Treasury Manager
Accountable (A): Finance Controller
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2586_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2586_End8" name="Complete">
        <bpmn:incoming>W2586_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2586_Annotation9">
        <bpmn:text>Controls: - CTL-446 (ensure controlled execution — Inter-Entity Service Level &amp; Billing (PA-72.2).) | - CTL-446 (IC-settlement accuracy — links to VS-17 / W14); operational: cash-movement authorization per W320 electronic-banking security; Finance Controller netting sign-off
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
