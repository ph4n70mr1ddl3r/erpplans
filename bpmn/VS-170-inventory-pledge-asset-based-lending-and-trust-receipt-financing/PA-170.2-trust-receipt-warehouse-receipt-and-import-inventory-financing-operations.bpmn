      <bpmndi:BPMNPlane id="W4946_plane" bpmnElement="W_W4946">
        <bpmndi:BPMNShape id="W4946_Lane1_di" bpmnElement="W4946_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
