        <bpmndi:BPMNEdge id="W4946_Flow11_di" bpmnElement="W4946_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4946_Flow12_di" bpmnElement="W4946_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4946_Flow13_di" bpmnElement="W4946_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4946_Assoc9_di" bpmnElement="W4946_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4947" name="W4947. Trust-Receipt Sell-Through Tracking &amp; Proceeds Segregation" isExecutable="false">
      <bpmn:documentation>Trigger: Sale/usage of trust goods (POS VS-08, B2B VS-11, ecommerce VS-10)
Frequency: Continuous (per transaction against trust goods)
Volume: ~15–25% of the 2.8M monthly POS + B2B + ecommerce transactions tied to trust goods
Owner: ABL &amp; Collateral Operations Manager / Finance / Treasury
Participants: Finance (VS-17), Treasury (VS-18), POS/Ecommerce (VS-08/VS-10), B2B (VS-11), Data (VS-28)
Source: workflow W4947 — Trust-Receipt Sell-Through Tracking &amp; Proceeds Segregation</bpmn:documentation>
      <bpmn:laneSet id="W4947_LaneSet2">
        <bpmn:lane id="W4947_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4947_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4947_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4947_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4947_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4947_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4947_Start3" name="Sale/usage of trust goods (POS VS-08, B2B VS-11, ecommerce VS-10)">
        <bpmn:outgoing>W4947_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4947_Task4" name="Track trust-goods sell-through: as goods-in-trust inventory sells (POS VS-08…">
        <bpmn:documentation>Step 1: Track trust-goods sell-through: as goods-in-trust inventory sells (POS VS-08, B2B VS-11, ecommerce VS-10), compute the proceeds attributable to the trust shipment (FIFO/identified-lot per TR terms), and segregate the proceeds from general cash into the TR-proceeds bucket for the bank
Responsible (R): Finance / Analytics / Treasury
Accountable (A): ABL Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4947_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4947_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4947_Task5" name="Segregate &amp; hold proceeds: hold the segregated proceeds pending remittance…">
        <bpmn:documentation>Step 2: Segregate &amp; hold proceeds: hold the segregated proceeds pending remittance (W4948), apply against the TR-payable (principal + charges), and prevent commingling/diversion to other uses (anti-diversion per PD 115 W4945); reconcile proceeds to sales and trust-goods depletion
Responsible (R): Finance / Treasury / Analytics
Accountable (A): Treasurer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4947_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4947_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4947_Task6" name="Report &amp; monitor trust-goods position: report trust-goods-on-hand vs sold vs…">
        <bpmn:documentation>Step 3: Report &amp; monitor trust-goods position: report trust-goods-on-hand vs sold vs proceeds-segregated to the bank/management, flag shortfalls (proceeds &lt; obligation as goods deplete), and feed remittance scheduling (W4948) and availability (W4942)
Responsible (R): Finance / Treasury / ABL Manager
Accountable (A): Treasurer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4947_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4947_End7" name="Complete">
        <bpmn:incoming>W4947_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4947_Annotation8">
        <bpmn:text>Controls: - CTL-741 (ensure controlled execution — Trust-Receipt, Warehouse-Receipt &amp; Import Inventory Financing Operations (PA-170.2).) | - CTL-741: proceeds segregated; anti-diversion enforced; attribution reconciled to sales/depletion; shortfalls alerted
Owner: ABL &amp; Collateral Operations Manager / Finance / Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4947_Assoc9" sourceRef="W4947_Annotation8" targetRef="W4947_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4947_Flow10" sourceRef="W4947_Start3" targetRef="W4947_Task4" />
      <bpmn:sequenceFlow id="W4947_Flow11" sourceRef="W4947_Task4" targetRef="W4947_Task5" />
      <bpmn:sequenceFlow id="W4947_Flow12" sourceRef="W4947_Task5" targetRef="W4947_Task6" />
      <bpmn:sequenceFlow id="W4947_Flow13" sourceRef="W4947_Task6" targetRef="W4947_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4947_diag">
      <bpmndi:BPMNPlane id="W4947_plane" bpmnElement="W_W4947">
        <bpmndi:BPMNShape id="W4947_Lane1_di" bpmnElement="W4947_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_Task4_di" bpmnElement="W4947_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_Task5_di" bpmnElement="W4947_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_Task6_di" bpmnElement="W4947_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_Start3_di" bpmnElement="W4947_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_End7_di" bpmnElement="W4947_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4947_Annotation8_di" bpmnElement="W4947_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4947_Flow10_di" bpmnElement="W4947_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4947_Flow11_di" bpmnElement="W4947_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4947_Flow12_di" bpmnElement="W4947_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4947_Flow13_di" bpmnElement="W4947_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4947_Assoc9_di" bpmnElement="W4947_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
