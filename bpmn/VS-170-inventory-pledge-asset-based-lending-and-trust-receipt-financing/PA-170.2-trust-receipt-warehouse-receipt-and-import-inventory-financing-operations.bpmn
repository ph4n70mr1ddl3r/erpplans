    <bpmn:process id="W_W4949" name="W4949. Warehouse-Receipt &amp; Field-Warehousing Collateral Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Warehouse-receipt collateral arrangement; ABL inventory pledge over DC stock
Frequency: Per arrangement + periodic verification
Volume: ~8–12 collateralized DC/store inventory pools across 4 DCs + designated store locations
Owner: ABL &amp; Collateral Operations Manager / Treasury / DC Ops
Participants: Treasury (VS-18), DC/Store Ops (VS-04/VS-07), Finance (VS-17), Legal (VS-100), Inventory (VS-05)
Source: workflow W4949 — Warehouse-Receipt &amp; Field-Warehousing Collateral Operations</bpmn:documentation>
      <bpmn:laneSet id="W4949_LaneSet4">
        <bpmn:lane id="W4949_Lane1" name="ABL Manager">
