    <bpmn:process id="W_W4945" name="W4945. Trust-Receipt Financing Program Setup &amp; PD 115 Compliance Framework" isExecutable="false">
      <bpmn:documentation>Trigger: Import-line close (W4937); TR program launch; legal/regulatory update (PD 115)
Frequency: Per setup + on legal/bank change
Volume: 1 TR program × import-line facilities × ~400–600 TEUs/month
Owner: ABL &amp; Collateral Operations Manager / Treasury / Legal
Participants: Treasury (VS-18), Legal (VS-100), Import/Customs (VS-02.2/VS-87), AP (VS-15), Finance (VS-17), Compliance (VS-86)
Source: workflow W4945 — Trust-Receipt Financing Program Setup &amp; PD 115 Compliance Framework</bpmn:documentation>
      <bpmn:laneSet id="W4945_LaneSet3">
        <bpmn:lane id="W4945_Lane1" name="Legal">
        <bpmn:flowNodeRef>W4945_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4945_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4945_Lane2" name="ABL Manager">
        <bpmn:flowNodeRef>W4945_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4945_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4945_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4945_Start4" name="Import-line close (W4937); TR program launch; legal/regulatory update (PD 115)">
        <bpmn:outgoing>W4945_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4945_Task5" name="Establish the TR-financing framework per PD 115 (Trust Receipts Law) and the…">
        <bpmn:documentation>Step 1: Establish the TR-financing framework per PD 115 (Trust Receipts Law) and the credit agreement: the trust-receipt instrument, the goods covered (imported goods under LC/DA/DP — links VS-15.1 W232), the proceeds obligation (sell and remit, or hold and pay at term), segregation of trust goods from general inventory, recordkeeping, and the compliance/anti-diversion controls (PD 115 Sec. 13 criminal liability)
Responsible (R): Legal / ABL Manager / Treasury
Accountable (A): CFO / Legal
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4945_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4945_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4945_Task6" name="Configure the TR operational model in ERP/treasury: TR subledger (per…">
        <bpmn:documentation>Step 2: Configure the TR operational model in ERP/treasury: TR subledger (per shipment/lc/BL), goods-in-trust inventory status (distinct from owned — links VS-05/VS-29), proceeds tracking, remittance scheduling, and the integration with import settlement (W232/W239) and inventory ownership transfer on remittance/release
Responsible (R): ABL Manager / Treasury / IT (VS-27) / Finance
Accountable (A): Treasurer
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4945_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4945_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4945_Task7" name="Train &amp; govern: brief Import/Customs, AP, Inventory, and DC/Store Ops on…">
        <bpmn:documentation>Step 3: Train &amp; govern: brief Import/Customs, AP, Inventory, and DC/Store Ops on goods-in-trust segregation, the prohibition on diversion/sale-without-remittance, and the audit trail; establish the compliance review (links VS-21/VS-86) and reporting to the bank
Responsible (R): ABL Manager / Legal / Compliance / Internal Audit
Accountable (A): CFO / Treasurer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4945_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4945_End8" name="Complete">
        <bpmn:incoming>W4945_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4945_Annotation9">
        <bpmn:text>Controls: - CTL-116 (ensure borrowing-base &amp; covenant compliance.) | - CTL-741: TR framework per PD 115; goods-in-trust segregated; anti-diversion controls; officer trained; audited (VS-21/VS-86)
Owner: ABL &amp; Collateral Operations Manager / Treasury / Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4945_Assoc10" sourceRef="W4945_Annotation9" targetRef="W4945_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4945_Flow11" sourceRef="W4945_Start4" targetRef="W4945_Task5" />
      <bpmn:sequenceFlow id="W4945_Flow12" sourceRef="W4945_Task5" targetRef="W4945_Task6" />
      <bpmn:sequenceFlow id="W4945_Flow13" sourceRef="W4945_Task6" targetRef="W4945_Task7" />
      <bpmn:sequenceFlow id="W4945_Flow14" sourceRef="W4945_Task7" targetRef="W4945_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4945_diag">
      <bpmndi:BPMNPlane id="W4945_plane" bpmnElement="W_W4945">
        <bpmndi:BPMNShape id="W4945_Lane1_di" bpmnElement="W4945_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
