      <bpmn:sequenceFlow id="W4960_Flow12" sourceRef="W4960_Task5" targetRef="W4960_Task6" />
      <bpmn:sequenceFlow id="W4960_Flow13" sourceRef="W4960_Task6" targetRef="W4960_Task7" />
      <bpmn:sequenceFlow id="W4960_Flow14" sourceRef="W4960_Task7" targetRef="W4960_End8" />
    </bpmn:process>
