<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-170.3-collateral-release-reconciliation-compliance-and-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4953" name="W4953. Facility Paydown, Collateral Release &amp; Exit/Refinance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Facility maturity; refinance decision; excess-liquidity paydown; collateral release request
Frequency: Event-driven (maturity/refinance/paydown)
Volume: ~1–3 facilities × maturity/refinance events
Owner: Treasurer / ABL &amp; Collateral Operations Manager / Legal
Participants: Treasury (VS-18), Finance (VS-17), Legal (VS-100), Inventory (VS-05), AR (VS-16)
Source: workflow W4953 — Facility Paydown, Collateral Release &amp; Exit/Refinance Management</bpmn:documentation>
      <bpmn:laneSet id="W4953_LaneSet4">
        <bpmn:lane id="W4953_Lane1" name="Treasurer">
        <bpmn:flowNodeRef>W4953_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4953_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4953_Lane2" name="ABL Manager">
        <bpmn:flowNodeRef>W4953_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4953_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W4953_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4953_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4953_Start5" name="Facility maturity; refinance decision; excess-liquidity paydown; collateral release…">
        <bpmn:outgoing>W4953_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4953_Task6" name="Manage the paydown/refinance/exit: at maturity or strategic refinance (W4937)…">
        <bpmn:documentation>Step 1: Manage the paydown/refinance/exit: at maturity or strategic refinance (W4937), plan the paydown (from cash/SCF/collections), the new facility transition, and the collateral release schedule; coordinate with the bank/agent and Legal (VS-100.3) on termination/release documentation
Responsible (R): Treasurer / ABL Manager / Legal / Finance
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4953_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4953_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4953_Task7" name="Execute collateral release: on paydown/termination, release the inventory/AR…">
        <bpmn:documentation>Step 2: Execute collateral release: on paydown/termination, release the inventory/AR pledge (W4951), the trust-receipt residual (W4948), and warehouse-receipt collateral (W4949); record the release of security interest, reclassify any residual goods-in-trust to owned, and update the encumbrance register/disclosure (W4955)
Responsible (R): ABL Manager / Legal / Finance / Inventory
Accountable (A): Treasurer / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4953_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4953_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4953_Task8" name="Close the facility &amp; transition: settle final interest/charges (W4959)…">
        <bpmn:documentation>Step 3: Close the facility &amp; transition: settle final interest/charges (W4959), terminate covenants/reporting, archive the facility file, transition to the new facility (W4937) if refinancing, and report the exit to management/board (VS-36)
Responsible (R): Treasury / Finance / Legal
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4953_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4953_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4953_End9" name="Complete">
        <bpmn:incoming>W4953_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4953_Annotation10">
        <bpmn:text>Controls: - CTL-742 (ensure controlled execution — Collateral Release, Reconciliation, Compliance &amp; Analytics (PA-170.3).) | - CTL-742: paydown/refinance board-approved; security formally released; encumbrance register updated; transition sequenced
Owner: Treasurer / ABL &amp; Collateral Operations Manager / Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4953_Assoc11" sourceRef="W4953_Annotation10" targetRef="W4953_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4953_Flow12" sourceRef="W4953_Start5" targetRef="W4953_Task6" />
      <bpmn:sequenceFlow id="W4953_Flow13" sourceRef="W4953_Task6" targetRef="W4953_Task7" />
      <bpmn:sequenceFlow id="W4953_Flow14" sourceRef="W4953_Task7" targetRef="W4953_Task8" />
      <bpmn:sequenceFlow id="W4953_Flow15" sourceRef="W4953_Task8" targetRef="W4953_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4953_diag">
      <bpmndi:BPMNPlane id="W4953_plane" bpmnElement="W_W4953">
        <bpmndi:BPMNShape id="W4953_Lane1_di" bpmnElement="W4953_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4953_Lane2_di" bpmnElement="W4953_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4953_Lane3_di" bpmnElement="W4953_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4953_Task6_di" bpmnElement="W4953_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
