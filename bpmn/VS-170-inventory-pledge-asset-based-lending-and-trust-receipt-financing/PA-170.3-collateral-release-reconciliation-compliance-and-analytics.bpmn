        <bpmndi:BPMNShape id="W4954_Start3_di" bpmnElement="W4954_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4954_End7_di" bpmnElement="W4954_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4954_Annotation8_di" bpmnElement="W4954_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4954_Flow10_di" bpmnElement="W4954_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4954_Flow11_di" bpmnElement="W4954_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4954_Flow12_di" bpmnElement="W4954_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4954_Flow13_di" bpmnElement="W4954_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4954_Assoc9_di" bpmnElement="W4954_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4955" name="W4955. PFRS Encumbrance Disclosure, PAS 37 / Contingent-Liability Reporting &amp; Note Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Period close (VS-17.1); external reporting; audit (VS-21)
Frequency: Quarterly + annual
Volume: ~1 borrowing-base disclosure per facility × 1–3 facilities × 5 entities
Owner: Controller / ABL &amp; Collateral Operations Manager / Finance
Participants: Finance (VS-17), Treasury (VS-18), Legal (VS-100), External Audit (VS-21)
Source: workflow W4955 — PFRS Encumbrance Disclosure, PAS 37 / Contingent-Liability Reporting &amp; Note Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W4955_LaneSet2">
        <bpmn:lane id="W4955_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4955_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4955_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4955_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4955_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4955_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4955_Start3" name="Period close (VS-17.1); external reporting; audit (VS-21)">
        <bpmn:outgoing>W4955_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4955_Task4" name="Prepare the PFRS encumbrance/borrowing disclosure: the carrying amount and…">
        <bpmn:documentation>Step 1: Prepare the PFRS encumbrance/borrowing disclosure: the carrying amount and classification of borrowings (current/non-current), the encumbered inventory/AR (carrying amount and nature of encumbrance — pledge/trust/warehouse-receipt), the facility terms/availability, and contingent liabilities (guarantees W325, cross-entity) per PFRS/PAS disclosure requirements
Responsible (R): Finance / Controller / Treasury
Accountable (A): CFO / Controller
Duration: Quarterly + annual</bpmn:documentation>
        <bpmn:incoming>W4955_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4955_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4955_Task5" name="Reconcile to the ledger &amp; facility: tie disclosure to the GL (VS-17), the…">
        <bpmn:documentation>Step 2: Reconcile to the ledger &amp; facility: tie disclosure to the GL (VS-17), the borrowing base (W4939), the security register (W4951), and the contingent-liability register (W325); ensure the notes reconcile to the face of the statements
Responsible (R): Finance / Treasury / Legal
Accountable (A): Controller
Duration: Quarterly + annual</bpmn:documentation>
        <bpmn:incoming>W4955_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4955_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4955_Task6" name="Support external audit (VS-21): provide the disclosure workpapers, facility…">
        <bpmn:documentation>Step 3: Support external audit (VS-21): provide the disclosure workpapers, facility agreements, security/perfection evidence (W4951), and reconciliations; manage audit findings; and submit the audited statements to the bank (covenant W4944)
Responsible (R): Finance / External Audit / Legal
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4955_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4955_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4955_End7" name="Complete">
        <bpmn:incoming>W4955_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4955_Annotation8">
        <bpmn:text>Controls: - CTL-742 (ensure controlled execution — Collateral Release, Reconciliation, Compliance &amp; Analytics (PA-170.3).) | - CTL-742 (disclosure reconciles to GL/security register; notes reconcile to statements; contingent liabilities complete; audited (VS-21))
Owner: Controller / ABL &amp; Collateral Operations Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4955_Assoc9" sourceRef="W4955_Annotation8" targetRef="W4955_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4955_Flow10" sourceRef="W4955_Start3" targetRef="W4955_Task4" />
      <bpmn:sequenceFlow id="W4955_Flow11" sourceRef="W4955_Task4" targetRef="W4955_Task5" />
      <bpmn:sequenceFlow id="W4955_Flow12" sourceRef="W4955_Task5" targetRef="W4955_Task6" />
      <bpmn:sequenceFlow id="W4955_Flow13" sourceRef="W4955_Task6" targetRef="W4955_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4955_diag">
      <bpmndi:BPMNPlane id="W4955_plane" bpmnElement="W_W4955">
        <bpmndi:BPMNShape id="W4955_Lane1_di" bpmnElement="W4955_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_Task4_di" bpmnElement="W4955_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_Task5_di" bpmnElement="W4955_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_Task6_di" bpmnElement="W4955_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_Start3_di" bpmnElement="W4955_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_End7_di" bpmnElement="W4955_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4955_Annotation8_di" bpmnElement="W4955_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4955_Flow10_di" bpmnElement="W4955_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4955_Flow11_di" bpmnElement="W4955_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4955_Flow12_di" bpmnElement="W4955_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4955_Flow13_di" bpmnElement="W4955_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4955_Assoc9_di" bpmnElement="W4955_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4956" name="W4956. Financing-Cost, Effective-Rate &amp; Capital-Structure Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic review; refinance decision (W4937); strategic review (VS-33)
Frequency: Monthly + quarterly deep-dive
Volume: ~1 analytics program across 1–3 facilities
Owner: Treasury / ABL &amp; Collateral Operations Manager / FP&amp;A
Participants: Treasury (VS-18), Finance/FP&amp;A (VS-17.4/VS-33), Data (VS-28)
Source: workflow W4956 — Financing-Cost, Effective-Rate &amp; Capital-Structure Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4956_LaneSet3">
        <bpmn:lane id="W4956_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W4956_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4956_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4956_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4956_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W4956_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4956_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4956_Start4" name="Periodic review; refinance decision (W4937); strategic review (VS-33)">
        <bpmn:outgoing>W4956_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4956_Task5" name="Compute financing cost &amp; effective rate: the all-in cost (interest margin…">
        <bpmn:documentation>Step 1: Compute financing cost &amp; effective rate: the all-in cost (interest margin, commitment fee, utilization fee, field-exam fees, collateral-manager fees, bank charges W4959) against drawn/undrawn, the effective rate per facility and blended, and the cost-vs-WACC/benchmark comparison
Responsible (R): Treasury / FP&amp;A / Analytics
Accountable (A): Treasurer / CFO
Duration: Monthly + quarterly</bpmn:documentation>
        <bpmn:incoming>W4956_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4956_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4956_Task6" name="Analyze capital structure &amp; cost-of-capital: the debt/equity mix, the…">
        <bpmn:documentation>Step 2: Analyze capital structure &amp; cost-of-capital: the debt/equity mix, the collateralized vs uncollateralized split, the cost-of-debt impact on EBITDA/net-income, the working-capital-freed value, and the optimal facility/utilization profile (links VS-105 SCF, VS-18.2 cash)
Responsible (R): FP&amp;A / Treasury / Analytics
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4956_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4956_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4956_Task7" name="Recommend optimization: refinance/resize/restructure recommendations, the…">
        <bpmn:documentation>Step 3: Recommend optimization: refinance/resize/restructure recommendations, the SCF-vs-ABL-vs-TR trade-off, advance-rate/eligibility improvements, and feed strategy (W4937) and the board/finance committee (VS-36/VS-33)
Responsible (R): Treasury / FP&amp;A / Strategy
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4956_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4956_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4956_End8" name="Complete">
        <bpmn:incoming>W4956_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4956_Annotation9">
        <bpmn:text>Controls: - CTL-742 (ensure controlled execution — Collateral Release, Reconciliation, Compliance &amp; Analytics (PA-170.3).) | - CTL-742: financing cost reconciled to bank charges (W4959); effective-rate documented; optimization recommendations reviewed by CFO
Owner: Treasury / ABL &amp; Collateral Operations Manager / FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
