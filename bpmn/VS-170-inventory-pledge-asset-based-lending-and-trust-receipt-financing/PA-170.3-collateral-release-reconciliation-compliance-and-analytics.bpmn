      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4954" name="W4954. Borrowing-Base to Inventory/AR Subledger Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Each borrowing-base cycle (W4939); close (VS-17.1); field exam (W4943)
Frequency: Monthly (+ event-driven)
Volume: ~2–4 reconciliations per facility per cycle × 1–3 facilities
Owner: ABL &amp; Collateral Operations Manager / Finance / Controller
Participants: Finance (VS-17), Inventory (VS-05), AR (VS-16), Treasury (VS-18), Data (VS-28)
Source: workflow W4954 — Borrowing-Base to Inventory/AR Subledger Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W4954_LaneSet2">
        <bpmn:lane id="W4954_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4954_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4954_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4954_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4954_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4954_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4954_Start3" name="Each borrowing-base cycle (W4939); close (VS-17.1); field exam (W4943)">
        <bpmn:outgoing>W4954_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4954_Task4" name="Reconcile the borrowing base to the subledgers: tie eligible inventory (W4940)…">
        <bpmn:documentation>Step 1: Reconcile the borrowing base to the subledgers: tie eligible inventory (W4940) to the inventory subledger/GL, eligible AR (W4941) to the AR subledger, identify and explain variances (timing, ineligibles, reserves, shrink), and document the reconciliation
Responsible (R): Finance / Inventory / AR / Analytics
Accountable (A): Controller / ABL Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4954_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4954_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4954_Task5" name="Investigate &amp; resolve variances: root-cause variances (data quality VS-29…">
        <bpmn:documentation>Step 2: Investigate &amp; resolve variances: root-cause variances (data quality VS-29, posting timing, status errors), correct the data/process, and document for the certificate (W4939) and audit (W4943/W4958)
Responsible (R): Finance / Inventory / AR / IT
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4954_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4954_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4954_Task6" name="Govern data quality for the borrowing base: the inventory accuracy target…">
        <bpmn:documentation>Step 3: Govern data quality for the borrowing base: the inventory accuracy target (≥97%), AR aging integrity, master-data quality (VS-29), and the controls that prevent recurrence; report to management and the bank
Responsible (R): Finance / Data Governance / Analytics
Accountable (A): Controller
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4954_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4954_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4954_End7" name="Complete">
        <bpmn:incoming>W4954_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4954_Annotation8">
        <bpmn:text>Controls: - CTL-742 (ensure controlled execution — Collateral Release, Reconciliation, Compliance &amp; Analytics (PA-170.3).) | - CTL-742: monthly reconciliation; variances investigated &amp; resolved; ≥97% inventory accuracy; master-data governed
Owner: ABL &amp; Collateral Operations Manager / Finance / Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4954_Assoc9" sourceRef="W4954_Annotation8" targetRef="W4954_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4954_Flow10" sourceRef="W4954_Start3" targetRef="W4954_Task4" />
      <bpmn:sequenceFlow id="W4954_Flow11" sourceRef="W4954_Task4" targetRef="W4954_Task5" />
      <bpmn:sequenceFlow id="W4954_Flow12" sourceRef="W4954_Task5" targetRef="W4954_Task6" />
      <bpmn:sequenceFlow id="W4954_Flow13" sourceRef="W4954_Task6" targetRef="W4954_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4954_diag">
      <bpmndi:BPMNPlane id="W4954_plane" bpmnElement="W_W4954">
        <bpmndi:BPMNShape id="W4954_Lane1_di" bpmnElement="W4954_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4954_Task4_di" bpmnElement="W4954_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
