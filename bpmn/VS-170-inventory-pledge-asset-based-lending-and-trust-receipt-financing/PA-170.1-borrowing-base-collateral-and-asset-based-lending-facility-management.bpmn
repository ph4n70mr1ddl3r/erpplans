        <bpmndi:BPMNShape id="W4938_Annotation9_di" bpmnElement="W4938_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4938_Flow11_di" bpmnElement="W4938_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4938_Flow12_di" bpmnElement="W4938_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4938_Flow13_di" bpmnElement="W4938_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4938_Flow14_di" bpmnElement="W4938_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4938_Assoc10_di" bpmnElement="W4938_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4939" name="W4939. Borrowing-Base Certificate Preparation &amp; Periodic Submission" isExecutable="false">
      <bpmn:documentation>Trigger: Reporting cadence (monthly/weekly at higher utilization); period close (VS-17.1 W9A)
Frequency: Monthly (+ weekly at elevated utilization per agreement)
Volume: 1 certificate per facility per period × 1–3 facilities
Owner: ABL &amp; Collateral Operations Manager / Finance
Participants: Finance/Accounting (VS-17), Treasury (VS-18), Inventory (VS-05), AR (VS-16), Legal (VS-100)
Source: workflow W4939 — Borrowing-Base Certificate Preparation &amp; Periodic Submission</bpmn:documentation>
      <bpmn:laneSet id="W4939_LaneSet3">
        <bpmn:lane id="W4939_Lane1" name="ABL Manager">
        <bpmn:flowNodeRef>W4939_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4939_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4939_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4939_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4939_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4939_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4939_Start4" name="Reporting cadence (monthly/weekly at higher utilization); period close (VS-17.1 W9A)">
        <bpmn:outgoing>W4939_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4939_Task5" name="Prepare the borrowing-base certificate from period-close data: eligible…">
        <bpmn:documentation>Step 1: Prepare the borrowing-base certificate from period-close data: eligible inventory at cost (lower of cost/NRV per VS-17 W9) by category/location, eligible AR net of allowances (VS-16 W81), apply advance rates and reserves (W4938), compute availability, and reconcile to the GL and the inventory/AR subledgers
Responsible (R): ABL Manager / Accounting / Finance
Accountable (A): Treasurer / Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4939_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4939_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4939_Task6" name="Review, certify &amp; sign: finance review, the designated officer certification…">
        <bpmn:documentation>Step 2: Review, certify &amp; sign: finance review, the designated officer certification (representation of accuracy), the ineligibles/reserve schedule, and any required supporting detail (aging, location roll-forward); secure Legal sign-off on any representation language
Responsible (R): Finance / Treasurer / Legal / Controller
Accountable (A): CFO / Treasurer
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4939_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4939_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4939_Task7" name="Submit to the bank/agent, post to the bank portal, record the certificate in…">
        <bpmn:documentation>Step 3: Submit to the bank/agent, post to the bank portal, record the certificate in the facility file, and update availability monitoring (W4942); manage any bank follow-up questions and corrections
Responsible (R): ABL Manager / Treasury / Finance
Accountable (A): Treasurer
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4939_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4939_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4939_End8" name="Complete">
        <bpmn:incoming>W4939_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4939_Annotation9">
        <bpmn:text>Controls: - CTL-116 (ensure borrowing-base &amp; covenant compliance.) | - CTL-740: certificate reconciles to GL/subledgers; eligibility auto-tested (W4940/W4941); officer-certified; submitted on time; bank queries logged
Owner: ABL &amp; Collateral Operations Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4939_Assoc10" sourceRef="W4939_Annotation9" targetRef="W4939_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4939_Flow11" sourceRef="W4939_Start4" targetRef="W4939_Task5" />
      <bpmn:sequenceFlow id="W4939_Flow12" sourceRef="W4939_Task5" targetRef="W4939_Task6" />
      <bpmn:sequenceFlow id="W4939_Flow13" sourceRef="W4939_Task6" targetRef="W4939_Task7" />
      <bpmn:sequenceFlow id="W4939_Flow14" sourceRef="W4939_Task7" targetRef="W4939_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4939_diag">
      <bpmndi:BPMNPlane id="W4939_plane" bpmnElement="W_W4939">
        <bpmndi:BPMNShape id="W4939_Lane1_di" bpmnElement="W4939_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Lane2_di" bpmnElement="W4939_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Task5_di" bpmnElement="W4939_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Task6_di" bpmnElement="W4939_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Task7_di" bpmnElement="W4939_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Start4_di" bpmnElement="W4939_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_End8_di" bpmnElement="W4939_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4939_Annotation9_di" bpmnElement="W4939_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4939_Flow11_di" bpmnElement="W4939_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4939_Flow12_di" bpmnElement="W4939_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4939_Flow13_di" bpmnElement="W4939_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4939_Flow14_di" bpmnElement="W4939_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4939_Assoc10_di" bpmnElement="W4939_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
