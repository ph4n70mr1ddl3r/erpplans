      <bpmn:sequenceFlow id="W4942_Flow13" sourceRef="W4942_Task6" targetRef="W4942_Task7" />
      <bpmn:sequenceFlow id="W4942_Flow14" sourceRef="W4942_Task7" targetRef="W4942_End8" />
    </bpmn:process>
