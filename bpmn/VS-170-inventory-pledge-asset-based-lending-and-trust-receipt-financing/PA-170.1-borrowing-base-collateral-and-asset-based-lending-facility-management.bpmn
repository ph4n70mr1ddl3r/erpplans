    <bpmn:process id="W_W4944" name="W4944. Covenant Monitoring, Facility Reporting &amp; Multi-Entity Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Covenant calendar (W4937); reporting cadence; entity/facility change
Frequency: Quarterly covenant test + monthly reporting
Volume: Financial + reporting covenants × 1–3 facilities × 5 entities
Owner: Treasurer / ABL &amp; Collateral Operations Manager / Controller
Participants: Finance (VS-17), Treasury (VS-18), Legal (VS-100), Shared Services (VS-72), Internal Audit (VS-21)
Source: workflow W4944 — Covenant Monitoring, Facility Reporting &amp; Multi-Entity Governance</bpmn:documentation>
      <bpmn:laneSet id="W4944_LaneSet3">
        <bpmn:lane id="W4944_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4944_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4944_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4944_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4944_Lane2" name="Treasurer">
        <bpmn:flowNodeRef>W4944_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4944_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4944_Start4" name="Covenant calendar (W4937); reporting cadence; entity/facility change">
        <bpmn:outgoing>W4944_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4944_Task5" name="Monitor covenants per the calendar (W4937/W319): financial covenants (leverage…">
        <bpmn:documentation>Step 1: Monitor covenants per the calendar (W4937/W319): financial covenants (leverage, interest cover, minimum-availability, net-worth), reporting covenants (certificate cadence W4939, audited statements, compliance certificate), test against period results (VS-17.1 W9A/W9B), and alert on headroom/breach
Responsible (R): Finance / Treasurer / ABL Manager
Accountable (A): CFO
Duration: Quarterly + monthly</bpmn:documentation>
        <bpmn:incoming>W4944_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4944_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4944_Task6" name="Manage facility reporting: monthly/quarterly compliance certificate…">
        <bpmn:documentation>Step 2: Manage facility reporting: monthly/quarterly compliance certificate, borrowing-base certificate (W4939), financial statements, and ad-hoc bank requests; secure officer certification and Legal review
Responsible (R): Finance / Controller / Legal
Accountable (A): CFO / Treasurer
Duration: Monthly + quarterly</bpmn:documentation>
        <bpmn:incoming>W4944_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4944_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4944_Task7" name="Govern multi-entity (VS-72): the cross-entity guarantor structure, intercompany…">
        <bpmn:documentation>Step 3: Govern multi-entity (VS-72): the cross-entity guarantor structure, intercompany sub-limit and downstream guarantees, the consolidated compliance view across the 5 entities, and the legal-entity-level facility allocation; manage waivers/amendments with the bank via Legal (VS-100)
Responsible (R): Treasurer / Legal / Shared Services / Finance
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4944_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4944_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4944_End8" name="Complete">
        <bpmn:incoming>W4944_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4944_Annotation9">
        <bpmn:text>Controls: - CTL-116 (ensure borrowing-base &amp; covenant compliance.) | - CTL-740: covenant calendar maintained; headroom monitored; compliance certificate officer-certified; intercompany sub-limits tracked; waivers documented
Owner: Treasurer / ABL &amp; Collateral Operations Manager / Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4944_Assoc10" sourceRef="W4944_Annotation9" targetRef="W4944_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4944_Flow11" sourceRef="W4944_Start4" targetRef="W4944_Task5" />
      <bpmn:sequenceFlow id="W4944_Flow12" sourceRef="W4944_Task5" targetRef="W4944_Task6" />
      <bpmn:sequenceFlow id="W4944_Flow13" sourceRef="W4944_Task6" targetRef="W4944_Task7" />
      <bpmn:sequenceFlow id="W4944_Flow14" sourceRef="W4944_Task7" targetRef="W4944_End8" />
    </bpmn:process>
