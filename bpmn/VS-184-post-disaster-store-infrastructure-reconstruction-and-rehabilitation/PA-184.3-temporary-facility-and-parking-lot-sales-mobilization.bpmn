    <bpmn:process id="W_W5290" name="W5290. Mobile POS Terminal Routing and Network Activation" isExecutable="false">
      <bpmn:documentation>Trigger: Temporary office structure setup (W5289)
Frequency: Per temporary site activation
Volume: ~1-2 activations annually
Owner: IT Field Support Engineer
Participants: Store Manager, Network Analyst, Security Analyst
Source: workflow W5290 — Mobile POS Terminal Routing and Network Activation</bpmn:documentation>
