      <bpmn:userTask id="W5290_Task6" name="Deploy mobile POS terminal units, receipt printers, and barcode scanners to…">
        <bpmn:documentation>Step 1: Deploy mobile POS terminal units, receipt printers, and barcode scanners to site.
Responsible (R): IT Field Support Engineer
Accountable (A): IT Field Support Engineer
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5290_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5290_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5290_Task7" name="Establish secure network tunnel via dual cellular LTE/5G SIM routers.">
        <bpmn:documentation>Step 2: Establish secure network tunnel via dual cellular LTE/5G SIM routers.
Responsible (R): IT Field Support Engineer
Accountable (A): IT Field Support Engineer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5290_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5290_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5290_Task8" name="Verify POS software transactions processing, receipt printing, and e-wallet…">
        <bpmn:documentation>Step 3: Verify POS software transactions processing, receipt printing, and e-wallet connectivity.
Responsible (R): Store Manager
Accountable (A): IT Field Support Engineer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5290_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5290_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5290_Task9" name="Audit security logs ensuring terminal transactions encryption.">
        <bpmn:documentation>Step 4: Audit security logs ensuring terminal transactions encryption.
Responsible (R): Network Analyst
Accountable (A): IT Field Support Engineer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5290_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5290_Flow17</bpmn:outgoing>
      </bpmn:userTask>
