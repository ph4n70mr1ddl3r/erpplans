Responsible (R): Store Manager
Accountable (A): Facilities Coordinator / Store Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5289_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5289_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5289_Task7" name="Mobilize mobile office containers (typically 20-foot shipping container…">
        <bpmn:documentation>Step 2: Mobilize mobile office containers (typically 20-foot shipping container offices).
Responsible (R): Construction Contractor
Accountable (A): Facilities Coordinator / Store Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5289_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5289_Flow15</bpmn:outgoing>
      </bpmn:userTask>
