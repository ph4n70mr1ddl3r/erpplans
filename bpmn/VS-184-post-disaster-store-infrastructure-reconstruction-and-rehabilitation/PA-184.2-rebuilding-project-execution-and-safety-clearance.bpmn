    <bpmn:process id="W_W5282" name="W5282. Fast-Track Construction Contractor Vetting and Procurement SLA" isExecutable="false">
      <bpmn:documentation>Trigger: Approved rebuild budget (W5281)
Frequency: Per rebuilding project
Volume: ~2-3 contracts executed annually
Owner: Procurement Specialist
Participants: Director, Facilities &amp; Real Estate, Contractor Account Manager, VP Legal (VS-100)
Source: workflow W5282 — Fast-Track Construction Contractor Vetting and Procurement SLA</bpmn:documentation>
      <bpmn:laneSet id="W5282_LaneSet3">
        <bpmn:lane id="W5282_Lane1" name="Procurement Specialist">
        <bpmn:flowNodeRef>W5282_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5282_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5282_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5282_Start4</bpmn:flowNodeRef>
