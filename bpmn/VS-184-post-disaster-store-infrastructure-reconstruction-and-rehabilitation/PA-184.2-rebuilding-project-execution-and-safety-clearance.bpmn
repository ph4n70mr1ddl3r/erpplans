Responsible (R): Project Manager / Construction PMO Leader
Accountable (A): Project Manager / Construction PMO Leader
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5283_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5283_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5283_End9" name="Complete">
        <bpmn:incoming>W5283_Flow16</bpmn:incoming>
