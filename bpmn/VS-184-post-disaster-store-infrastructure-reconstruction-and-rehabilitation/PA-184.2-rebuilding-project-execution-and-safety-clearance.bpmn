Responsible (R): Contractor Site Manager
Accountable (A): Project Manager / Construction PMO Leader
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5283_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5283_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5283_Task8" name="Update project dashboard and share access with Regional Managers.">
