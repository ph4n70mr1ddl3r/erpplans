    <bpmn:process id="W_W5283" name="W5283. Site Reconstruction PMO Activation and Schedule Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Signed contractor agreement (W5282)
Frequency: Per project activation
Volume: ~2-3 PMO activations annually
Owner: Project Manager / Construction PMO Leader
Participants: Contractor Site Manager, Store Manager, Facilities Coordinator
Source: workflow W5283 — Site Reconstruction PMO Activation and Schedule Coordination</bpmn:documentation>
      <bpmn:laneSet id="W5283_LaneSet3">
        <bpmn:lane id="W5283_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W5283_Task5</bpmn:flowNodeRef>
