        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5282_Start4" name="Approved rebuild budget (W5281)">
        <bpmn:outgoing>W5282_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5282_Task5" name="Vet candidate contractors for valid PCAB licensing, insurance coverages, and…">
        <bpmn:documentation>Step 1: Vet candidate contractors for valid PCAB licensing, insurance coverages, and project capacity.
Responsible (R): Procurement Specialist
Accountable (A): Procurement Specialist
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5282_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5282_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5282_Task6" name="Draft fast-track construction agreement incorporating milestones, safety…">
        <bpmn:documentation>Step 2: Draft fast-track construction agreement incorporating milestones, safety penalties, and payment terms.
Responsible (R): Procurement Specialist
Accountable (A): Procurement Specialist
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5282_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5282_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5282_Task7" name="Review contractor bonding and bank guarantee requirements per VS-116.">
        <bpmn:documentation>Step 3: Review contractor bonding and bank guarantee requirements per VS-116.
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): Procurement Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5282_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5282_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5282_Task8" name="Execute contract signing and register contractor in vendor database.">
        <bpmn:documentation>Step 4: Execute contract signing and register contractor in vendor database.
Responsible (R): Procurement Specialist
Accountable (A): Procurement Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5282_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5282_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5282_End9" name="Complete">
        <bpmn:incoming>W5282_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5282_Annotation10">
        <bpmn:text>Controls: - CTL-06: Prevent unauthorized vendor onboarding; Director approval on procurement agreements.
Owner: Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
