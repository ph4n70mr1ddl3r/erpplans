Accountable (A): Project Manager / Construction PMO Leader
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5283_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5283_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5283_Task6" name="Conduct site kick-off meeting defining milestones (demolition, structure…">
