    <bpmn:process id="W_W5281" name="W5281. Post-Disaster Rebuilding CAPA Budget Approval and Financing Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Approved BOQ (W5275) and insurance clearance (W5278)
Frequency: Per approved reconstruction project
Volume: ~2-3 budgets set up annually
Owner: Finance Controller
Participants: Director, Facilities &amp; Real Estate, CFO, Budget Analyst (VS-33.1)
Source: workflow W5281 — Post-Disaster Rebuilding CAPA Budget Approval and Financing Setup</bpmn:documentation>
      <bpmn:laneSet id="W5281_LaneSet4">
        <bpmn:lane id="W5281_Lane1" name="Director, Facilities &amp; Real Estate">
        <bpmn:flowNodeRef>W5281_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5281_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5281_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W5281_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5281_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5281_Lane3" name="Budget Analyst">
        <bpmn:flowNodeRef>W5281_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5281_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5281_Start5" name="Approved BOQ (W5275) and insurance clearance (W5278)">
        <bpmn:outgoing>W5281_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5281_Task6" name="Compile reconstruction budget request: BOQ, contractor estimates, permit fees…">
        <bpmn:documentation>Step 1: Compile reconstruction budget request: BOQ, contractor estimates, permit fees, contingency buffer.
Responsible (R): Director, Facilities &amp; Real Estate
Accountable (A): Finance Controller
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5281_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5281_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5281_Task7" name="Verify funding source allocation: insurance recovery offsets vs. corporate…">
        <bpmn:documentation>Step 2: Verify funding source allocation: insurance recovery offsets vs. corporate CAPEX cash.
Responsible (R): Finance Controller
Accountable (A): Finance Controller
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5281_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5281_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5281_Task8" name="Review budget against corporate performance metrics and annual plans.">
        <bpmn:documentation>Step 3: Review budget against corporate performance metrics and annual plans.
Responsible (R): Budget Analyst
Accountable (A): Finance Controller
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5281_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5281_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5281_Task9" name="Release approved project budget in ERP and initialize project code.">
        <bpmn:documentation>Step 4: Release approved project budget in ERP and initialize project code.
Responsible (R): Finance Controller
Accountable (A): Finance Controller
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5281_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5281_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5281_End10" name="Complete">
        <bpmn:incoming>W5281_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5281_Annotation11">
        <bpmn:text>Controls: - CTL-02: Capex authorization limits; Board approval required for rebuilds &gt; PHP 50M.
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
