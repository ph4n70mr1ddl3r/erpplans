      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4619" name="W4619. AML/KYC Monitoring, Suspicious-Transaction Reporting &amp; Sanctions" isExecutable="false">
      <bpmn:documentation>Trigger: AML threshold; suspicious pattern; sanctions check
Frequency: Continuous + per report
Volume: AML/KYC monitoring across VAS (high-AML remittance/e-money)
Owner: AML (VS-86) / Compliance (VS-22)
Participants: Counter Staff, Principals (W4603), Legal (VS-100.3), Audit (VS-21), AMLC
Source: workflow W4619 — AML/KYC Monitoring, Suspicious-Transaction Reporting &amp; Sanctions</bpmn:documentation>
      <bpmn:laneSet id="W4619_LaneSet3">
        <bpmn:lane id="W4619_Lane1" name="AML">
        <bpmn:flowNodeRef>W4619_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4619_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4619_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4619_Lane2" name="Audit">
        <bpmn:flowNodeRef>W4619_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4619_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4619_Start4" name="AML threshold; suspicious pattern; sanctions check">
        <bpmn:outgoing>W4619_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4619_Task5" name="AML/Compliance monitor VAS transactions for suspicious patterns…">
        <bpmn:documentation>Step 1: AML/Compliance monitor VAS transactions for suspicious patterns (structuring/smurfing, rapid cash-in/out, high-risk geographies) as agent, per VS-86 and principal program
Responsible (R): AML / Compliance / Data
Accountable (A): Compliance Officer (BSA/AMLA)
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4619_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4619_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4619_Task6" name="AML/Compliance screen for sanctions/watchlist (customer name/ID), and file…">
        <bpmn:documentation>Step 2: AML/Compliance screen for sanctions/watchlist (customer name/ID), and file suspicious-transaction reports (STR) to AMLC per the principal&#x27;s BSP program (VS-86)
Responsible (R): AML / Compliance
Accountable (A): Compliance Officer
Duration: Per report</bpmn:documentation>
        <bpmn:incoming>W4619_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4619_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4619_Task7" name="Audit/Legal ensure AML/KYC agent compliance (records, training, reporting)…">
        <bpmn:documentation>Step 3: Audit/Legal ensure AML/KYC agent compliance (records, training, reporting), coordinate with principals, and report AML posture to the board (VS-36)
Responsible (R): Audit / Legal / Compliance
Accountable (A): VP Legal / Board
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4619_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4619_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4619_End8" name="Complete">
        <bpmn:incoming>W4619_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4619_Annotation9">
        <bpmn:text>Controls: - CTL-93 (ensure VAS agency cash &amp; BSP compliance.) | - CTL-700: AML/KYC monitored as agent (VS-86); sanctions screened; STRs filed to AMLC; agent compliance documented
Owner: AML (VS-86) / Compliance (VS-22)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4619_Assoc10" sourceRef="W4619_Annotation9" targetRef="W4619_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4619_Flow11" sourceRef="W4619_Start4" targetRef="W4619_Task5" />
      <bpmn:sequenceFlow id="W4619_Flow12" sourceRef="W4619_Task5" targetRef="W4619_Task6" />
      <bpmn:sequenceFlow id="W4619_Flow13" sourceRef="W4619_Task6" targetRef="W4619_Task7" />
      <bpmn:sequenceFlow id="W4619_Flow14" sourceRef="W4619_Task7" targetRef="W4619_End8" />
    </bpmn:process>
