    <bpmn:process id="W_W4620" name="W4620. BSP &amp; Regulatory Reporting, Cash-Transaction Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory cycle; threshold transaction; BSP request
Frequency: Periodic + on threshold
Volume: BSP/regulatory reporting across VAS
Owner: Compliance (VS-22) / Finance (VS-17) / Tax (VS-79)
Participants: AML (VS-86), Principals (W4602–W4604), Legal (VS-100.3), Audit (VS-21)
Source: workflow W4620 — BSP &amp; Regulatory Reporting, Cash-Transaction Reporting</bpmn:documentation>
      <bpmn:laneSet id="W4620_LaneSet3">
        <bpmn:lane id="W4620_Lane1" name="Compliance">
        <bpmn:flowNodeRef>W4620_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4620_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4620_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4620_Lane2" name="Audit">
        <bpmn:flowNodeRef>W4620_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4620_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4620_Start4" name="Regulatory cycle; threshold transaction; BSP request">
        <bpmn:outgoing>W4620_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4620_Task5" name="Compliance/Finance prepare VAS regulatory reporting (BSP agent reporting per…">
        <bpmn:documentation>Step 1: Compliance/Finance prepare VAS regulatory reporting (BSP agent reporting per principal program, cash-transaction/CTR thresholds, commission/tax VS-79), per VS-22
Responsible (R): Compliance / Finance / Tax
Accountable (A): VP Legal / CFO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4620_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4620_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4620_Task6" name="Compliance/Principals coordinate reporting (BuildRight agent data feeds to…">
        <bpmn:documentation>Step 2: Compliance/Principals coordinate reporting (BuildRight agent data feeds to principals for their BSP reporting), and manage BSP inquiries/examinations
Responsible (R): Compliance / Principals / Legal
Accountable (A): VP Legal
Duration: On inquiry</bpmn:documentation>
        <bpmn:incoming>W4620_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4620_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4620_Task7" name="Audit/Compliance ensure reporting accuracy/completeness, retain records…">
