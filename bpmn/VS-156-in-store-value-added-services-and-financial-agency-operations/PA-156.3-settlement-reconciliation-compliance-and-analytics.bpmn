    <bpmn:process id="W_W4617" name="W4617. Principal Settlement, Float &amp; Commission Management" isExecutable="false">
      <bpmn:documentation>Trigger: Settlement cycle (daily/weekly); commission accrual
Frequency: Per cycle (frequent)
Volume: Settlement/float/commission across principals
Owner: Finance (VS-17) / Treasury (VS-18)
Participants: Principals (W4602–W4604), Compliance (VS-22), Cash Mgmt (VS-08.2)
Source: workflow W4617 — Principal Settlement, Float &amp; Commission Management</bpmn:documentation>
      <bpmn:laneSet id="W4617_LaneSet3">
        <bpmn:lane id="W4617_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4617_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4617_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4617_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4617_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W4617_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4617_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4617_Start4" name="Settlement cycle (daily/weekly); commission accrual">
        <bpmn:outgoing>W4617_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4617_Task5" name="Finance/Principals reconcile VAS transactions to principal statements…">
        <bpmn:documentation>Step 1: Finance/Principals reconcile VAS transactions to principal statements (bills/remittance/e-money/load), and settle collected cash vs principal (net commission) per cycle
Responsible (R): Finance / Principals
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4617_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4617_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4617_Task6" name="Treasury/Finance manage the float/settlement account (VS-18), ensure cash is…">
        <bpmn:documentation>Step 2: Treasury/Finance manage the float/settlement account (VS-18), ensure cash is banked/settled timely (VS-81), and monitor float aging
Responsible (R): Treasury / Finance
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4617_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4617_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4617_Task7" name="Finance/Tax book commission revenue (VS-79 VAT/withholding), manage…">
        <bpmn:documentation>Step 3: Finance/Tax book commission revenue (VS-79 VAT/withholding), manage intercompany where applicable (VS-72), and report settlement/commission to the board (VS-36)
Responsible (R): Finance / Tax
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4617_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4617_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4617_End8" name="Complete">
        <bpmn:incoming>W4617_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4617_Annotation9">
        <bpmn:text>Controls: - CTL-93 (ensure VAS agency cash &amp; BSP compliance.) | - CTL-700: transactions reconciled to principal; float monitored/timely-settled (VS-18); commission tax-treated (VS-79); SoD
Owner: Finance (VS-17) / Treasury (VS-18)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4617_Assoc10" sourceRef="W4617_Annotation9" targetRef="W4617_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4617_Flow11" sourceRef="W4617_Start4" targetRef="W4617_Task5" />
      <bpmn:sequenceFlow id="W4617_Flow12" sourceRef="W4617_Task5" targetRef="W4617_Task6" />
      <bpmn:sequenceFlow id="W4617_Flow13" sourceRef="W4617_Task6" targetRef="W4617_Task7" />
      <bpmn:sequenceFlow id="W4617_Flow14" sourceRef="W4617_Task7" targetRef="W4617_End8" />
    </bpmn:process>
