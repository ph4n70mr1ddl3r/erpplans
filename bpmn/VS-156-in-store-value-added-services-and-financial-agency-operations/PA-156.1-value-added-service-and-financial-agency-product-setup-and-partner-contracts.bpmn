    <bpmn:process id="W_W4603" name="W4603. Remittance &amp; E-Money Principal/Partner Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4601); partner selection
Frequency: Per partner + ongoing
Volume: Remittance/e-money principal partner network
Owner: Commercial / Compliance (VS-22) / Procurement (VS-34)
Participants: Legal (VS-100.3), AML (VS-86), Treasury (VS-18), Risk (VS-21.2)
Source: workflow W4603 — Remittance &amp; E-Money Principal/Partner Selection</bpmn:documentation>
      <bpmn:laneSet id="W4603_LaneSet3">
        <bpmn:lane id="W4603_Lane1" name="Commercial">
        <bpmn:flowNodeRef>W4603_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4603_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4603_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4603_Lane2" name="Treasury">
