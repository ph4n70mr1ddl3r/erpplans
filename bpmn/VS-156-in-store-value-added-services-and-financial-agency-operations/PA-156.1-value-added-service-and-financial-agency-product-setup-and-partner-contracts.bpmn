        <bpmn:outgoing>W4603_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4603_Task5" name="Commercial/Compliance select the remittance/e-money principal (BSP-licensed…">
        <bpmn:documentation>Step 1: Commercial/Compliance select the remittance/e-money principal (BSP-licensed EMII/REM/EMO principal, e-money issuer — GCash/Maya partners), screened for licensure/solvency/AML program
Responsible (R): Commercial / Compliance / Risk
Accountable (A): COO / CFO / VP Legal
Duration: Per partner</bpmn:documentation>
        <bpmn:incoming>W4603_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4603_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4603_Task6" name="Commercial/Legal/AML contract the principal (cash-in/out agent terms…">
        <bpmn:documentation>Step 2: Commercial/Legal/AML contract the principal (cash-in/out agent terms, remittance terms, commission, float, AML/KYC obligations, liability), per VS-100.3/VS-86
Responsible (R): Commercial / Legal / AML
Accountable (A): COO / VP Legal
Duration: Per partner</bpmn:documentation>
        <bpmn:incoming>W4603_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4603_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4603_Task7" name="Treasury/Compliance set up the float/settlement arrangement (VS-18/W4617)…">
        <bpmn:documentation>Step 3: Treasury/Compliance set up the float/settlement arrangement (VS-18/W4617), manage AML/KYC as agent (VS-86/W4619), and monitor principal conduct/solvency
Responsible (R): Treasury / Compliance / AML
Accountable (A): CFO / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4603_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4603_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4603_End8" name="Complete">
        <bpmn:incoming>W4603_Flow14</bpmn:incoming>
      </bpmn:endEvent>
