    <bpmn:process id="W_W4609" name="W4609. Bills-Payment Counter Transaction Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer bills-payment request
Frequency: Per transaction (high frequency at target stores)
Volume: Bills-payment transactions across counters
Owner: Counter Staff / Store Ops (VS-07)
Participants: Cash Mgmt (VS-08.2), Aggregator (W4602), Compliance (VS-22)
Source: workflow W4609 — Bills-Payment Counter Transaction Processing</bpmn:documentation>
      <bpmn:laneSet id="W4609_LaneSet2">
        <bpmn:lane id="W4609_Lane1" name="Counter Staff">
        <bpmn:flowNodeRef>W4609_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4609_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4609_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4609_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4609_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4609_Start3" name="Customer bills-payment request">
        <bpmn:outgoing>W4609_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4609_Task4" name="Counter Staff process the bills-payment (select biller, enter…">
        <bpmn:documentation>Step 1: Counter Staff process the bills-payment (select biller, enter account/reference/amount, validate per aggregator W4602), collect cash, and confirm posting
Responsible (R): Counter Staff
Accountable (A): Store Manager / Counter Lead
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W4609_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4609_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4609_Task5" name="Counter Staff issue the official receipt/transaction record (BIR-compliant cash…">
        <bpmn:documentation>Step 2: Counter Staff issue the official receipt/transaction record (BIR-compliant cash receipt VS-79/W4620), and capture the transaction to the VAS system (W4608)
Responsible (R): Counter Staff / Cash Mgmt
Accountable (A): Store Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W4609_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4609_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4609_Task6" name="Counter Staff handle any posting exception/error (W4615), and reconcile cash to…">
        <bpmn:documentation>Step 3: Counter Staff handle any posting exception/error (W4615), and reconcile cash to transactions at end-of-day (W4613)
Responsible (R): Counter Staff / Cash Mgmt
Accountable (A): Store Manager
Duration: Per transaction/daily</bpmn:documentation>
        <bpmn:incoming>W4609_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4609_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4609_End7" name="Complete">
        <bpmn:incoming>W4609_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4609_Annotation8">
        <bpmn:text>Controls: - CTL-699 (ensure controlled execution — Counter Operations — Bills Payment, Remittance, E-Money &amp; Mobile Load (PA-156.2).) | - CTL-699: transaction validated before posting; BIR-receipt issued (VS-79); cash reconciled daily (SoD)
Owner: Counter Staff / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4609_Assoc9" sourceRef="W4609_Annotation8" targetRef="W4609_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4609_Flow10" sourceRef="W4609_Start3" targetRef="W4609_Task4" />
      <bpmn:sequenceFlow id="W4609_Flow11" sourceRef="W4609_Task4" targetRef="W4609_Task5" />
      <bpmn:sequenceFlow id="W4609_Flow12" sourceRef="W4609_Task5" targetRef="W4609_Task6" />
      <bpmn:sequenceFlow id="W4609_Flow13" sourceRef="W4609_Task6" targetRef="W4609_End7" />
    </bpmn:process>
