      <bpmn:sequenceFlow id="W4610_Flow11" sourceRef="W4610_Task4" targetRef="W4610_Task5" />
      <bpmn:sequenceFlow id="W4610_Flow12" sourceRef="W4610_Task5" targetRef="W4610_Task6" />
      <bpmn:sequenceFlow id="W4610_Flow13" sourceRef="W4610_Task6" targetRef="W4610_End7" />
    </bpmn:process>
