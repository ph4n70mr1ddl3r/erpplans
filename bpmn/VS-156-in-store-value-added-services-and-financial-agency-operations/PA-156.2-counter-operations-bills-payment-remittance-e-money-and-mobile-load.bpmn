    <bpmn:process id="W_W4611" name="W4611. E-Money Cash-In/Cash-Out Transaction Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer cash-in/out request
Frequency: Per transaction
Volume: E-money cash-in/out transactions across counters
Owner: Counter Staff / Store Ops (VS-07)
Participants: E-money principal (W4603), Cash Mgmt (VS-08.2), AML (VS-86)
Source: workflow W4611 — E-Money Cash-In/Cash-Out Transaction Processing</bpmn:documentation>
      <bpmn:laneSet id="W4611_LaneSet2">
        <bpmn:lane id="W4611_Lane1" name="Counter Staff">
        <bpmn:flowNodeRef>W4611_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4611_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4611_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4611_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4611_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4611_Start3" name="Customer cash-in/out request">
        <bpmn:outgoing>W4611_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4611_Task4" name="Counter Staff process cash-in (customer cash → e-money account credit) or…">
        <bpmn:documentation>Step 1: Counter Staff process cash-in (customer cash → e-money account credit) or cash-out (e-money debit → customer cash), with customer verification/mobile OTP, via principal (W4603)
Responsible (R): Counter Staff
Accountable (A): Store Manager / Counter Lead
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W4611_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4611_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4611_Task5" name="Counter Staff apply AML/threshold checks as agent (VS-86/W4619)…">
        <bpmn:documentation>Step 2: Counter Staff apply AML/threshold checks as agent (VS-86/W4619), collect/disperse cash, issue receipt, and capture to VAS system (W4608)
Responsible (R): Counter Staff / AML / Cash Mgmt
Accountable (A): Store Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W4611_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4611_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4611_Task6" name="Counter Staff/AML handle threshold exceptions (W4615/W4619), report suspicious…">
        <bpmn:documentation>Step 3: Counter Staff/AML handle threshold exceptions (W4615/W4619), report suspicious activity (VS-86), and reconcile cash (W4613)
Responsible (R): Counter Staff / AML / Cash Mgmt
Accountable (A): Store Manager / Compliance
Duration: Per transaction/daily</bpmn:documentation>
        <bpmn:incoming>W4611_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4611_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4611_End7" name="Complete">
        <bpmn:incoming>W4611_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4611_Annotation8">
        <bpmn:text>Controls: - CTL-699 (ensure controlled execution — Counter Operations — Bills Payment, Remittance, E-Money &amp; Mobile Load (PA-156.2).) | - CTL-699: customer verified (OTP/ID); AML thresholds/reporting as agent (VS-86/W4619); cash reconciled (SoD)
Owner: Counter Staff / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4611_Assoc9" sourceRef="W4611_Annotation8" targetRef="W4611_Start3" associationDirection="None" />
