<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-76.3-lgu-relationship-regulatory-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2686" name="W2686. LGU Official Relationship &amp; Engagement Management" isExecutable="false">
      <bpmn:documentation>Trigger: New LGU administration or periodic engagement
Frequency: Quarterly; election cycle renewal
Volume: ~205 locations across ~150 LGUs (per W54)
Owner: VP Legal
Participants: VP Legal, Store Managers, Regional Managers, Government Relations
Source: workflow W2686 — LGU Official Relationship &amp; Engagement Management</bpmn:documentation>
      <bpmn:laneSet id="W2686_LaneSet3">
        <bpmn:lane id="W2686_Lane1" name="VP Legal">
        <bpmn:flowNodeRef>W2686_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2686_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2686_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2686_Lane2" name="Store Managers">
        <bpmn:flowNodeRef>W2686_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2686_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2686_Start4" name="New LGU administration or periodic engagement">
        <bpmn:outgoing>W2686_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2686_Task5" name="VP Legal maintains the LGU relationship strategy: key officials per location…">
        <bpmn:documentation>Step 1: VP Legal maintains the LGU relationship strategy: key officials per location (mayor, councilors, BPLO head, fire marshal, barangay captains — the same contacts the W2673 barangay work engages at the lowest tier); tracks the 3-year local-election cycle that resets the official set; plans the engagement calendar
Responsible (R): VP Legal / Government Relations
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2686_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2686_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2686_Task6" name="Store Managers maintain the day-to-day relationships at barangay level (W2673)…">
        <bpmn:documentation>Step 2: Store Managers maintain the day-to-day relationships at barangay level (W2673); Regional Managers handle city/municipal level; Government Relations handles province and the ARTA (Anti-Red Tape Authority, RA 11032) interface for systemic friction
Responsible (R): Store Managers / Regional Managers
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2686_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2686_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2686_Task7" name="VP Legal conducts the post-election engagement cycle (every 3 years…">
        <bpmn:documentation>Step 3: VP Legal conducts the post-election engagement cycle (every 3 years, synchronized with the local-election cycle): meets newly-seated officials, introduces BuildRight&#x27;s footprint and economic contribution, renews the relationship baseline; obtains the updated official contact directory
Responsible (R): VP Legal
Accountable (A): CEO
Duration: Every 3 years</bpmn:documentation>
        <bpmn:incoming>W2686_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2686_End8" name="Complete">
        <bpmn:incoming>W2686_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2686_Annotation9">
        <bpmn:text>Controls: - CTL-459 (ensure controlled execution — LGU Relationship &amp; Regulatory Analytics (PA-76.3).) | - CTL-459 (ABC / anti-bribery — links to VS-86.3 / W159): all LGU engagement within the gift/sponsorship policy; operational: VS-132 conduct review during election periods
Owner: VP Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2686_Assoc10" sourceRef="W2686_Annotation9" targetRef="W2686_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2686_Flow11" sourceRef="W2686_Start4" targetRef="W2686_Task5" />
      <bpmn:sequenceFlow id="W2686_Flow12" sourceRef="W2686_Task5" targetRef="W2686_Task6" />
      <bpmn:sequenceFlow id="W2686_Flow13" sourceRef="W2686_Task6" targetRef="W2686_Task7" />
      <bpmn:sequenceFlow id="W2686_Flow14" sourceRef="W2686_Task7" targetRef="W2686_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2686_diag">
      <bpmndi:BPMNPlane id="W2686_plane" bpmnElement="W_W2686">
        <bpmndi:BPMNShape id="W2686_Lane1_di" bpmnElement="W2686_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
