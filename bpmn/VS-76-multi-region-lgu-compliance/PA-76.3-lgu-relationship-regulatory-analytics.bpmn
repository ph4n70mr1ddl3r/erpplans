    <bpmn:process id="W_W2688" name="W2688. LGU Regulatory Compliance Audit &amp; Gap Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit cycle
Frequency: Annual
Volume: ~205 locations
Owner: Internal Auditor
Participants: Internal Auditor, Legal Compliance Officer, VP Legal
Source: workflow W2688 — LGU Regulatory Compliance Audit &amp; Gap Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2688_LaneSet3">
        <bpmn:lane id="W2688_Lane1" name="Internal Auditor">
        <bpmn:flowNodeRef>W2688_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2688_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2688_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2688_Lane2" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2688_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2688_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2688_Start4" name="Annual audit cycle">
        <bpmn:outgoing>W2688_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2688_Task5" name="Internal Auditor conducts the annual LGU compliance audit at a risk-based…">
        <bpmn:documentation>Step 1: Internal Auditor conducts the annual LGU compliance audit at a risk-based sample of locations (20–30/year, weighted to high-cost/high-complexity LGUs and stores with prior findings): verifies permits are current and displayed (W2670–W2675), tax payments complete (W2678/W2679), DOLE postings present (W2681), fire-safety compliance (W2672)
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 2–3 weeks/year</bpmn:documentation>
        <bpmn:incoming>W2688_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2688_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2688_Task6" name="Auditor identifies gaps: expired permits, unpaid taxes, missing postings…">
        <bpmn:documentation>Step 2: Auditor identifies gaps: expired permits, unpaid taxes, missing postings, non-compliant signage, fire deficiencies; quantifies the penalty exposure for each; rates findings by severity (critical / major / minor)
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2688_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2688_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2688_Task7" name="Legal Compliance Officer implements corrections on a severity-based timeline…">
        <bpmn:documentation>Step 3: Legal Compliance Officer implements corrections on a severity-based timeline: critical within 7 days, major within 30 days, minor within 90 days; updates the underlying SOPs to prevent recurrence; tracks the improvement trend into the next cycle
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W2688_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2688_End8" name="Complete">
        <bpmn:incoming>W2688_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2688_Annotation9">
        <bpmn:text>Controls: - CTL-459 (ensure controlled execution — LGU Relationship &amp; Regulatory Analytics (PA-76.3).) | - operational: segregation-of-duties review — the auditor is independent of the Legal Compliance Officer who remediates; operational: Head of Internal Audit sign-off on the audit report
Owner: Internal Auditor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2688_Assoc10" sourceRef="W2688_Annotation9" targetRef="W2688_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2688_Flow11" sourceRef="W2688_Start4" targetRef="W2688_Task5" />
      <bpmn:sequenceFlow id="W2688_Flow12" sourceRef="W2688_Task5" targetRef="W2688_Task6" />
      <bpmn:sequenceFlow id="W2688_Flow13" sourceRef="W2688_Task6" targetRef="W2688_Task7" />
      <bpmn:sequenceFlow id="W2688_Flow14" sourceRef="W2688_Task7" targetRef="W2688_End8" />
    </bpmn:process>
