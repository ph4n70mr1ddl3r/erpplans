    <bpmn:process id="W_W2692" name="W2692. Store Closure LGU Regulatory Decommissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Store closure decision
Frequency: Per closure; ~1–2/year
Volume: ~1–2/year
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, VP Legal, Store Manager, LGU
Source: workflow W2692 — Store Closure LGU Regulatory Decommissioning</bpmn:documentation>
      <bpmn:laneSet id="W2692_LaneSet3">
        <bpmn:lane id="W2692_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2692_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2692_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2692_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2692_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W2692_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2692_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2692_Start4" name="Store closure decision">
        <bpmn:outgoing>W2692_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2692_Task5" name="Officer manages the regulatory decommissioning once the VS-59 closure decision…">
        <bpmn:documentation>Step 1: Officer manages the regulatory decommissioning once the VS-59 closure decision is made: LGU notification of closure, permit cancellation (mayor&#x27;s, FSIC, sanitary, sign), tax-clearance application, final LGU inspection, barangay notification, utilities disconnection, signage removal (links to W2674)
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: 2–3 months before closure</bpmn:documentation>
        <bpmn:incoming>W2692_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2692_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2692_Task6" name="Tax Accountant settles the final obligations: final local business tax…">
        <bpmn:documentation>Step 2: Tax Accountant settles the final obligations: final local business tax (prorated to the closure date per RA 7160), final real property tax, permit-fee reconciliations, obtains the LGU tax clearance certifying no outstanding liability
Responsible (R): Tax Accountant / Legal Compliance Officer
Accountable (A): Tax Manager
Duration: 1–2 months before closure</bpmn:documentation>
        <bpmn:incoming>W2692_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2692_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2692_Task7" name="Officer archives all LGU documentation for the closed location for 10 years per…">
        <bpmn:documentation>Step 3: Officer archives all LGU documentation for the closed location for 10 years per BIR/LGU record-retention requirements (links to VS-88 / W256 document retention, the 10-year TRAIN-law rule); ensures a clean exit without lingering LGU exposure
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Post-closure</bpmn:documentation>
        <bpmn:incoming>W2692_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2692_End8" name="Complete">
        <bpmn:incoming>W2692_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2692_Annotation9">
        <bpmn:text>Controls: - CTL-459 (ensure controlled execution — LGU Relationship &amp; Regulatory Analytics (PA-76.3).) | - operational: permit-status update to &quot;closed — decommissioned&quot; in the master; operational: VP Legal sign-off on the tax-clearance certifying clean exit
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2692_Assoc10" sourceRef="W2692_Annotation9" targetRef="W2692_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2692_Flow11" sourceRef="W2692_Start4" targetRef="W2692_Task5" />
      <bpmn:sequenceFlow id="W2692_Flow12" sourceRef="W2692_Task5" targetRef="W2692_Task6" />
      <bpmn:sequenceFlow id="W2692_Flow13" sourceRef="W2692_Task6" targetRef="W2692_Task7" />
      <bpmn:sequenceFlow id="W2692_Flow14" sourceRef="W2692_Task7" targetRef="W2692_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2692_diag">
      <bpmndi:BPMNPlane id="W2692_plane" bpmnElement="W_W2692">
        <bpmndi:BPMNShape id="W2692_Lane1_di" bpmnElement="W2692_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2692_Lane2_di" bpmnElement="W2692_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
