    <bpmn:process id="W_W2687" name="W2687. Multi-LGU Regulatory Cost Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Annual benchmarking cycle — Multi-LGU Regulatory Cost Benchmarking
Frequency: Annual
Volume: ~205 locations
Owner: Finance Analyst
Participants: Finance Analyst, Tax Manager, Finance Controller
Source: workflow W2687 — Multi-LGU Regulatory Cost Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W2687_LaneSet3">
        <bpmn:lane id="W2687_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2687_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2687_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2687_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2687_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2687_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2687_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2687_Start4" name="Annual benchmarking cycle — Multi-LGU Regulatory Cost Benchmarking">
        <bpmn:outgoing>W2687_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2687_Task5" name="Finance Analyst compiles the total regulatory cost per store: local business…">
        <bpmn:documentation>Step 1: Finance Analyst compiles the total regulatory cost per store: local business tax (W2678), real property tax (W2679), permit fees (W2670 suite), penalties incurred, compliance-staff time allocation; expresses each as % of the store&#x27;s revenue (a like-for-like comparison metric across high- and low-revenue stores)
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2687_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2687_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2687_Task6" name="Analyst benchmarks across the ~150 LGUs (per W54): most-expensive (Metro…">
        <bpmn:documentation>Step 2: Analyst benchmarks across the ~150 LGUs (per W54): most-expensive (Metro Manila, Cebu City), most-business-friendly (the LGUs offering tax holidays per W2689), penalty incidence; produces a cost heat map across the Philippine footprint
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2687_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2687_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2687_Task7" name="Finance Controller presents to COO and VP Strategy: the cost heat map…">
        <bpmn:documentation>Step 3: Finance Controller presents to COO and VP Strategy: the cost heat map influences new-store site selection (links to VS-20 / W116 site selection) and identifies LGUs where BuildRight should negotiate incentives (links to W2689)
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2687_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2687_End8" name="Complete">
        <bpmn:incoming>W2687_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2687_Annotation9">
        <bpmn:text>Controls: - CTL-459 (ensure controlled execution — LGU Relationship &amp; Regulatory Analytics (PA-76.3).) | - CTL-459 (tax-cost accuracy — links to VS-79 / W349 corporate tax &amp; statutory reporting audit); operational: Finance Controller sign-off on the benchmark before it feeds site-selection
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2687_Assoc10" sourceRef="W2687_Annotation9" targetRef="W2687_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2687_Flow11" sourceRef="W2687_Start4" targetRef="W2687_Task5" />
      <bpmn:sequenceFlow id="W2687_Flow12" sourceRef="W2687_Task5" targetRef="W2687_Task6" />
      <bpmn:sequenceFlow id="W2687_Flow13" sourceRef="W2687_Task6" targetRef="W2687_Task7" />
      <bpmn:sequenceFlow id="W2687_Flow14" sourceRef="W2687_Task7" targetRef="W2687_End8" />
    </bpmn:process>
