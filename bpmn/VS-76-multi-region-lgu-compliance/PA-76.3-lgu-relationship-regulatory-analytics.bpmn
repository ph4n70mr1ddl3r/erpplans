    <bpmn:process id="W_W2689" name="W2689. LGU Incentive &amp; Investment Promotion Evaluation" isExecutable="false">
      <bpmn:documentation>Trigger: New store site selection
Frequency: Per new store; 10–15/year
Volume: 10–15 new stores/year
Owner: COO
Participants: COO, Legal, Finance, VP Strategy
Source: workflow W2689 — LGU Incentive &amp; Investment Promotion Evaluation</bpmn:documentation>
      <bpmn:laneSet id="W2689_LaneSet4">
        <bpmn:lane id="W2689_Lane1" name="COO">
        <bpmn:flowNodeRef>W2689_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2689_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2689_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2689_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2689_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2689_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2689_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2689_Start5" name="New store site selection">
        <bpmn:outgoing>W2689_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2689_Task6" name="COO evaluates the LGU incentive package offered under the LGU&#x27;s Local…">
        <bpmn:documentation>Step 1: COO evaluates the LGU incentive package offered under the LGU&#x27;s Local Investment Code (authorized by RA 7160 §192): tax holidays (often 3–5 years on local business tax), reduced rates, fast-track permitting, infrastructure support, employment incentives (local-hire quotas); compares across the candidate locations
Responsible (R): COO / Legal
Accountable (A): CEO
Duration: Per site selection</bpmn:documentation>
        <bpmn:incoming>W2689_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2689_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2689_Task7" name="Legal reviews the incentive agreement: enforceability, hidden conditions…">
        <bpmn:documentation>Step 2: Legal reviews the incentive agreement: enforceability, hidden conditions (employment quotas, local-sourcing requirements, clawback if BuildRight exits early), duration and renewal terms; negotiates additional concessions where BuildRight&#x27;s investment is material to the LGU
Responsible (R): Legal / COO
Accountable (A): VP Legal
Duration: Per site selection</bpmn:documentation>
        <bpmn:incoming>W2689_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2689_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2689_Task8" name="Finance models the incentive impact on the store P&amp;L: tax savings NPV over the…">
        <bpmn:documentation>Step 3: Finance models the incentive impact on the store P&amp;L: tax savings NPV over the holiday period, compliance-cost comparison vs. a non-incentivized LGU (from W2687), clawback risk; COO incorporates the net financial impact into the site-decision matrix
Responsible (R): Finance / COO
Accountable (A): CFO
Duration: Per site selection</bpmn:documentation>
        <bpmn:incoming>W2689_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2689_End9" name="Complete">
        <bpmn:incoming>W2689_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2689_Annotation10">
        <bpmn:text>Controls: - CTL-459 (ensure controlled execution — LGU Relationship &amp; Regulatory Analytics (PA-76.3).) | - operational: capex/site-investment approval — links to the VS-20 site-decision gate; operational: CEO + CFO sign-off on any incentive agreement with a &gt;3-year commitment
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
