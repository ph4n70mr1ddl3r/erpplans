      <bpmndi:BPMNPlane id="W2687_plane" bpmnElement="W_W2687">
        <bpmndi:BPMNShape id="W2687_Lane1_di" bpmnElement="W2687_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
