      <bpmndi:BPMNPlane id="W2688_plane" bpmnElement="W_W2688">
        <bpmndi:BPMNShape id="W2688_Lane1_di" bpmnElement="W2688_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
