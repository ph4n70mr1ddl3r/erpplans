        <bpmn:flowNodeRef>W3817_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3817_Start3" name="Cohort intake (W3814); program calendar">
        <bpmn:outgoing>W3817_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3817_Task4" name="Trade Capability/L&amp;D plan cohorts: cohort size/intake aligned to capability…">
        <bpmn:documentation>Step 1: Trade Capability/L&amp;D plan cohorts: cohort size/intake aligned to capability needs and store-growth (links to VS-37/VS-103.3), intake calendar, theory/practical schedule, store/DC rotation slots, and instructor/mentor capacity (links to W3820)
Responsible (R): Trade Capability / L&amp;D / Store Ops
Accountable (A): Trade Capability Lead
Duration: Per cohort</bpmn:documentation>
        <bpmn:incoming>W3817_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3817_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3817_Task5" name="Trade Capability/Store-Ops allocate apprentices to stores/DCs balancing…">
        <bpmn:documentation>Step 2: Trade Capability/Store-Ops allocate apprentices to stores/DCs balancing learning value, store capacity, trade coverage, and regional distribution, and schedule rotation across departments (lumber, tiles, plumbing, electrical, paint, tools)
Responsible (R): Trade Capability / Store Ops / DC Ops
Accountable (A): Trade Capability Lead
Duration: Per cohort</bpmn:documentation>
        <bpmn:incoming>W3817_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3817_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3817_Task6" name="Trade Capability/Finance allocate program resources: instructors, materials…">
        <bpmn:documentation>Step 3: Trade Capability/Finance allocate program resources: instructors, materials, tools/PPE kits (links to W172/W3823), facilities, and budget tracking (links to W3812)
Responsible (R): Trade Capability / Finance
Accountable (A): Trade Capability Lead
Duration: Per cohort</bpmn:documentation>
        <bpmn:incoming>W3817_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3817_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3817_End7" name="Complete">
        <bpmn:incoming>W3817_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3817_Annotation8">
        <bpmn:text>Controls: - CTL-599 (ensure controlled execution — Apprenticeship Cohort Operations, Mentorship &amp; Competency Assessment (PA-123.2).) | - operational: capacity planning; operational: rotation scheduling
Owner: Trade Capability / L&amp;D</bpmn:text>
      </bpmn:textAnnotation>
