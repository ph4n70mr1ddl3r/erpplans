        <bpmndi:BPMNShape id="W1887_Annotation11_di" bpmnElement="W1887_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1887_Flow13_di" bpmnElement="W1887_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1887_Flow14_di" bpmnElement="W1887_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1887_Flow15_di" bpmnElement="W1887_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1887_Flow16_di" bpmnElement="W1887_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1887_Flow17_di" bpmnElement="W1887_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1887_Assoc12_di" bpmnElement="W1887_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1888" name="W1888. Contractor Volume Rebate &amp; Spend-Based Incentive Calculation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual/quarterly volume rebate calculation period end
Frequency: Quarterly calculation for Gold/Platinum; annual for Bronze/Silver
Volume: ~200 Gold/Platinum accounts eligible for volume rebates
Owner: FP&amp;A
Participants: FP&amp;A, Account Manager, Finance, Trade Professional
Source: workflow W1888 — Contractor Volume Rebate &amp; Spend-Based Incentive Calculation</bpmn:documentation>
      <bpmn:laneSet id="W1888_LaneSet4">
        <bpmn:lane id="W1888_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1888_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1888_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1888_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1888_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1888_Lane3" name="Finance">
        <bpmn:flowNodeRef>W1888_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1888_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1888_Start5" name="Annual/quarterly volume rebate calculation period end">
        <bpmn:outgoing>W1888_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1888_Task6" name="FP&amp;A calculates volume rebate per eligible account: (a) total qualifying spend…">
        <bpmn:documentation>Step 1: FP&amp;A calculates volume rebate per eligible account: (a) total qualifying spend during period (exclude returns, taxes, non-merchandise), (b) apply rebate rate per the W1161/W1549 spend tiers: (i) Bronze PHP 100K–500K: 1% rebate, (ii) Silver PHP 500K–1.5M: 1.5%, (iii) Gold PHP 1.5M–5M: 2%, (iv) Platinum PHP 5M+: 2.5%, (c) rebate paid as credit memo to trade account (applied against future purchases) or as direct refund
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1–2 days/period</bpmn:documentation>
        <bpmn:incoming>W1888_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1888_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1888_Task7" name="Account Manager communicates rebate to trade professional: (a) present rebate…">
        <bpmn:documentation>Step 2: Account Manager communicates rebate to trade professional: (a) present rebate calculation with supporting spend data, (b) explain how rebate will be applied (credit memo or refund), (c) encourage reinvestment: suggest using rebate credit for upcoming project materials
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W1888_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1888_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1888_Task8" name="Finance processes rebate: (a) credit memo: Dr. Trade Promotion Expense / Cr…">
        <bpmn:documentation>Step 3: Finance processes rebate: (a) credit memo: Dr. Trade Promotion Expense / Cr. Accounts Receivable — Trade Account, (b) refund: Dr. Trade Promotion Expense / Cr. Cash, (c) update trade account balance
Responsible (R): Finance
Accountable (A): Controller
Duration: Per AP process</bpmn:documentation>
        <bpmn:incoming>W1888_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1888_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1888_End9" name="Complete">
        <bpmn:incoming>W1888_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1888_Annotation10">
        <bpmn:text>Controls: - CTL-371 (ensure controlled execution — Contractor Loyalty, Incentive &amp; Volume Program (PA-43.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1888_Assoc11" sourceRef="W1888_Annotation10" targetRef="W1888_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1888_Flow12" sourceRef="W1888_Start5" targetRef="W1888_Task6" />
      <bpmn:sequenceFlow id="W1888_Flow13" sourceRef="W1888_Task6" targetRef="W1888_Task7" />
      <bpmn:sequenceFlow id="W1888_Flow14" sourceRef="W1888_Task7" targetRef="W1888_Task8" />
      <bpmn:sequenceFlow id="W1888_Flow15" sourceRef="W1888_Task8" targetRef="W1888_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1888_diag">
      <bpmndi:BPMNPlane id="W1888_plane" bpmnElement="W_W1888">
        <bpmndi:BPMNShape id="W1888_Lane1_di" bpmnElement="W1888_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1888_Lane2_di" bpmnElement="W1888_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1888_Lane3_di" bpmnElement="W1888_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
