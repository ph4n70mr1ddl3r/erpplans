    <bpmn:process id="W_W1890" name="W1890. Contractor Early Payment Discount &amp; Supply Chain Finance Program" isExecutable="false">
      <bpmn:documentation>Trigger: Trade account elects early payment on eligible invoices
Frequency: ~500–1,000 early payments/year
Volume: Available to Gold and Platinum tier accounts
Owner: Finance
Participants: Finance, Account Manager, Trade Professional, Bank
Source: workflow W1890 — Contractor Early Payment Discount &amp; Supply Chain Finance Program</bpmn:documentation>
      <bpmn:laneSet id="W1890_LaneSet2">
        <bpmn:lane id="W1890_Lane1" name="Finance">
        <bpmn:flowNodeRef>W1890_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1890_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1890_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1890_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1890_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1890_Start3" name="Trade account elects early payment on eligible invoices">
        <bpmn:outgoing>W1890_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1890_Task4" name="Finance offers early payment incentive to Gold/Platinum trade accounts: (a)…">
        <bpmn:documentation>Step 1: Finance offers early payment incentive to Gold/Platinum trade accounts: (a) 2/10 Net 30: 2% discount if paid within 10 days instead of standard Net 30, (b) BuildRight benefits from improved cash flow from trade accounts (receivables collected faster), (c) trade account benefits from cost savings on materials
Responsible (R): Finance
Accountable (A): CFO
Duration: Per invoice</bpmn:documentation>
        <bpmn:incoming>W1890_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1890_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1890_Task5" name="Trade account elects early payment: (a) pays invoice within discount window…">
        <bpmn:documentation>Step 2: Trade account elects early payment: (a) pays invoice within discount window, (b) Finance processes payment with 2% discount applied, (c) Dr. Cash (98%) / Dr. Sales Discount (2%) / Cr. Accounts Receivable (100%)
Responsible (R): Finance
Accountable (A): Controller
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W1890_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1890_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1890_Task6" name="Quarterly: Finance evaluates early payment program cost vs. benefit: (a) total…">
        <bpmn:documentation>Step 3: Quarterly: Finance evaluates early payment program cost vs. benefit: (a) total discount cost (2% of accelerated receivables), (b) cash flow benefit (earlier collection reduces working capital needs), (c) annualized cost of discount vs. cost of borrowing — if discount cost &lt; borrowing cost, program is financially beneficial
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1890_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1890_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1890_End7" name="Complete">
        <bpmn:incoming>W1890_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1890_Annotation8">
        <bpmn:text>Controls: - CTL-189 (ensure trade-program benefit &amp; master-data integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1890_Assoc9" sourceRef="W1890_Annotation8" targetRef="W1890_Start3" associationDirection="None" />
