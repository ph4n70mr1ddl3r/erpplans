    <bpmn:process id="W_W1891" name="W1891. Contractor Seasonal Promotion &amp; Project Bundle Pricing Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promotional calendar; trade-specific promotion
Frequency: 6 major promotions/year + 2–3 trade-specific promotions
Volume: Targeted to ~5,200 trade accounts
Owner: VP Merchandising
Participants: VP Merchandising, CMO, Category Manager, Account Manager
Source: workflow W1891 — Contractor Seasonal Promotion &amp; Project Bundle Pricing Execution</bpmn:documentation>
      <bpmn:laneSet id="W1891_LaneSet3">
        <bpmn:lane id="W1891_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1891_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1891_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1891_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1891_Lane2" name="CMO">
        <bpmn:flowNodeRef>W1891_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1891_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1891_Start4" name="Seasonal promotional calendar; trade-specific promotion">
        <bpmn:outgoing>W1891_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1891_Task5" name="Category Manager proposes trade-specific promotions: (a) summer construction…">
        <bpmn:documentation>Step 1: Category Manager proposes trade-specific promotions: (a) summer construction season (Mar–May): cement and rebar bundle discount for contractors, (b) back-to-school build (May–Jun): paint and electrical bundle for school renovation projects, (c) Q4 project closeout (Oct–Dec): appliance and fixture packages for turnover-ready units, (d) each promotion includes: eligible products, trade-only pricing, minimum quantity, promotional period, margin impact
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 week/promotion</bpmn:documentation>
        <bpmn:incoming>W1891_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1891_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1891_Task6" name="CMO executes trade promotion communication: (a) direct email/SMS to trade…">
        <bpmn:documentation>Step 2: CMO executes trade promotion communication: (a) direct email/SMS to trade accounts with personalized pricing based on tier, (b) trade portal banner and featured products, (c) AM outreach to key and growth accounts with personalized offer, (d) in-store signage at contractor-frequented departments
Responsible (R): CMO / Account Manager
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1891_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1891_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1891_Task7" name="Post-promotion analysis: (a) Category Manager and FP&amp;A evaluate: incremental…">
        <bpmn:documentation>Step 3: Post-promotion analysis: (a) Category Manager and FP&amp;A evaluate: incremental sales volume, margin impact, trade account participation rate, inventory sell-through, (b) adjust future promotions based on performance
Responsible (R): Category Manager / FP&amp;A
Accountable (A): VP Merchandising
Duration: 1 day/promotion</bpmn:documentation>
        <bpmn:incoming>W1891_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1891_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1891_End8" name="Complete">
        <bpmn:incoming>W1891_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1891_Annotation9">
        <bpmn:text>Controls: - CTL-371 (ensure controlled execution — Contractor Loyalty, Incentive &amp; Volume Program (PA-43.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
