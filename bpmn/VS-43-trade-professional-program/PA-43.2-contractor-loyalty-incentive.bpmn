    <bpmn:process id="W_W1887" name="W1887. Contractor Points Earning, Redemption &amp; Statement Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor purchase at POS; points redemption request
Frequency: Continuous; ~15,000 B2B transactions/month generating points
Volume: ~5,200 trade accounts earning and redeeming points
Owner: Account Manager
Participants: Account Manager, Cashier, Trade Professional, Loyalty System
Source: workflow W1887 — Contractor Points Earning, Redemption &amp; Statement Management</bpmn:documentation>
      <bpmn:laneSet id="W1887_LaneSet4">
        <bpmn:lane id="W1887_Lane1" name="System">
        <bpmn:flowNodeRef>W1887_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1887_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1887_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1887_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W1887_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1887_Lane3" name="Account Manager">
        <bpmn:flowNodeRef>W1887_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1887_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1887_Start5" name="Contractor purchase at POS; points redemption request">
        <bpmn:outgoing>W1887_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1887_Task6" name="Contractor makes purchase at POS using trade account card: (a) system…">
        <bpmn:documentation>Step 1: Contractor makes purchase at POS using trade account card: (a) system identifies trade account and loyalty tier, (b) points earned per spend: Bronze 1 point per PHP 100, Silver 1.5 per PHP 100, Gold 2 per PHP 100, Platinum 3 per PHP 100, (c) system posts points to contractor&#x27;s loyalty account with transaction reference, (d) points visible in contractor&#x27;s online portal and mobile app
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1887_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1887_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1887_Task7" name="Contractor redeems points: (a) at POS: contractor presents trade account card…">
        <bpmn:documentation>Step 2: Contractor redeems points: (a) at POS: contractor presents trade account card and requests points redemption; cashier enters redemption amount; system converts points to peso value (1 point = PHP 1.00), (b) online: contractor redeems points for merchandise or gift items through trade portal, (c) points deduction posted to loyalty account; redemption value reduces transaction total or issued as store credit
Responsible (R): Cashier / System
Accountable (A): —
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1887_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1887_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1887_Task8" name="Monthly: system generates contractor loyalty statement: (a) points earned this…">
        <bpmn:documentation>Step 3: Monthly: system generates contractor loyalty statement: (a) points earned this month and year-to-date, (b) points redeemed this month and year-to-date, (c) current points balance and peso equivalent, (d) current tier and progress to next tier, (e) next tier benefits preview, (f) statement sent via email and available in trade portal
Responsible (R): System / Account Manager
Accountable (A): VP Store Operations
Duration: Automated + 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1887_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1887_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1887_Task9" name="Quarterly: Account Manager reviews points liability for assigned accounts: (a)…">
        <bpmn:documentation>Step 4: Quarterly: Account Manager reviews points liability for assigned accounts: (a) total unredeemed points per account, (b) accounts with high points balances that may indicate dissatisfaction (earning but not redeeming = not engaging with program benefits), (c) accounts approaching tier upgrade — proactive communication to encourage next-tier spend
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1887_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1887_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1887_End10" name="Complete">
        <bpmn:incoming>W1887_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1887_Annotation11">
        <bpmn:text>Controls: - CTL-371 (ensure controlled execution — Contractor Loyalty, Incentive &amp; Volume Program (PA-43.2).) | - operational: Account Manager review and approval gate
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1887_Assoc12" sourceRef="W1887_Annotation11" targetRef="W1887_Start5" associationDirection="None" />
