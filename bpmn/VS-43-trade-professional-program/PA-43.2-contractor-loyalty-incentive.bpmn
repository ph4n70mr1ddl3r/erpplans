      <bpmn:sequenceFlow id="W1890_Flow12" sourceRef="W1890_Task5" targetRef="W1890_Task6" />
      <bpmn:sequenceFlow id="W1890_Flow13" sourceRef="W1890_Task6" targetRef="W1890_End7" />
    </bpmn:process>
