      <bpmn:sequenceFlow id="W1887_Flow17" sourceRef="W1887_Task9" targetRef="W1887_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1887_diag">
      <bpmndi:BPMNPlane id="W1887_plane" bpmnElement="W_W1887">
        <bpmndi:BPMNShape id="W1887_Lane1_di" bpmnElement="W1887_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1887_Lane2_di" bpmnElement="W1887_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1887_Lane3_di" bpmnElement="W1887_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
