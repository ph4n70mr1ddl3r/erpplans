    <bpmn:process id="W_W1889" name="W1889. Contractor Referral Program &amp; New Account Acquisition Incentive" isExecutable="false">
      <bpmn:documentation>Trigger: Existing trade account refers a new contractor to BuildRight
Frequency: ~100–200 referrals/year
Volume: Per referral
Owner: Account Manager
Participants: Account Manager, Referred Contractor, Existing Contractor, Marketing
Source: workflow W1889 — Contractor Referral Program &amp; New Account Acquisition Incentive</bpmn:documentation>
      <bpmn:laneSet id="W1889_LaneSet3">
        <bpmn:lane id="W1889_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W1889_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1889_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1889_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1889_Lane2" name="System">
        <bpmn:flowNodeRef>W1889_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1889_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1889_Start4" name="Existing trade account refers a new contractor to BuildRight">
        <bpmn:outgoing>W1889_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1889_Task5" name="Existing trade account refers new contractor: (a) provides new contractor&#x27;s…">
        <bpmn:documentation>Step 1: Existing trade account refers new contractor: (a) provides new contractor&#x27;s name, contact, and trade type, (b) referral logged in CRM with referrer account number
Responsible (R): Account Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1889_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1889_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1889_Task6" name="Account Manager contacts referred contractor: (a) introduce BuildRight trade…">
        <bpmn:documentation>Step 2: Account Manager contacts referred contractor: (a) introduce BuildRight trade program, (b) offer referral incentive: 500 loyalty points for the referring contractor upon new account activation, (c) process new account application per W1878
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1889_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1889_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1889_Task7" name="Upon new account activation: (a) system awards referral bonus points to…">
        <bpmn:documentation>Step 3: Upon new account activation: (a) system awards referral bonus points to referring contractor, (b) new contractor receives welcome bonus: 200 loyalty points, (c) AM tracks referral conversion rate
Responsible (R): System / AM
Accountable (A): VP Store Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1889_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1889_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1889_End8" name="Complete">
        <bpmn:incoming>W1889_Flow14</bpmn:incoming>
      </bpmn:endEvent>
