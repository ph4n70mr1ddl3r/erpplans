<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-43.2-contractor-loyalty-incentive" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1886" name="W1886. Contractor Loyalty Program Tier Design &amp; Benefit Structure Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program review; competitive benchmarking
Frequency: Annual review; redesign every 2–3 years
Volume: 4 loyalty tiers across ~5,200 trade accounts
Owner: VP Store Operations
Participants: VP Store Operations, CMO, CFO, Category Manager
Source: workflow W1886 — Contractor Loyalty Program Tier Design &amp; Benefit Structure Management</bpmn:documentation>
      <bpmn:laneSet id="W1886_LaneSet4">
        <bpmn:lane id="W1886_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1886_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1886_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1886_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1886_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1886_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1886_Lane3" name="IT">
        <bpmn:flowNodeRef>W1886_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1886_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1886_Start5" name="Annual program review; competitive benchmarking">
        <bpmn:outgoing>W1886_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1886_Task6" name="Annual: VP Store Operations reviews contractor loyalty tier structure: (a)…">
        <bpmn:documentation>Step 1: Annual: VP Store Operations reviews contractor loyalty tier structure: (a) current tiers per the W1549 register: Bronze (PHP 100K–500K/year), Silver (PHP 500K–1.5M), Gold (PHP 1.5M–5M), Platinum (PHP 5M+), (b) evaluate tier distribution: are too many accounts in Bronze (devaluing program) or too few in Platinum (unattainable)?, (c) competitive benchmarking: what do CitiHardware, Wilcon Depot, and ACE Hardware offer trade professionals?, (d) member satisfaction survey: do contractors value current benefits? What benefits would increase loyalty?
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1886_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1886_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1886_Task7" name="VP Store Operations and CMO redesign benefit structure: (a) pricing benefits…">
        <bpmn:documentation>Step 2: VP Store Operations and CMO redesign benefit structure: (a) pricing benefits: trade discount by tier (Bronze 5%, Silver 8%, Gold 12%, Platinum 15%), (b) service benefits: priority delivery scheduling, dedicated phone line, extended store hours access, (c) credit benefits: higher credit limits, longer payment terms for higher tiers, (d) experiential benefits: exclusive contractor events, product training, jobsite visits by Category Managers, (e) partner benefits: discounts from partner businesses (insurance, fuel, vehicle rental), (f) financial modeling: cost of benefits per tier vs. incremental margin from higher spend
Responsible (R): VP Store Operations / CMO
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1886_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1886_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1886_Task8" name="CFO approves program financial model: (a) total program cost (discounts…">
        <bpmn:documentation>Step 3: CFO approves program financial model: (a) total program cost (discounts, benefits, points liability) vs. incremental revenue from tier-based spend uplift, (b) target ROI: program cost should not exceed 2–3% of B2B revenue, (c) points liability impact on balance sheet per W1893
Responsible (R): CFO
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1886_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1886_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1886_Task9" name="IT configures loyalty tier rules in POS and CRM: (a) tier thresholds and…">
        <bpmn:documentation>Step 4: IT configures loyalty tier rules in POS and CRM: (a) tier thresholds and auto-upgrade/downgrade rules, (b) benefit activation per tier, (c) points earning rates per tier (higher tiers earn points faster), (d) test configuration before go-live
Responsible (R): IT
Accountable (A): CIO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1886_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1886_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1886_End10" name="Complete">
        <bpmn:incoming>W1886_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1886_Annotation11">
        <bpmn:text>Controls: - CTL-371 (ensure controlled execution — Contractor Loyalty, Incentive &amp; Volume Program (PA-43.2).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1886_Assoc12" sourceRef="W1886_Annotation11" targetRef="W1886_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1886_Flow13" sourceRef="W1886_Start5" targetRef="W1886_Task6" />
      <bpmn:sequenceFlow id="W1886_Flow14" sourceRef="W1886_Task6" targetRef="W1886_Task7" />
      <bpmn:sequenceFlow id="W1886_Flow15" sourceRef="W1886_Task7" targetRef="W1886_Task8" />
      <bpmn:sequenceFlow id="W1886_Flow16" sourceRef="W1886_Task8" targetRef="W1886_Task9" />
      <bpmn:sequenceFlow id="W1886_Flow17" sourceRef="W1886_Task9" targetRef="W1886_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1886_diag">
      <bpmndi:BPMNPlane id="W1886_plane" bpmnElement="W_W1886">
        <bpmndi:BPMNShape id="W1886_Lane1_di" bpmnElement="W1886_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
