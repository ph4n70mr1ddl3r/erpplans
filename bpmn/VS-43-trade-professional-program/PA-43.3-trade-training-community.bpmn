    <bpmn:process id="W_W1901" name="W1901. Trade Professional Recognition Awards &amp; Community Building" isExecutable="false">
      <bpmn:documentation>Trigger: Annual recognition program cycle
Frequency: Annual awards; monthly spotlights
Volume: ~10 annual awards; ~12 monthly spotlights
Owner: CMO
Participants: CMO, VP Store Operations, Account Manager, Trade Professionals
Source: workflow W1901 — Trade Professional Recognition Awards &amp; Community Building</bpmn:documentation>
      <bpmn:laneSet id="W1901_LaneSet2">
        <bpmn:lane id="W1901_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1901_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1901_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1901_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1901_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1901_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1901_Start3" name="Annual recognition program cycle">
        <bpmn:outgoing>W1901_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1901_Task4" name="CMO designs annual trade recognition program: (a) award categories: Contractor…">
        <bpmn:documentation>Step 1: CMO designs annual trade recognition program: (a) award categories: Contractor of the Year, Best Project (residential, commercial, renovation), Rising Star (new trade account with highest growth), Safety Champion, Green Builder, (b) nomination process: AMs nominate trade accounts; self-nomination accepted, (c) judging panel: VP Store Operations, VP Merchandising, and invited industry expert, (d) prizes: cash (PHP 50K–200K), BuildRight gift certificates, feature in BuildRight marketing materials, exclusive Platinum tier upgrade for 1 year
Responsible (R): CMO
Accountable (A): VP Merchandising
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1901_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1901_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1901_Task5" name="Monthly spotlight: (a) CMO selects 1 trade professional per month for…">
        <bpmn:documentation>Step 2: Monthly spotlight: (a) CMO selects 1 trade professional per month for &quot;BuildRight Trade Partner Spotlight&quot; on social media and trade portal, (b) feature: contractor&#x27;s story, featured project, partnership with BuildRight, (c) benefits: contractor receives exposure; BuildRight demonstrates trade program success stories
Responsible (R): CMO
Accountable (A): VP Store Operations
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1901_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1901_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1901_Task6" name="Annual awards ceremony: (a) host ceremony at BuildRight HQ or major store…">
        <bpmn:documentation>Step 3: Annual awards ceremony: (a) host ceremony at BuildRight HQ or major store during holiday season, (b) invite all nominees, key accounts, and media, (c) present awards; photograph and publish, (d) incorporate into next year&#x27;s trade program marketing
Responsible (R): CMO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1901_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1901_End7" name="Complete">
        <bpmn:incoming>W1901_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1901_Annotation8">
        <bpmn:text>Controls: - CTL-372 (ensure controlled execution — Trade Training, Certification &amp; Community Engagement (PA-43.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
