    <bpmn:process id="W_W1897" name="W1897. Vendor-Sponsored Trade Seminar &amp; Product Demo Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor proposal for trade seminar; BuildRight request for vendor demo
Frequency: ~8–12 vendor-sponsored seminars/year
Volume: ~50–100 trade attendees per seminar
Owner: Category Manager
Participants: Category Manager, Vendor Representatives, Account Manager, Trade Professionals
Source: workflow W1897 — Vendor-Sponsored Trade Seminar &amp; Product Demo Coordination</bpmn:documentation>
      <bpmn:laneSet id="W1897_LaneSet3">
        <bpmn:lane id="W1897_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1897_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1897_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1897_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1897_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1897_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1897_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1897_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1897_Start4" name="Vendor proposal for trade seminar; BuildRight request for vendor demo">
        <bpmn:outgoing>W1897_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1897_Task5" name="Category Manager coordinates with vendor: (a) vendor proposes seminar topic…">
        <bpmn:documentation>Step 1: Category Manager coordinates with vendor: (a) vendor proposes seminar topic aligned with their product range (e.g., Bosch power tool demonstration, Boysen paint application techniques, Holcim cement mixing best practices), (b) agree on date, venue (BuildRight store), target audience (trade professionals by trade type), (c) vendor provides: instructor, demo units, promotional materials, co-funding for refreshments, (d) Category Manager approves seminar content to ensure it adds value (not purely sales pitch)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1897_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1897_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1897_Task6" name="Account Manager invites relevant trade accounts: (a) target trade type matching…">
        <bpmn:documentation>Step 2: Account Manager invites relevant trade accounts: (a) target trade type matching seminar topic (plumbers for pipe fitting demo, electricians for wiring demo), (b) Gold/Platinum priority, (c) track RSVP in CRM
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1897_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1897_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1897_Task7" name="Seminar execution: (a) vendor conducts product demo and technical training, (b)…">
        <bpmn:documentation>Step 3: Seminar execution: (a) vendor conducts product demo and technical training, (b) Category Manager ensures BuildRight product availability for post-seminar purchases, (c) attendance tracked; loyalty points awarded
Responsible (R): Category Manager / Vendor
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W1897_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1897_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1897_Task8" name="Post-seminar: (a) track purchase impact: did attendees buy the demonstrated…">
        <bpmn:documentation>Step 4: Post-seminar: (a) track purchase impact: did attendees buy the demonstrated products?, (b) vendor provides co-op marketing cost contribution per W39 (vendor rebate), (c) Category Manager evaluates vendor partnership for future seminars
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1897_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1897_End9" name="Complete">
        <bpmn:incoming>W1897_Flow16</bpmn:incoming>
      </bpmn:endEvent>
