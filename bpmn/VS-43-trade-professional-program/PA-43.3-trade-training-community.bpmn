    <bpmn:process id="W_W1896" name="W1896. Trade Community Online Forum &amp; Knowledge Base Management" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing community management
Frequency: Continuous; daily moderation
Volume: ~5,200 trade account members
Owner: Marketing Team
Participants: Marketing Team, Category Managers, Trade Professionals
Source: workflow W1896 — Trade Community Online Forum &amp; Knowledge Base Management</bpmn:documentation>
      <bpmn:laneSet id="W1896_LaneSet2">
        <bpmn:lane id="W1896_Lane1" name="Marketing Team">
        <bpmn:flowNodeRef>W1896_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1896_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1896_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1896_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1896_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1896_Start3" name="Ongoing community management">
        <bpmn:outgoing>W1896_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1896_Task4" name="Marketing Team manages trade professional online community: (a) platform…">
        <bpmn:documentation>Step 1: Marketing Team manages trade professional online community: (a) platform: dedicated section on buildright.com.ph or private Facebook group for trade accounts, (b) content: product tips, installation guides, specification sheets, project photos, industry news, (c) discussion forums: contractors share project experiences, ask technical questions, recommend products, (d) Category Managers participate as subject matter experts: answer technical questions, provide product guidance
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W1896_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1896_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1896_Task5" name="Marketing Team moderates community: (a) ensure discussions are professional and…">
        <bpmn:documentation>Step 2: Marketing Team moderates community: (a) ensure discussions are professional and on-topic, (b) remove spam, competitor promotions, or inappropriate content, (c) escalate technical questions to Category Managers if needed, (d) encourage active participation through featured contractor spotlights, project of the month
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1896_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1896_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1896_Task6" name="Monthly: Marketing Team reports community engagement metrics: (a) active users…">
        <bpmn:documentation>Step 3: Monthly: Marketing Team reports community engagement metrics: (a) active users, (b) posts and comments, (c) most-discussed topics, (d) product questions (feed into training calendar W1894), (e) community growth
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1896_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1896_End7" name="Complete">
        <bpmn:incoming>W1896_Flow13</bpmn:incoming>
      </bpmn:endEvent>
