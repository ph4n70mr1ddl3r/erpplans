    <bpmn:process id="W_W1895" name="W1895. Contractor Skills Workshop &amp; Certification Event Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly workshop calendar; partnership with trade associations
Frequency: Quarterly skills workshops in major cities (Davao, Cebu, Manila, Clark)
Volume: ~100–200 attendees per event; ~400–800 total/year
Owner: CMO
Participants: CMO, Account Manager, Category Manager, Trade Association Partners, Sponsor Vendors
Source: workflow W1895 — Contractor Skills Workshop &amp; Certification Event Management</bpmn:documentation>
      <bpmn:laneSet id="W1895_LaneSet2">
        <bpmn:lane id="W1895_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1895_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1895_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1895_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1895_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1895_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1895_Start3" name="Quarterly workshop calendar; partnership with trade associations">
        <bpmn:outgoing>W1895_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1895_Task4" name="CMO plans quarterly workshop: (a) topic selection based on trade demand…">
        <bpmn:documentation>Step 1: CMO plans quarterly workshop: (a) topic selection based on trade demand: electrical wiring safety, plumbing installation best practices, tile laying techniques, solar panel installation, (b) partner with trade associations (Philippine Constructors Association, Philippine Institute of Architects) for credibility and reach, (c) secure vendor sponsorship: power tool brands, tile brands, electrical brands — sponsors provide demo units, instructors, and co-funding, (d) venue: BuildRight store event space or rented venue, (e) marketing: invite trade accounts, promote on social media, partner association channels
Responsible (R): CMO
Accountable (A): VP Merchandising
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1895_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1895_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1895_Task5" name="Event execution: (a) registration and attendance tracking, (b) workshop…">
        <bpmn:documentation>Step 2: Event execution: (a) registration and attendance tracking, (b) workshop sessions: hands-on product demonstration, installation technique, safety practices, (c) BuildRight product showcase: highlight trade-available products and pricing, (d) networking opportunity for contractors, (e) loyalty points awarded for attendance
Responsible (R): CMO / Category Manager
Accountable (A): VP Merchandising
Duration: Half-day event</bpmn:documentation>
        <bpmn:incoming>W1895_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1895_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1895_Task6" name="Post-event: (a) attendee feedback survey, (b) AM follow-up with attendees for…">
        <bpmn:documentation>Step 3: Post-event: (a) attendee feedback survey, (b) AM follow-up with attendees for product trials, (c) vendor sponsor feedback and ROI review, (d) plan next quarter&#x27;s workshop based on feedback
Responsible (R): CMO / AM
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1895_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1895_End7" name="Complete">
        <bpmn:incoming>W1895_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1895_Annotation8">
        <bpmn:text>Controls: - CTL-372 (ensure controlled execution — Trade Training, Certification &amp; Community Engagement (PA-43.3).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1895_Assoc9" sourceRef="W1895_Annotation8" targetRef="W1895_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1895_Flow10" sourceRef="W1895_Start3" targetRef="W1895_Task4" />
      <bpmn:sequenceFlow id="W1895_Flow11" sourceRef="W1895_Task4" targetRef="W1895_Task5" />
      <bpmn:sequenceFlow id="W1895_Flow12" sourceRef="W1895_Task5" targetRef="W1895_Task6" />
      <bpmn:sequenceFlow id="W1895_Flow13" sourceRef="W1895_Task6" targetRef="W1895_End7" />
    </bpmn:process>
