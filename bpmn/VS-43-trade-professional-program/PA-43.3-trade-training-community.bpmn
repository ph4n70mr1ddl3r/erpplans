<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-43.3-trade-training-community" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1894" name="W1894. Trade Professional Product Training Program Planning &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: New product launch; annual training calendar; trade account request
Frequency: Monthly training sessions across regions
Volume: ~500–1,000 contractors trained/year across all sessions
Owner: Category Manager
Participants: Category Manager, Account Manager, Product Trainers, Trade Professionals
Source: workflow W1894 — Trade Professional Product Training Program Planning &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W1894_LaneSet3">
        <bpmn:lane id="W1894_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1894_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1894_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1894_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1894_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1894_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1894_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1894_Start4" name="New product launch; annual training calendar; trade account request">
        <bpmn:outgoing>W1894_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1894_Task5" name="Annual: Category Manager develops trade training calendar: (a) align with…">
        <bpmn:documentation>Step 1: Annual: Category Manager develops trade training calendar: (a) align with product launch schedule: new power tool line → power tool training, new tile collection → tile installation training, (b) align with seasonal demand: waterproofing training before rainy season, aircon installation training before summer, (c) regional scheduling: rotate training across Mindanao, Visayas, Luzon to maximize accessibility, (d) training formats: in-store demo (1–2 hours), regional seminar (half-day), online webinar (1 hour)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1894_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1894_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1894_Task6" name="Monthly: execute scheduled training sessions: (a) Category Manager or Product…">
        <bpmn:documentation>Step 2: Monthly: execute scheduled training sessions: (a) Category Manager or Product Trainer conducts session: product features, installation techniques, common mistakes, safety considerations, BuildRight product advantages vs. competitor products, (b) Account Manager invites trade accounts by tier: Gold/Platinum get priority; Bronze/Silver on waitlist, (c) training materials: product samples for hands-on practice, installation guides, specification sheets, (d) attendance tracked in CRM for account engagement scoring
Responsible (R): Category Manager / Product Trainer
Accountable (A): VP Merchandising
Duration: 2–4 hours/session</bpmn:documentation>
        <bpmn:incoming>W1894_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1894_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1894_Task7" name="Post-training: Account Manager follows up with attendees: (a) provide product…">
        <bpmn:documentation>Step 3: Post-training: Account Manager follows up with attendees: (a) provide product samples or trial pricing for newly trained products, (b) track post-training purchase behavior: did attendees increase purchases of trained products?, (c) gather feedback for training improvement
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 15 min/attendee</bpmn:documentation>
        <bpmn:incoming>W1894_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1894_End8" name="Complete">
        <bpmn:incoming>W1894_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1894_Annotation9">
        <bpmn:text>Controls: - CTL-372 (ensure controlled execution — Trade Training, Certification &amp; Community Engagement (PA-43.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1894_Assoc10" sourceRef="W1894_Annotation9" targetRef="W1894_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1894_Flow11" sourceRef="W1894_Start4" targetRef="W1894_Task5" />
      <bpmn:sequenceFlow id="W1894_Flow12" sourceRef="W1894_Task5" targetRef="W1894_Task6" />
      <bpmn:sequenceFlow id="W1894_Flow13" sourceRef="W1894_Task6" targetRef="W1894_Task7" />
      <bpmn:sequenceFlow id="W1894_Flow14" sourceRef="W1894_Task7" targetRef="W1894_End8" />
    </bpmn:process>
