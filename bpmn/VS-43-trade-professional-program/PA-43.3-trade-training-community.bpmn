    <bpmn:process id="W_W1899" name="W1899. Trade Show Participation &amp; Industry Event Representation" isExecutable="false">
      <bpmn:documentation>Trigger: Industry trade show calendar; strategic decision to participate
Frequency: ~3–5 trade shows/year (PHILCONSTRUCT, CEBUCON, WorldBEX, local construction expos)
Volume: Per event
Owner: CMO
Participants: CMO, VP Merchandising, Category Manager, Account Manager
Source: workflow W1899 — Trade Show Participation &amp; Industry Event Representation</bpmn:documentation>
      <bpmn:laneSet id="W1899_LaneSet3">
        <bpmn:lane id="W1899_Lane1" name="CMO">
        <bpmn:flowNodeRef>W1899_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1899_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1899_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1899_Lane2" name="AM">
        <bpmn:flowNodeRef>W1899_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1899_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1899_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1899_Start4" name="Industry trade show calendar; strategic decision to participate">
        <bpmn:outgoing>W1899_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1899_Task5" name="CMO evaluates trade show opportunities: (a) PHILCONSTRUCT (Manila, Cebu…">
        <bpmn:documentation>Step 1: CMO evaluates trade show opportunities: (a) PHILCONSTRUCT (Manila, Cebu, Davao): largest construction expo in Philippines — must attend, (b) WorldBEX (Manila): building and construction expo — high contractor attendance, (c) local construction expos: regional events in key markets, (d) evaluate: cost vs. expected trade account acquisition and brand exposure
Responsible (R): CMO
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1899_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1899_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1899_Task6" name="Prepare trade show booth and materials: (a) booth design: BuildRight trade…">
        <bpmn:documentation>Step 2: Prepare trade show booth and materials: (a) booth design: BuildRight trade program showcase, product displays, interactive demos, (b) collateral: trade program brochures, pricing guides, account application forms, (c) staffing: AMs and Category Managers present to engage contractors, (d) digital: tablet for on-the-spot trade account registration
Responsible (R): CMO / VP Merchandising
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1899_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1899_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1899_Task7" name="Execute trade show: (a) engage visiting contractors: present trade program…">
        <bpmn:documentation>Step 3: Execute trade show: (a) engage visiting contractors: present trade program benefits, collect contact information, process on-the-spot account applications, (b) demonstrate BuildRight products and services, (c) network with industry partners and vendors
Responsible (R): AM / Category Manager
Accountable (A): VP Store Operations
Duration: 2–4 days</bpmn:documentation>
        <bpmn:incoming>W1899_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1899_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1899_Task8" name="Post-event: (a) process new account applications from trade show leads per…">
        <bpmn:documentation>Step 4: Post-event: (a) process new account applications from trade show leads per W1878, (b) AM follows up with all contacts within 1 week, (c) measure ROI: new accounts × projected first-year spend vs. event cost
Responsible (R): AM / CMO
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1899_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1899_End9" name="Complete">
        <bpmn:incoming>W1899_Flow16</bpmn:incoming>
      </bpmn:endEvent>
