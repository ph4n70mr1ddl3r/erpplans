        <bpmndi:BPMNShape id="W1882_Lane2_di" bpmnElement="W1882_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1882_Lane3_di" bpmnElement="W1882_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
