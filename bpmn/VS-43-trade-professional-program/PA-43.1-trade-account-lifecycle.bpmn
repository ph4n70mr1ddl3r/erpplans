      <bpmn:sequenceFlow id="W1885_Flow13" sourceRef="W1885_Task6" targetRef="W1885_Task7" />
      <bpmn:sequenceFlow id="W1885_Flow14" sourceRef="W1885_Task7" targetRef="W1885_End8" />
    </bpmn:process>
