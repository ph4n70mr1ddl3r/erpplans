        <bpmndi:BPMNEdge id="W1878_Assoc14_di" bpmnElement="W1878_Assoc14"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1879" name="W1879. Trade Account Annual Recertification &amp; Tier Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual recertification cycle (anniversary of account creation)
Frequency: ~5,200 recertifications/year (~100/week)
Volume: All active trade accounts
Owner: Account Manager
Participants: Account Manager, Credit Analyst, Trade Professional
Source: workflow W1879 — Trade Account Annual Recertification &amp; Tier Review</bpmn:documentation>
      <bpmn:laneSet id="W1879_LaneSet4">
        <bpmn:lane id="W1879_Lane1" name="System">
        <bpmn:flowNodeRef>W1879_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1879_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1879_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1879_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1879_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1879_Lane3" name="Credit Analyst">
        <bpmn:flowNodeRef>W1879_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1879_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1879_Start5" name="Annual recertification cycle (anniversary of account creation)">
        <bpmn:outgoing>W1879_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1879_Task6" name="System triggers annual recertification 30 days before anniversary: (a) Account…">
        <bpmn:documentation>Step 1: System triggers annual recertification 30 days before anniversary: (a) Account Manager reviews account activity: (i) trailing 12-month purchase volume, (ii) payment history: on-time payment rate, aging incidents, bounced checks, (iii) credit utilization: current balance vs. credit limit, (iv) purchase frequency: how often does the account purchase?, (v) return rate and dispute history
Responsible (R): System / Account Manager
Accountable (A): VP Store Operations
Duration: 15–30 min/account</bpmn:documentation>
        <bpmn:incoming>W1879_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1879_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1879_Task7" name="Account Manager determines tier classification: (a) review segmentation per…">
        <bpmn:documentation>Step 2: Account Manager determines tier classification: (a) review segmentation per W1878.2c: has the contractor grown into a higher tier? (b) adjust credit limit per W1549 (contractor annual spend tier review): increase if utilization &gt; 80% and payment history clean; decrease if utilization &lt; 20% or payment issues, (c) review trade pricing eligibility: higher-volume accounts may qualify for deeper trade discounts per W1549
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 15 min/account</bpmn:documentation>
        <bpmn:incoming>W1879_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1879_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1879_Task8" name="Credit Analyst reviews creditworthiness: (a) for accounts with payment issues…">
        <bpmn:documentation>Step 3: Credit Analyst reviews creditworthiness: (a) for accounts with payment issues: reassess credit limit and terms — may reduce limit, tighten terms to Net 30, or convert to COD, (b) for accounts requesting credit limit increase: process per W24 credit scoring, (c) for dormant accounts: flag for W1882 (dormancy reactivation) or W1884 (offboarding)
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 10–15 min/account</bpmn:documentation>
        <bpmn:incoming>W1879_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1879_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1879_Task9" name="Account Manager contacts trade professional: (a) confirm current contact and…">
        <bpmn:documentation>Step 4: Account Manager contacts trade professional: (a) confirm current contact and business information is accurate, (b) communicate any changes to credit limit, terms, or pricing tier, (c) discuss upcoming project pipeline and anticipated purchase needs, (d) confirm Account Manager assignment (may change if contractor&#x27;s primary store has changed), (e) update CRM record with recertification outcome
Responsible (R): Account Manager
Accountable (A): —
Duration: 15–30 min/account</bpmn:documentation>
        <bpmn:incoming>W1879_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1879_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1879_End10" name="Complete">
        <bpmn:incoming>W1879_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1879_Annotation11">
        <bpmn:text>Controls: - CTL-189 (ensure trade-program benefit &amp; master-data integrity.) | - operational: Account Manager review and approval gate
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1879_Assoc12" sourceRef="W1879_Annotation11" targetRef="W1879_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1879_Flow13" sourceRef="W1879_Start5" targetRef="W1879_Task6" />
      <bpmn:sequenceFlow id="W1879_Flow14" sourceRef="W1879_Task6" targetRef="W1879_Task7" />
      <bpmn:sequenceFlow id="W1879_Flow15" sourceRef="W1879_Task7" targetRef="W1879_Task8" />
      <bpmn:sequenceFlow id="W1879_Flow16" sourceRef="W1879_Task8" targetRef="W1879_Task9" />
      <bpmn:sequenceFlow id="W1879_Flow17" sourceRef="W1879_Task9" targetRef="W1879_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1879_diag">
      <bpmndi:BPMNPlane id="W1879_plane" bpmnElement="W_W1879">
        <bpmndi:BPMNShape id="W1879_Lane1_di" bpmnElement="W1879_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Lane2_di" bpmnElement="W1879_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Lane3_di" bpmnElement="W1879_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Task6_di" bpmnElement="W1879_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Task7_di" bpmnElement="W1879_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Task8_di" bpmnElement="W1879_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Task9_di" bpmnElement="W1879_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Start5_di" bpmnElement="W1879_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_End10_di" bpmnElement="W1879_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1879_Annotation11_di" bpmnElement="W1879_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1879_Flow13_di" bpmnElement="W1879_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1879_Flow14_di" bpmnElement="W1879_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1879_Flow15_di" bpmnElement="W1879_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1879_Flow16_di" bpmnElement="W1879_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1879_Flow17_di" bpmnElement="W1879_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1879_Assoc12_di" bpmnElement="W1879_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1880" name="W1880. Trade Account Manager Assignment &amp; Coverage Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual territory planning; Account Manager turnover; account growth requiring reassignment
Frequency: Annual territory planning; ad-hoc reassignments
Volume: ~5,200 trade accounts ÷ ~5 Account Managers = ~1,040 accounts/AM
Owner: VP Store Operations
Participants: VP Store Operations, Account Managers, Regional Store Managers
Source: workflow W1880 — Trade Account Manager Assignment &amp; Coverage Planning</bpmn:documentation>
      <bpmn:laneSet id="W1880_LaneSet3">
        <bpmn:lane id="W1880_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1880_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1880_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1880_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1880_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1880_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1880_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1880_Start4" name="Annual territory planning; Account Manager turnover; account growth requiring reassignment">
        <bpmn:outgoing>W1880_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1880_Task5" name="Annual: VP Store Operations reviews Account Manager coverage: (a) current…">
        <bpmn:documentation>Step 1: Annual: VP Store Operations reviews Account Manager coverage: (a) current account distribution by AM: number of accounts, total managed revenue, geographic coverage, (b) identify imbalances: AMs with &gt; 1,200 accounts or &gt; PHP 5B managed revenue are overloaded; AMs with &lt; 800 accounts may have capacity for more, (c) consider geographic alignment: AMs should cover accounts clustered by region to minimize travel time and maximize store-level coordination, (d) consider specialization: should certain AMs specialize in large contractor accounts (higher touch, fewer accounts) vs. small trade accounts (lower touch, more accounts)?
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1880_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1880_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1880_Task6" name="VP Store Operations reassigns accounts per coverage plan: (a) reassign accounts…">
        <bpmn:documentation>Step 2: VP Store Operations reassigns accounts per coverage plan: (a) reassign accounts between AMs to balance workload and revenue coverage, (b) ensure each AM has a mix of account sizes (not all small or all large), (c) update CRM with new AM assignments, (d) notify affected trade professionals of their new AM with introduction communication
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1880_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1880_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1880_Task7" name="AM develops annual coverage plan for assigned accounts: (a) classify accounts…">
        <bpmn:documentation>Step 3: AM develops annual coverage plan for assigned accounts: (a) classify accounts by engagement frequency: (i) key accounts (top 50 by revenue): monthly in-person visit + weekly call/email, (ii) growth accounts (next 200): quarterly in-person visit + monthly call, (iii) maintained accounts (remaining): semi-annual visit + quarterly call/email, (b) plan store visit schedule to coincide with trade account visits, (c) identify upsell/cross-sell opportunities per account
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1880_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1880_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1880_End8" name="Complete">
        <bpmn:incoming>W1880_Flow14</bpmn:incoming>
      </bpmn:endEvent>
