<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-43.1-trade-account-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1878" name="W1878. Trade Professional Account Application &amp; Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor or trade professional applies for trade account at store or online
Frequency: ~700–1,200 gross new trade account applications/year (≈500–800 net of the 200–400 closures per W1884)
Volume: ~5,200 active trade accounts; ~5–8% annual growth
Owner: Account Manager
Participants: Account Manager, Credit Analyst, Trade Professional, Store Manager
Source: workflow W1878 — Trade Professional Account Application &amp; Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W1878_LaneSet5">
        <bpmn:lane id="W1878_Lane1" name="Trade Professional">
        <bpmn:flowNodeRef>W1878_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1878_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1878_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1878_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1878_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1878_Lane3" name="Credit Analyst">
        <bpmn:flowNodeRef>W1878_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1878_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1878_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1878_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1878_Start6" name="Contractor or trade professional applies for trade account at store or online">
        <bpmn:outgoing>W1878_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1878_Task7" name="Trade professional submits application: (a) full name, business name (if…">
        <bpmn:documentation>Step 1: Trade professional submits application: (a) full name, business name (if applicable), TIN, business address, contact information, trade type (electrical, plumbing, general construction, interior design, architecture, HVAC, other), (b) supporting documents: DTI/SEC registration (if business), PCAB license (Philippine Contractors Accreditation Board — for licensed contractors), PRC license (for architects and engineers), valid government ID, proof of business address (utility bill or lease contract), (c) applicant self-declares estimated annual purchase volume
Responsible (R): Trade Professional
Accountable (A): —
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1878_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1878_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1878_Task8" name="Account Manager reviews application: (a) verify documents are complete and…">
        <bpmn:documentation>Step 2: Account Manager reviews application: (a) verify documents are complete and authentic, (b) check for duplicate accounts (same TIN or business name already in system), (c) classify trade type and assign segmentation: (i) solo professional (electrician, plumber): expected PHP 100K–500K/year, (ii) small contractor (1–5 employees): PHP 500K–3M/year, (iii) medium contractor (6–50 employees): PHP 3M–20M/year, (iv) large contractor / developer: PHP 20M+/year, (v) architect / designer: PHP 200K–2M/year (specification influence but lower direct purchase volume)
Responsible (R): Account Manager
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1878_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1878_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1878_Task9" name="Credit Analyst processes credit application per W24 (credit application &amp;…">
        <bpmn:documentation>Step 3: Credit Analyst processes credit application per W24 (credit application &amp; scoring): (a) credit check: verify no adverse BIR, bank, or supplier references, (b) set initial credit limit per segmentation: solo PHP 50K, small PHP 200K, medium PHP 1M, large PHP 5M+ (subject to credit scoring), (c) set payment terms: Net 30 for solo/small; Net 30–60 for medium; Net 60–90 for large, (d) Credit Manager approves per tiered authority
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: Per W24</bpmn:documentation>
        <bpmn:incoming>W1878_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1878_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1878_Task10" name="Account Manager completes onboarding: (a) create trade account in CRM/ERP with…">
        <bpmn:documentation>Step 4: Account Manager completes onboarding: (a) create trade account in CRM/ERP with full profile and segmentation, (b) assign dedicated Account Manager based on geographic coverage and account size, (c) issue trade account card (physical + digital) with trade pricing access, (d) provide welcome kit: (i) trade pricing guide (5–15% discount structure by category), (ii) credit terms summary, (iii) dedicated Account Manager contact information, (iv) trade program benefits overview (W1549 contractor annual tier review), (v) buildright.com.ph trade portal login, (e) schedule introductory meeting at account&#x27;s preferred store for store team introduction
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1878_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1878_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1878_Task11" name="Store Manager and Department Supervisors introduced to new trade account: (a)…">
        <bpmn:documentation>Step 5: Store Manager and Department Supervisors introduced to new trade account: (a) recognize the contractor at their primary store, (b) brief Sales Associates on contractor&#x27;s trade type and typical purchase needs, (c) ensure trade pricing is active in POS for account card scan
Responsible (R): Store Manager
Accountable (A): Account Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1878_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1878_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1878_End12" name="Complete">
        <bpmn:incoming>W1878_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1878_Annotation13">
        <bpmn:text>Controls: - CTL-370 (ensure controlled execution — Trade Account Lifecycle &amp; Relationship Management (PA-43.1).) | - operational: Account Manager review and approval gate
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1878_Assoc14" sourceRef="W1878_Annotation13" targetRef="W1878_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1878_Flow15" sourceRef="W1878_Start6" targetRef="W1878_Task7" />
      <bpmn:sequenceFlow id="W1878_Flow16" sourceRef="W1878_Task7" targetRef="W1878_Task8" />
      <bpmn:sequenceFlow id="W1878_Flow17" sourceRef="W1878_Task8" targetRef="W1878_Task9" />
      <bpmn:sequenceFlow id="W1878_Flow18" sourceRef="W1878_Task9" targetRef="W1878_Task10" />
      <bpmn:sequenceFlow id="W1878_Flow19" sourceRef="W1878_Task10" targetRef="W1878_Task11" />
      <bpmn:sequenceFlow id="W1878_Flow20" sourceRef="W1878_Task11" targetRef="W1878_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1878_diag">
      <bpmndi:BPMNPlane id="W1878_plane" bpmnElement="W_W1878">
        <bpmndi:BPMNShape id="W1878_Lane1_di" bpmnElement="W1878_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
