    <bpmn:process id="W_W1885" name="W1885. Trade Account Master Data Quality &amp; Segmentation Review" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual data quality audit
Frequency: Semi-annual
Volume: ~5,200 trade accounts
Owner: CRM Data Analyst
Participants: CRM Data Analyst, Account Managers, Finance
Source: workflow W1885 — Trade Account Master Data Quality &amp; Segmentation Review</bpmn:documentation>
      <bpmn:laneSet id="W1885_LaneSet3">
        <bpmn:lane id="W1885_Lane1" name="CRM Data Analyst">
        <bpmn:flowNodeRef>W1885_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1885_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1885_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1885_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W1885_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1885_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1885_Start4" name="Semi-annual data quality audit">
        <bpmn:outgoing>W1885_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1885_Task5" name="CRM Data Analyst runs data quality checks: (a) completeness: % of accounts with…">
        <bpmn:documentation>Step 1: CRM Data Analyst runs data quality checks: (a) completeness: % of accounts with all required fields populated (contact info, trade type, TIN, segmentation), (b) accuracy: sample 100 accounts for phone verification — are contact numbers still valid?, (c) duplication: detect duplicate accounts (same TIN, similar name, same address), (d) segmentation accuracy: do account segmentation labels match actual purchase behavior? (e.g., account labeled &quot;small contractor&quot; but spending PHP 5M/year should be &quot;medium contractor&quot;)
Responsible (R): CRM Data Analyst
Accountable (A): VP Store Operations
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1885_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1885_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1885_Task6" name="Account Manager action data quality issues: (a) update incorrect or missing…">
        <bpmn:documentation>Step 2: Account Manager action data quality issues: (a) update incorrect or missing contact information, (b) merge duplicate accounts, (c) correct segmentation mismatches, (d) update dormant or closed accounts
Responsible (R): Account Manager
Accountable (A): VP Store Operations
Duration: 1–2 days/cycle</bpmn:documentation>
        <bpmn:incoming>W1885_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1885_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1885_Task7" name="Semi-annual: CRM Data Analyst presents data quality report to VP Store…">
        <bpmn:documentation>Step 3: Semi-annual: CRM Data Analyst presents data quality report to VP Store Operations: (a) data quality score (% of accounts with complete, accurate data), (b) improvement trend vs. previous audit, (c) specific issues requiring process changes (e.g., Account Managers not updating records after visits)
Responsible (R): CRM Data Analyst
Accountable (A): VP Store Operations
Duration: 1 day/cycle</bpmn:documentation>
        <bpmn:incoming>W1885_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1885_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1885_End8" name="Complete">
        <bpmn:incoming>W1885_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1885_Annotation9">
        <bpmn:text>Controls: - CTL-189 (ensure trade-program benefit &amp; master-data integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: CRM Data Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1885_Assoc10" sourceRef="W1885_Annotation9" targetRef="W1885_Start4" associationDirection="None" />
