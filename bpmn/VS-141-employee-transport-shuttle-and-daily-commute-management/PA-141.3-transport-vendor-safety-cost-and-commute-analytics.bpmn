Responsible (R): People Analytics / Finance
Accountable (A): CHRO / COO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4262_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4262_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4262_Task7" name="HR/Transport act on findings (extend coverage W4254, redesign routes W4263…">
