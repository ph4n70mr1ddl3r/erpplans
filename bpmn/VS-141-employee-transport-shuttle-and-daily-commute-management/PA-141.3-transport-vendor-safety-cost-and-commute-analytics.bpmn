      <bpmndi:BPMNPlane id="W4257_plane" bpmnElement="W_W4257">
        <bpmndi:BPMNShape id="W4257_Lane1_di" bpmnElement="W4257_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
