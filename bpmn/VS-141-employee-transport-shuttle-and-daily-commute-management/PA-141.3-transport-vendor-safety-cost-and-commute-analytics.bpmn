    <bpmn:process id="W_W4258" name="W4258. Transport Vendor SLA, Performance &amp; Rate Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contract start (W4257); monthly QBR; SLA breach
Frequency: Monthly review + continuous monitoring
Volume: SLA performance per vendor × route × month
Owner: Transport Lead / Procurement (VS-34)
Participants: Site Managers, Finance (VS-17.4), HSE (VS-24)
Source: workflow W4258 — Transport Vendor SLA, Performance &amp; Rate Management</bpmn:documentation>
      <bpmn:laneSet id="W4258_LaneSet2">
        <bpmn:lane id="W4258_Lane1" name="Transport Lead">
        <bpmn:flowNodeRef>W4258_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4258_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4258_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4258_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4258_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4258_Start3" name="Contract start (W4257); monthly QBR; SLA breach">
        <bpmn:outgoing>W4258_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4258_Task4" name="Transport define and track the SLA (on-time pickup/arrival, vehicle/driver…">
        <bpmn:documentation>Step 1: Transport define and track the SLA (on-time pickup/arrival, vehicle/driver standard adherence, safety incidents, no-show response time, complaint resolution), and capture data from dispatch (W4250)
Responsible (R): Transport Lead / Dispatcher
Accountable (A): COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4258_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4258_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4258_Task5" name="Transport/Procurement run the monthly/quarterly business review with vendors…">
        <bpmn:documentation>Step 2: Transport/Procurement run the monthly/quarterly business review with vendors (performance scorecard, breach penalties/incentives, capacity changes), and manage rate changes (fuel-index clauses)
Responsible (R): Transport Lead / Procurement
Accountable (A): COO
Duration: Monthly/Qtrly</bpmn:documentation>
        <bpmn:incoming>W4258_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4258_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4258_Task6" name="Transport manage corrective action/penalty enforcement, vendor development, and…">
        <bpmn:documentation>Step 3: Transport manage corrective action/penalty enforcement, vendor development, and exit/replacement on sustained underperformance (coordinate VS-03/VS-34)
Responsible (R): Transport Lead / Procurement / Legal
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4258_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4258_End7" name="Complete">
        <bpmn:incoming>W4258_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4258_Annotation8">
        <bpmn:text>Controls: - CTL-655 (ensure controlled execution — Transport Vendor, Safety, Cost &amp; Commute Analytics (PA-141.3).) | - CTL-655: SLA tracked &amp; enforced; rate changes governed/justified; underperformance acted on
Owner: Transport Lead / Procurement (VS-34)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4258_Assoc9" sourceRef="W4258_Annotation8" targetRef="W4258_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4258_Flow10" sourceRef="W4258_Start3" targetRef="W4258_Task4" />
      <bpmn:sequenceFlow id="W4258_Flow11" sourceRef="W4258_Task4" targetRef="W4258_Task5" />
      <bpmn:sequenceFlow id="W4258_Flow12" sourceRef="W4258_Task5" targetRef="W4258_Task6" />
      <bpmn:sequenceFlow id="W4258_Flow13" sourceRef="W4258_Task6" targetRef="W4258_End7" />
    </bpmn:process>
