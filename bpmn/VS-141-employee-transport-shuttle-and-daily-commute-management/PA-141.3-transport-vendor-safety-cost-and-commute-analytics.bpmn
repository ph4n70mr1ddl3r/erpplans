    <bpmn:process id="W_W4257" name="W4257. Shuttle/Charter Vendor Sourcing, Qualification &amp; Contracting" isExecutable="false">
      <bpmn:documentation>Trigger: Operating model (W4244) selecting contracted service; vendor-market review; expansion
Frequency: Per sourcing cycle + onboarding
Volume: Regional shuttle/charter vendors across Mindanao/Visayas/Luzon/NCR
Owner: Procurement (VS-34) / Transport Lead
Participants: Legal (VS-100.3), Insurance (VS-26), HSE (VS-24), Finance (VS-17.4), Contingent Workforce (VS-98)
Source: workflow W4257 — Shuttle/Charter Vendor Sourcing, Qualification &amp; Contracting</bpmn:documentation>
      <bpmn:laneSet id="W4257_LaneSet2">
        <bpmn:lane id="W4257_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W4257_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4257_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4257_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4257_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4257_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4257_Start3" name="Operating model (W4244) selecting contracted service; vendor-market review; expansion">
        <bpmn:outgoing>W4257_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4257_Task4" name="Procurement/Transport run a sourcing event (RFP/RFQ) for shuttle/charter…">
        <bpmn:documentation>Step 1: Procurement/Transport run a sourcing event (RFP/RFQ) for shuttle/charter vendors per region, defining service specs (routes, shifts, vehicle standard, driver standard, safety/insurance)
Responsible (R): Procurement / Transport Lead
Accountable (A): COO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4257_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4257_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4257_Task5" name="Procurement/Legal/HSE qualify bidders (LTFRB franchise, LTO-registered…">
        <bpmn:documentation>Step 2: Procurement/Legal/HSE qualify bidders (LTFRB franchise, LTO-registered vehicles, driver licensing/clearance, passenger-liability insurance, HSE/DOLE record, financial standing)
Responsible (R): Procurement / Legal / HSE
Accountable (A): COO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4257_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4257_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4257_Task6" name="Procurement/Legal negotiate and execute the master service agreement (rates…">
        <bpmn:documentation>Step 3: Procurement/Legal negotiate and execute the master service agreement (rates, SLA, insurance indemnity, termination), onboard the vendor (coordinate VS-98 for embedded drivers), and load to vendor master (VS-03)
Responsible (R): Procurement / Legal
Accountable (A): COO / CFO
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W4257_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4257_End7" name="Complete">
        <bpmn:incoming>W4257_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4257_Annotation8">
        <bpmn:text>Controls: - CTL-655 (ensure controlled execution — Transport Vendor, Safety, Cost &amp; Commute Analytics (PA-141.3).) | - CTL-655: vendor LTFRB-franchised &amp; insured (VS-26); HSE/DOLE record checked; contract Legal-reviewed (VS-100.3)
Owner: Procurement (VS-34) / Transport Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4257_Assoc9" sourceRef="W4257_Annotation8" targetRef="W4257_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4257_Flow10" sourceRef="W4257_Start3" targetRef="W4257_Task4" />
      <bpmn:sequenceFlow id="W4257_Flow11" sourceRef="W4257_Task4" targetRef="W4257_Task5" />
      <bpmn:sequenceFlow id="W4257_Flow12" sourceRef="W4257_Task5" targetRef="W4257_Task6" />
      <bpmn:sequenceFlow id="W4257_Flow13" sourceRef="W4257_Task6" targetRef="W4257_End7" />
    </bpmn:process>
