      <bpmn:sequenceFlow id="W3763_Flow11" sourceRef="W3763_Task4" targetRef="W3763_Task5" />
      <bpmn:sequenceFlow id="W3763_Flow12" sourceRef="W3763_Task5" targetRef="W3763_Task6" />
      <bpmn:sequenceFlow id="W3763_Flow13" sourceRef="W3763_Task6" targetRef="W3763_End7" />
    </bpmn:process>
