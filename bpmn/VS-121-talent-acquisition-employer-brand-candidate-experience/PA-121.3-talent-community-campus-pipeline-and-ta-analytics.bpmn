Responsible (R): TA Marketing / EX
Accountable (A): TA Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3781_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3781_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3781_Task6" name="TA Marketing/Analytics measure referral yield (share of hires…">
