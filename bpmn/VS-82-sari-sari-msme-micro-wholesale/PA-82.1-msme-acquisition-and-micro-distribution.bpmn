    <bpmn:process id="W_W2825" name="W2825. Sari-Sari Store &amp; MSME Prospecting, Onboarding &amp; KYC" isExecutable="false">
      <bpmn:documentation>Trigger: Field acquisition campaign; in-store sign-up
Frequency: Continuous
Volume: Target ~50,000 active MSME partners within 3 years
Owner: MSME Sales Manager
Participants: MSME Sales, Field Sales, Compliance, AR
Source: workflow W2825 — Sari-Sari Store &amp; MSME Prospecting, Onboarding &amp; KYC</bpmn:documentation>
      <bpmn:laneSet id="W2825_LaneSet4">
        <bpmn:lane id="W2825_Lane1" name="Field Sales">
        <bpmn:flowNodeRef>W2825_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2825_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2825_Lane2" name="Compliance">
        <bpmn:flowNodeRef>W2825_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2825_Lane3" name="AR">
        <bpmn:flowNodeRef>W2825_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2825_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2825_Start5" name="Field acquisition campaign; in-store sign-up">
        <bpmn:outgoing>W2825_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2825_Task6" name="Field Sales prospects sari-sari stores, hardware mini-marts, small contractors…">
        <bpmn:documentation>Step 1: Field Sales prospects sari-sari stores, hardware mini-marts, small contractors in store catchment; registers via app with store photo, location, owner ID
Responsible (R): Field Sales
Accountable (A): MSME Sales Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2825_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2825_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2825_Task7" name="Compliance performs KYC: DTI/SEC/Mayor&#x27;s permit, owner valid ID, BIR TIN…">
        <bpmn:documentation>Step 2: Compliance performs KYC: DTI/SEC/Mayor&#x27;s permit, owner valid ID, BIR TIN; validates business legitimacy; screens for sanctions/AML (W2921 linkage)
Responsible (R): Compliance / AR
Accountable (A): MSME Sales Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2825_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2825_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2825_Task8" name="AR creates MSME account in customer master with tier, credit terms, default…">
        <bpmn:documentation>Step 3: AR creates MSME account in customer master with tier, credit terms, default reorder list; activates in loyalty-as-reseller program
Responsible (R): AR
Accountable (A): AR Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2825_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2825_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2825_End9" name="Complete">
        <bpmn:incoming>W2825_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2825_Annotation10">
        <bpmn:text>Controls: - CTL-206 (ensure MSME micro-wholesale credit &amp; order integrity.) | - operational: ID/permit validation and sanctions screening
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2825_Assoc11" sourceRef="W2825_Annotation10" targetRef="W2825_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2825_Flow12" sourceRef="W2825_Start5" targetRef="W2825_Task6" />
      <bpmn:sequenceFlow id="W2825_Flow13" sourceRef="W2825_Task6" targetRef="W2825_Task7" />
      <bpmn:sequenceFlow id="W2825_Flow14" sourceRef="W2825_Task7" targetRef="W2825_Task8" />
      <bpmn:sequenceFlow id="W2825_Flow15" sourceRef="W2825_Task8" targetRef="W2825_End9" />
    </bpmn:process>
