    <bpmn:process id="W_W2827" name="W2827. Micro-Reseller Right-Sized Assortment &amp; Reorder List Curation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly assortment review; new MSME segment
Frequency: Quarterly + event-driven
Volume: ~500–800 SKUs in micro-wholesale assortment
Owner: Category Manager
Participants: Category Manager, MSME Sales, Merchandising
Source: workflow W2827 — Micro-Reseller Right-Sized Assortment &amp; Reorder List Curation</bpmn:documentation>
      <bpmn:laneSet id="W2827_LaneSet4">
        <bpmn:lane id="W2827_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2827_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2827_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2827_Lane2" name="Merchandising">
        <bpmn:flowNodeRef>W2827_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2827_Lane3" name="MSME Sales">
        <bpmn:flowNodeRef>W2827_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2827_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2827_Start5" name="Quarterly assortment review; new MSME segment">
        <bpmn:outgoing>W2827_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2827_Task6" name="Category Manager curates right-sized assortment for sari-sari resale…">
        <bpmn:documentation>Step 1: Category Manager curates right-sized assortment for sari-sari resale: fast-moving hardware, basic electrical/plumbing, paints, adhesives, fasteners in small pack sizes
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2827_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2827_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2827_Task7" name="Merchandising configures default reorder lists per MSME segment (sari-sari vs…">
        <bpmn:documentation>Step 2: Merchandising configures default reorder lists per MSME segment (sari-sari vs. mini-mart vs. contractor); sets suggested order quantities
Responsible (R): Merchandising
Accountable (A): Category Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2827_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2827_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2827_Task8" name="MSME Sales reviews sell-through by MSME segment; recommends assortment…">
        <bpmn:documentation>Step 3: MSME Sales reviews sell-through by MSME segment; recommends assortment additions/deletions based on demand patterns
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2827_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2827_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2827_End9" name="Complete">
        <bpmn:incoming>W2827_Flow15</bpmn:incoming>
      </bpmn:endEvent>
