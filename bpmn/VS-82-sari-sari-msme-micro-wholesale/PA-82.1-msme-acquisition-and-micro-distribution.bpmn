    <bpmn:process id="W_W2826" name="W2826. &quot;BuildRight Negosyo Partner&quot; Tier, Pricing &amp; Benefits Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: New partner onboarding; tier reclassification
Frequency: Event-driven + quarterly review
Volume: 4 tiers (Bronze/Silver/Gold/Platinum)
Owner: MSME Sales Manager
Participants: MSME Sales, Pricing, Marketing, Loyalty
Source: workflow W2826 — &quot;BuildRight Negosyo Partner&quot; Tier, Pricing &amp; Benefits Configuration</bpmn:documentation>
      <bpmn:laneSet id="W2826_LaneSet4">
        <bpmn:lane id="W2826_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W2826_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2826_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2826_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2826_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2826_Lane3" name="MSME Sales">
        <bpmn:flowNodeRef>W2826_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2826_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2826_Start5" name="New partner onboarding; tier reclassification">
        <bpmn:outgoing>W2826_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2826_Task6" name="Pricing configures tier-based wholesale discount (3%–12% off SRP), volume…">
        <bpmn:documentation>Step 1: Pricing configures tier-based wholesale discount (3%–12% off SRP), volume rebates, and exclusive &quot;Negosyo&quot; SKU pricing in ERP customer price matrix
Responsible (R): Pricing
Accountable (A): MSME Sales Manager
Duration: Per tier</bpmn:documentation>
        <bpmn:incoming>W2826_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2826_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2826_Task7" name="Marketing sets tier benefits: free delivery threshold, priority allocation…">
        <bpmn:documentation>Step 2: Marketing sets tier benefits: free delivery threshold, priority allocation, Negosyo Academy access, loyalty points multiplier, financing access
Responsible (R): Marketing
Accountable (A): CMO
Duration: Per tier</bpmn:documentation>
        <bpmn:incoming>W2826_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2826_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2826_Task8" name="MSME Sales reviews tier qualification quarterly based on purchase volume…">
        <bpmn:documentation>Step 3: MSME Sales reviews tier qualification quarterly based on purchase volume; upgrades/downgrades accounts; communicates changes
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2826_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2826_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2826_End9" name="Complete">
        <bpmn:incoming>W2826_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2826_Annotation10">
        <bpmn:text>Controls: - CTL-475 (ensure controlled execution — MSME/Sari-Sari Account Acquisition &amp; Micro-Distribution (PA-82.1).) | - operational: tier economics modeling
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2826_Assoc11" sourceRef="W2826_Annotation10" targetRef="W2826_Start5" associationDirection="None" />
