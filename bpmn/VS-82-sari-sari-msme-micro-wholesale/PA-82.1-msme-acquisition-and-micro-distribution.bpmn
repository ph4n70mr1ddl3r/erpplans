    <bpmn:process id="W_W2832" name="W2832. MSME Account Health, Churn Prevention &amp; Win-Back" isExecutable="false">
      <bpmn:documentation>Trigger: Account inactivity alert (no order &gt; 30 days)
Frequency: Weekly review + event-driven
Volume: ~50,000 active accounts
Owner: MSME Sales Manager
Participants: MSME Sales, Field Sales, Loyalty
Source: workflow W2832 — MSME Account Health, Churn Prevention &amp; Win-Back</bpmn:documentation>
      <bpmn:laneSet id="W2832_LaneSet4">
        <bpmn:lane id="W2832_Lane1" name="Loyalty">
        <bpmn:flowNodeRef>W2832_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2832_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2832_Lane2" name="Field Sales">
        <bpmn:flowNodeRef>W2832_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2832_Lane3" name="MSME Sales">
        <bpmn:flowNodeRef>W2832_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2832_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2832_Start5" name="Account inactivity alert (no order &gt; 30 days)">
        <bpmn:outgoing>W2832_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2832_Task6" name="Loyalty/MSME Sales monitors account health score (recency, frequency, basket…">
        <bpmn:documentation>Step 1: Loyalty/MSME Sales monitors account health score (recency, frequency, basket trend); flags at-risk accounts for intervention
Responsible (R): Loyalty / MSME Sales
Accountable (A): MSME Sales Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2832_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2832_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2832_Task7" name="Field Sales contacts at-risk MSME; diagnoses reason (price, competition…">
        <bpmn:documentation>Step 2: Field Sales contacts at-risk MSME; diagnoses reason (price, competition, stockout, closure); offers targeted win-back incentive
Responsible (R): Field Sales
Accountable (A): MSME Sales Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2832_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2832_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2832_Task8" name="MSME Sales reports churn rate and win-back conversion; refines retention…">
        <bpmn:documentation>Step 3: MSME Sales reports churn rate and win-back conversion; refines retention playbook and incentive design
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2832_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2832_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2832_End9" name="Complete">
        <bpmn:incoming>W2832_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2832_Annotation10">
        <bpmn:text>Controls: - CTL-475 (ensure controlled execution — MSME/Sari-Sari Account Acquisition &amp; Micro-Distribution (PA-82.1).) | - operational: health-score monitoring and proactive outreach
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
