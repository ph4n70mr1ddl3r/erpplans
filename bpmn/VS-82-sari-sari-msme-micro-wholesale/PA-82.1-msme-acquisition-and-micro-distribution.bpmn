    <bpmn:process id="W_W2828" name="W2828. MSME Product Knowledge, Negosyo Academy &amp; Retailer Training" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly content calendar; new product launch
Frequency: Quarterly + campaign-driven
Volume: ~50,000 MSME partners
Owner: Training Manager
Participants: Training Mgr, Category Manager, MSME Sales, Marketing
Source: workflow W2828 — MSME Product Knowledge, Negosyo Academy &amp; Retailer Training</bpmn:documentation>
      <bpmn:laneSet id="W2828_LaneSet4">
        <bpmn:lane id="W2828_Lane1" name="Training Manager">
        <bpmn:flowNodeRef>W2828_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2828_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2828_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2828_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2828_Lane3" name="MSME Sales">
        <bpmn:flowNodeRef>W2828_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2828_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2828_Start5" name="Quarterly content calendar; new product launch">
        <bpmn:outgoing>W2828_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2828_Task6" name="Training develops &quot;Negosyo Academy&quot; curriculum: basic business skills…">
        <bpmn:documentation>Step 1: Training develops &quot;Negosyo Academy&quot; curriculum: basic business skills, inventory management, merchandising, product knowledge, digital payments adoption
Responsible (R): Training Manager
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2828_Flow12</bpmn:incoming>
