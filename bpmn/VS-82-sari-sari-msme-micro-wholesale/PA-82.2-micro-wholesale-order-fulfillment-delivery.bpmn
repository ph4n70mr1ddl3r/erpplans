      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2834" name="W2834. MSME Order Validation, Credit Check &amp; Confirmation" isExecutable="false">
      <bpmn:documentation>Trigger: Order captured in ERP
Frequency: Per order
Volume: ~10,000–20,000 orders/week
Owner: AR Analyst
Participants: AR, MSME Sales, Credit
Source: workflow W2834 — MSME Order Validation, Credit Check &amp; Confirmation</bpmn:documentation>
      <bpmn:laneSet id="W2834_LaneSet4">
        <bpmn:lane id="W2834_Lane1" name="ERP automation">
        <bpmn:flowNodeRef>W2834_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2834_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2834_Lane2" name="AR">
        <bpmn:flowNodeRef>W2834_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2834_Lane3" name="MSME Sales">
        <bpmn:flowNodeRef>W2834_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2834_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2834_Start5" name="Order captured in ERP">
        <bpmn:outgoing>W2834_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2834_Task6" name="ERP auto-validates order: tier pricing, credit limit (if on credit terms)…">
        <bpmn:documentation>Step 1: ERP auto-validates order: tier pricing, credit limit (if on credit terms), overdue balance, delivery eligibility by location
Responsible (R): ERP automation
Accountable (A): AR Analyst
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2834_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2834_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2834_Task7" name="AR reviews flagged orders (over-limit, overdue, first-time large)…">
        <bpmn:documentation>Step 2: AR reviews flagged orders (over-limit, overdue, first-time large); approves/declines or routes to MSME Sales Manager
Responsible (R): AR
Accountable (A): AR Manager
Duration: Per flagged order</bpmn:documentation>
        <bpmn:incoming>W2834_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2834_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2834_Task8" name="MSME Sales confirms order with MSME (amount, delivery date); triggers…">
        <bpmn:documentation>Step 3: MSME Sales confirms order with MSME (amount, delivery date); triggers fulfillment release
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2834_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2834_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2834_End9" name="Complete">
        <bpmn:incoming>W2834_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2834_Annotation10">
        <bpmn:text>Controls: - CTL-206 (ensure MSME micro-wholesale credit &amp; order integrity.) | - operational: conservative limits and credit-bureau-style scoring (W2921)
Owner: AR Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2834_Assoc11" sourceRef="W2834_Annotation10" targetRef="W2834_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2834_Flow12" sourceRef="W2834_Start5" targetRef="W2834_Task6" />
      <bpmn:sequenceFlow id="W2834_Flow13" sourceRef="W2834_Task6" targetRef="W2834_Task7" />
      <bpmn:sequenceFlow id="W2834_Flow14" sourceRef="W2834_Task7" targetRef="W2834_Task8" />
      <bpmn:sequenceFlow id="W2834_Flow15" sourceRef="W2834_Task8" targetRef="W2834_End9" />
    </bpmn:process>
