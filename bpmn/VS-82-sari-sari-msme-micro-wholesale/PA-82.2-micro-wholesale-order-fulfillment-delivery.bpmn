      <bpmn:userTask id="W2840_Task7" name="DC Ops/Logistics escalates capacity constraints (peak demand, vehicle…">
        <bpmn:documentation>Step 2: DC Ops/Logistics escalates capacity constraints (peak demand, vehicle shortage); re-balances routes and fulfillment sourcing
Responsible (R): DC Ops / Logistics
Accountable (A): MSME Operations Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2840_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2840_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2840_Task8" name="IT monitors order capture system uptime across channels; addresses bottlenecks…">
        <bpmn:documentation>Step 3: IT monitors order capture system uptime across channels; addresses bottlenecks; scales for growth to 50K MSMEs
Responsible (R): IT
Accountable (A): MSME Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2840_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2840_Flow15</bpmn:outgoing>
      </bpmn:userTask>
