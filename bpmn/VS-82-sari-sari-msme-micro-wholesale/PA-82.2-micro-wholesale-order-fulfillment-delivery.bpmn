    <bpmn:process id="W_W2836" name="W2836. Last-Mile Delivery to Sari-Sari / Micro-Account (Tricycle/Multicab)" isExecutable="false">
      <bpmn:documentation>Trigger: Order ready for delivery
Frequency: Daily; route-based
Volume: ~10,000–20,000 deliveries/week
Owner: Logistics Supervisor
Participants: Logistics, Driver/Courier, MSME Partner
Source: workflow W2836 — Last-Mile Delivery to Sari-Sari / Micro-Account (Tricycle/Multicab)</bpmn:documentation>
      <bpmn:laneSet id="W2836_LaneSet3">
        <bpmn:lane id="W2836_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W2836_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2836_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2836_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2836_Lane2" name="Driver">
        <bpmn:flowNodeRef>W2836_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2836_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2836_Start4" name="Order ready for delivery">
        <bpmn:outgoing>W2836_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2836_Task5" name="Logistics plans multi-drop routes using lightweight vehicles (tricycle…">
        <bpmn:documentation>Step 1: Logistics plans multi-drop routes using lightweight vehicles (tricycle, multicab, Lalamove) optimized for narrow streets and small baskets
Responsible (R): Logistics
Accountable (A): Logistics Supervisor
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2836_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2836_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2836_Task6" name="Driver/courier delivers to sari-sari store; verifies recipient; collects…">
        <bpmn:documentation>Step 2: Driver/courier delivers to sari-sari store; verifies recipient; collects payment (COD) or e-wallet confirmation; captures digital POD
Responsible (R): Driver/Courier
Accountable (A): Logistics Supervisor
Duration: Per drop</bpmn:documentation>
        <bpmn:incoming>W2836_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2836_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2836_Task7" name="Logistics tracks on-time delivery, route efficiency, and damage rate; reports…">
        <bpmn:documentation>Step 3: Logistics tracks on-time delivery, route efficiency, and damage rate; reports MSME delivery satisfaction
Responsible (R): Logistics
Accountable (A): Logistics Supervisor
