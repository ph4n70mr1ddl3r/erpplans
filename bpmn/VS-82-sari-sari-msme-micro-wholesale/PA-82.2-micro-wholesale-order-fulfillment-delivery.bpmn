    <bpmn:process id="W_W2835" name="W2835. Micro-Wholesale Pick, Pack &amp; Aggregated Basket Build" isExecutable="false">
      <bpmn:documentation>Trigger: Order released to DC or store fulfillment
Frequency: Daily
Volume: ~10,000–20,000 orders/week
Owner: DC Operations Supervisor
Participants: DC Ops, Picker, Packer
Source: workflow W2835 — Micro-Wholesale Pick, Pack &amp; Aggregated Basket Build</bpmn:documentation>
      <bpmn:laneSet id="W2835_LaneSet3">
        <bpmn:lane id="W2835_Lane1" name="DC Ops">
        <bpmn:flowNodeRef>W2835_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2835_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2835_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2835_Lane2" name="Picker">
        <bpmn:flowNodeRef>W2835_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2835_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2835_Start4" name="Order released to DC or store fulfillment">
        <bpmn:outgoing>W2835_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2835_Task5" name="DC Ops aggregates orders by delivery route/geography; generates consolidated…">
        <bpmn:documentation>Step 1: DC Ops aggregates orders by delivery route/geography; generates consolidated pick list optimizing travel within DC
Responsible (R): DC Ops
Accountable (A): DC Operations Supervisor
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2835_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2835_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2835_Task6" name="Picker picks per consolidated list; packer builds per-order baskets with right…">
        <bpmn:documentation>Step 2: Picker picks per consolidated list; packer builds per-order baskets with right pack sizes; applies MSME-branded packaging and price tags
Responsible (R): Picker / Packer
Accountable (A): DC Operations Supervisor
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2835_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2835_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2835_Task7" name="DC Ops stages baskets by route; performs pre-dispatch quality check; loads for…">
        <bpmn:documentation>Step 3: DC Ops stages baskets by route; performs pre-dispatch quality check; loads for last-mile delivery
Responsible (R): DC Ops
Accountable (A): DC Operations Supervisor
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2835_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2835_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2835_End8" name="Complete">
        <bpmn:incoming>W2835_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2835_Annotation9">
        <bpmn:text>Controls: - CTL-476 (ensure controlled execution — Micro-Wholesale Ordering, Fulfillment &amp; Delivery (PA-82.2).) | - operational: route aggregation
Owner: DC Operations Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2835_Assoc10" sourceRef="W2835_Annotation9" targetRef="W2835_Start4" associationDirection="None" />
