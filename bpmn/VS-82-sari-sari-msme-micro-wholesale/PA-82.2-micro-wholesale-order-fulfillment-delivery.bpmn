<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-82.2-micro-wholesale-order-fulfillment-delivery" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2833" name="W2833. MSME Multi-Channel Ordering (App/WhatsApp/Call/Sales Rep) Capture" isExecutable="false">
      <bpmn:documentation>Trigger: MSME places order
Frequency: Weekly per active MSME
Volume: ~50,000 MSMEs; ~10,000–20,000 orders/week at maturity
Owner: MSME Sales Manager
Participants: MSME Sales, Customer Service, IT
Source: workflow W2833 — MSME Multi-Channel Ordering (App/WhatsApp/Call/Sales Rep) Capture</bpmn:documentation>
      <bpmn:laneSet id="W2833_LaneSet4">
        <bpmn:lane id="W2833_Lane1" name="MSME Partner">
        <bpmn:flowNodeRef>W2833_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2833_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2833_Lane2" name="IT">
        <bpmn:flowNodeRef>W2833_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2833_Lane3" name="Customer Service">
        <bpmn:flowNodeRef>W2833_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2833_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2833_Start5" name="MSME places order">
        <bpmn:outgoing>W2833_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2833_Task6" name="MSME places order via preferred channel: mobile app (preferred), WhatsApp/SMS…">
        <bpmn:documentation>Step 1: MSME places order via preferred channel: mobile app (preferred), WhatsApp/SMS, call center, or field rep tablet; each captures standardized order data
Responsible (R): MSME Partner / Customer Service
Accountable (A): MSME Sales Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2833_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2833_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2833_Task7" name="IT normalizes multi-channel orders into single ERP order queue; auto-applies…">
        <bpmn:documentation>Step 2: IT normalizes multi-channel orders into single ERP order queue; auto-applies tier pricing and default reorder list; validates SKU availability
Responsible (R): IT / ERP automation
Accountable (A): MSME Sales Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2833_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2833_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2833_Task8" name="Customer Service handles exceptions (out-of-stock substitution, address…">
        <bpmn:documentation>Step 3: Customer Service handles exceptions (out-of-stock substitution, address correction); confirms order with MSME via channel of choice
Responsible (R): Customer Service
Accountable (A): MSME Sales Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2833_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2833_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2833_End9" name="Complete">
        <bpmn:incoming>W2833_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2833_Annotation10">
        <bpmn:text>Controls: - CTL-206 (ensure MSME micro-wholesale credit &amp; order integrity.) | - operational: app migration and structured capture templates
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2833_Assoc11" sourceRef="W2833_Annotation10" targetRef="W2833_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2833_Flow12" sourceRef="W2833_Start5" targetRef="W2833_Task6" />
      <bpmn:sequenceFlow id="W2833_Flow13" sourceRef="W2833_Task6" targetRef="W2833_Task7" />
      <bpmn:sequenceFlow id="W2833_Flow14" sourceRef="W2833_Task7" targetRef="W2833_Task8" />
      <bpmn:sequenceFlow id="W2833_Flow15" sourceRef="W2833_Task8" targetRef="W2833_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2833_diag">
      <bpmndi:BPMNPlane id="W2833_plane" bpmnElement="W_W2833">
        <bpmndi:BPMNShape id="W2833_Lane1_di" bpmnElement="W2833_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2833_Lane2_di" bpmnElement="W2833_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2833_Lane3_di" bpmnElement="W2833_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
