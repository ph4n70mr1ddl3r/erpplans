    <bpmn:process id="W_W2841" name="W2841. MSME Micro-Credit &amp; &quot;Negosyo Loan&quot; Origination (Partner Bank/SBCorp)" isExecutable="false">
      <bpmn:documentation>Trigger: MSME requests financing for inventory/capex
Frequency: Event-driven; growing demand
Volume: ~5,000–10,000 financed MSMEs at maturity
Owner: MSME Sales Manager
Participants: MSME Sales, Partner Bank, Treasury, Compliance
Source: workflow W2841 — MSME Micro-Credit &amp; &quot;Negosyo Loan&quot; Origination (Partner Bank/SBCorp)</bpmn:documentation>
      <bpmn:laneSet id="W2841_LaneSet4">
        <bpmn:lane id="W2841_Lane1" name="MSME Sales">
        <bpmn:flowNodeRef>W2841_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2841_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2841_Lane2" name="Partner Bank">
        <bpmn:flowNodeRef>W2841_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2841_Lane3" name="Compliance">
        <bpmn:flowNodeRef>W2841_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2841_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2841_Start5" name="MSME requests financing for inventory/capex">
        <bpmn:outgoing>W2841_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2841_Task6" name="MSME Sales refers qualified MSME to partner bank (or SBCorp/DTI microfinance…">
        <bpmn:documentation>Step 1: MSME Sales refers qualified MSME to partner bank (or SBCorp/DTI microfinance program) for &quot;Negosyo Loan&quot;; provides purchase history as credit evidence
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Per referral</bpmn:documentation>
        <bpmn:incoming>W2841_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2841_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2841_Task7" name="Partner bank underwrites using BuildRight transaction data (consented)…">
        <bpmn:documentation>Step 2: Partner bank underwrites using BuildRight transaction data (consented); disburses loan; funds may flow directly to BuildRight for inventory purchase
Responsible (R): Partner Bank / Treasury
Accountable (A): MSME Sales Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2841_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2841_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2841_Task8" name="Compliance ensures data-sharing consent and BSP Open Finance compliance…">
        <bpmn:documentation>Step 3: Compliance ensures data-sharing consent and BSP Open Finance compliance; Treasury tracks partner-bank settlement and any revenue-share
Responsible (R): Compliance / Treasury
Accountable (A): CFO
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W2841_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2841_End9" name="Complete">
        <bpmn:incoming>W2841_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2841_Annotation10">
        <bpmn:text>Controls: - CTL-477 (ensure controlled execution — MSME Growth, Credit &amp; Digital Enablement (PA-82.3).) | - operational: explicit consent capture
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2841_Assoc11" sourceRef="W2841_Annotation10" targetRef="W2841_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2841_Flow12" sourceRef="W2841_Start5" targetRef="W2841_Task6" />
      <bpmn:sequenceFlow id="W2841_Flow13" sourceRef="W2841_Task6" targetRef="W2841_Task7" />
      <bpmn:sequenceFlow id="W2841_Flow14" sourceRef="W2841_Task7" targetRef="W2841_Task8" />
      <bpmn:sequenceFlow id="W2841_Flow15" sourceRef="W2841_Task8" targetRef="W2841_End9" />
    </bpmn:process>
