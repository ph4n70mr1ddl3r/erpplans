      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2843" name="W2843. MSME Digital Store Upgrade &amp; E-Load/E-Wallet Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: MSME digital-readiness assessment
Frequency: Campaign-driven
Volume: ~50,000 MSMEs
Owner: MSME Sales Manager
Participants: MSME Sales, E-wallet Partner, Marketing
Source: workflow W2843 — MSME Digital Store Upgrade &amp; E-Load/E-Wallet Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W2843_LaneSet4">
        <bpmn:lane id="W2843_Lane1" name="MSME Sales">
        <bpmn:flowNodeRef>W2843_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2843_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2843_Lane2" name="E-wallet Partner">
        <bpmn:flowNodeRef>W2843_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2843_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W2843_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2843_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2843_Start5" name="MSME digital-readiness assessment">
        <bpmn:outgoing>W2843_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2843_Task6" name="MSME Sales assesses MSME digital readiness; recommends e-wallet (GCash/Maya)…">
        <bpmn:documentation>Step 1: MSME Sales assesses MSME digital readiness; recommends e-wallet (GCash/Maya) merchant onboarding, e-load resale, and bill-payment services
Responsible (R): MSME Sales
Accountable (A): MSME Sales Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2843_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2843_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2843_Task7" name="E-wallet partner onboards MSME merchant; BuildRight coordinates bulk onboarding…">
        <bpmn:documentation>Step 2: E-wallet partner onboards MSME merchant; BuildRight coordinates bulk onboarding events at stores; provides setup support
Responsible (R): E-wallet Partner / MSME Sales
Accountable (A): MSME Sales Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2843_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2843_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2843_Task8" name="Marketing tracks MSME digital adoption, e-wallet transaction volume, and…">
        <bpmn:documentation>Step 3: Marketing tracks MSME digital adoption, e-wallet transaction volume, and incremental BuildRight orders; reports program ROI
Responsible (R): Marketing
Accountable (A): CMO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2843_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2843_End9" name="Complete">
        <bpmn:incoming>W2843_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2843_Annotation10">
        <bpmn:text>Controls: - CTL-477 (ensure controlled execution — MSME Growth, Credit &amp; Digital Enablement (PA-82.3).) | - operational: hands-on onboarding and incentives
Owner: MSME Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2843_Assoc11" sourceRef="W2843_Annotation10" targetRef="W2843_Start5" associationDirection="None" />
