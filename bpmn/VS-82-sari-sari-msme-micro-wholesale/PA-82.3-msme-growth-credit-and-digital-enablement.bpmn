    <bpmn:process id="W_W2842" name="W2842. MSME Receivables Financing, Factor &amp; Receivable Discounting" isExecutable="false">
      <bpmn:documentation>Trigger: MSME or partner financier requests early payment
Frequency: Event-driven
Volume: Eligible credit-term MSMEs
Owner: Treasury Manager
Participants: Treasury, Finance, MSME Sales, Partner Financier
Source: workflow W2842 — MSME Receivables Financing, Factor &amp; Receivable Discounting</bpmn:documentation>
      <bpmn:laneSet id="W2842_LaneSet3">
        <bpmn:lane id="W2842_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W2842_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2842_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2842_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2842_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2842_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2842_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2842_Start4" name="MSME or partner financier requests early payment">
        <bpmn:outgoing>W2842_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2842_Task5" name="MSME requests early payment discount (e.g., 2% for 10-day vs. 30-day); Treasury…">
        <bpmn:documentation>Step 1: MSME requests early payment discount (e.g., 2% for 10-day vs. 30-day); Treasury evaluates cost vs. cash benefit
Responsible (R): Treasury
Accountable (A): Treasury Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W2842_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2842_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2842_Task6" name="Finance structures receivable discounting or factoring arrangement with partner…">
        <bpmn:documentation>Step 2: Finance structures receivable discounting or factoring arrangement with partner financier; assigns receivables with notice
Responsible (R): Finance / Partner Financier
Accountable (A): CFO
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W2842_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2842_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2842_Task7" name="Treasury settles discounted payment; reconciles factor advance and recourse…">
        <bpmn:documentation>Step 3: Treasury settles discounted payment; reconciles factor advance and recourse; reports program yield and MSME adoption
Responsible (R): Treasury
Accountable (A): CFO
Duration: Per settlement</bpmn:documentation>
        <bpmn:incoming>W2842_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2842_End8" name="Complete">
        <bpmn:incoming>W2842_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2842_Annotation9">
        <bpmn:text>Controls: - CTL-477 (ensure controlled execution — MSME Growth, Credit &amp; Digital Enablement (PA-82.3).) | - operational: non-recourse structuring where viable
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2842_Assoc10" sourceRef="W2842_Annotation9" targetRef="W2842_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2842_Flow11" sourceRef="W2842_Start4" targetRef="W2842_Task5" />
      <bpmn:sequenceFlow id="W2842_Flow12" sourceRef="W2842_Task5" targetRef="W2842_Task6" />
      <bpmn:sequenceFlow id="W2842_Flow13" sourceRef="W2842_Task6" targetRef="W2842_Task7" />
      <bpmn:sequenceFlow id="W2842_Flow14" sourceRef="W2842_Task7" targetRef="W2842_End8" />
    </bpmn:process>
