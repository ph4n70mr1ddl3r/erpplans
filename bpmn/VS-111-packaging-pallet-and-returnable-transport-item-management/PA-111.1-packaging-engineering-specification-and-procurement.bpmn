      <bpmndi:BPMNPlane id="W3521_plane" bpmnElement="W_W3521">
        <bpmndi:BPMNShape id="W3521_Lane1_di" bpmnElement="W3521_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
