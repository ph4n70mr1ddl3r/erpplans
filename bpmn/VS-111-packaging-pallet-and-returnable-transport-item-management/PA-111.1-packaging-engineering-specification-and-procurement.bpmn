        <bpmndi:BPMNShape id="W3522_Task6_di" bpmnElement="W3522_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3522_Start3_di" bpmnElement="W3522_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3522_End7_di" bpmnElement="W3522_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3522_Annotation8_di" bpmnElement="W3522_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3522_Flow10_di" bpmnElement="W3522_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3522_Flow11_di" bpmnElement="W3522_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3522_Flow12_di" bpmnElement="W3522_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3522_Flow13_di" bpmnElement="W3522_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3522_Assoc9_di" bpmnElement="W3522_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3523" name="W3523. Transport &amp; Protective Packaging Design" isExecutable="false">
      <bpmn:documentation>Trigger: Damage analytics (W3540); new lane/mode/product; import packaging
Frequency: Project + ongoing
Volume: Transport packaging across inbound/line-haul/last-mile
Owner: Packaging Engineer / Logistics
Participants: Packaging Eng, Logistics (links to VS-06/VS-110), DC Operations (links to VS-04), Import (links to VS-02.2/VS-87), Quality (links to VS-31), Supplier
Source: workflow W3523 — Transport &amp; Protective Packaging Design</bpmn:documentation>
      <bpmn:laneSet id="W3523_LaneSet2">
        <bpmn:lane id="W3523_Lane1" name="Packaging Eng">
        <bpmn:flowNodeRef>W3523_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3523_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3523_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3523_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3523_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3523_Start3" name="Damage analytics (W3540); new lane/mode/product; import packaging">
        <bpmn:outgoing>W3523_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3523_Task4" name="Packaging Eng/Logistics design the transport/protective packaging per…">
        <bpmn:documentation>Step 1: Packaging Eng/Logistics design the transport/protective packaging per lane/mode: export/import packaging (container-load, moisture/vapor barrier, desiccant for ocean transit links to VS-02.2/W3503), palletization pattern and stretch-wrap/strapping, corner-boards/edge-protection, dunnage/void-fill, and fragile/hazardous handling (links to VS-24.3); optimize pallet build (W3529) and cube (links to W3541)
Responsible (R): Packaging Eng / Logistics
Accountable (A): VP Merchandising / Logistics Mgr
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3523_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3523_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3523_Task5" name="Packaging Eng/Quality validate the transport design via transit/damage testing…">
        <bpmn:documentation>Step 2: Packaging Eng/Quality validate the transport design via transit/damage testing and real damage data (W3540): drop, vibration, compression, humidity, tilt; iterate to reduce damage claims (links to VS-90/W3511) and protect high-value/fragile categories (appliances, tiles, power tools)
Responsible (R): Packaging Eng / Quality
Accountable (A): Logistics Manager
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3523_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3523_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3523_Task6" name="Packaging Eng publish the transport-packaging spec to vendors (inbound, W3525)…">
        <bpmn:documentation>Step 3: Packaging Eng publish the transport-packaging spec to vendors (inbound, W3525) and DC/store (outbound handling), capture the spec in the lane/SKU master (links to VS-29/VS-110), and track damage reduction (W3540) and freight-cube improvement (W3541)
Responsible (R): Packaging Eng / Logistics
Accountable (A): Logistics Manager
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3523_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3523_End7" name="Complete">
        <bpmn:incoming>W3523_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3523_Annotation8">
        <bpmn:text>Controls: - CTL-562 (ensure controlled execution — Packaging Engineering, Specification &amp; Procurement (PA-111.1).) | - operational: transit testing and damage analytics; operational: barrier/desiccant packaging
Owner: Packaging Engineer / Logistics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3523_Assoc9" sourceRef="W3523_Annotation8" targetRef="W3523_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3523_Flow10" sourceRef="W3523_Start3" targetRef="W3523_Task4" />
      <bpmn:sequenceFlow id="W3523_Flow11" sourceRef="W3523_Task4" targetRef="W3523_Task5" />
      <bpmn:sequenceFlow id="W3523_Flow12" sourceRef="W3523_Task5" targetRef="W3523_Task6" />
      <bpmn:sequenceFlow id="W3523_Flow13" sourceRef="W3523_Task6" targetRef="W3523_End7" />
    </bpmn:process>
