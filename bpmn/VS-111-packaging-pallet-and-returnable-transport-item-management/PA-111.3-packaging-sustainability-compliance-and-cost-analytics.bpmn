      <bpmn:sequenceFlow id="W3538_Flow11" sourceRef="W3538_Task4" targetRef="W3538_Task5" />
      <bpmn:sequenceFlow id="W3538_Flow12" sourceRef="W3538_Task5" targetRef="W3538_Task6" />
      <bpmn:sequenceFlow id="W3538_Flow13" sourceRef="W3538_Task6" targetRef="W3538_End7" />
    </bpmn:process>
