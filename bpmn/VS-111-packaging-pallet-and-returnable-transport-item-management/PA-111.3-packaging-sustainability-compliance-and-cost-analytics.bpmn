      <bpmn:sequenceFlow id="W3537_Flow13" sourceRef="W3537_Task6" targetRef="W3537_Task7" />
      <bpmn:sequenceFlow id="W3537_Flow14" sourceRef="W3537_Task7" targetRef="W3537_End8" />
    </bpmn:process>
