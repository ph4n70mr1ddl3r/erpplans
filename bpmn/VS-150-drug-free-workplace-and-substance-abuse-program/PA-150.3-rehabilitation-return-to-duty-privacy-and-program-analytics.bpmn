      <bpmn:sequenceFlow id="W4474_Flow12" sourceRef="W4474_Task5" targetRef="W4474_Task6" />
      <bpmn:sequenceFlow id="W4474_Flow13" sourceRef="W4474_Task6" targetRef="W4474_Task7" />
      <bpmn:sequenceFlow id="W4474_Flow14" sourceRef="W4474_Task7" targetRef="W4474_End8" />
    </bpmn:process>
