    <bpmn:process id="W_W4480" name="W4480. Drug-Free Program Governance, Continuous Improvement &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Governance cycle; Board/leadership reporting; program review
Frequency: Quarterly + annual
Volume: One drug-free program governance/reporting
Owner: HR/CHRO (VS-103) / Compliance (VS-22) / Governance (VS-36) / Audit (VS-21)
Participants: HR (VS-103), Compliance (VS-22), Governance (VS-36), Audit (VS-21), HSE (VS-24), Legal (VS-100), Occupational Health (VS-83)
Source: workflow W4480 — Drug-Free Program Governance, Continuous Improvement &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W4480_LaneSet2">
        <bpmn:lane id="W4480_Lane1" name="HR">
        <bpmn:flowNodeRef>W4480_Task4</bpmn:flowNodeRef>
