    <bpmn:process id="W_W4473" name="W4473. Employee Assistance Program (EAP) &amp; Referral to Rehabilitation" isExecutable="false">
      <bpmn:documentation>Trigger: Positive result eligible for rehab (W4471); self-referral; supervisor referral
Frequency: Per referral
Volume: EAP/referral cases (self- and case-driven)
Owner: Occupational Health/EAP (VS-83.3) / HR (VS-103) / Labor Relations (VS-84)
Participants: EAP (VS-83.3), Occupational Health (VS-83), HR (VS-103), Labor Relations (VS-84), Legal (VS-100), Compliance (VS-22), Vendor (W4460)
Source: workflow W4473 — Employee Assistance Program (EAP) &amp; Referral to Rehabilitation</bpmn:documentation>
      <bpmn:laneSet id="W4473_LaneSet2">
        <bpmn:lane id="W4473_Lane1" name="EAP">
        <bpmn:flowNodeRef>W4473_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4473_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4473_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4473_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4473_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4473_Start3" name="Positive result eligible for rehab (W4471); self-referral; supervisor referral">
        <bpmn:outgoing>W4473_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4473_Task4" name="EAP/Occupational Health/HR offer the rehabilitation pathway (per DOLE…">
        <bpmn:documentation>Step 1: EAP/Occupational Health/HR offer the rehabilitation pathway (per DOLE rehabilitation emphasis &amp; policy W4457) to eligible positive cases and self-referrals, confidentially, with no retaliation
Responsible (R): EAP / Occupational Health / HR
Accountable (A): CHRO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4473_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4473_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4473_Task5" name="EAP/Occupational Health assess the employee, refer to the rehabilitation…">
        <bpmn:documentation>Step 2: EAP/Occupational Health assess the employee, refer to the rehabilitation provider network (W4475), coordinate leave/treatment, and manage the return-to-work agreement (W4474)
Responsible (R): EAP / Occupational Health / HR
Accountable (A): Occupational Health Lead / CHRO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4473_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4473_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4473_Task6" name="EAP/HR manage the case through treatment (confidentially W4462), coordinate…">
        <bpmn:documentation>Step 3: EAP/HR manage the case through treatment (confidentially W4462), coordinate return-to-duty/follow-up testing (W4474), and document for DOLE (W4477)
Responsible (R): EAP / HR / Occupational Health
Accountable (A): CHRO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4473_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4473_End7" name="Complete">
        <bpmn:incoming>W4473_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4473_Annotation8">
        <bpmn:text>Controls: - CTL-682 (ensure controlled execution — Rehabilitation, Return-to-Duty, Privacy &amp; Program Analytics (PA-150.3).) | - CTL-682: rehabilitation pathway offered to eligible cases; confidential &amp; no-retaliation; provider-network referral; return-to-work agreement (W4474); documented
Owner: Occupational Health/EAP (VS-83.3) / HR (VS-103) / Labor Relations (VS-84)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4473_Assoc9" sourceRef="W4473_Annotation8" targetRef="W4473_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4473_Flow10" sourceRef="W4473_Start3" targetRef="W4473_Task4" />
      <bpmn:sequenceFlow id="W4473_Flow11" sourceRef="W4473_Task4" targetRef="W4473_Task5" />
      <bpmn:sequenceFlow id="W4473_Flow12" sourceRef="W4473_Task5" targetRef="W4473_Task6" />
      <bpmn:sequenceFlow id="W4473_Flow13" sourceRef="W4473_Task6" targetRef="W4473_End7" />
    </bpmn:process>
