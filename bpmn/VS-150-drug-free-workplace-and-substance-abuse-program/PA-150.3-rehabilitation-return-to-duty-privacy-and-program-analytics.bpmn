    <bpmn:process id="W_W4476" name="W4476. Confidentiality, Records Retention &amp; RA 10173 Data Protection" isExecutable="false">
      <bpmn:documentation>Trigger: Program operation; records lifecycle; privacy review
Frequency: Continuous + per review
Volume: All drug-program records (~thousands of test/case records)
Owner: Privacy/DPO (VS-91) / Records (VS-88) / HR (VS-103) / Occupational Health (VS-83)
Participants: DPO (VS-91), Records (VS-88), HR (VS-103), Occupational Health (VS-83), Legal (VS-100), Compliance (VS-22), IT (VS-27)
Source: workflow W4476 — Confidentiality, Records Retention &amp; RA 10173 Data Protection</bpmn:documentation>
      <bpmn:laneSet id="W4476_LaneSet3">
        <bpmn:lane id="W4476_Lane1" name="DPO">
        <bpmn:flowNodeRef>W4476_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4476_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4476_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4476_Lane2" name="HR">
        <bpmn:flowNodeRef>W4476_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4476_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4476_Start4" name="Program operation; records lifecycle; privacy review">
        <bpmn:outgoing>W4476_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4476_Task5" name="DPO/Records/HR set the confidentiality &amp; retention policy — drug-test/case…">
        <bpmn:documentation>Step 1: DPO/Records/HR set the confidentiality &amp; retention policy — drug-test/case records as sensitive health data under RA 10173, restricted access (HR/Occupational Health/Legal need-to-know), retention per DOLE/legal (VS-88), and destruction
Responsible (R): DPO / Records / Legal / HR
Accountable (A): DPO / VP Legal / CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4476_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4476_Flow11</bpmn:outgoing>
      </bpmn:userTask>
