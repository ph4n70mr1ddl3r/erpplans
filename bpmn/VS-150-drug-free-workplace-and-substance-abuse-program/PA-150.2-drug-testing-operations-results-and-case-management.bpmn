    <bpmn:process id="W_W4465" name="W4465. Pre-Employment Drug Testing (links VS-121 recruitment)" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate at offer/contingent-offer stage
Frequency: Per hire (~1,200–1,600 hires/yr)
Volume: ~1,200–1,600 pre-employment tests/yr
Owner: Talent Acquisition (VS-121) / Occupational Health (VS-83) / HR
Participants: Talent Acquisition (VS-121), Occupational Health (VS-83), HR (VS-103), Vendor (W4460), Compliance (VS-22)
Source: workflow W4465 — Pre-Employment Drug Testing (links VS-121 recruitment)</bpmn:documentation>
      <bpmn:laneSet id="W4465_LaneSet4">
        <bpmn:lane id="W4465_Lane1" name="Talent Acquisition">
        <bpmn:flowNodeRef>W4465_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4465_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4465_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W4465_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4465_Lane3" name="Occupational Health">
        <bpmn:flowNodeRef>W4465_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4465_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4465_Start5" name="Candidate at offer/contingent-offer stage">
        <bpmn:outgoing>W4465_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4465_Task6" name="Talent Acquisition include drug-test as a contingent-offer condition, schedule…">
        <bpmn:documentation>Step 1: Talent Acquisition include drug-test as a contingent-offer condition, schedule with the DOH-accredited vendor (W4460), and obtain candidate consent (W4462)
Responsible (R): Talent Acquisition / Occupational Health
Accountable (A): TA Lead / CHRO
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W4465_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4465_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4465_Task7" name="Vendor collect specimen per chain-of-custody (W4469), lab test, MRO review…">
        <bpmn:documentation>Step 2: Vendor collect specimen per chain-of-custody (W4469), lab test, MRO review (W4470), and return result to Occupational Health/HR confidentially
Responsible (R): Vendor / Occupational Health
Accountable (A): Occupational Health Lead
Duration: Per test</bpmn:documentation>
        <bpmn:incoming>W4465_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4465_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4465_Task8" name="Occupational Health/HR act on result — negative → proceed to hire…">
        <bpmn:documentation>Step 3: Occupational Health/HR act on result — negative → proceed to hire; positive/refusal → withdraw offer per policy (W4457) and due process (W4471), with confidentiality (W4462)
Responsible (R): Occupational Health / HR / Legal
Accountable (A): CHRO / VP Legal
Duration: Per result</bpmn:documentation>
        <bpmn:incoming>W4465_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4465_End9" name="Complete">
        <bpmn:incoming>W4465_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4465_Annotation10">
        <bpmn:text>Controls: - CTL-681 (ensure controlled execution — Drug Testing Operations, Results &amp; Case Management (PA-150.2).) | - CTL-681: drug-test a contingent-offer condition; DOH-accredited vendor + chain-of-custody; result confidential to HR/Occupational Health; offer-gated on result
Owner: Talent Acquisition (VS-121) / Occupational Health (VS-83) / HR</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4465_Assoc11" sourceRef="W4465_Annotation10" targetRef="W4465_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4465_Flow12" sourceRef="W4465_Start5" targetRef="W4465_Task6" />
      <bpmn:sequenceFlow id="W4465_Flow13" sourceRef="W4465_Task6" targetRef="W4465_Task7" />
      <bpmn:sequenceFlow id="W4465_Flow14" sourceRef="W4465_Task7" targetRef="W4465_Task8" />
      <bpmn:sequenceFlow id="W4465_Flow15" sourceRef="W4465_Task8" targetRef="W4465_End9" />
    </bpmn:process>
