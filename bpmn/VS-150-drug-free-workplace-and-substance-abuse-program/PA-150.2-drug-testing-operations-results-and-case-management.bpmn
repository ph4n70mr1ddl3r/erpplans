      <bpmn:sequenceFlow id="W4467_Flow12" sourceRef="W4467_Task5" targetRef="W4467_Task6" />
      <bpmn:sequenceFlow id="W4467_Flow13" sourceRef="W4467_Task6" targetRef="W4467_Task7" />
      <bpmn:sequenceFlow id="W4467_Flow14" sourceRef="W4467_Task7" targetRef="W4467_End8" />
    </bpmn:process>
