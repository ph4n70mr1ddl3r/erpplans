        <bpmndi:BPMNEdge id="W4466_Flow12_di" bpmnElement="W4466_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4466_Flow13_di" bpmnElement="W4466_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4466_Flow14_di" bpmnElement="W4466_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4466_Assoc10_di" bpmnElement="W4466_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4467" name="W4467. Reasonable-Suspicion &amp; For-Cause Drug Testing" isExecutable="false">
      <bpmn:documentation>Trigger: Observed signs of impairment; behavior/performance; safety event precursor
Frequency: Per event (on suspicion)
Volume: For-cause tests (variable; triggered by observation)
Owner: Supervisor/Manager / HR (VS-103) / HSE (VS-24) / Occupational Health (VS-83)
Participants: Supervisor/Managers, HR (VS-103), HSE (VS-24), Occupational Health (VS-83), Security (VS-23), Legal (VS-100), Vendor (W4460)
Source: workflow W4467 — Reasonable-Suspicion &amp; For-Cause Drug Testing</bpmn:documentation>
      <bpmn:laneSet id="W4467_LaneSet3">
        <bpmn:lane id="W4467_Lane1" name="Supervisor">
        <bpmn:flowNodeRef>W4467_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4467_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4467_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4467_Lane2" name="Occupational Health">
        <bpmn:flowNodeRef>W4467_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4467_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4467_Start4" name="Observed signs of impairment; behavior/performance; safety event precursor">
        <bpmn:outgoing>W4467_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4467_Task5" name="Trained supervisor observes &amp; documents specific, articulable signs of…">
        <bpmn:documentation>Step 1: Trained supervisor observes &amp; documents specific, articulable signs of impairment (appearance/behavior/speech/coordination/performance/safety), per reasonable-suspicion training (W4461)
Responsible (R): Supervisor / Manager
Accountable (A): Supervisor / HSE Lead
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W4467_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4467_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4467_Task6" name="Supervisor/HR/Occupational Health confer, confirm reasonable suspicion (second…">
        <bpmn:documentation>Step 2: Supervisor/HR/Occupational Health confer, confirm reasonable suspicion (second observer where possible), arrange immediate for-cause test with vendor, and manage the employee safely (remove from safety-sensitive duty)
Responsible (R): Supervisor / HR / Occupational Health / HSE / Vendor
Accountable (A): HR / HSE Lead / CHRO
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W4467_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4467_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4467_Task7" name="Occupational Health/HR/Legal act on result (positive → W4471; negative → resume…">
        <bpmn:documentation>Step 3: Occupational Health/HR/Legal act on result (positive → W4471; negative → resume with appropriate handling), document the reasonable-suspicion record, and protect against wrongful-accusation/discrimination (W4462)
Responsible (R): Occupational Health / HR / Legal
Accountable (A): CHRO / VP Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4467_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4467_End8" name="Complete">
        <bpmn:incoming>W4467_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4467_Annotation9">
        <bpmn:text>Controls: - CTL-681 (ensure controlled execution — Drug Testing Operations, Results &amp; Case Management (PA-150.2).) | - CTL-681: trained supervisor; articulable documented signs; second observer where possible; immediate removal from safety-sensitive duty; documented; confidentiality/due process
Owner: Supervisor/Manager / HR (VS-103) / HSE (VS-24) / Occupational Health (VS-83)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4467_Assoc10" sourceRef="W4467_Annotation9" targetRef="W4467_Start4" associationDirection="None" />
