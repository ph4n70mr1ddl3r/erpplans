        <bpmndi:BPMNShape id="W678_Task10_di" bpmnElement="W678_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W678_Task11_di" bpmnElement="W678_Task11"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
