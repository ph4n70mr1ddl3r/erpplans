<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-01.2-pricing-and-promotions" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W13" name="W13. Promotions &amp; Pricing Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional calendar (6 bi-monthly events + monthly hot deals)
Frequency: 6 major promos/year + 12 monthly hot deal cycles
Volume: ~200–500 SKUs per major promo; 10–20 SKUs per monthly hot deals
Owner: Pricing Analyst
Participants: Category Manager, Pricing Analyst, Marketing, Store Operations, IT
Source: workflow W13 — Promotions &amp; Pricing Execution</bpmn:documentation>
      <bpmn:laneSet id="W13_LaneSet7">
        <bpmn:lane id="W13_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W13_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W13_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W13_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_Task18</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W13_Lane3" name="VP Merchandising">
        <bpmn:flowNodeRef>W13_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W13_Lane4" name="Marketing">
        <bpmn:flowNodeRef>W13_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W13_Lane5" name="System">
        <bpmn:flowNodeRef>W13_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_Task15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W13_Lane6" name="Regional Manager">
        <bpmn:flowNodeRef>W13_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W13_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W13_Start8" name="Promotional calendar (6 bi-monthly events + monthly hot deals)">
        <bpmn:outgoing>W13_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W13_Task9" name="Category Manager defines promo mechanics (percentage off, bundle price…">
        <bpmn:documentation>Step 1: Category Manager defines promo mechanics (percentage off, bundle price, buy-X-get-Y)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Per promo event</bpmn:documentation>
        <bpmn:incoming>W13_Flow22</bpmn:incoming>
        <bpmn:outgoing>W13_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W13_Task10" name="Pricing Analyst sets up promotional prices in system with effective dates">
        <bpmn:documentation>Step 2: Pricing Analyst sets up promotional prices in system with effective dates
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 2–4 hours/promo</bpmn:documentation>
        <bpmn:incoming>W13_Flow23</bpmn:incoming>
        <bpmn:outgoing>W13_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W13_Task11" name="VP Merchandising approves promo pricing">
        <bpmn:documentation>Step 3: VP Merchandising approves promo pricing
Responsible (R): VP Merchandising
Accountable (A): VP Merchandising
Duration: 30 min review</bpmn:documentation>
        <bpmn:incoming>W13_Flow24</bpmn:incoming>
        <bpmn:outgoing>W13_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W13_Task12" name="Marketing creates promotional materials (shelf tags, POS materials, digital…">
        <bpmn:documentation>Step 4: Marketing creates promotional materials (shelf tags, POS materials, digital banners)
Responsible (R): Marketing
Accountable (A): CMO
Duration: 1–2 weeks lead time</bpmn:documentation>
        <bpmn:incoming>W13_Flow25</bpmn:incoming>
        <bpmn:outgoing>W13_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W13_Task13" name="System pushes promo prices to all POS terminals before promo start date">
        <bpmn:documentation>Step 5: System pushes promo prices to all POS terminals before promo start date
Responsible (R): System
Accountable (A): —
Duration: Automated (scheduled)</bpmn:documentation>
        <bpmn:incoming>W13_Flow26</bpmn:incoming>
        <bpmn:outgoing>W13_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W13_Task14" name="Store Operations coordinates shelf tag updates across stores">
        <bpmn:documentation>Step 6: Store Operations coordinates shelf tag updates across stores
Responsible (R): Regional Manager
Accountable (A): COO
Duration: 1–2 days before promo</bpmn:documentation>
        <bpmn:incoming>W13_Flow27</bpmn:incoming>
        <bpmn:outgoing>W13_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W13_Task15" name="During promo: system auto-applies promotional pricing at POS (no cashier action)">
        <bpmn:documentation>Step 7: During promo: system auto-applies promotional pricing at POS (no cashier action)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W13_Flow28</bpmn:incoming>
        <bpmn:outgoing>W13_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W13_Task16" name="Pricing Analyst monitors promo performance daily (sell-through, margin impact)">
        <bpmn:documentation>Step 8: Pricing Analyst monitors promo performance daily (sell-through, margin impact)
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 30 min/day during promo</bpmn:documentation>
        <bpmn:incoming>W13_Flow29</bpmn:incoming>
        <bpmn:outgoing>W13_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W13_Task17" name="After promo: system automatically reverts to regular price; flags unsold promo…">
        <bpmn:documentation>Step 9: After promo: system automatically reverts to regular price; flags unsold promo stock for clearance
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W13_Flow30</bpmn:incoming>
        <bpmn:outgoing>W13_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W13_Task18" name="Pricing Analyst generates post-promo analysis (lift, cannibalization, margin…">
        <bpmn:documentation>Step 10: Pricing Analyst generates post-promo analysis (lift, cannibalization, margin erosion, clearance recovery rate)
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 2 hours/promo</bpmn:documentation>
        <bpmn:incoming>W13_Flow220</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W13_End19" name="Complete">
        <bpmn:incoming>W13_Flow221</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W13_Annotation20">
        <bpmn:text>Controls: - CTL-07 (prevent unauthorized pricing changes.); CTL-08 (prevent unauthorized promotional pricing.) | - operational: Pricing Analyst review and approval gate
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W13_Assoc21" sourceRef="W13_Annotation20" targetRef="W13_Start8" associationDirection="None" />
