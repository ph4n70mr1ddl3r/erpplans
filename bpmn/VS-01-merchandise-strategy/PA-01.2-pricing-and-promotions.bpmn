        <bpmndi:BPMNEdge id="W107_Flow14_di" bpmnElement="W107_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow15_di" bpmnElement="W107_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow16_di" bpmnElement="W107_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow17_di" bpmnElement="W107_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow18_di" bpmnElement="W107_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow19_di" bpmnElement="W107_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Flow20_di" bpmnElement="W107_Flow20"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W107_Assoc13_di" bpmnElement="W107_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W130" name="W130. Competitor Price Intelligence Gathering" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly pricing review cycle
Frequency: Weekly
Volume: ~1,000 KVIs (Known Value Items) tracked vs the 3–5 key competitors
Owner: Pricing Analyst
Participants: Store Staff (manual checks), Web Scraping Tools (digital)
Source: workflow W130 — Competitor Price Intelligence Gathering</bpmn:documentation>
      <bpmn:laneSet id="W130_LaneSet3">
        <bpmn:lane id="W130_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W130_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W130_Lane2" name="Store Assoc">
        <bpmn:flowNodeRef>W130_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W130_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W130_Start4" name="Weekly pricing review cycle">
        <bpmn:outgoing>W130_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W130_Task5" name="Define KVI List: Top 1,000 SKUs that drive price perception">
        <bpmn:documentation>Step 1: Define KVI List: Top 1,000 SKUs that drive price perception
Responsible (R): Pricing Analyst
Accountable (A): Category Mgr
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W130_Flow14</bpmn:incoming>
        <bpmn:outgoing>W130_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W130_Task6" name="Manual Price Check: Store associates visit local competitors to record prices">
        <bpmn:documentation>Step 2: Manual Price Check: Store associates visit local competitors to record prices
Responsible (R): Store Assoc
Accountable (A): Store Manager
Duration: 4 hours/week</bpmn:documentation>
        <bpmn:incoming>W130_Flow15</bpmn:incoming>
        <bpmn:outgoing>W130_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W130_Task7" name="Digital Price Check: Automated scraping of competitor ecommerce sites">
        <bpmn:documentation>Step 3: Digital Price Check: Automated scraping of competitor ecommerce sites
Responsible (R): Pricing Analyst
Accountable (A): System
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W130_Flow16</bpmn:incoming>
        <bpmn:outgoing>W130_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W130_Task8" name="Data Consolidation: Upload manual and digital prices into ERP/Pricing Tool">
        <bpmn:documentation>Step 4: Data Consolidation: Upload manual and digital prices into ERP/Pricing Tool
Responsible (R): Pricing Analyst
Accountable (A): Pricing Analyst
Duration: 1 day/week</bpmn:documentation>
        <bpmn:incoming>W130_Flow17</bpmn:incoming>
        <bpmn:outgoing>W130_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W130_Task9" name="Gap Analysis: Identify items where BuildRight is &gt; 5% above market">
        <bpmn:documentation>Step 5: Gap Analysis: Identify items where BuildRight is &gt; 5% above market
Responsible (R): Pricing Analyst
Accountable (A): Category Mgr
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W130_Flow18</bpmn:incoming>
        <bpmn:outgoing>W130_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W130_Task10" name="Price Adjustment: Propose markdowns/updates per W40 or W61">
        <bpmn:documentation>Step 6: Price Adjustment: Propose markdowns/updates per W40 or W61
Responsible (R): Pricing Analyst
Accountable (A): Category Mgr
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W130_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W130_End11" name="Complete">
        <bpmn:incoming>W130_Flow20</bpmn:incoming>
      </bpmn:endEvent>
