        <bpmn:flowNodeRef>W515_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W515_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W515_Start6" name="Quarterly tier re-evaluation cycle (January 1, April 1, July 1, October 1); or member…">
        <bpmn:outgoing>W515_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W515_Task7" name="System executes quarterly tier re-evaluation: calculates 12-month rolling spend…">
        <bpmn:documentation>Step 1: System executes quarterly tier re-evaluation: calculates 12-month rolling spend for each of 600,000 loyalty members; compares against tier thresholds (Bronze: &lt;PHP 50K, Silver: PHP 50K–150K, Gold: PHP 150K–500K, Platinum: &gt;PHP 500K) as configured in loyalty rule master (W313)
Responsible (R): System
Accountable (A): —
Duration: Automated (batch)</bpmn:documentation>
        <bpmn:incoming>W515_Flow21</bpmn:incoming>
        <bpmn:outgoing>W515_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W515_Task8" name="System identifies tier migration candidates: upgrade candidates (spend exceeds…">
        <bpmn:documentation>Step 2: System identifies tier migration candidates: upgrade candidates (spend exceeds next tier threshold), downgrade candidates (spend below current tier threshold), stable members (no change), borderline cases (within 10% of tier boundary)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W515_Flow22</bpmn:incoming>
        <bpmn:outgoing>W515_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W515_Task9" name="Loyalty Analyst reviews borderline cases (within 10% of boundary): applies…">
        <bpmn:documentation>Step 3: Loyalty Analyst reviews borderline cases (within 10% of boundary): applies grace period logic — members downgrading from Gold/Silver/Platinum receive one-tier soft landing for one quarter before full downgrade; approves or overrides grace period on case-by-case basis
Responsible (R): Loyalty Analyst
Accountable (A): Loyalty Program Manager
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W515_Flow23</bpmn:incoming>
        <bpmn:outgoing>W515_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W515_Task10" name="System computes deferred revenue adjustment for tier migrations: upgrade tier…">
        <bpmn:documentation>Step 4: System computes deferred revenue adjustment for tier migrations: upgrade tier changes increase points liability (more points per PHP spent); downgrade tier changes decrease points liability; generates journal entries for FP&amp;A review (Dr. Deferred Revenue / Cr. Loyalty Liability or vice versa)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W515_Flow24</bpmn:incoming>
        <bpmn:outgoing>W515_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W515_Task11" name="FP&amp;A Analyst reviews deferred revenue impact of tier migrations: validates…">
        <bpmn:documentation>Step 5: FP&amp;A Analyst reviews deferred revenue impact of tier migrations: validates journal entries, confirms total loyalty liability adjustment within budgeted range; approves journal posting
Responsible (R): FP&amp;A Analyst
Accountable (A): Controller
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W515_Flow25</bpmn:incoming>
        <bpmn:outgoing>W515_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W515_Task12" name="System posts approved journal entries to GL; updates loyalty liability account…">
        <bpmn:documentation>Step 6: System posts approved journal entries to GL; updates loyalty liability account per tier migration impact
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W515_Flow26</bpmn:incoming>
        <bpmn:outgoing>W515_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W515_Task13" name="For upgrade members: Marketing Communications Manager triggers upgrade…">
        <bpmn:documentation>Step 7: For upgrade members: Marketing Communications Manager triggers upgrade notification sequence — personalized email and SMS congratulating member, explaining new benefits (enhanced earning rate, exclusive offers, priority service), digital card update with new tier visual
Responsible (R): System / MarCom Manager
Accountable (A): Loyalty Program Manager
Duration: Automated + 1 hour review</bpmn:documentation>
        <bpmn:incoming>W515_Flow27</bpmn:incoming>
        <bpmn:outgoing>W515_Flow27</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W515_Task14" name="For downgrade members (after grace period): system triggers soft downgrade…">
        <bpmn:documentation>Step 8: For downgrade members (after grace period): system triggers soft downgrade notification — personalized email explaining tier change, highlighting benefits still available, providing &quot;earn back your tier&quot; incentive (e.g., double points for next 30 days)
Responsible (R): System / MarCom Manager
Accountable (A): Loyalty Program Manager
Duration: Automated + 1 hour review</bpmn:documentation>
        <bpmn:incoming>W515_Flow28</bpmn:incoming>
        <bpmn:outgoing>W515_Flow28</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W515_Task15" name="System updates member profiles: new tier status, new earning rate, new benefit…">
        <bpmn:documentation>Step 9: System updates member profiles: new tier status, new earning rate, new benefit entitlements, tier effective date, next re-evaluation date; propagates to POS (W5B), ecommerce, and CDP (W156)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W515_Flow29</bpmn:incoming>
        <bpmn:outgoing>W515_Flow29</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W515_Task16" name="Loyalty Program Manager reviews quarterly migration analytics: total…">
        <bpmn:documentation>Step 10: Loyalty Program Manager reviews quarterly migration analytics: total upgrades/downgrades, migration rate by tier, grace period utilization rate, retention rate of downgraded members (still active after 90 days), tier revenue contribution analysis
Responsible (R): Loyalty Program Manager
Accountable (A): VP Marketing
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W515_Flow210</bpmn:incoming>
        <bpmn:outgoing>W515_Flow210</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W515_Task17" name="Annually: Loyalty Program Manager reviews tier threshold effectiveness with…">
        <bpmn:documentation>Step 11: Annually: Loyalty Program Manager reviews tier threshold effectiveness with Finance: are thresholds driving desired behavior? Should thresholds be adjusted? Commission actuarial review of loyalty liability adequacy; present recommendations to VP Marketing and CFO
Responsible (R): Loyalty Program Manager
Accountable (A): CFO
Duration: 8 hours/year</bpmn:documentation>
        <bpmn:incoming>W515_Flow211</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W515_End18" name="Complete">
        <bpmn:incoming>W515_Flow212</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W515_Annotation19">
        <bpmn:text>Controls: - CTL-241 (ensure controlled execution — Pricing &amp; Promotions (PA-01.2).) | - operational: soft-landing grace period and win-back incentive; operational: FP&amp;A review and quarterly accrual smoothing; operational: annual threshold review with inflation adjustment consideration
Owner: Loyalty Program Manager</bpmn:text>
      </bpmn:textAnnotation>
