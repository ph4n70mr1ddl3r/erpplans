      <bpmndi:BPMNPlane id="W181_plane" bpmnElement="W_W181">
        <bpmndi:BPMNShape id="W181_Lane1_di" bpmnElement="W181_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
