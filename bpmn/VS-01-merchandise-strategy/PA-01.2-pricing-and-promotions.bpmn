    </bpmn:process>
    <bpmndi:BPMNDiagram id="W40_diag">
      <bpmndi:BPMNPlane id="W40_plane" bpmnElement="W_W40">
        <bpmndi:BPMNShape id="W40_Lane1_di" bpmnElement="W40_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="4310" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W40_Lane2_di" bpmnElement="W40_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="4310" height="170" /></bpmndi:BPMNShape>
