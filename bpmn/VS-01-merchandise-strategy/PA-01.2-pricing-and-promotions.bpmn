    <bpmn:process id="W_W181" name="W181. Store-Level Price Tag Printing &amp; Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Central price update (W40/W13); or shelf tag discrepancy report (W5B.11)
Frequency: Daily / As-needed
Volume: ~200 stores × daily batch; 10–25 price changes/day chain-wide (most stores see only a few tag changes per week per W40); markdown and promo waves (W93/W13) add ~2,000–5,000 tag prints/month
Owner: Store Manager
Participants: Stock Associate, Cashier (Verification)
Source: workflow W181 — Store-Level Price Tag Printing &amp; Verification</bpmn:documentation>
      <bpmn:laneSet id="W181_LaneSet4">
        <bpmn:lane id="W181_Lane1" name="System">
        <bpmn:flowNodeRef>W181_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W181_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W181_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W181_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W181_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W181_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W181_Lane3" name="Cashier">
        <bpmn:flowNodeRef>W181_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W181_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W181_Start5" name="Central price update (W40/W13); or shelf tag discrepancy report (W5B.11)">
        <bpmn:outgoing>W181_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W181_Task6" name="Batch Generation">
        <bpmn:documentation>Step 1: Batch Generation: ERP flags items with price changes; system creates &quot;Price Tag Print Batch&quot; per store
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W181_Flow14</bpmn:incoming>
        <bpmn:outgoing>W181_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W181_Task7" name="Printing">
        <bpmn:documentation>Step 2: Printing: Stock Associate prints new shelf tags at the store office using dedicated label printers
Responsible (R): Stock Associate
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W181_Flow15</bpmn:incoming>
        <bpmn:outgoing>W181_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W181_Task8" name="Tag Replacement">
        <bpmn:documentation>Step 3: Tag Replacement: Associate walks floor; replaces old tags; scans new tag with handheld to &quot;Confirm Replacement&quot;
Responsible (R): Stock Associate
Accountable (A): Dept Supervisor
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W181_Flow16</bpmn:incoming>
        <bpmn:outgoing>W181_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W181_Task9" name="Verification">
        <bpmn:documentation>Step 4: Verification: Cashier or Supervisor performs random &quot;Price Scan Audit&quot; (W69): scans 20 items on shelf; system verifies shelf price matches POS
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W181_Flow17</bpmn:incoming>
        <bpmn:outgoing>W181_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W181_Task10" name="Error Correction">
        <bpmn:documentation>Step 5: Error Correction: If mismatch found, system triggers immediate re-print and investigates sync lag
Responsible (R): System
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W181_Flow18</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W181_End11" name="Complete">
        <bpmn:incoming>W181_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W181_Annotation12">
        <bpmn:text>Controls: - CTL-241 (ensure controlled execution — Pricing &amp; Promotions (PA-01.2).) | - operational: record alone, requiring manual investigation that takes 15–30 min per incident
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
