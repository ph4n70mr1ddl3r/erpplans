    <bpmn:process id="W_W27" name="W27. Vendor Rebate Accrual &amp; Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor rebate agreement established; or monthly settlement date
Frequency: Agreements established annually; settlements monthly or quarterly per contract terms
Volume: ~40–60 active rebate agreements (top 20 vendors = 45% of COGS; ~2–3 agreements per vendor)
Owner: Buyer (agreement); Finance — Cost Accountant (accrual and settlement)
Participants: Buyer, Category Manager, Cost Accountant, AP Clerk, Vendor
Source: workflow W27 — Vendor Rebate Accrual &amp; Settlement</bpmn:documentation>
      <bpmn:laneSet id="W27_LaneSet5">
        <bpmn:lane id="W27_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W27_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W27_Lane2" name="System">
        <bpmn:flowNodeRef>W27_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W27_Lane3" name="Cost Accountant">
        <bpmn:flowNodeRef>W27_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W27_Lane4" name="AP Clerk">
        <bpmn:flowNodeRef>W27_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W27_End18</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W27_Start6" name="Vendor rebate agreement established; or monthly settlement date">
        <bpmn:outgoing>W27_Flow21</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W27_Task7" name="Buyer negotiates rebate agreement with vendor: terms (volume-based…">
        <bpmn:documentation>Step 1: Buyer negotiates rebate agreement with vendor: terms (volume-based, growth-based, promotional), qualifying SKUs, rebate rate, settlement frequency, measurement period
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per negotiation</bpmn:documentation>
        <bpmn:incoming>W27_Flow21</bpmn:incoming>
        <bpmn:outgoing>W27_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W27_Task8" name="System records rebate agreement: vendor, SKUs, rebate type, rate/tier…">
        <bpmn:documentation>Step 2: System records rebate agreement: vendor, SKUs, rebate type, rate/tier, effective dates, settlement schedule
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 15 min/agreement</bpmn:documentation>
        <bpmn:incoming>W27_Flow22</bpmn:incoming>
        <bpmn:outgoing>W27_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W27_Task9" name="At each qualifying purchase (PO receipt): system accrues rebate amount based on…">
        <bpmn:documentation>Step 3: At each qualifying purchase (PO receipt): system accrues rebate amount based on agreement terms
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W27_Flow23</bpmn:incoming>
        <bpmn:outgoing>W27_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W27_Task10" name="At each qualifying sale (POS): system accrues rebate for sell-through-based…">
        <bpmn:documentation>Step 4: At each qualifying sale (POS): system accrues rebate for sell-through-based agreements
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W27_Flow24</bpmn:incoming>
        <bpmn:outgoing>W27_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W27_Task11" name="Monthly: Cost Accountant reviews accrued rebates report; validates accruals…">
        <bpmn:documentation>Step 5: Monthly: Cost Accountant reviews accrued rebates report; validates accruals against agreement terms
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W27_Flow25</bpmn:incoming>
        <bpmn:outgoing>W27_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W27_Task12" name="At settlement date (monthly/quarterly): system generates rebate settlement…">
        <bpmn:documentation>Step 6: At settlement date (monthly/quarterly): system generates rebate settlement report per vendor showing accrued rebate, qualifying volume, and amount due
Responsible (R): System
Accountable (A): Cost Accountant
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W27_Flow26</bpmn:incoming>
        <bpmn:outgoing>W27_Flow26</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W27_Task13" name="Buyer reviews settlement report; confirms quantities and amounts with vendor">
        <bpmn:documentation>Step 7: Buyer reviews settlement report; confirms quantities and amounts with vendor
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min/vendor</bpmn:documentation>
        <bpmn:incoming>W27_Flow27</bpmn:incoming>
        <bpmn:outgoing>W27_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W27_Task14" name="If vendor disputes: Buyer negotiates resolution; adjusts settlement amount with…">
        <bpmn:documentation>Step 8: If vendor disputes: Buyer negotiates resolution; adjusts settlement amount with Category Manager approval
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/occurrence</bpmn:documentation>
        <bpmn:incoming>W27_Flow28</bpmn:incoming>
        <bpmn:outgoing>W27_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W27_Task15" name="Cost Accountant posts rebate settlement: AP credit memo created; vendor balance…">
        <bpmn:documentation>Step 9: Cost Accountant posts rebate settlement: AP credit memo created; vendor balance reduced
Responsible (R): Cost Accountant
Accountable (A): Controller
Duration: 15 min/vendor</bpmn:documentation>
        <bpmn:incoming>W27_Flow29</bpmn:incoming>
        <bpmn:outgoing>W27_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W27_Task16" name="AP processes net payment to vendor (or offset against next invoice per…">
        <bpmn:documentation>Step 10: AP processes net payment to vendor (or offset against next invoice per agreement)
Responsible (R): AP Clerk
Accountable (A): AP Supervisor
Duration: Per W7</bpmn:documentation>
        <bpmn:incoming>W27_Flow210</bpmn:incoming>
        <bpmn:outgoing>W27_Flow210</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W27_Task17" name="Quarterly: Buyer reviews rebate program effectiveness; recommends renewal…">
        <bpmn:documentation>Step 11: Quarterly: Buyer reviews rebate program effectiveness; recommends renewal, renegotiation, or termination
Responsible (R): Buyer
Accountable (A): VP Merchandising
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W27_Flow211</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W27_End18" name="Complete">
        <bpmn:incoming>W27_Flow212</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W27_Annotation19">
        <bpmn:text>Controls: - CTL-39 (ensure vendor rebate accuracy.); CTL-48 (ensure vendor rebate dispute resolution.) | - operational: Buyer (agreement); Finance — Cost Accountant (accrual and settlement) review and approval gate
Owner: Buyer (agreement); Finance — Cost Accountant (accrual and settlement)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W27_Assoc20" sourceRef="W27_Annotation19" targetRef="W27_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W27_Flow21" sourceRef="W27_Start6" targetRef="W27_Task7" />
      <bpmn:sequenceFlow id="W27_Flow22" sourceRef="W27_Task7" targetRef="W27_Task8" />
