    <bpmn:process id="W_W515" name="W515. Loyalty Tier Re-evaluation &amp; Migration Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly tier re-evaluation cycle (January 1, April 1, July 1, October 1); or member requests tier status review
Frequency: Quarterly batch processing; ad-hoc individual reviews
Volume: ~600,000 loyalty members evaluated per quarter; ~15,000–25,000 tier migrations per quarter
Owner: Loyalty Program Manager
Participants: Loyalty Analyst, FP&amp;A Analyst, Marketing Communications Manager
Source: workflow W515 — Loyalty Tier Re-evaluation &amp; Migration Processing</bpmn:documentation>
      <bpmn:laneSet id="W515_LaneSet5">
        <bpmn:lane id="W515_Lane1" name="System">
        <bpmn:flowNodeRef>W515_Task7</bpmn:flowNodeRef>
