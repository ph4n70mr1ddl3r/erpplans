        <bpmn:flowNodeRef>W2157_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2157_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2157_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2157_Start3" name="Customer requests cancellation within cooling-off or error correction">
        <bpmn:outgoing>W2157_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2157_Task4" name="CS Supervisor reviews the cancellation request: cooling-off period (within…">
        <bpmn:documentation>Step 1: CS Supervisor reviews the cancellation request: cooling-off period (within 24–48 hours of purchase, unredeemed), error correction (wrong denomination loaded), or fraud-claim reversal; verifies the card is unredeemed; processes the refund (reverse the liability, refund the original payment method)
Responsible (R): CS Supervisor
Accountable (A): Customer Service Mgr
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2157_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2157_End5" name="Complete">
