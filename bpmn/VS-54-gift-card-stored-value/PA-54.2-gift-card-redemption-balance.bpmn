    <bpmn:process id="W_W2157" name="W2157. Gift Card Refund &amp; Cancellation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests cancellation within cooling-off or error correction
Frequency: ~100–200 cancellations/month (~1%)
Volume: ~100–200/month
Owner: CS Supervisor
Participants: Customer Service Mgr
Source: workflow W2157 — Gift Card Refund &amp; Cancellation</bpmn:documentation>
      <bpmn:laneSet id="W2157_LaneSet2">
