        <bpmndi:BPMNShape id="W2152_Start3_di" bpmnElement="W2152_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2152_End5_di" bpmnElement="W2152_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2152_Annotation6_di" bpmnElement="W2152_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2152_Flow8_di" bpmnElement="W2152_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2152_Flow9_di" bpmnElement="W2152_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
