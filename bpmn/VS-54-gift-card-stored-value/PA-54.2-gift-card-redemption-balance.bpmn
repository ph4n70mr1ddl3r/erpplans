      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2153" name="W2153. Lost/Stolen Gift Card Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports lost or stolen physical card
Frequency: ~200–400 reports/month (~1–2%)
Volume: ~200–400/month; primarily physical cards
Owner: Customer Service Rep
Participants: CSR, Customer Service Mgr
Source: workflow W2153 — Lost/Stolen Gift Card Management</bpmn:documentation>
      <bpmn:laneSet id="W2153_LaneSet2">
        <bpmn:lane id="W2153_Lane1" name="CSR">
        <bpmn:flowNodeRef>W2153_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2153_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2153_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2153_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2153_Start3" name="Customer reports lost or stolen physical card">
        <bpmn:outgoing>W2153_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2153_Task4" name="CSR verifies the customer&#x27;s identity and card ownership (proof of purchase…">
        <bpmn:documentation>Step 1: CSR verifies the customer&#x27;s identity and card ownership (proof of purchase, card number from the receipt); if the card is registered (loyalty-linked), the verification is straightforward; system freezes the card balance to prevent fraudulent redemption
Responsible (R): CSR
Accountable (A): Customer Service Mgr
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W2153_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2153_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2153_Task5" name="CSR issues a replacement card (new number) with the frozen balance transferred…">
        <bpmn:documentation>Step 2: CSR issues a replacement card (new number) with the frozen balance transferred; the old card number is permanently deactivated; customer notified
Responsible (R): CSR
Accountable (A): Customer Service Mgr
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W2153_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2153_End6" name="Complete">
        <bpmn:incoming>W2153_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2153_Annotation7">
        <bpmn:text>Controls: - CTL-392 (ensure controlled execution — Gift Card Redemption &amp; Balance Management (PA-54.2).) | - operational: Customer Service Manager sign-off on replacements &gt;PHP 5K
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2153_Assoc8" sourceRef="W2153_Annotation7" targetRef="W2153_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2153_Flow9" sourceRef="W2153_Start3" targetRef="W2153_Task4" />
      <bpmn:sequenceFlow id="W2153_Flow10" sourceRef="W2153_Task4" targetRef="W2153_Task5" />
      <bpmn:sequenceFlow id="W2153_Flow11" sourceRef="W2153_Task5" targetRef="W2153_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2153_diag">
      <bpmndi:BPMNPlane id="W2153_plane" bpmnElement="W_W2153">
        <bpmndi:BPMNShape id="W2153_Lane1_di" bpmnElement="W2153_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2153_Task4_di" bpmnElement="W2153_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2153_Task5_di" bpmnElement="W2153_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2153_Start3_di" bpmnElement="W2153_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2153_End6_di" bpmnElement="W2153_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2153_Annotation7_di" bpmnElement="W2153_Annotation7"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2153_Flow9_di" bpmnElement="W2153_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2153_Flow10_di" bpmnElement="W2153_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2153_Flow11_di" bpmnElement="W2153_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2153_Assoc8_di" bpmnElement="W2153_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2154" name="W2154. Gift Card Partial Redemption &amp; Multi-Card Payment" isExecutable="false">
      <bpmn:documentation>Trigger: Customer uses multiple gift cards for one transaction
Frequency: ~2,000–3,000 multi-card transactions/month
Volume: ~2K–3K/month; ~15% of redemptions
Owner: Cashier / POS System
Participants: Store Manager
Source: workflow W2154 — Gift Card Partial Redemption &amp; Multi-Card Payment</bpmn:documentation>
      <bpmn:laneSet id="W2154_LaneSet2">
        <bpmn:lane id="W2154_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2154_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2154_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2154_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2154_Start3" name="Customer uses multiple gift cards for one transaction">
        <bpmn:outgoing>W2154_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2154_Task4" name="Cashier scans multiple gift cards; system applies each in sequence (partial…">
        <bpmn:documentation>Step 1: Cashier scans multiple gift cards; system applies each in sequence (partial redemption per card, draining each toward the transaction total); posts each liability→revenue conversion; prints the updated balance on each card&#x27;s receipt
Responsible (R): Cashier / POS System
Accountable (A): Store Manager
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W2154_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2154_End5" name="Complete">
        <bpmn:incoming>W2154_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2154_Annotation6">
        <bpmn:text>Controls: - CTL-392 (ensure controlled execution — Gift Card Redemption &amp; Balance Management (PA-54.2).) | - operational: Store Manager daily-close review
Owner: Cashier / POS System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2154_Assoc7" sourceRef="W2154_Annotation6" targetRef="W2154_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2154_Flow8" sourceRef="W2154_Start3" targetRef="W2154_Task4" />
      <bpmn:sequenceFlow id="W2154_Flow9" sourceRef="W2154_Task4" targetRef="W2154_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2154_diag">
      <bpmndi:BPMNPlane id="W2154_plane" bpmnElement="W_W2154">
        <bpmndi:BPMNShape id="W2154_Lane1_di" bpmnElement="W2154_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2154_Task4_di" bpmnElement="W2154_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
