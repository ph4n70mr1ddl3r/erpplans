    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2152" name="W2152. Gift Card Balance Inquiry &amp; Statement" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests balance via any channel
Frequency: ~8,000–12,000 inquiries/month
Volume: ~8K–12K/month across SMS, app, web, in-store
Owner: CSR / Self-Service
Participants: Customer Service Mgr
Source: workflow W2152 — Gift Card Balance Inquiry &amp; Statement</bpmn:documentation>
      <bpmn:laneSet id="W2152_LaneSet2">
        <bpmn:lane id="W2152_Lane1" name="System">
        <bpmn:flowNodeRef>W2152_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2152_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2152_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2152_Start3" name="Customer requests balance via any channel">
        <bpmn:outgoing>W2152_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2152_Task4" name="Customer requests balance via SMS (text the card number), app/web (enter…">
        <bpmn:documentation>Step 1: Customer requests balance via SMS (text the card number), app/web (enter number+PIN), or in-store (CSR scans); system returns the current balance and recent transactions
Responsible (R): System / CSR
Accountable (A): Customer Service Mgr
Duration: Automated or 1–2 min</bpmn:documentation>
        <bpmn:incoming>W2152_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2152_End5" name="Complete">
        <bpmn:incoming>W2152_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2152_Annotation6">
        <bpmn:text>Controls: - CTL-392 (rate-limit / enumeration guard); CTL-44 (balance integrity); operational: Customer Service Manager monitoring
Owner: CSR / Self-Service</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2152_Assoc7" sourceRef="W2152_Annotation6" targetRef="W2152_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2152_Flow8" sourceRef="W2152_Start3" targetRef="W2152_Task4" />
      <bpmn:sequenceFlow id="W2152_Flow9" sourceRef="W2152_Task4" targetRef="W2152_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2152_diag">
      <bpmndi:BPMNPlane id="W2152_plane" bpmnElement="W_W2152">
        <bpmndi:BPMNShape id="W2152_Lane1_di" bpmnElement="W2152_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
