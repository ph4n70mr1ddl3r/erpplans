        <bpmndi:BPMNShape id="W2154_End5_di" bpmnElement="W2154_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2154_Annotation6_di" bpmnElement="W2154_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2154_Flow8_di" bpmnElement="W2154_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2154_Flow9_di" bpmnElement="W2154_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2154_Assoc7_di" bpmnElement="W2154_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2155" name="W2155. Gift Card Reload &amp; Top-Up" isExecutable="false">
      <bpmn:documentation>Trigger: Customer adds value to existing gift card
Frequency: ~3,000–5,000 reloads/month
Volume: ~3K–5K/month; avg PHP 1,500
Owner: Cashier / Ecommerce System
Participants: Store Manager, Ecommerce Ops
Source: workflow W2155 — Gift Card Reload &amp; Top-Up</bpmn:documentation>
      <bpmn:laneSet id="W2155_LaneSet2">
        <bpmn:lane id="W2155_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2155_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2155_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2155_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2155_Start3" name="Customer adds value to existing gift card">
        <bpmn:outgoing>W2155_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2155_Task4" name="Customer presents an existing card (physical or digital) and pays the reload…">
        <bpmn:documentation>Step 1: Customer presents an existing card (physical or digital) and pays the reload amount; system adds the amount to the stored-value liability and updates the balance; same AMLA KYC threshold applies to cash reloads ≥PHP 50K
Responsible (R): Cashier / Ecommerce System
Accountable (A): Store Manager / Ecommerce Ops
Duration: 1–2 min</bpmn:documentation>
