      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2151" name="W2151. Online Gift Card Redemption" isExecutable="false">
      <bpmn:documentation>Trigger: Customer applies gift card at ecommerce checkout
Frequency: ~3,000–5,000 online redemptions/month
Volume: ~3K–5K/month; growing
Owner: Ecommerce System
Participants: Ecommerce Ops
Source: workflow W2151 — Online Gift Card Redemption</bpmn:documentation>
      <bpmn:laneSet id="W2151_LaneSet2">
        <bpmn:lane id="W2151_Lane1" name="Ecommerce System">
        <bpmn:flowNodeRef>W2151_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2151_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2151_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2151_Start3" name="Customer applies gift card at ecommerce checkout">
        <bpmn:outgoing>W2151_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2151_Task4" name="Customer enters the gift card number/PIN at checkout; system validates the…">
        <bpmn:documentation>Step 1: Customer enters the gift card number/PIN at checkout; system validates the balance, applies the redemption, converts liability→revenue, and completes the order; balance updated in real-time across all channels (omnichannel stored-value)
Responsible (R): Ecommerce System
Accountable (A): Ecommerce Ops
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2151_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2151_End5" name="Complete">
        <bpmn:incoming>W2151_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2151_Annotation6">
        <bpmn:text>Controls: - CTL-392 (ensure controlled execution — Gift Card Redemption &amp; Balance Management (PA-54.2).) | - operational: Ecommerce Ops monitoring
Owner: Ecommerce System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2151_Assoc7" sourceRef="W2151_Annotation6" targetRef="W2151_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2151_Flow8" sourceRef="W2151_Start3" targetRef="W2151_Task4" />
      <bpmn:sequenceFlow id="W2151_Flow9" sourceRef="W2151_Task4" targetRef="W2151_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2151_diag">
