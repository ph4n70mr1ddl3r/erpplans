    <bpmn:process id="W_W2150" name="W2150. In-Store Gift Card Redemption at POS" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents gift card as payment
Frequency: ~12,000–18,000 redemptions/month
Volume: ~12K–18K/month; avg PHP 1,800
Owner: Cashier
Participants: Store Manager
Source: workflow W2150 — In-Store Gift Card Redemption at POS</bpmn:documentation>
      <bpmn:laneSet id="W2150_LaneSet2">
        <bpmn:lane id="W2150_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2150_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2150_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2150_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2150_Start3" name="Customer presents gift card as payment">
        <bpmn:outgoing>W2150_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2150_Task4" name="Cashier scans the gift card; system displays the balance; customer confirms the…">
        <bpmn:documentation>Step 1: Cashier scans the gift card; system displays the balance; customer confirms the amount to redeem; system applies the redemption, posts the liability→revenue conversion (the redeemed amount leaves gift-card liability and posts to revenue per PFRS 15), and prints the updated balance on the receipt
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W2150_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2150_End5" name="Complete">
        <bpmn:incoming>W2150_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2150_Annotation6">
        <bpmn:text>Controls: - CTL-392 (ensure controlled execution — Gift Card Redemption &amp; Balance Management (PA-54.2).) | - operational: Store Manager daily-close review
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2150_Assoc7" sourceRef="W2150_Annotation6" targetRef="W2150_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2150_Flow8" sourceRef="W2150_Start3" targetRef="W2150_Task4" />
      <bpmn:sequenceFlow id="W2150_Flow9" sourceRef="W2150_Task4" targetRef="W2150_End5" />
    </bpmn:process>
