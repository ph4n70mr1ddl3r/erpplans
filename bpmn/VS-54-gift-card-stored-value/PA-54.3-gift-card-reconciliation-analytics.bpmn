    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2159" name="W2159. Monthly Gift Card Financial Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial close per VS-17
Frequency: Monthly
Volume: Full GC program for 5 entities
Owner: Finance Manager
Participants: CFO
Source: workflow W2159 — Monthly Gift Card Financial Reporting</bpmn:documentation>
      <bpmn:laneSet id="W2159_LaneSet2">
        <bpmn:lane id="W2159_Lane1" name="Finance Manager">
        <bpmn:flowNodeRef>W2159_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2159_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2159_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2159_Start3" name="Monthly financial close per VS-17">
        <bpmn:outgoing>W2159_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2159_Task4" name="Finance Manager compiles the monthly gift-card financial report: liability…">
        <bpmn:documentation>Step 1: Finance Manager compiles the monthly gift-card financial report: liability movement, loads, redemptions, breakage, cancellation, outstanding liability, channel split; reconciles to the W2158 daily rollup
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W2159_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2159_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2159_End5" name="Complete">
        <bpmn:incoming>W2159_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2159_Annotation6">
        <bpmn:text>Controls: - CTL-393 (financial-reporting accuracy — links to VS-17); CTL-44 (liability integrity); operational: CFO monthly sign-off
Owner: Finance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2159_Assoc7" sourceRef="W2159_Annotation6" targetRef="W2159_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2159_Flow8" sourceRef="W2159_Start3" targetRef="W2159_Task4" />
      <bpmn:sequenceFlow id="W2159_Flow9" sourceRef="W2159_Task4" targetRef="W2159_End5" />
    </bpmn:process>
