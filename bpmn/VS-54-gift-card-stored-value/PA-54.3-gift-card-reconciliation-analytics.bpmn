    <bpmn:process id="W_W2160" name="W2160. Gift Card Fraud Monitoring &amp; Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Real-time alerts or weekly review
Frequency: Real-time + weekly comprehensive
Volume: ~50–100 flagged transactions/week; &lt;0.5% fraud
Owner: Loss Prevention Analyst
Participants: LP Analyst, Loss Prevention Mgr
Source: workflow W2160 — Gift Card Fraud Monitoring &amp; Prevention</bpmn:documentation>
      <bpmn:laneSet id="W2160_LaneSet3">
        <bpmn:lane id="W2160_Lane1" name="System">
        <bpmn:flowNodeRef>W2160_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2160_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2160_Lane2" name="LP Analyst">
        <bpmn:flowNodeRef>W2160_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2160_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2160_Start4" name="Real-time alerts or weekly review">
        <bpmn:outgoing>W2160_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2160_Task5" name="System applies real-time fraud rules: velocity (rapid high-value purchases)…">
        <bpmn:documentation>Step 1: System applies real-time fraud rules: velocity (rapid high-value purchases), enumeration (brute-force card-number attempts), geolocation anomalies, stolen-payment-method patterns; holds suspicious transactions for review
Responsible (R): System / LP Analyst
Accountable (A): Loss Prevention Mgr
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W2160_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2160_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2160_Task6" name="LP Analyst reviews the flagged queue weekly: confirms fraud (reverse the…">
        <bpmn:documentation>Step 2: LP Analyst reviews the flagged queue weekly: confirms fraud (reverse the transaction, freeze the card), or releases the hold (false positive); tunes the rules to reduce false positives
Responsible (R): LP Analyst
Accountable (A): Loss Prevention Mgr
Duration: 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2160_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2160_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2160_End7" name="Complete">
        <bpmn:incoming>W2160_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2160_Annotation8">
        <bpmn:text>Controls: - CTL-393 (fraud-detection — links to VS-125); CTL-44 (freeze/reversal integrity); operational: Loss Prevention Manager weekly sign-off
Owner: Loss Prevention Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2160_Assoc9" sourceRef="W2160_Annotation8" targetRef="W2160_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2160_Flow10" sourceRef="W2160_Start4" targetRef="W2160_Task5" />
      <bpmn:sequenceFlow id="W2160_Flow11" sourceRef="W2160_Task5" targetRef="W2160_Task6" />
      <bpmn:sequenceFlow id="W2160_Flow12" sourceRef="W2160_Task6" targetRef="W2160_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2160_diag">
      <bpmndi:BPMNPlane id="W2160_plane" bpmnElement="W_W2160">
