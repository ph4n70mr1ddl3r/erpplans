      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2161" name="W2161. Gift Card Program ROI Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly program review
Frequency: Quarterly; annual comprehensive
Volume: ~PHP 500–600M annual liability; ~PHP 30–50M breakage
Owner: FP&amp;A Analyst
Participants: CFO
Source: workflow W2161 — Gift Card Program ROI Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2161_LaneSet2">
        <bpmn:lane id="W2161_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2161_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2161_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2161_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2161_Start3" name="Quarterly program review">
        <bpmn:outgoing>W2161_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2161_Task4" name="FP&amp;A Analyst computes the program ROI: program cost (card production, platform…">
        <bpmn:documentation>Step 1: FP&amp;A Analyst computes the program ROI: program cost (card production, platform, fraud loss, marketing) vs. program benefit (breakage revenue, incremental basket lift from gift-card recipients, cash-flow float benefit); recommends the program-investment split
Responsible (R): FP&amp;A Analyst
Accountable (A): CFO
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2161_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2161_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2161_End5" name="Complete">
        <bpmn:incoming>W2161_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2161_Annotation6">
        <bpmn:text>Controls: - CTL-393 (ensure controlled execution — Gift Card Reconciliation &amp; Analytics (PA-54.3).) | - CTL-393 (ROI/budget accuracy — links to VS-17); operational: CFO sign-off on the ROI methodology
Owner: FP&amp;A Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2161_Assoc7" sourceRef="W2161_Annotation6" targetRef="W2161_Start3" associationDirection="None" />
