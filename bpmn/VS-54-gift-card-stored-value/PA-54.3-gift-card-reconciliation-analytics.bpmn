    <bpmn:process id="W_W2163" name="W2163. Gift Card System Integration &amp; API Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly maintenance or API degradation
Frequency: Monthly maintenance; real-time monitoring
Volume: 4 integration points: POS, ecommerce, app, CRM
Owner: IT Integration Lead
Participants: CIO
Source: workflow W2163 — Gift Card System Integration &amp; API Management</bpmn:documentation>
      <bpmn:laneSet id="W2163_LaneSet2">
        <bpmn:lane id="W2163_Lane1" name="IT Integration Lead">
        <bpmn:flowNodeRef>W2163_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2163_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2163_End5</bpmn:flowNodeRef>
