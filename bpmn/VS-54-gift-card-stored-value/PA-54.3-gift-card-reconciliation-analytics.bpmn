    <bpmn:process id="W_W2158" name="W2158. Daily Gift Card Liability Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-day POS close and ecommerce settlement
Frequency: Daily across 200 stores + ecommerce
Volume: ~15,000–25,000 daily GC transactions
Owner: Accountant (AP/AR)
Participants: Accountant, Finance Manager
Source: workflow W2158 — Daily Gift Card Liability Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W2158_LaneSet2">
        <bpmn:lane id="W2158_Lane1" name="Accountant">
        <bpmn:flowNodeRef>W2158_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2158_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2158_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2158_Start3" name="End-of-day POS close and ecommerce settlement">
        <bpmn:outgoing>W2158_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2158_Task4" name="Accountant reconciles the daily gift-card liability movement: openings +…">
        <bpmn:documentation>Step 1: Accountant reconciles the daily gift-card liability movement: openings + loads/reloads − redemptions − breakage − cancellations = closing; validates the stored-value-system total against the GL liability account
Responsible (R): Accountant
Accountable (A): Finance Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2158_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2158_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2158_End5" name="Complete">
        <bpmn:incoming>W2158_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2158_Annotation6">
        <bpmn:text>Controls: - CTL-393 (ensure controlled execution — Gift Card Reconciliation &amp; Analytics (PA-54.3).) | - operational: liability-reconciliation integrity; bank/liability reconciliation — links to VS-17; operational: Finance Manager daily sign-off
Owner: Accountant (AP/AR)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2158_Assoc7" sourceRef="W2158_Annotation6" targetRef="W2158_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2158_Flow8" sourceRef="W2158_Start3" targetRef="W2158_Task4" />
      <bpmn:sequenceFlow id="W2158_Flow9" sourceRef="W2158_Task4" targetRef="W2158_End5" />
    </bpmn:process>
