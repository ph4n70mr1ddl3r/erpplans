<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-54.1-gift-card-issuance-distribution" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2142" name="W2142. Physical Gift Card Stock Management" isExecutable="false">
      <bpmn:documentation>Trigger: Gift card inventory reorder point or new design launch
Frequency: Monthly reorder; quarterly new designs
Volume: ~50,000 cards printed/year; 10,000 in circulation
Owner: Marketing Operations Manager
Participants: Marketing Ops Mgr, VP Marketing, Vendor, DC
Source: workflow W2142 — Physical Gift Card Stock Management</bpmn:documentation>
      <bpmn:laneSet id="W2142_LaneSet3">
        <bpmn:lane id="W2142_Lane1" name="Marketing Ops Mgr">
        <bpmn:flowNodeRef>W2142_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2142_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2142_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W2142_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2142_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2142_Start4" name="Gift card inventory reorder point or new design launch">
        <bpmn:outgoing>W2142_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2142_Task5" name="Marketing Ops Manager monitors physical gift card stock across 200 stores…">
        <bpmn:documentation>Step 1: Marketing Ops Manager monitors physical gift card stock across 200 stores; reorder triggers at minimum threshold; coordinates with card vendor for production (security features, sequential numbering, BuildRight branding)
Responsible (R): Marketing Ops Mgr
Accountable (A): VP Marketing
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2142_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2142_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2142_Task6" name="Vendor produces cards with embedded security (sequential numbering registered…">
        <bpmn:documentation>Step 2: Vendor produces cards with embedded security (sequential numbering registered to ERP at activation); ships to DC for distribution; DC allocates to stores based on sell-through rate
Responsible (R): Vendor / DC
Accountable (A): Marketing Ops Mgr
Duration: 2–3 weeks lead time</bpmn:documentation>
        <bpmn:incoming>W2142_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2142_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2142_End7" name="Complete">
        <bpmn:incoming>W2142_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2142_Annotation8">
        <bpmn:text>Controls: - CTL-391 (ensure controlled execution — Gift Card Issuance &amp; Distribution (PA-54.1).) | - operational: Marketing Ops monthly stock-reconciliation sign-off
Owner: Marketing Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2142_Assoc9" sourceRef="W2142_Annotation8" targetRef="W2142_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2142_Flow10" sourceRef="W2142_Start4" targetRef="W2142_Task5" />
      <bpmn:sequenceFlow id="W2142_Flow11" sourceRef="W2142_Task5" targetRef="W2142_Task6" />
      <bpmn:sequenceFlow id="W2142_Flow12" sourceRef="W2142_Task6" targetRef="W2142_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2142_diag">
      <bpmndi:BPMNPlane id="W2142_plane" bpmnElement="W_W2142">
        <bpmndi:BPMNShape id="W2142_Lane1_di" bpmnElement="W2142_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_Lane2_di" bpmnElement="W2142_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_Task5_di" bpmnElement="W2142_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_Task6_di" bpmnElement="W2142_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_Start4_di" bpmnElement="W2142_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_End7_di" bpmnElement="W2142_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2142_Annotation8_di" bpmnElement="W2142_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2142_Flow10_di" bpmnElement="W2142_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2142_Flow11_di" bpmnElement="W2142_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2142_Flow12_di" bpmnElement="W2142_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2142_Assoc9_di" bpmnElement="W2142_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2143" name="W2143. Gift Card Sale &amp; Activation at POS" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases gift card at POS
Frequency: ~15,000–20,000 gift card transactions/month
Volume: ~15K–20K/month; avg PHP 2,000; ~PHP 30–40M/month
Owner: Cashier
Participants: Store Manager, Finance
Source: workflow W2143 — Gift Card Sale &amp; Activation at POS</bpmn:documentation>
      <bpmn:laneSet id="W2143_LaneSet3">
        <bpmn:lane id="W2143_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2143_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2143_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2143_Lane2" name="System">
        <bpmn:flowNodeRef>W2143_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2143_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2143_Start4" name="Customer purchases gift card at POS">
        <bpmn:outgoing>W2143_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2143_Task5" name="Cashier scans the physical card; system prompts for load amount; customer pays…">
        <bpmn:documentation>Step 1: Cashier scans the physical card; system prompts for load amount; customer pays; system activates the card (registers the sequential number to the stored-value liability) and prints a receipt; for cash purchases ≥PHP 50K, AMLA KYC applies (W2148)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W2143_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2143_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2143_Task6" name="System posts the sale: cash/card receipt to revenue-bank, load amount to…">
        <bpmn:documentation>Step 2: System posts the sale: cash/card receipt to revenue-bank, load amount to gift-card liability (not revenue — revenue is recognized at redemption per PFRS 15)
Responsible (R): System
Accountable (A): Finance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2143_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2143_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2143_End7" name="Complete">
        <bpmn:incoming>W2143_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2143_Annotation8">
        <bpmn:text>Controls: - CTL-391 (ensure controlled execution — Gift Card Issuance &amp; Distribution (PA-54.1).) | - operational: Store Manager daily-close review of gift-card activations
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2143_Assoc9" sourceRef="W2143_Annotation8" targetRef="W2143_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2143_Flow10" sourceRef="W2143_Start4" targetRef="W2143_Task5" />
      <bpmn:sequenceFlow id="W2143_Flow11" sourceRef="W2143_Task5" targetRef="W2143_Task6" />
      <bpmn:sequenceFlow id="W2143_Flow12" sourceRef="W2143_Task6" targetRef="W2143_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2143_diag">
      <bpmndi:BPMNPlane id="W2143_plane" bpmnElement="W_W2143">
        <bpmndi:BPMNShape id="W2143_Lane1_di" bpmnElement="W2143_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_Lane2_di" bpmnElement="W2143_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_Task5_di" bpmnElement="W2143_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_Task6_di" bpmnElement="W2143_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_Start4_di" bpmnElement="W2143_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_End7_di" bpmnElement="W2143_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2143_Annotation8_di" bpmnElement="W2143_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2143_Flow10_di" bpmnElement="W2143_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2143_Flow11_di" bpmnElement="W2143_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2143_Flow12_di" bpmnElement="W2143_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2143_Assoc9_di" bpmnElement="W2143_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2144" name="W2144. Digital Gift Card Sale &amp; Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases digital gift card online
Frequency: ~3,000–5,000 digital cards/month; growing 20% QoQ
Volume: ~3K–5K/month; avg PHP 2,500
Owner: Ecommerce Operations
Participants: Ecommerce Ops, Fraud Analyst
Source: workflow W2144 — Digital Gift Card Sale &amp; Delivery</bpmn:documentation>
      <bpmn:laneSet id="W2144_LaneSet2">
        <bpmn:lane id="W2144_Lane1" name="Ecommerce System">
        <bpmn:flowNodeRef>W2144_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2144_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2144_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2144_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2144_Start3" name="Customer purchases digital gift card online">
        <bpmn:outgoing>W2144_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2144_Task4" name="Customer selects denomination and recipient (self or gift recipient) on…">
        <bpmn:documentation>Step 1: Customer selects denomination and recipient (self or gift recipient) on ecommerce/app; pays online; system generates a digital card number, emails/SMSes it to the recipient, and posts the liability
Responsible (R): Ecommerce System
Accountable (A): Ecommerce Ops
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2144_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2144_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2144_Task5" name="For fraudulent-pattern transactions (rapid high-value purchases, stolen-card…">
        <bpmn:documentation>Step 2: For fraudulent-pattern transactions (rapid high-value purchases, stolen-card payment), the fraud filter (links to VS-125) holds the digital-card issuance pending review
Responsible (R): Ecommerce System / Fraud Analyst
Accountable (A): Ecommerce Ops
Duration: Automated + review</bpmn:documentation>
        <bpmn:incoming>W2144_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2144_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2144_End6" name="Complete">
        <bpmn:incoming>W2144_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2144_Annotation7">
        <bpmn:text>Controls: - CTL-391 (ensure controlled execution — Gift Card Issuance &amp; Distribution (PA-54.1).) | - operational: Ecommerce Ops monitoring of the fraud-hold queue
Owner: Ecommerce Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2144_Assoc8" sourceRef="W2144_Annotation7" targetRef="W2144_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2144_Flow9" sourceRef="W2144_Start3" targetRef="W2144_Task4" />
      <bpmn:sequenceFlow id="W2144_Flow10" sourceRef="W2144_Task4" targetRef="W2144_Task5" />
      <bpmn:sequenceFlow id="W2144_Flow11" sourceRef="W2144_Task5" targetRef="W2144_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2144_diag">
      <bpmndi:BPMNPlane id="W2144_plane" bpmnElement="W_W2144">
        <bpmndi:BPMNShape id="W2144_Lane1_di" bpmnElement="W2144_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2144_Task4_di" bpmnElement="W2144_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2144_Task5_di" bpmnElement="W2144_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2144_Start3_di" bpmnElement="W2144_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2144_End6_di" bpmnElement="W2144_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2144_Annotation7_di" bpmnElement="W2144_Annotation7"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2144_Flow9_di" bpmnElement="W2144_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2144_Flow10_di" bpmnElement="W2144_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2144_Flow11_di" bpmnElement="W2144_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2144_Assoc8_di" bpmnElement="W2144_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2145" name="W2145. Corporate Bulk Gift Card Program" isExecutable="false">
      <bpmn:documentation>Trigger: Corporate client requests bulk purchase
Frequency: ~20–30 corporate orders/month; peaks at Christmas
Volume: ~20–30 orders/month; 50–500 cards each
Owner: Corporate Sales Manager
Participants: Corporate Sales Mgr, Head of Trade / Account Management, Finance
Source: workflow W2145 — Corporate Bulk Gift Card Program</bpmn:documentation>
      <bpmn:laneSet id="W2145_LaneSet3">
        <bpmn:lane id="W2145_Lane1" name="Corporate Sales Mgr">
        <bpmn:flowNodeRef>W2145_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2145_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2145_Lane2" name="System">
        <bpmn:flowNodeRef>W2145_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2145_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2145_Start4" name="Corporate client requests bulk purchase">
        <bpmn:outgoing>W2145_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2145_Task5" name="Corporate Sales Manager processes the bulk order: denomination, quantity…">
        <bpmn:documentation>Step 1: Corporate Sales Manager processes the bulk order: denomination, quantity, custom branding if requested, payment terms (often invoiced vs. prepaid); for bulk cash orders ≥ threshold, AMLA KYC applies
Responsible (R): Corporate Sales Mgr
Accountable (A): Head of Trade / Account Management
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2145_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2145_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2145_Task6" name="System bulk-activates the card range to the stored-value liability on payment…">
        <bpmn:documentation>Step 2: System bulk-activates the card range to the stored-value liability on payment receipt; delivers physical (to the corporate client) or digital (to the client&#x27;s recipient list); invoices per the corporate payment terms
Responsible (R): System / Corporate Sales Mgr
Accountable (A): Finance
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W2145_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2145_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2145_End7" name="Complete">
        <bpmn:incoming>W2145_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2145_Annotation8">
        <bpmn:text>Controls: - CTL-391 (ensure controlled execution — Gift Card Issuance &amp; Distribution (PA-54.1).) | - operational: Head of Trade / Account Management sign-off on bulk orders &gt;PHP 500K
Owner: Corporate Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2145_Assoc9" sourceRef="W2145_Annotation8" targetRef="W2145_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2145_Flow10" sourceRef="W2145_Start4" targetRef="W2145_Task5" />
      <bpmn:sequenceFlow id="W2145_Flow11" sourceRef="W2145_Task5" targetRef="W2145_Task6" />
      <bpmn:sequenceFlow id="W2145_Flow12" sourceRef="W2145_Task6" targetRef="W2145_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2145_diag">
      <bpmndi:BPMNPlane id="W2145_plane" bpmnElement="W_W2145">
        <bpmndi:BPMNShape id="W2145_Lane1_di" bpmnElement="W2145_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_Lane2_di" bpmnElement="W2145_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_Task5_di" bpmnElement="W2145_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_Task6_di" bpmnElement="W2145_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_Start4_di" bpmnElement="W2145_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_End7_di" bpmnElement="W2145_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2145_Annotation8_di" bpmnElement="W2145_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2145_Flow10_di" bpmnElement="W2145_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2145_Flow11_di" bpmnElement="W2145_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2145_Flow12_di" bpmnElement="W2145_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2145_Assoc9_di" bpmnElement="W2145_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2146" name="W2146. Gift Card Promotional Campaign" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing launches gift card promotion (e.g., buy PHP 5K get PHP 500 bonus)
Frequency: ~4–6 campaigns/year aligned with seasonal calendar
Volume: ~4–6 campaigns/year; 30–50% lift during campaign
Owner: Marketing Promotions Manager
Participants: Marketing Promotions Mgr, VP Marketing, Finance, Finance Manager
Source: workflow W2146 — Gift Card Promotional Campaign</bpmn:documentation>
      <bpmn:laneSet id="W2146_LaneSet3">
        <bpmn:lane id="W2146_Lane1" name="Marketing Promotions Mgr">
        <bpmn:flowNodeRef>W2146_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2146_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2146_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2146_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2146_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2146_Start4" name="Marketing launches gift card promotion (e.g., buy PHP 5K get PHP 500 bonus)">
        <bpmn:outgoing>W2146_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2146_Task5" name="Marketing designs the promo (bonus structure, eligibility, channel); configures…">
        <bpmn:documentation>Step 1: Marketing designs the promo (bonus structure, eligibility, channel); configures the bonus-load in the stored-value system; promotes across channels; tracks redemption and lift vs. baseline
Responsible (R): Marketing Promotions Mgr
Accountable (A): VP Marketing
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2146_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2146_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2146_Task6" name="Finance validates the bonus-load accounting (the bonus is a separate liability…">
        <bpmn:documentation>Step 2: Finance validates the bonus-load accounting (the bonus is a separate liability tranche with a different breakage/revenue-recognition treatment per PFRS 15)
Responsible (R): Finance
Accountable (A): Finance Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2146_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2146_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2146_End7" name="Complete">
        <bpmn:incoming>W2146_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2146_Annotation8">
        <bpmn:text>Controls: - CTL-391 (ensure controlled execution — Gift Card Issuance &amp; Distribution (PA-54.1).) | - operational: promo-spend accuracy; CTL-283 (campaign regulatory compliance — DTI promo-permit review per W833); operational: Finance sign-off on the bonus-liability tranche
Owner: Marketing Promotions Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2146_Assoc9" sourceRef="W2146_Annotation8" targetRef="W2146_Start4" associationDirection="None" />
