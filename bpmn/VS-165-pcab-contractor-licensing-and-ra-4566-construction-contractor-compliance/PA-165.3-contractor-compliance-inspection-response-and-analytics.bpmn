    <bpmn:process id="W_W4837" name="W4837. Joint Ventures, Consortiums &amp; Foreign Contractor Licensing" isExecutable="false">
      <bpmn:documentation>Trigger: JV/consortium bid (large B2G/project); foreign-contractor partnership; capacity gap (W4819)
Frequency: Per JV/consortium opportunity
Volume: ~2–5 large-project JV opportunities/year
Owner: VP Legal &amp; Compliance / PCAB Compliance Lead / Strategy (VS-33)
Participants: Trade Sales (VS-11), Government Sales (VS-46), Legal (VS-100.3), Corporate Development (VS-130), Global Mobility (VS-160)
Source: workflow W4837 — Joint Ventures, Consortiums &amp; Foreign Contractor Licensing</bpmn:documentation>
      <bpmn:laneSet id="W4837_LaneSet3">
        <bpmn:lane id="W4837_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4837_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4837_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4837_Start4</bpmn:flowNodeRef>
