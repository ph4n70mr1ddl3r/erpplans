<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-165.3-contractor-compliance-inspection-response-and-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4833" name="W4833. CIAP/PCAB &amp; LGU Construction Inspection/Audit Response &amp; Corrective Action" isExecutable="false">
      <bpmn:documentation>Trigger: PCAB/CIAP audit; LGU Office of the Building Official (OBO) inspection; DOLE construction-safety inspection (W4827); COA audit (B2G); complaint-triggered inspection
Frequency: Ad hoc + scheduled
Volume: ~5–10 inspections/audits per year across licensed projects + entity-level audits
Owner: PCAB Compliance Lead / Legal (VS-100.3) / HSE (VS-24)
Participants: Engineering (VS-20), Installation (VS-12), Finance (VS-40), Records (VS-88), Internal Audit (VS-21)
Source: workflow W4833 — CIAP/PCAB &amp; LGU Construction Inspection/Audit Response &amp; Corrective Action</bpmn:documentation>
      <bpmn:laneSet id="W4833_LaneSet2">
        <bpmn:lane id="W4833_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4833_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4833_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4833_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4833_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4833_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4833_Start3" name="PCAB/CIAP audit; LGU Office of the Building Official (OBO) inspection; DOLE…">
        <bpmn:outgoing>W4833_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4833_Task4" name="Receive &amp; log the inspection/audit notice (PCAB, LGU-OBO, DOLE, COA), scope it…">
        <bpmn:documentation>Step 1: Receive &amp; log the inspection/audit notice (PCAB, LGU-OBO, DOLE, COA), scope it (entity, project W4825, license condition), assign the response owner, and assemble the evidence packet from the audit trail (W4823) and records (VS-88)
Responsible (R): PCAB Compliance Lead / Legal / Records
Accountable (A): VP Legal &amp; Compliance
Duration: Per event (immediate)</bpmn:documentation>
        <bpmn:incoming>W4833_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4833_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4833_Task5" name="Host the inspection/audit, respond to findings, and negotiate/correct…">
        <bpmn:documentation>Step 2: Host the inspection/audit, respond to findings, and negotiate/correct: immediate correction of construction-safety/scope/records issues, written response to PCAB/CIAP, and a corrective-action plan; coordinate with HSE (VS-24) and the project team
Responsible (R): PCAB Compliance Lead / Legal / HSE / Engineering
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4833_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4833_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4833_Task6" name="Track corrective-action closure, document the outcome in the audit trail…">
        <bpmn:documentation>Step 3: Track corrective-action closure, document the outcome in the audit trail (W4823) and legal matter record (VS-100.3), manage any resulting penalty (W4838), and feed inspection findings to governance (W4840) and analytics (W4839)
Responsible (R): PCAB Compliance Lead / Legal / Internal Audit
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4833_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4833_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4833_End7" name="Complete">
        <bpmn:incoming>W4833_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4833_Annotation8">
        <bpmn:text>Controls: - CTL-727 (ensure controlled execution — Contractor Compliance, Inspection Response &amp; Analytics (PA-165.3).) | - CTL-727: inspection response owner assigned; findings corrected &amp; closed; outcome documented
Owner: PCAB Compliance Lead / Legal (VS-100.3) / HSE (VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4833_Assoc9" sourceRef="W4833_Annotation8" targetRef="W4833_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4833_Flow10" sourceRef="W4833_Start3" targetRef="W4833_Task4" />
      <bpmn:sequenceFlow id="W4833_Flow11" sourceRef="W4833_Task4" targetRef="W4833_Task5" />
      <bpmn:sequenceFlow id="W4833_Flow12" sourceRef="W4833_Task5" targetRef="W4833_Task6" />
      <bpmn:sequenceFlow id="W4833_Flow13" sourceRef="W4833_Task6" targetRef="W4833_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4833_diag">
      <bpmndi:BPMNPlane id="W4833_plane" bpmnElement="W_W4833">
        <bpmndi:BPMNShape id="W4833_Lane1_di" bpmnElement="W4833_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
