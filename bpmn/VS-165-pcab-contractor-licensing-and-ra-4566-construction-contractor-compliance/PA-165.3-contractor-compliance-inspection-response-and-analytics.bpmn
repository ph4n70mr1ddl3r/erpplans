      <bpmndi:BPMNPlane id="W4835_plane" bpmnElement="W_W4835">
        <bpmndi:BPMNShape id="W4835_Lane1_di" bpmnElement="W4835_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
