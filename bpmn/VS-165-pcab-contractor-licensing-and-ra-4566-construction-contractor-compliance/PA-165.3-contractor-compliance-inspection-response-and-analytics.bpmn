    <bpmn:process id="W_W4835" name="W4835. Technical-Personnel Credentialing — PRC Engineer-of-Record, Responsible Officers &amp; PCAB-Required Staff" isExecutable="false">
      <bpmn:documentation>Trigger: License application/renewal (W4818/W4820); personnel hire/exit; CPD cycle; project need
Frequency: Per personnel change + annual CPD
Volume: ~10–15 PRC-licensed technical staff (civil/electrical engineers, architects) named on BuildRight licenses
Owner: PCAB Compliance Lead / HR (VS-19.4)
Participants: Engineering (VS-20), Trade Sales (VS-11), PRC, Learning (VS-19.4 CPD)
Source: workflow W4835 — Technical-Personnel Credentialing — PRC Engineer-of-Record, Responsible Officers &amp; PCAB-Required Staff</bpmn:documentation>
      <bpmn:laneSet id="W4835_LaneSet3">
        <bpmn:lane id="W4835_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4835_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4835_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4835_Lane2" name="HR">
        <bpmn:flowNodeRef>W4835_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4835_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4835_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4835_Start4" name="License application/renewal (W4818/W4820); personnel hire/exit; CPD cycle; project need">
        <bpmn:outgoing>W4835_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4835_Task5" name="Maintain the technical-personnel roster required by the licenses: named…">
        <bpmn:documentation>Step 1: Maintain the technical-personnel roster required by the licenses: named PRC-licensed civil/professional electrical engineers and architects (Engineer-of-Record / Responsible officers), verify active PRC status (links to W600 employee PRC verification), and map each to the license condition (W4834) and entity (W4822)
Responsible (R): PCAB Compliance Lead / HR / Engineering
Accountable (A): VP Legal &amp; Compliance / Director, Facilities &amp; Real Estate
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4835_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4835_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4835_Task6" name="Manage personnel lifecycle against license needs: on hire, credential-verify…">
        <bpmn:documentation>Step 2: Manage personnel lifecycle against license needs: on hire, credential-verify and name on the license where required; on resignation, immediately backfill to avoid a condition breach (W4834/W4824); manage the no-sole-dependency rule (backup for each critical credential)
Responsible (R): HR / PCAB Compliance Lead / Engineering
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4835_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4835_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4835_Task7" name="Track CPD/continuing-professional-development units per named staff per…">
        <bpmn:documentation>Step 3: Track CPD/continuing-professional-development units per named staff per PRC/PCAB requirements, ensure thresholds are met before renewal (W4820), and fund/coordinate CPD via Learning (VS-19.4); report credential-health to analytics (W4839)
Responsible (R): HR / Learning / PCAB Compliance Lead
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Annual + continuous</bpmn:documentation>
        <bpmn:incoming>W4835_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4835_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4835_End8" name="Complete">
        <bpmn:incoming>W4835_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4835_Annotation9">
        <bpmn:text>Controls: - CTL-727 (ensure controlled execution — Contractor Compliance, Inspection Response &amp; Analytics (PA-165.3).) | - CTL-727: named technical staff PRC-current; backup for each critical credential; CPD thresholds met
Owner: PCAB Compliance Lead / HR (VS-19.4)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4835_Assoc10" sourceRef="W4835_Annotation9" targetRef="W4835_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4835_Flow11" sourceRef="W4835_Start4" targetRef="W4835_Task5" />
      <bpmn:sequenceFlow id="W4835_Flow12" sourceRef="W4835_Task5" targetRef="W4835_Task6" />
      <bpmn:sequenceFlow id="W4835_Flow13" sourceRef="W4835_Task6" targetRef="W4835_Task7" />
      <bpmn:sequenceFlow id="W4835_Flow14" sourceRef="W4835_Task7" targetRef="W4835_End8" />
    </bpmn:process>
