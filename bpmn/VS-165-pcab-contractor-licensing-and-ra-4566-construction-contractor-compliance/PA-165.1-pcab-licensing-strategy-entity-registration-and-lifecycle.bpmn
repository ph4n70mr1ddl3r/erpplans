<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-165.1-pcab-licensing-strategy-entity-registration-and-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4817" name="W4817. PCAB Licensing Strategy, Entity Eligibility &amp; Contractor-Category Decision" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; new service line (installation VS-12, design-build VS-66, B2G delivery-and-install VS-46); entity added; annual strategy review
Frequency: Annual + on trigger
Volume: 1 group strategy; ~1–5 of the 5 entities requiring a PCAB license; ~2–4 license categories (Regular AAA/AA/A/B + Specialty)
Owner: VP Legal &amp; Compliance / PCAB Compliance Lead
Participants: COO, Director, Facilities &amp; Real Estate (VS-20), Trade Sales (VS-11), Government Sales (VS-46), Finance (VS-17), HR (VS-19.4 technical personnel)
Source: workflow W4817 — PCAB Licensing Strategy, Entity Eligibility &amp; Contractor-Category Decision</bpmn:documentation>
      <bpmn:laneSet id="W4817_LaneSet2">
        <bpmn:lane id="W4817_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4817_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4817_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4817_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4817_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4817_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4817_Start3" name="Program launch; new service line (installation VS-12, design-build VS-66, B2G…">
        <bpmn:outgoing>W4817_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4817_Task4" name="Determine where BuildRight acts as a *contractor* (vs pure material supplier)…">
        <bpmn:documentation>Step 1: Determine where BuildRight acts as a *contractor* (vs pure material supplier) across its service lines — installation (VS-12), design-build (VS-66), bulky install (VS-143), B2G delivery-and-install (VS-46/VS-11.2), own-site construction (VS-20) — and map each to the PCAB license-required trigger (engaging in the business of contracting; execution of construction/install scope for an owner)
Responsible (R): PCAB Compliance Lead / Legal / Trade Sales
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4817_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4817_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4817_Task5" name="Decide the licensing structure per entity: which of the 5 entities (Depot…">
        <bpmn:documentation>Step 2: Decide the licensing structure per entity: which of the 5 entities (Depot, Logistics, Digital Commerce, Property Mgmt, Holdings) holds which license; the category/size needed (Regular vs Specialty; AAA/AA/A/B/BB/Gen-B by max single-project value); and the affiliate/branch-coverage approach; validate against capitalization, equipment, and technical-personnel requirements
Responsible (R): PCAB Compliance Lead / Finance / HR / Engineering
Accountable (A): COO / VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4817_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4817_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4817_Task6" name="Approve the strategy &amp; multi-year license roadmap; integrate into corporate…">
        <bpmn:documentation>Step 3: Approve the strategy &amp; multi-year license roadmap; integrate into corporate compliance plan (VS-22/VS-166), B2G market strategy (VS-46), and the installation/design service strategy (VS-12/VS-66); set KPIs (license coverage %, renewal on-time %, project-registration timeliness, unlicensed-work incidents)
Responsible (R): PCAB Compliance Lead / Strategy
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4817_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4817_End7" name="Complete">
        <bpmn:incoming>W4817_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4817_Annotation8">
        <bpmn:text>Controls: - CTL-168 (ensure PCAB licensing validity &amp; capacity limits.) | - CTL-725: legal review of contractor-scope determination; entity/category decision approved by COO + VP Legal; coverage reviewed annually
Owner: VP Legal &amp; Compliance / PCAB Compliance Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4817_Assoc9" sourceRef="W4817_Annotation8" targetRef="W4817_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4817_Flow10" sourceRef="W4817_Start3" targetRef="W4817_Task4" />
      <bpmn:sequenceFlow id="W4817_Flow11" sourceRef="W4817_Task4" targetRef="W4817_Task5" />
      <bpmn:sequenceFlow id="W4817_Flow12" sourceRef="W4817_Task5" targetRef="W4817_Task6" />
      <bpmn:sequenceFlow id="W4817_Flow13" sourceRef="W4817_Task6" targetRef="W4817_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4817_diag">
      <bpmndi:BPMNPlane id="W4817_plane" bpmnElement="W_W4817">
        <bpmndi:BPMNShape id="W4817_Lane1_di" bpmnElement="W4817_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_Task4_di" bpmnElement="W4817_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_Task5_di" bpmnElement="W4817_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_Task6_di" bpmnElement="W4817_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_Start3_di" bpmnElement="W4817_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_End7_di" bpmnElement="W4817_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4817_Annotation8_di" bpmnElement="W4817_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4817_Flow10_di" bpmnElement="W4817_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4817_Flow11_di" bpmnElement="W4817_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4817_Flow12_di" bpmnElement="W4817_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4817_Flow13_di" bpmnElement="W4817_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4817_Assoc9_di" bpmnElement="W4817_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4818" name="W4818. PCAB License Application, Documentation Package &amp; Registration Issuance (RA 4566)" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy approved (W4817); new entity licensed; category added
Frequency: Per license application (initial)
Volume: ~1 application per entity/category at launch; ~rare new-category applications thereafter
Owner: PCAB Compliance Lead / Legal (VS-100.3)
Participants: Finance (audited FS), HR (technical personnel), Engineering (equipment list), External consultant/fixer, CIAP/PCAB
Source: workflow W4818 — PCAB License Application, Documentation Package &amp; Registration Issuance (RA 4566)</bpmn:documentation>
      <bpmn:laneSet id="W4818_LaneSet2">
        <bpmn:lane id="W4818_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4818_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4818_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4818_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4818_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4818_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4818_Start3" name="Strategy approved (W4817); new entity licensed; category added">
        <bpmn:outgoing>W4818_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4818_Task4" name="Assemble the RA 4566 / PCAB IRR documentation package per entity &amp; category…">
        <bpmn:documentation>Step 1: Assemble the RA 4566 / PCAB IRR documentation package per entity &amp; category: SEC/DTI registration, BIR tax clearance, current mayor&#x27;s permit (per entity HQ + branches), audited financial statements demonstrating net worth/capitalization, list of technical personnel (civil engineer, ECE, architect — PRC-licensed per W600), equipment inventory, business address, and the application form with required fees
Responsible (R): PCAB Compliance Lead / Finance / HR / Engineering
Accountable (A): VP Legal &amp; Compliance
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4818_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4818_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4818_Task5" name="Submit to CIAP/PCAB, track evaluation, respond to deficiencies (show-cause…">
        <bpmn:documentation>Step 2: Submit to CIAP/PCAB, track evaluation, respond to deficiencies (show-cause, additional documents, personnel/equipment validation), and coordinate the PCAB evaluation/inspection; manage external consultant/fixer per VS-166 third-party-provider governance
Responsible (R): PCAB Compliance Lead / Legal / External Consultant
Accountable (A): VP Legal &amp; Compliance
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4818_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4818_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4818_Task6" name="Receive the Certificate of Registration/License, record in the compliance…">
        <bpmn:documentation>Step 3: Receive the Certificate of Registration/License, record in the compliance register (VS-166) with license number, category, validity, conditions, and authorized scope; publish license proof to bidding/PhilGEPS (VS-46) and the installation/design service teams (VS-12/VS-66); trigger renewal on the calendar (W4820)
Responsible (R): PCAB Compliance Lead / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4818_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4818_End7" name="Complete">
        <bpmn:incoming>W4818_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4818_Annotation8">
        <bpmn:text>Controls: - CTL-168 (ensure PCAB licensing validity &amp; capacity limits.) | - CTL-725: complete documentation package per RA 4566/PCAB IRR; external consultant governed (VS-166); license recorded before any in-scope work begins
Owner: PCAB Compliance Lead / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4818_Assoc9" sourceRef="W4818_Annotation8" targetRef="W4818_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4818_Flow10" sourceRef="W4818_Start3" targetRef="W4818_Task4" />
      <bpmn:sequenceFlow id="W4818_Flow11" sourceRef="W4818_Task4" targetRef="W4818_Task5" />
      <bpmn:sequenceFlow id="W4818_Flow12" sourceRef="W4818_Task5" targetRef="W4818_Task6" />
      <bpmn:sequenceFlow id="W4818_Flow13" sourceRef="W4818_Task6" targetRef="W4818_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4818_diag">
      <bpmndi:BPMNPlane id="W4818_plane" bpmnElement="W_W4818">
        <bpmndi:BPMNShape id="W4818_Lane1_di" bpmnElement="W4818_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
