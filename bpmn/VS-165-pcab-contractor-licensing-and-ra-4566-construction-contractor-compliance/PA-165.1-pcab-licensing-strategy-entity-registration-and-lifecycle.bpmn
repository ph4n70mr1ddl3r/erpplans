        <bpmndi:BPMNShape id="W4819_Start3_di" bpmnElement="W4819_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4819_End7_di" bpmnElement="W4819_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4819_Annotation8_di" bpmnElement="W4819_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4819_Flow10_di" bpmnElement="W4819_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4819_Flow11_di" bpmnElement="W4819_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4819_Flow12_di" bpmnElement="W4819_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4819_Flow13_di" bpmnElement="W4819_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4819_Assoc9_di" bpmnElement="W4819_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4820" name="W4820. PCAB Annual License Renewal, Registration Compliance &amp; Expiry Calendar" isExecutable="false">
      <bpmn:documentation>Trigger: Annual license-renewal cycle (PCAB registration renewed annually); 60/90-day pre-expiry alert
Frequency: Annual per license
Volume: ~1–5 licenses (entities/categories) × annual renewal
Owner: PCAB Compliance Lead / Legal
Participants: Finance (fees, updated FS), HR (personnel currency), Engineering (equipment), Compliance Portfolio (VS-166)
Source: workflow W4820 — PCAB Annual License Renewal, Registration Compliance &amp; Expiry Calendar</bpmn:documentation>
      <bpmn:laneSet id="W4820_LaneSet2">
        <bpmn:lane id="W4820_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4820_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4820_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4820_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4820_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4820_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4820_Start3" name="Annual license-renewal cycle (PCAB registration renewed annually); 60/90-day pre-expiry…">
        <bpmn:outgoing>W4820_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4820_Task4" name="Maintain the PCAB renewal calendar in the compliance register (VS-166): license…">
        <bpmn:documentation>Step 1: Maintain the PCAB renewal calendar in the compliance register (VS-166): license number, expiry, renewal owner, required documents, fee, and the 60/90/30-day pre-expiry alerts; reconcile annually with CIAP/PCAB published schedules
Responsible (R): PCAB Compliance Lead / Compliance Portfolio
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4820_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4820_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4820_Task5" name="Prepare &amp; submit the annual renewal: updated mayor&#x27;s permit, current BIR tax…">
        <bpmn:documentation>Step 2: Prepare &amp; submit the annual renewal: updated mayor&#x27;s permit, current BIR tax clearance, updated audited FS, current technical-personnel roster (W4834), equipment list, paid annual registration fee, and proof of completed continuing requirements (insurance, safety program W4827); respond to PCAB queries
Responsible (R): PCAB Compliance Lead / Finance / HR / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4820_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4820_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4820_Task6" name="Receive renewed Certificate of Registration, update the license master (VS-166)…">
        <bpmn:documentation>Step 3: Receive renewed Certificate of Registration, update the license master (VS-166) and the bid-eligibility evidence (VS-46); escalate any lapse-risk to COO/Legal and trigger the lapse-prevention/remediation workflow (W4824) if a renewal is delayed
Responsible (R): PCAB Compliance Lead / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4820_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4820_End7" name="Complete">
        <bpmn:incoming>W4820_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4820_Annotation8">
        <bpmn:text>Controls: - CTL-168 (ensure PCAB licensing validity &amp; capacity limits.) | - CTL-725: annual renewal filed before expiry; evidence recorded (VS-166); lapse-risk escalated
Owner: PCAB Compliance Lead / Legal</bpmn:text>
      </bpmn:textAnnotation>
