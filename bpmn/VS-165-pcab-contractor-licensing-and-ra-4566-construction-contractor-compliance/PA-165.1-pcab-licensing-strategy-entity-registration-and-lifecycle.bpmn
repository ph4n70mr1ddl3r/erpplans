        <bpmndi:BPMNShape id="W4818_Task6_di" bpmnElement="W4818_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4818_Start3_di" bpmnElement="W4818_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4818_End7_di" bpmnElement="W4818_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4818_Annotation8_di" bpmnElement="W4818_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4818_Flow10_di" bpmnElement="W4818_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4818_Flow11_di" bpmnElement="W4818_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4818_Flow12_di" bpmnElement="W4818_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4818_Flow13_di" bpmnElement="W4818_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4818_Assoc9_di" bpmnElement="W4818_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4819" name="W4819. License Category, Classification &amp; Size/Capacity Upgrade Management" isExecutable="false">
      <bpmn:documentation>Trigger: Larger project opportunity exceeding current category cap; capacity/capitalization growth; strategic expansion (W4817)
Frequency: Per upgrade event + annual review
Volume: ~rare upgrades (e.g., B → A → AA as B2G/project scale grows)
Owner: PCAB Compliance Lead / Trade Sales (VS-11) / Finance
Participants: Legal (VS-100.3), Engineering, HR, CIAP/PCAB
Source: workflow W4819 — License Category, Classification &amp; Size/Capacity Upgrade Management</bpmn:documentation>
      <bpmn:laneSet id="W4819_LaneSet2">
        <bpmn:lane id="W4819_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4819_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4819_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4819_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4819_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4819_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4819_Start3" name="Larger project opportunity exceeding current category cap; capacity/capitalization…">
        <bpmn:outgoing>W4819_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4819_Task4" name="Identify the upgrade trigger (a specific bid/project exceeding the current…">
        <bpmn:documentation>Step 1: Identify the upgrade trigger (a specific bid/project exceeding the current category&#x27;s max single-contract value, or strategic capacity growth), confirm the target category/size, and assess eligibility (capitalization, equipment, technical personnel, track record of completed projects)
Responsible (R): PCAB Compliance Lead / Finance / HR / Trade Sales
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4819_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4819_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4819_Task5" name="Prepare &amp; submit the upgrade application (additional capitalization evidence…">
        <bpmn:documentation>Step 2: Prepare &amp; submit the upgrade application (additional capitalization evidence, completed-projects list, personnel/equipment add), track PCAB evaluation, and respond to deficiencies
Responsible (R): PCAB Compliance Lead / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4819_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4819_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4819_Task6" name="On approval, update the license master (VS-166), notify bidding/sales…">
        <bpmn:documentation>Step 3: On approval, update the license master (VS-166), notify bidding/sales (VS-46/VS-11) of the new capacity, and feed the upgrade economics (application cost vs incremental bid-access) to analytics (W4839)
Responsible (R): PCAB Compliance Lead / Finance
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4819_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4819_End7" name="Complete">
        <bpmn:incoming>W4819_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4819_Annotation8">
        <bpmn:text>Controls: - CTL-168 (ensure PCAB licensing validity &amp; capacity limits.) | - CTL-725: upgrade application complete &amp; approved by VP Legal; capacity validated before bidding at the new level
Owner: PCAB Compliance Lead / Trade Sales (VS-11) / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4819_Assoc9" sourceRef="W4819_Annotation8" targetRef="W4819_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4819_Flow10" sourceRef="W4819_Start3" targetRef="W4819_Task4" />
      <bpmn:sequenceFlow id="W4819_Flow11" sourceRef="W4819_Task4" targetRef="W4819_Task5" />
      <bpmn:sequenceFlow id="W4819_Flow12" sourceRef="W4819_Task5" targetRef="W4819_Task6" />
      <bpmn:sequenceFlow id="W4819_Flow13" sourceRef="W4819_Task6" targetRef="W4819_End7" />
    </bpmn:process>
