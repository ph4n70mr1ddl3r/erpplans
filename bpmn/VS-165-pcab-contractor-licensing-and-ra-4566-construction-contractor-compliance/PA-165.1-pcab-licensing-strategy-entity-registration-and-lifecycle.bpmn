    <bpmn:process id="W_W4824" name="W4824. License Lapse/Revocation Prevention, Condition Breach Reporting &amp; Reinstatement" isExecutable="false">
      <bpmn:documentation>Trigger: Renewal delayed (W4820); condition breach (personnel/equipment/insurance shortfall); PCAB show-cause/suspension/revocation notice; complaint
Frequency: Ad hoc (lapse/breach events)
Volume: ~rare events; ~any lapse is critical
Owner: PCAB Compliance Lead / Legal (VS-100.3)
Participants: COO, Trade Sales (VS-11), HR (VS-19.4), Finance, Insurance (VS-26/VS-116)
Source: workflow W4824 — License Lapse/Revocation Prevention, Condition Breach Reporting &amp; Reinstatement</bpmn:documentation>
      <bpmn:laneSet id="W4824_LaneSet2">
        <bpmn:lane id="W4824_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4824_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4824_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4824_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4824_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4824_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4824_Start3" name="Renewal delayed (W4820); condition breach (personnel/equipment/insurance shortfall); PCAB…">
        <bpmn:outgoing>W4824_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4824_Task4" name="Detect the lapse/breach risk: expiry alert missed (W4820), condition shortfall…">
        <bpmn:documentation>Step 1: Detect the lapse/breach risk: expiry alert missed (W4820), condition shortfall (lost PRC engineer, lapsed insurance, equipment disposed), or a PCAB notice (show-cause, suspension, revocation); assess business impact (active bids VS-46, in-flight projects W4825, ongoing install VS-12) and escalate to COO/Legal immediately
Responsible (R): PCAB Compliance Lead / Compliance Portfolio / Legal
Accountable (A): VP Legal &amp; Compliance / COO
Duration: Per event (immediate)</bpmn:documentation>
        <bpmn:incoming>W4824_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4824_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4824_Task5" name="Contain &amp; remediate: for a renewal delay, expedite filing and, where lawful…">
        <bpmn:documentation>Step 2: Contain &amp; remediate: for a renewal delay, expedite filing and, where lawful, pause new in-scope contracting until reinstated; for a condition breach, cure within the PCAB cure period (replace personnel W4834, restore insurance/equipment); for a suspension/revocation notice, file a response/appeal (W4821/W4838) and manage active-project continuity (transfer scope, subcontract under a licensed partner W4829)
Responsible (R): PCAB Compliance Lead / Legal / HR / Finance / Trade Sales
Accountable (A): VP Legal &amp; Compliance / COO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4824_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4824_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4824_Task6" name="Reinstate &amp; prevent recurrence: obtain reinstatement/renewed license, update…">
        <bpmn:documentation>Step 3: Reinstate &amp; prevent recurrence: obtain reinstatement/renewed license, update the register (VS-166) and bid eligibility (VS-46), conduct a root-cause review (calendar failure, personnel-retention gap), strengthen controls, and report the incident/lesson to governance (W4840) and analytics (W4839)
Responsible (R): PCAB Compliance Lead / Legal / Internal Audit
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4824_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4824_End7" name="Complete">
        <bpmn:incoming>W4824_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4824_Annotation8">
        <bpmn:text>Controls: - CTL-725 (ensure controlled execution — PCAB Licensing Strategy, Entity Registration &amp; Lifecycle (PA-165.1).) | - CTL-725: lapse/breach escalated immediately; new in-scope contracting paused until reinstated where required; root-cause review documented
Owner: PCAB Compliance Lead / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4824_Assoc9" sourceRef="W4824_Annotation8" targetRef="W4824_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4824_Flow10" sourceRef="W4824_Start3" targetRef="W4824_Task4" />
      <bpmn:sequenceFlow id="W4824_Flow11" sourceRef="W4824_Task4" targetRef="W4824_Task5" />
      <bpmn:sequenceFlow id="W4824_Flow12" sourceRef="W4824_Task5" targetRef="W4824_Task6" />
      <bpmn:sequenceFlow id="W4824_Flow13" sourceRef="W4824_Task6" targetRef="W4824_End7" />
    </bpmn:process>
