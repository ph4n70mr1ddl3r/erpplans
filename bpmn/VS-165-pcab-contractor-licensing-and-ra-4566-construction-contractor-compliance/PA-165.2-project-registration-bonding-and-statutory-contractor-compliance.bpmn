      <bpmndi:BPMNPlane id="W4827_plane" bpmnElement="W_W4827">
        <bpmndi:BPMNShape id="W4827_Lane1_di" bpmnElement="W4827_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
