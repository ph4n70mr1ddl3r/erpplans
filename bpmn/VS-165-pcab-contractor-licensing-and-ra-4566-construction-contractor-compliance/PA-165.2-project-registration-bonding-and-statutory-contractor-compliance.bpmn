    <bpmn:process id="W_W4826" name="W4826. Performance &amp; Surety Bonding for PCAB-Licensed Project Work" isExecutable="false">
      <bpmn:documentation>Trigger: Project award (W4825); bid bond at tender (VS-116); contract/bond requirement
Frequency: Per project
Volume: ~B2G + large B2B project bonds per year
Owner: PCAB Compliance Lead / Treasury-Surety (VS-116) / Legal
Participants: Finance (VS-18 facility), Surety/Bank, Insurance (VS-26), Trade Sales (VS-11)
Source: workflow W4826 — Performance &amp; Surety Bonding for PCAB-Licensed Project Work</bpmn:documentation>
      <bpmn:laneSet id="W4826_LaneSet3">
        <bpmn:lane id="W4826_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4826_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4826_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4826_Lane2" name="Treasury-Surety">
        <bpmn:flowNodeRef>W4826_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4826_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4826_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4826_Start4" name="Project award (W4825); bid bond at tender (VS-116); contract/bond requirement">
        <bpmn:outgoing>W4826_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4826_Task5" name="Identify the bonding requirement per project (bid bond at tender VS-116…">
        <bpmn:documentation>Step 1: Identify the bonding requirement per project (bid bond at tender VS-116, performance bond 5–30% of contract, payment bond, warranty bond, retention) and confirm it against the license conditions (W4820) and the contract (VS-100.3)
Responsible (R): PCAB Compliance Lead / Treasury-Surety / Trade Sales
Accountable (A): VP Legal &amp; Compliance / CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W4826_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4826_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4826_Task6" name="Arrange &amp; issue the bond via the surety facility (VS-116): application…">
        <bpmn:documentation>Step 2: Arrange &amp; issue the bond via the surety facility (VS-116): application, counter-indemnity/collateral, premium, encumbrance on credit facility; deliver to owner/beneficiary and record encumbrance
Responsible (R): Treasury-Surety / Finance / Legal
Accountable (A): CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W4826_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4826_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4826_Task7" name="Track bond validity across the project + warranty period, manage…">
        <bpmn:documentation>Step 3: Track bond validity across the project + warranty period, manage reduction/release at acceptance (W4830) and final release at warranty expiry, and manage any bond claim/call (W4831/VS-116); feed bond economics to analytics (W4839)
Responsible (R): Treasury-Surety / PCAB Compliance Lead / Legal
Accountable (A): CFO / VP Legal &amp; Compliance
Duration: Per project + continuous</bpmn:documentation>
        <bpmn:incoming>W4826_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4826_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4826_End8" name="Complete">
        <bpmn:incoming>W4826_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4826_Annotation9">
        <bpmn:text>Controls: - CTL-726 (ensure controlled execution — Project Registration, Bonding &amp; Statutory Contractor Compliance (PA-165.2).) | - CTL-726: bond per contract/license requirement; facility encumbrance tracked (VS-116); release at milestones
Owner: PCAB Compliance Lead / Treasury-Surety (VS-116) / Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4826_Assoc10" sourceRef="W4826_Annotation9" targetRef="W4826_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4826_Flow11" sourceRef="W4826_Start4" targetRef="W4826_Task5" />
      <bpmn:sequenceFlow id="W4826_Flow12" sourceRef="W4826_Task5" targetRef="W4826_Task6" />
      <bpmn:sequenceFlow id="W4826_Flow13" sourceRef="W4826_Task6" targetRef="W4826_Task7" />
      <bpmn:sequenceFlow id="W4826_Flow14" sourceRef="W4826_Task7" targetRef="W4826_End8" />
    </bpmn:process>
