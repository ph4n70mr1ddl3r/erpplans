        <bpmndi:BPMNEdge id="W4826_Flow12_di" bpmnElement="W4826_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4826_Flow13_di" bpmnElement="W4826_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4826_Flow14_di" bpmnElement="W4826_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4826_Assoc10_di" bpmnElement="W4826_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4827" name="W4827. Construction Safety &amp; Health Program (COSP) &amp; DOLE D.O. 13-98 Compliance for Licensed Work" isExecutable="false">
      <bpmn:documentation>Trigger: Licensed project start (W4825); PCAB/DOLE requirement; annual program refresh
Frequency: Per project + annual program
Volume: All licensed construction/install projects
Owner: PCAB Compliance Lead / HSE (VS-24) / Safety Officer
Participants: DOLE-qualified Safety Officer, Engineering (VS-20), Installation (VS-12), HR (VS-19.4)
Source: workflow W4827 — Construction Safety &amp; Health Program (COSP) &amp; DOLE D.O. 13-98 Compliance for Licensed Work</bpmn:documentation>
      <bpmn:laneSet id="W4827_LaneSet3">
        <bpmn:lane id="W4827_Lane1" name="PCAB Compliance Lead">
        <bpmn:flowNodeRef>W4827_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4827_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4827_Lane2" name="HSE">
        <bpmn:flowNodeRef>W4827_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4827_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4827_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4827_Start4" name="Licensed project start (W4825); PCAB/DOLE requirement; annual program refresh">
        <bpmn:outgoing>W4827_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4827_Task5" name="Establish/maintain the Construction Safety &amp; Health Program (COSP) required for…">
        <bpmn:documentation>Step 1: Establish/maintain the Construction Safety &amp; Health Program (COSP) required for licensed contracting: DOLE D.O. 13-98 (Guidelines Governing Occupational Safety and Health in the Construction Industry) compliance — safety officer (SO1/SO2/SO3 per project size), safety program, PPE, incident reporting, and the OSH construction requirements; integrate with VS-24 HSE
Responsible (R): PCAB Compliance Lead / HSE / Safety Officer
Accountable (A): VP Legal &amp; Compliance / Director, Facilities &amp; Real Estate
Duration: Per project + annual</bpmn:documentation>
        <bpmn:incoming>W4827_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4827_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4827_Task6" name="Deploy per project: site-specific safety plan, qualified safety officer, worker…">
        <bpmn:documentation>Step 2: Deploy per project: site-specific safety plan, qualified safety officer, worker safety induction/orientation, daily safety briefing, incident reporting; verify for installation crews (VS-12/VS-143) on customer sites; coordinate with the project owner&#x27;s safety program
Responsible (R): HSE / Safety Officer / Installation / Engineering
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W4827_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4827_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4827_Task7" name="Report safety performance to DOLE/PCAB as required, manage any construction…">
        <bpmn:documentation>Step 3: Report safety performance to DOLE/PCAB as required, manage any construction incident (links to VS-24 incident management), and feed safety-record to license conditions (W4834) and analytics (W4839)
Responsible (R): HSE / PCAB Compliance Lead / Legal
Accountable (A): VP Legal &amp; Compliance / Director, Facilities &amp; Real Estate
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4827_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4827_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4827_End8" name="Complete">
        <bpmn:incoming>W4827_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4827_Annotation9">
        <bpmn:text>Controls: - CTL-726 (ensure controlled execution — Project Registration, Bonding &amp; Statutory Contractor Compliance (PA-165.2).) | - CTL-726: DOLE-qualified safety officer per project; COSP documented; incidents reported and managed (VS-24)
Owner: PCAB Compliance Lead / HSE (VS-24) / Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4827_Assoc10" sourceRef="W4827_Annotation9" targetRef="W4827_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4827_Flow11" sourceRef="W4827_Start4" targetRef="W4827_Task5" />
      <bpmn:sequenceFlow id="W4827_Flow12" sourceRef="W4827_Task5" targetRef="W4827_Task6" />
      <bpmn:sequenceFlow id="W4827_Flow13" sourceRef="W4827_Task6" targetRef="W4827_Task7" />
      <bpmn:sequenceFlow id="W4827_Flow14" sourceRef="W4827_Task7" targetRef="W4827_End8" />
    </bpmn:process>
