      </bpmn:startEvent>
      <bpmn:userTask id="W2880_Task5" name="LR Director charters LMC with union: composition, meeting cadence, agenda scope…">
        <bpmn:documentation>Step 1: LR Director charters LMC with union: composition, meeting cadence, agenda scope (productivity, quality, welfare, communication)
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: At establishment</bpmn:documentation>
        <bpmn:incoming>W2880_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2880_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2880_Task6" name="LMC convenes quarterly; discusses operational improvements, employee concerns…">
        <bpmn:documentation>Step 2: LMC convenes quarterly; discusses operational improvements, employee concerns, and joint initiatives; documents minutes
Responsible (R): Management Reps / Union Reps
Accountable (A): LR Director
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2880_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2880_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2880_Task7" name="LR Director tracks action items; reports LMC outcomes and partnership health to…">
        <bpmn:documentation>Step 3: LR Director tracks action items; reports LMC outcomes and partnership health to Executive Committee
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2880_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2880_End8" name="Complete">
        <bpmn:incoming>W2880_Flow14</bpmn:incoming>
      </bpmn:endEvent>
