      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2875" name="W2875. CBA Negotiation Sessions, Deadlock Management &amp; DOLE Conciliation" isExecutable="false">
      <bpmn:documentation>Trigger: CBA negotiation cycle
Frequency: Per CBA cycle (5-year + reopeners)
Volume: Multiple sessions
Owner: Labor Relations Director
Participants: LR Director, Management Panel, Union Panel, DOLE Conciliator
Source: workflow W2875 — CBA Negotiation Sessions, Deadlock Management &amp; DOLE Conciliation</bpmn:documentation>
      <bpmn:laneSet id="W2875_LaneSet3">
        <bpmn:lane id="W2875_Lane1" name="LR Director">
        <bpmn:flowNodeRef>W2875_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2875_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2875_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2875_Lane2" name="Management">
        <bpmn:flowNodeRef>W2875_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2875_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2875_Start4" name="CBA negotiation cycle">
        <bpmn:outgoing>W2875_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2875_Task5" name="LR Director conducts bargaining sessions per Labor Code (meets within 30 days…">
        <bpmn:documentation>Step 1: LR Director conducts bargaining sessions per Labor Code (meets within 30 days of notice); bargains in good faith; documents positions
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per session</bpmn:documentation>
        <bpmn:incoming>W2875_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2875_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2875_Task6" name="On deadlock, LR Director files notice of strike/lockout or submits to DOLE…">
        <bpmn:documentation>Step 2: On deadlock, LR Director files notice of strike/lockout or submits to DOLE conciliation; participates in preventive mediation
Responsible (R): LR Director / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per deadlock</bpmn:documentation>
        <bpmn:incoming>W2875_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2875_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2875_Task7" name="Management executes contingency plan (operations continuity, temporary…">
        <bpmn:documentation>Step 3: Management executes contingency plan (operations continuity, temporary staffing, security) during impasse; seeks resolution before strike deadline
Responsible (R): Management / BCM
Accountable (A): CEO
Duration: Per deadlock</bpmn:documentation>
        <bpmn:incoming>W2875_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2875_End8" name="Complete">
        <bpmn:incoming>W2875_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2875_Annotation9">
        <bpmn:text>Controls: - CTL-481 (ensure controlled execution — Union Recognition, CBA Negotiation &amp; Administration (PA-84.1).) | - operational: good-faith bargaining and contingency planning
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2875_Assoc10" sourceRef="W2875_Annotation9" targetRef="W2875_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2875_Flow11" sourceRef="W2875_Start4" targetRef="W2875_Task5" />
      <bpmn:sequenceFlow id="W2875_Flow12" sourceRef="W2875_Task5" targetRef="W2875_Task6" />
      <bpmn:sequenceFlow id="W2875_Flow13" sourceRef="W2875_Task6" targetRef="W2875_Task7" />
      <bpmn:sequenceFlow id="W2875_Flow14" sourceRef="W2875_Task7" targetRef="W2875_End8" />
    </bpmn:process>
