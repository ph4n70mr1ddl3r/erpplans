    <bpmn:process id="W_W2876" name="W2876. CBA Drafting, Ratification, Registration &amp; Publication" isExecutable="false">
      <bpmn:documentation>Trigger: Negotiation agreement (Terms of Settlement)
Frequency: Per CBA cycle
Volume: Per bargaining unit
Owner: Labor Relations Director
Participants: LR Director, Legal, Union, DOLE
Source: workflow W2876 — CBA Drafting, Ratification, Registration &amp; Publication</bpmn:documentation>
      <bpmn:laneSet id="W2876_LaneSet4">
        <bpmn:lane id="W2876_Lane1" name="Legal">
        <bpmn:flowNodeRef>W2876_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2876_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2876_Lane2" name="Union">
        <bpmn:flowNodeRef>W2876_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2876_Lane3" name="LR Director">
        <bpmn:flowNodeRef>W2876_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2876_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2876_Start5" name="Negotiation agreement (Terms of Settlement)">
        <bpmn:outgoing>W2876_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2876_Task6" name="Legal/LR Director drafts CBA text from agreed terms; reviews for legal…">
        <bpmn:documentation>Step 1: Legal/LR Director drafts CBA text from agreed terms; reviews for legal compliance and consistency with company policy and Labor Code
Responsible (R): Legal / LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2876_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2876_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2876_Task7" name="Union ratifies CBA with membership vote; LR Director verifies ratification…">
        <bpmn:documentation>Step 2: Union ratifies CBA with membership vote; LR Director verifies ratification; both parties sign
Responsible (R): Union / LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per ratification</bpmn:documentation>
        <bpmn:incoming>W2876_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2876_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2876_Task8" name="LR Director registers CBA with DOLE Regional Office within 5 days of signing…">
        <bpmn:documentation>Step 3: LR Director registers CBA with DOLE Regional Office within 5 days of signing; publishes for employees; archives executed copy
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2876_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2876_End9" name="Complete">
        <bpmn:incoming>W2876_Flow15</bpmn:incoming>
      </bpmn:endEvent>
