        <bpmndi:BPMNEdge id="W2874_Flow14_di" bpmnElement="W2874_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2874_Flow15_di" bpmnElement="W2874_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
