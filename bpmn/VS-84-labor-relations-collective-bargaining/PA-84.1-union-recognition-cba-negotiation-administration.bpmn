    <bpmn:process id="W_W2873" name="W2873. Labor Organization Certification, Recognition &amp; Verification (DOLE)" isExecutable="false">
      <bpmn:documentation>Trigger: Petition for certification election or voluntary recognition request
Frequency: Event-driven
Volume: ~5–10 events/decade
Owner: Labor Relations Director
Participants: LR Director, Legal, HR, DOLE, Union
Source: workflow W2873 — Labor Organization Certification, Recognition &amp; Verification (DOLE)</bpmn:documentation>
      <bpmn:laneSet id="W2873_LaneSet3">
        <bpmn:lane id="W2873_Lane1" name="LR Director">
        <bpmn:flowNodeRef>W2873_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2873_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2873_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2873_Lane2" name="HR">
        <bpmn:flowNodeRef>W2873_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2873_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2873_Start4" name="Petition for certification election or voluntary recognition request">
        <bpmn:outgoing>W2873_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2873_Task5" name="LR Director receives petition for certification election or voluntary…">
        <bpmn:documentation>Step 1: LR Director receives petition for certification election or voluntary recognition request; validates the petitioner&#x27;s legitimate-labor-organization status and bargaining-unit definition (a petition by an LLO is automatically ordered conducted per RA 9481 — no minimum support showing)
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2873_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2873_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2873_Task6" name="LR Director/Legal files with the DOLE Regional Office (Med-Arbiter, per D.O…">
        <bpmn:documentation>Step 2: LR Director/Legal files with the DOLE Regional Office (Med-Arbiter, per D.O. 40-03) for certification election; participates in pre-election conference; mediates bargaining-unit definition
Responsible (R): LR Director / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Weeks</bpmn:documentation>
        <bpmn:incoming>W2873_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2873_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2873_Task7" name="HR conducts certification election (with DOLE); notifies results; recognizes…">
        <bpmn:documentation>Step 3: HR conducts certification election (with DOLE); notifies results; recognizes certified union as exclusive bargaining representative upon majority vote
Responsible (R): HR / DOLE
Accountable (A): VP Legal &amp; Compliance
Duration: Per election</bpmn:documentation>
        <bpmn:incoming>W2873_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2873_End8" name="Complete">
        <bpmn:incoming>W2873_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2873_Annotation9">
        <bpmn:text>Controls: - CTL-481 (ensure controlled execution — Union Recognition, CBA Negotiation &amp; Administration (PA-84.1).) | - operational: strict legal process and neutrality
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2873_Assoc10" sourceRef="W2873_Annotation9" targetRef="W2873_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2873_Flow11" sourceRef="W2873_Start4" targetRef="W2873_Task5" />
      <bpmn:sequenceFlow id="W2873_Flow12" sourceRef="W2873_Task5" targetRef="W2873_Task6" />
      <bpmn:sequenceFlow id="W2873_Flow13" sourceRef="W2873_Task6" targetRef="W2873_Task7" />
      <bpmn:sequenceFlow id="W2873_Flow14" sourceRef="W2873_Task7" targetRef="W2873_End8" />
    </bpmn:process>
