    <bpmn:process id="W_W2874" name="W2874. CBA Negotiation Preparation, Data Assembly &amp; Bargaining Strategy" isExecutable="false">
      <bpmn:documentation>Trigger: CBA expiry (60-day pre-expiry notice)
Frequency: Every 5 years (CBA term) + 3-year wage reopening
Volume: Per recognized bargaining unit
Owner: Labor Relations Director
Participants: LR Director, Finance, HR, Legal, Management Panel
Source: workflow W2874 — CBA Negotiation Preparation, Data Assembly &amp; Bargaining Strategy</bpmn:documentation>
      <bpmn:laneSet id="W2874_LaneSet4">
        <bpmn:lane id="W2874_Lane1" name="LR Director">
        <bpmn:flowNodeRef>W2874_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2874_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2874_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2874_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2874_Lane3" name="Management">
        <bpmn:flowNodeRef>W2874_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2874_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2874_Start5" name="CBA expiry (60-day pre-expiry notice)">
        <bpmn:outgoing>W2874_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2874_Task6" name="LR Director assembles negotiation team (management panel); reviews prior CBA…">
        <bpmn:documentation>Step 1: LR Director assembles negotiation team (management panel); reviews prior CBA, grievances, and labor market benchmarks
Responsible (R): LR Director
Accountable (A): VP Legal &amp; Compliance
Duration: Pre-negotiation</bpmn:documentation>
        <bpmn:incoming>W2874_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2874_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2874_Task7" name="Finance prepares costing model for union proposals: wage increase, benefits…">
        <bpmn:documentation>Step 2: Finance prepares costing model for union proposals: wage increase, benefits, allowances, incentive plan; estimates 5-year financial impact
Responsible (R): Finance
Accountable (A): CFO
Duration: Pre-negotiation</bpmn:documentation>
        <bpmn:incoming>W2874_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2874_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2874_Task8" name="Management approves bargaining mandate, reservation points, and strike…">
        <bpmn:documentation>Step 3: Management approves bargaining mandate, reservation points, and strike contingency plan; LR Director finalizes strategy
Responsible (R): Management / LR Director
Accountable (A): CEO
Duration: Pre-negotiation</bpmn:documentation>
        <bpmn:incoming>W2874_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2874_End9" name="Complete">
        <bpmn:incoming>W2874_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2874_Annotation10">
        <bpmn:text>Controls: - CTL-217 (ensure labor-relations statutory compliance.) | - operational: rigorous costing and mandate clarity
Owner: Labor Relations Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2874_Assoc11" sourceRef="W2874_Annotation10" targetRef="W2874_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2874_Flow12" sourceRef="W2874_Start5" targetRef="W2874_Task6" />
      <bpmn:sequenceFlow id="W2874_Flow13" sourceRef="W2874_Task6" targetRef="W2874_Task7" />
      <bpmn:sequenceFlow id="W2874_Flow14" sourceRef="W2874_Task7" targetRef="W2874_Task8" />
      <bpmn:sequenceFlow id="W2874_Flow15" sourceRef="W2874_Task8" targetRef="W2874_End9" />
    </bpmn:process>
