    <bpmn:process id="W_W2961" name="W2961. Customs Broker Selection, Accreditation &amp; Performance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Broker onboarding or renewal
Frequency: Annual + event-driven
Volume: ~3–5 customs brokers
Owner: Trade Compliance Manager
Participants: Trade Compliance, Procurement, Logistics
Source: workflow W2961 — Customs Broker Selection, Accreditation &amp; Performance Management</bpmn:documentation>
      <bpmn:laneSet id="W2961_LaneSet3">
        <bpmn:lane id="W2961_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2961_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2961_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2961_Lane2" name="Trade Compliance">
        <bpmn:flowNodeRef>W2961_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2961_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2961_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2961_Start4" name="Broker onboarding or renewal">
        <bpmn:outgoing>W2961_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2961_Task5" name="Procurement vets customs broker: BOC AMO broker accreditation (CMO 04-2014…">
        <bpmn:documentation>Step 1: Procurement vets customs broker: BOC AMO broker accreditation (CMO 04-2014, 3-year validity; PRC license per RA 9280), PRC license, experience, references, insurance
Responsible (R): Procurement
Accountable (A): Trade Compliance Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W2961_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2961_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2961_Task6" name="Trade Compliance/Logistics contracts broker; defines SLA (clearance time, error…">
        <bpmn:documentation>Step 2: Trade Compliance/Logistics contracts broker; defines SLA (clearance time, error rate, availability) and KPIs
Responsible (R): Trade Compliance / Logistics
Accountable (A): Trade Compliance Manager
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W2961_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2961_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2961_Task7" name="Trade Compliance monitors broker performance quarterly; reviews errors, delays…">
        <bpmn:documentation>Step 3: Trade Compliance monitors broker performance quarterly; reviews errors, delays, and complaints; manages renewal/termination
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2961_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2961_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2961_End8" name="Complete">
        <bpmn:incoming>W2961_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2961_Annotation9">
        <bpmn:text>Controls: - CTL-492 (ensure controlled execution — Trade Compliance Audit, Broker Governance &amp; ADC (PA-87.3).) | - operational: SLA and quarterly review
Owner: Trade Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2961_Assoc10" sourceRef="W2961_Annotation9" targetRef="W2961_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2961_Flow11" sourceRef="W2961_Start4" targetRef="W2961_Task5" />
      <bpmn:sequenceFlow id="W2961_Flow12" sourceRef="W2961_Task5" targetRef="W2961_Task6" />
      <bpmn:sequenceFlow id="W2961_Flow13" sourceRef="W2961_Task6" targetRef="W2961_Task7" />
      <bpmn:sequenceFlow id="W2961_Flow14" sourceRef="W2961_Task7" targetRef="W2961_End8" />
    </bpmn:process>
