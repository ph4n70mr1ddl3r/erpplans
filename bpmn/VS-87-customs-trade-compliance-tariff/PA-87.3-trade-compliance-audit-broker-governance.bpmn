      <bpmndi:BPMNPlane id="W239_plane" bpmnElement="W_W239">
        <bpmndi:BPMNShape id="W239_Lane1_di" bpmnElement="W239_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
