    <bpmn:process id="W_W2963" name="W2963. BOC Alert Order, Hold &amp; Detention Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: BOC alert order or hold on shipment
Frequency: Event-driven; ~10–30 events/year
Volume: Subset of imports
Owner: Trade Compliance Specialist
Participants: Trade Compliance, Customs Broker, Legal, DC Operations
Source: workflow W2963 — BOC Alert Order, Hold &amp; Detention Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2963_LaneSet4">
        <bpmn:lane id="W2963_Lane1" name="Customs Broker">
        <bpmn:flowNodeRef>W2963_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2963_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2963_Lane2" name="Trade Compliance">
        <bpmn:flowNodeRef>W2963_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2963_Lane3" name="DC Operations">
        <bpmn:flowNodeRef>W2963_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2963_End9</bpmn:flowNodeRef>
