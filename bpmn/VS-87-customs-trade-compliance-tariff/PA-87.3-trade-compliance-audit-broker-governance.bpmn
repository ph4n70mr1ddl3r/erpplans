      <bpmn:sequenceFlow id="W2962_Flow12" sourceRef="W2962_Task5" targetRef="W2962_Task6" />
      <bpmn:sequenceFlow id="W2962_Flow13" sourceRef="W2962_Task6" targetRef="W2962_Task7" />
      <bpmn:sequenceFlow id="W2962_Flow14" sourceRef="W2962_Task7" targetRef="W2962_End8" />
    </bpmn:process>
