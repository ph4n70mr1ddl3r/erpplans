<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-87.3-trade-compliance-audit-broker-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W239" name="W239. Customs Duty &amp; Tax Reconciliation (BOC)" isExecutable="false">
      <bpmn:documentation>Trigger: Release of import shipment from Bureau of Customs (BOC)
Frequency: Per import shipment (~20–30/month)
Volume: Significant tax payments (VAT, Duties, Excise)
Owner: Import Coordinator
Participants: Finance (Tax), Customs Broker
Source: workflow W239 — Customs Duty &amp; Tax Reconciliation (BOC)</bpmn:documentation>
      <bpmn:laneSet id="W239_LaneSet4">
        <bpmn:lane id="W239_Lane1" name="Finance">
        <bpmn:flowNodeRef>W239_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W239_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W239_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W239_Lane2" name="Import Coord">
        <bpmn:flowNodeRef>W239_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W239_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W239_Lane3" name="Tax Manager">
        <bpmn:flowNodeRef>W239_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W239_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W239_Start5" name="Release of import shipment from Bureau of Customs (BOC)">
        <bpmn:outgoing>W239_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W239_Task6" name="Payment">
        <bpmn:documentation>Step 1: Payment: Pay duties and taxes via bank (IPAY/Pass5 system) based on BOC assessment
Responsible (R): Finance
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W239_Flow14</bpmn:incoming>
        <bpmn:outgoing>W239_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W239_Task7" name="Receipt Aggregation">
        <bpmn:documentation>Step 2: Receipt Aggregation: Collect Official Receipts (BCOR) and Statement of Settlement of Duties and Taxes (SSDT)
Responsible (R): Import Coord
Accountable (A): —
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W239_Flow15</bpmn:incoming>
        <bpmn:outgoing>W239_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W239_Task8" name="Reconciliation">
        <bpmn:documentation>Step 3: Reconciliation: Compare BOC assessed values vs. ERP estimated landed cost (W2B.12)
Responsible (R): Finance
Accountable (A): Controller
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W239_Flow16</bpmn:incoming>
        <bpmn:outgoing>W239_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W239_Task9" name="VAT Input Capture">
        <bpmn:documentation>Step 4: VAT Input Capture: Ensure 12% Import VAT is correctly recorded for BIR credit (W90)
Responsible (R): Tax Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W239_Flow17</bpmn:incoming>
        <bpmn:outgoing>W239_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W239_Task10" name="Variance Analysis">
        <bpmn:documentation>Step 5: Variance Analysis: Investigate significant variances in tariff classification or valuation
Responsible (R): Import Coord
Accountable (A): Tax Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W239_Flow18</bpmn:incoming>
        <bpmn:outgoing>W239_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W239_End11" name="Complete">
        <bpmn:incoming>W239_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W239_Annotation12">
        <bpmn:text>Controls: - CTL-492 (ensure controlled execution — Trade Compliance Audit, Broker Governance &amp; ADC (PA-87.3).) | - operational: periodic reconciliation against source documents
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W239_Assoc13" sourceRef="W239_Annotation12" targetRef="W239_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W239_Flow14" sourceRef="W239_Start5" targetRef="W239_Task6" />
      <bpmn:sequenceFlow id="W239_Flow15" sourceRef="W239_Task6" targetRef="W239_Task7" />
      <bpmn:sequenceFlow id="W239_Flow16" sourceRef="W239_Task7" targetRef="W239_Task8" />
      <bpmn:sequenceFlow id="W239_Flow17" sourceRef="W239_Task8" targetRef="W239_Task9" />
      <bpmn:sequenceFlow id="W239_Flow18" sourceRef="W239_Task9" targetRef="W239_Task10" />
      <bpmn:sequenceFlow id="W239_Flow19" sourceRef="W239_Task10" targetRef="W239_End11" />
    </bpmn:process>
