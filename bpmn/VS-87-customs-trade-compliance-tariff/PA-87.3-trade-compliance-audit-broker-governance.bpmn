        <bpmndi:BPMNEdge id="W2961_Flow13_di" bpmnElement="W2961_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2961_Flow14_di" bpmnElement="W2961_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2961_Assoc10_di" bpmnElement="W2961_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2962" name="W2962. BOC Post-Entry Audit (PEA) Readiness &amp; Response" isExecutable="false">
      <bpmn:documentation>Trigger: BOC Notice of Audit (NOA) or readiness review
Frequency: Event-driven + annual readiness
Volume: Multi-year audit scope
Owner: Trade Compliance Manager
Participants: Trade Compliance, Finance, Legal, External Advisor
Source: workflow W2962 — BOC Post-Entry Audit (PEA) Readiness &amp; Response</bpmn:documentation>
      <bpmn:laneSet id="W2962_LaneSet3">
        <bpmn:lane id="W2962_Lane1" name="Trade Compliance">
        <bpmn:flowNodeRef>W2962_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2962_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2962_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2962_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2962_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2962_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2962_Start4" name="BOC Notice of Audit (NOA) or readiness review">
        <bpmn:outgoing>W2962_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2962_Task5" name="Trade Compliance maintains audit-ready repository: import entries…">
        <bpmn:documentation>Step 1: Trade Compliance maintains audit-ready repository: import entries, classifications, valuations, COs, payments for the 3-year post-entry-audit look-back (records retained 5 years per CMTA)
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2962_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2962_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2962_Task6" name="Trade Compliance/Legal responds to BOC NOA; provides documents; negotiates…">
        <bpmn:documentation>Step 2: Trade Compliance/Legal responds to BOC NOA; provides documents; negotiates findings; files protest where warranted
Responsible (R): Trade Compliance / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W2962_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2962_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2962_Task7" name="Finance settles any assessed deficiency + surcharge/interest; books liability…">
        <bpmn:documentation>Step 3: Finance settles any assessed deficiency + surcharge/interest; books liability; updates controls
Responsible (R): Finance
Accountable (A): CFO
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W2962_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2962_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2962_End8" name="Complete">
        <bpmn:incoming>W2962_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2962_Annotation9">
        <bpmn:text>Controls: - CTL-492 (ensure controlled execution — Trade Compliance Audit, Broker Governance &amp; ADC (PA-87.3).) | - operational: audit readiness and proactive remediation
Owner: Trade Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2962_Assoc10" sourceRef="W2962_Annotation9" targetRef="W2962_Start4" associationDirection="None" />
