    <bpmn:process id="W_W2952" name="W2952. Classification Audit, Discrepancy &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit or discrepancy detection
Frequency: Annual + event-driven
Volume: Sample of imported SKUs
Owner: Internal Audit
Participants: Internal Audit, Trade Compliance, External Advisor
Source: workflow W2952 — Classification Audit, Discrepancy &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W2952_LaneSet4">
        <bpmn:lane id="W2952_Lane1" name="Internal Audit">
        <bpmn:flowNodeRef>W2952_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2952_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2952_Lane2" name="Trade Compliance">
        <bpmn:flowNodeRef>W2952_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2952_Lane3" name="External Advisor">
        <bpmn:flowNodeRef>W2952_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2952_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2952_Start5" name="Annual audit or discrepancy detection">
        <bpmn:outgoing>W2952_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2952_Task6" name="Internal Audit samples imported SKUs; reviews classification rationale vs. GRI…">
        <bpmn:documentation>Step 1: Internal Audit samples imported SKUs; reviews classification rationale vs. GRI and BOC practice
Responsible (R): Internal Audit
Accountable (A): Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2952_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2952_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2952_Task7" name="Trade Compliance remediates mis-classifications; files voluntary disclosure…">
        <bpmn:documentation>Step 2: Trade Compliance remediates mis-classifications; files voluntary disclosure with BOC where underpaid (mitigates penalty)
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W2952_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2952_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2952_Task8" name="External Advisor validates classification of high-value/complex SKUs; provides…">
        <bpmn:documentation>Step 3: External Advisor validates classification of high-value/complex SKUs; provides opinion for audit defense
Responsible (R): External Advisor
Accountable (A): Trade Compliance Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2952_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2952_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2952_End9" name="Complete">
        <bpmn:incoming>W2952_Flow15</bpmn:incoming>
      </bpmn:endEvent>
