    <bpmn:process id="W_W2946" name="W2946. Tariff Commission Advance Ruling on Tariff Classification Application" isExecutable="false">
      <bpmn:documentation>Trigger: Ambiguous or high-value classification
Frequency: Event-driven
Volume: ~5–20 applications/year
Owner: Trade Compliance Manager
Participants: Trade Compliance Mgr, Legal, BOC
Source: workflow W2946 — Tariff Commission Advance Ruling on Tariff Classification Application</bpmn:documentation>
      <bpmn:laneSet id="W2946_LaneSet4">
        <bpmn:lane id="W2946_Lane1" name="Trade Compliance Specialist">
        <bpmn:flowNodeRef>W2946_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2946_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2946_Lane2" name="Trade Compliance Manager">
        <bpmn:flowNodeRef>W2946_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2946_Lane3" name="Master Data">
        <bpmn:flowNodeRef>W2946_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2946_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2946_Start5" name="Ambiguous or high-value classification">
        <bpmn:outgoing>W2946_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2946_Task6" name="Trade Compliance prepares the Application for Advance Ruling on Tariff…">
        <bpmn:documentation>Step 1: Trade Compliance prepares the Application for Advance Ruling on Tariff Classification (TC Form 1, per TCC 001-17/CMTA Sec. 1100): product spec, sample, proposed classification, rationale
Responsible (R): Trade Compliance Specialist
Accountable (A): Trade Compliance Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W2946_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2946_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2946_Task7" name="Trade Compliance Officer submits to BOC; responds to queries; tracks ruling…">
        <bpmn:documentation>Step 2: Trade Compliance Officer submits to BOC; responds to queries; tracks ruling issuance
Responsible (R): Trade Compliance Manager
Accountable (A): VP Legal &amp; Compliance
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W2946_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2946_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2946_Task8" name="Master Data updates HS code per ruling once issued; applies prospectively…">
        <bpmn:documentation>Step 3: Master Data updates HS code per ruling once issued; applies prospectively; archives ruling for audit defense
Responsible (R): Master Data
Accountable (A): Trade Compliance Manager
Duration: Per ruling</bpmn:documentation>
        <bpmn:incoming>W2946_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2946_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2946_End9" name="Complete">
        <bpmn:incoming>W2946_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2946_Annotation10">
        <bpmn:text>Controls: - CTL-238 (ensure customs classification &amp; valuation compliance.) | - operational: CRA for high-value items
Owner: Trade Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2946_Assoc11" sourceRef="W2946_Annotation10" targetRef="W2946_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2946_Flow12" sourceRef="W2946_Start5" targetRef="W2946_Task6" />
      <bpmn:sequenceFlow id="W2946_Flow13" sourceRef="W2946_Task6" targetRef="W2946_Task7" />
      <bpmn:sequenceFlow id="W2946_Flow14" sourceRef="W2946_Task7" targetRef="W2946_Task8" />
      <bpmn:sequenceFlow id="W2946_Flow15" sourceRef="W2946_Task8" targetRef="W2946_End9" />
    </bpmn:process>
