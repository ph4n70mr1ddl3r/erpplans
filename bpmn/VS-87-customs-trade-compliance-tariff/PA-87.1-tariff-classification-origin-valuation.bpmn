    <bpmn:process id="W_W2945" name="W2945. HS Tariff Classification &amp; AHTN Code Assignment per Imported SKU" isExecutable="false">
      <bpmn:documentation>Trigger: New imported SKU or classification review
Frequency: Event-driven + periodic review
Volume: ~40% of 35,000 SKUs imported; ~14,000 SKUs
Owner: Trade Compliance Specialist
Participants: Trade Compliance, Procurement, Master Data
Source: workflow W2945 — HS Tariff Classification &amp; AHTN Code Assignment per Imported SKU</bpmn:documentation>
      <bpmn:laneSet id="W2945_LaneSet4">
        <bpmn:lane id="W2945_Lane1" name="Trade Compliance Specialist">
        <bpmn:flowNodeRef>W2945_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2945_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2945_Lane2" name="Master Data">
        <bpmn:flowNodeRef>W2945_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2945_Lane3" name="Trade Compliance">
        <bpmn:flowNodeRef>W2945_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2945_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2945_Start5" name="New imported SKU or classification review">
        <bpmn:outgoing>W2945_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2945_Task6" name="Trade Compliance assigns AHTN/HS code per SKU based on material, function…">
        <bpmn:documentation>Step 1: Trade Compliance assigns AHTN/HS code per SKU based on material, function, composition (General Rules of Interpretation); documents rationale
Responsible (R): Trade Compliance Specialist
Accountable (A): Trade Compliance Manager
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W2945_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2945_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2945_Task7" name="Master Data configures HS code and duty rate in item master; links to origin…">
        <bpmn:documentation>Step 2: Master Data configures HS code and duty rate in item master; links to origin and FTA preference eligibility
Responsible (R): Master Data
Accountable (A): Trade Compliance Specialist
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W2945_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2945_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2945_Task8" name="Trade Compliance validates classification on sample basis; corrects…">
        <bpmn:documentation>Step 3: Trade Compliance validates classification on sample basis; corrects mis-classification that over/under-pays duty
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W2945_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2945_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2945_End9" name="Complete">
        <bpmn:incoming>W2945_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2945_Annotation10">
        <bpmn:text>Controls: - CTL-238 (ensure customs classification &amp; valuation compliance.) | - operational: GRI-based classification and validation
Owner: Trade Compliance Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2945_Assoc11" sourceRef="W2945_Annotation10" targetRef="W2945_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2945_Flow12" sourceRef="W2945_Start5" targetRef="W2945_Task6" />
      <bpmn:sequenceFlow id="W2945_Flow13" sourceRef="W2945_Task6" targetRef="W2945_Task7" />
      <bpmn:sequenceFlow id="W2945_Flow14" sourceRef="W2945_Task7" targetRef="W2945_Task8" />
      <bpmn:sequenceFlow id="W2945_Flow15" sourceRef="W2945_Task8" targetRef="W2945_End9" />
    </bpmn:process>
