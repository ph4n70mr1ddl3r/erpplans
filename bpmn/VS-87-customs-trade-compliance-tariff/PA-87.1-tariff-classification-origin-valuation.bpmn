    <bpmn:process id="W_W2948" name="W2948. Assists, Royalties &amp; Additions to Customs Value Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Import with assists, royalties, or selling commissions
Frequency: Event-driven
Volume: Subset of imports (private label, licensed brands)
Owner: Trade Compliance Specialist
Participants: Trade Compliance, Procurement, Finance
Source: workflow W2948 — Assists, Royalties &amp; Additions to Customs Value Capture</bpmn:documentation>
      <bpmn:laneSet id="W2948_LaneSet4">
        <bpmn:lane id="W2948_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2948_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2948_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2948_Lane2" name="Trade Compliance">
        <bpmn:flowNodeRef>W2948_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2948_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2948_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2948_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2948_Start5" name="Import with assists, royalties, or selling commissions">
        <bpmn:outgoing>W2948_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2948_Task6" name="Procurement identifies dutiable additions: assists (tools/molds provided free)…">
        <bpmn:documentation>Step 1: Procurement identifies dutiable additions: assists (tools/molds provided free), royalties, license fees, selling commissions
Responsible (R): Procurement
Accountable (A): Trade Compliance Manager
Duration: Per import</bpmn:documentation>
        <bpmn:incoming>W2948_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2948_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2948_Task7" name="Trade Compliance computes additions to customs value; includes in import entry…">
        <bpmn:documentation>Step 2: Trade Compliance computes additions to customs value; includes in import entry; captures supporting documentation
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Per import</bpmn:documentation>
        <bpmn:incoming>W2948_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2948_Flow14</bpmn:outgoing>
      </bpmn:userTask>
