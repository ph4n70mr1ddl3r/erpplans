    <bpmn:process id="W_W2947" name="W2947. Customs Valuation (Transaction Value) &amp; Adjustments Management" isExecutable="false">
      <bpmn:documentation>Trigger: Each import entry
Frequency: Continuous
Volume: ~400–600 TEUs/month
Owner: Trade Compliance Specialist
Participants: Trade Compliance Manager, Treasury, Trade Compliance
Source: workflow W2947 — Customs Valuation (Transaction Value) &amp; Adjustments Management</bpmn:documentation>
      <bpmn:laneSet id="W2947_LaneSet4">
        <bpmn:lane id="W2947_Lane1" name="Trade Compliance Specialist">
        <bpmn:flowNodeRef>W2947_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2947_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2947_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W2947_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2947_Lane3" name="Trade Compliance">
        <bpmn:flowNodeRef>W2947_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2947_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2947_Start5" name="Each import entry">
        <bpmn:outgoing>W2947_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2947_Task6" name="Trade Compliance computes transaction value per WTO Valuation Agreement…">
        <bpmn:documentation>Step 1: Trade Compliance computes transaction value per WTO Valuation Agreement: invoice price + freight + insurance (CIF) + dutiable additions
Responsible (R): Trade Compliance Specialist
Accountable (A): Trade Compliance Manager
Duration: Per entry</bpmn:documentation>
        <bpmn:incoming>W2947_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2947_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2947_Task7" name="Treasury captures currency conversion at BOC-prescribed rate on date of filing…">
        <bpmn:documentation>Step 2: Treasury captures currency conversion at BOC-prescribed rate on date of filing; validates exchange rate application
Responsible (R): Treasury
Accountable (A): Trade Compliance Manager
Duration: Per entry</bpmn:documentation>
        <bpmn:incoming>W2947_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2947_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2947_Task8" name="Trade Compliance validates valuation method; documents alternative valuation if…">
        <bpmn:documentation>Step 3: Trade Compliance validates valuation method; documents alternative valuation if transaction value inapplicable
Responsible (R): Trade Compliance
Accountable (A): Trade Compliance Manager
Duration: Per entry</bpmn:documentation>
        <bpmn:incoming>W2947_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2947_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2947_End9" name="Complete">
        <bpmn:incoming>W2947_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2947_Annotation10">
        <bpmn:text>Controls: - CTL-238 (ensure customs classification &amp; valuation compliance.) | - operational: transaction-value method and documentation
Owner: Trade Compliance Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2947_Assoc11" sourceRef="W2947_Annotation10" targetRef="W2947_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2947_Flow12" sourceRef="W2947_Start5" targetRef="W2947_Task6" />
      <bpmn:sequenceFlow id="W2947_Flow13" sourceRef="W2947_Task6" targetRef="W2947_Task7" />
      <bpmn:sequenceFlow id="W2947_Flow14" sourceRef="W2947_Task7" targetRef="W2947_Task8" />
      <bpmn:sequenceFlow id="W2947_Flow15" sourceRef="W2947_Task8" targetRef="W2947_End9" />
    </bpmn:process>
