        <bpmn:outgoing>W2956_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2956_Task6" name="DC Operations maintains CBW inventory ledger; reconciles to BOC entries weekly…">
