    <bpmn:process id="W_W1927" name="W1927. Consignment Stock Display &amp; Shelf Management" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing store operations; weekly display review
Frequency: Weekly per store
Volume: ~8–15 consignment SKUs on display per store (major appliances + select tiles)
Owner: Department Supervisor
Participants: Department Supervisor, Sales Associate, Visual Merchandiser
Source: workflow W1927 — Consignment Stock Display &amp; Shelf Management</bpmn:documentation>
      <bpmn:laneSet id="W1927_LaneSet3">
        <bpmn:lane id="W1927_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W1927_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1927_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1927_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1927_Lane2" name="Sales Associate">
        <bpmn:flowNodeRef>W1927_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1927_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1927_Start4" name="Ongoing store operations; weekly display review">
        <bpmn:outgoing>W1927_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1927_Task5" name="Department Supervisor ensures consignment items are displayed per vendor…">
        <bpmn:documentation>Step 1: Department Supervisor ensures consignment items are displayed per vendor planogram: (a) appliance section: display units powered on where applicable (fans, aircons), price tags with SRP, (b) tile gallery: sample boards with pricing, specification cards, (c) consignment items displayed alongside owned inventory without differentiation visible to customer
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1927_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1927_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1927_Task6" name="Sales Associate trained on consignment product knowledge: (a) know which items…">
        <bpmn:documentation>Step 2: Sales Associate trained on consignment product knowledge: (a) know which items are consignment (internal knowledge only), (b) selling approach identical to owned inventory (no disclosure of consignment arrangement to customer), (c) warranty and return policies per BuildRight standard (BuildRight is point of contact, not vendor)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1927_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1927_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1927_Task7" name="Weekly: Department Supervisor reviews display condition: (a) display units…">
        <bpmn:documentation>Step 3: Weekly: Department Supervisor reviews display condition: (a) display units clean and functional, (b) price tags accurate and current, (c) demo/display units tracked separately per W97 (sample/demo inventory), (d) missing or damaged display items reported for vendor replacement
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1927_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1927_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1927_End8" name="Complete">
        <bpmn:incoming>W1927_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1927_Annotation9">
        <bpmn:text>Controls: - CTL-376 (ensure controlled execution — Consignment Inventory Operations (PA-45.1).) | - operational: Department Supervisor review and approval gate
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1927_Assoc10" sourceRef="W1927_Annotation9" targetRef="W1927_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1927_Flow11" sourceRef="W1927_Start4" targetRef="W1927_Task5" />
      <bpmn:sequenceFlow id="W1927_Flow12" sourceRef="W1927_Task5" targetRef="W1927_Task6" />
      <bpmn:sequenceFlow id="W1927_Flow13" sourceRef="W1927_Task6" targetRef="W1927_Task7" />
      <bpmn:sequenceFlow id="W1927_Flow14" sourceRef="W1927_Task7" targetRef="W1927_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1927_diag">
      <bpmndi:BPMNPlane id="W1927_plane" bpmnElement="W_W1927">
        <bpmndi:BPMNShape id="W1927_Lane1_di" bpmnElement="W1927_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1927_Lane2_di" bpmnElement="W1927_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
