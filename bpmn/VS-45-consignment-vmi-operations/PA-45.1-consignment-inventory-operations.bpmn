      <bpmn:sequenceFlow id="W1932_Flow12" sourceRef="W1932_Task5" targetRef="W1932_Task6" />
      <bpmn:sequenceFlow id="W1932_Flow13" sourceRef="W1932_Task6" targetRef="W1932_End7" />
    </bpmn:process>
