    <bpmn:process id="W_W1931" name="W1931. Consignment Return-to-Vendor Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Slow-moving consignment stock; vendor request; consignment agreement termination
Frequency: ~50–100 consignment returns/year
Volume: ~200–500 units/year
Owner: Category Manager
Participants: Category Manager, Receiving Clerk, AP Clerk, Vendor
Source: workflow W1931 — Consignment Return-to-Vendor Processing</bpmn:documentation>
      <bpmn:laneSet id="W1931_LaneSet4">
        <bpmn:lane id="W1931_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1931_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1931_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1931_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1931_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1931_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1931_Lane3" name="System">
        <bpmn:flowNodeRef>W1931_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1931_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1931_Start5" name="Slow-moving consignment stock; vendor request; consignment agreement termination">
        <bpmn:outgoing>W1931_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1931_Task6" name="Category Manager initiates consignment return: (a) reason: slow-moving (&gt; 90…">
        <bpmn:documentation>Step 1: Category Manager initiates consignment return: (a) reason: slow-moving (&gt; 90 days, no sales), model discontinued, vendor request, agreement termination, (b) create return request with SKU, qty, condition, reason, (c) notify vendor for pickup scheduling
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 15–30 min/return</bpmn:documentation>
        <bpmn:incoming>W1931_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1931_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1931_Task7" name="Receiving Clerk processes consignment return: (a) verify item condition…">
        <bpmn:documentation>Step 2: Receiving Clerk processes consignment return: (a) verify item condition (undamaged, complete with accessories, original packaging preferred), (b) scan items for system return posting, (c) system reduces consignment stock (no financial impact — vendor-owned), (d) stage items for vendor pickup
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 10–20 min/return</bpmn:documentation>
        <bpmn:incoming>W1931_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1931_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1931_Task8" name="Vendor picks up returned consignment goods: (a) vendor representative signs…">
        <bpmn:documentation>Step 3: Vendor picks up returned consignment goods: (a) vendor representative signs return acknowledgment, (b) Receiving Clerk records pickup with vendor signature, (c) system records return completion with timestamp
Responsible (R): Receiving Clerk / Vendor
Accountable (A): Department Supervisor
Duration: 15–30 min/pickup</bpmn:documentation>
        <bpmn:incoming>W1931_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1931_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1931_Task9" name="System reconciles consignment return: (a) vendor consignment balance reduced…">
        <bpmn:documentation>Step 4: System reconciles consignment return: (a) vendor consignment balance reduced, (b) no AP/AR impact (goods were vendor-owned), (c) return logged in vendor scorecard for performance tracking
Responsible (R): System
Accountable (A): AP Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1931_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1931_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1931_End10" name="Complete">
        <bpmn:incoming>W1931_Flow17</bpmn:incoming>
      </bpmn:endEvent>
