      <bpmn:sequenceFlow id="W1933_Flow13" sourceRef="W1933_Start5" targetRef="W1933_Task6" />
      <bpmn:sequenceFlow id="W1933_Flow14" sourceRef="W1933_Task6" targetRef="W1933_Task7" />
      <bpmn:sequenceFlow id="W1933_Flow15" sourceRef="W1933_Task7" targetRef="W1933_Task8" />
      <bpmn:sequenceFlow id="W1933_Flow16" sourceRef="W1933_Task8" targetRef="W1933_Task9" />
      <bpmn:sequenceFlow id="W1933_Flow17" sourceRef="W1933_Task9" targetRef="W1933_End10" />
    </bpmn:process>
