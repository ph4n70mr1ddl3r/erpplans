        <bpmndi:BPMNShape id="W1927_Task6_di" bpmnElement="W1927_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1927_Task7_di" bpmnElement="W1927_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1927_Start4_di" bpmnElement="W1927_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1927_End8_di" bpmnElement="W1927_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1927_Annotation9_di" bpmnElement="W1927_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1927_Flow11_di" bpmnElement="W1927_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1927_Flow12_di" bpmnElement="W1927_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1927_Flow13_di" bpmnElement="W1927_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1927_Flow14_di" bpmnElement="W1927_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1927_Assoc10_di" bpmnElement="W1927_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1928" name="W1928. Consignment Sell-Through at POS &amp; Ownership Transfer" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases consignment item at POS
Frequency: ~8,000–12,000 consignment sales/month chain-wide
Volume: ~5–6% of active SKUs are consignment; represents ~3–4% of revenue
Owner: Cashier
Participants: Cashier, Store Manager, System
Source: workflow W1928 — Consignment Sell-Through at POS &amp; Ownership Transfer</bpmn:documentation>
      <bpmn:laneSet id="W1928_LaneSet3">
        <bpmn:lane id="W1928_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W1928_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1928_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1928_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1928_Lane2" name="System">
        <bpmn:flowNodeRef>W1928_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1928_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1928_Start4" name="Customer purchases consignment item at POS">
        <bpmn:outgoing>W1928_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1928_Task5" name="Cashier scans consignment item at POS: (a) system identifies item as…">
        <bpmn:documentation>Step 1: Cashier scans consignment item at POS: (a) system identifies item as consignment via item master flag, (b) standard selling price applied (customer sees no difference), (c) standard POS receipt generated (no consignment indicator on customer receipt), (d) standard tender processing (cash, card, e-wallet, trade account)
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: &lt; 3 sec/scan</bpmn:documentation>
        <bpmn:incoming>W1928_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1928_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1928_Task6" name="System executes ownership transfer at transaction completion: (a) consignment…">
        <bpmn:documentation>Step 2: System executes ownership transfer at transaction completion: (a) consignment stock reduced by 1 unit (vendor-owned → sold), (b) COGS posted at consignment cost (vendor settlement price, not BuildRight cost), (c) revenue posted at selling price, (d) gross margin = selling price − consignment cost (typically 15–25% for appliances, 20–30% for tiles), (e) sell-through record created: transaction ID, vendor, SKU, qty, consignment cost, selling price, timestamp
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1928_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1928_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1928_Task7" name="For major appliances: (a) if customer needs delivery, create delivery order per…">
        <bpmn:documentation>Step 3: For major appliances: (a) if customer needs delivery, create delivery order per W5D, (b) if display unit sold, trigger replacement order from vendor consignment stock or vendor direct shipment, (c) appliance serial number captured at POS for warranty registration per W33
Responsible (R): Cashier / System
Accountable (A): Store Manager
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W1928_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1928_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1928_End8" name="Complete">
        <bpmn:incoming>W1928_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1928_Annotation9">
        <bpmn:text>Controls: - CTL-376 (ensure controlled execution — Consignment Inventory Operations (PA-45.1).) | - operational: should use same barcode scan path as standard items
Owner: Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1928_Assoc10" sourceRef="W1928_Annotation9" targetRef="W1928_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1928_Flow11" sourceRef="W1928_Start4" targetRef="W1928_Task5" />
      <bpmn:sequenceFlow id="W1928_Flow12" sourceRef="W1928_Task5" targetRef="W1928_Task6" />
      <bpmn:sequenceFlow id="W1928_Flow13" sourceRef="W1928_Task6" targetRef="W1928_Task7" />
      <bpmn:sequenceFlow id="W1928_Flow14" sourceRef="W1928_Task7" targetRef="W1928_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1928_diag">
      <bpmndi:BPMNPlane id="W1928_plane" bpmnElement="W_W1928">
        <bpmndi:BPMNShape id="W1928_Lane1_di" bpmnElement="W1928_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Lane2_di" bpmnElement="W1928_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Task5_di" bpmnElement="W1928_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Task6_di" bpmnElement="W1928_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Task7_di" bpmnElement="W1928_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Start4_di" bpmnElement="W1928_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_End8_di" bpmnElement="W1928_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1928_Annotation9_di" bpmnElement="W1928_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1928_Flow11_di" bpmnElement="W1928_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1928_Flow12_di" bpmnElement="W1928_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1928_Flow13_di" bpmnElement="W1928_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1928_Flow14_di" bpmnElement="W1928_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1928_Assoc10_di" bpmnElement="W1928_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1929" name="W1929. Consignment Stock Rotation &amp; Aging Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly consignment aging review
Frequency: Monthly
Volume: ~1,500–2,000 consignment SKUs monitored
Owner: Category Manager
Participants: Category Manager, Department Supervisor, Vendor
Source: workflow W1929 — Consignment Stock Rotation &amp; Aging Management</bpmn:documentation>
      <bpmn:laneSet id="W1929_LaneSet3">
        <bpmn:lane id="W1929_Lane1" name="System">
        <bpmn:flowNodeRef>W1929_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1929_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1929_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1929_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1929_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1929_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1929_Start4" name="Monthly consignment aging review">
        <bpmn:outgoing>W1929_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1929_Task5" name="System generates monthly consignment aging report: (a) days-on-hand by SKU by…">
        <bpmn:documentation>Step 1: System generates monthly consignment aging report: (a) days-on-hand by SKU by location, (b) sell-through rate: units sold / units available per month, (c) aging categories: &lt; 30 days (fast), 30–60 days (moderate), 60–90 days (slow), &gt; 90 days (dead stock), (d) compare consignment sell-through vs. owned inventory sell-through for same categories
Responsible (R): System
Accountable (A): Category Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1929_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1929_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1929_Task6" name="Category Manager reviews aging consignment stock: (a) identify slow-moving…">
        <bpmn:documentation>Step 2: Category Manager reviews aging consignment stock: (a) identify slow-moving consignment SKUs (&gt; 60 days, &lt; 1 unit/month sell-through), (b) contact vendor to discuss: (i) price reduction to stimulate sales, (ii) markdown support from vendor, (iii) stock rotation: return slow movers to vendor, replace with faster-selling models, (c) evaluate whether consignment arrangement is worthwhile for low-sell-through items
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1929_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1929_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1929_Task7" name="For consignment stock &gt; 90 days with no sales: (a) initiate return-to-vendor…">
        <bpmn:documentation>Step 3: For consignment stock &gt; 90 days with no sales: (a) initiate return-to-vendor per W1931, or (b) negotiate markdown with vendor cost-sharing, or (c) convert to owned stock at discounted price if vendor offers deep discount
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1929_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1929_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1929_End8" name="Complete">
        <bpmn:incoming>W1929_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1929_Annotation9">
        <bpmn:text>Controls: - CTL-376 (ensure controlled execution — Consignment Inventory Operations (PA-45.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
