<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-45.1-consignment-inventory-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1926" name="W1926. Consignment Goods Receipt &amp; Non-Valuated Inventory Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor delivers consignment goods to DC or store
Frequency: ~200–300 consignment receipts/month
Volume: ~1,500–2,000 consignment SKUs (major appliances, select tiles)
Owner: Receiving Clerk
Participants: Receiving Clerk, Department Supervisor, AP Clerk, Vendor
Source: workflow W1926 — Consignment Goods Receipt &amp; Non-Valuated Inventory Posting</bpmn:documentation>
      <bpmn:laneSet id="W1926_LaneSet4">
        <bpmn:lane id="W1926_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1926_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1926_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1926_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1926_Lane2" name="System">
        <bpmn:flowNodeRef>W1926_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1926_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W1926_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1926_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1926_Start5" name="Vendor delivers consignment goods to DC or store">
        <bpmn:outgoing>W1926_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1926_Task6" name="Receiving Clerk receives consignment delivery: (a) verify delivery against…">
        <bpmn:documentation>Step 1: Receiving Clerk receives consignment delivery: (a) verify delivery against consignment shipment advice (CSA) from vendor, (b) check item condition — consignment goods often high-value (appliances: PHP 5K–80K per unit; tiles: PHP 200–2,000 per box), (c) scan barcode or manually enter SKU, (d) system posts to non-valuated consignment stock (no WAC impact, no GR/IR, no AP liability until sale)
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15–30 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1926_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1926_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1926_Task7" name="System records: (a) consignment stock quantity by vendor by SKU by location…">
        <bpmn:documentation>Step 2: System records: (a) consignment stock quantity by vendor by SKU by location, (b) vendor ownership indicator on inventory record, (c) consignment agreement reference (pricing, settlement terms), (d) no financial posting (no inventory value, no AP) — vendor retains ownership
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1926_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1926_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1926_Task8" name="Receiving Clerk stages consignment goods in designated area: (a) major…">
        <bpmn:documentation>Step 3: Receiving Clerk stages consignment goods in designated area: (a) major appliances: appliance section display or backroom staging, (b) tiles: tile gallery display area, (c) attach consignment tag (vendor-owned indicator visible to staff but not customers)
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 15–30 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1926_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1926_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1926_Task9" name="Department Supervisor verifies receipt accuracy: (a) spot-check quantities…">
        <bpmn:documentation>Step 4: Department Supervisor verifies receipt accuracy: (a) spot-check quantities against CSA, (b) verify item condition (no damage during transit), (c) confirm non-valuated posting in system
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1926_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1926_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1926_End10" name="Complete">
        <bpmn:incoming>W1926_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1926_Annotation11">
        <bpmn:text>Controls: - CTL-174 (ensure consignment &amp; VMI settlement integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1926_Assoc12" sourceRef="W1926_Annotation11" targetRef="W1926_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1926_Flow13" sourceRef="W1926_Start5" targetRef="W1926_Task6" />
      <bpmn:sequenceFlow id="W1926_Flow14" sourceRef="W1926_Task6" targetRef="W1926_Task7" />
      <bpmn:sequenceFlow id="W1926_Flow15" sourceRef="W1926_Task7" targetRef="W1926_Task8" />
      <bpmn:sequenceFlow id="W1926_Flow16" sourceRef="W1926_Task8" targetRef="W1926_Task9" />
      <bpmn:sequenceFlow id="W1926_Flow17" sourceRef="W1926_Task9" targetRef="W1926_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1926_diag">
      <bpmndi:BPMNPlane id="W1926_plane" bpmnElement="W_W1926">
        <bpmndi:BPMNShape id="W1926_Lane1_di" bpmnElement="W1926_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
