      <bpmn:sequenceFlow id="W1944_Flow12" sourceRef="W1944_Task5" targetRef="W1944_Task6" />
      <bpmn:sequenceFlow id="W1944_Flow13" sourceRef="W1944_Task6" targetRef="W1944_Task7" />
      <bpmn:sequenceFlow id="W1944_Flow14" sourceRef="W1944_Task7" targetRef="W1944_End8" />
    </bpmn:process>
