        <bpmndi:BPMNShape id="W1943_Task6_di" bpmnElement="W1943_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1943_Task7_di" bpmnElement="W1943_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1943_Start4_di" bpmnElement="W1943_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1943_End8_di" bpmnElement="W1943_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1943_Annotation9_di" bpmnElement="W1943_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1943_Flow11_di" bpmnElement="W1943_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1943_Flow12_di" bpmnElement="W1943_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1943_Flow13_di" bpmnElement="W1943_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1943_Flow14_di" bpmnElement="W1943_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1943_Assoc10_di" bpmnElement="W1943_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1944" name="W1944. VMI Inventory Carrying Cost &amp; Optimization Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual VMI program optimization review
Frequency: Semi-annual
Volume: 12 VMI vendors; ~300 VMI SKUs
Owner: VP Supply Chain
Participants: VP Supply Chain, Category Manager, Finance Manager
Source: workflow W1944 — VMI Inventory Carrying Cost &amp; Optimization Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1944_LaneSet3">
        <bpmn:lane id="W1944_Lane1" name="Finance Manager">
        <bpmn:flowNodeRef>W1944_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1944_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1944_Lane2" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1944_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1944_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1944_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1944_Start4" name="Semi-annual VMI program optimization review">
        <bpmn:outgoing>W1944_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1944_Task5" name="Finance Manager calculates VMI inventory carrying cost: (a) average VMI…">
        <bpmn:documentation>Step 1: Finance Manager calculates VMI inventory carrying cost: (a) average VMI inventory value (at WAC) per month, (b) carrying cost rate: warehousing + insurance + obsolescence risk + cost of capital (~20–25% of average inventory value per year for Philippine retail), (c) compare VMI carrying cost to non-VMI carrying cost for similar SKUs
Responsible (R): Finance Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1944_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1944_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1944_Task6" name="VP Supply Chain evaluates VMI optimization: (a) inventory turns: VMI SKUs vs…">
        <bpmn:documentation>Step 2: VP Supply Chain evaluates VMI optimization: (a) inventory turns: VMI SKUs vs. non-VMI SKUs in same category, (b) stockout cost: lost sales from VMI stockouts vs. non-VMI stockouts, (c) procurement labor savings: VMI auto-replenishment reduces Buyer workload by ~X hours/month, (d) overstock cost: excess VMI inventory carrying cost above max level
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1944_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1944_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1944_Task7" name="Recommendations: (a) VMI SKUs with high overstock: tighten max levels or remove…">
        <bpmn:documentation>Step 3: Recommendations: (a) VMI SKUs with high overstock: tighten max levels or remove from VMI, (b) VMI SKUs with frequent stockouts: increase min levels or add supplier, (c) high-performing VMI vendors: expand VMI scope to additional SKUs, (d) low-performing VMI vendors: consider converting to standard procurement per W1947
Responsible (R): VP Supply Chain
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1944_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1944_End8" name="Complete">
        <bpmn:incoming>W1944_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1944_Annotation9">
        <bpmn:text>Controls: - CTL-378 (ensure controlled execution — Consignment &amp; VMI Settlement &amp; Analytics (PA-45.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1944_Assoc10" sourceRef="W1944_Annotation9" targetRef="W1944_Start4" associationDirection="None" />
