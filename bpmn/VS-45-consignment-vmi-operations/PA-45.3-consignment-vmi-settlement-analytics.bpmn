      <bpmn:sequenceFlow id="W1949_Flow13" sourceRef="W1949_Task6" targetRef="W1949_Task7" />
      <bpmn:sequenceFlow id="W1949_Flow14" sourceRef="W1949_Task7" targetRef="W1949_Task8" />
      <bpmn:sequenceFlow id="W1949_Flow15" sourceRef="W1949_Task8" targetRef="W1949_End9" />
    </bpmn:process>
