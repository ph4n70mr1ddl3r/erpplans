<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-45.3-consignment-vmi-settlement-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1942" name="W1942. Consignment Sell-Through Settlement &amp; Vendor Payment" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly settlement cycle per consignment agreement
Frequency: Monthly
Volume: ~15–25 consignment vendors settled monthly
Owner: AP Manager
Participants: AP Manager, Category Manager, Vendor
Source: workflow W1942 — Consignment Sell-Through Settlement &amp; Vendor Payment</bpmn:documentation>
      <bpmn:laneSet id="W1942_LaneSet3">
        <bpmn:lane id="W1942_Lane1" name="System">
        <bpmn:flowNodeRef>W1942_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1942_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1942_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1942_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1942_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1942_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1942_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1942_Start4" name="Monthly settlement cycle per consignment agreement">
        <bpmn:outgoing>W1942_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1942_Task5" name="System generates monthly consignment sell-through report per vendor: (a) total…">
        <bpmn:documentation>Step 1: System generates monthly consignment sell-through report per vendor: (a) total units sold by SKU in settlement period, (b) consignment cost per unit per SKU, (c) total settlement amount: units sold × consignment cost, (d) deductions: (i) returns processed, (ii) damages charged to vendor per agreement, (iii) promotional discounts shared per agreement, (e) net settlement amount
Responsible (R): System
Accountable (A): AP Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1942_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1942_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1942_Task6" name="AP Manager reviews sell-through report: (a) verify unit counts against POS…">
        <bpmn:documentation>Step 2: AP Manager reviews sell-through report: (a) verify unit counts against POS transaction data, (b) verify consignment costs per agreement (any price changes applied correctly?), (c) verify deductions (returns, damages, promo contributions), (d) flag any discrepancies for Category Manager review
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1942_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1942_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1942_Task7" name="AP Manager submits settlement statement to vendor: (a) via vendor portal…">
        <bpmn:documentation>Step 3: AP Manager submits settlement statement to vendor: (a) via vendor portal (preferred), (b) settlement statement includes: sell-through detail, deductions, net amount, payment terms (typically Net 30 from settlement date), (c) vendor reviews and confirms within 10 business days
Responsible (R): AP Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1942_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1942_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1942_Task8" name="Payment processing: (a) vendor invoice (settlement statement) processed through…">
        <bpmn:documentation>Step 4: Payment processing: (a) vendor invoice (settlement statement) processed through AP, (b) standard payment run per W7.9, (c) payment to vendor bank account, (d) GL posting: debit consignment AP (liability created at ownership transfer), credit cash/bank
Responsible (R): AP Manager / System
Accountable (A): Accounting Manager
Duration: Per payment run</bpmn:documentation>
        <bpmn:incoming>W1942_Flow15</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1942_End9" name="Complete">
        <bpmn:incoming>W1942_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1942_Annotation10">
        <bpmn:text>Controls: - CTL-378 (ensure controlled execution — Consignment &amp; VMI Settlement &amp; Analytics (PA-45.3).) | - operational: AP Manager review and approval gate
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1942_Assoc11" sourceRef="W1942_Annotation10" targetRef="W1942_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1942_Flow12" sourceRef="W1942_Start4" targetRef="W1942_Task5" />
      <bpmn:sequenceFlow id="W1942_Flow13" sourceRef="W1942_Task5" targetRef="W1942_Task6" />
      <bpmn:sequenceFlow id="W1942_Flow14" sourceRef="W1942_Task6" targetRef="W1942_Task7" />
      <bpmn:sequenceFlow id="W1942_Flow15" sourceRef="W1942_Task7" targetRef="W1942_Task8" />
      <bpmn:sequenceFlow id="W1942_Flow16" sourceRef="W1942_Task8" targetRef="W1942_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1942_diag">
      <bpmndi:BPMNPlane id="W1942_plane" bpmnElement="W_W1942">
        <bpmndi:BPMNShape id="W1942_Lane1_di" bpmnElement="W1942_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1942_Lane2_di" bpmnElement="W1942_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1942_Task5_di" bpmnElement="W1942_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1942_Task6_di" bpmnElement="W1942_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1942_Task7_di" bpmnElement="W1942_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
