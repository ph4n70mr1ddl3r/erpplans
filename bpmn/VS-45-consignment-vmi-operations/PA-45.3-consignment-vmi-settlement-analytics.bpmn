      <bpmndi:BPMNPlane id="W1944_plane" bpmnElement="W_W1944">
        <bpmndi:BPMNShape id="W1944_Lane1_di" bpmnElement="W1944_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1944_Lane2_di" bpmnElement="W1944_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1944_Task5_di" bpmnElement="W1944_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
