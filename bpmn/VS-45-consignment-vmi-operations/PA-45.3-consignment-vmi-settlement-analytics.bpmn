    <bpmn:process id="W_W1948" name="W1948. Consignment &amp; VMI Intercompany Settlement (Multi-Entity)" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly IC settlement cycle
Frequency: Monthly
Volume: Cross-entity consignment/VMI transactions across 5 legal entities
Owner: AP Manager
Participants: AP Manager, Accounting Manager, IC Settlement Team
Source: workflow W1948 — Consignment &amp; VMI Intercompany Settlement (Multi-Entity)</bpmn:documentation>
      <bpmn:laneSet id="W1948_LaneSet4">
        <bpmn:lane id="W1948_Lane1" name="System">
        <bpmn:flowNodeRef>W1948_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1948_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1948_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1948_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1948_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1948_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1948_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1948_Start5" name="Monthly IC settlement cycle">
        <bpmn:outgoing>W1948_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1948_Task6" name="System identifies cross-entity consignment/VMI transactions: (a) consignment…">
        <bpmn:documentation>Step 1: System identifies cross-entity consignment/VMI transactions: (a) consignment goods received by BuildRight Logistics DC but sold by BuildRight Depot store, (b) VMI stock at BuildRight Logistics DC transferred to BuildRight Depot stores, (c) ownership transfer revenue and COGS must be allocated to correct entities
Responsible (R): System
Accountable (A): AP Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1948_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1948_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1948_Task7" name="AP Manager processes IC settlement for consignment/VMI: (a) consignment…">
        <bpmn:documentation>Step 2: AP Manager processes IC settlement for consignment/VMI: (a) consignment settlement: vendor payment from BuildRight Depot (selling entity), IC service fee from BuildRight Logistics (DC storage/service), (b) VMI settlement: standard PO payment from purchasing entity, IC transfer pricing for stock movements between entities, (c) post IC AP/AR per W14
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W1948_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1948_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1948_Task8" name="Monthly IC reconciliation: (a) verify consignment/VMI IC balances match across…">
        <bpmn:documentation>Step 3: Monthly IC reconciliation: (a) verify consignment/VMI IC balances match across entities, (b) resolve timing differences (sale in one entity, settlement in another), (c) elimination entries for consolidation per W9A
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: Per month-end close</bpmn:documentation>
        <bpmn:incoming>W1948_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1948_End9" name="Complete">
        <bpmn:incoming>W1948_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1948_Annotation10">
        <bpmn:text>Controls: - CTL-174 (ensure consignment &amp; VMI settlement integrity.) | - operational: periodic reconciliation against source documents
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1948_Assoc11" sourceRef="W1948_Annotation10" targetRef="W1948_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1948_Flow12" sourceRef="W1948_Start5" targetRef="W1948_Task6" />
      <bpmn:sequenceFlow id="W1948_Flow13" sourceRef="W1948_Task6" targetRef="W1948_Task7" />
      <bpmn:sequenceFlow id="W1948_Flow14" sourceRef="W1948_Task7" targetRef="W1948_Task8" />
      <bpmn:sequenceFlow id="W1948_Flow15" sourceRef="W1948_Task8" targetRef="W1948_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1948_diag">
      <bpmndi:BPMNPlane id="W1948_plane" bpmnElement="W_W1948">
        <bpmndi:BPMNShape id="W1948_Lane1_di" bpmnElement="W1948_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1948_Lane2_di" bpmnElement="W1948_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1948_Lane3_di" bpmnElement="W1948_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
