    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1943" name="W1943. Consignment Margin Analysis &amp; Vendor Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly consignment margin review
Frequency: Quarterly
Volume: ~15–25 consignment vendors
Owner: Category Manager
Participants: Category Manager, Pricing Analyst, VP Merchandising
Source: workflow W1943 — Consignment Margin Analysis &amp; Vendor Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W1943_LaneSet3">
        <bpmn:lane id="W1943_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1943_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1943_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1943_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1943_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1943_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1943_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1943_Start4" name="Quarterly consignment margin review">
        <bpmn:outgoing>W1943_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1943_Task5" name="Pricing Analyst generates quarterly consignment margin report: (a) gross margin…">
        <bpmn:documentation>Step 1: Pricing Analyst generates quarterly consignment margin report: (a) gross margin % by consignment vendor, (b) gross margin % by consignment category (appliances, tiles), (c) compare consignment margin to owned-inventory margin for same categories, (d) margin trend: improving or declining by vendor, (e) identify vendors where consignment margin &lt; owned-inventory margin by &gt; 5 percentage points
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1943_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1943_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1943_Task6" name="Category Manager reviews margin analysis: (a) low-margin consignment vendors…">
        <bpmn:documentation>Step 2: Category Manager reviews margin analysis: (a) low-margin consignment vendors: negotiate improved consignment costs, (b) evaluate alternatives: can BuildRight purchase directly at better margin?, (c) high-margin consignment: consider expanding consignment range with vendor, (d) assess total value of consignment arrangement: (margin × volume) vs. (capital saved from not owning inventory)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1943_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1943_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1943_Task7" name="Annual: Category Manager negotiates consignment cost adjustments with vendors…">
        <bpmn:documentation>Step 3: Annual: Category Manager negotiates consignment cost adjustments with vendors based on: (a) volume commitment (higher volume = lower consignment cost), (b) competitive benchmarking (what margin do other retailers get?), (c) total relationship value (vendor also supplies non-consignment goods)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Per annual negotiation</bpmn:documentation>
        <bpmn:incoming>W1943_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1943_End8" name="Complete">
        <bpmn:incoming>W1943_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1943_Annotation9">
        <bpmn:text>Controls: - CTL-378 (ensure controlled execution — Consignment &amp; VMI Settlement &amp; Analytics (PA-45.3).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1943_Assoc10" sourceRef="W1943_Annotation9" targetRef="W1943_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1943_Flow11" sourceRef="W1943_Start4" targetRef="W1943_Task5" />
      <bpmn:sequenceFlow id="W1943_Flow12" sourceRef="W1943_Task5" targetRef="W1943_Task6" />
      <bpmn:sequenceFlow id="W1943_Flow13" sourceRef="W1943_Task6" targetRef="W1943_Task7" />
      <bpmn:sequenceFlow id="W1943_Flow14" sourceRef="W1943_Task7" targetRef="W1943_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1943_diag">
      <bpmndi:BPMNPlane id="W1943_plane" bpmnElement="W_W1943">
        <bpmndi:BPMNShape id="W1943_Lane1_di" bpmnElement="W1943_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1943_Lane2_di" bpmnElement="W1943_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
