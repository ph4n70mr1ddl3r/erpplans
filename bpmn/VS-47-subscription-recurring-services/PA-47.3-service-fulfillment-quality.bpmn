      <bpmndi:BPMNPlane id="W1992_plane" bpmnElement="W_W1992">
        <bpmndi:BPMNShape id="W1992_Lane1_di" bpmnElement="W1992_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_Task4_di" bpmnElement="W1992_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_Task5_di" bpmnElement="W1992_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_Task6_di" bpmnElement="W1992_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_Start3_di" bpmnElement="W1992_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_End7_di" bpmnElement="W1992_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1992_Annotation8_di" bpmnElement="W1992_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1992_Flow10_di" bpmnElement="W1992_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1992_Flow11_di" bpmnElement="W1992_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1992_Flow12_di" bpmnElement="W1992_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1992_Flow13_di" bpmnElement="W1992_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1992_Assoc9_di" bpmnElement="W1992_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1993" name="W1993. Service Quality Inspection &amp; Partner Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Service visit completion; random quality audit
Frequency: Continuous scoring; ~10% random audits
Volume: ~100–350 quality audits/month (10% of visits)
Owner: VP Store Operations
Participants: VP Store Operations, Quality Inspector, Service Partner
Source: workflow W1993 — Service Quality Inspection &amp; Partner Scoring</bpmn:documentation>
      <bpmn:laneSet id="W1993_LaneSet4">
        <bpmn:lane id="W1993_Lane1" name="System">
        <bpmn:flowNodeRef>W1993_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1993_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1993_Lane2" name="Quality Inspector">
        <bpmn:flowNodeRef>W1993_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1993_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1993_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1993_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1993_Start5" name="Service visit completion; random quality audit">
        <bpmn:outgoing>W1993_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1993_Task6" name="System calculates per-visit quality score: (a) customer rating (1–5 stars from…">
        <bpmn:documentation>Step 1: System calculates per-visit quality score: (a) customer rating (1–5 stars from W1991.3): weight 40%, (b) service report completeness (all fields filled, photos attached): weight 20%, (c) on-time arrival (within scheduled window): weight 20%, (d) customer complaint (if any): weight 20% (complaint = 0, no complaint = full score)
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1993_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1993_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1993_Task7" name="Random quality audit (~10% of visits): (a) VP Store Operations selects random…">
        <bpmn:documentation>Step 2: Random quality audit (~10% of visits): (a) VP Store Operations selects random sample, (b) Quality Inspector calls customer for feedback: (i) was technician professional?, (ii) was work completed to satisfaction?, (iii) would you recommend BuildRight services?, (c) review service report and photos for quality standards compliance
Responsible (R): Quality Inspector / VP Store Operations
Accountable (A): VP Store Operations
Duration: 15–20 min/audit</bpmn:documentation>
        <bpmn:incoming>W1993_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1993_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1993_Task8" name="Monthly partner scorecard: (a) average quality score by partner, (b) customer…">
        <bpmn:documentation>Step 3: Monthly partner scorecard: (a) average quality score by partner, (b) customer rating trend, (c) complaint rate, (d) on-time rate, (e) share with partner for continuous improvement
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1993_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1993_End9" name="Complete">
        <bpmn:incoming>W1993_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1993_Annotation10">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
