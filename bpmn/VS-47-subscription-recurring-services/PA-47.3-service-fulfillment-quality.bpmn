    <bpmn:process id="W_W1994" name="W1994. Service Complaint &amp; Revisit Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports service quality issue
Frequency: ~100–200 service complaints/month (projected ~5% complaint rate)
Volume: Per complaint
Owner: Customer Service Rep
Participants: Customer Service Rep, Service Coordinator, Service Partner, VP Store Operations
Source: workflow W1994 — Service Complaint &amp; Revisit Management</bpmn:documentation>
      <bpmn:laneSet id="W1994_LaneSet4">
        <bpmn:lane id="W1994_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1994_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1994_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1994_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1994_Lane2" name="Service Coordinator">
        <bpmn:flowNodeRef>W1994_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1994_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1994_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1994_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1994_Start5" name="Customer reports service quality issue">
        <bpmn:outgoing>W1994_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1994_Task6" name="Customer reports service complaint: (a) channel: phone, email, app, in-store…">
        <bpmn:documentation>Step 1: Customer reports service complaint: (a) channel: phone, email, app, in-store, (b) complaint categories: (i) technician no-show or late, (ii) incomplete service, (iii) property damage during service, (iv) rude/unprofessional technician, (v) billing issue, (c) severity: minor (inconvenience), major (property damage, safety issue)
Responsible (R): Customer Service Rep
Accountable (A): VP Store Operations
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1994_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1994_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1994_Task7" name="Service Coordinator investigates: (a) review service report and photos, (b)…">
        <bpmn:documentation>Step 2: Service Coordinator investigates: (a) review service report and photos, (b) contact service partner for their version, (c) for property damage: arrange inspection and repair, (d) for incomplete service: schedule revisit within 48 hours
Responsible (R): Service Coordinator
Accountable (A): VP Store Operations
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1994_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1994_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1994_Task8" name="Resolution: (a) minor: apology + service credit on next billing, (b) major…">
        <bpmn:documentation>Step 3: Resolution: (a) minor: apology + service credit on next billing, (b) major: free revisit + partner penalty + potential partner termination, (c) customer notified of resolution, (d) complaint logged in partner scorecard
Responsible (R): Customer Service Rep / Service Coordinator
Accountable (A): VP Store Operations
Duration: Per complaint</bpmn:documentation>
        <bpmn:incoming>W1994_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1994_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1994_Task9" name="Partner accountability: (a) repeated complaints from same partner: escalation…">
        <bpmn:documentation>Step 4: Partner accountability: (a) repeated complaints from same partner: escalation meeting, (b) 3+ complaints in 30 days: temporary suspension of new visits, (c) unresolved major complaint: partner termination per W1975 agreement
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1994_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1994_End10" name="Complete">
        <bpmn:incoming>W1994_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1994_Annotation11">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: Customer Service Rep review and approval gate
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1994_Assoc12" sourceRef="W1994_Annotation11" targetRef="W1994_Start5" associationDirection="None" />
