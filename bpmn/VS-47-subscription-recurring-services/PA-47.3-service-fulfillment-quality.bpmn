    <bpmn:process id="W_W1995" name="W1995. Service Partner Performance Dashboard &amp; Quarterly Review" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly dashboard update; quarterly review meeting
Frequency: Monthly dashboard; quarterly review
Volume: ~20–30 service partners reviewed
Owner: VP Store Operations
Participants: VP Store Operations, Service Partners, COO
Source: workflow W1995 — Service Partner Performance Dashboard &amp; Quarterly Review</bpmn:documentation>
      <bpmn:laneSet id="W1995_LaneSet3">
        <bpmn:lane id="W1995_Lane1" name="System">
        <bpmn:flowNodeRef>W1995_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1995_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1995_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1995_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1995_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1995_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1995_Start4" name="Monthly dashboard update; quarterly review meeting">
        <bpmn:outgoing>W1995_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1995_Task5" name="Monthly: system generates partner performance dashboard: (a) visits completed…">
        <bpmn:documentation>Step 1: Monthly: system generates partner performance dashboard: (a) visits completed vs. scheduled, (b) average customer rating (1–5 stars), (c) on-time arrival rate, (d) complaint rate (% of visits resulting in complaint), (e) quality audit score (from random audits), (f) revisit rate (% of visits requiring follow-up)
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1995_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1995_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1995_Task6" name="VP Store Operations reviews dashboard monthly: (a) identify underperforming…">
        <bpmn:documentation>Step 2: VP Store Operations reviews dashboard monthly: (a) identify underperforming partners (score &lt; 3.5/5.0), (b) identify top performers for recognition and priority dispatch, (c) flag capacity issues (partner declining visits due to workload)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W1995_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1995_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1995_Task7" name="Quarterly: VP Store Operations conducts review meeting with each partner: (a)…">
        <bpmn:documentation>Step 3: Quarterly: VP Store Operations conducts review meeting with each partner: (a) present scorecard, (b) discuss improvement areas, (c) agree on action items with deadlines, (d) discuss upcoming volume changes (seasonal demand, new territories), (e) top-performing partners: discuss expansion opportunities (additional territories, new service types)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 hours/partner/quarter</bpmn:documentation>
        <bpmn:incoming>W1995_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1995_End8" name="Complete">
        <bpmn:incoming>W1995_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1995_Annotation9">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
