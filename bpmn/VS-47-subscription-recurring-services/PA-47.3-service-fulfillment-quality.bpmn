      <bpmn:sequenceFlow id="W1994_Flow15" sourceRef="W1994_Task7" targetRef="W1994_Task8" />
      <bpmn:sequenceFlow id="W1994_Flow16" sourceRef="W1994_Task8" targetRef="W1994_Task9" />
      <bpmn:sequenceFlow id="W1994_Flow17" sourceRef="W1994_Task9" targetRef="W1994_End10" />
    </bpmn:process>
