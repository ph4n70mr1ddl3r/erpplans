    <bpmn:process id="W_W1997" name="W1997. Subscription Service Annual Program Review &amp; Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Annual subscription program review
Frequency: Annual
Volume: Consolidated program review
Owner: VP Store Operations
Participants: VP Store Operations, CMO, CFO, COO
Source: workflow W1997 — Subscription Service Annual Program Review &amp; Optimization</bpmn:documentation>
      <bpmn:laneSet id="W1997_LaneSet4">
        <bpmn:lane id="W1997_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1997_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1997_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1997_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1997_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1997_Lane3" name="COO">
        <bpmn:flowNodeRef>W1997_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1997_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1997_Start5" name="Annual subscription program review">
        <bpmn:outgoing>W1997_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1997_Task6" name="VP Store Operations compiles annual program review: (a) subscriber count…">
        <bpmn:documentation>Step 1: VP Store Operations compiles annual program review: (a) subscriber count: target vs. actual, (b) revenue: subscription revenue + deferred revenue balance, (c) margin: actual vs. target (25–35%), (d) retention rate: % of subscribers renewed, (e) churn analysis: why are customers leaving?, (f) service quality: average customer rating, complaint rate, partner performance, (g) enrollment funnel: awareness → inquiry → enrollment conversion rate
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1997_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1997_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1997_Task7" name="CFO reviews financial performance: (a) deferred revenue as % of total revenue…">
        <bpmn:documentation>Step 2: CFO reviews financial performance: (a) deferred revenue as % of total revenue, (b) breakage rate: % of subscribers not using all visits, (c) partner cost trend: are partner costs increasing?, (d) cash flow impact: annual upfront payments improve cash flow; monthly payments create receivables, (e) ROI of subscription program: incremental profit vs. investment
Responsible (R): CFO
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1997_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1997_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1997_Task8" name="Strategic decisions: (a) expand: add new service types or territories, (b)…">
        <bpmn:documentation>Step 3: Strategic decisions: (a) expand: add new service types or territories, (b) optimize: adjust pricing, tiers, partner network, (c) sunset: discontinue underperforming subscription products, (d) invest: allocate budget for Year 2 subscriber growth target
Responsible (R): COO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1997_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1997_End9" name="Complete">
        <bpmn:incoming>W1997_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1997_Annotation10">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
