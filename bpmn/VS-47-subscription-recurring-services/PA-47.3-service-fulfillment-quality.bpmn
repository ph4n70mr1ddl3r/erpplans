    <bpmn:process id="W_W1996" name="W1996. Service Visit No-Show &amp; Rescheduling Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or partner no-show for scheduled visit
Frequency: ~100–200 no-shows/month (projected ~5–10% rate)
Volume: Per occurrence
Owner: Service Coordinator
Participants: Service Coordinator, Customer, Service Partner
Source: workflow W1996 — Service Visit No-Show &amp; Rescheduling Management</bpmn:documentation>
      <bpmn:laneSet id="W1996_LaneSet3">
        <bpmn:lane id="W1996_Lane1" name="Service Partner">
        <bpmn:flowNodeRef>W1996_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1996_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1996_Lane2" name="Service Coordinator">
        <bpmn:flowNodeRef>W1996_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1996_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1996_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1996_Start4" name="Customer or partner no-show for scheduled visit">
        <bpmn:outgoing>W1996_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1996_Task5" name="Customer no-show: (a) technician arrives at scheduled time, customer not…">
        <bpmn:documentation>Step 1: Customer no-show: (a) technician arrives at scheduled time, customer not available, (b) technician waits 15 minutes, attempts customer contact, (c) if no response: mark as customer no-show, (d) system logs no-show with timestamp, (e) reschedule: system sends rescheduling link to customer
Responsible (R): Service Partner / System
Accountable (A): Service Coordinator
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W1996_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1996_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1996_Task6" name="Partner no-show: (a) partner fails to arrive within scheduled window, (b)…">
        <bpmn:documentation>Step 2: Partner no-show: (a) partner fails to arrive within scheduled window, (b) system detects: no GPS check-in from partner app within 30 min of scheduled start, (c) Service Coordinator contacts partner immediately, (d) if partner cannot come: emergency dispatch from backup partner or reschedule customer, (e) partner no-show penalty: PHP 500–1,000 deduction from partner payment per no-show
Responsible (R): Service Coordinator
Accountable (A): VP Store Operations
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1996_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1996_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1996_Task7" name="Rescheduling: (a) system offers 3 alternative time slots, (b) customer selects…">
        <bpmn:documentation>Step 3: Rescheduling: (a) system offers 3 alternative time slots, (b) customer selects preferred slot, (c) partner notified of rescheduled visit, (d) if rescheduling within same billing period: no impact on revenue recognition, (e) if rescheduling pushes visit to next billing period: deferred revenue timing adjusted
Responsible (R): Service Coordinator / System
Accountable (A): VP Store Operations
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W1996_Flow13</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1996_End8" name="Complete">
        <bpmn:incoming>W1996_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1996_Annotation9">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Service Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1996_Assoc10" sourceRef="W1996_Annotation9" targetRef="W1996_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1996_Flow11" sourceRef="W1996_Start4" targetRef="W1996_Task5" />
      <bpmn:sequenceFlow id="W1996_Flow12" sourceRef="W1996_Task5" targetRef="W1996_Task6" />
      <bpmn:sequenceFlow id="W1996_Flow13" sourceRef="W1996_Task6" targetRef="W1996_Task7" />
      <bpmn:sequenceFlow id="W1996_Flow14" sourceRef="W1996_Task7" targetRef="W1996_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1996_diag">
      <bpmndi:BPMNPlane id="W1996_plane" bpmnElement="W_W1996">
        <bpmndi:BPMNShape id="W1996_Lane1_di" bpmnElement="W1996_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1996_Lane2_di" bpmnElement="W1996_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1996_Task5_di" bpmnElement="W1996_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1996_Task6_di" bpmnElement="W1996_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1996_Task7_di" bpmnElement="W1996_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
