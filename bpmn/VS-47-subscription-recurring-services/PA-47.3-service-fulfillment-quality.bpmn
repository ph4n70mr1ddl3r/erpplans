        <bpmndi:BPMNShape id="W1990_End8_di" bpmnElement="W1990_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1990_Annotation9_di" bpmnElement="W1990_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1990_Flow11_di" bpmnElement="W1990_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1990_Flow12_di" bpmnElement="W1990_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1990_Flow13_di" bpmnElement="W1990_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1990_Flow14_di" bpmnElement="W1990_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1990_Assoc10_di" bpmnElement="W1990_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1991" name="W1991. Service Visit Execution &amp; Customer Interaction" isExecutable="false">
      <bpmn:documentation>Trigger: Service partner arrives at customer location
Frequency: ~1,000–3,500 visits/month (per W1990&#x27;s subscriber-based derivation)
Volume: Per visit
Owner: Service Partner Technician
Participants: Service Partner Technician, Customer
Source: workflow W1991 — Service Visit Execution &amp; Customer Interaction</bpmn:documentation>
      <bpmn:laneSet id="W1991_LaneSet2">
        <bpmn:lane id="W1991_Lane1" name="Service Partner Technician">
        <bpmn:flowNodeRef>W1991_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1991_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1991_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1991_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1991_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1991_Start3" name="Service partner arrives at customer location">
        <bpmn:outgoing>W1991_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1991_Task4" name="Service Partner Technician arrives at customer location: (a) BuildRight-branded…">
        <bpmn:documentation>Step 1: Service Partner Technician arrives at customer location: (a) BuildRight-branded uniform and ID, (b) greet customer, confirm identity and service requested, (c) perform service per tier checklist: (i) basic: inspection + report, (ii) standard: inspection + minor repair + report, (iii) premium: inspection + all repairs + parts + report
Responsible (R): Service Partner Technician
Accountable (A): —
Duration: 1–3 hours/visit</bpmn:documentation>
        <bpmn:incoming>W1991_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1991_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1991_Task5" name="Service documentation: (a) technician completes digital service report on…">
        <bpmn:documentation>Step 2: Service documentation: (a) technician completes digital service report on tablet/app: (i) work performed, (ii) materials used (for premium tier), (iii) findings and recommendations, (iv) before/after photos (required), (v) customer signature on completion, (b) system records: service visit completed, time spent, findings
Responsible (R): Service Partner Technician
Accountable (A): VP Store Operations
Duration: 10–15 min/report</bpmn:documentation>
        <bpmn:incoming>W1991_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1991_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1991_Task6" name="Customer interaction: (a) technician explains findings to customer, (b)…">
        <bpmn:documentation>Step 3: Customer interaction: (a) technician explains findings to customer, (b) provides maintenance tips and recommendations, (c) schedules next visit (if customer wants early next visit), (d) customer rates service experience (1–5 stars) on technician&#x27;s tablet before departure
Responsible (R): Service Partner Technician / Customer
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1991_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1991_End7" name="Complete">
        <bpmn:incoming>W1991_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1991_Annotation8">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Service Partner Technician</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1991_Assoc9" sourceRef="W1991_Annotation8" targetRef="W1991_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1991_Flow10" sourceRef="W1991_Start3" targetRef="W1991_Task4" />
      <bpmn:sequenceFlow id="W1991_Flow11" sourceRef="W1991_Task4" targetRef="W1991_Task5" />
      <bpmn:sequenceFlow id="W1991_Flow12" sourceRef="W1991_Task5" targetRef="W1991_Task6" />
      <bpmn:sequenceFlow id="W1991_Flow13" sourceRef="W1991_Task6" targetRef="W1991_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1991_diag">
      <bpmndi:BPMNPlane id="W1991_plane" bpmnElement="W_W1991">
        <bpmndi:BPMNShape id="W1991_Lane1_di" bpmnElement="W1991_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_Task4_di" bpmnElement="W1991_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_Task5_di" bpmnElement="W1991_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_Task6_di" bpmnElement="W1991_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_Start3_di" bpmnElement="W1991_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_End7_di" bpmnElement="W1991_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1991_Annotation8_di" bpmnElement="W1991_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1991_Flow10_di" bpmnElement="W1991_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1991_Flow11_di" bpmnElement="W1991_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1991_Flow12_di" bpmnElement="W1991_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1991_Flow13_di" bpmnElement="W1991_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1991_Assoc9_di" bpmnElement="W1991_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1992" name="W1992. Service Completion Confirmation &amp; Revenue Recognition Trigger" isExecutable="false">
      <bpmn:documentation>Trigger: Service visit completed and customer-signed report uploaded
Frequency: ~1,000–3,500 completions/month (per W1990&#x27;s visit volume)
Volume: Per visit
Owner: Accounting Manager
Participants: System, Accounting Manager, Service Partner
Source: workflow W1992 — Service Completion Confirmation &amp; Revenue Recognition Trigger</bpmn:documentation>
      <bpmn:laneSet id="W1992_LaneSet2">
        <bpmn:lane id="W1992_Lane1" name="System">
        <bpmn:flowNodeRef>W1992_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1992_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1992_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1992_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1992_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1992_Start3" name="Service visit completed and customer-signed report uploaded">
        <bpmn:outgoing>W1992_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1992_Task4" name="System triggers revenue recognition on visit completion: (a) deferred revenue →…">
        <bpmn:documentation>Step 1: System triggers revenue recognition on visit completion: (a) deferred revenue → service revenue: pro-rata portion per visit (total subscription fee ÷ number of visits), (b) output VAT recognized on service revenue, (c) service partner cost recognized: debit COGS (service cost), credit AP (service partner payable)
Responsible (R): System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1992_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1992_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1992_Task5" name="Service partner payment: (a) system accumulates partner costs per visit, (b)…">
        <bpmn:documentation>Step 2: Service partner payment: (a) system accumulates partner costs per visit, (b) monthly: AP processes partner payment per agreed terms (typically Net 15), (c) payment per completed visit × per-visit rate, (d) deduction for quality issues or customer complaints (if applicable)
Responsible (R): System / AP Clerk
Accountable (A): Accounting Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1992_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1992_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1992_Task6" name="Customer notification: (a) system sends service completion confirmation with…">
        <bpmn:documentation>Step 3: Customer notification: (a) system sends service completion confirmation with summary report, (b) include: work performed, recommendations, next visit date, (c) attach digital service report (PDF), (d) CSAT survey link
Responsible (R): System
Accountable (A): Service Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1992_Flow12</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1992_End7" name="Complete">
        <bpmn:incoming>W1992_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1992_Annotation8">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1992_Assoc9" sourceRef="W1992_Annotation8" targetRef="W1992_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1992_Flow10" sourceRef="W1992_Start3" targetRef="W1992_Task4" />
      <bpmn:sequenceFlow id="W1992_Flow11" sourceRef="W1992_Task4" targetRef="W1992_Task5" />
      <bpmn:sequenceFlow id="W1992_Flow12" sourceRef="W1992_Task5" targetRef="W1992_Task6" />
      <bpmn:sequenceFlow id="W1992_Flow13" sourceRef="W1992_Task6" targetRef="W1992_End7" />
    </bpmn:process>
