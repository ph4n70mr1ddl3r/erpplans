<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-47.3-service-fulfillment-quality" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1990" name="W1990. Service Visit Scheduling &amp; Dispatch Management" isExecutable="false">
      <bpmn:documentation>Trigger: Subscription enrollment; scheduled service visit due
Frequency: ~1,000–3,500 service visits/month (projected; derived from ~5,000–10,000 subscribers × 2–4 visits/year)
Volume: ~5,000–10,000 subscribers × 2–4 visits/year
Owner: Service Coordinator
Participants: Service Coordinator, Service Partner, Customer
Source: workflow W1990 — Service Visit Scheduling &amp; Dispatch Management</bpmn:documentation>
      <bpmn:laneSet id="W1990_LaneSet3">
        <bpmn:lane id="W1990_Lane1" name="System">
        <bpmn:flowNodeRef>W1990_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1990_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1990_Lane2" name="Service Coordinator">
        <bpmn:flowNodeRef>W1990_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1990_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1990_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1990_Start4" name="Subscription enrollment; scheduled service visit due">
        <bpmn:outgoing>W1990_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1990_Task5" name="System generates service visit schedule: (a) based on subscription frequency…">
        <bpmn:documentation>Step 1: System generates service visit schedule: (a) based on subscription frequency: quarterly, semi-annual, annual, (b) customer&#x27;s preferred visit window (from enrollment), (c) service partner availability calendar, (d) geographic optimization: batch visits by area to minimize partner travel time
Responsible (R): System
Accountable (A): Service Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1990_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1990_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1990_Task6" name="Service Coordinator reviews and confirms schedule: (a) verify partner…">
        <bpmn:documentation>Step 2: Service Coordinator reviews and confirms schedule: (a) verify partner availability, (b) check customer communication preferences (SMS/email/app), (c) send visit confirmation to customer: date, time window (e.g., 9 AM–12 PM), partner name, (d) send dispatch order to service partner: customer address, service type, tier, special instructions
Responsible (R): Service Coordinator
Accountable (A): VP Store Operations
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W1990_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1990_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1990_Task7" name="Day-of coordination: (a) partner confirms arrival estimate via app, (b) system…">
        <bpmn:documentation>Step 3: Day-of coordination: (a) partner confirms arrival estimate via app, (b) system sends &quot;technician on the way&quot; notification to customer with ETA, (c) if partner reports delay: reschedule notification to customer
Responsible (R): Service Coordinator / System
Accountable (A): VP Store Operations
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W1990_Flow13</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1990_End8" name="Complete">
        <bpmn:incoming>W1990_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1990_Annotation9">
        <bpmn:text>Controls: - CTL-384 (ensure controlled execution — Service Fulfillment, Scheduling &amp; Quality Assurance (PA-47.3).) | - operational: Service Coordinator review and approval gate
Owner: Service Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1990_Assoc10" sourceRef="W1990_Annotation9" targetRef="W1990_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1990_Flow11" sourceRef="W1990_Start4" targetRef="W1990_Task5" />
      <bpmn:sequenceFlow id="W1990_Flow12" sourceRef="W1990_Task5" targetRef="W1990_Task6" />
      <bpmn:sequenceFlow id="W1990_Flow13" sourceRef="W1990_Task6" targetRef="W1990_Task7" />
      <bpmn:sequenceFlow id="W1990_Flow14" sourceRef="W1990_Task7" targetRef="W1990_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1990_diag">
      <bpmndi:BPMNPlane id="W1990_plane" bpmnElement="W_W1990">
        <bpmndi:BPMNShape id="W1990_Lane1_di" bpmnElement="W1990_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1990_Lane2_di" bpmnElement="W1990_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
