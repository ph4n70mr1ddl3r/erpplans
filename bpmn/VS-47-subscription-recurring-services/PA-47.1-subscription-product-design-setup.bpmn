      <bpmn:sequenceFlow id="W1981_Flow13" sourceRef="W1981_Task6" targetRef="W1981_Task7" />
      <bpmn:sequenceFlow id="W1981_Flow14" sourceRef="W1981_Task7" targetRef="W1981_End8" />
    </bpmn:process>
