    <bpmn:process id="W_W1979" name="W1979. Service Territory &amp; Coverage Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: Subscription service launch in new area; quarterly review
Frequency: Quarterly review; per expansion
Volume: 200 store catchment areas
Owner: VP Store Operations
Participants: VP Store Operations, Service Partners, Regional Managers
Source: workflow W1979 — Service Territory &amp; Coverage Mapping</bpmn:documentation>
      <bpmn:laneSet id="W1979_LaneSet3">
        <bpmn:lane id="W1979_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1979_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1979_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1979_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1979_Lane2" name="IT Analyst">
        <bpmn:flowNodeRef>W1979_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1979_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1979_Start4" name="Subscription service launch in new area; quarterly review">
        <bpmn:outgoing>W1979_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1979_Task5" name="VP Store Operations maps service territories: (a) each store catchment area =…">
        <bpmn:documentation>Step 1: VP Store Operations maps service territories: (a) each store catchment area = potential service territory, (b) partner assignment: (i) 1 primary service partner per territory, (ii) 1 backup partner per territory, (c) service radius: typically 15–20 km from store location, (d) service capacity: estimate households in territory × expected subscription penetration rate (2–5%) × visits per year = total visits; verify partner capacity
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 week/territory batch</bpmn:documentation>
        <bpmn:incoming>W1979_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1979_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1979_Task6" name="Online enrollment territory validation: (a) customer enters service address on…">
        <bpmn:documentation>Step 2: Online enrollment territory validation: (a) customer enters service address on buildright.com.ph, (b) system validates address against service territory coverage, (c) if covered: proceed with enrollment, (d) if not covered: display &quot;Coming soon&quot; message with email notification signup
Responsible (R): IT Analyst
Accountable (A): VP Store Operations
Duration: Per enrollment</bpmn:documentation>
        <bpmn:incoming>W1979_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1979_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1979_Task7" name="Quarterly: VP Store Operations reviews territory coverage: (a) coverage…">
        <bpmn:documentation>Step 3: Quarterly: VP Store Operations reviews territory coverage: (a) coverage expansion plan based on demand signals (enrollment requests from uncovered areas), (b) partner performance by territory, (c) partner capacity utilization
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1979_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1979_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1979_End8" name="Complete">
        <bpmn:incoming>W1979_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1979_Annotation9">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
