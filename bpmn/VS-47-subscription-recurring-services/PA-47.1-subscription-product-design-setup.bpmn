    <bpmn:process id="W_W1978" name="W1978. Subscription Revenue Model &amp; Deferred Revenue Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: Subscription product financial setup
Frequency: Per product setup; quarterly review
Volume: ~5–8 subscription products
Owner: Accounting Manager
Participants: Accounting Manager, CFO, External Auditor
Source: workflow W1978 — Subscription Revenue Model &amp; Deferred Revenue Configuration</bpmn:documentation>
      <bpmn:laneSet id="W1978_LaneSet3">
        <bpmn:lane id="W1978_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W1978_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1978_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1978_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1978_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1978_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1978_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1978_Start4" name="Subscription product financial setup">
        <bpmn:outgoing>W1978_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1978_Task5" name="Accounting Manager configures deferred revenue model per PFRS 15: (a) contract…">
        <bpmn:documentation>Step 1: Accounting Manager configures deferred revenue model per PFRS 15: (a) contract liability setup: customer payment → deferred revenue (liability), (b) revenue recognition trigger: service visit completed → deferred revenue → service revenue, (c) VAT treatment: output VAT recognized at service completion (not at payment), (d) breakage: unperformed services after subscription expiry → breakage income, (e) refund: pro-rata refund if customer cancels — deferred revenue reduced, cash refunded
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1–2 days/product</bpmn:documentation>
        <bpmn:incoming>W1978_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1978_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1978_Task6" name="Monthly: Accounting Manager reviews deferred revenue schedule: (a) total…">
        <bpmn:documentation>Step 2: Monthly: Accounting Manager reviews deferred revenue schedule: (a) total deferred revenue balance, (b) deferred revenue by subscription product, (c) revenue recognized in month (service visits completed), (d) new enrollments added to deferred revenue, (e) breakage recognized (subscriptions expired with unused visits)
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1978_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1978_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1978_Task7" name="Quarterly: CFO reviews subscription financials with COO: (a) subscription…">
        <bpmn:documentation>Step 3: Quarterly: CFO reviews subscription financials with COO: (a) subscription revenue growth, (b) deferred revenue trend, (c) breakage rate (target: &lt; 10% of deferred revenue), (d) subscription margin vs. target
Responsible (R): CFO
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1978_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1978_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1978_End8" name="Complete">
        <bpmn:incoming>W1978_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1978_Annotation9">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: Accounting Manager review and approval gate
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
