    <bpmn:process id="W_W1980" name="W1980. Subscription Pilot Program Execution &amp; Evaluation" isExecutable="false">
      <bpmn:documentation>Trigger: New subscription product ready for pilot
Frequency: Per new subscription product (~2–4/year)
Volume: ~100–200 pilot subscribers per product
Owner: VP Store Operations
Participants: VP Store Operations, CMO, CFO, Pilot Stores
Source: workflow W1980 — Subscription Pilot Program Execution &amp; Evaluation</bpmn:documentation>
      <bpmn:laneSet id="W1980_LaneSet2">
        <bpmn:lane id="W1980_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1980_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1980_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1980_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1980_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1980_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1980_Start3" name="New subscription product ready for pilot">
        <bpmn:outgoing>W1980_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1980_Task4" name="VP Store Operations designs pilot program: (a) pilot stores: 10 stores in Metro…">
        <bpmn:documentation>Step 1: VP Store Operations designs pilot program: (a) pilot stores: 10 stores in Metro Manila + Davao, (b) pilot duration: 3 months (enough for at least 1 service visit), (c) target: 100–200 subscribers, (d) special pricing: 20% discount for pilot subscribers, (e) measurement: enrollment rate, service completion rate, customer satisfaction, retention intent
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 week design</bpmn:documentation>
        <bpmn:incoming>W1980_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1980_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1980_Task5" name="Pilot execution: (a) train pilot store staff on enrollment, (b) launch…">
        <bpmn:documentation>Step 2: Pilot execution: (a) train pilot store staff on enrollment, (b) launch enrollment campaign in pilot stores, (c) schedule and execute first service visits within 2 weeks of enrollment, (d) collect customer feedback after each visit
Responsible (R): VP Store Operations / Pilot Store Managers
Accountable (A): COO
Duration: 3 months</bpmn:documentation>
        <bpmn:incoming>W1980_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1980_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1980_Task6" name="Pilot evaluation: (a) enrollment conversion: what % of eligible customers…">
        <bpmn:documentation>Step 3: Pilot evaluation: (a) enrollment conversion: what % of eligible customers enrolled?, (b) service quality: CSAT score per visit, (c) operational issues: scheduling conflicts, partner no-shows, customer complaints, (d) financial: actual margin vs. target, (e) go/no-go decision: VP Store Operations presents pilot results to COO and CFO
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 week evaluation</bpmn:documentation>
        <bpmn:incoming>W1980_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1980_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1980_End7" name="Complete">
        <bpmn:incoming>W1980_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1980_Annotation8">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1980_Assoc9" sourceRef="W1980_Annotation8" targetRef="W1980_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1980_Flow10" sourceRef="W1980_Start3" targetRef="W1980_Task4" />
      <bpmn:sequenceFlow id="W1980_Flow11" sourceRef="W1980_Task4" targetRef="W1980_Task5" />
      <bpmn:sequenceFlow id="W1980_Flow12" sourceRef="W1980_Task5" targetRef="W1980_Task6" />
      <bpmn:sequenceFlow id="W1980_Flow13" sourceRef="W1980_Task6" targetRef="W1980_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1980_diag">
      <bpmndi:BPMNPlane id="W1980_plane" bpmnElement="W_W1980">
        <bpmndi:BPMNShape id="W1980_Lane1_di" bpmnElement="W1980_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
