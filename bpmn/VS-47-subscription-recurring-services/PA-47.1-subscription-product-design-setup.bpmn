<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-47.1-subscription-product-design-setup" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1974" name="W1974. Subscription Service Product Definition &amp; Pricing" isExecutable="false">
      <bpmn:documentation>Trigger: New subscription service product development
Frequency: ~2–4 new subscription products/year
Volume: Target: 5–8 subscription service products
Owner: VP Store Operations
Participants: VP Store Operations, Category Manager, Pricing Analyst, CFO
Source: workflow W1974 — Subscription Service Product Definition &amp; Pricing</bpmn:documentation>
      <bpmn:laneSet id="W1974_LaneSet4">
        <bpmn:lane id="W1974_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1974_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1974_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1974_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1974_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1974_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1974_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1974_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1974_Start5" name="New subscription service product development">
        <bpmn:outgoing>W1974_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1974_Task6" name="VP Store Operations defines subscription service product: (a) service type: (i)…">
        <bpmn:documentation>Step 1: VP Store Operations defines subscription service product: (a) service type: (i) pest control (quarterly visits, PHP 3,000–8,000/year), (ii) aircon cleaning/maintenance (bi-annual, PHP 2,500–5,000/year), (iii) water heater maintenance (annual, PHP 1,500–3,000/year), (iv) generator servicing (semi-annual, PHP 3,000–6,000/year), (v) plumbing check-up (annual, PHP 2,000–4,000/year), (vi) electrical safety inspection (annual, PHP 2,000–4,000/year), (b) service tier: basic (inspection only), standard (inspection + minor repair), premium (inspection + all repairs + parts), (c) service frequency: annual, semi-annual, quarterly, (d) geographic coverage: initially Metro Manila + Davao; expand to all 200 store catchment areas
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 weeks/product</bpmn:documentation>
        <bpmn:incoming>W1974_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1974_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1974_Task7" name="Pricing Analyst develops subscription pricing: (a) cost model: service partner…">
        <bpmn:documentation>Step 2: Pricing Analyst develops subscription pricing: (a) cost model: service partner cost + BuildRight margin + platform fee, (b) competitive benchmarking: market rates for equivalent services in Philippines, (c) subscription discount: 10–20% below a-la-carte pricing to incentivize subscription, (d) annual vs. monthly billing: annual upfront (preferred — higher cash collection) with monthly payment option, (e) target margin: 25–35% per service visit
Responsible (R): Pricing Analyst
Accountable (A): CFO
Duration: 3–5 days/product</bpmn:documentation>
        <bpmn:incoming>W1974_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1974_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1974_Task8" name="CFO approves pricing and revenue model: (a) deferred revenue treatment per PFRS…">
        <bpmn:documentation>Step 3: CFO approves pricing and revenue model: (a) deferred revenue treatment per PFRS 15 (customer pays upfront, revenue recognized per service visit), (b) breakage estimation for unused services (customers who don&#x27;t schedule all visits), (c) annual margin contribution projection
Responsible (R): CFO
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1974_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1974_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1974_End9" name="Complete">
        <bpmn:incoming>W1974_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1974_Annotation10">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1974_Assoc11" sourceRef="W1974_Annotation10" targetRef="W1974_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1974_Flow12" sourceRef="W1974_Start5" targetRef="W1974_Task6" />
      <bpmn:sequenceFlow id="W1974_Flow13" sourceRef="W1974_Task6" targetRef="W1974_Task7" />
      <bpmn:sequenceFlow id="W1974_Flow14" sourceRef="W1974_Task7" targetRef="W1974_Task8" />
      <bpmn:sequenceFlow id="W1974_Flow15" sourceRef="W1974_Task8" targetRef="W1974_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1974_diag">
      <bpmndi:BPMNPlane id="W1974_plane" bpmnElement="W_W1974">
        <bpmndi:BPMNShape id="W1974_Lane1_di" bpmnElement="W1974_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Lane2_di" bpmnElement="W1974_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Lane3_di" bpmnElement="W1974_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Task6_di" bpmnElement="W1974_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Task7_di" bpmnElement="W1974_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Task8_di" bpmnElement="W1974_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Start5_di" bpmnElement="W1974_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_End9_di" bpmnElement="W1974_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1974_Annotation10_di" bpmnElement="W1974_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1974_Flow12_di" bpmnElement="W1974_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1974_Flow13_di" bpmnElement="W1974_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1974_Flow14_di" bpmnElement="W1974_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1974_Flow15_di" bpmnElement="W1974_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1974_Assoc11_di" bpmnElement="W1974_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1975" name="W1975. Service Partner Qualification &amp; Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New subscription service product requires service partners
Frequency: ~5–10 service partners qualified/year
Volume: ~20–30 active service partners across Philippines
Owner: VP Store Operations
Participants: VP Store Operations, Service Partner, Legal &amp; Compliance Officer
Source: workflow W1975 — Service Partner Qualification &amp; Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W1975_LaneSet3">
        <bpmn:lane id="W1975_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1975_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1975_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1975_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1975_Lane2" name="Legal &amp; Compliance Officer">
        <bpmn:flowNodeRef>W1975_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1975_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1975_Start4" name="New subscription service product requires service partners">
        <bpmn:outgoing>W1975_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1975_Task5" name="VP Store Operations identifies and evaluates service partners: (a) licensed…">
        <bpmn:documentation>Step 1: VP Store Operations identifies and evaluates service partners: (a) licensed pest control operators (FPA-licensed per Philippine law), (b) HVAC technicians (TESDA-certified), (c) licensed electricians and plumbers, (d) criteria: (i) professional license and insurance, (ii) service vehicle and equipment, (iii) geographic coverage, (iv) customer service capability, (v) background-checked technicians
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 weeks/partner</bpmn:documentation>
        <bpmn:incoming>W1975_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1975_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1975_Task6" name="Legal &amp; Compliance Officer reviews service partner agreement: (a) scope of…">
        <bpmn:documentation>Step 2: Legal &amp; Compliance Officer reviews service partner agreement: (a) scope of services, (b) service SLA: response time, completion time, quality standards, (c) pricing: per-visit cost to BuildRight, (d) liability: service partner carries own professional liability insurance, (e) customer interaction standards: BuildRight-branded uniform, BuildRight service checklist, BuildRight-branded service report, (f) termination clause: BuildRight can terminate for quality or compliance failures
Responsible (R): Legal &amp; Compliance Officer
Accountable (A): VP Legal
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1975_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1975_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1975_Task7" name="Onboarding: (a) service partner training on BuildRight service standards, (b)…">
        <bpmn:documentation>Step 3: Onboarding: (a) service partner training on BuildRight service standards, (b) system access: service scheduling portal, customer information (privacy-compliant per RA 10173), (c) branded materials: uniform, ID, vehicle signage, service report templates, (d) pilot: first 10 service visits monitored by BuildRight quality team
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1975_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1975_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1975_End8" name="Complete">
        <bpmn:incoming>W1975_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1975_Annotation9">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1975_Assoc10" sourceRef="W1975_Annotation9" targetRef="W1975_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1975_Flow11" sourceRef="W1975_Start4" targetRef="W1975_Task5" />
      <bpmn:sequenceFlow id="W1975_Flow12" sourceRef="W1975_Task5" targetRef="W1975_Task6" />
      <bpmn:sequenceFlow id="W1975_Flow13" sourceRef="W1975_Task6" targetRef="W1975_Task7" />
      <bpmn:sequenceFlow id="W1975_Flow14" sourceRef="W1975_Task7" targetRef="W1975_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1975_diag">
      <bpmndi:BPMNPlane id="W1975_plane" bpmnElement="W_W1975">
        <bpmndi:BPMNShape id="W1975_Lane1_di" bpmnElement="W1975_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Lane2_di" bpmnElement="W1975_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Task5_di" bpmnElement="W1975_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Task6_di" bpmnElement="W1975_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Task7_di" bpmnElement="W1975_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Start4_di" bpmnElement="W1975_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_End8_di" bpmnElement="W1975_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1975_Annotation9_di" bpmnElement="W1975_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1975_Flow11_di" bpmnElement="W1975_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1975_Flow12_di" bpmnElement="W1975_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1975_Flow13_di" bpmnElement="W1975_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1975_Flow14_di" bpmnElement="W1975_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1975_Assoc10_di" bpmnElement="W1975_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1976" name="W1976. Subscription SKU &amp; Service Item Master Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Subscription product approved per W1974
Frequency: Per new subscription product
Volume: ~5–8 subscription service items
Owner: IT Analyst
Participants: IT Analyst, VP Store Operations, Accounting Manager
Source: workflow W1976 — Subscription SKU &amp; Service Item Master Setup</bpmn:documentation>
      <bpmn:laneSet id="W1976_LaneSet3">
        <bpmn:lane id="W1976_Lane1" name="IT Analyst">
        <bpmn:flowNodeRef>W1976_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1976_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1976_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1976_Lane2" name="Accounting Manager">
        <bpmn:flowNodeRef>W1976_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1976_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1976_Start4" name="Subscription product approved per W1974">
        <bpmn:outgoing>W1976_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1976_Task5" name="IT Analyst creates subscription service items in item master: (a) service SKU…">
        <bpmn:documentation>Step 1: IT Analyst creates subscription service items in item master: (a) service SKU with subscription indicator, (b) pricing: annual subscription price, per-visit service cost (internal), (c) revenue recognition: deferred revenue model — customer pays annual fee upfront, revenue recognized per visit completed, (d) billing schedule: annual upfront or monthly recurring, (e) service frequency: number of visits per subscription period, (f) service duration: estimated hours per visit
Responsible (R): IT Analyst
Accountable (A): VP Store Operations
Duration: 1 day/product</bpmn:documentation>
        <bpmn:incoming>W1976_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1976_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1976_Task6" name="Accounting Manager configures financial posting: (a) customer payment: debit…">
        <bpmn:documentation>Step 2: Accounting Manager configures financial posting: (a) customer payment: debit cash, credit deferred revenue (liability), (b) per service visit completed: debit deferred revenue, credit service revenue + output VAT, (c) service partner cost: debit COGS, credit AP (service partner), (d) unused service (breakage): after subscription period expires, remaining deferred revenue recognized as breakage income
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day/product</bpmn:documentation>
        <bpmn:incoming>W1976_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1976_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1976_Task7" name="POS configuration: (a) subscription enrollment at POS: scan service item…">
        <bpmn:documentation>Step 3: POS configuration: (a) subscription enrollment at POS: scan service item, collect annual fee, print enrollment confirmation with service schedule, (b) online enrollment: ecommerce integration per ECOM-008, (c) loyalty points: subscription purchase earns points per standard rules
Responsible (R): IT Analyst
Accountable (A): VP Store Operations
Duration: 1 day/product</bpmn:documentation>
        <bpmn:incoming>W1976_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1976_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1976_End8" name="Complete">
        <bpmn:incoming>W1976_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1976_Annotation9">
        <bpmn:text>Controls: - CTL-192 (ensure subscription billing &amp; dunning integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1976_Assoc10" sourceRef="W1976_Annotation9" targetRef="W1976_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1976_Flow11" sourceRef="W1976_Start4" targetRef="W1976_Task5" />
      <bpmn:sequenceFlow id="W1976_Flow12" sourceRef="W1976_Task5" targetRef="W1976_Task6" />
      <bpmn:sequenceFlow id="W1976_Flow13" sourceRef="W1976_Task6" targetRef="W1976_Task7" />
      <bpmn:sequenceFlow id="W1976_Flow14" sourceRef="W1976_Task7" targetRef="W1976_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1976_diag">
      <bpmndi:BPMNPlane id="W1976_plane" bpmnElement="W_W1976">
        <bpmndi:BPMNShape id="W1976_Lane1_di" bpmnElement="W1976_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Lane2_di" bpmnElement="W1976_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Task5_di" bpmnElement="W1976_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Task6_di" bpmnElement="W1976_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Task7_di" bpmnElement="W1976_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Start4_di" bpmnElement="W1976_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_End8_di" bpmnElement="W1976_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1976_Annotation9_di" bpmnElement="W1976_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1976_Flow11_di" bpmnElement="W1976_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1976_Flow12_di" bpmnElement="W1976_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1976_Flow13_di" bpmnElement="W1976_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1976_Flow14_di" bpmnElement="W1976_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1976_Assoc10_di" bpmnElement="W1976_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1977" name="W1977. Subscription Enrollment Flow Design (POS &amp; Online)" isExecutable="false">
      <bpmn:documentation>Trigger: Subscription product ready for enrollment
Frequency: Per product launch
Volume: Target: 5,000–10,000 subscribers within Year 1
Owner: VP Store Operations
Participants: VP Store Operations, CMO, IT Analyst
Source: workflow W1977 — Subscription Enrollment Flow Design (POS &amp; Online)</bpmn:documentation>
      <bpmn:laneSet id="W1977_LaneSet3">
        <bpmn:lane id="W1977_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1977_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1977_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1977_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1977_Lane2" name="CMO">
        <bpmn:flowNodeRef>W1977_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1977_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1977_Start4" name="Subscription product ready for enrollment">
        <bpmn:outgoing>W1977_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1977_Task5" name="POS enrollment flow: (a) Sales Associate identifies subscription opportunity…">
        <bpmn:documentation>Step 1: POS enrollment flow: (a) Sales Associate identifies subscription opportunity during customer interaction (e.g., customer buying aircon → offer maintenance subscription), (b) scan subscription service SKU at POS, (c) system prompts: (i) customer details (link to loyalty account or new enrollment), (ii) service address, (iii) preferred visit schedule, (iv) payment: annual upfront or monthly, (d) customer signs subscription agreement (digital or paper), (e) payment collected, (f) confirmation with first visit date sent via SMS/email
Responsible (R): VP Store Operations / IT Analyst
Accountable (A): COO
Duration: 1 week design</bpmn:documentation>
        <bpmn:incoming>W1977_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1977_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1977_Task6" name="Online enrollment flow: (a) customer browses subscription services on…">
        <bpmn:documentation>Step 2: Online enrollment flow: (a) customer browses subscription services on buildright.com.ph, (b) selects service, tier, and frequency, (c) enters service address and preferred schedule, (d) pays online (annual or monthly via PayMongo/GCash/CC), (e) receives confirmation with assigned service partner and first visit date
Responsible (R): CMO / IT Analyst
Accountable (A): COO
Duration: 1 week design</bpmn:documentation>
        <bpmn:incoming>W1977_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1977_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1977_Task7" name="Enrollment training for store staff: (a) Sales Associate training on…">
        <bpmn:documentation>Step 3: Enrollment training for store staff: (a) Sales Associate training on subscription product knowledge and selling technique, (b) target: every Sales Associate can explain subscription benefits and process enrollment, (c) enrollment KPI: 10% of eligible product buyers offered subscription; 20% conversion of offers
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day training</bpmn:documentation>
        <bpmn:incoming>W1977_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1977_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1977_End8" name="Complete">
        <bpmn:incoming>W1977_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1977_Annotation9">
        <bpmn:text>Controls: - CTL-382 (ensure controlled execution — Subscription Product Design &amp; Setup (PA-47.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
