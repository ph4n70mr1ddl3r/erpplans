    <bpmn:process id="W_W1986" name="W1986. Subscription Payment Failure &amp; Dunning Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly auto-charge payment failure
Frequency: ~200–500 failed payments/month (5–10% failure rate projected)
Volume: ~2,000–5,000 monthly-billed subscribers
Owner: AR Clerk
Participants: AR Clerk, Customer Service Rep, Customer
Source: workflow W1986 — Subscription Payment Failure &amp; Dunning Management</bpmn:documentation>
      <bpmn:laneSet id="W1986_LaneSet3">
        <bpmn:lane id="W1986_Lane1" name="System">
        <bpmn:flowNodeRef>W1986_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1986_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1986_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1986_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W1986_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1986_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1986_Start4" name="Monthly auto-charge payment failure">
        <bpmn:outgoing>W1986_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1986_Task5" name="System detects payment failure: (a) credit card declined, (b) e-wallet…">
        <bpmn:documentation>Step 1: System detects payment failure: (a) credit card declined, (b) e-wallet insufficient balance, (c) bank account issue, (d) system tags subscription as &quot;payment due&quot;
Responsible (R): System
Accountable (A): AR Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1986_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1986_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1986_Task6" name="Dunning sequence: (a) Day 1: SMS notification — &quot;Your payment didn&#x27;t go…">
        <bpmn:documentation>Step 2: Dunning sequence: (a) Day 1: SMS notification — &quot;Your payment didn&#x27;t go through. Please update your payment method.&quot;, (b) Day 3: email with payment update link, (c) Day 7: customer service call, (d) Day 14: second call + final notice, (e) Day 30: subscription suspended (service visits paused)
Responsible (R): System / Customer Service Rep
Accountable (A): AR Clerk
Duration: Automated + manual calls</bpmn:documentation>
        <bpmn:incoming>W1986_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1986_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1986_Task7" name="Payment recovery: (a) customer updates payment method (online or in-store), (b)…">
        <bpmn:documentation>Step 3: Payment recovery: (a) customer updates payment method (online or in-store), (b) system retries charge, (c) if successful: reactivate subscription, clear overdue status, (d) if customer unresponsive after 60 days: auto-cancel subscription per W1984 (no refund — subscription was partially used)
Responsible (R): AR Clerk / System
Accountable (A): Accounting Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W1986_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1986_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1986_End8" name="Complete">
        <bpmn:incoming>W1986_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1986_Annotation9">
        <bpmn:text>Controls: - CTL-192 (ensure subscription billing &amp; dunning integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
