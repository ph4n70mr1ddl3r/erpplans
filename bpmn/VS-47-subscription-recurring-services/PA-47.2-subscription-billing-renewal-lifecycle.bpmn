    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1988_diag">
      <bpmndi:BPMNPlane id="W1988_plane" bpmnElement="W_W1988">
        <bpmndi:BPMNShape id="W1988_Lane1_di" bpmnElement="W1988_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1988_Lane2_di" bpmnElement="W1988_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
