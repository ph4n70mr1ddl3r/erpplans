    <bpmn:process id="W_W1989" name="W1989. Subscription Customer Communication &amp; Notification Management" isExecutable="false">
      <bpmn:documentation>Trigger: Various subscription lifecycle events
Frequency: Continuous
Volume: ~5,000–10,000 subscribers receiving communications
Owner: CMO
Participants: CMO, System, Customer Service Rep
Source: workflow W1989 — Subscription Customer Communication &amp; Notification Management</bpmn:documentation>
      <bpmn:laneSet id="W1989_LaneSet3">
        <bpmn:lane id="W1989_Lane1" name="System">
        <bpmn:flowNodeRef>W1989_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1989_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1989_Lane2" name="CMO">
        <bpmn:flowNodeRef>W1989_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1989_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1989_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1989_Start4" name="Various subscription lifecycle events">
        <bpmn:outgoing>W1989_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1989_Task5" name="System sends automated communications at lifecycle events: (a) enrollment…">
        <bpmn:documentation>Step 1: System sends automated communications at lifecycle events: (a) enrollment confirmation with welcome guide, (b) service visit reminder: 48 hours and 2 hours before scheduled visit, (c) service completion confirmation with satisfaction survey, (d) renewal notice: 30/14/7 days before expiry, (e) payment confirmation (or failure notice), (f) subscription anniversary: thank you + loyalty points bonus
Responsible (R): System
Accountable (A): CMO
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1989_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1989_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1989_Task6" name="CMO designs communication templates: (a) consistent BuildRight branding, (b)…">
        <bpmn:documentation>Step 2: CMO designs communication templates: (a) consistent BuildRight branding, (b) SMS: concise (160 char), actionable, (c) email: branded template with service details and self-service links, (d) app push notification: quick-action buttons, (e) all communications comply with RA 10173 (consent-based)
Responsible (R): CMO
Accountable (A): COO
Duration: Per template design</bpmn:documentation>
        <bpmn:incoming>W1989_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1989_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1989_Task7" name="Quarterly: CMO reviews communication effectiveness: (a) open rate, click rate…">
        <bpmn:documentation>Step 3: Quarterly: CMO reviews communication effectiveness: (a) open rate, click rate, action rate per communication type, (b) A/B test subject lines and timing, (c) adjust communication frequency: reduce if opt-out rate &gt; 2%/month
Responsible (R): CMO
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1989_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1989_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1989_End8" name="Complete">
        <bpmn:incoming>W1989_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1989_Annotation9">
        <bpmn:text>Controls: - CTL-383 (ensure controlled execution — Subscription Billing, Renewal &amp; Lifecycle (PA-47.2).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1989_Assoc10" sourceRef="W1989_Annotation9" targetRef="W1989_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1989_Flow11" sourceRef="W1989_Start4" targetRef="W1989_Task5" />
      <bpmn:sequenceFlow id="W1989_Flow12" sourceRef="W1989_Task5" targetRef="W1989_Task6" />
      <bpmn:sequenceFlow id="W1989_Flow13" sourceRef="W1989_Task6" targetRef="W1989_Task7" />
      <bpmn:sequenceFlow id="W1989_Flow14" sourceRef="W1989_Task7" targetRef="W1989_End8" />
    </bpmn:process>
