    <bpmn:process id="W_W1988" name="W1988. Subscription Gift &amp; Transfer Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchases subscription as gift; customer moves and transfers service
Frequency: ~20–50 gift/transfer requests/month
Volume: Gift purchases: ~5% of enrollment; Transfers: ~2%
Owner: Customer Service Rep
Participants: Customer Service Rep, AR Clerk, Customer
Source: workflow W1988 — Subscription Gift &amp; Transfer Processing</bpmn:documentation>
      <bpmn:laneSet id="W1988_LaneSet3">
        <bpmn:lane id="W1988_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1988_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1988_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1988_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1988_Lane2" name="AR Clerk">
        <bpmn:flowNodeRef>W1988_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1988_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1988_Start4" name="Customer purchases subscription as gift; customer moves and transfers service">
        <bpmn:outgoing>W1988_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1988_Task5" name="Gift subscription purchase: (a) customer purchases subscription at POS or…">
        <bpmn:documentation>Step 1: Gift subscription purchase: (a) customer purchases subscription at POS or online as gift, (b) recipient details collected: name, address, phone, email, (c) gift notification sent to recipient with activation instructions, (d) recipient activates by confirming address and scheduling first visit
Responsible (R): Customer Service Rep / System
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1988_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1988_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1988_Task6" name="Subscription transfer (customer moving): (a) customer requests transfer to new…">
        <bpmn:documentation>Step 2: Subscription transfer (customer moving): (a) customer requests transfer to new address, (b) system validates new address against service territory, (c) if covered: update service address and assign new service partner, (d) if not covered: offer cancellation with pro-rata refund or pause until coverage expands
Responsible (R): Customer Service Rep
Accountable (A): VP Store Operations
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W1988_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1988_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1988_Task7" name="Financial processing: (a) no fee for gift activation or address transfer, (b)…">
        <bpmn:documentation>Step 3: Financial processing: (a) no fee for gift activation or address transfer, (b) service territory change may affect partner cost: internal cost reallocation, no customer price change
Responsible (R): AR Clerk
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1988_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1988_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1988_End8" name="Complete">
        <bpmn:incoming>W1988_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1988_Annotation9">
        <bpmn:text>Controls: - CTL-383 (ensure controlled execution — Subscription Billing, Renewal &amp; Lifecycle (PA-47.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
