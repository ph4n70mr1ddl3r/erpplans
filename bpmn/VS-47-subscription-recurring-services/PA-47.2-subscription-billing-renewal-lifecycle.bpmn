    <bpmn:process id="W_W1987" name="W1987. Subscription Pause &amp; Reactivation Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests temporary pause (moving, travel, financial difficulty)
Frequency: ~20–50 pause requests/month
Volume: ~5–10% of subscribers may pause per year
Owner: Customer Service Rep
Participants: Customer Service Rep, AR Clerk, Customer
Source: workflow W1987 — Subscription Pause &amp; Reactivation Processing</bpmn:documentation>
      <bpmn:laneSet id="W1987_LaneSet3">
        <bpmn:lane id="W1987_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W1987_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1987_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1987_Lane2" name="System">
        <bpmn:flowNodeRef>W1987_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1987_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1987_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1987_Start4" name="Customer requests temporary pause (moving, travel, financial difficulty)">
        <bpmn:outgoing>W1987_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1987_Task5" name="Customer requests pause: (a) reason: travel, renovation, temporary move…">
        <bpmn:documentation>Step 1: Customer requests pause: (a) reason: travel, renovation, temporary move, financial difficulty, (b) pause duration: 1–6 months maximum, (c) Customer Service Rep verifies subscription is in good standing
Responsible (R): Customer Service Rep
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1987_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1987_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1987_Task6" name="System processes pause: (a) pause start date and end date recorded, (b) monthly…">
        <bpmn:documentation>Step 2: System processes pause: (a) pause start date and end date recorded, (b) monthly billing suspended during pause period, (c) annual subscription: pause extends subscription expiry by pause duration, (d) service visits cancelled during pause, (e) customer notified of pause confirmation with reactivation date
Responsible (R): System
Accountable (A): AR Clerk
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1987_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1987_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1987_Task7" name="Reactivation: (a) system sends reactivation reminder 7 days before pause end…">
        <bpmn:documentation>Step 3: Reactivation: (a) system sends reactivation reminder 7 days before pause end date, (b) customer confirms reactivation (or requests extension), (c) billing resumes, (d) next service visit scheduled, (e) if customer does not respond: auto-reactivate after 14 days grace period
Responsible (R): System / Customer Service Rep
Accountable (A): AR Clerk
Duration: Automated + 10 min manual</bpmn:documentation>
        <bpmn:incoming>W1987_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1987_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1987_End8" name="Complete">
        <bpmn:incoming>W1987_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1987_Annotation9">
        <bpmn:text>Controls: - CTL-383 (ensure controlled execution — Subscription Billing, Renewal &amp; Lifecycle (PA-47.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
