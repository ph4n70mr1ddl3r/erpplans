        <bpmndi:BPMNShape id="W1473_Task9_di" bpmnElement="W1473_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1473_Task10_di" bpmnElement="W1473_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1473_Start5_di" bpmnElement="W1473_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1473_End11_di" bpmnElement="W1473_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1473_Annotation12_di" bpmnElement="W1473_Annotation12"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1473_Flow14_di" bpmnElement="W1473_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Flow15_di" bpmnElement="W1473_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Flow16_di" bpmnElement="W1473_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Flow17_di" bpmnElement="W1473_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Flow18_di" bpmnElement="W1473_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Flow19_di" bpmnElement="W1473_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1473_Assoc13_di" bpmnElement="W1473_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1474" name="W1474. Surplus Cash Investment Portfolio Review, Counterparty Risk Assessment &amp; Yield Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly investment review; or significant cash surplus identified in cash forecast per W76; or counterparty credit event
Frequency: Monthly portfolio review; quarterly counterparty risk assessment; ad-hoc for cash surplus or market events
Volume: Average surplus cash of PHP 500M–1B available for short-term investment; ~5–8 active investment placements at any time
Owner: Treasury Manager
Participants: Treasury Analyst, CFO, Bank Relationship Manager, Controller, Investment Committee (CFO + Controller + Treasury Manager)
Source: workflow W1474 — Surplus Cash Investment Portfolio Review, Counterparty Risk Assessment &amp; Yield Optimization</bpmn:documentation>
      <bpmn:laneSet id="W1474_LaneSet3">
        <bpmn:lane id="W1474_Lane1" name="Treasury Analyst">
        <bpmn:flowNodeRef>W1474_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1474_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W1474_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1474_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1474_Start4" name="Monthly investment review; or significant cash surplus identified in cash forecast per…">
        <bpmn:outgoing>W1474_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1474_Task5" name="Monthly portfolio review">
        <bpmn:documentation>Step 1: Monthly portfolio review: (a) Treasury Analyst compiles investment portfolio summary: (i) all active placements — instrument type, bank/issuer, principal amount, interest rate, maturity date, days to maturity; (ii) portfolio yield vs. benchmark (91-day T-bill rate or PHP SONIA); (iii) laddering profile — maturities distributed to ensure liquidity windows; (iv) PDIC coverage analysis — ensure no single bank holds deposits exceeding practical insurance recovery threshold; (b) Treasury Manager reviews: is the portfolio appropriately positioned given current cash forecast per W76 and upcoming disbursement needs?
Responsible (R): Treasury Analyst / Treasury Manager
Accountable (A): CFO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1474_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1474_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1474_Task6" name="Surplus cash investment decision">
        <bpmn:documentation>Step 2: Surplus cash investment decision: When cash forecast per W76 shows &gt; PHP 200M surplus for &gt; 30 days: (a) Treasury Manager proposes investment placement: (i) amount, (ii) instrument (time deposit 30/60/90 days, money market fund, T-bill), (iii) bank/issuer selection, (iv) target yield; (b) Investment Committee (CFO + Controller + Treasury Manager) approves placement: (i) verify counterparty risk acceptable per step 3, (ii) verify maturity aligns with forecasted cash needs, (iii) verify diversification limits not breached; (c) Treasury Analyst executes placement with approved bank
Responsible (R): Treasury Manager / Investment Committee
Accountable (A): CFO
Duration: 1 hour/decision</bpmn:documentation>
        <bpmn:incoming>W1474_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1474_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1474_Task7" name="Counterparty risk assessment">
        <bpmn:documentation>Step 3: Counterparty risk assessment: (a) quarterly: Treasury Analyst evaluates bank counterparties: (i) CAMELS rating (if available from BSP), (ii) capital adequacy ratio, (iii) non-performing loan ratio, (iv) credit rating from Philippine rating agencies (PhilRatings, CRIF), (v) PDIC membership status, (vi) any regulatory actions or negative news; (b) assign internal risk rating: Green (no concerns), Yellow (monitor — reduce exposure), Red (exit — withdraw funds at maturity); (c) maintain counterparty diversification limits: no single bank &gt; 30% of total investment portfolio, minimum 3 active banking counterparties; (d) for government securities: BSP-registered PD participants only
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1474_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1474_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1474_Task8" name="Maturity &amp; rollover management">
        <bpmn:documentation>Step 4: Maturity &amp; rollover management: (a) system alerts Treasury Analyst 5 days before each investment maturity; (b) Treasury Analyst assesses: (i) does BuildRight need the cash at maturity? If yes: let placement mature, funds returned to operating account; (ii) can BuildRight afford to reinvest? If yes: negotiate rollover rate with bank based on current market rates and counterparty approval per step 3; (c) document rollover decision with yield comparison vs. alternative placements
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: 30 min/maturity</bpmn:documentation>
        <bpmn:incoming>W1474_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1474_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1474_Task9" name="Yield optimization &amp; benchmarking">
        <bpmn:documentation>Step 5: Yield optimization &amp; benchmarking: (a) quarterly: Treasury Manager benchmarks BuildRight&#x27;s portfolio yield against: (i) BSP policy rate, (ii) 91-day T-bill average, (iii) peer company treasury yields (if available from industry surveys); (b) identify opportunities: (i) extend maturity ladder if yield curve is steep (lock in higher rates), (ii) shorten maturity if rate increases expected (maintain flexibility), (iii) diversify into higher-yielding instruments (commercial papers, corporate bonds) within approved risk limits; (c) Investment Committee reviews and approves any changes to investment strategy or counterparty limits
Responsible (R): Treasury Manager
Accountable (A): CFO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1474_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1474_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1474_Task10" name="Investment accounting &amp; reporting">
        <bpmn:documentation>Step 6: Investment accounting &amp; reporting: (a) monthly: Treasury Analyst records interest income accruals in GL per W86; (b) quarterly: Controller verifies investment valuations (amortized cost for held-to-maturity, fair value for trading); (c) annual: External Auditor confirms investment balances and counterparty risk assessment as part of W86 financial audit
Responsible (R): Treasury Analyst / Controller
Accountable (A): CFO
Duration: Per W86</bpmn:documentation>
        <bpmn:incoming>W1474_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1474_End11" name="Complete">
        <bpmn:incoming>W1474_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1474_Annotation12">
        <bpmn:text>Controls: - CTL-295 (ensure controlled execution — FX &amp; Investments (PA-18.3).) | - operational: Treasury Manager review and approval gate
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
