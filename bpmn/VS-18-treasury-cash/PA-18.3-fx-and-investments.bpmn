    <bpmn:process id="W_W1456" name="W1456. Multi-Entity Intercompany FX Settlement &amp; Transfer Pricing Rate Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly intercompany settlement cycle; or IC payable/receivable balance exceeds PHP 10M threshold; or quarterly transfer pricing rate review
Frequency: Monthly settlement; quarterly rate review
Volume: ~PHP 200–400M in monthly intercompany transactions across 5 entities; ~30–50 IC FX settlements/month
Owner: Treasury Analyst
Participants: Treasury Analyst, Finance Controller, Tax Accountant, Intercompany Accountant, CFO
Source: workflow W1456 — Multi-Entity Intercompany FX Settlement &amp; Transfer Pricing Rate Management</bpmn:documentation>
      <bpmn:laneSet id="W1456_LaneSet5">
        <bpmn:lane id="W1456_Lane1" name="System">
        <bpmn:flowNodeRef>W1456_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1456_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1456_Lane2" name="Treasury Analyst">
        <bpmn:flowNodeRef>W1456_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1456_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1456_Lane3" name="Intercompany Accountant">
        <bpmn:flowNodeRef>W1456_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1456_Lane4" name="Tax Accountant">
        <bpmn:flowNodeRef>W1456_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1456_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1456_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1456_Start6" name="Monthly intercompany settlement cycle; or IC payable/receivable balance exceeds PHP 10M…">
        <bpmn:outgoing>W1456_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1456_Task7" name="Monthly IC balance aggregation">
        <bpmn:documentation>Step 1: Monthly IC balance aggregation: System generates monthly IC payable/receivable summary by entity pair; identify USD-denominated portion requiring FX settlement
Responsible (R): System / Intercompany Accountant
Accountable (A): Finance Controller
Duration: Automated + 30 min</bpmn:documentation>
        <bpmn:incoming>W1456_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1456_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1456_Task8" name="Transfer pricing rate application">
        <bpmn:documentation>Step 2: Transfer pricing rate application: Treasury Analyst applies approved rate: BSP spot rate, monthly average, or forward rate per W80; system converts USD IC balances to PHP at approved rate
Responsible (R): Treasury Analyst
Accountable (A): Finance Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1456_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1456_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1456_Task9" name="IC settlement execution">
        <bpmn:documentation>Step 3: IC settlement execution: Treasury initiates inter-entity bank transfer (book entry for same-bank, T+1 for cross-bank); system posts IC settlement entries in both entities&#x27; GLs with IC elimination tags
Responsible (R): Treasury Analyst
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1456_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1456_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1456_Task10" name="Monthly IC FX gain/loss allocation">
        <bpmn:documentation>Step 4: Monthly IC FX gain/loss allocation: System calculates FX gain/loss on each IC settlement; allocates to entity bearing FX risk per Transfer Pricing Policy
Responsible (R): Intercompany Accountant
Accountable (A): Finance Controller
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1456_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1456_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1456_Task11" name="Quarterly transfer pricing rate review">
        <bpmn:documentation>Step 5: Quarterly transfer pricing rate review: Tax Accountant and Finance Controller review IC FX rate methodology quarterly; verify BSP rate vs. actual settlement rates (variance &lt; 1%); document rate methodology per RR 02-2013
Responsible (R): Tax Accountant
Accountable (A): Finance Controller
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1456_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1456_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1456_Task12" name="Annual transfer pricing documentation">
        <bpmn:documentation>Step 6: Annual transfer pricing documentation: Tax Accountant prepares annual TP documentation per RR 02-2013: transaction summary, pricing method, benchmarking analysis, arm&#x27;s-length justification
Responsible (R): Tax Accountant
Accountable (A): VP Legal / CFO
Duration: 20–30 hours/year</bpmn:documentation>
        <bpmn:incoming>W1456_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1456_End13" name="Complete">
        <bpmn:incoming>W1456_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1456_Annotation14">
        <bpmn:text>Controls: - CTL-295 (ensure controlled execution — FX &amp; Investments (PA-18.3).) | - operational: Treasury Analyst review and approval gate
Owner: Treasury Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1456_Assoc15" sourceRef="W1456_Annotation14" targetRef="W1456_Start6" associationDirection="None" />
