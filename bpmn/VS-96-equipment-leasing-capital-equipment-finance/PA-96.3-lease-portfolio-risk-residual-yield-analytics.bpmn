    <bpmn:process id="W_W3180" name="W3180. Lease Yield, IRR &amp; Profitability Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly profitability cycle
Frequency: Monthly/quarterly
Volume: Whole portfolio + per deal
Owner: Lease Portfolio Manager
Participants: Lease Portfolio Mgr, Finance, BI (links to VS-28), Treasury (links to VS-18)
Source: workflow W3180 — Lease Yield, IRR &amp; Profitability Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3180_LaneSet4">
        <bpmn:lane id="W3180_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W3180_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3180_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3180_Lane2" name="Lease Portfolio Mgr">
        <bpmn:flowNodeRef>W3180_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3180_Lane3" name="Finance">
        <bpmn:flowNodeRef>W3180_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3180_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3180_Start5" name="Monthly/quarterly profitability cycle">
        <bpmn:outgoing>W3180_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3180_Task6" name="Finance/BI (links to VS-28) compute portfolio yield: effective interest yield…">
        <bpmn:documentation>Step 1: Finance/BI (links to VS-28) compute portfolio yield: effective interest yield, net interest margin (yield − cost-of-funds), operating cost ratio, credit cost (provisions), residual gain/loss; segment by product/segment/partner
Responsible (R): Finance Analyst / BI
Accountable (A): Lease Portfolio Manager
Duration: Monthly</bpmn:documentation>
