<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-96.3-lease-portfolio-risk-residual-yield-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3177" name="W3177. Lease Portfolio Composition &amp; Concentration Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly portfolio review; ALM cycle
Frequency: Monthly/quarterly
Volume: Whole portfolio
Owner: Lease Portfolio Manager
Participants: Lease Portfolio Mgr, Finance, Risk, BI (links to VS-28), Treasury (links to VS-18)
Source: workflow W3177 — Lease Portfolio Composition &amp; Concentration Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3177_LaneSet4">
        <bpmn:lane id="W3177_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W3177_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3177_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3177_Lane2" name="Lease Portfolio Mgr">
        <bpmn:flowNodeRef>W3177_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3177_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3177_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3177_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3177_Start5" name="Monthly portfolio review; ALM cycle">
        <bpmn:outgoing>W3177_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3177_Task6" name="BI (links to VS-28) compute portfolio composition: outstanding balance, # of…">
        <bpmn:documentation>Step 1: BI (links to VS-28) compute portfolio composition: outstanding balance, # of leases, average ticket, by segment (trade/corporate/government), asset category, geography, tenor, lessor partner (W3165), lease type
Responsible (R): BI Analyst
Accountable (A): Lease Portfolio Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3177_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3177_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3177_Task7" name="Lease Portfolio Mgr/Risk analyze concentration vs. limits: top-customer…">
        <bpmn:documentation>Step 2: Lease Portfolio Mgr/Risk analyze concentration vs. limits: top-customer concentration, single-segment, single-asset-category, single-region; flag breaches and recommend rebalancing (origination tilt, partner diversification)
Responsible (R): Lease Portfolio Mgr / Risk
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3177_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3177_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3177_Task8" name="Finance/Treasury (links to VS-18) report portfolio metrics to ALCO/Finance…">
        <bpmn:documentation>Step 3: Finance/Treasury (links to VS-18) report portfolio metrics to ALCO/Finance Committee (links to VS-36); mature/amortize portfolio projections; align funding to asset profile (W3181)
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3177_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3177_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3177_End9" name="Complete">
        <bpmn:incoming>W3177_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3177_Annotation10">
        <bpmn:text>Controls: - CTL-519 (ensure controlled execution — Lease Portfolio Risk, Residual &amp; Yield Analytics (PA-96.3).) | - operational: limits and diversification
Owner: Lease Portfolio Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3177_Assoc11" sourceRef="W3177_Annotation10" targetRef="W3177_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3177_Flow12" sourceRef="W3177_Start5" targetRef="W3177_Task6" />
      <bpmn:sequenceFlow id="W3177_Flow13" sourceRef="W3177_Task6" targetRef="W3177_Task7" />
      <bpmn:sequenceFlow id="W3177_Flow14" sourceRef="W3177_Task7" targetRef="W3177_Task8" />
      <bpmn:sequenceFlow id="W3177_Flow15" sourceRef="W3177_Task8" targetRef="W3177_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3177_diag">
