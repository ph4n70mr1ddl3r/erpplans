      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3179" name="W3179. Residual Value Realization &amp; Used-Equipment Remarketing" isExecutable="false">
      <bpmn:documentation>Trigger: Asset return (W3175); periodic residual review
Frequency: Per return + quarterly review
Volume: Per returned asset + portfolio
Owner: Lease Portfolio Manager
Participants: Lease Portfolio Mgr, Inventory (links to VS-05), Category (links to VS-01), Quality, Sales (links to VS-11)
Source: workflow W3179 — Residual Value Realization &amp; Used-Equipment Remarketing</bpmn:documentation>
      <bpmn:laneSet id="W3179_LaneSet3">
        <bpmn:lane id="W3179_Lane1" name="Lease Portfolio Mgr">
        <bpmn:flowNodeRef>W3179_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3179_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3179_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3179_Lane2" name="Inventory">
        <bpmn:flowNodeRef>W3179_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3179_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3179_Start4" name="Asset return (W3175); periodic residual review">
        <bpmn:outgoing>W3179_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3179_Task5" name="Lease Portfolio Mgr/Category (links to VS-01) track residual realization…">
        <bpmn:documentation>Step 1: Lease Portfolio Mgr/Category (links to VS-01) track residual realization: returned-asset sale price vs. book residual; analyze by asset category, age, condition; identify over/under-stated residuals
Responsible (R): Lease Portfolio Mgr / Category
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3179_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3179_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3179_Task6" name="Inventory/Sales (links to VS-11) remarket returned assets: certified-pre-owned…">
        <bpmn:documentation>Step 2: Inventory/Sales (links to VS-11) remarket returned assets: certified-pre-owned sale (links to VS-09 W916), auction, dealer wholesale, redeploy to new lease (W3175), refurbish (links to VS-09), or scrap (links to VS-73); maximize recovery
Responsible (R): Inventory / Sales / Quality
Accountable (A): Lease Portfolio Manager
Duration: Per asset</bpmn:documentation>
        <bpmn:incoming>W3179_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3179_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3179_Task7" name="Lease Portfolio Mgr/Risk recalibrate residual curves (W3162) based on actual…">
        <bpmn:documentation>Step 3: Lease Portfolio Mgr/Risk recalibrate residual curves (W3162) based on actual realization; adjust pricing; report residual risk to Finance Committee (links to VS-36)
Responsible (R): Lease Portfolio Mgr / Risk
Accountable (A): CFO
Duration: Quarterly/annual</bpmn:documentation>
        <bpmn:incoming>W3179_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3179_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3179_End8" name="Complete">
        <bpmn:incoming>W3179_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3179_Annotation9">
        <bpmn:text>Controls: - CTL-519 (ensure controlled execution — Lease Portfolio Risk, Residual &amp; Yield Analytics (PA-96.3).) | - operational: conservative residual and diverse remarketing channels
Owner: Lease Portfolio Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3179_Assoc10" sourceRef="W3179_Annotation9" targetRef="W3179_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3179_Flow11" sourceRef="W3179_Start4" targetRef="W3179_Task5" />
      <bpmn:sequenceFlow id="W3179_Flow12" sourceRef="W3179_Task5" targetRef="W3179_Task6" />
      <bpmn:sequenceFlow id="W3179_Flow13" sourceRef="W3179_Task6" targetRef="W3179_Task7" />
      <bpmn:sequenceFlow id="W3179_Flow14" sourceRef="W3179_Task7" targetRef="W3179_End8" />
    </bpmn:process>
