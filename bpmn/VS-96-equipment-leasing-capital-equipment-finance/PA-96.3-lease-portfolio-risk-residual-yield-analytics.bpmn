    <bpmn:process id="W_W3182" name="W3182. Lease Regulatory Compliance (BSP, Truth in Lending, BIR)" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory cycle; new regulation; examination
Frequency: Continuous + per cycle
Volume: Whole portfolio
Owner: Compliance Officer
Participants: Compliance Officer, Legal, Finance, Lease Operations Mgr, External Counsel
Source: workflow W3182 — Lease Regulatory Compliance (BSP, Truth in Lending, BIR)</bpmn:documentation>
      <bpmn:laneSet id="W3182_LaneSet3">
        <bpmn:lane id="W3182_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W3182_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3182_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3182_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3182_Lane2" name="Lease Operations Mgr">
