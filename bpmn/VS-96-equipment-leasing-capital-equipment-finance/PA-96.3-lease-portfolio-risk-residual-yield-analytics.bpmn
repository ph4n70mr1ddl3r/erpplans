        <bpmn:flowNodeRef>W3182_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3182_Start4" name="Regulatory cycle; new regulation; examination">
        <bpmn:outgoing>W3182_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3182_Task5" name="Compliance/Legal map applicable regulations: BSP rules (if BuildRight entity is…">
        <bpmn:documentation>Step 1: Compliance/Legal map applicable regulations: BSP rules (if BuildRight entity is financing-company-registered or partners with BSP-supervised lessor), Truth in Lending Act (RA 3765) disclosure, Consumer Act (RA 7394) for any consumer-adjacent lease, BIR lease-accounting/tax (links to VS-79), SEC reporting for financing companies
Responsible (R): Compliance Officer
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3182_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3182_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3182_Task6" name="Lease Operations implement compliance: Truth-in-Lending disclosure on every…">
        <bpmn:documentation>Step 2: Lease Operations implement compliance: Truth-in-Lending disclosure on every quote (W3164), fair-collection-practices (no harassment — links to VS-84 for collections), data privacy (links to VS-91), anti-money-laundering on lease payments (links to VS-86), books-and-records per BIR
Responsible (R): Lease Operations Mgr / Compliance
Accountable (A): Lease Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3182_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3182_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3182_Task7" name="Compliance respond to regulatory examinations; remediate findings; track…">
        <bpmn:documentation>Step 3: Compliance respond to regulatory examinations; remediate findings; track regulatory-change management (links to VS-22); report to Audit/Compliance Committee (links to VS-36)
Responsible (R): Compliance Officer / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per examination</bpmn:documentation>
        <bpmn:incoming>W3182_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3182_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3182_End8" name="Complete">
        <bpmn:incoming>W3182_Flow14</bpmn:incoming>
      </bpmn:endEvent>
