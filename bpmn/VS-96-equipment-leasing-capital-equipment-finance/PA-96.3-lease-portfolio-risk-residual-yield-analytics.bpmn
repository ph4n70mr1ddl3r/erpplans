    <bpmn:process id="W_W3183" name="W3183. Lease Tax, VAT &amp; Withholding Treatment" isExecutable="false">
      <bpmn:documentation>Trigger: Billing cycle (W3170); tax filing; BIR inquiry
Frequency: Per transaction + monthly/quarterly filing
Volume: All lease transactions
Owner: Tax Manager
Participants: Tax Mgr, Finance, Lease Operations Mgr, External Tax Counsel
Source: workflow W3183 — Lease Tax, VAT &amp; Withholding Treatment</bpmn:documentation>
      <bpmn:laneSet id="W3183_LaneSet3">
        <bpmn:lane id="W3183_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W3183_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3183_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3183_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3183_Lane2" name="System">
        <bpmn:flowNodeRef>W3183_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3183_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3183_Start4" name="Billing cycle (W3170); tax filing; BIR inquiry">
        <bpmn:outgoing>W3183_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3183_Task5" name="Tax Mgr structure lease taxation per lease type and BIR rules: operating lease…">
        <bpmn:documentation>Step 1: Tax Mgr structure lease taxation per lease type and BIR rules: operating lease rentals = VATable lease income; finance lease = separate treatment of principal/interest; creditable withholding tax (EWT/CWT) on rental payments by customer; document tax positions (links to VS-79)
Responsible (R): Tax Manager
Accountable (A): Tax Manager
Duration: Setup + ongoing</bpmn:documentation>
        <bpmn:incoming>W3183_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3183_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3183_Task6" name="System compute per-invoice: VAT (12%) on lease rental, EWT (5% on lease rentals…">
        <bpmn:documentation>Step 2: System compute per-invoice: VAT (12%) on lease rental, EWT (5% on lease rentals per RR 2-98, withheld by the customer-lessee), any percentage tax; generate BIR-compliant invoice and Form 2307 for customer withholding (links to VS-79)
Responsible (R): System / Finance
Accountable (A): Tax Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3183_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3183_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3183_Task7" name="Tax Mgr remit VAT/EWT to BIR (links to VS-79); reconcile creditable withholding…">
        <bpmn:documentation>Step 3: Tax Mgr remit VAT/EWT to BIR (links to VS-79); reconcile creditable withholding credits; file income tax on lease profit; defend on BIR audit (links to VS-21); issue annual tax documents to customers
Responsible (R): Tax Manager / Finance
Accountable (A): Tax Manager
Duration: Monthly/quarterly/annual</bpmn:documentation>
        <bpmn:incoming>W3183_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3183_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3183_End8" name="Complete">
        <bpmn:incoming>W3183_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3183_Annotation9">
        <bpmn:text>Controls: - CTL-519 (ensure controlled execution — Lease Portfolio Risk, Residual &amp; Yield Analytics (PA-96.3).) | - operational: structured tax design and external counsel review
Owner: Tax Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3183_Assoc10" sourceRef="W3183_Annotation9" targetRef="W3183_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3183_Flow11" sourceRef="W3183_Start4" targetRef="W3183_Task5" />
