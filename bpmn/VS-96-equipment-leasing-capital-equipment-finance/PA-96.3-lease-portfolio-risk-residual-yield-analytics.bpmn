    <bpmn:process id="W_W3178" name="W3178. Lease Credit Risk, Scoring &amp; Provisioning" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly risk cycle; delinquency migration; ECL re-measurement
Frequency: Monthly + event-driven
Volume: Whole portfolio
Owner: Lease Credit Manager
Participants: Lease Credit Mgr, Risk, Finance, Internal Audit (links to VS-21)
Source: workflow W3178 — Lease Credit Risk, Scoring &amp; Provisioning</bpmn:documentation>
      <bpmn:laneSet id="W3178_LaneSet4">
        <bpmn:lane id="W3178_Lane1" name="Risk Analyst">
        <bpmn:flowNodeRef>W3178_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3178_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3178_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3178_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3178_Lane3" name="Internal Audit">
        <bpmn:flowNodeRef>W3178_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3178_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3178_Start5" name="Monthly risk cycle; delinquency migration; ECL re-measurement">
        <bpmn:outgoing>W3178_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3178_Task6" name="Lease Credit Mgr/Risk monitor portfolio credit quality: delinquency buckets…">
        <bpmn:documentation>Step 1: Lease Credit Mgr/Risk monitor portfolio credit quality: delinquency buckets (30/60/90+), default rate, cure rate, migration by internal rating; refresh scoring model performance vs. actuals
Responsible (R): Risk Analyst / Lease Credit Mgr
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3178_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3178_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3178_Task7" name="Finance compute Expected Credit Loss (ECL) per PFRS 9 / PAS 39 (links to…">
        <bpmn:documentation>Step 2: Finance compute Expected Credit Loss (ECL) per PFRS 9 / PAS 39 (links to VS-17): PD × LGD × EAD by bucket; post provision; report movement to Finance Committee (links to VS-36)
Responsible (R): Finance Analyst
Accountable (A): Controller
Duration: Monthly/quarterly</bpmn:documentation>
        <bpmn:incoming>W3178_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3178_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3178_Task8" name="Internal Audit (links to VS-21) periodically audit credit process: underwriting…">
        <bpmn:documentation>Step 3: Internal Audit (links to VS-21) periodically audit credit process: underwriting quality, scoring accuracy, provisioning methodology, collection effectiveness; findings to audit committee
Responsible (R): Internal Audit
Accountable (A): Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3178_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3178_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3178_End9" name="Complete">
        <bpmn:incoming>W3178_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3178_Annotation10">
        <bpmn:text>Controls: - CTL-105 (prevent unauthorized lease credit extension.) | - operational: back-testing and periodic model validation
Owner: Lease Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3178_Assoc11" sourceRef="W3178_Annotation10" targetRef="W3178_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3178_Flow12" sourceRef="W3178_Start5" targetRef="W3178_Task6" />
      <bpmn:sequenceFlow id="W3178_Flow13" sourceRef="W3178_Task6" targetRef="W3178_Task7" />
      <bpmn:sequenceFlow id="W3178_Flow14" sourceRef="W3178_Task7" targetRef="W3178_Task8" />
      <bpmn:sequenceFlow id="W3178_Flow15" sourceRef="W3178_Task8" targetRef="W3178_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3178_diag">
      <bpmndi:BPMNPlane id="W3178_plane" bpmnElement="W_W3178">
        <bpmndi:BPMNShape id="W3178_Lane1_di" bpmnElement="W3178_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3178_Lane2_di" bpmnElement="W3178_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
