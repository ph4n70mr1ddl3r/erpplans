      <bpmndi:BPMNPlane id="W3179_plane" bpmnElement="W_W3179">
        <bpmndi:BPMNShape id="W3179_Lane1_di" bpmnElement="W3179_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3179_Lane2_di" bpmnElement="W3179_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3179_Task5_di" bpmnElement="W3179_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
