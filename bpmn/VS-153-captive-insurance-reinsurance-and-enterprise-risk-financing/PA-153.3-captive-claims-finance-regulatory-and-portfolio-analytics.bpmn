    <bpmn:process id="W_W4545" name="W4545. Captive Claims Administration &amp; TPA Management" isExecutable="false">
      <bpmn:documentation>Trigger: Claim event (VS-26.3); TPA cycle
Frequency: Per claim + ongoing
Volume: Claims across in-scope captive programs (property/cat, liability, fleet, cyber)
Owner: Insurance (VS-26.3) / Risk / TPA (W4534)
Participants: Legal (VS-100.3), Finance (VS-17), Claimants, Fronting carrier
Source: workflow W4545 — Captive Claims Administration &amp; TPA Management</bpmn:documentation>
      <bpmn:laneSet id="W4545_LaneSet4">
        <bpmn:lane id="W4545_Lane1" name="TPA">
        <bpmn:flowNodeRef>W4545_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4545_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4545_Lane2" name="Risk">
        <bpmn:flowNodeRef>W4545_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4545_Lane3" name="Finance">
        <bpmn:flowNodeRef>W4545_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4545_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4545_Start5" name="Claim event (VS-26.3); TPA cycle">
        <bpmn:outgoing>W4545_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4545_Task6" name="TPA/Insurance administer captive claims (FNOL, investigation, adjustment…">
        <bpmn:documentation>Step 1: TPA/Insurance administer captive claims (FNOL, investigation, adjustment, settlement) per the commercial claims process (VS-26.3), routing captive-layer claims to the captive
Responsible (R): TPA / Insurance
Accountable (A): Head of Internal Audit &amp; Risk / Insurance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4545_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4545_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4545_Task7" name="Risk/Legal manage large/complex captive claims (cat, liability litigation…">
        <bpmn:documentation>Step 2: Risk/Legal manage large/complex captive claims (cat, liability litigation VS-100, cyber VS-27.3), and approve settlements within authority
Responsible (R): Risk / Legal
Accountable (A): Head of Internal Audit &amp; Risk / Captive Board
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4545_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4545_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4545_Task8" name="Finance/TPA pay claims from captive funds, record loss data (W4551), update…">
        <bpmn:documentation>Step 3: Finance/TPA pay claims from captive funds, record loss data (W4551), update reserves (W4542), and trigger reinsurance recovery (W4546) above retention
Responsible (R): Finance / TPA / Actuarial
Accountable (A): CFO / Head of Internal Audit &amp; Risk
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4545_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4545_End9" name="Complete">
        <bpmn:incoming>W4545_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4545_Annotation10">
        <bpmn:text>Controls: - CTL-691 (ensure controlled execution — Captive Claims, Finance, Regulatory &amp; Portfolio Analytics (PA-153.3).) | - CTL-691: claims handled per VS-26.3 standard; TPA SLA-monitored (W4534); settlements within authority; reserves updated (W4542)
Owner: Insurance (VS-26.3) / Risk / TPA (W4534)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4545_Assoc11" sourceRef="W4545_Annotation10" targetRef="W4545_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4545_Flow12" sourceRef="W4545_Start5" targetRef="W4545_Task6" />
      <bpmn:sequenceFlow id="W4545_Flow13" sourceRef="W4545_Task6" targetRef="W4545_Task7" />
      <bpmn:sequenceFlow id="W4545_Flow14" sourceRef="W4545_Task7" targetRef="W4545_Task8" />
      <bpmn:sequenceFlow id="W4545_Flow15" sourceRef="W4545_Task8" targetRef="W4545_End9" />
    </bpmn:process>
