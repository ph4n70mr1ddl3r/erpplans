    <bpmn:process id="W_W4546" name="W4546. Captive Reinsurance Recovery &amp; Collections" isExecutable="false">
      <bpmn:documentation>Trigger: Loss above retention (W4545); treaty bound (W4540)
Frequency: Per recoverable event + ongoing
Volume: Reinsurance recoveries/collectibles across treaties
Owner: Risk / Treasury (VS-18) / Finance (VS-17)
Participants: Broker, Reinsurers, Actuarial, Captive Board
Source: workflow W4546 — Captive Reinsurance Recovery &amp; Collections</bpmn:documentation>
      <bpmn:laneSet id="W4546_LaneSet4">
        <bpmn:lane id="W4546_Lane1" name="Risk">
        <bpmn:flowNodeRef>W4546_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4546_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4546_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W4546_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4546_Lane3" name="Actuarial">
        <bpmn:flowNodeRef>W4546_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4546_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4546_Start5" name="Loss above retention (W4545); treaty bound (W4540)">
        <bpmn:outgoing>W4546_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4546_Task6" name="Risk/Broker report losses/bordereaux to reinsurers per treaty (W4540), and…">
        <bpmn:documentation>Step 1: Risk/Broker report losses/bordereaux to reinsurers per treaty (W4540), and submit reinsurance recovery claims above the captive retention
Responsible (R): Risk / Broker
Accountable (A): Head of Internal Audit &amp; Risk
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4546_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4546_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4546_Task7" name="Treasury/Finance collect reinsurance recoveries from reinsurers, reconcile to…">
        <bpmn:documentation>Step 2: Treasury/Finance collect reinsurance recoveries from reinsurers, reconcile to submissions, and pursue overdue/aged balances
Responsible (R): Treasury / Finance
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4546_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4546_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4546_Task8" name="Actuarial/Risk monitor reinsurance recoverable on the balance sheet, assess…">
        <bpmn:documentation>Step 3: Actuarial/Risk monitor reinsurance recoverable on the balance sheet, assess reinsurer default risk, and report collection health to the captive board
Responsible (R): Actuarial / Risk / Treasury
Accountable (A): Head of Internal Audit &amp; Risk / Captive Board
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4546_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4546_End9" name="Complete">
        <bpmn:incoming>W4546_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4546_Annotation10">
        <bpmn:text>Controls: - CTL-691 (ensure controlled execution — Captive Claims, Finance, Regulatory &amp; Portfolio Analytics (PA-153.3).) | - CTL-691: recoveries submitted per treaty (W4540); reinsurers security-monitored; collectibles reconciled &amp; aged
Owner: Risk / Treasury (VS-18) / Finance (VS-17)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4546_Assoc11" sourceRef="W4546_Annotation10" targetRef="W4546_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4546_Flow12" sourceRef="W4546_Start5" targetRef="W4546_Task6" />
      <bpmn:sequenceFlow id="W4546_Flow13" sourceRef="W4546_Task6" targetRef="W4546_Task7" />
