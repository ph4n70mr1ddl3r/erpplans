    <bpmn:process id="W_W4536" name="W4536. Captive Implementation, Transition &amp; Go-Live Readiness" isExecutable="false">
      <bpmn:documentation>Trigger: Formation complete (W4532); go-live plan
Frequency: Per implementation
Volume: One captive implementation/go-live
Owner: Risk / Treasury (VS-18) / Project mgmt (VS-112)
Participants: Insurance (VS-26), IT (VS-27), Finance (VS-17), OCM (VS-134)
Source: workflow W4536 — Captive Implementation, Transition &amp; Go-Live Readiness</bpmn:documentation>
      <bpmn:laneSet id="W4536_LaneSet3">
        <bpmn:lane id="W4536_Lane1" name="Risk">
