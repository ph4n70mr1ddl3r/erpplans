    <bpmn:process id="W_W4529" name="W4529. Total-Cost-of-Risk Baseline &amp; Captive Feasibility/Business Case" isExecutable="false">
      <bpmn:documentation>Trigger: Risk-financing review (VS-21.2); premium spike; board mandate
Frequency: Feasibility cycle + periodic refresh
Volume: One enterprise total-cost-of-risk (TCOR) baseline
Owner: Risk (VS-21.2) / Treasury (VS-18) / CFO
Participants: Insurance (VS-26), Finance (VS-17.4), Actuarial advisor, Brokers
Source: workflow W4529 — Total-Cost-of-Risk Baseline &amp; Captive Feasibility/Business Case</bpmn:documentation>
      <bpmn:laneSet id="W4529_LaneSet3">
        <bpmn:lane id="W4529_Lane1" name="Risk">
        <bpmn:flowNodeRef>W4529_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4529_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4529_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4529_Lane2" name="CFO">
        <bpmn:flowNodeRef>W4529_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4529_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4529_Start4" name="Risk-financing review (VS-21.2); premium spike; board mandate">
        <bpmn:outgoing>W4529_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4529_Task5" name="Risk/Insurance quantify the TCOR baseline (commercial premium + retained losses…">
        <bpmn:documentation>Step 1: Risk/Insurance quantify the TCOR baseline (commercial premium + retained losses + risk-mgmt cost + admin) across property/cat, liability, fleet, crime, cyber, D&amp;O, employee — per VS-26/VS-21.2
Responsible (R): Risk / Insurance / Finance
Accountable (A): Head of Internal Audit &amp; Risk / CFO
Duration: Feasibility cycle</bpmn:documentation>
        <bpmn:incoming>W4529_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4529_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4529_Task6" name="Risk/Treasury/Actuarial model the captive business case (loss-history analysis…">
        <bpmn:documentation>Step 2: Risk/Treasury/Actuarial model the captive business case (loss-history analysis, predicted retained-layer loss, reinsurance cost, capital required, savings vs commercial) with sensitivity
Responsible (R): Risk / Treasury / Actuarial
Accountable (A): Head of Internal Audit &amp; Risk / CFO
Duration: Feasibility cycle</bpmn:documentation>
        <bpmn:incoming>W4529_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4529_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4529_Task7" name="CFO/Head of Internal Audit &amp; Risk present the business case to the board…">
        <bpmn:documentation>Step 3: CFO/Head of Internal Audit &amp; Risk present the business case to the board (VS-36), obtain go/no-go, and define success metrics vs the do-nothing baseline
Responsible (R): CFO / Head of Internal Audit &amp; Risk
Accountable (A): Board
Duration: Per decision</bpmn:documentation>
        <bpmn:incoming>W4529_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4529_End8" name="Complete">
        <bpmn:incoming>W4529_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4529_Annotation9">
        <bpmn:text>Controls: - CTL-112 (ensure captive risk-transfer adequacy.) | - CTL-689: TCOR actuarially baselined (VS-21.2); business case conservative/board-approved (VS-36); success metrics defined
Owner: Risk (VS-21.2) / Treasury (VS-18) / CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4529_Assoc10" sourceRef="W4529_Annotation9" targetRef="W4529_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4529_Flow11" sourceRef="W4529_Start4" targetRef="W4529_Task5" />
      <bpmn:sequenceFlow id="W4529_Flow12" sourceRef="W4529_Task5" targetRef="W4529_Task6" />
      <bpmn:sequenceFlow id="W4529_Flow13" sourceRef="W4529_Task6" targetRef="W4529_Task7" />
      <bpmn:sequenceFlow id="W4529_Flow14" sourceRef="W4529_Task7" targetRef="W4529_End8" />
    </bpmn:process>
