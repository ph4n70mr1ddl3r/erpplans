      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4531" name="W4531. Domicile Selection, Licensing &amp; Regulatory Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Structure decision (W4530); formation
Frequency: Per formation + ongoing compliance
Volume: One domicile/license decision
Owner: Risk / Legal (VS-100.3) / Treasury
Participants: Tax (VS-79), Compliance (VS-22), Captive manager, Domiciliary regulator
Source: workflow W4531 — Domicile Selection, Licensing &amp; Regulatory Setup</bpmn:documentation>
      <bpmn:laneSet id="W4531_LaneSet4">
        <bpmn:lane id="W4531_Lane1" name="Risk">
        <bpmn:flowNodeRef>W4531_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4531_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4531_Lane2" name="Legal">
        <bpmn:flowNodeRef>W4531_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4531_Lane3" name="Compliance">
        <bpmn:flowNodeRef>W4531_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4531_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4531_Start5" name="Structure decision (W4530); formation">
        <bpmn:outgoing>W4531_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4531_Task6" name="Risk/Legal/Tax evaluate domicile options (onshore IC-Philippine vs offshore…">
        <bpmn:documentation>Step 1: Risk/Legal/Tax evaluate domicile options (onshore IC-Philippine vs offshore Labuan/Bermuda/Cayman/Singapore etc.) on capital requirements, regulation, tax, cost, reputation, and PH-group fit
Responsible (R): Risk / Legal / Tax / Captive Manager
Accountable (A): Head of Internal Audit &amp; Risk / CFO / VP Legal
Duration: Per formation</bpmn:documentation>
        <bpmn:incoming>W4531_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4531_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4531_Task7" name="Legal/Captive Manager apply for domicile licensing (business plan, capital…">
        <bpmn:documentation>Step 2: Legal/Captive Manager apply for domicile licensing (business plan, capital, governance, actuarial, fit-and-proper), and establish the regulatory relationship
Responsible (R): Legal / Captive Manager
Accountable (A): VP Legal / Board
Duration: Per formation</bpmn:documentation>
        <bpmn:incoming>W4531_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4531_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4531_Task8" name="Compliance/Tax set up ongoing regulatory compliance (domiciliary filings…">
        <bpmn:documentation>Step 3: Compliance/Tax set up ongoing regulatory compliance (domiciliary filings, RBC/capital-adequacy, tax), integrated to VS-22/VS-79
Responsible (R): Compliance / Tax / Legal
Accountable (A): VP Legal / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4531_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4531_End9" name="Complete">
        <bpmn:incoming>W4531_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4531_Annotation10">
        <bpmn:text>Controls: - CTL-112 (ensure captive risk-transfer adequacy.) | - CTL-689: domicile structured-evaluated; license obtained pre-underwriting; ongoing compliance integrated (VS-22/VS-79)
Owner: Risk / Legal (VS-100.3) / Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4531_Assoc11" sourceRef="W4531_Annotation10" targetRef="W4531_Start5" associationDirection="None" />
