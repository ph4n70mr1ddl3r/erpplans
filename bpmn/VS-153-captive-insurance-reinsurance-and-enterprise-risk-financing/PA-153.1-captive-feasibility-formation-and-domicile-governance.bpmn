        <bpmn:flowNodeRef>W4536_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4536_Start4" name="Formation complete (W4532); go-live plan">
        <bpmn:outgoing>W4536_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4536_Task5" name="Risk/Treasury/PMO build the implementation plan (policy issuance via fronting…">
        <bpmn:documentation>Step 1: Risk/Treasury/PMO build the implementation plan (policy issuance via fronting, captive ceding, claims handoff, accounting, reporting), per VS-112 project governance
Responsible (R): Risk / Treasury / PMO
Accountable (A): Head of Internal Audit &amp; Risk / CFO
Duration: Per implementation</bpmn:documentation>
        <bpmn:incoming>W4536_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4536_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4536_Task6" name="IT/Finance stand up captive systems (policy/claims admin, accounting, reporting…">
        <bpmn:documentation>Step 2: IT/Finance stand up captive systems (policy/claims admin, accounting, reporting integrations to VS-17/VS-27), with OCM/change enablement (VS-134) for affected teams
Responsible (R): IT / Finance / OCM
Accountable (A): CIO / CFO
Duration: Per implementation</bpmn:documentation>
        <bpmn:incoming>W4536_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4536_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4536_Task7" name="Risk/Insurance execute the transition (move in-scope risks from commercial to…">
        <bpmn:documentation>Step 3: Risk/Insurance execute the transition (move in-scope risks from commercial to captive at renewal VS-26), verify go-live readiness, and cut over
Responsible (R): Risk / Insurance
Accountable (A): Head of Internal Audit &amp; Risk / CFO
Duration: Per go-live</bpmn:documentation>
        <bpmn:incoming>W4536_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4536_End8" name="Complete">
        <bpmn:incoming>W4536_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4536_Annotation9">
        <bpmn:text>Controls: - CTL-689 (ensure controlled execution — Captive Feasibility, Formation &amp; Domicile/Governance (PA-153.1).) | - CTL-689: implementation PMO-governed (VS-112); systems ready pre-cutover; coverage continuity at transition (VS-26)
Owner: Risk / Treasury (VS-18) / Project mgmt (VS-112)</bpmn:text>
      </bpmn:textAnnotation>
