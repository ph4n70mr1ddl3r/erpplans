    <bpmn:process id="W_W2988" name="W2988. NPC Data Privacy Audit &amp; Records Production" isExecutable="false">
      <bpmn:documentation>Trigger: NPC complaint, investigation, or compliance check
Frequency: Event-driven
Volume: Per event
Owner: DPO
Participants: DPO, Records Manager, Compliance, Legal
Source: workflow W2988 — NPC Data Privacy Audit &amp; Records Production</bpmn:documentation>
      <bpmn:laneSet id="W2988_LaneSet3">
        <bpmn:lane id="W2988_Lane1" name="DPO">
        <bpmn:flowNodeRef>W2988_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2988_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2988_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2988_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2988_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2988_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2988_Start4" name="NPC complaint, investigation, or compliance check">
        <bpmn:outgoing>W2988_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2988_Task5" name="DPO maintains Data Privacy Act records: DPIAs, consent records, data processing…">
        <bpmn:documentation>Step 1: DPO maintains Data Privacy Act records: DPIAs, consent records, data processing inventory, breach register, registration (DPS)
Responsible (R): DPO
Accountable (A): Compliance Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2988_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2988_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2988_Task6" name="DPO produces records in response to NPC inquiry/complaint; demonstrates…">
        <bpmn:documentation>Step 2: DPO produces records in response to NPC inquiry/complaint; demonstrates compliance with privacy principles and retention rules
Responsible (R): DPO / Records Manager
Accountable (A): Compliance Officer
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2988_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2988_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2988_Task7" name="Legal/DPO defends position; implements any NPC order; updates privacy program…">
        <bpmn:documentation>Step 3: Legal/DPO defends position; implements any NPC order; updates privacy program; archives outcome
Responsible (R): Legal / DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2988_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2988_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2988_End8" name="Complete">
        <bpmn:incoming>W2988_Flow14</bpmn:incoming>
