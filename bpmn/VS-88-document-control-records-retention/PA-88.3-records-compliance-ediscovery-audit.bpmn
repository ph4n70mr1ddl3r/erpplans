    <bpmn:process id="W_W2986" name="W2986. BIR Records Inspection (LOA) Support &amp; Production" isExecutable="false">
      <bpmn:documentation>Trigger: BIR Letter of Authority covering books/records
Frequency: Event-driven; ~2–4 audits/year
Volume: Multi-year scope
Owner: Tax Manager
Participants: Tax Manager, Records Manager, Legal
Source: workflow W2986 — BIR Records Inspection (LOA) Support &amp; Production</bpmn:documentation>
      <bpmn:laneSet id="W2986_LaneSet3">
        <bpmn:lane id="W2986_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W2986_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2986_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2986_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2986_Lane2" name="Records Manager">
        <bpmn:flowNodeRef>W2986_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2986_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2986_Start4" name="BIR Letter of Authority covering books/records">
        <bpmn:outgoing>W2986_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2986_Task5" name="Tax Manager validates LOA scope; coordinates with Records Manager to assemble…">
        <bpmn:documentation>Step 1: Tax Manager validates LOA scope; coordinates with Records Manager to assemble books, e-books, invoices, schedules for 10-year look-back
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W2986_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2986_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2986_Task6" name="Records Manager produces records (digital preferred; physical where required)…">
        <bpmn:documentation>Step 2: Records Manager produces records (digital preferred; physical where required) in BIR-accepted format; maintains inventory and chain of custody
Responsible (R): Records Manager
Accountable (A): Tax Manager
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W2986_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2986_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2986_Task7" name="Tax Manager/Legal responds to BIR queries; defends record completeness and…">
        <bpmn:documentation>Step 3: Tax Manager/Legal responds to BIR queries; defends record completeness and integrity; archives audit correspondence
Responsible (R): Tax Manager / Legal
Accountable (A): CFO
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W2986_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2986_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2986_End8" name="Complete">
        <bpmn:incoming>W2986_Flow14</bpmn:incoming>
      </bpmn:endEvent>
