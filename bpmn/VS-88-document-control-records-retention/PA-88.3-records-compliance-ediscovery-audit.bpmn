    <bpmn:process id="W_W2987" name="W2987. SEC Corporate Records Filing &amp; Inspection Support" isExecutable="false">
      <bpmn:documentation>Trigger: Annual filing or SEC inquiry
Frequency: Annual + event-driven
Volume: 5 entities
Owner: Corporate Secretary
Participants: Corp Sec, Legal, Records Manager
Source: workflow W2987 — SEC Corporate Records Filing &amp; Inspection Support</bpmn:documentation>
      <bpmn:laneSet id="W2987_LaneSet3">
        <bpmn:lane id="W2987_Lane1" name="Corp Sec">
        <bpmn:flowNodeRef>W2987_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2987_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2987_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2987_Lane2" name="Records Manager">
        <bpmn:flowNodeRef>W2987_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2987_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2987_Start4" name="Annual filing or SEC inquiry">
        <bpmn:outgoing>W2987_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2987_Task5" name="Corp Sec maintains SEC corporate records: articles, bylaws, board/stockholder…">
        <bpmn:documentation>Step 1: Corp Sec maintains SEC corporate records: articles, bylaws, board/stockholder minutes, secretary&#x27;s certificate, GIS, AFS
Responsible (R): Corp Sec
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2987_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2987_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2987_Task6" name="Corp Sec files SEC-required forms (GIS, AFS, material disclosures) via SEC…">
        <bpmn:documentation>Step 2: Corp Sec files SEC-required forms (GIS, AFS, material disclosures) via SEC Express/iACES; archives confirmation
Responsible (R): Corp Sec
Accountable (A): VP Legal &amp; Compliance
Duration: Per filing</bpmn:documentation>
        <bpmn:incoming>W2987_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2987_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2987_Task7" name="Records Manager supports SEC inspection/inquiry by producing corporate records…">
        <bpmn:documentation>Step 3: Records Manager supports SEC inspection/inquiry by producing corporate records on demand
Responsible (R): Records Manager
Accountable (A): Corp Sec
Duration: Per inquiry</bpmn:documentation>
        <bpmn:incoming>W2987_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2987_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2987_End8" name="Complete">
        <bpmn:incoming>W2987_Flow14</bpmn:incoming>
      </bpmn:endEvent>
