    <bpmn:process id="W_W2985" name="W2985. e-Discovery Request Response, Collection &amp; Production" isExecutable="false">
      <bpmn:documentation>Trigger: Court order, subpoena, or regulatory e-Discovery request
Frequency: Event-driven; ~5–15 requests/year
Volume: Per request
Owner: Legal Counsel
Participants: Legal, Records Manager, IT, Custodians
Source: workflow W2985 — e-Discovery Request Response, Collection &amp; Production</bpmn:documentation>
      <bpmn:laneSet id="W2985_LaneSet4">
        <bpmn:lane id="W2985_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W2985_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2985_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2985_Lane2" name="IT">
        <bpmn:flowNodeRef>W2985_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2985_Lane3" name="Legal">
        <bpmn:flowNodeRef>W2985_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2985_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2985_Start5" name="Court order, subpoena, or regulatory e-Discovery request">
        <bpmn:outgoing>W2985_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2985_Task6" name="Legal parses request scope (custodians, date range, keywords, record classes)…">
        <bpmn:documentation>Step 1: Legal parses request scope (custodians, date range, keywords, record classes); coordinates with Records Manager/IT
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W2985_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2985_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2985_Task7" name="IT/Records Manager collects relevant ESI (electronically stored information)…">
        <bpmn:documentation>Step 2: IT/Records Manager collects relevant ESI (electronically stored information) preserving metadata and chain of custody; de-duplicates and reviews for privilege
Responsible (R): IT / Records Manager
Accountable (A): Legal Counsel
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W2985_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2985_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2985_Task8" name="Legal produces responsive records in required format; documents privilege log…">
        <bpmn:documentation>Step 3: Legal produces responsive records in required format; documents privilege log; archives production
Responsible (R): Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W2985_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2985_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2985_End9" name="Complete">
        <bpmn:incoming>W2985_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2985_Annotation10">
        <bpmn:text>Controls: - CTL-495 (ensure controlled execution — Records Compliance, e-Discovery &amp; BIR/SEC/NPC Audit (PA-88.3).) | - operational: defensible process and documentation
Owner: Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2985_Assoc11" sourceRef="W2985_Annotation10" targetRef="W2985_Start5" associationDirection="None" />
