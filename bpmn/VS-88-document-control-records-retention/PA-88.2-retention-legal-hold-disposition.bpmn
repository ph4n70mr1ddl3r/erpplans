        <bpmn:outgoing>W2977_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2977_Task6" name="Records Manager maintains retention schedule mapping each record class to…">
        <bpmn:documentation>Step 1: Records Manager maintains retention schedule mapping each record class to mandated retention: BIR accounting/tax 10 years, DOLE payroll 3–5+ years, SEC corporate permanent/specified, NPC per purpose
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2977_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2977_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2977_Task7" name="Compliance/Legal/Tax validate retention against current regulations; updates on…">
        <bpmn:documentation>Step 2: Compliance/Legal/Tax validate retention against current regulations; updates on regulatory change
Responsible (R): Compliance / Legal / Tax Manager
Accountable (A): Compliance Officer
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W2977_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2977_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2977_Task8" name="IT configures retention policy in document management system; enforces…">
        <bpmn:documentation>Step 3: IT configures retention policy in document management system; enforces automatic disposition hold until retention expires
Responsible (R): IT
Accountable (A): Records Manager
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W2977_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2977_End9" name="Complete">
        <bpmn:incoming>W2977_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2977_Annotation10">
        <bpmn:text>Controls: - CTL-239 (ensure records-retention &amp; legal-hold compliance.) | - operational: policy-enforced retention
Owner: Records Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2977_Assoc11" sourceRef="W2977_Annotation10" targetRef="W2977_Start5" associationDirection="None" />
