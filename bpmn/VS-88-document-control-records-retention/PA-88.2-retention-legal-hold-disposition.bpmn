    <bpmn:process id="W_W2979" name="W2979. Legal Hold Issuance, Scope &amp; Release Management" isExecutable="false">
      <bpmn:documentation>Trigger: Litigation, investigation, or regulatory inquiry
Frequency: Event-driven; ~5–20 holds/year
Volume: Per matter
Owner: Legal Counsel
Participants: Legal, Records Manager, IT, Custodians
Source: workflow W2979 — Legal Hold Issuance, Scope &amp; Release Management</bpmn:documentation>
      <bpmn:laneSet id="W2979_LaneSet4">
        <bpmn:lane id="W2979_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W2979_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2979_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2979_Lane2" name="Records Manager">
        <bpmn:flowNodeRef>W2979_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2979_Lane3" name="Legal">
        <bpmn:flowNodeRef>W2979_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2979_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2979_Start5" name="Litigation, investigation, or regulatory inquiry">
        <bpmn:outgoing>W2979_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2979_Task6" name="Legal issues legal hold notice defining scope (custodians, date range…">
        <bpmn:documentation>Step 1: Legal issues legal hold notice defining scope (custodians, date range, keywords, record classes); communicates to custodians
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: Per hold</bpmn:documentation>
        <bpmn:incoming>W2979_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2979_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2979_Task7" name="Records Manager/IT applies hold in repository (suspends retention clock and…">
        <bpmn:documentation>Step 2: Records Manager/IT applies hold in repository (suspends retention clock and disposition); preserves relevant records and metadata
Responsible (R): Records Manager / IT
Accountable (A): Records Manager
Duration: Per hold</bpmn:documentation>
        <bpmn:incoming>W2979_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2979_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2979_Task8" name="Legal releases hold at matter closure; Records Manager resumes normal…">
        <bpmn:documentation>Step 3: Legal releases hold at matter closure; Records Manager resumes normal retention; documents hold lifecycle
Responsible (R): Legal / Records Manager
Accountable (A): VP Legal &amp; Compliance
Duration: Per hold</bpmn:documentation>
        <bpmn:incoming>W2979_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2979_End9" name="Complete">
        <bpmn:incoming>W2979_Flow15</bpmn:incoming>
      </bpmn:endEvent>
