        <bpmn:flowNodeRef>W2978_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2978_Lane2" name="IT">
        <bpmn:flowNodeRef>W2978_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2978_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2978_Start4" name="Record creation or triggering event">
        <bpmn:outgoing>W2978_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2978_Task5" name="Records Manager defines retention-clock start event per class (e.g., tax record…">
        <bpmn:documentation>Step 1: Records Manager defines retention-clock start event per class (e.g., tax record starts at fiscal year-end; contract at termination)
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Per class</bpmn:documentation>
        <bpmn:incoming>W2978_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2978_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2978_Task6" name="IT starts clock automatically at triggering event; pauses on legal hold or…">
        <bpmn:documentation>Step 2: IT starts clock automatically at triggering event; pauses on legal hold or audit; extends on regulatory change
Responsible (R): IT
Accountable (A): Records Manager
Duration: Per record</bpmn:documentation>
        <bpmn:incoming>W2978_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2978_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2978_Task7" name="Records Manager monitors clocks reaching expiry; queues for disposition review…">
        <bpmn:documentation>Step 3: Records Manager monitors clocks reaching expiry; queues for disposition review; prevents premature destruction
Responsible (R): Records Manager
Accountable (A): Records Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2978_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2978_End8" name="Complete">
        <bpmn:incoming>W2978_Flow14</bpmn:incoming>
      </bpmn:endEvent>
