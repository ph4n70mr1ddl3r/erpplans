    <bpmn:process id="W_W2978" name="W2978. Retention Clock Start, Pause &amp; Event-Driven Extension" isExecutable="false">
      <bpmn:documentation>Trigger: Record creation or triggering event
Frequency: Continuous
Volume: All records
Owner: Records Manager
Participants: Records Mgr, IT
Source: workflow W2978 — Retention Clock Start, Pause &amp; Event-Driven Extension</bpmn:documentation>
      <bpmn:laneSet id="W2978_LaneSet3">
        <bpmn:lane id="W2978_Lane1" name="Records Manager">
        <bpmn:flowNodeRef>W2978_Task5</bpmn:flowNodeRef>
