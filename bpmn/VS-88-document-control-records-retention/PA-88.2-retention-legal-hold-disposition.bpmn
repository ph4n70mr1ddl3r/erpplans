    <bpmn:process id="W_W2977" name="W2977. Retention Schedule Maintenance by Record Class (BIR/SEC/DOLE/NPC)" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or regulatory change
Frequency: Annual + event-driven
Volume: ~200–300 record classes
Owner: Records Manager
Participants: Records Mgr, Compliance, Legal, Tax Manager
Source: workflow W2977 — Retention Schedule Maintenance by Record Class (BIR/SEC/DOLE/NPC)</bpmn:documentation>
      <bpmn:laneSet id="W2977_LaneSet4">
        <bpmn:lane id="W2977_Lane1" name="Records Manager">
