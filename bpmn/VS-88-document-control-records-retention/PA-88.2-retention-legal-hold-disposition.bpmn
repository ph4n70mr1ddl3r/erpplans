    <bpmn:process id="W_W2980" name="W2980. Disposition Review, Approval &amp; Secure Destruction Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Retention expiry
Frequency: Continuous (queued) + monthly batch
Volume: Thousands of records/year
Owner: Records Manager
Participants: Records Mgr, Compliance, Department Owner
Source: workflow W2980 — Disposition Review, Approval &amp; Secure Destruction Execution</bpmn:documentation>
      <bpmn:laneSet id="W2980_LaneSet3">
        <bpmn:lane id="W2980_Lane1" name="Records Manager">
        <bpmn:flowNodeRef>W2980_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2980_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2980_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2980_Lane2" name="Department Owner">
        <bpmn:flowNodeRef>W2980_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2980_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2980_Start4" name="Retention expiry">
        <bpmn:outgoing>W2980_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2980_Task5" name="Records Manager generates disposition queue (records at retention expiry)…">
        <bpmn:documentation>Step 1: Records Manager generates disposition queue (records at retention expiry); reviews for legal hold or active audit before destruction
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2980_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2980_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2980_Task6" name="Department Owner/Compliance approves disposition; validates no business need…">
        <bpmn:documentation>Step 2: Department Owner/Compliance approves disposition; validates no business need for extension
Responsible (R): Department Owner / Compliance
Accountable (A): Records Manager
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W2980_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2980_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2980_Task7" name="Records Manager executes secure destruction (physical or digital); issues…">
        <bpmn:documentation>Step 3: Records Manager executes secure destruction (physical or digital); issues Certificate of Destruction; archives certificate
Responsible (R): Records Manager
Accountable (A): Compliance Officer
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W2980_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2980_End8" name="Complete">
        <bpmn:incoming>W2980_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2980_Annotation9">
        <bpmn:text>Controls: - CTL-239 (ensure records-retention &amp; legal-hold compliance.) | - operational: review/approval and certificates
Owner: Records Manager</bpmn:text>
      </bpmn:textAnnotation>
