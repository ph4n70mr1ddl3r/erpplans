        <bpmn:flowNodeRef>W2546_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2546_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W2546_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2546_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2546_Start5" name="30 days post-installation completion">
        <bpmn:outgoing>W2546_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2546_Task6" name="System sends automated NPS survey 30 days post-installation: product…">
        <bpmn:documentation>Step 1: System sends automated NPS survey 30 days post-installation: product satisfaction, installation experience, communication quality, value for money, likelihood to recommend (0–10), open comments; survey completion target: &gt;40% response rate
Responsible (R): System / CX Analyst
Accountable (A): COO
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2546_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2546_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2546_Task7" name="CX Analyst reviews responses: categorizes detractors (0–6), passives (7–8)…">
        <bpmn:documentation>Step 2: CX Analyst reviews responses: categorizes detractors (0–6), passives (7–8), promoters (9–10); routes detractor feedback to Category Manager for immediate follow-up within 48 hours; compiles monthly NPS report
Responsible (R): CX Analyst
Accountable (A): COO
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2546_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2546_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2546_Task8" name="Category Manager addresses detractor issues: coordinates service recovery…">
        <bpmn:documentation>Step 3: Category Manager addresses detractor issues: coordinates service recovery (additional inspection, performance optimization, partial refund if warranted); updates training or processes based on recurring themes; reports quarterly NPS trend to VP Merchandising
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2546_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2546_End9" name="Complete">
        <bpmn:incoming>W2546_Flow15</bpmn:incoming>
      </bpmn:endEvent>
