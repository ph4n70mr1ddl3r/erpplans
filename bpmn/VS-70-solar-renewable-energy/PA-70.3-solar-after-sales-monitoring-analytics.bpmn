    <bpmn:process id="W_W2549" name="W2549. Solar Market Intelligence &amp; Regulatory Update Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly intelligence cycle or regulatory announcement
Frequency: Monthly; event-driven for regulatory changes
Volume: Monthly report; 2–4 regulatory alerts/year
Owner: Category Manager — Electrical
Participants: Category Mgr, Procurement, Legal, VP Merchandising
Source: workflow W2549 — Solar Market Intelligence &amp; Regulatory Update Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2549_LaneSet3">
        <bpmn:lane id="W2549_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2549_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2549_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2549_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2549_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2549_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2549_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2549_Start4" name="Monthly intelligence cycle or regulatory announcement">
        <bpmn:outgoing>W2549_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2549_Task5" name="Category Manager monitors market developments: global solar panel pricing…">
        <bpmn:documentation>Step 1: Category Manager monitors market developments: global solar panel pricing trends (spot market), Philippine ERC net metering policy changes, DU-specific interconnection rule updates, government solar incentive programs (BOI tax holidays for solar manufacturers), competitor solar pricing and assortment
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W2549_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2549_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2549_Task6" name="Legal reviews regulatory changes: ERC circulars, DOE renewable energy targets…">
        <bpmn:documentation>Step 2: Legal reviews regulatory changes: ERC circulars, DOE renewable energy targets, LGU building code amendments affecting solar installations, BIR tax treatment of solar sales (VAT zero-rating for renewable energy equipment per RA 9513); updates compliance requirements
Responsible (R): Legal
Accountable (A): VP Legal
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2549_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2549_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2549_Task7" name="Category Manager incorporates intelligence into strategy: adjusts pricing based…">
        <bpmn:documentation>Step 3: Category Manager incorporates intelligence into strategy: adjusts pricing based on global panel cost trends, updates assortment for new technology (e.g., bifacial panels, solid-state batteries), modifies sales approach for regulatory changes, briefs Store Ops and Training on updates
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2549_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2549_End8" name="Complete">
        <bpmn:incoming>W2549_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2549_Annotation9">
        <bpmn:text>Controls: - CTL-441 (ensure controlled execution — Solar After-Sales Monitoring &amp; Analytics (PA-70.3).) | - operational: Category Manager — Electrical review and approval gate
Owner: Category Manager — Electrical</bpmn:text>
      </bpmn:textAnnotation>
