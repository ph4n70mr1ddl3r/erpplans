    <bpmn:process id="W_W2548" name="W2548. Solar Product Return &amp; Exchange Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests return of solar product (pre-installation) or defective unit replacement
Frequency: ~10–20 returns/month
Volume: ~10–20/month
Owner: Store Customer Service Rep
Participants: Customer Service Rep, Department Supervisor, Category Manager, Vendor
Source: workflow W2548 — Solar Product Return &amp; Exchange Processing</bpmn:documentation>
      <bpmn:laneSet id="W2548_LaneSet4">
        <bpmn:lane id="W2548_Lane1" name="Customer Service Rep">
        <bpmn:flowNodeRef>W2548_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2548_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2548_Lane2" name="Department Supervisor">
        <bpmn:flowNodeRef>W2548_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2548_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W2548_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2548_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2548_Start5" name="Customer requests return of solar product (pre-installation) or defective unit replacement">
        <bpmn:outgoing>W2548_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2548_Task6" name="Customer Service Rep processes return request: verifies purchase within 30-day…">
        <bpmn:documentation>Step 1: Customer Service Rep processes return request: verifies purchase within 30-day return window (standard) or warranty period (defective); for panels/inverters — inspects for physical damage; for special-order items — confirms return authorization per vendor policy
Responsible (R): Customer Service Rep
Accountable (A): Department Supervisor
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W2548_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2548_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2548_Task7" name="Supervisor approves return; system processes refund (cash/card reversal) or…">
        <bpmn:documentation>Step 2: Supervisor approves return; system processes refund (cash/card reversal) or exchange; for defective items: creates vendor return authorization request; items placed in defective quarantine area; customer receives replacement from stock or special order
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2548_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2548_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2548_Task8" name="Category Manager reviews return trend monthly: high return rate SKUs flagged…">
        <bpmn:documentation>Step 3: Category Manager reviews return trend monthly: high return rate SKUs flagged for quality review with vendor; defective analysis by vendor, product type, and batch/lot; adjusts inventory buffers for high-return SKUs
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W2548_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2548_End9" name="Complete">
        <bpmn:incoming>W2548_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2548_Annotation10">
        <bpmn:text>Controls: - CTL-441 (ensure controlled execution — Solar After-Sales Monitoring &amp; Analytics (PA-70.3).) | - operational: Store Customer Service Rep review and approval gate
Owner: Store Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
