    <bpmn:process id="W_W2546" name="W2546. Solar Customer Satisfaction &amp; NPS Survey" isExecutable="false">
      <bpmn:documentation>Trigger: 30 days post-installation completion
Frequency: ~40–60 surveys/month
Volume: ~40–60/month
Owner: Customer Experience Analyst
Participants: CX Analyst, Category Manager, Solar Sales Coordinator
Source: workflow W2546 — Solar Customer Satisfaction &amp; NPS Survey</bpmn:documentation>
      <bpmn:laneSet id="W2546_LaneSet4">
        <bpmn:lane id="W2546_Lane1" name="System">
        <bpmn:flowNodeRef>W2546_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2546_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
