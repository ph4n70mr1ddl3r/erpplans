<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-70.3-solar-after-sales-monitoring-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2542" name="W2542. Solar System Remote Monitoring &amp; Performance Alerting" isExecutable="false">
      <bpmn:documentation>Trigger: IoT monitoring detects anomaly or scheduled daily performance check
Frequency: Continuous monitoring; daily summary
Volume: ~500–1,000 monitored systems (growing at ~600/year)
Owner: Solar Technical Support
Participants: Solar Tech Support, Installation Partner, Customer
Source: workflow W2542 — Solar System Remote Monitoring &amp; Performance Alerting</bpmn:documentation>
      <bpmn:laneSet id="W2542_LaneSet3">
        <bpmn:lane id="W2542_Lane1" name="System">
        <bpmn:flowNodeRef>W2542_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2542_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2542_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2542_Lane2" name="Solar Tech Support">
        <bpmn:flowNodeRef>W2542_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2542_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2542_Start4" name="IoT monitoring detects anomaly or scheduled daily performance check">
        <bpmn:outgoing>W2542_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2542_Task5" name="IoT gateway collects real-time data from inverter: power output (kW), daily…">
        <bpmn:documentation>Step 1: IoT gateway collects real-time data from inverter: power output (kW), daily generation (kWh), grid import/export, inverter temperature, error codes; transmits to ERP via API; system compares actual vs. expected generation based on weather data (irradiance) and system specifications
Responsible (R): System / Solar Tech Support
Accountable (A): Category Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2542_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2542_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2542_Task6" name="System generates alerts: Underperformance (actual &lt;80% of expected for 3…">
        <bpmn:documentation>Step 2: System generates alerts: Underperformance (actual &lt;80% of expected for 3 consecutive days), Inverter Error (fault code triggers diagnostic), Communication Loss (no data for 24 hours); Solar Tech Support reviews alerts daily and triages priority
Responsible (R): System / Solar Tech Support
Accountable (A): Category Manager
Duration: 30–60 min/day</bpmn:documentation>
        <bpmn:incoming>W2542_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2542_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2542_Task7" name="For confirmed issues: Tech Support contacts customer, diagnoses remotely…">
        <bpmn:documentation>Step 3: For confirmed issues: Tech Support contacts customer, diagnoses remotely (inverter reset, connection check); dispatches installation partner for on-site repair if needed; logs service ticket in ERP; tracks resolution within SLA (non-critical: 5 days, critical: 2 days)
Responsible (R): Solar Tech Support / Installer
Accountable (A): Category Manager
Duration: 30 min – 2 hours per issue</bpmn:documentation>
        <bpmn:incoming>W2542_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2542_End8" name="Complete">
        <bpmn:incoming>W2542_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2542_Annotation9">
        <bpmn:text>Controls: - CTL-441 (ensure controlled execution — Solar After-Sales Monitoring &amp; Analytics (PA-70.3).) | - operational: Solar Technical Support review and approval gate
Owner: Solar Technical Support</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2542_Assoc10" sourceRef="W2542_Annotation9" targetRef="W2542_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2542_Flow11" sourceRef="W2542_Start4" targetRef="W2542_Task5" />
      <bpmn:sequenceFlow id="W2542_Flow12" sourceRef="W2542_Task5" targetRef="W2542_Task6" />
      <bpmn:sequenceFlow id="W2542_Flow13" sourceRef="W2542_Task6" targetRef="W2542_Task7" />
      <bpmn:sequenceFlow id="W2542_Flow14" sourceRef="W2542_Task7" targetRef="W2542_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2542_diag">
      <bpmndi:BPMNPlane id="W2542_plane" bpmnElement="W_W2542">
        <bpmndi:BPMNShape id="W2542_Lane1_di" bpmnElement="W2542_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Lane2_di" bpmnElement="W2542_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Task5_di" bpmnElement="W2542_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Task6_di" bpmnElement="W2542_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Task7_di" bpmnElement="W2542_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Start4_di" bpmnElement="W2542_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_End8_di" bpmnElement="W2542_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2542_Annotation9_di" bpmnElement="W2542_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2542_Flow11_di" bpmnElement="W2542_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2542_Flow12_di" bpmnElement="W2542_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2542_Flow13_di" bpmnElement="W2542_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2542_Flow14_di" bpmnElement="W2542_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2542_Assoc10_di" bpmnElement="W2542_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2543" name="W2543. Solar Panel Performance Degradation Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Annual performance review cycle or warranty claim
Frequency: Annual per installed system
Volume: ~500–1,000 annual reviews (growing)
Owner: Solar Technical Support
Participants: Solar Tech Support, Category Manager, Vendor
Source: workflow W2543 — Solar Panel Performance Degradation Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2543_LaneSet3">
        <bpmn:lane id="W2543_Lane1" name="System">
        <bpmn:flowNodeRef>W2543_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2543_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2543_Lane2" name="Solar Tech Support">
        <bpmn:flowNodeRef>W2543_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2543_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2543_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2543_Start4" name="Annual performance review cycle or warranty claim">
        <bpmn:outgoing>W2543_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2543_Task5" name="System calculates annual degradation rate per installation: compares Year N…">
        <bpmn:documentation>Step 1: System calculates annual degradation rate per installation: compares Year N actual generation vs. Year 1 baseline, normalized for weather (irradiance data); flags installations exceeding panel warranty degradation curve (typically &lt;0.55%/year for Tier 1 panels)
Responsible (R): System / Solar Tech Support
Accountable (A): Category Manager
Duration: 1–2 days/year batch</bpmn:documentation>
        <bpmn:incoming>W2543_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2543_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2543_Task6" name="Tech Support reviews flagged installations: determines if degradation is…">
        <bpmn:documentation>Step 2: Tech Support reviews flagged installations: determines if degradation is panel-related (manufacturing defect warrantable) vs. environmental (shading from new construction, soiling from nearby construction dust, vegetation growth)
Responsible (R): Solar Tech Support
Accountable (A): Category Manager
Duration: 30–60 min per case</bpmn:documentation>
        <bpmn:incoming>W2543_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2543_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2543_Task7" name="For warrantable degradation: initiates warranty claim with panel vendor…">
        <bpmn:documentation>Step 3: For warrantable degradation: initiates warranty claim with panel vendor (W2544); provides monitoring data as evidence; coordinates panel testing and replacement. For environmental issues: advises customer on remediation (tree trimming, panel cleaning service)
Responsible (R): Solar Tech Support / Vendor
Accountable (A): Category Manager
Duration: 1–4 weeks per case</bpmn:documentation>
        <bpmn:incoming>W2543_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2543_End8" name="Complete">
        <bpmn:incoming>W2543_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2543_Annotation9">
        <bpmn:text>Controls: - CTL-441 (ensure controlled execution — Solar After-Sales Monitoring &amp; Analytics (PA-70.3).) | - operational: Solar Technical Support review and approval gate
Owner: Solar Technical Support</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2543_Assoc10" sourceRef="W2543_Annotation9" targetRef="W2543_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2543_Flow11" sourceRef="W2543_Start4" targetRef="W2543_Task5" />
      <bpmn:sequenceFlow id="W2543_Flow12" sourceRef="W2543_Task5" targetRef="W2543_Task6" />
      <bpmn:sequenceFlow id="W2543_Flow13" sourceRef="W2543_Task6" targetRef="W2543_Task7" />
      <bpmn:sequenceFlow id="W2543_Flow14" sourceRef="W2543_Task7" targetRef="W2543_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2543_diag">
      <bpmndi:BPMNPlane id="W2543_plane" bpmnElement="W_W2543">
        <bpmndi:BPMNShape id="W2543_Lane1_di" bpmnElement="W2543_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Lane2_di" bpmnElement="W2543_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Task5_di" bpmnElement="W2543_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Task6_di" bpmnElement="W2543_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Task7_di" bpmnElement="W2543_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Start4_di" bpmnElement="W2543_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_End8_di" bpmnElement="W2543_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2543_Annotation9_di" bpmnElement="W2543_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2543_Flow11_di" bpmnElement="W2543_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2543_Flow12_di" bpmnElement="W2543_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2543_Flow13_di" bpmnElement="W2543_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2543_Flow14_di" bpmnElement="W2543_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2543_Assoc10_di" bpmnElement="W2543_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2544" name="W2544. Solar Warranty Claim &amp; Vendor Recovery Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports solar product defect or monitoring detects performance issue
Frequency: ~10–20 warranty claims/month
Volume: ~10–20/month
Owner: Solar Sales Coordinator
Participants: Solar Sales Coord, Vendor, Installation Partner, Finance, Customer
Source: workflow W2544 — Solar Warranty Claim &amp; Vendor Recovery Processing</bpmn:documentation>
      <bpmn:laneSet id="W2544_LaneSet3">
        <bpmn:lane id="W2544_Lane1" name="Solar Sales Coordinator">
        <bpmn:flowNodeRef>W2544_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2544_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2544_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2544_Lane2" name="Solar Sales Coord">
        <bpmn:flowNodeRef>W2544_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2544_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2544_Start4" name="Customer reports solar product defect or monitoring detects performance issue">
        <bpmn:outgoing>W2544_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2544_Task5" name="Coordinator receives warranty claim: customer-submitted via portal or…">
        <bpmn:documentation>Step 1: Coordinator receives warranty claim: customer-submitted via portal or monitoring-triggered; validates warranty status (within coverage period, registered serial number); categorizes: panel defect, inverter failure, battery issue, installation workmanship
Responsible (R): Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2544_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2544_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2544_Task6" name="Coordinator coordinates inspection: dispatches installation partner to diagnose…">
        <bpmn:documentation>Step 2: Coordinator coordinates inspection: dispatches installation partner to diagnose on-site; collects photographic evidence and test data; submits claim to vendor with documentation package per vendor warranty process (varies by manufacturer)
Responsible (R): Solar Sales Coordinator / Installer
Accountable (A): Category Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2544_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2544_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2544_Task7" name="Upon vendor approval: Coordinator coordinates replacement delivery and…">
        <bpmn:documentation>Step 3: Upon vendor approval: Coordinator coordinates replacement delivery and installation; Finance processes vendor credit/replacement PO; system updates warranty record and inventory; if vendor rejects, escalates to Category Manager for resolution or customer accommodation
Responsible (R): Solar Sales Coord / Finance / Vendor
Accountable (A): Category Manager / Finance
Duration: 1–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2544_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2544_End8" name="Complete">
        <bpmn:incoming>W2544_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2544_Annotation9">
        <bpmn:text>Controls: - CTL-441 (ensure controlled execution — Solar After-Sales Monitoring &amp; Analytics (PA-70.3).) | - operational: non-operational during warranty resolution
Owner: Solar Sales Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2544_Assoc10" sourceRef="W2544_Annotation9" targetRef="W2544_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2544_Flow11" sourceRef="W2544_Start4" targetRef="W2544_Task5" />
      <bpmn:sequenceFlow id="W2544_Flow12" sourceRef="W2544_Task5" targetRef="W2544_Task6" />
      <bpmn:sequenceFlow id="W2544_Flow13" sourceRef="W2544_Task6" targetRef="W2544_Task7" />
      <bpmn:sequenceFlow id="W2544_Flow14" sourceRef="W2544_Task7" targetRef="W2544_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2544_diag">
      <bpmndi:BPMNPlane id="W2544_plane" bpmnElement="W_W2544">
        <bpmndi:BPMNShape id="W2544_Lane1_di" bpmnElement="W2544_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Lane2_di" bpmnElement="W2544_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Task5_di" bpmnElement="W2544_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Task6_di" bpmnElement="W2544_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Task7_di" bpmnElement="W2544_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Start4_di" bpmnElement="W2544_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_End8_di" bpmnElement="W2544_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2544_Annotation9_di" bpmnElement="W2544_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2544_Flow11_di" bpmnElement="W2544_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2544_Flow12_di" bpmnElement="W2544_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2544_Flow13_di" bpmnElement="W2544_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2544_Flow14_di" bpmnElement="W2544_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2544_Assoc10_di" bpmnElement="W2544_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2545" name="W2545. Solar Installation Partner Performance Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly review cycle
Frequency: Monthly
Volume: ~10–20 installation partners
Owner: Category Manager — Electrical
Participants: Category Mgr, Solar Sales Coordinator, VP Merchandising
Source: workflow W2545 — Solar Installation Partner Performance Scoring</bpmn:documentation>
      <bpmn:laneSet id="W2545_LaneSet3">
        <bpmn:lane id="W2545_Lane1" name="System">
        <bpmn:flowNodeRef>W2545_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2545_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2545_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2545_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2545_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2545_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2545_Start4" name="Monthly review cycle">
        <bpmn:outgoing>W2545_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2545_Task5" name="System generates partner scorecard: installation quality (inspection pass rate…">
        <bpmn:documentation>Step 1: System generates partner scorecard: installation quality (inspection pass rate target ≥95%), schedule adherence (on-time installation target ≥90%), customer satisfaction (NPS from post-install survey), warranty claim rate (&lt;5% within first year), safety incidents (zero tolerance)
Responsible (R): System / Solar Sales Coordinator
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2545_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2545_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2545_Task6" name="Category Manager reviews scorecards; conducts monthly performance call with…">
        <bpmn:documentation>Step 2: Category Manager reviews scorecards; conducts monthly performance call with each partner; for underperformers: issues corrective action plan with 30-day improvement window; for top performers: increases lead allocation and explores volume commitments
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2545_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2545_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2545_Task7" name="Quarterly: Category Manager evaluates partner portfolio; onboards new partners…">
        <bpmn:documentation>Step 3: Quarterly: Category Manager evaluates partner portfolio; onboards new partners in underserved regions (especially Visayas/Mindanao); terminates chronically underperforming partners per contract terms; maintains minimum 2 partners per region for competition
Responsible (R): Category Manager / Procurement
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2545_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2545_End8" name="Complete">
