    <bpmn:process id="W_W2547" name="W2547. Solar Sales Analytics &amp; Revenue Attribution" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle
Frequency: Monthly
Volume: Monthly aggregation of ~40–60 sales
Owner: Category Manager — Electrical
Participants: Category Mgr, FP&amp;A, BI Analyst
Source: workflow W2547 — Solar Sales Analytics &amp; Revenue Attribution</bpmn:documentation>
      <bpmn:laneSet id="W2547_LaneSet4">
        <bpmn:lane id="W2547_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W2547_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2547_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2547_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2547_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2547_Lane3" name="FP&amp;A">
        <bpmn:flowNodeRef>W2547_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2547_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2547_Start5" name="Monthly reporting cycle">
        <bpmn:outgoing>W2547_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2547_Task6" name="BI Analyst generates solar sales dashboard: total revenue (product +…">
        <bpmn:documentation>Step 1: BI Analyst generates solar sales dashboard: total revenue (product + installation), units sold by system size, average system price, margin by product category (panels, inverters, batteries, accessories, installation services), conversion rate (lead → sale), sales per store, regional performance
Responsible (R): BI Analyst / Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2547_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2547_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2547_Task7" name="Category Manager analyzes trends: attach rate (product-only vs…">
        <bpmn:documentation>Step 2: Category Manager analyzes trends: attach rate (product-only vs. product+installation), upsell rate (battery, EV charger), vendor rebate recovery, installation partner cost trends, customer segment performance (B2C vs. B2B trade); identifies top/bottom performing stores
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2547_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2547_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2547_Task8" name="FP&amp;A reviews solar category P&amp;L: revenue growth vs. forecast, gross margin…">
        <bpmn:documentation>Step 3: FP&amp;A reviews solar category P&amp;L: revenue growth vs. forecast, gross margin (target 25–30%), customer acquisition cost, lifetime value (including cross-sell); adjusts category financial plan for next quarter
Responsible (R): FP&amp;A / Category Manager
Accountable (A): CFO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2547_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2547_End9" name="Complete">
        <bpmn:incoming>W2547_Flow15</bpmn:incoming>
      </bpmn:endEvent>
