      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3906" name="W3906. Demand Planning &amp; Statistical Baseline Forecasting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cycle; data refresh
Frequency: Monthly + weekly refresh
Volume: ~35,000 active SKUs × 200 stores/4 DCs; ~55,000 SKU master
Owner: Demand Planning
Participants: Demand Planning, Data Science (links to VS-30.2), Merchandising (links to VS-01), Supply Planning (links to VS-02), Insights (links to VS-28.1), IT (links to VS-27/VS-28), Consumer Insights (links to VS-44)
Source: workflow W3906 — Demand Planning &amp; Statistical Baseline Forecasting</bpmn:documentation>
      <bpmn:laneSet id="W3906_LaneSet2">
        <bpmn:lane id="W3906_Lane1" name="Demand Planning">
        <bpmn:flowNodeRef>W3906_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3906_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3906_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3906_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3906_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3906_Start3" name="Monthly cycle; data refresh">
        <bpmn:outgoing>W3906_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3906_Task4" name="Demand Planning/Data Science generate the statistical baseline forecast per…">
        <bpmn:documentation>Step 1: Demand Planning/Data Science generate the statistical baseline forecast per SKU/region: time-series models (seasonal, trend, Croston for slow-movers), hierarchical reconciliation (category → SKU, region → store), outlier cleansing, and incorporate the seasonal calendar (links to profile §13.2 and VS-64)
Responsible (R): Demand Planning / Data Science
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3906_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3906_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3906_Task5" name="Demand Planning segment SKUs by treatment (A-items statistical + override…">
        <bpmn:documentation>Step 2: Demand Planning segment SKUs by treatment (A-items statistical + override; B-items statistical; C-items aggregate/profile) to balance effort, and incorporate causal factors (price links to VS-01.2, weather/typhoon links to VS-69, holidays, store openings links to VS-37)
Responsible (R): Demand Planning / Merchandising
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3906_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3906_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3906_Task6" name="Demand Planning publish the baseline to the consensus review (links to W3907)…">
        <bpmn:documentation>Step 3: Demand Planning publish the baseline to the consensus review (links to W3907) with confidence intervals, model lineage, and exceptions for review
Responsible (R): Demand Planning
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3906_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3906_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3906_End7" name="Complete">
        <bpmn:incoming>W3906_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3906_Annotation8">
        <bpmn:text>Controls: - CTL-610 (ensure controlled execution — S&amp;OP/IBP Framework, Demand Consensus &amp; Forecasting (PA-127.1).) | - operational: monthly retrain and bias tracking (links to W3911); operational: ABC segmentation
Owner: Demand Planning</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3906_Assoc9" sourceRef="W3906_Annotation8" targetRef="W3906_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3906_Flow10" sourceRef="W3906_Start3" targetRef="W3906_Task4" />
      <bpmn:sequenceFlow id="W3906_Flow11" sourceRef="W3906_Task4" targetRef="W3906_Task5" />
      <bpmn:sequenceFlow id="W3906_Flow12" sourceRef="W3906_Task5" targetRef="W3906_Task6" />
      <bpmn:sequenceFlow id="W3906_Flow13" sourceRef="W3906_Task6" targetRef="W3906_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3906_diag">
      <bpmndi:BPMNPlane id="W3906_plane" bpmnElement="W_W3906">
        <bpmndi:BPMNShape id="W3906_Lane1_di" bpmnElement="W3906_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
