<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-127.1-sop-framework-demand-consensus-forecasting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3905" name="W3905. S&amp;OP/IBP Strategy, Operating Rhythm &amp; Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle (links to VS-33.1); executive mandate
Frequency: Annual design + monthly cycle
Volume: 1 enterprise S&amp;OP/IBP process (18–24 month rolling horizon, per step 1)
Owner: S&amp;OP / Demand &amp; Supply Planning
Participants: S&amp;OP Lead, Merchandising (links to VS-01), Supply Planning (links to VS-02), Marketing (links to VS-14), Finance/FP&amp;A (links to VS-17.4/VS-101), Store Ops (links to VS-07), Logistics (links to VS-06/VS-110), Sourcing/Import (links to VS-122/VS-87), Strategy (links to VS-33), Commodity (links to VS-106)
Source: workflow W3905 — S&amp;OP/IBP Strategy, Operating Rhythm &amp; Governance</bpmn:documentation>
      <bpmn:laneSet id="W3905_LaneSet3">
        <bpmn:lane id="W3905_Lane1" name="S&amp;OP Lead">
        <bpmn:flowNodeRef>W3905_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3905_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3905_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3905_Lane2" name="COO">
        <bpmn:flowNodeRef>W3905_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3905_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3905_Start4" name="Annual planning cycle (links to VS-33.1); executive mandate">
        <bpmn:outgoing>W3905_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3905_Task5" name="S&amp;OP/Demand-Supply design the S&amp;OP/IBP operating model: horizon (18–24 month…">
        <bpmn:documentation>Step 1: S&amp;OP/Demand-Supply design the S&amp;OP/IBP operating model: horizon (18–24 month rolling), granularity (category/region/SKU-family monthly → key-SKU weekly), the five-step monthly cycle (demand review → supply review → pre-S&amp;OP → exec S&amp;OP → plan publication), product-treatment segments (A/B/C links to profile §6.6), and KPIs (forecast accuracy, plan adherence, service level, inventory turns)
Responsible (R): S&amp;OP Lead / Planning
Accountable (A): COO / VP Merchandising
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3905_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3905_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3905_Task6" name="S&amp;OP establish governance: S&amp;OP chair (typically Demand-Supply Planning…">
        <bpmn:documentation>Step 2: S&amp;OP establish governance: S&amp;OP chair (typically Demand-Supply Planning leader), executive sponsor (COO), the demand-consensus participants (Sales/Marketing/Merchandising/Finance/Supply), decision rights, escalation path, and integration to corporate planning (links to VS-33) and merchandise financial planning (links to VS-101)
Responsible (R): S&amp;OP Lead / COO
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3905_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3905_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3905_Task7" name="COO/Executive ratify the cadence, calendar (monthly cycle aligned to financial…">
        <bpmn:documentation>Step 3: COO/Executive ratify the cadence, calendar (monthly cycle aligned to financial close), and the single-number principle (one agreed plan), and cascade to functions
Responsible (R): COO / S&amp;OP Lead
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3905_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3905_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3905_End8" name="Complete">
        <bpmn:incoming>W3905_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3905_Annotation9">
        <bpmn:text>Controls: - CTL-72 (ensure S&amp;OP consensus &amp; financial reconciliation.) | - operational: consensus cycle and single-number governance; operational: fixed calendar and exec sponsorship
Owner: S&amp;OP / Demand &amp; Supply Planning</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3905_Assoc10" sourceRef="W3905_Annotation9" targetRef="W3905_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3905_Flow11" sourceRef="W3905_Start4" targetRef="W3905_Task5" />
      <bpmn:sequenceFlow id="W3905_Flow12" sourceRef="W3905_Task5" targetRef="W3905_Task6" />
      <bpmn:sequenceFlow id="W3905_Flow13" sourceRef="W3905_Task6" targetRef="W3905_Task7" />
      <bpmn:sequenceFlow id="W3905_Flow14" sourceRef="W3905_Task7" targetRef="W3905_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3905_diag">
      <bpmndi:BPMNPlane id="W3905_plane" bpmnElement="W_W3905">
        <bpmndi:BPMNShape id="W3905_Lane1_di" bpmnElement="W3905_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
