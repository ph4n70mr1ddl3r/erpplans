        <bpmndi:BPMNEdge id="W3906_Flow11_di" bpmnElement="W3906_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3906_Flow12_di" bpmnElement="W3906_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3906_Flow13_di" bpmnElement="W3906_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3906_Assoc9_di" bpmnElement="W3906_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3907" name="W3907. Demand Consensus Review (Sales/Marketing/Merchandising/Finance)" isExecutable="false">
      <bpmn:documentation>Trigger: Baseline published (W3906)
Frequency: Monthly
Volume: ~1 consensus cycle/month across categories
Owner: S&amp;OP / Demand Planning
Participants: S&amp;OP Lead, Merchandising/Category (links to VS-01), Sales/Trade (links to VS-11/VS-107), Marketing (links to VS-14), Finance/FP&amp;A (links to VS-17.4/VS-101), Store Ops (links to VS-07), Supply (links to VS-02), Ecommerce (links to VS-10)
Source: workflow W3907 — Demand Consensus Review (Sales/Marketing/Merchandising/Finance)</bpmn:documentation>
      <bpmn:laneSet id="W3907_LaneSet3">
        <bpmn:lane id="W3907_Lane1" name="S&amp;OP Lead">
        <bpmn:flowNodeRef>W3907_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3907_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3907_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3907_Lane2" name="Functions">
        <bpmn:flowNodeRef>W3907_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3907_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3907_Start4" name="Baseline published (W3906)">
        <bpmn:outgoing>W3907_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3907_Task5" name="S&amp;OP facilitate the demand-consensus meeting: review baseline (links to W3906)…">
        <bpmn:documentation>Step 1: S&amp;OP facilitate the demand-consensus meeting: review baseline (links to W3906), incorporate sales/marketing intelligence (promotions links to VS-58/VS-14, key-account pipeline links to VS-107, trade-pro activity links to VS-43, ecommerce trends links to VS-10), and reconcile divergent views into one unconstrained demand plan
Responsible (R): S&amp;OP Lead / Functions
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3907_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3907_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3907_Task6" name="Functions provide structured demand overrides with justification and ownership…">
        <bpmn:documentation>Step 2: Functions provide structured demand overrides with justification and ownership (override reason codes, confidence), tracked for accountability and feedback to model learning (links to W3911)
Responsible (R): Functions / Demand Planning
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3907_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3907_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3907_Task7" name="S&amp;OP publish the unconstrained consensus demand plan (volume by…">
        <bpmn:documentation>Step 3: S&amp;OP publish the unconstrained consensus demand plan (volume by category/region/SKU-family over the horizon) for the supply review (links to W3913) and financial reconciliation (links to W3921)
Responsible (R): S&amp;OP Lead
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3907_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3907_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3907_End8" name="Complete">
        <bpmn:incoming>W3907_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3907_Annotation9">
        <bpmn:text>Controls: - CTL-610 (ensure controlled execution — S&amp;OP/IBP Framework, Demand Consensus &amp; Forecasting (PA-127.1).) | - operational: override tracking and accountability; operational: structured override and intelligence input
Owner: S&amp;OP / Demand Planning</bpmn:text>
      </bpmn:textAnnotation>
