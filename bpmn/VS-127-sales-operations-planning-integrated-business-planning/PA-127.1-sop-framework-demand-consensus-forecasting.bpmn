      <bpmn:sequenceFlow id="W3907_Flow12" sourceRef="W3907_Task5" targetRef="W3907_Task6" />
      <bpmn:sequenceFlow id="W3907_Flow13" sourceRef="W3907_Task6" targetRef="W3907_Task7" />
      <bpmn:sequenceFlow id="W3907_Flow14" sourceRef="W3907_Task7" targetRef="W3907_End8" />
    </bpmn:process>
