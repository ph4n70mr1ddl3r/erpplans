    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5495" name="W5495. Vendor-Managed Inventory (VMI) and Consignment S&amp;OP Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly consensus cycle; VMI/consignment agreement (links to VS-45); inventory-policy review
Frequency: Monthly + continuous signal
Volume: ~300 VMI SKUs from 12 key vendors + consignment (major appliances, select tiles) per profile §6.4 — ownership/signal crosses the vendor boundary
Owner: S&amp;OP/IBP Lead (Supply Chain &amp; Logistics)
Participants: Demand Planning, Supply Planning, Vendor Management (links to VS-03/VS-45), Merchandising (links to VS-01), DC Operations (links to VS-04), Finance/SCF (links to VS-105/VS-170), Inventory (links to VS-05)
Source: workflow W5495 — Vendor-Managed Inventory (VMI) and Consignment S&amp;OP Integration</bpmn:documentation>
      <bpmn:laneSet id="W5495_LaneSet2">
        <bpmn:lane id="W5495_Lane1" name="S&amp;OP">
        <bpmn:flowNodeRef>W5495_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5495_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5495_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5495_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5495_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5495_Start3" name="Monthly consensus cycle; VMI/consignment agreement (links to VS-45); inventory-policy…">
        <bpmn:outgoing>W5495_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5495_Task4" name="S&amp;OP/IBP reconcile VMI/consignment demand into the consensus plan as a distinct…">
        <bpmn:documentation>Step 1: S&amp;OP/IBP reconcile VMI/consignment demand into the consensus plan as a distinct treatment: VMI SKUs where the vendor owns the replenishment signal (links to VS-45), consignment where BuildRight sells-but-does-not-own until point-of-sale (links to VS-05/VS-170), so they are visible but not double-planned against BuildRight-owned supply
Responsible (R): S&amp;OP/IBP / Demand Planning
Accountable (A): S&amp;OP/IBP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5495_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5495_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5495_Task5" name="S&amp;OP/IBP/Vendor-Management coordinate the vendor signal: share the consensus…">
        <bpmn:documentation>Step 2: S&amp;OP/IBP/Vendor-Management coordinate the vendor signal: share the consensus demand and POS/sell-through data with VMI vendors, agree min/max and service levels, manage the consignment settlement/ownership-transfer at POS, and align to SCF/consignment financing (links to VS-105/VS-170)
Responsible (R): S&amp;OP/IBP / Vendor Mgmt / Finance
Accountable (A): S&amp;OP/IBP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5495_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5495_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5495_Task6" name="S&amp;OP/IBP monitor VMI/consignment service level (stockout, overstock, vendor…">
        <bpmn:documentation>Step 3: S&amp;OP/IBP monitor VMI/consignment service level (stockout, overstock, vendor fill-rate), resolve signal/ownership-boundary disputes, and feed VMI performance into the vendor scorecard (links to VS-67/VS-03) and the inventory-policy review (links to VS-136/W3914)
Responsible (R): S&amp;OP/IBP / Vendor Mgmt / Inventory
Accountable (A): S&amp;OP/IBP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5495_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5495_End7" name="Complete">
        <bpmn:incoming>W5495_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5495_Annotation8">
        <bpmn:text>Controls: - CTL-613 (ensure controlled execution — Calamity, Seasonality &amp; Philippine-Retail Demand–Supply Dynamics (PA-127.4).) | - operational: VMI/consignment as a distinct treatment to prevent double-planning; operational: consignment ownership-transfer settlement (VS-170/VS-05); operational: VMI service-level feed to vendor scorecard
Owner: S&amp;OP/IBP Lead (Supply Chain &amp; Logistics)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5495_Assoc9" sourceRef="W5495_Annotation8" targetRef="W5495_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5495_Flow10" sourceRef="W5495_Start3" targetRef="W5495_Task4" />
      <bpmn:sequenceFlow id="W5495_Flow11" sourceRef="W5495_Task4" targetRef="W5495_Task5" />
      <bpmn:sequenceFlow id="W5495_Flow12" sourceRef="W5495_Task5" targetRef="W5495_Task6" />
      <bpmn:sequenceFlow id="W5495_Flow13" sourceRef="W5495_Task6" targetRef="W5495_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5495_diag">
      <bpmndi:BPMNPlane id="W5495_plane" bpmnElement="W_W5495">
        <bpmndi:BPMNShape id="W5495_Lane1_di" bpmnElement="W5495_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_Task4_di" bpmnElement="W5495_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_Task5_di" bpmnElement="W5495_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_Task6_di" bpmnElement="W5495_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_Start3_di" bpmnElement="W5495_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_End7_di" bpmnElement="W5495_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5495_Annotation8_di" bpmnElement="W5495_Annotation8"><dc:Bounds x="160" y="290" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5495_Flow10_di" bpmnElement="W5495_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5495_Flow11_di" bpmnElement="W5495_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5495_Flow12_di" bpmnElement="W5495_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5495_Flow13_di" bpmnElement="W5495_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
