        <bpmndi:BPMNShape id="W3914_Start3_di" bpmnElement="W3914_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3914_End7_di" bpmnElement="W3914_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3914_Annotation8_di" bpmnElement="W3914_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3914_Flow10_di" bpmnElement="W3914_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3914_Flow11_di" bpmnElement="W3914_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3914_Flow12_di" bpmnElement="W3914_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3914_Flow13_di" bpmnElement="W3914_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3914_Assoc9_di" bpmnElement="W3914_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3915" name="W3915. Sourcing, Import &amp; Lead-Time Constraint Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Supply plan (W3913); import cycle
Frequency: Monthly + per import shipment
Volume: ~400–600 import TEUs/month; ~400 international vendors; ~PHP 1.4B/month import value
Owner: Sourcing / Import / Supply
Participants: Sourcing (links to VS-122), Import/Customs (links to VS-87/VS-02.2), Supply Planning (links to VS-02), Vendor Mgmt (links to VS-03), Logistics/Freight (links to VS-110/VS-06), Finance/SCF (links to VS-105), Commodity (links to VS-106), DG (links to VS-114)
Source: workflow W3915 — Sourcing, Import &amp; Lead-Time Constraint Planning</bpmn:documentation>
      <bpmn:laneSet id="W3915_LaneSet2">
        <bpmn:lane id="W3915_Lane1" name="Sourcing">
        <bpmn:flowNodeRef>W3915_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3915_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3915_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3915_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3915_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3915_Start3" name="Supply plan (W3913); import cycle">
        <bpmn:outgoing>W3915_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3915_Task4" name="Sourcing/Supply size the import plan from the consensus demand (links to…">
        <bpmn:documentation>Step 1: Sourcing/Supply size the import plan from the consensus demand (links to W3907): container forecast (TEUs), vendor allocation, consolidated-container buying (links to VS-122), and the 45–90-day lead-time phasing (order → produce → ship → customs → DC)
Responsible (R): Sourcing / Supply
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3915_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3915_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3915_Task5" name="Sourcing/Import manage lead-time and supply risk: vendor capacity, ocean…">
        <bpmn:documentation>Step 2: Sourcing/Import manage lead-time and supply risk: vendor capacity, ocean freight (links to VS-110), customs/compliance (links to VS-87), port congestion, DG/hazmat (links to VS-114), commodity availability (links to VS-106), and sourcing-agent performance (links to VS-122)
Responsible (R): Sourcing / Import / Freight
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3915_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3915_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3915_Task6" name="Sourcing/Finance align import financing (LC/TT links to VS-18, SCF links to…">
        <bpmn:documentation>Step 3: Sourcing/Finance align import financing (LC/TT links to VS-18, SCF links to VS-105), and import-vendor trade-compliance/ABC gating (links to VS-86/VS-122), and feed import constraints to pre-S&amp;OP (links to W3916)
Responsible (R): Sourcing / Finance / Customs
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3915_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3915_End7" name="Complete">
        <bpmn:incoming>W3915_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3915_Annotation8">
        <bpmn:text>Controls: - CTL-611 (ensure controlled execution — Supply Reconciliation, Pre-S&amp;OP &amp; Scenario Planning (PA-127.2).) | - operational: long-horizon sensing and safety stock; operational: buffer and freight visibility (links to VS-110/VS-87)
Owner: Sourcing / Import / Supply</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3915_Assoc9" sourceRef="W3915_Annotation8" targetRef="W3915_Start3" associationDirection="None" />
