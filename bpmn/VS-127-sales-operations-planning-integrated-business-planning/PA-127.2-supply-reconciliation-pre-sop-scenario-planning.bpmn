      <bpmn:sequenceFlow id="W3914_Flow11" sourceRef="W3914_Task4" targetRef="W3914_Task5" />
      <bpmn:sequenceFlow id="W3914_Flow12" sourceRef="W3914_Task5" targetRef="W3914_Task6" />
      <bpmn:sequenceFlow id="W3914_Flow13" sourceRef="W3914_Task6" targetRef="W3914_End7" />
    </bpmn:process>
