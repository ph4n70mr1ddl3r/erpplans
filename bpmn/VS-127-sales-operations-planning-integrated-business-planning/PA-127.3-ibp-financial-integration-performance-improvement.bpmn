<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-127.3-ibp-financial-integration-performance-improvement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3921" name="W3921. Financial Reconciliation to Plan (Revenue/Margin/Inventory Budget)" isExecutable="false">
      <bpmn:documentation>Trigger: Plan publication (W3920); financial cycle
Frequency: Monthly + quarterly
Volume: Financial reconciliation across the plan horizon
Owner: S&amp;OP / Finance
Participants: S&amp;OP Lead, Finance/FP&amp;A (links to VS-17.4), Merchandising (links to VS-101), Treasury (links to VS-18), Strategy (links to VS-33), Supply (links to VS-02), Commodity (links to VS-106)
Source: workflow W3921 — Financial Reconciliation to Plan (Revenue/Margin/Inventory Budget)</bpmn:documentation>
      <bpmn:laneSet id="W3921_LaneSet2">
        <bpmn:lane id="W3921_Lane1" name="S&amp;OP">
        <bpmn:flowNodeRef>W3921_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3921_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3921_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3921_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3921_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3921_Start3" name="Plan publication (W3920); financial cycle">
        <bpmn:outgoing>W3921_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3921_Task4" name="S&amp;OP/Finance translate the constrained volume plan (links to W3920) into…">
        <bpmn:documentation>Step 1: S&amp;OP/Finance translate the constrained volume plan (links to W3920) into financial terms: revenue (× price links to VS-01.2), COGS (× cost incl. commodity/FX links to VS-106/VS-18.3), gross margin (links to VS-101), and inventory investment, reconciled to the corporate budget (links to VS-33/VS-17.4)
Responsible (R): S&amp;OP / Finance / Merchandising
Accountable (A): S&amp;OP Lead / FP&amp;A
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3921_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3921_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3921_Task5" name="S&amp;OP/Finance quantify plan-vs-budget gaps (revenue/margin/inventory/EBITDA…">
        <bpmn:documentation>Step 2: S&amp;OP/Finance quantify plan-vs-budget gaps (revenue/margin/inventory/EBITDA links to profile §9.4), identify financial risk (markdown need links to VS-101, commodity exposure links to VS-106, FX links to VS-18.3), and feed gap-closing to exec S&amp;OP (links to W3912/W3919)
Responsible (R): S&amp;OP / Finance / Commodity
Accountable (A): S&amp;OP Lead / FP&amp;A
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3921_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3921_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3921_Task6" name="S&amp;OP/Finance document the financial implications of plan decisions (e.g…">
        <bpmn:documentation>Step 3: S&amp;OP/Finance document the financial implications of plan decisions (e.g., expedite cost, inventory build cost, markdown cost) for the decision record and the IBP steering
Responsible (R): S&amp;OP / Finance
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3921_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3921_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3921_End7" name="Complete">
        <bpmn:incoming>W3921_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3921_Annotation8">
        <bpmn:text>Controls: - CTL-72 (ensure S&amp;OP consensus &amp; financial reconciliation.) | - operational: monthly financial reconciliation; operational: decision costing
Owner: S&amp;OP / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3921_Assoc9" sourceRef="W3921_Annotation8" targetRef="W3921_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3921_Flow10" sourceRef="W3921_Start3" targetRef="W3921_Task4" />
      <bpmn:sequenceFlow id="W3921_Flow11" sourceRef="W3921_Task4" targetRef="W3921_Task5" />
      <bpmn:sequenceFlow id="W3921_Flow12" sourceRef="W3921_Task5" targetRef="W3921_Task6" />
      <bpmn:sequenceFlow id="W3921_Flow13" sourceRef="W3921_Task6" targetRef="W3921_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3921_diag">
      <bpmndi:BPMNPlane id="W3921_plane" bpmnElement="W_W3921">
        <bpmndi:BPMNShape id="W3921_Lane1_di" bpmnElement="W3921_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
