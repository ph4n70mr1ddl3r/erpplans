      <bpmn:sequenceFlow id="W3923_Flow10" sourceRef="W3923_Start3" targetRef="W3923_Task4" />
      <bpmn:sequenceFlow id="W3923_Flow11" sourceRef="W3923_Task4" targetRef="W3923_Task5" />
      <bpmn:sequenceFlow id="W3923_Flow12" sourceRef="W3923_Task5" targetRef="W3923_Task6" />
      <bpmn:sequenceFlow id="W3923_Flow13" sourceRef="W3923_Task6" targetRef="W3923_End7" />
    </bpmn:process>
