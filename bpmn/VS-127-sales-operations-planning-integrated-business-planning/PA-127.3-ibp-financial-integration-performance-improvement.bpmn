      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3922" name="W3922. Merchandise Financial Plan &amp; Open-to-Buy Alignment" isExecutable="false">
      <bpmn:documentation>Trigger: S&amp;OP plan (W3920); MFP/OTB cycle (links to VS-101)
Frequency: Monthly + seasonal
Volume: MFP/OTB by department/category/season
Owner: S&amp;OP / Merchandising
Participants: S&amp;OP Lead, Merchandising/Merch Planners (links to VS-01/VS-101), Finance (links to VS-17.4), Buyers (links to VS-01/VS-03), Supply (links to VS-02), Insights (links to VS-28.1)
Source: workflow W3922 — Merchandise Financial Plan &amp; Open-to-Buy Alignment</bpmn:documentation>
      <bpmn:laneSet id="W3922_LaneSet2">
        <bpmn:lane id="W3922_Lane1" name="S&amp;OP">
        <bpmn:flowNodeRef>W3922_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3922_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3922_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3922_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3922_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3922_Start3" name="S&amp;OP plan (W3920); MFP/OTB cycle (links to VS-101)">
        <bpmn:outgoing>W3922_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3922_Task4" name="S&amp;OP/Merchandising align the S&amp;OP volume plan to the merchandise financial plan…">
        <bpmn:documentation>Step 1: S&amp;OP/Merchandising align the S&amp;OP volume plan to the merchandise financial plan and OTB (links to VS-101): sales plan, receipt plan, markdown budget, IMU/maintained margin, and turn/GMROI/WOS targets, reconciling volume→pesos
Responsible (R): S&amp;OP / Merchandising / Finance
Accountable (A): S&amp;OP Lead / VP Merchandising
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3922_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3922_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3922_Task5" name="S&amp;OP/Merchandising manage OTB consumption against the plan (commitments vs…">
        <bpmn:documentation>Step 2: S&amp;OP/Merchandising manage OTB consumption against the plan (commitments vs open-to-buy links to VS-101), and flag OTB pressure requiring markdown re-plan or receipt re-phasing
Responsible (R): S&amp;OP / Merchandising
Accountable (A): S&amp;OP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3922_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3922_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3922_Task6" name="S&amp;OP/Merchandising feed the seasonal MFP refresh (links to VS-101/profile…">
        <bpmn:documentation>Step 3: S&amp;OP/Merchandising feed the seasonal MFP refresh (links to VS-101/profile §13.2) and align buyer purchase decisions (links to VS-01/VS-03/VS-122) to the constrained plan
Responsible (R): S&amp;OP / Buyers / Merchandising
Accountable (A): S&amp;OP Lead
Duration: Seasonal</bpmn:documentation>
        <bpmn:incoming>W3922_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3922_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3922_End7" name="Complete">
        <bpmn:incoming>W3922_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3922_Annotation8">
        <bpmn:text>Controls: - CTL-612 (ensure controlled execution — IBP Financial Integration, Performance &amp; Continuous Improvement (PA-127.3).) | - operational: OTB tracking and re-phasing; operational: alignment
Owner: S&amp;OP / Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3922_Assoc9" sourceRef="W3922_Annotation8" targetRef="W3922_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3922_Flow10" sourceRef="W3922_Start3" targetRef="W3922_Task4" />
      <bpmn:sequenceFlow id="W3922_Flow11" sourceRef="W3922_Task4" targetRef="W3922_Task5" />
      <bpmn:sequenceFlow id="W3922_Flow12" sourceRef="W3922_Task5" targetRef="W3922_Task6" />
      <bpmn:sequenceFlow id="W3922_Flow13" sourceRef="W3922_Task6" targetRef="W3922_End7" />
    </bpmn:process>
