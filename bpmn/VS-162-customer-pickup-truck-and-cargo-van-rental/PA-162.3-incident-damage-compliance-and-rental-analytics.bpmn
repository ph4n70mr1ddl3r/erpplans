<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-162.3-incident-damage-compliance-and-rental-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4761" name="W4761. Rental Vehicle Accident, Damage &amp; Roadside Event Response" isExecutable="false">
      <bpmn:documentation>Trigger: Telematics crash/harsh-event alert (W4749); customer call-in of accident/damage/breakdown; police/third-party report
Frequency: Per event
Volume: ~accident/damage events benchmarked ~1–3% of rentals
Owner: Rental Program Manager / LP &amp; Safety (VS-23/VS-24)
Participants: Customer, Police, Insurance (VS-26), Maintenance (W4750), Legal (VS-100)
Source: workflow W4761 — Rental Vehicle Accident, Damage &amp; Roadside Event Response</bpmn:documentation>
      <bpmn:laneSet id="W4761_LaneSet2">
        <bpmn:lane id="W4761_Lane1" name="Rental Program">
        <bpmn:flowNodeRef>W4761_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4761_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4761_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4761_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4761_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4761_Start3" name="Telematics crash/harsh-event alert (W4749); customer call-in of…">
        <bpmn:outgoing>W4761_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4761_Task4" name="Triage the event on telematics + customer call: severity, location, injuries…">
        <bpmn:documentation>Step 1: Triage the event on telematics + customer call: severity, location, injuries, third-party involvement, vehicle drivability; if injury/serious → emergency services + notify Safety/LP (VS-24) + Legal (VS-100) + Insurance (VS-26) immediately; capture the customer&#x27;s statement and photos at scene
Responsible (R): Rental Program / LP / Safety
Accountable (A): Rental Program Manager / Safety Officer
Duration: Per event (urgent)</bpmn:documentation>
        <bpmn:incoming>W4761_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4761_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4761_Task5" name="Coordinate roadside response: recovery/tow to nearest approved workshop…">
        <bpmn:documentation>Step 2: Coordinate roadside response: recovery/tow to nearest approved workshop (VS-31/W4750), substitute vehicle for the stranded customer (W4750) if the rental continues, and liaison with police for the incident report (required for insurance W4762 and any third-party claim)
Responsible (R): Rental Program / Fleet
Accountable (A): Rental Program Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4761_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4761_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4761_Task6" name="Document the event end-to-end (telematics snapshot, photos, police report…">
        <bpmn:documentation>Step 3: Document the event end-to-end (telematics snapshot, photos, police report, statements, workshop damage estimate) into the claim file (W4762); preserve evidence per Legal/records (VS-88/VS-100); if the customer was at-fault and LDW declined, trigger deductible recovery (W4756/W4762); if a third party was at-fault, prepare subrogation (W4762)
Responsible (R): Rental Program / LP / Legal
Accountable (A): Rental Program Manager / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4761_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4761_End7" name="Complete">
        <bpmn:incoming>W4761_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4761_Annotation8">
        <bpmn:text>Controls: - CTL-718 (ensure controlled execution — Incident, Damage, Compliance &amp; Rental Analytics (PA-162.3).) | - CTL-718: serious events escalated to Safety/Legal/Insurance immediately; scene evidence (telematics + photos + police report) captured before vehicle moves
Owner: Rental Program Manager / LP &amp; Safety (VS-23/VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4761_Assoc9" sourceRef="W4761_Annotation8" targetRef="W4761_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4761_Flow10" sourceRef="W4761_Start3" targetRef="W4761_Task4" />
      <bpmn:sequenceFlow id="W4761_Flow11" sourceRef="W4761_Task4" targetRef="W4761_Task5" />
      <bpmn:sequenceFlow id="W4761_Flow12" sourceRef="W4761_Task5" targetRef="W4761_Task6" />
      <bpmn:sequenceFlow id="W4761_Flow13" sourceRef="W4761_Task6" targetRef="W4761_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4761_diag">
      <bpmndi:BPMNPlane id="W4761_plane" bpmnElement="W_W4761">
        <bpmndi:BPMNShape id="W4761_Lane1_di" bpmnElement="W4761_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_Task4_di" bpmnElement="W4761_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_Task5_di" bpmnElement="W4761_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_Task6_di" bpmnElement="W4761_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_Start3_di" bpmnElement="W4761_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_End7_di" bpmnElement="W4761_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4761_Annotation8_di" bpmnElement="W4761_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4761_Flow10_di" bpmnElement="W4761_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4761_Flow11_di" bpmnElement="W4761_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4761_Flow12_di" bpmnElement="W4761_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4761_Flow13_di" bpmnElement="W4761_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4761_Assoc9_di" bpmnElement="W4761_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4762" name="W4762. Damage Recovery, Insurance Claim, Deductible Settlement &amp; Subrogation" isExecutable="false">
      <bpmn:documentation>Trigger: Damage event (W4761); return-damage charge (W4759); total loss
Frequency: Per claim
Volume: ~10–35 claims/month, per the W4761 event rate (~1–3% of ~800–1,200 rentals/month)
Owner: Risk &amp; Insurance (VS-26) / Rental Program
Participants: Insurer/broker, Finance (VS-17), Legal (VS-100), Customer, Workshop (VS-31)
Source: workflow W4762 — Damage Recovery, Insurance Claim, Deductible Settlement &amp; Subrogation</bpmn:documentation>
      <bpmn:laneSet id="W4762_LaneSet2">
        <bpmn:lane id="W4762_Lane1" name="Risk &amp; Insurance">
        <bpmn:flowNodeRef>W4762_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4762_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4762_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4762_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4762_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4762_Start3" name="Damage event (W4761); return-damage charge (W4759); total loss">
        <bpmn:outgoing>W4762_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4762_Task4" name="Open the claim with the insurer (CTPL for third-party bodily/property…">
        <bpmn:documentation>Step 1: Open the claim with the insurer (CTPL for third-party bodily/property; comprehensive for own-damage/theft per W4748); submit the evidence file (W4761), workshop estimate (VS-31), and the agreement/LDW election (W4755/W4757); track to settlement
Responsible (R): Risk &amp; Insurance / Workshop
Accountable (A): Risk &amp; Insurance Lead
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4762_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4762_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4762_Task5" name="Settle the customer-deductible: if LDW taken and terms met → no customer…">
        <bpmn:documentation>Step 2: Settle the customer-deductible: if LDW taken and terms met → no customer charge; if LDW declined/at-fault → capture the deductible from the deposit (W4756/W4759) or invoice the customer; reconcile deductible vs repair cost vs insurer settlement; if total-loss, retire the vehicle (W4752) and settle actual-cash-value
Responsible (R): Risk &amp; Insurance / Finance
Accountable (A): Risk &amp; Insurance Lead / Finance
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4762_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4762_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4762_Task6" name="Where a third party is at-fault, pursue subrogation/recovery via Legal (VS-100)…">
        <bpmn:documentation>Step 3: Where a third party is at-fault, pursue subrogation/recovery via Legal (VS-100) against the third party/their insurer; manage unrecovered balances; feed claim outcomes to the loss-experience re-pricing (W4748) and analytics (W4768)
Responsible (R): Risk &amp; Insurance / Legal
Accountable (A): Risk &amp; Insurance Lead / Legal
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W4762_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4762_End7" name="Complete">
        <bpmn:incoming>W4762_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4762_Annotation8">
        <bpmn:text>Controls: - CTL-718 (ensure controlled execution — Incident, Damage, Compliance &amp; Rental Analytics (PA-162.3).) | - CTL-718: deductible collected per LDW election; insurer claim filed with full evidence; subrogation pursued for at-fault third parties; finance-recon
Owner: Risk &amp; Insurance (VS-26) / Rental Program</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4762_Assoc9" sourceRef="W4762_Annotation8" targetRef="W4762_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4762_Flow10" sourceRef="W4762_Start3" targetRef="W4762_Task4" />
      <bpmn:sequenceFlow id="W4762_Flow11" sourceRef="W4762_Task4" targetRef="W4762_Task5" />
      <bpmn:sequenceFlow id="W4762_Flow12" sourceRef="W4762_Task5" targetRef="W4762_Task6" />
      <bpmn:sequenceFlow id="W4762_Flow13" sourceRef="W4762_Task6" targetRef="W4762_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4762_diag">
      <bpmndi:BPMNPlane id="W4762_plane" bpmnElement="W_W4762">
        <bpmndi:BPMNShape id="W4762_Lane1_di" bpmnElement="W4762_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_Task4_di" bpmnElement="W4762_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_Task5_di" bpmnElement="W4762_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_Task6_di" bpmnElement="W4762_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_Start3_di" bpmnElement="W4762_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_End7_di" bpmnElement="W4762_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4762_Annotation8_di" bpmnElement="W4762_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4762_Flow10_di" bpmnElement="W4762_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4762_Flow11_di" bpmnElement="W4762_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4762_Flow12_di" bpmnElement="W4762_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4762_Flow13_di" bpmnElement="W4762_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4762_Assoc9_di" bpmnElement="W4762_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4763" name="W4763. Vehicle Non-Return, Theft &amp; Fraud Recovery (Geofence-Breach Response)" isExecutable="false">
      <bpmn:documentation>Trigger: Vehicle past scheduled return with no check-in; geofence breach alert (W4749); do-not-rent/fraud signal (VS-125)
Frequency: Per event (rare)
Volume: ~non-return/theft events benchmarked &lt;0.5% of rentals
Owner: LP Director (VS-23) / Rental Program
Participants: LP (VS-23), Legal (VS-100), Police, Insurance (VS-26), Telematics (W4749)
Source: workflow W4763 — Vehicle Non-Return, Theft &amp; Fraud Recovery (Geofence-Breach Response)</bpmn:documentation>
      <bpmn:laneSet id="W4763_LaneSet2">
        <bpmn:lane id="W4763_Lane1" name="LP">
        <bpmn:flowNodeRef>W4763_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4763_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4763_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4763_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4763_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4763_Start3" name="Vehicle past scheduled return with no check-in; geofence breach alert (W4749)…">
        <bpmn:outgoing>W4763_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4763_Task4" name="Detect non-return/geofence-breach from telematics (W4749) at the grace-period…">
        <bpmn:documentation>Step 1: Detect non-return/geofence-breach from telematics (W4749) at the grace-period expiry; attempt customer contact (per agreement W4755); if no response or confirmed unauthorized use → escalate to LP (VS-23), begin recovery, and notify Insurance (theft claim W4748) and Legal (VS-100)
Responsible (R): LP / Rental Program
Accountable (A): LP Director
Duration: Per event (urgent)</bpmn:documentation>
        <bpmn:incoming>W4763_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4763_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4763_Task5" name="Use telematics GPS to locate and recover the vehicle with police assistance…">
        <bpmn:documentation>Step 2: Use telematics GPS to locate and recover the vehicle with police assistance (VS-23 coordinates law-enforcement per VS-159 W4694 pattern); file a police report (theft/estafa under the Revised Penal Code / RA 10951); recover via the deposit (W4756) and pursue the customer legally for unpaid rental, damage, and costs
Responsible (R): LP / Legal / Police
Accountable (A): LP Director / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4763_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4763_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4763_Task6" name="Add the offender to the do-not-rent watch-list (W4754); recover via insurance…">
        <bpmn:documentation>Step 3: Add the offender to the do-not-rent watch-list (W4754); recover via insurance if unrecovered (theft claim W4748/W4762); retire the vehicle from the register if not recovered (W4752); feed the event to fraud analytics (VS-125) and the do-not-rent screen
Responsible (R): LP / Legal / Insurance
Accountable (A): LP Director / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4763_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4763_End7" name="Complete">
        <bpmn:incoming>W4763_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4763_Annotation8">
        <bpmn:text>Controls: - CTL-718 (ensure controlled execution — Incident, Damage, Compliance &amp; Rental Analytics (PA-162.3).) | - CTL-718: non-return escalated within grace period; police-led recovery; offender watch-listed; insurance/legal recovery pursued
Owner: LP Director (VS-23) / Rental Program</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4763_Assoc9" sourceRef="W4763_Annotation8" targetRef="W4763_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4763_Flow10" sourceRef="W4763_Start3" targetRef="W4763_Task4" />
      <bpmn:sequenceFlow id="W4763_Flow11" sourceRef="W4763_Task4" targetRef="W4763_Task5" />
      <bpmn:sequenceFlow id="W4763_Flow12" sourceRef="W4763_Task5" targetRef="W4763_Task6" />
      <bpmn:sequenceFlow id="W4763_Flow13" sourceRef="W4763_Task6" targetRef="W4763_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4763_diag">
      <bpmndi:BPMNPlane id="W4763_plane" bpmnElement="W_W4763">
        <bpmndi:BPMNShape id="W4763_Lane1_di" bpmnElement="W4763_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_Task4_di" bpmnElement="W4763_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_Task5_di" bpmnElement="W4763_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_Task6_di" bpmnElement="W4763_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_Start3_di" bpmnElement="W4763_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_End7_di" bpmnElement="W4763_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4763_Annotation8_di" bpmnElement="W4763_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4763_Flow10_di" bpmnElement="W4763_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4763_Flow11_di" bpmnElement="W4763_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4763_Flow12_di" bpmnElement="W4763_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4763_Flow13_di" bpmnElement="W4763_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4763_Assoc9_di" bpmnElement="W4763_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4764" name="W4764. Traffic Violation, Citation &amp; Toll Violation Handling (Customer Recharge)" isExecutable="false">
      <bpmn:documentation>Trigger: Citation/toll notice received by BuildRight (registered owner) for a vehicle during a customer&#x27;s rental
Frequency: Per notice
Volume: ~notices benchmarked ~1–5% of rentals (speeding, no-contact-apprehension, parking, toll)
Owner: Rental Program / Legal-Compliance (VS-100/VS-22)
Participants: LTO/MMDA/toll operator, Customer, Finance (W4760), Legal (VS-100)
Source: workflow W4764 — Traffic Violation, Citation &amp; Toll Violation Handling (Customer Recharge)</bpmn:documentation>
      <bpmn:laneSet id="W4764_LaneSet2">
        <bpmn:lane id="W4764_Lane1" name="Rental Program">
        <bpmn:flowNodeRef>W4764_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4764_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4764_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4764_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4764_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4764_Start3" name="Citation/toll notice received by BuildRight (registered owner) for a vehicle during a…">
        <bpmn:outgoing>W4764_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4764_Task4" name="Receive the citation/toll notice addressed to BuildRight (registered owner)…">
        <bpmn:documentation>Step 1: Receive the citation/toll notice addressed to BuildRight (registered owner); match the notice date/time + plate to the rental record (telematics W4749 + agreement W4755) to identify the customer who was driving; verify via telematics that the vehicle was on-rent to that customer at the time
Responsible (R): Rental Program / Compliance
Accountable (A): Rental Program Manager / Legal
Duration: Per notice</bpmn:documentation>
        <bpmn:incoming>W4764_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4764_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4764_Task5" name="Recharge the penalty + an administrative fee to the customer per the agreement…">
        <bpmn:documentation>Step 2: Recharge the penalty + an administrative fee to the customer per the agreement (W4755): capture from the deposit (W4756) or invoice/bill the customer (W4760); contest the notice if telematics proves the vehicle was elsewhere (false-apprehension defense); pay the uncontested penalty timely to avoid BuildRight liability (registered-owner default)
Responsible (R): Rental Program / Finance / Legal
Accountable (A): Rental Program Manager / Legal
Duration: Per notice</bpmn:documentation>
        <bpmn:incoming>W4764_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4764_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4764_Task6" name="Manage the no-contact-apprehension program (MMDA/LTO NCAP) and toll (RFID)…">
        <bpmn:documentation>Step 3: Manage the no-contact-apprehension program (MMDA/LTO NCAP) and toll (RFID) reconciliation; report repeat-offender customers to the do-not-rent list (W4754); track notice volume as a driver-behavior KPI (links W4768)
Responsible (R): Rental Program / Compliance
Accountable (A): Rental Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4764_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4764_End7" name="Complete">
        <bpmn:incoming>W4764_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4764_Annotation8">
        <bpmn:text>Controls: - CTL-718 (ensure controlled execution — Incident, Damage, Compliance &amp; Rental Analytics (PA-162.3).) | - CTL-718: notices matched to rental within SLA; uncontested paid timely (owner-liability); customer recharged per agreement; repeat offenders watchlisted
Owner: Rental Program / Legal-Compliance (VS-100/VS-22)</bpmn:text>
      </bpmn:textAnnotation>
