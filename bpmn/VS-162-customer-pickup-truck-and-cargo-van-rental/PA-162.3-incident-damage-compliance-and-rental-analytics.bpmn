    <bpmn:process id="W_W4765" name="W4765. Customer Dispute, Complaint &amp; Chargeback Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer disputes a rental charge (W4760), damage/deductible (W4759/W4762), fuel/cleaning/late fee, or files a complaint/chargeback (VS-80/VS-13/W469)
Frequency: Per case
Volume: ~disputes benchmarked ~1–3% of rentals
Owner: Rental Program Manager / CX (VS-13)
Participants: Customer, Finance (VS-80/VS-17), Legal (VS-100), LP (VS-23)
Source: workflow W4765 — Customer Dispute, Complaint &amp; Chargeback Resolution</bpmn:documentation>
      <bpmn:laneSet id="W4765_LaneSet4">
        <bpmn:lane id="W4765_Lane1" name="Rental Counter">
        <bpmn:flowNodeRef>W4765_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4765_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
