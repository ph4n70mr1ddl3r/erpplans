<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-162.2-rental-transaction-counter-operations-and-customer-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4753" name="W4753. Rental Inquiry, Reservation &amp; Availability Promise" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires at rental desk / Pro Desk (VS-43) / app (VS-75) / phone after a bulky purchase or in advance
Frequency: Continuous (per inquiry)
Volume: ~1,500–2,500 inquiries/month across 200 stores, converting to ~800–1,200 rentals/month (~4–6 per store per month; bulky-attach per W4745)
Owner: Rental Counter Associate / Customer Service (VS-07)
Participants: Pro Desk (VS-43), Merchandising (basket), App/Digital (VS-75)
Source: workflow W4753 — Rental Inquiry, Reservation &amp; Availability Promise</bpmn:documentation>
      <bpmn:laneSet id="W4753_LaneSet2">
        <bpmn:lane id="W4753_Lane1" name="Rental Counter Associate">
        <bpmn:flowNodeRef>W4753_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4753_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4753_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4753_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4753_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4753_Start3" name="Customer inquires at rental desk / Pro Desk (VS-43) / app (VS-75) / phone after a bulky…">
        <bpmn:outgoing>W4753_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4753_Task4" name="Capture the rental inquiry: desired vehicle type (pickup vs van — match to the…">
        <bpmn:documentation>Step 1: Capture the rental inquiry: desired vehicle type (pickup vs van — match to the purchased basket), requested window, pickup/return store, intended load (so the right vehicle &amp; tie-downs are assigned per W4746 spec), and customer identification (loyalty/trade account VS-13/VS-43 where available)
Responsible (R): Rental Counter Associate
Accountable (A): Rental Counter Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W4753_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4753_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4753_Task5" name="Check real-time availability against the rental availability calendar…">
        <bpmn:documentation>Step 2: Check real-time availability against the rental availability calendar (telematics W4749 + reservations + in-service status W4750); confirm the vehicle is registered/insured/safety-checked (W4747/W4748/W4750) before promising it; offer alternatives or the next available slot
Responsible (R): Rental Counter Associate / Fleet
Accountable (A): Rental Counter Supervisor
Duration: 2–4 min</bpmn:documentation>
        <bpmn:incoming>W4753_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4753_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4753_Task6" name="Create the reservation with a hold-to time, send confirmation (app/SMS per…">
        <bpmn:documentation>Step 3: Create the reservation with a hold-to time, send confirmation (app/SMS per VS-75), and brief the customer on license/age requirements (W4754), deposit (W4756), and what to bring at pickup
Responsible (R): Rental Counter Associate
Accountable (A): Rental Counter Supervisor
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W4753_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4753_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4753_End7" name="Complete">
        <bpmn:incoming>W4753_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4753_Annotation8">
        <bpmn:text>Controls: - CTL-717 (ensure controlled execution — Rental Transaction, Counter Operations &amp; Customer Onboarding (PA-162.2).) | - CTL-717: reservation only against verified-available, in-service, road-legal vehicles; hold-to time enforced
Owner: Rental Counter Associate / Customer Service (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4753_Assoc9" sourceRef="W4753_Annotation8" targetRef="W4753_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4753_Flow10" sourceRef="W4753_Start3" targetRef="W4753_Task4" />
      <bpmn:sequenceFlow id="W4753_Flow11" sourceRef="W4753_Task4" targetRef="W4753_Task5" />
      <bpmn:sequenceFlow id="W4753_Flow12" sourceRef="W4753_Task5" targetRef="W4753_Task6" />
      <bpmn:sequenceFlow id="W4753_Flow13" sourceRef="W4753_Task6" targetRef="W4753_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4753_diag">
      <bpmndi:BPMNPlane id="W4753_plane" bpmnElement="W_W4753">
        <bpmndi:BPMNShape id="W4753_Lane1_di" bpmnElement="W4753_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_Task4_di" bpmnElement="W4753_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_Task5_di" bpmnElement="W4753_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_Task6_di" bpmnElement="W4753_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_Start3_di" bpmnElement="W4753_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_End7_di" bpmnElement="W4753_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4753_Annotation8_di" bpmnElement="W4753_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4753_Flow10_di" bpmnElement="W4753_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4753_Flow11_di" bpmnElement="W4753_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4753_Flow12_di" bpmnElement="W4753_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4753_Flow13_di" bpmnElement="W4753_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4753_Assoc9_di" bpmnElement="W4753_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4754" name="W4754. Driver-License Verification, Age/Eligibility Check &amp; Driving-Record Screen" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents to take a vehicle (reservation W4753 or walk-up)
Frequency: Per rental
Volume: Every rental (~800–1,200/month across 200 stores)
Owner: Rental Counter Associate / Rental Compliance
Participants: LTO (license validation), Rental Desk, LP (VS-23)
Source: workflow W4754 — Driver-License Verification, Age/Eligibility Check &amp; Driving-Record Screen</bpmn:documentation>
      <bpmn:laneSet id="W4754_LaneSet2">
        <bpmn:lane id="W4754_Lane1" name="Rental Counter Associate">
        <bpmn:flowNodeRef>W4754_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4754_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4754_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4754_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4754_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4754_Start3" name="Customer presents to take a vehicle (reservation W4753 or walk-up)">
        <bpmn:outgoing>W4754_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4754_Task4" name="Inspect the customer&#x27;s valid Philippine driver&#x27;s license (or recognized…">
        <bpmn:documentation>Step 1: Inspect the customer&#x27;s valid Philippine driver&#x27;s license (or recognized foreign/international license): photograph + signature match, not expired, correct restriction code for the vehicle class; verify age meets minimum (typically 21+, with a young-driver surcharge below 25); record license number &amp; expiry
Responsible (R): Rental Counter Associate
Accountable (A): Rental Counter Supervisor
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W4754_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4754_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4754_Task5" name="Screen against a watch/do-not-rent list (prior non-return W4763, unpaid damage…">
        <bpmn:documentation>Step 2: Screen against a watch/do-not-rent list (prior non-return W4763, unpaid damage W4762, fraud VS-125, license revocation); validate the license is not flagged using LTO online lookup where available; refuse rental with documented reason if flagged
Responsible (R): Rental Counter Associate / LP
Accountable (A): Rental Counter Supervisor / LP
Duration: 2–4 min</bpmn:documentation>
        <bpmn:incoming>W4754_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4754_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4754_Task6" name="Record the eligibility decision with the license image + ID selfie (RA…">
        <bpmn:documentation>Step 3: Record the eligibility decision with the license image + ID selfie (RA 10173-consistent, W4755 consent) into the rental record; this is the gate before agreement execution (W4755) — no rental proceeds without a passed eligibility check
Responsible (R): Rental Counter Associate
Accountable (A): Rental Counter Supervisor
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W4754_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4754_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4754_End7" name="Complete">
        <bpmn:incoming>W4754_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4754_Annotation8">
        <bpmn:text>Controls: - CTL-94 (ensure rental fleet safety &amp; settlement integrity.) | - CTL-717: valid license + age + not-on-watch-list required before agreement (gate to W4755); license image + selfie captured with consent
Owner: Rental Counter Associate / Rental Compliance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4754_Assoc9" sourceRef="W4754_Annotation8" targetRef="W4754_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4754_Flow10" sourceRef="W4754_Start3" targetRef="W4754_Task4" />
      <bpmn:sequenceFlow id="W4754_Flow11" sourceRef="W4754_Task4" targetRef="W4754_Task5" />
      <bpmn:sequenceFlow id="W4754_Flow12" sourceRef="W4754_Task5" targetRef="W4754_Task6" />
      <bpmn:sequenceFlow id="W4754_Flow13" sourceRef="W4754_Task6" targetRef="W4754_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4754_diag">
      <bpmndi:BPMNPlane id="W4754_plane" bpmnElement="W_W4754">
        <bpmndi:BPMNShape id="W4754_Lane1_di" bpmnElement="W4754_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_Task4_di" bpmnElement="W4754_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_Task5_di" bpmnElement="W4754_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_Task6_di" bpmnElement="W4754_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_Start3_di" bpmnElement="W4754_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_End7_di" bpmnElement="W4754_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4754_Annotation8_di" bpmnElement="W4754_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4754_Flow10_di" bpmnElement="W4754_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4754_Flow11_di" bpmnElement="W4754_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4754_Flow12_di" bpmnElement="W4754_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4754_Flow13_di" bpmnElement="W4754_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4754_Assoc9_di" bpmnElement="W4754_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4755" name="W4755. Rental Agreement Execution, Liability Waiver &amp; Telematics Consent" isExecutable="false">
      <bpmn:documentation>Trigger: Eligibility passed (W4754); vehicle about to be released
Frequency: Per rental
Volume: Every rental (~800–1,200/month)
Owner: Rental Counter Associate / Legal (VS-100.3)
Participants: Customer, Legal (VS-100), Privacy (VS-91)
Source: workflow W4755 — Rental Agreement Execution, Liability Waiver &amp; Telematics Consent</bpmn:documentation>
      <bpmn:laneSet id="W4755_LaneSet2">
        <bpmn:lane id="W4755_Lane1" name="Rental Counter Associate">
        <bpmn:flowNodeRef>W4755_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4755_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4755_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4755_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4755_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4755_Start3" name="Eligibility passed (W4754); vehicle about to be released">
        <bpmn:outgoing>W4755_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4755_Task4" name="Generate the rental agreement: vehicle (plate/VIN), customer (license W4754)…">
        <bpmn:documentation>Step 1: Generate the rental agreement: vehicle (plate/VIN), customer (license W4754), checkout date/time &amp; odometer, scheduled return, rate structure (W4745), deposit/hold (W4756), LDW election (W4757), permitted-use terms (no sub-rental, no off-road unless specified, no ferry/cross-island outside geofence W4749, no illegal use), and the customer&#x27;s liability for damage/theft/traffic violations
Responsible (R): Rental Counter Associate
Accountable (A): Rental Counter Supervisor / Legal
Duration: 4–6 min</bpmn:documentation>
        <bpmn:incoming>W4755_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4755_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4755_Task5" name="telematics/privacy consent">
        <bpmn:documentation>Step 2: Capture the signed liability acceptance and the telematics/privacy consent (RA 10173) for GPS/speed/harsh-event data (W4749), the personal-data processing for the rental record, and the do-not-rent consequence of breach; make consent granular and recorded
Responsible (R): Rental Counter Associate / Privacy
Accountable (A): Rental Counter Supervisor / DPO
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W4755_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4755_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4755_Task6" name="Execute (e-signature preferred per VS-88/electronic records), store the…">
        <bpmn:documentation>Step 3: Execute (e-signature preferred per VS-88/electronic records), store the agreement in the records system (VS-88 retention 10-yr per BIR / TRAIN NIRC Sec. 235), and link it to the vehicle telematics (W4749) and the billing record (W4760); the signed agreement is the legal basis for all downstream recovery (W4761/W4762/W4763)
Responsible (R): Rental Counter Associate / Legal
Accountable (A): Rental Counter Supervisor
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W4755_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4755_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4755_End7" name="Complete">
        <bpmn:incoming>W4755_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4755_Annotation8">
        <bpmn:text>Controls: - CTL-717 (ensure controlled execution — Rental Transaction, Counter Operations &amp; Customer Onboarding (PA-162.2).) | - CTL-717: signed agreement with liability + telematics consent required before release (gate to W4758); Legal-approved template; consent recorded; retention per VS-88
Owner: Rental Counter Associate / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4755_Assoc9" sourceRef="W4755_Annotation8" targetRef="W4755_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4755_Flow10" sourceRef="W4755_Start3" targetRef="W4755_Task4" />
      <bpmn:sequenceFlow id="W4755_Flow11" sourceRef="W4755_Task4" targetRef="W4755_Task5" />
      <bpmn:sequenceFlow id="W4755_Flow12" sourceRef="W4755_Task5" targetRef="W4755_Task6" />
      <bpmn:sequenceFlow id="W4755_Flow13" sourceRef="W4755_Task6" targetRef="W4755_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4755_diag">
      <bpmndi:BPMNPlane id="W4755_plane" bpmnElement="W_W4755">
        <bpmndi:BPMNShape id="W4755_Lane1_di" bpmnElement="W4755_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_Task4_di" bpmnElement="W4755_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_Task5_di" bpmnElement="W4755_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_Task6_di" bpmnElement="W4755_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_Start3_di" bpmnElement="W4755_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_End7_di" bpmnElement="W4755_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4755_Annotation8_di" bpmnElement="W4755_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4755_Flow10_di" bpmnElement="W4755_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4755_Flow11_di" bpmnElement="W4755_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4755_Flow12_di" bpmnElement="W4755_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4755_Flow13_di" bpmnElement="W4755_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4755_Assoc9_di" bpmnElement="W4755_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4756" name="W4756. Security Deposit Authorization, Card Hold &amp; Pre-Authorization Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Agreement execution (W4755); vehicle release
Frequency: Per rental
Volume: Every rental (~800–1,200/month)
Owner: Rental Counter Associate / Finance-Treasury (VS-18/VS-80)
Participants: Customer, Payment/Acquirer (VS-80), Finance (VS-17)
Source: workflow W4756 — Security Deposit Authorization, Card Hold &amp; Pre-Authorization Capture</bpmn:documentation>
      <bpmn:laneSet id="W4756_LaneSet3">
        <bpmn:lane id="W4756_Lane1" name="Rental Counter Associate">
        <bpmn:flowNodeRef>W4756_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4756_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4756_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4756_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4756_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4756_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4756_Start4" name="Agreement execution (W4755); vehicle release">
        <bpmn:outgoing>W4756_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4756_Task5" name="Authorize the security deposit/pre-authorization at the deductible level set in…">
        <bpmn:documentation>Step 1: Authorize the security deposit/pre-authorization at the deductible level set in W4748 (covering the customer&#x27;s damage/theft exposure without LDW, plus fuel + potential late/overtime + cleaning): place a card hold (VS-80 payment gateway) or accept a cash/security deposit per policy; record the authorization reference
Responsible (R): Rental Counter Associate / Finance
Accountable (A): Rental Counter Supervisor / Finance
Duration: 2–4 min</bpmn:documentation>
        <bpmn:incoming>W4756_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4756_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4756_Task6" name="Confirm the hold succeeded before vehicle release (W4758); explain to the…">
        <bpmn:documentation>Step 2: Confirm the hold succeeded before vehicle release (W4758); explain to the customer how/when the hold is released (W4760) and what charges may be applied (damage, fuel short, late return, cleaning); this is the financial guarantee backing the agreement (W4755)
Responsible (R): Rental Counter Associate / Finance
Accountable (A): Rental Counter Supervisor
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W4756_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4756_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4756_Task7" name="Manage exceptions: insufficient-hold (downgrade vehicle or refuse)…">
        <bpmn:documentation>Step 3: Manage exceptions: insufficient-hold (downgrade vehicle or refuse), cash-deposit handling (VS-08.2 cash controls / VS-81 CIT risk), and the hold-release timing compliance (card holds expire; don&#x27;t release a vehicle without a live hold)
Responsible (R): Finance / Rental Counter
Accountable (A): Rental Counter Supervisor / Finance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4756_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4756_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4756_End8" name="Complete">
        <bpmn:incoming>W4756_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4756_Annotation9">
        <bpmn:text>Controls: - CTL-717 (ensure controlled execution — Rental Transaction, Counter Operations &amp; Customer Onboarding (PA-162.2).) | - CTL-717: confirmed deposit hold required before release (gate to W4758); hold level = deductible; cash deposits via VS-08.2 controls
Owner: Rental Counter Associate / Finance-Treasury (VS-18/VS-80)</bpmn:text>
      </bpmn:textAnnotation>
