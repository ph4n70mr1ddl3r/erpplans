      <bpmn:sequenceFlow id="W4760_Flow12" sourceRef="W4760_Task5" targetRef="W4760_Task6" />
      <bpmn:sequenceFlow id="W4760_Flow13" sourceRef="W4760_Task6" targetRef="W4760_End7" />
    </bpmn:process>
