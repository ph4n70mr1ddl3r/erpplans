    <bpmn:process id="W_W4746" name="W4746. Rental Vehicle Procurement, Specification &amp; Fleet Acquisition" isExecutable="false">
      <bpmn:documentation>Trigger: Fleet-capex approval (W4745); replacement cycle (W4752); new-store rollout
Frequency: Per acquisition batch + annual
Volume: ~150–250 vehicles/yr (fleet build + rolling replacement across 200 stores)
Owner: Rental Program Manager / Procurement (VS-03/VS-34)
Participants: OEM/dealer partners, Finance (VS-17), Fleet (VS-06), Insurance (VS-26)
Source: workflow W4746 — Rental Vehicle Procurement, Specification &amp; Fleet Acquisition</bpmn:documentation>
      <bpmn:laneSet id="W4746_LaneSet4">
        <bpmn:lane id="W4746_Lane1" name="Rental Program Manager">
        <bpmn:flowNodeRef>W4746_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4746_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4746_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4746_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4746_Lane3" name="Fleet">
        <bpmn:flowNodeRef>W4746_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4746_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4746_Start5" name="Fleet-capex approval (W4745); replacement cycle (W4752); new-store rollout">
        <bpmn:outgoing>W4746_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4746_Task6" name="Specify the vehicle requirements: payload (≥1,000 kg for cement/tile pallets &amp;…">
        <bpmn:documentation>Step 1: Specify the vehicle requirements: payload (≥1,000 kg for cement/tile pallets &amp; lumber), cargo length (≥2.4 m pickup bed or ≥3 m van), tie-down points, payload-rated tires, fuel efficiency, spare parts availability across all Philippine regions, warranty, and livery/branding (VS-14)
Responsible (R): Rental Program Manager / Fleet
Accountable (A): COO
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4746_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4746_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4746_Task7" name="Negotiate fleet purchase with OEM/dealer (volume discount, corporate-fleet…">
        <bpmn:documentation>Step 2: Negotiate fleet purchase with OEM/dealer (volume discount, corporate-fleet program, trade-in of retired fleet W4752, after-sales/warranty, parts lead time); structure as capex purchase or operating lease per the W4745 capex case
Responsible (R): Procurement / Rental Program Manager / Finance
Accountable (A): COO / CFO
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4746_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4746_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4746_Task8" name="Receive vehicles, install livery + telematics (W4749) + compulsory equipment…">
        <bpmn:documentation>Step 3: Receive vehicles, install livery + telematics (W4749) + compulsory equipment (early-warning device, fire extinguisher, first-aid, spare tire, jack, tie-down straps), register (W4747), insure (W4748), and commission into the rental fleet at the assigned store
Responsible (R): Fleet / Rental Program Manager
Accountable (A): COO
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4746_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4746_End9" name="Complete">
        <bpmn:incoming>W4746_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4746_Annotation10">
        <bpmn:text>Controls: - CTL-716 (ensure controlled execution — Rental Fleet Strategy, Acquisition &amp; Lifecycle Management (PA-162.1).) | - CTL-716: vehicle spec tied to basket payload; TCO comparison documented; PO via VS-03 gate with VS-26 insurance verified before commissioning
Owner: Rental Program Manager / Procurement (VS-03/VS-34)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4746_Assoc11" sourceRef="W4746_Annotation10" targetRef="W4746_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4746_Flow12" sourceRef="W4746_Start5" targetRef="W4746_Task6" />
      <bpmn:sequenceFlow id="W4746_Flow13" sourceRef="W4746_Task6" targetRef="W4746_Task7" />
      <bpmn:sequenceFlow id="W4746_Flow14" sourceRef="W4746_Task7" targetRef="W4746_Task8" />
      <bpmn:sequenceFlow id="W4746_Flow15" sourceRef="W4746_Task8" targetRef="W4746_End9" />
    </bpmn:process>
