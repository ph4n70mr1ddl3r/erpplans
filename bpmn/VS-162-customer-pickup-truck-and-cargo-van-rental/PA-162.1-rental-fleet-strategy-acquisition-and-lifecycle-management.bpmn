        <bpmndi:BPMNShape id="W4746_Start5_di" bpmnElement="W4746_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4746_End9_di" bpmnElement="W4746_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4746_Annotation10_di" bpmnElement="W4746_Annotation10"><dc:Bounds x="160" y="630" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4746_Flow12_di" bpmnElement="W4746_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4746_Flow13_di" bpmnElement="W4746_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4746_Flow14_di" bpmnElement="W4746_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4746_Flow15_di" bpmnElement="W4746_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4746_Assoc11_di" bpmnElement="W4746_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4747" name="W4747. Rental Vehicle LTO Registration, Conduction Sticker &amp; Motor-Vehicle Titling" isExecutable="false">
      <bpmn:documentation>Trigger: New vehicle commissioning (W4746); annual registration renewal; plate loss/transfer
Frequency: Per vehicle + annual renewal
Volume: ~600–800 vehicles initially; ~600–800 annual renewals + ~150–250 new/retired per year
Owner: Rental Fleet Compliance Officer / Legal (VS-100.3)
Participants: LTO, Fleet (VS-06), Procurement (dealer handover), Insurance (VS-26)
Source: workflow W4747 — Rental Vehicle LTO Registration, Conduction Sticker &amp; Motor-Vehicle Titling</bpmn:documentation>
      <bpmn:laneSet id="W4747_LaneSet2">
        <bpmn:lane id="W4747_Lane1" name="Fleet Compliance">
        <bpmn:flowNodeRef>W4747_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4747_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4747_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4747_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4747_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4747_Start3" name="New vehicle commissioning (W4746); annual registration renewal; plate loss/transfer">
        <bpmn:outgoing>W4747_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4747_Task4" name="For each new vehicle: process Sales Report / Deed of Sale, LTO Initial…">
        <bpmn:documentation>Step 1: For each new vehicle: process Sales Report / Deed of Sale, LTO Initial Registration, MV File Number, official receipt, plates, conduction sticker (for the pre-plate window), and the official CR (Certificate of Registration); record in the fleet/asset register (VS-35/VS-06)
Responsible (R): Fleet Compliance / Fleet
Accountable (A): Rental Program Manager / Legal
Duration: Per vehicle</bpmn:documentation>
        <bpmn:incoming>W4747_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4747_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4747_Task5" name="Maintain the annual LTO registration renewal calendar for the entire fleet…">
        <bpmn:documentation>Step 2: Maintain the annual LTO registration renewal calendar for the entire fleet; coordinate the MVIS / PMVIC inspection, emission test, and Compulsory Third-Party Liability (CTPL) proof; renew before expiry to avoid driving an unregistered vehicle (a criminal/insurance-void offense)
Responsible (R): Fleet Compliance / Fleet
Accountable (A): Rental Program Manager
Duration: Annual + continuous</bpmn:documentation>
        <bpmn:incoming>W4747_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4747_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4747_Task6" name="Manage plate/CRCR transfers on retirement (W4752), lost-plate replacement, and…">
        <bpmn:documentation>Step 3: Manage plate/CRCR transfers on retirement (W4752), lost-plate replacement, and the motor-vehicle title lifecycle; ensure every vehicle on the rental lot has valid, unexpired CR + plate + CTPL before it is ever released to a customer (W4759 release gate)
Responsible (R): Fleet Compliance / Legal
Accountable (A): Rental Program Manager / Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4747_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4747_End7" name="Complete">
        <bpmn:incoming>W4747_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4747_Annotation8">
        <bpmn:text>Controls: - CTL-94 (ensure rental fleet safety &amp; settlement integrity.) | - CTL-716: valid CR + plate + unexpired CTPL required before any customer release (release gate W4759); annual renewal calendar maintained; title chain clean
Owner: Rental Fleet Compliance Officer / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4747_Assoc9" sourceRef="W4747_Annotation8" targetRef="W4747_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4747_Flow10" sourceRef="W4747_Start3" targetRef="W4747_Task4" />
      <bpmn:sequenceFlow id="W4747_Flow11" sourceRef="W4747_Task4" targetRef="W4747_Task5" />
      <bpmn:sequenceFlow id="W4747_Flow12" sourceRef="W4747_Task5" targetRef="W4747_Task6" />
      <bpmn:sequenceFlow id="W4747_Flow13" sourceRef="W4747_Task6" targetRef="W4747_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4747_diag">
      <bpmndi:BPMNPlane id="W4747_plane" bpmnElement="W_W4747">
        <bpmndi:BPMNShape id="W4747_Lane1_di" bpmnElement="W4747_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
