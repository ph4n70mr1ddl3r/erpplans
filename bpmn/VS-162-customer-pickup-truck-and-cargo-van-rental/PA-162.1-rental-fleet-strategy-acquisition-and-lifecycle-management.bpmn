        <bpmndi:BPMNShape id="W4747_Start3_di" bpmnElement="W4747_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4747_End7_di" bpmnElement="W4747_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4747_Annotation8_di" bpmnElement="W4747_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4747_Flow10_di" bpmnElement="W4747_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4747_Flow11_di" bpmnElement="W4747_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4747_Flow12_di" bpmnElement="W4747_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4747_Flow13_di" bpmnElement="W4747_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4747_Assoc9_di" bpmnElement="W4747_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4748" name="W4748. Rental Fleet Insurance Program — CTPL, Comprehensive &amp; Self-Insurance Layer" isExecutable="false">
      <bpmn:documentation>Trigger: Fleet acquisition (W4746); annual policy renewal; claim experience review
Frequency: Per vehicle + annual renewal
Volume: ~600–800 insured vehicles; 1 master fleet policy + per-vehicle CTPL
Owner: Rental Program Manager / Risk &amp; Insurance (VS-26)
Participants: Insurance broker/underwriter, Treasury (VS-18), Legal (VS-100), Finance (VS-17)
Source: workflow W4748 — Rental Fleet Insurance Program — CTPL, Comprehensive &amp; Self-Insurance Layer</bpmn:documentation>
      <bpmn:laneSet id="W4748_LaneSet2">
        <bpmn:lane id="W4748_Lane1" name="Risk &amp; Insurance">
        <bpmn:flowNodeRef>W4748_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4748_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4748_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4748_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4748_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4748_Start3" name="Fleet acquisition (W4746); annual policy renewal; claim experience review">
        <bpmn:outgoing>W4748_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4748_Task4" name="Structure the fleet motor-vehicle insurance program: Compulsory Third-Party…">
        <bpmn:documentation>Step 1: Structure the fleet motor-vehicle insurance program: Compulsory Third-Party Liability (CTPL, mandatory under RA 4136 — the Land Transportation and Traffic Code — for every registered vehicle) for every vehicle; comprehensive own-damage &amp; theft cover (or a documented self-insured retention layer for a 600–800 fleet where it is economic); and a motor fleet excess/umbrella for catastrophic third-party bodily injury, given customers drive into public roads
Responsible (R): Risk &amp; Insurance / Rental Program Manager / Treasury
Accountable (A): Rental Program Manager / Head of Internal Audit &amp; Risk
Duration: Annual + per vehicle</bpmn:documentation>
        <bpmn:incoming>W4748_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4748_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4748_Task5" name="Loss Damage Waiver (LDW)">
        <bpmn:documentation>Step 2: Define and price the customer-facing Loss Damage Waiver (LDW) — the optional add-on (sold at the rental desk W4757) that waives the customer&#x27;s financial responsibility for damage/theft in exchange for a fee — and the per-incident deductible/excess the customer remains liable for without LDW; set the security deposit/hold (W4756) at the deductible level
Responsible (R): Risk &amp; Insurance / Rental Program Manager
Accountable (A): Rental Program Manager / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4748_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4748_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4748_Task6" name="Manage the claim interface between customer incidents (W4761/W4762), the…">
        <bpmn:documentation>Step 3: Manage the claim interface between customer incidents (W4761/W4762), the deductible recovery from the customer deposit/hold, the LDW waiver decision, and the insurer settlement/subrogation; review loss experience annually and re-price LDW/deposit/renewal
Responsible (R): Risk &amp; Insurance / Legal / Claims
Accountable (A): Rental Program Manager / Head of Internal Audit &amp; Risk
Duration: Continuous + annual</bpmn:documentation>
        <bpmn:incoming>W4748_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4748_End7" name="Complete">
        <bpmn:incoming>W4748_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4748_Annotation8">
        <bpmn:text>Controls: - CTL-716 (ensure controlled execution — Rental Fleet Strategy, Acquisition &amp; Lifecycle Management (PA-162.1).) | - CTL-716: every registered vehicle carries CTPL (release gate W4759); LDW/deductible/deposit policy board-approved (Head of Internal Audit &amp; Risk/CFO); annual loss review
Owner: Rental Program Manager / Risk &amp; Insurance (VS-26)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4748_Assoc9" sourceRef="W4748_Annotation8" targetRef="W4748_Start3" associationDirection="None" />
