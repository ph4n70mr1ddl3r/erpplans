<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-162.1-rental-fleet-strategy-acquisition-and-lifecycle-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4745" name="W4745. Self-Haul Rental Fleet Strategy, Sizing &amp; Business Model" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual fleet-capex &amp; pricing review; new-store opening (VS-37); format evolution
Frequency: Annual + on launch/new-store cohort
Volume: 1 group strategy; ~2–3 pickup trucks + 1 cargo van per store → ~600–800 vehicles across 200 stores
Owner: COO / Self-Haul Rental Program Manager
Participants: Store Ops (VS-07), Merchandising (large-item categories), Finance (VS-17.4 FP&amp;A), Fleet (VS-06), Insurance (VS-26)
Source: workflow W4745 — Self-Haul Rental Fleet Strategy, Sizing &amp; Business Model</bpmn:documentation>
      <bpmn:laneSet id="W4745_LaneSet2">
        <bpmn:lane id="W4745_Lane1" name="Rental Program Manager">
        <bpmn:flowNodeRef>W4745_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4745_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4745_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4745_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4745_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4745_Start3" name="Program launch; annual fleet-capex &amp; pricing review; new-store opening (VS-37); format…">
        <bpmn:outgoing>W4745_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4745_Task4" name="Set the fleet strategy &amp; business model: vehicle mix (single-cab &amp; crew-cab…">
        <bpmn:documentation>Step 1: Set the fleet strategy &amp; business model: vehicle mix (single-cab &amp; crew-cab pickups for lumber/yard loads; high-roof cargo van/LCV for appliances/furniture/boxes), fleet size per store sized to bulky-merch attach rate &amp; transaction volume, pricing structure (flat first-75-min fee + hourly + per-km + insurance waiver + fuel), deposit/hold policy, and the sale-conversion KPI the fleet exists to lift (large-item basket completion)
Responsible (R): Rental Program Manager / FP&amp;A
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4745_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4745_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4745_Task5" name="Build the unit-economics &amp; capex case: vehicle depreciation over ~3–5 yr /…">
        <bpmn:documentation>Step 2: Build the unit-economics &amp; capex case: vehicle depreciation over ~3–5 yr / ~80–120k km, CTPL + comprehensive premium, maintenance, fuel, telematics, staffing, insurance-claim reserve vs. rental revenue + attach-uplift; define the hurdle rate and the fleet right-size per store tier (Metro vs provincial; high lumber-yard stores get more pickups)
Responsible (R): Rental Program Manager / FP&amp;A
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4745_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4745_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4745_Task6" name="Approve the annual fleet-capex envelope, integrate into the corporate capex…">
        <bpmn:documentation>Step 3: Approve the annual fleet-capex envelope, integrate into the corporate capex plan (VS-40/VS-112), and define the rollout sequence for new stores (fleet commissioned at store opening per VS-37)
Responsible (R): Rental Program Manager / Finance / PMO (VS-112)
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4745_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4745_End7" name="Complete">
        <bpmn:incoming>W4745_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4745_Annotation8">
        <bpmn:text>Controls: - CTL-716 (ensure controlled execution — Rental Fleet Strategy, Acquisition &amp; Lifecycle Management (PA-162.1).) | - CTL-716: annual business case &amp; pricing reviewed by CFO; fleet count tied to bulky-attach KPI; capex approved via VS-40 gate
Owner: COO / Self-Haul Rental Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4745_Assoc9" sourceRef="W4745_Annotation8" targetRef="W4745_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4745_Flow10" sourceRef="W4745_Start3" targetRef="W4745_Task4" />
      <bpmn:sequenceFlow id="W4745_Flow11" sourceRef="W4745_Task4" targetRef="W4745_Task5" />
      <bpmn:sequenceFlow id="W4745_Flow12" sourceRef="W4745_Task5" targetRef="W4745_Task6" />
      <bpmn:sequenceFlow id="W4745_Flow13" sourceRef="W4745_Task6" targetRef="W4745_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4745_diag">
      <bpmndi:BPMNPlane id="W4745_plane" bpmnElement="W_W4745">
        <bpmndi:BPMNShape id="W4745_Lane1_di" bpmnElement="W4745_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
