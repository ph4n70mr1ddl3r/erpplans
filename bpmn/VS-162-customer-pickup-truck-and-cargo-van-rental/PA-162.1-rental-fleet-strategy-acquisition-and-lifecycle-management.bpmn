    <bpmn:process id="W_W4751" name="W4751. Rental Fleet Cross-Store Rebalancing &amp; Seasonal Demand Matching" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly availability review; seasonal demand shift (VS-64); store opening/closure; localized sell-through event
Frequency: Weekly + seasonal
Volume: ~30–60 inter-store moves/year across 200 stores; 1 group availability view
Owner: Rental Program Manager / Fleet Logistics (VS-06)
Participants: Store Ops (VS-07), Supply Planning (VS-02), Fleet (VS-06)
Source: workflow W4751 — Rental Fleet Cross-Store Rebalancing &amp; Seasonal Demand Matching</bpmn:documentation>
      <bpmn:laneSet id="W4751_LaneSet3">
        <bpmn:lane id="W4751_Lane1" name="Rental Program Manager">
        <bpmn:flowNodeRef>W4751_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4751_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4751_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4751_Lane2" name="Fleet">
        <bpmn:flowNodeRef>W4751_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4751_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4751_Start4" name="Weekly availability review; seasonal demand shift (VS-64); store opening/closure…">
        <bpmn:outgoing>W4751_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4751_Task5" name="Monitor fleet availability &amp; utilization across all 200 stores weekly…">
        <bpmn:documentation>Step 1: Monitor fleet availability &amp; utilization across all 200 stores weekly: utilization rate, turn-down (lost-rental) rate, vehicle downtime, and demand signals (large-item promotions VS-58, seasonal peaks like summer AC/appliance or ber-months furniture per profile §13.2); identify surplus vs deficit stores
Responsible (R): Rental Program Manager / Supply Planning / Fleet
Accountable (A): Rental Program Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W4751_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4751_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4751_Task6" name="Rebalance vehicles inter-store: move surplus trucks/vans from low-demand to…">
        <bpmn:documentation>Step 2: Rebalance vehicles inter-store: move surplus trucks/vans from low-demand to high-demand stores within a region/DC catchment (using VS-06 fleet movement); coordinate seasonal pre-positioning (more pickups to lumber-heavy stores during construction peak; more vans to appliance stores during summer/ber-months)
Responsible (R): Fleet / Rental Program Manager
Accountable (A): Rental Program Manager / COO
Duration: Weekly + seasonal</bpmn:documentation>
        <bpmn:incoming>W4751_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4751_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4751_Task7" name="Right-size per-store allocation over time using utilization data; feed the…">
        <bpmn:documentation>Step 3: Right-size per-store allocation over time using utilization data; feed the annual fleet-sizing &amp; capex case (W4745) and the replacement cycle (W4752); manage the new-store cohort allocation at store opening (VS-37)
Responsible (R): Rental Program Manager / FP&amp;A
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4751_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4751_End8" name="Complete">
        <bpmn:incoming>W4751_Flow14</bpmn:incoming>
      </bpmn:endEvent>
