        <bpmndi:BPMNShape id="W4745_End7_di" bpmnElement="W4745_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4745_Annotation8_di" bpmnElement="W4745_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
