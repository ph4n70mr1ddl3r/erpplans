    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1780" name="W1780. Monthly Financing Partner Statement Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly statement received from financing partner
Frequency: Monthly (~5–8 partner statements)
Volume: ~5–8 reconciliations/month
Owner: Treasury
Participants: Treasury, Revenue Accountant, Accounting Manager
Source: workflow W1780 — Monthly Financing Partner Statement Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1780_LaneSet4">
        <bpmn:lane id="W1780_Lane1" name="Financing Partner">
        <bpmn:flowNodeRef>W1780_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1780_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1780_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W1780_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1780_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1780_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1780_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1780_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1780_Start5" name="Monthly statement received from financing partner">
        <bpmn:outgoing>W1780_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1780_Task6" name="Financing partner provides monthly statement: (a) total transactions processed…">
        <bpmn:documentation>Step 1: Financing partner provides monthly statement: (a) total transactions processed, (b) total settlement amount remitted, (c) total MDR/fees charged, (d) chargebacks and reversals, (e) promotional subsidy adjustments
Responsible (R): Financing Partner
Accountable (A): Treasury
Duration: By 10th of following month</bpmn:documentation>
        <bpmn:incoming>W1780_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1780_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1780_Task7" name="Treasury reconciles monthly statement to internal records: (a) total…">
        <bpmn:documentation>Step 2: Treasury reconciles monthly statement to internal records: (a) total transaction amount: partner total vs. POS total for installment transactions, (b) total settlement received: partner total vs. bank deposits, (c) MDR charged: partner calculation vs. contracted rate × transaction volume, (d) promotional adjustments: verify against approved promotional campaigns, (e) net settlement: partner total vs. GL clearing account balance
Responsible (R): Treasury
Accountable (A): Accounting Manager
Duration: 1 day/partner</bpmn:documentation>
        <bpmn:incoming>W1780_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1780_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1780_Task8" name="Discrepancies investigated and resolved: (a) MDR rate misapplication: compare…">
        <bpmn:documentation>Step 3: Discrepancies investigated and resolved: (a) MDR rate misapplication: compare contracted rate to actual rate charged per transaction, (b) promotional rate discrepancies: verify correct promotional MDR applied during campaign periods, (c) settlement timing: adjust for T+2 or T+3 settlements crossing month-end, (d) adjustments: partner issues credit note or debit memo for confirmed discrepancies
Responsible (R): Treasury / Financing Partner
Accountable (A): Accounting Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1780_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1780_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1780_Task9" name="Accounting Manager reviews and approves monthly reconciliation; adjusts GL…">
        <bpmn:documentation>Step 4: Accounting Manager reviews and approves monthly reconciliation; adjusts GL entries for any reconciling items; reconciliation filed for audit trail
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1780_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1780_End10" name="Complete">
        <bpmn:incoming>W1780_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1780_Annotation11">
        <bpmn:text>Controls: - CTL-357 (ensure controlled execution — Financing Reconciliation &amp; Partner Settlement (PA-38.3).) | - operational: Treasury review and approval gate; periodic reconciliation against source documents
Owner: Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1780_Assoc12" sourceRef="W1780_Annotation11" targetRef="W1780_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1780_Flow13" sourceRef="W1780_Start5" targetRef="W1780_Task6" />
      <bpmn:sequenceFlow id="W1780_Flow14" sourceRef="W1780_Task6" targetRef="W1780_Task7" />
      <bpmn:sequenceFlow id="W1780_Flow15" sourceRef="W1780_Task7" targetRef="W1780_Task8" />
      <bpmn:sequenceFlow id="W1780_Flow16" sourceRef="W1780_Task8" targetRef="W1780_Task9" />
      <bpmn:sequenceFlow id="W1780_Flow17" sourceRef="W1780_Task9" targetRef="W1780_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1780_diag">
      <bpmndi:BPMNPlane id="W1780_plane" bpmnElement="W_W1780">
        <bpmndi:BPMNShape id="W1780_Lane1_di" bpmnElement="W1780_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Lane2_di" bpmnElement="W1780_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Lane3_di" bpmnElement="W1780_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Task6_di" bpmnElement="W1780_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Task7_di" bpmnElement="W1780_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Task8_di" bpmnElement="W1780_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Task9_di" bpmnElement="W1780_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Start5_di" bpmnElement="W1780_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_End10_di" bpmnElement="W1780_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1780_Annotation11_di" bpmnElement="W1780_Annotation11"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1780_Flow13_di" bpmnElement="W1780_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1780_Flow14_di" bpmnElement="W1780_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1780_Flow15_di" bpmnElement="W1780_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1780_Flow16_di" bpmnElement="W1780_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1780_Flow17_di" bpmnElement="W1780_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1780_Assoc12_di" bpmnElement="W1780_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1781" name="W1781. Financing Chargeback &amp; Dispute Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Chargeback received from financing partner (customer disputes transaction)
Frequency: ~50–100 chargebacks/year
Volume: ~0.005% of installment transactions (~50–100 chargebacks/year)
Owner: Store Manager
Participants: Store Manager, Treasury, Legal Counsel, Financing Partner, Customer
Source: workflow W1781 — Financing Chargeback &amp; Dispute Resolution</bpmn:documentation>
      <bpmn:laneSet id="W1781_LaneSet4">
        <bpmn:lane id="W1781_Lane1" name="Financing Partner → Treasury">
        <bpmn:flowNodeRef>W1781_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1781_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1781_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1781_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1781_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W1781_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1781_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1781_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1781_Start5" name="Chargeback received from financing partner (customer disputes transaction)">
        <bpmn:outgoing>W1781_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1781_Task6" name="Financing partner notifies BuildRight of chargeback: (a) customer claims…">
        <bpmn:documentation>Step 1: Financing partner notifies BuildRight of chargeback: (a) customer claims: merchandise not received, defective, or not as described, (b) fraud claim: customer denies making the purchase, (c) processing error: duplicate charge, incorrect amount
Responsible (R): Financing Partner → Treasury
Accountable (A): —
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1781_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1781_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1781_Task7" name="Treasury alerts Store Manager for investigation: (a) pull transaction details…">
        <bpmn:documentation>Step 2: Treasury alerts Store Manager for investigation: (a) pull transaction details (receipt, POS log, sales associate), (b) check delivery status (for ecommerce), (c) review CCTV footage if fraud claim, (d) check return history for the transaction
Responsible (R): Store Manager / Treasury
Accountable (A): —
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1781_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1781_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1781_Task8" name="BuildRight responds to financing partner: (a) provide evidence supporting the…">
        <bpmn:documentation>Step 3: BuildRight responds to financing partner: (a) provide evidence supporting the transaction (signed receipt, delivery confirmation, product description match), (b) if BuildRight accepts chargeback (legitimate dispute): accept loss, process return, reverse transaction, (c) if BuildRight contests: submit representment with evidence to partner, (d) partner makes final determination
Responsible (R): Treasury / Store Manager
Accountable (A): Accounting Manager
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W1781_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1781_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1781_Task9" name="If chargeback upheld: (a) revenue reversed, (b) inventory recovered (if…">
        <bpmn:documentation>Step 4: If chargeback upheld: (a) revenue reversed, (b) inventory recovered (if merchandise returned), (c) chargeback fee (typically PHP 500–1,500) charged as expense, (d) if chargeback overturned: transaction reinstated, funds returned to BuildRight
Responsible (R): Treasury / System
Accountable (A): Accounting Manager
Duration: Per resolution</bpmn:documentation>
        <bpmn:incoming>W1781_Flow16</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1781_End10" name="Complete">
        <bpmn:incoming>W1781_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1781_Annotation11">
        <bpmn:text>Controls: - CTL-357 (ensure controlled execution — Financing Reconciliation &amp; Partner Settlement (PA-38.3).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1781_Assoc12" sourceRef="W1781_Annotation11" targetRef="W1781_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1781_Flow13" sourceRef="W1781_Start5" targetRef="W1781_Task6" />
      <bpmn:sequenceFlow id="W1781_Flow14" sourceRef="W1781_Task6" targetRef="W1781_Task7" />
      <bpmn:sequenceFlow id="W1781_Flow15" sourceRef="W1781_Task7" targetRef="W1781_Task8" />
      <bpmn:sequenceFlow id="W1781_Flow16" sourceRef="W1781_Task8" targetRef="W1781_Task9" />
      <bpmn:sequenceFlow id="W1781_Flow17" sourceRef="W1781_Task9" targetRef="W1781_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1781_diag">
      <bpmndi:BPMNPlane id="W1781_plane" bpmnElement="W_W1781">
        <bpmndi:BPMNShape id="W1781_Lane1_di" bpmnElement="W1781_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1781_Lane2_di" bpmnElement="W1781_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1781_Lane3_di" bpmnElement="W1781_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1781_Task6_di" bpmnElement="W1781_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1781_Task7_di" bpmnElement="W1781_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1781_Task8_di" bpmnElement="W1781_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
