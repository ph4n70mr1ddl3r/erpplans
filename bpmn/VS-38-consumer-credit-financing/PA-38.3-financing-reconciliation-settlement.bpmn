      <bpmn:sequenceFlow id="W1784_Flow15" sourceRef="W1784_Task7" targetRef="W1784_Task8" />
      <bpmn:sequenceFlow id="W1784_Flow16" sourceRef="W1784_Task8" targetRef="W1784_Task9" />
      <bpmn:sequenceFlow id="W1784_Flow17" sourceRef="W1784_Task9" targetRef="W1784_End10" />
    </bpmn:process>
