        <bpmndi:BPMNShape id="W1785_Start4_di" bpmnElement="W1785_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1785_End8_di" bpmnElement="W1785_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1785_Annotation9_di" bpmnElement="W1785_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1785_Flow11_di" bpmnElement="W1785_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1785_Flow12_di" bpmnElement="W1785_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1785_Flow13_di" bpmnElement="W1785_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1785_Flow14_di" bpmnElement="W1785_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1785_Assoc10_di" bpmnElement="W1785_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1786" name="W1786. Annual Financing Program Financial Close &amp; Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual financial close and external audit
Frequency: Annual
Volume: 1 comprehensive review/year
Owner: CFO
Participants: CFO, Treasury, Accounting Manager, External Auditor
Source: workflow W1786 — Annual Financing Program Financial Close &amp; Audit</bpmn:documentation>
      <bpmn:laneSet id="W1786_LaneSet4">
        <bpmn:lane id="W1786_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W1786_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1786_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1786_Lane2" name="External Auditor">
        <bpmn:flowNodeRef>W1786_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1786_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1786_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1786_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1786_Start5" name="Annual financial close and external audit">
        <bpmn:outgoing>W1786_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1786_Task6" name="Year-end financing reconciliation: (a) all partner statements reconciled…">
        <bpmn:documentation>Step 1: Year-end financing reconciliation: (a) all partner statements reconciled through December 31, (b) all unreconciled items resolved or accrued, (c) MDR expense accrued for transactions settled in January but related to December sales, (d) in-house installment AR aged and provisioned per W1778, (e) promotional subsidy accrual for active promotions straddling year-end
Responsible (R): Treasury / Accounting Manager
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1786_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1786_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1786_Task7" name="External auditor review: (a) select sample of installment transactions and…">
        <bpmn:documentation>Step 2: External auditor review: (a) select sample of installment transactions and trace to settlement records, (b) verify revenue recognition per PFRS 15, (c) confirm MDR expense accuracy, (d) review AR aging and bad debt provision adequacy for in-house installment portfolio, (e) verify partner reconciliation completeness, (f) confirm intercompany elimination for Digital Commerce Inc. financing settlements
Responsible (R): External Auditor
Accountable (A): CFO
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1786_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1786_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1786_Task8" name="CFO responds to audit findings; adjusts if needed; includes financing program…">
        <bpmn:documentation>Step 3: CFO responds to audit findings; adjusts if needed; includes financing program disclosures in financial statement notes (related party — if Digital Commerce Inc. settlement terms are non-standard)
Responsible (R): CFO
Accountable (A): External Auditor
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1786_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1786_End9" name="Complete">
        <bpmn:incoming>W1786_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1786_Annotation10">
        <bpmn:text>Controls: - CTL-357 (ensure controlled execution — Financing Reconciliation &amp; Partner Settlement (PA-38.3).) | - operational: CFO review and approval gate; periodic reconciliation against source documents
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1786_Assoc11" sourceRef="W1786_Annotation10" targetRef="W1786_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1786_Flow12" sourceRef="W1786_Start5" targetRef="W1786_Task6" />
      <bpmn:sequenceFlow id="W1786_Flow13" sourceRef="W1786_Task6" targetRef="W1786_Task7" />
      <bpmn:sequenceFlow id="W1786_Flow14" sourceRef="W1786_Task7" targetRef="W1786_Task8" />
      <bpmn:sequenceFlow id="W1786_Flow15" sourceRef="W1786_Task8" targetRef="W1786_End9" />
    </bpmn:process>
