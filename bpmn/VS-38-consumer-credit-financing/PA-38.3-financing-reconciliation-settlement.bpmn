    <bpmn:process id="W_W1785" name="W1785. Ecommerce Financing Settlement Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce financing transactions settled via BuildRight Digital Commerce Inc.
Frequency: Daily
Volume: ~500–1,000 ecommerce financing transactions/month
Owner: Treasury
Participants: Treasury, Ecommerce Operations, Digital Commerce Inc.
Source: workflow W1785 — Ecommerce Financing Settlement Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1785_LaneSet3">
        <bpmn:lane id="W1785_Lane1" name="System">
        <bpmn:flowNodeRef>W1785_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1785_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1785_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W1785_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1785_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1785_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1785_Start4" name="Ecommerce financing transactions settled via BuildRight Digital Commerce Inc.">
        <bpmn:outgoing>W1785_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1785_Task5" name="Ecommerce financing flow: (a) customer selects installment/BNPL on…">
        <bpmn:documentation>Step 1: Ecommerce financing flow: (a) customer selects installment/BNPL on buildright.com.ph, (b) payment gateway (PayMongo/Dragonpay) processes installment with financing partner, (c) BuildRight Digital Commerce Inc. collects payment from gateway, (d) Digital Commerce Inc. remits to BuildRight Depot Inc. per intercompany agreement (daily or weekly), (e) Depot Inc. recognizes revenue at fulfillment (per intercompany arrangement)
Responsible (R): System
Accountable (A): Treasury
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1785_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1785_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1785_Task6" name="Reconciliation layers: (a) ecommerce platform orders → payment gateway records…">
        <bpmn:documentation>Step 2: Reconciliation layers: (a) ecommerce platform orders → payment gateway records → financing partner settlements → Digital Commerce Inc. receipts → Depot Inc. intercompany remittances, (b) each layer reconciled separately, (c) discrepancies between layers investigated and resolved
Responsible (R): Treasury / Ecommerce Operations
Accountable (A): CFO
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W1785_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1785_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1785_Task7" name="Monthly: comprehensive ecommerce financing reconciliation report including all…">
        <bpmn:documentation>Step 3: Monthly: comprehensive ecommerce financing reconciliation report including all layers, intercompany settlement confirmation, and MDR analysis
Responsible (R): Treasury
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1785_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1785_End8" name="Complete">
        <bpmn:incoming>W1785_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1785_Annotation9">
        <bpmn:text>Controls: - CTL-208 (ensure consumer-financing settlement &amp; compliance.) | - operational: periodic reconciliation against source documents
Owner: Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1785_Assoc10" sourceRef="W1785_Annotation9" targetRef="W1785_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1785_Flow11" sourceRef="W1785_Start4" targetRef="W1785_Task5" />
      <bpmn:sequenceFlow id="W1785_Flow12" sourceRef="W1785_Task5" targetRef="W1785_Task6" />
      <bpmn:sequenceFlow id="W1785_Flow13" sourceRef="W1785_Task6" targetRef="W1785_Task7" />
      <bpmn:sequenceFlow id="W1785_Flow14" sourceRef="W1785_Task7" targetRef="W1785_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1785_diag">
      <bpmndi:BPMNPlane id="W1785_plane" bpmnElement="W_W1785">
        <bpmndi:BPMNShape id="W1785_Lane1_di" bpmnElement="W1785_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1785_Lane2_di" bpmnElement="W1785_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
