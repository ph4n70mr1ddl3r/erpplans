        <bpmndi:BPMNEdge id="W1779_Flow17_di" bpmnElement="W1779_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1779_Assoc12_di" bpmnElement="W1779_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
