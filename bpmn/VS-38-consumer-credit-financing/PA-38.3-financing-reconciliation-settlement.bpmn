    <bpmn:process id="W_W1782" name="W1782. MDR Fee Tracking &amp; Expense Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly management reporting
Frequency: Monthly
Volume: ~5–8 partners × monthly reports
Owner: FP&amp;A
Participants: FP&amp;A, Treasury, CFO
Source: workflow W1782 — MDR Fee Tracking &amp; Expense Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1782_LaneSet4">
        <bpmn:lane id="W1782_Lane1" name="System">
        <bpmn:flowNodeRef>W1782_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1782_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1782_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1782_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1782_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1782_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1782_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1782_Start5" name="Monthly management reporting">
        <bpmn:outgoing>W1782_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1782_Task6" name="System tracks MDR fees per transaction: (a) standard credit card MDR: 1.5–2.0%…">
        <bpmn:documentation>Step 1: System tracks MDR fees per transaction: (a) standard credit card MDR: 1.5–2.0%, (b) installment MDR: 2.5–4.0% (higher for longer terms and 0% promotions), (c) BNPL fee: 2–4%, (d) non-card financing fee: 3–5%, (e) fees recorded as selling expense per transaction, allocated to store cost center
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1782_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1782_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1782_Task7" name="Monthly MDR expense report: (a) total MDR expense by partner, (b) MDR as % of…">
        <bpmn:documentation>Step 2: Monthly MDR expense report: (a) total MDR expense by partner, (b) MDR as % of financed sales, (c) MDR rate comparison vs. contracted rates (identify overcharging), (d) MDR by store (identify stores with higher installment usage and higher MDR cost), (e) trend analysis: is MDR cost increasing as % of sales?
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1782_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1782_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1782_Task8" name="CFO uses MDR data for partner renegotiation: (a) aggregate volume provides…">
        <bpmn:documentation>Step 3: CFO uses MDR data for partner renegotiation: (a) aggregate volume provides leverage for better rates, (b) identify partners with highest MDR for targeted negotiation, (c) assess if MDR cost is justified by incremental sales generated by financing
Responsible (R): CFO
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W1782_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1782_End9" name="Complete">
        <bpmn:incoming>W1782_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1782_Annotation10">
        <bpmn:text>Controls: - CTL-208 (ensure consumer-financing settlement &amp; compliance.) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
