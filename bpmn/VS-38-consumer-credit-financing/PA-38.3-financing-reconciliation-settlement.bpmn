<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-38.3-financing-reconciliation-settlement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1779" name="W1779. Financing Partner Daily Settlement Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Daily settlement received from financing partners (T+1 to T+3)
Frequency: Daily (~5–8 partners × 365 days = ~2,000 settlements/year)
Volume: ~4,000 installment transactions/day across all stores (per W747; ~120,000/month)
Owner: Treasury
Participants: Treasury, Revenue Accountant, Accounting Manager
Source: workflow W1779 — Financing Partner Daily Settlement Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1779_LaneSet4">
        <bpmn:lane id="W1779_Lane1" name="Financing Partner → System">
        <bpmn:flowNodeRef>W1779_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1779_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1779_Lane2" name="System">
        <bpmn:flowNodeRef>W1779_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1779_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W1779_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1779_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1779_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1779_Start5" name="Daily settlement received from financing partners (T+1 to T+3)">
        <bpmn:outgoing>W1779_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1779_Task6" name="Financing partner settles daily transactions: (a) bank installment: acquiring…">
        <bpmn:documentation>Step 1: Financing partner settles daily transactions: (a) bank installment: acquiring bank remits net amount (gross − MDR) to BuildRight bank account, (b) non-card financing: partner remits approved transaction amounts, (c) BNPL provider: remits via designated settlement account, (d) settlement file received electronically (per partner: CSV, API, or bank statement)
Responsible (R): Financing Partner → System
Accountable (A): Treasury
Duration: Automated (T+1 to T+3)</bpmn:documentation>
        <bpmn:incoming>W1779_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1779_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1779_Task7" name="System auto-matches settlement records to POS transactions: (a) match on…">
        <bpmn:documentation>Step 2: System auto-matches settlement records to POS transactions: (a) match on: transaction reference, date, amount, terminal ID, (b) matched transactions: system posts receipt to GL (debit cash, credit AR-financing partner), (c) unmatched transactions: flagged for investigation (unreconciled items queue)
Responsible (R): System
Accountable (A): Treasury
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1779_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1779_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1779_Task8" name="Treasury investigates unmatched items: (a) timing differences (settlement…">
        <bpmn:documentation>Step 3: Treasury investigates unmatched items: (a) timing differences (settlement covers different date range than POS), (b) amount discrepancies (MDR calculation differences, promotional rate misapplication), (c) missing transactions (POS transaction not received by partner), (d) resolves within 5 business days; escalates to partner for unresolved items
Responsible (R): Treasury
Accountable (A): Accounting Manager
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W1779_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1779_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1779_Task9" name="Daily reconciliation report: matched count/amount, unmatched count/amount…">
        <bpmn:documentation>Step 4: Daily reconciliation report: matched count/amount, unmatched count/amount, aging of unreconciled items; Accounting Manager reviews material discrepancies
Responsible (R): Treasury
Accountable (A): Accounting Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W1779_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1779_End10" name="Complete">
        <bpmn:incoming>W1779_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1779_Annotation11">
        <bpmn:text>Controls: - CTL-357 (ensure controlled execution — Financing Reconciliation &amp; Partner Settlement (PA-38.3).) | - operational: Treasury review and approval gate; periodic reconciliation against source documents
Owner: Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1779_Assoc12" sourceRef="W1779_Annotation11" targetRef="W1779_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1779_Flow13" sourceRef="W1779_Start5" targetRef="W1779_Task6" />
      <bpmn:sequenceFlow id="W1779_Flow14" sourceRef="W1779_Task6" targetRef="W1779_Task7" />
