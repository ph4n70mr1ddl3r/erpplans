    <bpmn:process id="W_W1611" name="W1611. New Vendor Quality Qualification &amp; First Article Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarding per W42 (Vendor Sourcing &amp; Onboarding in VS-03)
Frequency: ~50–80 new vendors/year
Volume: ~4–7 new vendor qualifications per month
Owner: Quality Manager
Participants: Quality Manager, Buyer, Category Manager, DC Quality Inspector
Source: workflow W1611 — New Vendor Quality Qualification &amp; First Article Inspection</bpmn:documentation>
      <bpmn:laneSet id="W1611_LaneSet4">
        <bpmn:lane id="W1611_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W1611_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1611_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1611_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1611_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1611_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1611_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1611_Lane3" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1611_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1611_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1611_Start5" name="New vendor onboarding per W42 (Vendor Sourcing &amp; Onboarding in VS-03)">
        <bpmn:outgoing>W1611_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1611_Task6" name="Buyer initiates new vendor quality qualification as part of onboarding (W42)…">
        <bpmn:documentation>Step 1: Buyer initiates new vendor quality qualification as part of onboarding (W42); Quality Manager receives notification with vendor profile, product categories, and sample request
Responsible (R): Buyer / Quality Manager
Accountable (A): Category Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1611_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1611_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1611_Task7" name="Quality Manager requests product samples from vendor (minimum 3 units per SKU…">
        <bpmn:documentation>Step 2: Quality Manager requests product samples from vendor (minimum 3 units per SKU for first article inspection); for import vendors: request pre-shipment sample or third-party inspection report
Responsible (R): Quality Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1611_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1611_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1611_Task8" name="DC Quality Inspector performs First Article Inspection (FAI): (a) dimensional…">
        <bpmn:documentation>Step 3: DC Quality Inspector performs First Article Inspection (FAI): (a) dimensional verification against product specification, (b) material/finish quality assessment, (c) functional testing per category checklist, (d) packaging and labeling review, (e) certification documentation verification (PS/ICC/FPA per category), (f) comparison to existing product benchmarks (if replacing incumbent vendor)
Responsible (R): DC Quality Inspector
Accountable (A): Quality Manager
Duration: 30–60 min/SKU</bpmn:documentation>
        <bpmn:incoming>W1611_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1611_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1611_Task9" name="Approved">
        <bpmn:documentation>Step 4: Quality Manager reviews FAI results; classifies: (a) Approved — vendor product meets quality standards; vendor cleared for commercial orders with standard inspection (10% sampling per W1600), (b) Conditional — product acceptable with noted deviations; vendor cleared for trial order with enhanced inspection (100% sampling on first 3 shipments), (c) Rejected — product does not meet quality standards; vendor not cleared; Buyer to source alternative or negotiate vendor quality improvements
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1611_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1611_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1611_Task10" name="FAI record attached to vendor master; initial quality classification (A/B/C/D)…">
        <bpmn:documentation>Step 5: FAI record attached to vendor master; initial quality classification (A/B/C/D) set based on FAI results; sampling plan set per classification
Responsible (R): Quality Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1611_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1611_End11" name="Complete">
        <bpmn:incoming>W1611_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1611_Annotation12">
        <bpmn:text>Controls: - CTL-229 (ensure supplier quality &amp; product-safety verification.) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
