    <bpmn:process id="W_W1614" name="W1614. Quality Cost Analysis &amp; Vendor Chargeback Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly quality cost aggregation or vendor-caused quality event
Frequency: Monthly analysis; ad-hoc chargeback processing
Volume: ~30–50 chargebacks/month
Owner: Quality Manager
Participants: Quality Manager, Controller, Buyer, Category Manager
Source: workflow W1614 — Quality Cost Analysis &amp; Vendor Chargeback Processing</bpmn:documentation>
      <bpmn:laneSet id="W1614_LaneSet5">
        <bpmn:lane id="W1614_Lane1" name="System">
        <bpmn:flowNodeRef>W1614_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1614_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1614_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1614_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1614_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1614_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1614_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W1614_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1614_Lane4" name="Controller">
        <bpmn:flowNodeRef>W1614_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1614_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1614_Start6" name="Monthly quality cost aggregation or vendor-caused quality event">
        <bpmn:outgoing>W1614_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1614_Task7" name="Prevention costs">
        <bpmn:documentation>Step 1: Monthly: System aggregates quality costs across 4 categories: (a) Prevention costs — quality inspection labor, vendor audits, certification management, training, (b) Appraisal costs — inspection equipment, third-party testing, lab supplies, (c) Internal failure costs — scrap, rework, re-inspection, Quality Hold carrying cost, (d) External failure costs — customer returns due to quality, warranty claims, recall costs, lost sales, brand damage (estimated)
Responsible (R): System / Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1614_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1614_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1614_Task8" name="Quality Manager analyzes cost of quality (COQ) as percentage of COGS and…">
        <bpmn:documentation>Step 2: Quality Manager analyzes cost of quality (COQ) as percentage of COGS and revenue; compares to industry benchmarks (target: COQ &lt; 2% of COGS); identifies top cost drivers
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1614_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1614_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1614_Task9" name="For vendor-caused quality events: Quality Manager creates chargeback request —…">
        <bpmn:documentation>Step 3: For vendor-caused quality events: Quality Manager creates chargeback request — (a) documents vendor-caused failure with evidence, (b) calculates chargeback amount: direct cost (product cost + handling + inspection) + consequential cost (lost margin from stockout if applicable), (c) routes to Buyer for vendor negotiation and Controller for GL posting
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain / Controller
Duration: 30 min/event</bpmn:documentation>
        <bpmn:incoming>W1614_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1614_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1614_Task10" name="Buyer negotiates chargeback with vendor — options: (a) direct credit note on…">
        <bpmn:documentation>Step 4: Buyer negotiates chargeback with vendor — options: (a) direct credit note on next payment, (b) product replacement at no charge, (c) future order price concession, (d) combination
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1614_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1614_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1614_Task11" name="Controller processes chargeback settlement: (a) debit vendor AP, (b) credit…">
        <bpmn:documentation>Step 5: Controller processes chargeback settlement: (a) debit vendor AP, (b) credit quality cost recovery account, (c) track chargeback recovery rate (target: &gt; 80% of chargeback amount recovered)
Responsible (R): Controller
Accountable (A): CFO
Duration: 15 min/event</bpmn:documentation>
        <bpmn:incoming>W1614_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1614_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1614_Task12" name="Quarterly: Quality Manager presents COQ trend to executive team with…">
        <bpmn:documentation>Step 6: Quarterly: Quality Manager presents COQ trend to executive team with recommendations for quality investment (e.g., additional inspector, testing equipment) and vendor portfolio optimization
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain / CFO
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1614_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1614_End13" name="Complete">
        <bpmn:incoming>W1614_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1614_Annotation14">
        <bpmn:text>Controls: - CTL-335 (ensure controlled execution — Vendor Quality Management &amp; Audit (PA-31.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1614_Assoc15" sourceRef="W1614_Annotation14" targetRef="W1614_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1614_Flow16" sourceRef="W1614_Start6" targetRef="W1614_Task7" />
