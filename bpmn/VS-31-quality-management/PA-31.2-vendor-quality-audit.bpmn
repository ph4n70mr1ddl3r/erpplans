<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-31.2-vendor-quality-audit" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1608" name="W1608. Vendor Quality Scorecard &amp; Performance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly quality data aggregation cycle
Frequency: Monthly scorecard generation; quarterly review with vendors
Volume: ~800–1,000 active vendors
Owner: Quality Manager
Participants: Quality Manager, Category Managers, Buyers, VP Merchandising
Source: workflow W1608 — Vendor Quality Scorecard &amp; Performance Review</bpmn:documentation>
      <bpmn:laneSet id="W1608_LaneSet3">
        <bpmn:lane id="W1608_Lane1" name="System">
        <bpmn:flowNodeRef>W1608_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1608_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1608_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1608_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1608_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1608_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1608_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1608_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1608_Start4" name="Monthly quality data aggregation cycle">
        <bpmn:outgoing>W1608_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1608_Task5" name="System auto-calculates vendor quality score monthly based on weighted metrics…">
        <bpmn:documentation>Step 1: System auto-calculates vendor quality score monthly based on weighted metrics: (a) GR inspection pass rate (weight 30%) — from W1600/W1601 data, (b) defect rate per million items received (weight 25%), (c) customer complaint rate for vendor&#x27;s products (weight 20%) — from VS-13 data, (d) return-to-vendor rate (weight 15%) — from W88/W1280 data, (e) certification compliance rate (weight 10%) — from W1612 data
Responsible (R): System
Accountable (A): Quality Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1608_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1608_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1608_Task6" name="Quality Manager reviews auto-generated scorecard; validates anomalies (e.g…">
        <bpmn:documentation>Step 2: Quality Manager reviews auto-generated scorecard; validates anomalies (e.g., low score driven by one large defective lot vs. chronic quality issues); adds qualitative notes from DC Quality Inspectors
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1608_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1608_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1608_Task7" name="A (≥ 90)">
        <bpmn:documentation>Step 3: Vendors scored: (a) A (≥ 90): Preferred vendor — eligible for increased volume, relaxed inspection (skip-lot sampling), (b) B (75–89): Acceptable — standard inspection and monitoring, (c) C (60–74): Watch list — enhanced inspection, quarterly review, corrective action plan required, (d) D (&lt; 60): Probation — 90-day improvement window; if no improvement, vendor discontinuation recommended to Category Manager
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1608_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1608_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1608_Task8" name="Quarterly: Quality Manager and Category Manager conduct joint quality review…">
        <bpmn:documentation>Step 4: Quarterly: Quality Manager and Category Manager conduct joint quality review with C/D vendors: (a) present scorecard data, (b) discuss specific quality issues, (c) agree on corrective actions and timeline, (d) document in Vendor Corrective Action Request per W1610
Responsible (R): Quality Manager / Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W1608_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1608_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1608_Task9" name="Quarterly: Quality Manager presents top-level vendor quality summary to VP…">
        <bpmn:documentation>Step 5: Quarterly: Quality Manager presents top-level vendor quality summary to VP Merchandising: (a) overall vendor quality trend, (b) top 10 quality problem vendors, (c) correlation between vendor quality improvements and customer complaint reduction, (d) recommended vendor additions/removals based on quality performance
Responsible (R): Quality Manager
Accountable (A): VP Merchandising
Duration: 30 min/quarter</bpmn:documentation>
        <bpmn:incoming>W1608_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1608_End10" name="Complete">
        <bpmn:incoming>W1608_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1608_Annotation11">
        <bpmn:text>Controls: - CTL-335 (ensure controlled execution — Vendor Quality Management &amp; Audit (PA-31.2).) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1608_Assoc12" sourceRef="W1608_Annotation11" targetRef="W1608_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1608_Flow13" sourceRef="W1608_Start4" targetRef="W1608_Task5" />
      <bpmn:sequenceFlow id="W1608_Flow14" sourceRef="W1608_Task5" targetRef="W1608_Task6" />
      <bpmn:sequenceFlow id="W1608_Flow15" sourceRef="W1608_Task6" targetRef="W1608_Task7" />
      <bpmn:sequenceFlow id="W1608_Flow16" sourceRef="W1608_Task7" targetRef="W1608_Task8" />
      <bpmn:sequenceFlow id="W1608_Flow17" sourceRef="W1608_Task8" targetRef="W1608_Task9" />
      <bpmn:sequenceFlow id="W1608_Flow18" sourceRef="W1608_Task9" targetRef="W1608_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1608_diag">
      <bpmndi:BPMNPlane id="W1608_plane" bpmnElement="W_W1608">
        <bpmndi:BPMNShape id="W1608_Lane1_di" bpmnElement="W1608_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Lane2_di" bpmnElement="W1608_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Task5_di" bpmnElement="W1608_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Task6_di" bpmnElement="W1608_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Task7_di" bpmnElement="W1608_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Task8_di" bpmnElement="W1608_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Task9_di" bpmnElement="W1608_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Start4_di" bpmnElement="W1608_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_End10_di" bpmnElement="W1608_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1608_Annotation11_di" bpmnElement="W1608_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1608_Flow13_di" bpmnElement="W1608_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Flow14_di" bpmnElement="W1608_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Flow15_di" bpmnElement="W1608_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Flow16_di" bpmnElement="W1608_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Flow17_di" bpmnElement="W1608_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Flow18_di" bpmnElement="W1608_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1608_Assoc12_di" bpmnElement="W1608_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1609" name="W1609. Annual Vendor Quality Audit Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit calendar (Q1 planning) or triggered by vendor quality score drop to D-level
Frequency: ~30–40 on-site audits/year (top 20 vendors annually + triggered audits)
Volume: Top 20 vendors (45% of COGS) + ~10–20 triggered audits
Owner: Quality Manager
Participants: Quality Manager, Buyer, Category Manager, vendor quality team
Source: workflow W1609 — Annual Vendor Quality Audit Program</bpmn:documentation>
      <bpmn:laneSet id="W1609_LaneSet2">
        <bpmn:lane id="W1609_Lane1" name="Quality Manager">
        <bpmn:flowNodeRef>W1609_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1609_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1609_Start3" name="Annual audit calendar (Q1 planning) or triggered by vendor quality score drop to D-level">
        <bpmn:outgoing>W1609_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1609_Task4" name="Quality Manager develops annual audit plan: (a) mandatory audits for top 20…">
        <bpmn:documentation>Step 1: Quality Manager develops annual audit plan: (a) mandatory audits for top 20 vendors, (b) triggered audits for D-scored vendors, (c) new vendor audits (first year), (d) focus areas per vendor based on quality scorecard trends (e.g., if paint vendor has high defect rate, focus on colorant mixing and batch consistency)
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 8 hours</bpmn:documentation>
        <bpmn:incoming>W1609_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1609_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1609_Task5" name="Schedule audit with vendor (2–4 weeks lead time); share audit scope and…">
        <bpmn:documentation>Step 2: Schedule audit with vendor (2–4 weeks lead time); share audit scope and checklist; for import vendors: coordinate with buying team for scheduled visit or third-party audit arrangement
Responsible (R): Quality Manager
Accountable (A): —
Duration: 2 hours/audit</bpmn:documentation>
        <bpmn:incoming>W1609_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1609_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1609_Task6" name="On-site audit execution: (a) facility tour (production floor, raw material…">
        <bpmn:documentation>Step 3: On-site audit execution: (a) facility tour (production floor, raw material storage, finished goods warehouse, QC lab), (b) quality management system review (ISO 9001 certification or equivalent, incoming material QC, in-process QC, final QC, non-conformance handling), (c) product-specific inspection (review testing protocols, calibration records, defect tracking), (d) documentation review (certifications, test reports, traceability systems), (e) worker training and competency records
Responsible (R): Quality Manager / Buyer
Accountable (A): VP Supply Chain
Duration: 1 day/vendor (local); 2 days (international)</bpmn:documentation>
        <bpmn:incoming>W1609_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1609_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1609_Task7" name="Audit report: (a) findings categorized as Critical (immediate action required)…">
        <bpmn:documentation>Step 4: Audit report: (a) findings categorized as Critical (immediate action required), Major (corrective action within 30 days), Minor (improvement opportunity), Observation (best practice), (b) evidence photos and documentation, (c) overall audit score, (d) comparison to previous audit score
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/audit</bpmn:documentation>
        <bpmn:incoming>W1609_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1609_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1609_Task8" name="Follow-up: (a) Critical findings — immediate meeting with vendor; supply may be…">
        <bpmn:documentation>Step 5: Follow-up: (a) Critical findings — immediate meeting with vendor; supply may be suspended pending resolution, (b) Major findings — Vendor Corrective Action Request per W1610 with 30-day deadline, (c) Minor/Observation — tracked for next audit review
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/finding</bpmn:documentation>
        <bpmn:incoming>W1609_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1609_End9" name="Complete">
        <bpmn:incoming>W1609_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1609_Annotation10">
        <bpmn:text>Controls: - CTL-229 (ensure supplier quality &amp; product-safety verification.) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1609_Assoc11" sourceRef="W1609_Annotation10" targetRef="W1609_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1609_Flow12" sourceRef="W1609_Start3" targetRef="W1609_Task4" />
      <bpmn:sequenceFlow id="W1609_Flow13" sourceRef="W1609_Task4" targetRef="W1609_Task5" />
      <bpmn:sequenceFlow id="W1609_Flow14" sourceRef="W1609_Task5" targetRef="W1609_Task6" />
      <bpmn:sequenceFlow id="W1609_Flow15" sourceRef="W1609_Task6" targetRef="W1609_Task7" />
      <bpmn:sequenceFlow id="W1609_Flow16" sourceRef="W1609_Task7" targetRef="W1609_Task8" />
      <bpmn:sequenceFlow id="W1609_Flow17" sourceRef="W1609_Task8" targetRef="W1609_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1609_diag">
      <bpmndi:BPMNPlane id="W1609_plane" bpmnElement="W_W1609">
        <bpmndi:BPMNShape id="W1609_Lane1_di" bpmnElement="W1609_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Task4_di" bpmnElement="W1609_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Task5_di" bpmnElement="W1609_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Task6_di" bpmnElement="W1609_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Task7_di" bpmnElement="W1609_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Task8_di" bpmnElement="W1609_Task8"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Start3_di" bpmnElement="W1609_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_End9_di" bpmnElement="W1609_End9"><dc:Bounds x="1470" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1609_Annotation10_di" bpmnElement="W1609_Annotation10"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1609_Flow12_di" bpmnElement="W1609_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Flow13_di" bpmnElement="W1609_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Flow14_di" bpmnElement="W1609_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Flow15_di" bpmnElement="W1609_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Flow16_di" bpmnElement="W1609_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Flow17_di" bpmnElement="W1609_Flow17"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1609_Assoc11_di" bpmnElement="W1609_Assoc11"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1610" name="W1610. Vendor Corrective Action Request (VCAR) Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quality inspection rejection (W1600), vendor audit finding (W1609), or chronic quality issue identified in scorecard (W1608)
Frequency: ~15–25 VCARs/month
Volume: ~200–300 active VCARs/year
Owner: Quality Manager
Participants: Quality Manager, Buyer, Category Manager, vendor quality representative
Source: workflow W1610 — Vendor Corrective Action Request (VCAR) Management</bpmn:documentation>
      <bpmn:laneSet id="W1610_LaneSet3">
        <bpmn:lane id="W1610_Lane1" name="Quality Manager">
        <bpmn:flowNodeRef>W1610_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1610_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W1610_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1610_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1610_Start4" name="Quality inspection rejection (W1600), vendor audit finding (W1609), or chronic quality…">
        <bpmn:outgoing>W1610_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1610_Task5" name="Quality Manager creates VCAR: (a) references source (inspection report, audit…">
        <bpmn:documentation>Step 1: Quality Manager creates VCAR: (a) references source (inspection report, audit finding, complaint analysis), (b) describes non-conformance with evidence (photos, defect data, customer complaint details), (c) specifies severity (Critical/Major/Minor), (d) assigns corrective action deadline (Critical: 7 days; Major: 30 days; Minor: 60 days), (e) sends to vendor via vendor portal (per VPP-001) or email
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 30 min/VCAR</bpmn:documentation>
        <bpmn:incoming>W1610_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task6" name="Vendor acknowledges VCAR within 3 business days; commits to investigation and…">
        <bpmn:documentation>Step 2: Vendor acknowledges VCAR within 3 business days; commits to investigation and corrective action plan
Responsible (R): Vendor
Accountable (A): —
Duration: —</bpmn:documentation>
        <bpmn:incoming>W1610_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task7" name="Vendor submits corrective action plan: (a) root cause analysis (5-Why, fishbone…">
        <bpmn:documentation>Step 3: Vendor submits corrective action plan: (a) root cause analysis (5-Why, fishbone diagram, or equivalent), (b) immediate containment action (what&#x27;s done now to prevent recurrence), (c) permanent corrective action (process/system changes), (d) prevention of recurrence (controls, monitoring), (e) timeline for implementation
Responsible (R): Vendor
Accountable (A): Quality Manager
Duration: Vendor-dependent</bpmn:documentation>
        <bpmn:incoming>W1610_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task8" name="Quality Manager reviews and approves corrective action plan; if inadequate…">
        <bpmn:documentation>Step 4: Quality Manager reviews and approves corrective action plan; if inadequate, requests revision with specific guidance
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 30 min/VCAR</bpmn:documentation>
        <bpmn:incoming>W1610_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task9" name="At corrective action deadline: Quality Manager verifies implementation — (a)…">
        <bpmn:documentation>Step 5: At corrective action deadline: Quality Manager verifies implementation — (a) review vendor-submitted evidence of implementation (updated procedures, test results, training records), (b) for Critical/Major: schedule verification inspection of next shipment, (c) update vendor quality scorecard
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 30 min/VCAR</bpmn:documentation>
        <bpmn:incoming>W1610_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task10" name="Close">
        <bpmn:documentation>Step 6: Close: Quality Manager closes VCAR if corrective action verified as effective; VCAR record retained for 3 years; open VCAR count reflected in vendor quality score
Responsible (R): Quality Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1610_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1610_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1610_Task11" name="Escalation">
        <bpmn:documentation>Step 7: Escalation: If vendor fails to respond within deadline or corrective action is ineffective after 2 attempts: (a) escalate to Category Manager and VP Merchandising, (b) consider enhanced inspection (100% inspection on all shipments), (c) consider vendor probation or discontinuation
Responsible (R): Quality Manager / Category Manager
Accountable (A): VP Merchandising
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1610_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1610_End12" name="Complete">
        <bpmn:incoming>W1610_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1610_Annotation13">
        <bpmn:text>Controls: - CTL-229 (ensure supplier quality &amp; product-safety verification.) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
