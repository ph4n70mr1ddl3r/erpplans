        <bpmndi:BPMNShape id="W1613_End11_di" bpmnElement="W1613_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1613_Annotation12_di" bpmnElement="W1613_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
