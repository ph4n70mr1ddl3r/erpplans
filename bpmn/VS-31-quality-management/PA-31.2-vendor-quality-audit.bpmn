    <bpmn:process id="W_W1612" name="W1612. Vendor Certification &amp; Compliance Document Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarding, certification renewal, or regulatory change
Frequency: Ongoing; ~50–100 certification tracking events/month
Volume: ~800–1,000 vendors × ~3–5 certifications each = ~3,000–5,000 active certification records
Owner: Quality Manager
Participants: Quality Manager, Compliance Officer, Buyer
Source: workflow W1612 — Vendor Certification &amp; Compliance Document Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1612_LaneSet3">
        <bpmn:lane id="W1612_Lane1" name="Quality Manager">
        <bpmn:flowNodeRef>W1612_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1612_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1612_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1612_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1612_Lane2" name="System">
        <bpmn:flowNodeRef>W1612_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1612_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1612_Start4" name="New vendor onboarding, certification renewal, or regulatory change">
        <bpmn:outgoing>W1612_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1612_Task5" name="Create certification record per vendor per certification type: (a) Business…">
        <bpmn:documentation>Step 1: Create certification record per vendor per certification type: (a) Business registration (SEC/DTI), (b) BIR registration (TIN, VAT certificate), (c) Product certifications (PS mark, ICC, FPA registration, DENR ECC), (d) Quality management certifications (ISO 9001, ISO 14001 if applicable), (e) Import-specific certifications (country of origin certificate, phytosanitary certificate for wood products), (f) Insurance certificates (product liability), (g) Philippine-specific: LGU business permit, FDA certification (if applicable to product range)
Responsible (R): Quality Manager / Buyer
Accountable (A): Quality Manager
Duration: 15 min/certification</bpmn:documentation>
        <bpmn:incoming>W1612_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1612_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1612_Task6" name="System monitors certification expiry dates; auto-alerts: (a) 90 days before…">
        <bpmn:documentation>Step 2: System monitors certification expiry dates; auto-alerts: (a) 90 days before expiry — Quality Manager notifies Buyer to request renewal from vendor, (b) 30 days before expiry — escalation to Category Manager, (c) On expiry — vendor flagged as &quot;Certification Expired&quot;; system blocks new PO creation for affected SKUs until certification renewed
Responsible (R): System
Accountable (A): Quality Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1612_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1612_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1612_Task7" name="Vendor submits renewed certification; Quality Manager reviews and updates…">
        <bpmn:documentation>Step 3: Vendor submits renewed certification; Quality Manager reviews and updates record; system unblocks PO creation if previously blocked
Responsible (R): Quality Manager
Accountable (A): —
Duration: 10 min/certification</bpmn:documentation>
        <bpmn:incoming>W1612_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1612_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1612_Task8" name="Quarterly: Quality Manager generates certification compliance dashboard — (a)…">
        <bpmn:documentation>Step 4: Quarterly: Quality Manager generates certification compliance dashboard — (a) percentage of vendors with current certifications, (b) vendors with expiring certifications in next 90 days, (c) vendors blocked due to expired certifications, (d) correlation between certification gaps and quality issues
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W1612_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1612_End9" name="Complete">
        <bpmn:incoming>W1612_Flow16</bpmn:incoming>
      </bpmn:endEvent>
