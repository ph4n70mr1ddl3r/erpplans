      <bpmndi:BPMNPlane id="W1612_plane" bpmnElement="W_W1612">
        <bpmndi:BPMNShape id="W1612_Lane1_di" bpmnElement="W1612_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
