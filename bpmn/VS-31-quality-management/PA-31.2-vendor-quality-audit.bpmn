    <bpmn:process id="W_W1613" name="W1613. Import Vendor Quality &amp; Compliance Pre-Shipment Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Import PO approaches ship-ready status; vendor confirms production complete
Frequency: ~20–30 import POs/month (~40% of vendors are import vendors; per the §6.5 canon)
Volume: ~50–75 pre-shipment verifications/month
Owner: Import Coordinator
Participants: Import Coordinator, Quality Manager, third-party inspection agency, Buyer
Source: workflow W1613 — Import Vendor Quality &amp; Compliance Pre-Shipment Verification</bpmn:documentation>
      <bpmn:laneSet id="W1613_LaneSet4">
        <bpmn:lane id="W1613_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W1613_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1613_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1613_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1613_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1613_Lane2" name="Third-party Inspector">
        <bpmn:flowNodeRef>W1613_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1613_Lane3" name="Quality Manager">
        <bpmn:flowNodeRef>W1613_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1613_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1613_Start5" name="Import PO approaches ship-ready status; vendor confirms production complete">
        <bpmn:outgoing>W1613_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1613_Task6" name="Import Coordinator identifies import POs approaching ship-ready date…">
        <bpmn:documentation>Step 1: Import Coordinator identifies import POs approaching ship-ready date; determines pre-shipment verification requirement based on: (a) vendor quality score (C/D vendors require mandatory PSI), (b) PO value (&gt; PHP 1M requires PSI), (c) product category risk (electrical, chemical categories require PSI), (d) new vendor (first 3 shipments require PSI)
Responsible (R): Import Coordinator
Accountable (A): Supply Chain Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1613_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1613_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1613_Task7" name="For shipments requiring PSI: Import Coordinator engages third-party inspection…">
        <bpmn:documentation>Step 2: For shipments requiring PSI: Import Coordinator engages third-party inspection agency (SGS, Bureau Veritas, Intertek) at vendor&#x27;s location; provides PO specification, quality requirements, and inspection checklist
Responsible (R): Import Coordinator
Accountable (A): Supply Chain Manager
Duration: 1 hour/PO</bpmn:documentation>
        <bpmn:incoming>W1613_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1613_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1613_Task8" name="Third-party inspector performs PSI at vendor facility: (a) quantity…">
        <bpmn:documentation>Step 3: Third-party inspector performs PSI at vendor facility: (a) quantity verification, (b) visual quality inspection per AQL sampling, (c) packaging and marking verification, (d) labeling compliance check, (e) photograph documentation
Responsible (R): Third-party Inspector
Accountable (A): Quality Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1613_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1613_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1613_Task9" name="Pass">
        <bpmn:documentation>Step 4: PSI report reviewed by Quality Manager: (a) Pass — authorize shipment; vendor books freight, (b) Conditional Pass — authorize shipment with rework conditions; vendor corrects minor issues before shipping, (c) Fail — shipment withheld; vendor must correct and resubmit for re-inspection; Buyer notified of delay
Responsible (R): Quality Manager
Accountable (A): Supply Chain Manager
Duration: 30 min/PO</bpmn:documentation>
        <bpmn:incoming>W1613_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1613_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1613_Task10" name="PSI report linked to import PO and container tracking; feeds into PDI at…">
        <bpmn:documentation>Step 5: PSI report linked to import PO and container tracking; feeds into PDI at Philippine port per W1602
Responsible (R): Import Coordinator
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1613_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1613_End11" name="Complete">
        <bpmn:incoming>W1613_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1613_Annotation12">
        <bpmn:text>Controls: - CTL-335 (ensure controlled execution — Vendor Quality Management &amp; Audit (PA-31.2).) | - operational: Import Coordinator review and approval gate
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1613_Assoc13" sourceRef="W1613_Annotation12" targetRef="W1613_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1613_Flow14" sourceRef="W1613_Start5" targetRef="W1613_Task6" />
      <bpmn:sequenceFlow id="W1613_Flow15" sourceRef="W1613_Task6" targetRef="W1613_Task7" />
      <bpmn:sequenceFlow id="W1613_Flow16" sourceRef="W1613_Task7" targetRef="W1613_Task8" />
      <bpmn:sequenceFlow id="W1613_Flow17" sourceRef="W1613_Task8" targetRef="W1613_Task9" />
      <bpmn:sequenceFlow id="W1613_Flow18" sourceRef="W1613_Task9" targetRef="W1613_Task10" />
      <bpmn:sequenceFlow id="W1613_Flow19" sourceRef="W1613_Task10" targetRef="W1613_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1613_diag">
      <bpmndi:BPMNPlane id="W1613_plane" bpmnElement="W_W1613">
        <bpmndi:BPMNShape id="W1613_Lane1_di" bpmnElement="W1613_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1613_Lane2_di" bpmnElement="W1613_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
