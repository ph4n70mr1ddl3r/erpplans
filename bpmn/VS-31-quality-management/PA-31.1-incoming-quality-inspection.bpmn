      <bpmn:startEvent id="W1607_Start4" name="Lumber/building materials goods receipt at DC or store (DSD)">
        <bpmn:outgoing>W1607_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1607_Task5" name="At GR (DC): verify (a) species/grade match PO specification (e.g., Tanguile…">
        <bpmn:documentation>Step 1: At GR (DC): verify (a) species/grade match PO specification (e.g., Tanguile, Apitong, Yakal — Philippine commercial timber species), (b) dimensional check on sample boards (length, width, thickness against tolerance: ±3mm for dimensional lumber), (c) moisture content spot check using pin-type moisture meter (target: &lt; 20% for air-dried; &lt; 15% for kiln-dried), (d) visual check for defects: cracks, knots exceeding grade limits, warping, insect damage, fungal growth
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 15 min/lot</bpmn:documentation>
        <bpmn:incoming>W1607_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1607_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1607_Task6" name="At store DSD: Receiving Clerk performs visual check for obvious defects…">
        <bpmn:documentation>Step 2: At store DSD: Receiving Clerk performs visual check for obvious defects (cracked boards, broken hollow blocks, damaged cement bags); dimensional spot check on sample
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1607_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1607_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1607_Task7" name="Cement quality: (a) check for lumps (indicates moisture exposure — hardened…">
        <bpmn:documentation>Step 3: Cement quality: (a) check for lumps (indicates moisture exposure — hardened cement is unusable), (b) check manufacturing date (cement shelf life ~3 months from manufacture per Philippine standard), (c) check bag integrity (no tears, moisture staining)
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 3 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1607_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1607_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1607_Task8" name="Steel/rebar: (a) check diameter against specification using caliper on sample…">
        <bpmn:documentation>Step 4: Steel/rebar: (a) check diameter against specification using caliper on sample, (b) check for rust (surface rust acceptable; deep pitting is reject), (c) check length per piece, (d) check mill test certificate availability per lot
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 10 min/lot</bpmn:documentation>
        <bpmn:incoming>W1607_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1607_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1607_End9" name="Complete">
        <bpmn:incoming>W1607_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1607_Annotation10">
        <bpmn:text>Controls: - CTL-334 (ensure controlled execution — Incoming Quality Inspection &amp; Control (PA-31.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Quality Inspector (DC); Receiving Clerk (store DSD)</bpmn:text>
      </bpmn:textAnnotation>
