    <bpmn:process id="W_W1603" name="W1603. Batch / Lot Quality Hold &amp; Release" isExecutable="false">
      <bpmn:documentation>Trigger: Quality inspection failure (W1600, W1601, W1602) or external notification (vendor recall notice, customer complaint pattern)
Frequency: ~20–30 quality holds/month across all DCs and stores
Volume: Variable — from single pallet to full container lot
Owner: DC Supervisor (DC holds); Store Manager (store holds)
Participants: DC Quality Inspector, Department Supervisor, Buyer, Category Manager, Compliance Officer
Source: workflow W1603 — Batch / Lot Quality Hold &amp; Release</bpmn:documentation>
      <bpmn:laneSet id="W1603_LaneSet3">
        <bpmn:lane id="W1603_Lane1" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1603_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1603_Lane2" name="System">
        <bpmn:flowNodeRef>W1603_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1603_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1603_Start4" name="Quality inspection failure (W1600, W1601, W1602) or external notification (vendor recall…">
        <bpmn:outgoing>W1603_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1603_Task5" name="System or user places inventory batch/lot in &quot;Quality Hold&quot; status — inventory…">
        <bpmn:documentation>Step 1: System or user places inventory batch/lot in &quot;Quality Hold&quot; status — inventory blocked from sale, allocation, transfer, and ATP calculation; physical items moved to quarantine zone
Responsible (R): DC Quality Inspector / Department Supervisor
Accountable (A): DC Supervisor / Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1603_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1603_Task6" name="Quality Hold record created: hold reason (inspection failure, customer…">
        <bpmn:documentation>Step 2: Quality Hold record created: hold reason (inspection failure, customer complaint pattern, vendor notification, regulatory alert), affected items (SKU, lot/batch number, quantity, locations), hold date, initiating source
Responsible (R): System / DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1603_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1603_Task7" name="Investigation: (a) DC Quality Inspector or Department Supervisor reviews…">
        <bpmn:documentation>Step 3: Investigation: (a) DC Quality Inspector or Department Supervisor reviews quality data for the lot, (b) checks if affected lot is at multiple locations (DCs + stores), (c) if multi-location: system identifies all locations holding the affected lot/batch for potential cascade hold, (d) contacts vendor for technical assessment if root cause unclear
Responsible (R): DC Quality Inspector / Buyer
Accountable (A): DC Supervisor / Category Manager
Duration: 1–4 hours</bpmn:documentation>
        <bpmn:incoming>W1603_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1603_Task8" name="Release — Pass">
        <bpmn:documentation>Step 4: Release — Pass: Investigation confirms quality acceptable; Inspector releases hold; inventory returns to available status; hold record closed with resolution notes
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1603_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1603_Task9" name="Release — Restricted">
        <bpmn:documentation>Step 5: Release — Restricted: Items pass secondary inspection but with restrictions (e.g., sell at specific discount with disclosure, restrict to non-critical applications); system applies restricted status with conditions
Responsible (R): DC Quality Inspector / Category Manager
Accountable (A): DC Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1603_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1603_Task10" name="Reject">
        <bpmn:documentation>Step 6: Reject: Items confirmed defective/unsafe; route to disposition per W91 — RTV (W88/W1280), scrap (W92), or recall (W1610–W1614 per PA-31.3)
Responsible (R): DC Quality Inspector / Buyer
Accountable (A): DC Supervisor / Category Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1603_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1603_Task11" name="Quality Hold aging report: system alerts DC Supervisor for any hold &gt; 48 hours…">
        <bpmn:documentation>Step 7: Quality Hold aging report: system alerts DC Supervisor for any hold &gt; 48 hours without resolution; weekly aging review to prevent indefinite holds that consume warehouse space and working capital
Responsible (R): System / DC Supervisor
Accountable (A): VP Supply Chain
Duration: Automated + 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1603_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1603_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1603_End12" name="Complete">
        <bpmn:incoming>W1603_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1603_Annotation13">
        <bpmn:text>Controls: - CTL-334 (ensure controlled execution — Incoming Quality Inspection &amp; Control (PA-31.1).) | - operational: DC Supervisor (DC holds); Store Manager (store holds) review and approval gate
Owner: DC Supervisor (DC holds); Store Manager (store holds)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1603_Assoc14" sourceRef="W1603_Annotation13" targetRef="W1603_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1603_Flow15" sourceRef="W1603_Start4" targetRef="W1603_Task5" />
      <bpmn:sequenceFlow id="W1603_Flow16" sourceRef="W1603_Task5" targetRef="W1603_Task6" />
      <bpmn:sequenceFlow id="W1603_Flow17" sourceRef="W1603_Task6" targetRef="W1603_Task7" />
      <bpmn:sequenceFlow id="W1603_Flow18" sourceRef="W1603_Task7" targetRef="W1603_Task8" />
      <bpmn:sequenceFlow id="W1603_Flow19" sourceRef="W1603_Task8" targetRef="W1603_Task9" />
      <bpmn:sequenceFlow id="W1603_Flow20" sourceRef="W1603_Task9" targetRef="W1603_Task10" />
      <bpmn:sequenceFlow id="W1603_Flow21" sourceRef="W1603_Task10" targetRef="W1603_Task11" />
      <bpmn:sequenceFlow id="W1603_Flow22" sourceRef="W1603_Task11" targetRef="W1603_End12" />
    </bpmn:process>
