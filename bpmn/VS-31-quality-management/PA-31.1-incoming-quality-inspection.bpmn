    <bpmn:process id="W_W1607" name="W1607. Lumber &amp; Building Materials Dimensional &amp; Structural Quality Check" isExecutable="false">
      <bpmn:documentation>Trigger: Lumber/building materials goods receipt at DC or store (DSD)
Frequency: ~100–150 lumber/building materials GRs/month (high-value, bulky items)
Volume: ~4,900 active SKUs in Lumber &amp; Building Materials category
Owner: DC Quality Inspector (DC); Receiving Clerk (store DSD)
Participants: DC Quality Inspector, Receiving Clerk, Department Supervisor, Buyer
Source: workflow W1607 — Lumber &amp; Building Materials Dimensional &amp; Structural Quality Check</bpmn:documentation>
      <bpmn:laneSet id="W1607_LaneSet3">
        <bpmn:lane id="W1607_Lane1" name="DC Quality Inspector">
