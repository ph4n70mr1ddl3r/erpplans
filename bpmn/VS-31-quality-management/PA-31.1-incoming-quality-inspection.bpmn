        <bpmn:flowNodeRef>W1605_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1605_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1605_Start5" name="Paint/chemical goods receipt at DC or store; or periodic shelf-life audit">
        <bpmn:outgoing>W1605_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1605_Task6" name="At GR: verify (a) FPA (Fertilizer and Pesticide Authority) registration for…">
        <bpmn:documentation>Step 1: At GR: verify (a) FPA (Fertilizer and Pesticide Authority) registration for applicable products, (b) DENR Environmental Compliance Certificate (ECC) reference for restricted chemicals, (c) batch/lot number recorded in system, (d) manufacturing date and shelf life check (paint: 24–36 months from manufacture; adhesives: 12–18 months), (e) packaging integrity (no leaking, bulging, or dented containers)
Responsible (R): DC Quality Inspector / Receiving Clerk
Accountable (A): DC Supervisor
Duration: 10 min/lot</bpmn:documentation>
        <bpmn:incoming>W1605_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1605_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1605_Task7" name="Spot test: (a) paint viscosity check (visual — no excessive thickening or…">
        <bpmn:documentation>Step 2: Spot test: (a) paint viscosity check (visual — no excessive thickening or separation), (b) colorant compatibility verification for tinting bases, (c) solvent/chemical flash point documentation check for hazmat storage compliance
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 5 min/lot</bpmn:documentation>
        <bpmn:incoming>W1605_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1605_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1605_Task8" name="Shelf-life audit (monthly): system generates list of paint/chemical inventory…">
        <bpmn:documentation>Step 3: Shelf-life audit (monthly): system generates list of paint/chemical inventory approaching expiry (within 6 months); Department Supervisor or Stock Associate checks physical condition of flagged items; items within 3 months of expiry flagged for markdown (W93); items past expiry quarantined for disposal per W82 (hazmat)
Responsible (R): Department Supervisor / Stock Associate
Accountable (A): Store Manager / DC Supervisor
Duration: 2 hours/location/month</bpmn:documentation>
        <bpmn:incoming>W1605_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1605_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1605_Task9" name="Buyer notified of quality issues; vendor-specific trend tracked; repeated…">
        <bpmn:documentation>Step 4: Buyer notified of quality issues; vendor-specific trend tracked; repeated quality failures trigger vendor quality audit per W1608
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1605_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1605_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1605_End10" name="Complete">
        <bpmn:incoming>W1605_Flow17</bpmn:incoming>
      </bpmn:endEvent>
