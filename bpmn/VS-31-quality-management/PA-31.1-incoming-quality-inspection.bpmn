    <bpmn:process id="W_W1605" name="W1605. Paint &amp; Chemical Product Quality Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Paint/chemical goods receipt at DC or store; or periodic shelf-life audit
Frequency: ~200–300 paint/chemical GRs/month; monthly shelf-life audit
Volume: ~2,800 active SKUs in Paint &amp; Finishes category
Owner: DC Quality Inspector (DC); Department Supervisor (store)
Participants: DC Quality Inspector, Department Supervisor, Buyer, Compliance Officer
Source: workflow W1605 — Paint &amp; Chemical Product Quality Verification</bpmn:documentation>
      <bpmn:laneSet id="W1605_LaneSet4">
        <bpmn:lane id="W1605_Lane1" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1605_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1605_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1605_Start5</bpmn:flowNodeRef>
