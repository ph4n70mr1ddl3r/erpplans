<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-31.1-incoming-quality-inspection" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1600" name="W1600. DC Goods Receipt Quality Sampling &amp; Acceptance" isExecutable="false">
      <bpmn:documentation>Trigger: Goods receipt at DC (against PO or transfer order per W18/W4)
Frequency: ~6,000 goods receipts/month across 4 DCs
Volume: ~1,500 GRs/DC/month; quality sampling on ~40% of GRs (high-value, new vendor, seasonal, flagged categories)
Owner: DC Quality Inspector
Participants: DC Quality Inspector, Receiving Clerk, DC Supervisor, Buyer
Source: workflow W1600 — DC Goods Receipt Quality Sampling &amp; Acceptance</bpmn:documentation>
      <bpmn:laneSet id="W1600_LaneSet5">
        <bpmn:lane id="W1600_Lane1" name="System">
        <bpmn:flowNodeRef>W1600_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1600_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1600_Lane2" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1600_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1600_Lane3" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1600_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1600_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1600_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1600_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1600_Lane4" name="DC Supervisor">
        <bpmn:flowNodeRef>W1600_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1600_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1600_Start6" name="Goods receipt at DC (against PO or transfer order per W18/W4)">
        <bpmn:outgoing>W1600_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1600_Task7" name="System auto-flags GR for quality inspection based on rules: (a) new vendor…">
        <bpmn:documentation>Step 1: System auto-flags GR for quality inspection based on rules: (a) new vendor (first 3 shipments), (b) vendor with quality score &lt; 80%, (c) high-value PO line &gt; PHP 500K, (d) category flagged for inspection (electrical, paint/chemical, power tools), (e) random sample at configurable rate per category (default 10%)
Responsible (R): System
Accountable (A): DC Supervisor
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1600_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1600_Task8" name="Receiving Clerk completes standard GR (quantity, condition check); system…">
        <bpmn:documentation>Step 2: Receiving Clerk completes standard GR (quantity, condition check); system places flagged items in &quot;Quality Hold&quot; status — inventory recorded but unavailable for allocation or shipment
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor
Duration: 5 min/pallet</bpmn:documentation>
        <bpmn:incoming>W1600_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1600_Task9" name="DC Quality Inspector pulls AQL sampling plan per SKU category (per W1604…">
        <bpmn:documentation>Step 3: DC Quality Inspector pulls AQL sampling plan per SKU category (per W1604 configuration): (a) selects random sample from received lot per AQL table (e.g., ISO 2859-1 General Inspection Level II), (b) performs visual inspection (packaging integrity, labeling accuracy, product appearance), (c) performs dimensional/functional checks per category checklist (electrical: plug fit test; tools: torque test; tiles: dimensional tolerance ±1mm), (d) checks required certifications/markings (PS mark, ICC sticker, FPA registration for chemicals)
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 15–30 min/lot</bpmn:documentation>
        <bpmn:incoming>W1600_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1600_Task10" name="Pass">
        <bpmn:documentation>Step 4: Pass: Inspector records &quot;Accept&quot; in quality inspection module; system releases inventory from Quality Hold to available stock; GR proceeds to putaway per W18
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1600_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1600_Task11" name="Fail — Minor">
        <bpmn:documentation>Step 5: Fail — Minor: Inspector records defect type and quantity; system accepts lot with defect notation; defect rate feeds vendor scorecard per W44; inventory released with &quot;Accepted with Deviation&quot; status
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1600_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1600_Task12" name="Fail — Major/Reject">
        <bpmn:documentation>Step 6: Fail — Major/Reject: Inspector records &quot;Reject&quot; with defect description and photos; system keeps inventory in Quality Hold; notifies Buyer and Category Manager; defective items quarantined for RTV per W88/W1280 or vendor negotiation; acceptable portion released
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor / Buyer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1600_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1600_Task13" name="Monthly: DC Supervisor generates quality inspection summary report — pass rate…">
        <bpmn:documentation>Step 7: Monthly: DC Supervisor generates quality inspection summary report — pass rate by vendor, by category, by DC; defect trend analysis; feeds into vendor quality review per W1608 (W31.2)
Responsible (R): DC Supervisor
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1600_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1600_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1600_End14" name="Complete">
        <bpmn:incoming>W1600_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1600_Annotation15">
        <bpmn:text>Controls: - CTL-334 (ensure controlled execution — Incoming Quality Inspection &amp; Control (PA-31.1).) | - operational: DC Quality Inspector review and approval gate
Owner: DC Quality Inspector</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1600_Assoc16" sourceRef="W1600_Annotation15" targetRef="W1600_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1600_Flow17" sourceRef="W1600_Start6" targetRef="W1600_Task7" />
      <bpmn:sequenceFlow id="W1600_Flow18" sourceRef="W1600_Task7" targetRef="W1600_Task8" />
      <bpmn:sequenceFlow id="W1600_Flow19" sourceRef="W1600_Task8" targetRef="W1600_Task9" />
      <bpmn:sequenceFlow id="W1600_Flow20" sourceRef="W1600_Task9" targetRef="W1600_Task10" />
      <bpmn:sequenceFlow id="W1600_Flow21" sourceRef="W1600_Task10" targetRef="W1600_Task11" />
      <bpmn:sequenceFlow id="W1600_Flow22" sourceRef="W1600_Task11" targetRef="W1600_Task12" />
      <bpmn:sequenceFlow id="W1600_Flow23" sourceRef="W1600_Task12" targetRef="W1600_Task13" />
      <bpmn:sequenceFlow id="W1600_Flow24" sourceRef="W1600_Task13" targetRef="W1600_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1600_diag">
      <bpmndi:BPMNPlane id="W1600_plane" bpmnElement="W_W1600">
        <bpmndi:BPMNShape id="W1600_Lane1_di" bpmnElement="W1600_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
