    <bpmn:process id="W_W1604" name="W1604. AQL Sampling Plan Configuration &amp; Category Management" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU category created, vendor quality issue identified, or annual quality policy review
Frequency: Quarterly review; ad-hoc updates as needed
Volume: ~13 product categories with distinct sampling plans
Owner: Quality Manager (proposed new role under VP Supply Chain)
Participants: Quality Manager, Category Managers, DC Supervisor, VP Supply Chain
Source: workflow W1604 — AQL Sampling Plan Configuration &amp; Category Management</bpmn:documentation>
      <bpmn:laneSet id="W1604_LaneSet2">
        <bpmn:lane id="W1604_Lane1" name="Quality Manager">
        <bpmn:flowNodeRef>W1604_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1604_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1604_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1604_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1604_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1604_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1604_Start3" name="New SKU category created, vendor quality issue identified, or annual quality policy review">
        <bpmn:outgoing>W1604_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1604_Task4" name="Quality Manager reviews AQL sampling parameters per category: (a) inspection…">
        <bpmn:documentation>Step 1: Quality Manager reviews AQL sampling parameters per category: (a) inspection level (I, II, III, or S-1 through S-4 per ISO 2859-1), (b) AQL limit (% defective acceptable: Critical 0, Major 1.0–2.5, Minor 2.5–6.5), (c) sampling size based on lot size and inspection level, (d) accept/reject numbers per sample size
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1604_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1604_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1604_Task5" name="Category-specific configurations: (a) Electrical — 100% certification check…">
        <bpmn:documentation>Step 2: Category-specific configurations: (a) Electrical — 100% certification check (PS/ICC mark), functional test on sample, (b) Paint/Chemical — batch/lot verification, shelf life check, FPA registration, (c) Power Tools — functional test sample, safety guard check, (d) Tiles — dimensional tolerance check, breakage rate, (e) Lumber — moisture content spot check, dimensional check, grading verification, (f) Hardware/Fasteners — dimension, material, and finish check on sample
Responsible (R): Quality Manager
Accountable (A): Category Managers
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1604_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1604_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1604_Task6" name="System updates AQL configuration; new parameters applied to next quality…">
        <bpmn:documentation>Step 3: System updates AQL configuration; new parameters applied to next quality inspection event; historical parameters retained for audit trail
Responsible (R): Quality Manager / System
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1604_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1604_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1604_Task7" name="Annual: Quality Manager reviews sampling effectiveness — compare inspection…">
        <bpmn:documentation>Step 4: Annual: Quality Manager reviews sampling effectiveness — compare inspection pass rates to actual customer complaint and return rates per category; adjust sampling stringency if gap detected
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W1604_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1604_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1604_End8" name="Complete">
        <bpmn:incoming>W1604_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1604_Annotation9">
        <bpmn:text>Controls: - CTL-334 (ensure controlled execution — Incoming Quality Inspection &amp; Control (PA-31.1).) | - operational: Quality Manager (proposed new role under VP Supply Chain) review and approval gate
Owner: Quality Manager (proposed new role under VP Supply Chain)</bpmn:text>
      </bpmn:textAnnotation>
