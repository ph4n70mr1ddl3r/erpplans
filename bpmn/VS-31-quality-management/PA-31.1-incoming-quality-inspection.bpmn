    <bpmn:process id="W_W1601" name="W1601. Store-Level DSD Quality Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Direct store delivery (DSD) goods arrival at store — ~500–600 DSD receipts/month (~30% of inbound by value)
Frequency: ~2–3 DSD deliveries per store per month (varies; stores with lumber/cement yards receive more)
Volume: ~500–600 DSD receipts/month across 200 stores (per profile §7.1 and the Trigger)
Owner: Receiving Clerk
Participants: Receiving Clerk, Department Supervisor, Vendor Driver
Source: workflow W1601 — Store-Level DSD Quality Verification</bpmn:documentation>
      <bpmn:laneSet id="W1601_LaneSet3">
        <bpmn:lane id="W1601_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1601_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1601_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1601_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1601_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1601_Start4" name="Direct store delivery (DSD) goods arrival at store — ~500–600 DSD receipts/month (~30% of…">
        <bpmn:outgoing>W1601_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1601_Task5" name="Vendor driver arrives with delivery; Receiving Clerk accesses PO/ASN in system…">
        <bpmn:documentation>Step 1: Vendor driver arrives with delivery; Receiving Clerk accesses PO/ASN in system; checks delivery against expected PO: vendor, items, quantities
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1601_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1601_Task6" name="Quick quality verification: (a) visual inspection of packaging integrity (no…">
        <bpmn:documentation>Step 2: Quick quality verification: (a) visual inspection of packaging integrity (no crushed boxes, wet damage, broken seals), (b) count check against packing slip, (c) check cement for clumping/lumpiness (indicates moisture exposure), (d) check lumber for warping, cracks, or insect damage, (e) check tile boxes for breakage (shake test — rattling indicates broken tiles inside)
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5 min/delivery</bpmn:documentation>
        <bpmn:incoming>W1601_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1601_Task7" name="Accept">
        <bpmn:documentation>Step 3: Accept: Clerk processes GR in system; inventory updated; driver signs delivery receipt
Responsible (R): Receiving Clerk
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W1601_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1601_Task8" name="Partial Reject">
        <bpmn:documentation>Step 4: Partial Reject: Clerk records damaged/defective items with photo; processes GR for accepted quantity only; rejected items returned on driver&#x27;s truck; system creates discrepancy record for AP matching per W7
Responsible (R): Receiving Clerk
Accountable (A): Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1601_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1601_Task9" name="Full Reject">
        <bpmn:documentation>Step 5: Full Reject: Clerk refuses delivery; records rejection reason with photos; notifies Buyer; system creates rejection record; vendor must reschedule delivery
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1601_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1601_Task10" name="Weekly: Store Manager reviews DSD rejection rate; stores with rejection rate &gt;…">
        <bpmn:documentation>Step 6: Weekly: Store Manager reviews DSD rejection rate; stores with rejection rate &gt; 5% flagged for Buyer investigation of vendor delivery quality
Responsible (R): Store Manager
Accountable (A): VP Merchandising
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W1601_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1601_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1601_End11" name="Complete">
        <bpmn:incoming>W1601_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1601_Annotation12">
        <bpmn:text>Controls: - CTL-334 (ensure controlled execution — Incoming Quality Inspection &amp; Control (PA-31.1).) | - operational: Receiving Clerk review and approval gate
Owner: Receiving Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1601_Assoc13" sourceRef="W1601_Annotation12" targetRef="W1601_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1601_Flow14" sourceRef="W1601_Start4" targetRef="W1601_Task5" />
      <bpmn:sequenceFlow id="W1601_Flow15" sourceRef="W1601_Task5" targetRef="W1601_Task6" />
      <bpmn:sequenceFlow id="W1601_Flow16" sourceRef="W1601_Task6" targetRef="W1601_Task7" />
      <bpmn:sequenceFlow id="W1601_Flow17" sourceRef="W1601_Task7" targetRef="W1601_Task8" />
      <bpmn:sequenceFlow id="W1601_Flow18" sourceRef="W1601_Task8" targetRef="W1601_Task9" />
      <bpmn:sequenceFlow id="W1601_Flow19" sourceRef="W1601_Task9" targetRef="W1601_Task10" />
      <bpmn:sequenceFlow id="W1601_Flow20" sourceRef="W1601_Task10" targetRef="W1601_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1601_diag">
      <bpmndi:BPMNPlane id="W1601_plane" bpmnElement="W_W1601">
        <bpmndi:BPMNShape id="W1601_Lane1_di" bpmnElement="W1601_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
