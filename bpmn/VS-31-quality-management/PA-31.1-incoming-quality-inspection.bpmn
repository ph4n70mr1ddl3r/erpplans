    <bpmn:process id="W_W1606" name="W1606. Electrical Product Safety Verification &amp; Certification Check" isExecutable="false">
      <bpmn:documentation>Trigger: Electrical product goods receipt at DC
Frequency: ~150–200 electrical product GRs/month (~3,500 active SKUs)
Volume: Focus on wiring, breakers, switches, panels — safety-critical items
Owner: DC Quality Inspector
Participants: DC Quality Inspector, Buyer, Compliance Officer
Source: workflow W1606 — Electrical Product Safety Verification &amp; Certification Check</bpmn:documentation>
      <bpmn:laneSet id="W1606_LaneSet2">
        <bpmn:lane id="W1606_Lane1" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1606_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1606_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1606_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1606_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1606_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1606_Start3" name="Electrical product goods receipt at DC">
        <bpmn:outgoing>W1606_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1606_Task4" name="At GR: verify (a) PS (Philippine Standard) mark or ICC (Import Commodity…">
        <bpmn:documentation>Step 1: At GR: verify (a) PS (Philippine Standard) mark or ICC (Import Commodity Clearance) sticker on product and packaging, (b) DTI-BPS certification reference in vendor documentation, (c) product labeling compliance (voltage rating, wattage, country of origin, importer information), (d) for import electrical items: Bureau of Customs import clearance and BPS test report
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 10 min/lot</bpmn:documentation>
        <bpmn:incoming>W1606_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1606_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1606_Task5" name="Functional spot test on sample: (a) wire: conductor count, insulation thickness…">
        <bpmn:documentation>Step 2: Functional spot test on sample: (a) wire: conductor count, insulation thickness visual check, (b) breakers/switches: physical integrity, no cracks or damage, (c) continuity test on sample wires using multimeter
Responsible (R): DC Quality Inspector
Accountable (A): DC Supervisor
Duration: 10 min/lot</bpmn:documentation>
        <bpmn:incoming>W1606_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1606_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1606_Task6" name="Non-compliant items: (a) items missing PS/ICC marks placed in Quality Hold per…">
        <bpmn:documentation>Step 3: Non-compliant items: (a) items missing PS/ICC marks placed in Quality Hold per W1603, (b) Buyer notified to contact vendor for certification documentation or product replacement, (c) items without valid certification cannot be released for sale — BuildRight liability for selling uncertified electrical products per Philippine Consumer Act (RA 7394) and DTI regulations
Responsible (R): DC Quality Inspector / Buyer
Accountable (A): DC Supervisor / Compliance Officer
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1606_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1606_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1606_End7" name="Complete">
        <bpmn:incoming>W1606_Flow13</bpmn:incoming>
      </bpmn:endEvent>
