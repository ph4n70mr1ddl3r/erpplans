        <bpmndi:BPMNShape id="W1601_Task9_di" bpmnElement="W1601_Task9"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1601_Task10_di" bpmnElement="W1601_Task10"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1601_Start4_di" bpmnElement="W1601_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1601_End11_di" bpmnElement="W1601_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1601_Annotation12_di" bpmnElement="W1601_Annotation12"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1601_Flow14_di" bpmnElement="W1601_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow15_di" bpmnElement="W1601_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow16_di" bpmnElement="W1601_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow17_di" bpmnElement="W1601_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow18_di" bpmnElement="W1601_Flow18"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow19_di" bpmnElement="W1601_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Flow20_di" bpmnElement="W1601_Flow20"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1601_Assoc13_di" bpmnElement="W1601_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1602" name="W1602. Import Shipment Pre-Delivery Inspection (PDI)" isExecutable="false">
      <bpmn:documentation>Trigger: Import container arrives at Philippine port; customs clearance pending or completed
Frequency: ~400–600 TEUs/month
Volume: ~100–150 TEUs/week requiring PDI
Owner: Supply Chain Manager — Imports
Participants: Import Coordinator, Customs Broker, DC Quality Inspector, Buyer
Source: workflow W1602 — Import Shipment Pre-Delivery Inspection (PDI)</bpmn:documentation>
      <bpmn:laneSet id="W1602_LaneSet4">
        <bpmn:lane id="W1602_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W1602_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1602_Lane2" name="DC Quality Inspector">
        <bpmn:flowNodeRef>W1602_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1602_Lane3" name="Supply Chain Manager">
        <bpmn:flowNodeRef>W1602_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1602_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1602_Start5" name="Import container arrives at Philippine port; customs clearance pending or completed">
        <bpmn:outgoing>W1602_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1602_Task6" name="Import Coordinator receives container arrival notice from shipping line…">
        <bpmn:documentation>Step 1: Import Coordinator receives container arrival notice from shipping line; schedules PDI at port/warehouse or at DC depending on customs status
Responsible (R): Import Coordinator
Accountable (A): Supply Chain Manager
Duration: 30 min/container</bpmn:documentation>
        <bpmn:incoming>W1602_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task7" name="DC Quality Inspector performs PDI at container opening: (a) container condition…">
        <bpmn:documentation>Step 2: DC Quality Inspector performs PDI at container opening: (a) container condition check (seal integrity, water ingress, pest evidence, temperature log if applicable), (b) damage assessment of visible outer cartons, (c) count check of pallets/cartons against packing list, (d) random sampling of inner contents (open 3–5 cartons per container for detailed inspection), (e) photograph container condition and any damage
Responsible (R): DC Quality Inspector
Accountable (A): Supply Chain Manager
Duration: 1–2 hours/container</bpmn:documentation>
        <bpmn:incoming>W1602_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task8" name="Pass">
        <bpmn:documentation>Step 3: Pass: Inspector signs PDI report; container released to DC for standard GR per W18
Responsible (R): DC Quality Inspector
Accountable (A): Supply Chain Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1602_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task9" name="Fail — Damage">
        <bpmn:documentation>Step 4: Fail — Damage: Inspector documents damage with photos; notifies Import Coordinator; initiates cargo insurance claim per W26.3/W837; salvageable goods processed at discounted valuation; damaged goods dispositioned per W91
Responsible (R): DC Quality Inspector
Accountable (A): Supply Chain Manager / Insurance Officer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1602_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task10" name="Fail — Quality">
        <bpmn:documentation>Step 5: Fail — Quality: Inspector documents quality defects; notifies Buyer; Buyer contacts vendor for remediation (replacement shipment, credit note, price concession); defective goods quarantined pending vendor response
Responsible (R): DC Quality Inspector / Buyer
Accountable (A): Supply Chain Manager / Category Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1602_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task11" name="Import Coordinator files carrier claim for transit damage if carrier liability…">
        <bpmn:documentation>Step 6: Import Coordinator files carrier claim for transit damage if carrier liability established; tracks claim through to settlement
Responsible (R): Import Coordinator
Accountable (A): Supply Chain Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1602_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1602_Task12" name="Monthly: Supply Chain Manager reviews import PDI report — damage rate by origin…">
        <bpmn:documentation>Step 7: Monthly: Supply Chain Manager reviews import PDI report — damage rate by origin port, carrier, and vendor; feeds into carrier selection and vendor quality evaluation
Responsible (R): Supply Chain Manager
Accountable (A): VP Supply Chain
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1602_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1602_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1602_End13" name="Complete">
        <bpmn:incoming>W1602_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1602_Annotation14">
        <bpmn:text>Controls: - CTL-229 (ensure supplier quality &amp; product-safety verification.) | - operational: Supply Chain Manager — Imports review and approval gate
Owner: Supply Chain Manager — Imports</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1602_Assoc15" sourceRef="W1602_Annotation14" targetRef="W1602_Start5" associationDirection="None" />
