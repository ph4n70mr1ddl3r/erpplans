    <bpmn:process id="W_W1620" name="W1620. Product Safety Testing &amp; Certification Renewal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Certification renewal cycle, new product introduction, or quality investigation
Frequency: ~50–100 certification renewals/year; ~20–30 new product certifications
Volume: ~800–1,000 SKUs requiring product safety certification
Owner: Quality Manager
Participants: Quality Manager, Category Manager, Buyer, third-party testing laboratory
Source: workflow W1620 — Product Safety Testing &amp; Certification Renewal Management</bpmn:documentation>
      <bpmn:laneSet id="W1620_LaneSet4">
        <bpmn:lane id="W1620_Lane1" name="System">
        <bpmn:flowNodeRef>W1620_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1620_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1620_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1620_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1620_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1620_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1620_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1620_Lane3" name="Testing Laboratory">
        <bpmn:flowNodeRef>W1620_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1620_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1620_Start5" name="Certification renewal cycle, new product introduction, or quality investigation">
        <bpmn:outgoing>W1620_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1620_Task6" name="System tracks product safety certification status per SKU: (a) certification…">
        <bpmn:documentation>Step 1: System tracks product safety certification status per SKU: (a) certification type (PS mark, ICC, FPA, DENR, FDA), (b) issuing body (DTI-BPS, FPA, DENR-EMB), (c) certification number and validity period, (d) renewal requirements (testing, documentation, fees)
Responsible (R): System
Accountable (A): Quality Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1620_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1620_Task7" name="120 days before certification expiry: system generates renewal task; Quality…">
        <bpmn:documentation>Step 2: 120 days before certification expiry: system generates renewal task; Quality Manager coordinates with Category Manager and Buyer to: (a) determine if SKU will remain active (discontinuing SKUs do not need renewal), (b) collect product samples for testing, (c) engage accredited testing laboratory (preferably DTI-BPS recognized lab)
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 1 hour/SKU</bpmn:documentation>
        <bpmn:incoming>W1620_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1620_Task8" name="Testing laboratory conducts product testing per applicable Philippine National…">
        <bpmn:documentation>Step 3: Testing laboratory conducts product testing per applicable Philippine National Standard (PNS): (a) electrical products: PNS IEC standards (safety, performance), (b) paint/chemical: PNS paint standards (lead content, volatile organic compounds), (c) construction materials: PNS structural standards (cement, steel, tiles), (d) timeline: 30–60 days for standard testing
Responsible (R): Testing Laboratory
Accountable (A): Quality Manager
Duration: 30–60 days</bpmn:documentation>
        <bpmn:incoming>W1620_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1620_Task9" name="Pass">
        <bpmn:documentation>Step 4: Test results received: (a) Pass: Quality Manager submits test report and application to DTI-BPS/FPA/DENR for certification renewal, (b) Fail: Quality Manager notifies Category Manager and Buyer; product cannot be sold after current certification expires; vendor notified for corrective action per W1610; inventory disposition decision needed (sell through before expiry, RTV, or scrap)
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 2 hours/SKU</bpmn:documentation>
        <bpmn:incoming>W1620_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1620_Task10" name="Renewal approval received from issuing body; update certification record in…">
        <bpmn:documentation>Step 5: Renewal approval received from issuing body; update certification record in system; update product master with new certification validity period
Responsible (R): Quality Manager
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1620_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1620_Task11" name="Annual: Quality Manager reviews certification portfolio — (a) percentage of…">
        <bpmn:documentation>Step 6: Annual: Quality Manager reviews certification portfolio — (a) percentage of active SKUs with current certification, (b) upcoming renewal wave and resource planning, (c) testing cost analysis, (d) recommendation for SKU rationalization (SKUs with high certification cost relative to revenue)
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours/year</bpmn:documentation>
        <bpmn:incoming>W1620_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1620_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1620_End12" name="Complete">
        <bpmn:incoming>W1620_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1620_Annotation13">
        <bpmn:text>Controls: - CTL-336 (ensure controlled execution — Product Recall &amp; Safety Compliance (PA-31.3).) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1620_Assoc14" sourceRef="W1620_Annotation13" targetRef="W1620_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1620_Flow15" sourceRef="W1620_Start5" targetRef="W1620_Task6" />
