<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-31.3-product-recall-safety-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1615" name="W1615. Product Recall Assessment &amp; Decision" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor recall notice, regulatory directive (DTI, DENR, FDA), or internal safety investigation finding
Frequency: ~2–4 recall assessments/year (most do not result in full recall)
Volume: Low frequency but high impact per event
Owner: Compliance Officer
Participants: Compliance Officer, VP Merchandising, Quality Manager, Category Manager, Legal Counsel, VP Supply Chain
Source: workflow W1615 — Product Recall Assessment &amp; Decision</bpmn:documentation>
      <bpmn:laneSet id="W1615_LaneSet4">
        <bpmn:lane id="W1615_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W1615_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1615_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1615_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1615_Lane2" name="System">
        <bpmn:flowNodeRef>W1615_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1615_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1615_Lane3" name="Recall Assessment Team">
        <bpmn:flowNodeRef>W1615_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1615_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1615_Start5" name="Vendor recall notice, regulatory directive (DTI, DENR, FDA), or internal safety…">
        <bpmn:outgoing>W1615_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1615_Task6" name="Recall trigger received: (a) vendor issues recall notice (e.g., power tool…">
        <bpmn:documentation>Step 1: Recall trigger received: (a) vendor issues recall notice (e.g., power tool safety defect, paint lead content exceedance), (b) DTI/DENR/FDA issues product safety advisory, (c) internal quality investigation identifies safety risk (e.g., customer injury report linked to product), (d) media/social media report of product safety issue
Responsible (R): Compliance Officer / Quality Manager
Accountable (A): VP Merchandising
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1615_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1615_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1615_Task7" name="Critical">
        <bpmn:documentation>Step 2: Compliance Officer convenes Recall Assessment Team (Compliance, Quality, Category Manager, Legal, Supply Chain); initial assessment: (a) identify affected product(s) and lot/batch numbers, (b) determine affected inventory locations (DCs, stores, in-transit), (c) determine if product has been sold to customers (sales history by lot/batch), (d) assess risk severity: (i) Critical — injury or death risk (electrical shock, structural failure, toxic exposure), (ii) High — property damage risk or non-critical injury, (iii) Medium — product does not meet specification but no immediate safety risk, (iv) Low — labeling or documentation issue
Responsible (R): Compliance Officer
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1615_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1615_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1615_Task8" name="System identifies: (a) all inventory locations holding affected lot/batch, (b)…">
        <bpmn:documentation>Step 3: System identifies: (a) all inventory locations holding affected lot/batch, (b) quantity on hand vs. quantity sold, (c) customer purchase records for sold items (POS transaction history with lot/batch traceability), (d) ecommerce order records with customer contact information
Responsible (R): System
Accountable (A): Compliance Officer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1615_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1615_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1615_Task9" name="Full Recall">
        <bpmn:documentation>Step 4: Recall decision: (a) Full Recall (Critical/High severity) — remove all affected product from sale; notify all customers who purchased affected product; public advisory, (b) Market Withdrawal (Medium severity) — remove affected product from sale; customer notification via targeted communication; no public advisory unless escalated, (c) Stock Correction (Low severity) — replace or relabel affected inventory; no customer notification required, (d) No Action — risk assessment does not warrant recall; document decision with rationale
Responsible (R): Recall Assessment Team
Accountable (A): CEO / COO (Critical); VP Merchandising (High/Medium)
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1615_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1615_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1615_Task10" name="If Full Recall or Market Withdrawal: system immediately blocks affected SKU/lot…">
        <bpmn:documentation>Step 5: If Full Recall or Market Withdrawal: system immediately blocks affected SKU/lot from: (a) POS sale, (b) ecommerce availability, (c) store replenishment, (d) transfer orders
Responsible (R): System / Compliance Officer
Accountable (A): VP Supply Chain
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1615_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1615_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1615_End11" name="Complete">
        <bpmn:incoming>W1615_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1615_Annotation12">
        <bpmn:text>Controls: - CTL-336 (ensure controlled execution — Product Recall &amp; Safety Compliance (PA-31.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1615_Assoc13" sourceRef="W1615_Annotation12" targetRef="W1615_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1615_Flow14" sourceRef="W1615_Start5" targetRef="W1615_Task6" />
      <bpmn:sequenceFlow id="W1615_Flow15" sourceRef="W1615_Task6" targetRef="W1615_Task7" />
      <bpmn:sequenceFlow id="W1615_Flow16" sourceRef="W1615_Task7" targetRef="W1615_Task8" />
      <bpmn:sequenceFlow id="W1615_Flow17" sourceRef="W1615_Task8" targetRef="W1615_Task9" />
      <bpmn:sequenceFlow id="W1615_Flow18" sourceRef="W1615_Task9" targetRef="W1615_Task10" />
      <bpmn:sequenceFlow id="W1615_Flow19" sourceRef="W1615_Task10" targetRef="W1615_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1615_diag">
      <bpmndi:BPMNPlane id="W1615_plane" bpmnElement="W_W1615">
        <bpmndi:BPMNShape id="W1615_Lane1_di" bpmnElement="W1615_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Lane2_di" bpmnElement="W1615_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Lane3_di" bpmnElement="W1615_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Task6_di" bpmnElement="W1615_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Task7_di" bpmnElement="W1615_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Task8_di" bpmnElement="W1615_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Task9_di" bpmnElement="W1615_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Task10_di" bpmnElement="W1615_Task10"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Start5_di" bpmnElement="W1615_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_End11_di" bpmnElement="W1615_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1615_Annotation12_di" bpmnElement="W1615_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1615_Flow14_di" bpmnElement="W1615_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Flow15_di" bpmnElement="W1615_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Flow16_di" bpmnElement="W1615_Flow16"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Flow17_di" bpmnElement="W1615_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Flow18_di" bpmnElement="W1615_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Flow19_di" bpmnElement="W1615_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1615_Assoc13_di" bpmnElement="W1615_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1616" name="W1616. Product Recall Execution &amp; Customer Notification" isExecutable="false">
      <bpmn:documentation>Trigger: Recall decision (Full Recall or Market Withdrawal) from W1615
Frequency: ~1–2 full recall executions/year
Volume: Variable — from single SKU/lot to multi-SKU recall
Owner: Compliance Officer
Participants: Compliance Officer, Store Operations, Marketing, Customer Service, DC Operations, Legal
Source: workflow W1616 — Product Recall Execution &amp; Customer Notification</bpmn:documentation>
      <bpmn:laneSet id="W1616_LaneSet5">
        <bpmn:lane id="W1616_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W1616_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1616_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1616_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1616_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1616_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1616_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1616_Lane3" name="DC Supervisor">
        <bpmn:flowNodeRef>W1616_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1616_Lane4" name="Marketing">
        <bpmn:flowNodeRef>W1616_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1616_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1616_Start6" name="Recall decision (Full Recall or Market Withdrawal) from W1615">
        <bpmn:outgoing>W1616_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1616_Task7" name="Compliance Officer creates Recall Execution Plan: (a) recall scope (SKU…">
        <bpmn:documentation>Step 1: Compliance Officer creates Recall Execution Plan: (a) recall scope (SKU, lot/batch, date range), (b) affected locations (DCs and stores with affected inventory), (c) customer notification scope (purchased customers identifiable via loyalty/ecommerce records), (d) disposition plan for recalled product (return to vendor, quarantine for investigation, or destruction), (e) timeline: store-level product removal within 24 hours; customer notification within 48 hours
Responsible (R): Compliance Officer
Accountable (A): VP Merchandising
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W1616_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1616_Task8" name="Store-level execution: (a) system sends recall alert to all affected store…">
        <bpmn:documentation>Step 2: Store-level execution: (a) system sends recall alert to all affected store managers with product images, lot numbers, and instructions, (b) Store Manager assigns Stock Associates to pull affected product from sales floor and backroom, (c) Stock Associates scan and remove affected items; system moves to &quot;Recalled&quot; inventory status, (d) Store Manager confirms removal completion within 24 hours
Responsible (R): Store Manager / Stock Associates
Accountable (A): VP Store Operations
Duration: 2–4 hours/store</bpmn:documentation>
        <bpmn:incoming>W1616_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1616_Task9" name="DC-level execution: (a) DC Supervisor pulls affected lots from available stock…">
        <bpmn:documentation>Step 3: DC-level execution: (a) DC Supervisor pulls affected lots from available stock and quarantine zones, (b) segregates recalled product in designated recall staging area, (c) confirms removal completion
Responsible (R): DC Supervisor
Accountable (A): VP Supply Chain
Duration: 2–4 hours/DC</bpmn:documentation>
        <bpmn:incoming>W1616_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1616_Task10" name="Loyalty members">
        <bpmn:documentation>Step 4: Customer notification: (a) Loyalty members: system generates notification list of loyalty members who purchased affected product; sends SMS/email with product details, risk explanation, and return instructions (full refund or replacement), (b) Ecommerce customers: system sends email to all ecommerce customers who purchased affected product; includes return shipping label for home delivery customers, (c) General public (Full Recall only): Marketing posts recall notice on buildright.com.ph, social media, and in-store poster; press release if DTI directs public notification
Responsible (R): Marketing / Customer Service
Accountable (A): CMO / VP Merchandising
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W1616_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1616_Task11" name="In-store recall signage posted at: (a) entrance, (b) affected product…">
        <bpmn:documentation>Step 5: In-store recall signage posted at: (a) entrance, (b) affected product aisle/shelf location, (c) customer service counter
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W1616_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1616_Task12" name="Store and DC submit daily recall progress reports until all affected product…">
        <bpmn:documentation>Step 6: Store and DC submit daily recall progress reports until all affected product accounted for: (a) units pulled from shelf, (b) units returned by customers, (c) units unaccounted for (sold but not yet returned)
Responsible (R): Store Manager / DC Supervisor
Accountable (A): Compliance Officer
Duration: 15 min/day during recall</bpmn:documentation>
        <bpmn:incoming>W1616_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1616_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1616_End13" name="Complete">
        <bpmn:incoming>W1616_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1616_Annotation14">
        <bpmn:text>Controls: - CTL-336 (ensure controlled execution — Product Recall &amp; Safety Compliance (PA-31.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1616_Assoc15" sourceRef="W1616_Annotation14" targetRef="W1616_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1616_Flow16" sourceRef="W1616_Start6" targetRef="W1616_Task7" />
      <bpmn:sequenceFlow id="W1616_Flow17" sourceRef="W1616_Task7" targetRef="W1616_Task8" />
      <bpmn:sequenceFlow id="W1616_Flow18" sourceRef="W1616_Task8" targetRef="W1616_Task9" />
      <bpmn:sequenceFlow id="W1616_Flow19" sourceRef="W1616_Task9" targetRef="W1616_Task10" />
      <bpmn:sequenceFlow id="W1616_Flow20" sourceRef="W1616_Task10" targetRef="W1616_Task11" />
      <bpmn:sequenceFlow id="W1616_Flow21" sourceRef="W1616_Task11" targetRef="W1616_Task12" />
      <bpmn:sequenceFlow id="W1616_Flow22" sourceRef="W1616_Task12" targetRef="W1616_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1616_diag">
