    <bpmn:process id="W_W1621" name="W1621. Consumer Product Safety Monitoring &amp; Market Surveillance" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing monitoring cycle
Frequency: Weekly scan; monthly summary
Volume: Continuous monitoring of regulatory feeds, social media, and competitor actions
Owner: Compliance Officer
Participants: Compliance Officer, Quality Manager, Marketing, Legal
Source: workflow W1621 — Consumer Product Safety Monitoring &amp; Market Surveillance</bpmn:documentation>
      <bpmn:laneSet id="W1621_LaneSet4">
        <bpmn:lane id="W1621_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W1621_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1621_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1621_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1621_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1621_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W1621_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1621_Lane3" name="Quality Manager">
        <bpmn:flowNodeRef>W1621_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1621_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1621_Start5" name="Ongoing monitoring cycle">
        <bpmn:outgoing>W1621_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1621_Task6" name="Compliance Officer monitors regulatory feeds: (a) DTI Consumer Safety Notices…">
        <bpmn:documentation>Step 1: Compliance Officer monitors regulatory feeds: (a) DTI Consumer Safety Notices and advisories, (b) DENR environmental compliance updates, (c) FDA product safety alerts (for applicable categories), (d) Philippine Consumer Act amendments and implementing rules, (e) ASEAN product safety harmonization initiatives
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1621_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1621_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1621_Task7" name="Marketing monitors social media and online forums for: (a) product safety…">
        <bpmn:documentation>Step 2: Marketing monitors social media and online forums for: (a) product safety complaints mentioning BuildRight or carried brands, (b) viral posts about product issues in hardware/DIY category, (c) competitor recall notices or safety issues that may affect BuildRight customers using similar products
Responsible (R): Marketing
Accountable (A): Compliance Officer
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1621_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1621_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1621_Task8" name="Quality Manager monitors international product safety databases for vendors…">
        <bpmn:documentation>Step 3: Quality Manager monitors international product safety databases for vendors also supplying BuildRight: (a) EU RAPEX (rapid alert system for dangerous products), (b) US CPSC (Consumer Product Safety Commission) recalls, (c) Australian ACCC product safety recalls; if a vendor&#x27;s product is recalled in another market, assess whether same product/lot is sold by BuildRight
Responsible (R): Quality Manager
Accountable (A): Compliance Officer
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1621_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1621_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1621_Task9" name="Monthly: Compliance Officer compiles Market Surveillance Summary: (a) new…">
        <bpmn:documentation>Step 4: Monthly: Compliance Officer compiles Market Surveillance Summary: (a) new regulatory requirements or changes, (b) industry safety incidents, (c) BuildRight-specific safety trends from customer complaints, (d) action items (certification updates, product testing, label changes, vendor communication)
Responsible (R): Compliance Officer
Accountable (A): VP Legal
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1621_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1621_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1621_Task10" name="Quarterly: Compliance Officer and Quality Manager review surveillance findings…">
        <bpmn:documentation>Step 5: Quarterly: Compliance Officer and Quality Manager review surveillance findings with Category Managers; proactive actions: (a) update product specifications or inspection criteria based on industry incidents, (b) proactively test products from vendors with international safety issues, (c) update customer-facing safety documentation (warning labels, instruction sheets)
Responsible (R): Compliance Officer / Quality Manager
Accountable (A): VP Merchandising
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W1621_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1621_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1621_End11" name="Complete">
        <bpmn:incoming>W1621_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1621_Annotation12">
        <bpmn:text>Controls: - CTL-336 (ensure controlled execution — Product Recall &amp; Safety Compliance (PA-31.3).) | - operational: Compliance Officer review and approval gate
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1621_Assoc13" sourceRef="W1621_Annotation12" targetRef="W1621_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1621_Flow14" sourceRef="W1621_Start5" targetRef="W1621_Task6" />
