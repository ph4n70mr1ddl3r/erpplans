        <bpmndi:BPMNShape id="W1616_Task11_di" bpmnElement="W1616_Task11"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1616_Task12_di" bpmnElement="W1616_Task12"><dc:Bounds x="1450" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1616_Start6_di" bpmnElement="W1616_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1616_End13_di" bpmnElement="W1616_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1616_Annotation14_di" bpmnElement="W1616_Annotation14"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1616_Flow16_di" bpmnElement="W1616_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow17_di" bpmnElement="W1616_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow18_di" bpmnElement="W1616_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow19_di" bpmnElement="W1616_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow20_di" bpmnElement="W1616_Flow20"><di:waypoint x="1210" y="675" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow21_di" bpmnElement="W1616_Flow21"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Flow22_di" bpmnElement="W1616_Flow22"><di:waypoint x="1630" y="335" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1616_Assoc15_di" bpmnElement="W1616_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1617" name="W1617. Product Recall Effectiveness Verification &amp; Closure" isExecutable="false">
      <bpmn:documentation>Trigger: Recall execution reaches steady state (all locations confirmed removal; customer returns declining)
Frequency: Per recall event
Volume: ~1–2 per year
Owner: Compliance Officer
Participants: Compliance Officer, Quality Manager, Legal, VP Merchandising
Source: workflow W1617 — Product Recall Effectiveness Verification &amp; Closure</bpmn:documentation>
      <bpmn:laneSet id="W1617_LaneSet4">
        <bpmn:lane id="W1617_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W1617_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1617_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1617_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1617_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1617_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1617_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1617_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1617_Lane3" name="Controller">
        <bpmn:flowNodeRef>W1617_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1617_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1617_Start5" name="Recall execution reaches steady state (all locations confirmed removal; customer returns…">
        <bpmn:outgoing>W1617_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1617_Task6" name="Compliance Officer reviews recall effectiveness metrics: (a) % of affected…">
        <bpmn:documentation>Step 1: Compliance Officer reviews recall effectiveness metrics: (a) % of affected inventory removed from stores and DCs (target: 100%), (b) % of identifiable customers notified (target: &gt; 95%), (c) customer return rate of recalled product (target: &gt; 50% for Critical recalls), (d) time from recall decision to store removal completion (target: &lt; 24 hours)
Responsible (R): Compliance Officer
Accountable (A): VP Merchandising
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1617_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1617_Task7" name="Physical verification: Quality Manager or Internal Audit conducts spot checks…">
        <bpmn:documentation>Step 2: Physical verification: Quality Manager or Internal Audit conducts spot checks at 5–10 stores to confirm recalled product is not on shelf; confirms recall signage is posted
Responsible (R): Quality Manager / Internal Audit
Accountable (A): Compliance Officer
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1617_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1617_Task8" name="Disposition of recalled product: (a) vendor-liable: coordinate return to vendor…">
        <bpmn:documentation>Step 3: Disposition of recalled product: (a) vendor-liable: coordinate return to vendor per W88 with credit recovery, (b) BuildRight-liable: arrange destruction with DENR-compliant disposal for chemicals (W82) or general destruction with documentation for non-hazardous items, (c) investigation samples: retain 5–10 units for Quality Manager and Legal investigation
Responsible (R): Quality Manager / DC Supervisor
Accountable (A): VP Supply Chain / Legal
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W1617_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1617_Task9" name="Financial settlement: (a) Controller calculates total recall cost (product cost…">
        <bpmn:documentation>Step 4: Financial settlement: (a) Controller calculates total recall cost (product cost + handling + disposal + customer refunds + vendor chargeback/recovery), (b) processes insurance claim if applicable (product liability insurance per W837), (c) records quality cost per W1614
Responsible (R): Controller
Accountable (A): CFO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1617_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1617_Task10" name="Recall closure: Compliance Officer prepares Recall Close-Out Report: (a) root…">
        <bpmn:documentation>Step 5: Recall closure: Compliance Officer prepares Recall Close-Out Report: (a) root cause summary, (b) effectiveness metrics, (c) total cost and recovery, (d) corrective actions implemented to prevent recurrence (vendor VCAR per W1610, procurement specification changes, inspection protocol updates), (e) lessons learned
Responsible (R): Compliance Officer
Accountable (A): VP Merchandising / CEO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1617_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1617_Task11" name="Post-recall monitoring: Quality Manager monitors the affected SKU/category for…">
        <bpmn:documentation>Step 6: Post-recall monitoring: Quality Manager monitors the affected SKU/category for 6 months post-recall for recurrence; monthly check of customer complaints for recalled product
Responsible (R): Quality Manager
Accountable (A): Compliance Officer
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1617_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1617_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1617_End12" name="Complete">
        <bpmn:incoming>W1617_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1617_Annotation13">
        <bpmn:text>Controls: - CTL-336 (ensure controlled execution — Product Recall &amp; Safety Compliance (PA-31.3).) | - operational: Compliance Officer review and approval gate
Owner: Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1617_Assoc14" sourceRef="W1617_Annotation13" targetRef="W1617_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1617_Flow15" sourceRef="W1617_Start5" targetRef="W1617_Task6" />
      <bpmn:sequenceFlow id="W1617_Flow16" sourceRef="W1617_Task6" targetRef="W1617_Task7" />
      <bpmn:sequenceFlow id="W1617_Flow17" sourceRef="W1617_Task7" targetRef="W1617_Task8" />
      <bpmn:sequenceFlow id="W1617_Flow18" sourceRef="W1617_Task8" targetRef="W1617_Task9" />
      <bpmn:sequenceFlow id="W1617_Flow19" sourceRef="W1617_Task9" targetRef="W1617_Task10" />
      <bpmn:sequenceFlow id="W1617_Flow20" sourceRef="W1617_Task10" targetRef="W1617_Task11" />
      <bpmn:sequenceFlow id="W1617_Flow21" sourceRef="W1617_Task11" targetRef="W1617_End12" />
    </bpmn:process>
