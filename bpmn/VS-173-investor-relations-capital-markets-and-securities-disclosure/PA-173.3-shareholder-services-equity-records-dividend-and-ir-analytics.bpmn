        <bpmndi:BPMNEdge id="W5026_Flow12_di" bpmnElement="W5026_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5026_Flow13_di" bpmnElement="W5026_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5026_Flow14_di" bpmnElement="W5026_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5026_Assoc10_di" bpmnElement="W5026_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5027" name="W5027. Dividend &amp; Distribution Program — Declaration-to-Payment, DRIP/Election &amp; Unclaimed-Property" isExecutable="false">
      <bpmn:documentation>Trigger: Dividend declaration (board); distribution cycle; DRIP election; unclaimed-property review
Frequency: Per declaration/distribution + periodic
Volume: ~dividend cycles × shareholders × 5 entities
Owner: VP Investor Relations / CFO / Treasury (VS-18) / Company Secretary (VS-36)
Participants: Treasury (VS-18/W327 payment), Finance/R2R (VS-17), Company Secretary (VS-36 record date W5025), Legal (VS-100), Compliance (VS-22), Audit (VS-21)
Source: workflow W5027 — Dividend &amp; Distribution Program — Declaration-to-Payment, DRIP/Election &amp; Unclaimed-Property</bpmn:documentation>
      <bpmn:laneSet id="W5027_LaneSet2">
        <bpmn:lane id="W5027_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5027_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5027_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5027_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5027_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5027_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5027_Start3" name="Dividend declaration (board); distribution cycle; DRIP election; unclaimed-property review">
        <bpmn:outgoing>W5027_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5027_Task4" name="Run the dividend program (declaration→record date→payment): board declaration…">
        <bpmn:documentation>Step 1: Run the dividend program (declaration→record date→payment): board declaration, disclosure (W5019), record date from the register (W5025), the dividend computation per shareholder/entitlement, and the payment instruction to treasury (links W327 in VS-18.1 which executes the cash payment)
Responsible (R): VP IR / Finance / Company Secretary / Treasury
Accountable (A): CFO / Board
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5027_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5027_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5027_Task5" name="Manage DRIP/election &amp; alternatives: dividend-reinvestment (DRIP) election…">
        <bpmn:documentation>Step 2: Manage DRIP/election &amp; alternatives: dividend-reinvestment (DRIP) election, scrip/cash election, cross-entity distribution handling (links VS-72), and the cap-table impact of reinvested shares (W5025)
Responsible (R): VP IR / Finance / Company Secretary
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5027_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5027_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5027_Task6" name="Manage unclaimed property &amp; reconciliation: undelivered/unclaimed dividends…">
        <bpmn:documentation>Step 3: Manage unclaimed property &amp; reconciliation: undelivered/unclaimed dividends, escheatment/unclaimed-property compliance (links VS-79 tax, VS-166), dividend-to-ledger reconciliation (VS-17), withholding-tax handling (links VS-79), and audit (VS-21)
Responsible (R): VP IR / Finance / Legal / Audit
Accountable (A): CFO
Duration: Per cycle + periodic</bpmn:documentation>
        <bpmn:incoming>W5027_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5027_End7" name="Complete">
        <bpmn:incoming>W5027_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5027_Annotation8">
        <bpmn:text>Controls: - CTL-751 (ensure controlled execution — Shareholder Services, Equity Records, Dividend &amp; IR Analytics (PA-173.3).) | - CTL-751: record date from register (W5025); entitlement computed; payment via treasury (W327); withholding tax applied (VS-79); unclaimed property handled; audited (VS-21)
Owner: VP Investor Relations / CFO / Treasury (VS-18) / Company Secretary (VS-36)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5027_Assoc9" sourceRef="W5027_Annotation8" targetRef="W5027_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5027_Flow10" sourceRef="W5027_Start3" targetRef="W5027_Task4" />
      <bpmn:sequenceFlow id="W5027_Flow11" sourceRef="W5027_Task4" targetRef="W5027_Task5" />
      <bpmn:sequenceFlow id="W5027_Flow12" sourceRef="W5027_Task5" targetRef="W5027_Task6" />
      <bpmn:sequenceFlow id="W5027_Flow13" sourceRef="W5027_Task6" targetRef="W5027_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5027_diag">
      <bpmndi:BPMNPlane id="W5027_plane" bpmnElement="W_W5027">
        <bpmndi:BPMNShape id="W5027_Lane1_di" bpmnElement="W5027_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
