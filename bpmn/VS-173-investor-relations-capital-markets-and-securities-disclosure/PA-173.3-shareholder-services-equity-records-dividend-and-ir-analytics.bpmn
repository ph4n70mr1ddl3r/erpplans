    <bpmn:process id="W_W5026" name="W5026. Stock Transfer, Share-Movement &amp; Investor Position Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Share transfer/sale; gift/inheritance; pledge/lien; conversion/exercise; transaction (VS-130)
Frequency: Per transfer + periodic reconciliation
Volume: ~200–500 share transfers per year × investors
Owner: Company Secretary (VS-36) / Transfer Agent / VP Investor Relations
Participants: Legal (VS-100), Compliance (VS-22), Finance (VS-17), Transfer Agent, Audit (VS-21)
Source: workflow W5026 — Stock Transfer, Share-Movement &amp; Investor Position Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W5026_LaneSet3">
        <bpmn:lane id="W5026_Lane1" name="Company Secretary">
        <bpmn:flowNodeRef>W5026_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5026_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5026_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5026_Lane2" name="Transfer Agent">
        <bpmn:flowNodeRef>W5026_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5026_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5026_Start4" name="Share transfer/sale; gift/inheritance; pledge/lien; conversion/exercise; transaction…">
        <bpmn:outgoing>W5026_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5026_Task5" name="Process stock transfers: instrument/endorsement validation, transfer-agent…">
        <bpmn:documentation>Step 1: Process stock transfers: instrument/endorsement validation, transfer-agent execution, register update (W5025), transfer restrictions/lock-up check (links VS-130, W5022 insider-trading-window), and pledge/lien/encumbrance check
Responsible (R): Company Secretary / Transfer Agent / Legal
Accountable (A): Company Secretary
Duration: Per transfer</bpmn:documentation>
        <bpmn:incoming>W5026_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5026_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5026_Task6" name="Reconcile investor positions: registered vs street-name/beneficial…">
        <bpmn:documentation>Step 2: Reconcile investor positions: registered vs street-name/beneficial, transfer-agent vs register, and reconciliation to the cap table (W5025) and ownership intelligence (W5010); manage splits/consolidations/conversions/exercises
Responsible (R): Transfer Agent / VP IR / Finance
Accountable (A): Company Secretary
Duration: Periodic + per event</bpmn:documentation>
        <bpmn:incoming>W5026_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5026_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5026_Task7" name="Report &amp; assure: share-movement reporting/filing (links VS-100, VS-166), audit…">
        <bpmn:documentation>Step 3: Report &amp; assure: share-movement reporting/filing (links VS-100, VS-166), audit trail (VS-21), and threshold-crossing disclosure where a transfer triggers it (W5019/W5023)
Responsible (R): Company Secretary / Compliance / Audit
Accountable (A): Company Secretary / VP Legal &amp; Compliance
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W5026_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5026_End8" name="Complete">
        <bpmn:incoming>W5026_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5026_Annotation9">
        <bpmn:text>Controls: - CTL-751 (ensure controlled execution — Shareholder Services, Equity Records, Dividend &amp; IR Analytics (PA-173.3).) | - CTL-751: transfers validated (restrictions/lock-up/insider-window W5022); register reconciled; encumbrances tracked; audited (VS-21)
Owner: Company Secretary (VS-36) / Transfer Agent / VP Investor Relations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5026_Assoc10" sourceRef="W5026_Annotation9" targetRef="W5026_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5026_Flow11" sourceRef="W5026_Start4" targetRef="W5026_Task5" />
      <bpmn:sequenceFlow id="W5026_Flow12" sourceRef="W5026_Task5" targetRef="W5026_Task6" />
      <bpmn:sequenceFlow id="W5026_Flow13" sourceRef="W5026_Task6" targetRef="W5026_Task7" />
      <bpmn:sequenceFlow id="W5026_Flow14" sourceRef="W5026_Task7" targetRef="W5026_End8" />
    </bpmn:process>
