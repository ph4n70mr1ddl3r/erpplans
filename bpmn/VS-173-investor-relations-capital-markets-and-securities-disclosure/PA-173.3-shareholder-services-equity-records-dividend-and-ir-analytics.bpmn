      <bpmndi:BPMNPlane id="W5026_plane" bpmnElement="W_W5026">
        <bpmndi:BPMNShape id="W5026_Lane1_di" bpmnElement="W5026_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
