<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-173.3-shareholder-services-equity-records-dividend-and-ir-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5025" name="W5025. Share Register, Stock Ledger &amp; Ownership / Cap-Table Administration" isExecutable="false">
      <bpmn:documentation>Trigger: Share issuance/issuance event; cap-table change; record date; transaction (VS-130); periodic reconciliation
Frequency: Per share event + periodic reconciliation
Volume: ~share movements × 5 entities × shareholders
Owner: Company Secretary (VS-36) / VP Investor Relations / VP Legal &amp; Compliance (VS-100)
Participants: Legal (VS-100), Finance/R2R (VS-17), Treasury (VS-18), Transfer Agent, Compliance (VS-22), Audit (VS-21)
Source: workflow W5025 — Share Register, Stock Ledger &amp; Ownership / Cap-Table Administration</bpmn:documentation>
      <bpmn:laneSet id="W5025_LaneSet3">
        <bpmn:lane id="W5025_Lane1" name="Company Secretary">
        <bpmn:flowNodeRef>W5025_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5025_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5025_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5025_Lane2" name="VP IR">
        <bpmn:flowNodeRef>W5025_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5025_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5025_Start4" name="Share issuance/issuance event; cap-table change; record date; transaction (VS-130)…">
        <bpmn:outgoing>W5025_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5025_Task5" name="Maintain the share register &amp; stock ledger: the register of…">
        <bpmn:documentation>Step 1: Maintain the share register &amp; stock ledger: the register of shareholders/members, stock ledger, issued/outstanding/treasury shares, classes/series, par value, and the cap table per entity (5 entities — links VS-72), ensuring legal integrity of ownership records (the ASHM/dividend/RPT foundation)
Responsible (R): Company Secretary / Legal / Transfer Agent
Accountable (A): Company Secretary / VP Legal &amp; Compliance
Duration: Per event + periodic</bpmn:documentation>
        <bpmn:incoming>W5025_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5025_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5025_Task6" name="Administer the cap table &amp; ownership: authorized vs issued vs outstanding…">
        <bpmn:documentation>Step 2: Administer the cap table &amp; ownership: authorized vs issued vs outstanding, option/warrant/convertible tracking (links VS-102 W3324 LTI), dilution analysis, beneficial-owner mapping (W5023), and ownership intelligence feed (W5010)
Responsible (R): VP IR / Legal / Finance
Accountable (A): Company Secretary
Duration: Continuous + periodic</bpmn:documentation>
        <bpmn:incoming>W5025_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5025_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5025_Task7" name="Reconcile &amp; assure: reconcile the register/ledger to the equity accounts…">
        <bpmn:documentation>Step 3: Reconcile &amp; assure: reconcile the register/ledger to the equity accounts (VS-17) and intercompany/group structure (VS-72), set record dates (links W5020 ASHM, W5027 dividend), and assure (VS-21); manage discrepancies as ownership-record risk
Responsible (R): Company Secretary / Finance / Audit
Accountable (A): Company Secretary / CFO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W5025_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5025_End8" name="Complete">
        <bpmn:incoming>W5025_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5025_Annotation9">
        <bpmn:text>Controls: - CTL-751 (ensure controlled execution — Shareholder Services, Equity Records, Dividend &amp; IR Analytics (PA-173.3).) | - CTL-751: register/ledger legally maintained; reconciled to equity accounts (VS-17) &amp; group (VS-72); record dates set; audited (VS-21)
Owner: Company Secretary (VS-36) / VP Investor Relations / VP Legal &amp; Compliance (VS-100)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5025_Assoc10" sourceRef="W5025_Annotation9" targetRef="W5025_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5025_Flow11" sourceRef="W5025_Start4" targetRef="W5025_Task5" />
      <bpmn:sequenceFlow id="W5025_Flow12" sourceRef="W5025_Task5" targetRef="W5025_Task6" />
      <bpmn:sequenceFlow id="W5025_Flow13" sourceRef="W5025_Task6" targetRef="W5025_Task7" />
      <bpmn:sequenceFlow id="W5025_Flow14" sourceRef="W5025_Task7" targetRef="W5025_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5025_diag">
      <bpmndi:BPMNPlane id="W5025_plane" bpmnElement="W_W5025">
        <bpmndi:BPMNShape id="W5025_Lane1_di" bpmnElement="W5025_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
