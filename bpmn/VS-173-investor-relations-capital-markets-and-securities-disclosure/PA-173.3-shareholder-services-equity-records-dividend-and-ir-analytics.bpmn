        <bpmn:flowNodeRef>W5032_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5032_Start3" name="Activist accumulation/nomination; crisis/event (W5019); unsolicited approach…">
        <bpmn:outgoing>W5032_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5032_Task4" name="Detect &amp; assess: activist-accumulation/ownership-flow signal (W5029/W5010)…">
        <bpmn:documentation>Step 1: Detect &amp; assess: activist-accumulation/ownership-flow signal (W5029/W5010), unsolicited approach, crisis triggering investor impact (W5019), or transaction (VS-130); convene the response team (IR, legal, strategy, comms, treasury, board VS-36)
Responsible (R): VP IR / Legal / Strategy / Analytics
Accountable (A): CFO / VP Legal &amp; Compliance / CEO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5032_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5032_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5032_Task5" name="Coordinate the IR response: the activist/defense playbook (engagement vs…">
        <bpmn:documentation>Step 2: Coordinate the IR response: the activist/defense playbook (engagement vs defense, board/shareholder communication, proxy defense links W5020), transaction IR (W5021), crisis investor-communications (W5019, fair-disclosure W5017), and rating/lender reassurance (W5013/VS-18)
Responsible (R): VP IR / Legal / Strategy / Comms
Accountable (A): CEO / Board (VS-36)
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5032_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5032_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5032_Task6" name="Disclose, settle &amp; learn: ensure all material aspects disclosed timely/fairly…">
        <bpmn:documentation>Step 3: Disclose, settle &amp; learn: ensure all material aspects disclosed timely/fairly (W5017/W5019), post-incident review (W5024), and capture lessons in the IR/crisis playbook
Responsible (R): VP IR / Legal / Compliance
Accountable (A): CEO / Board (VS-36)
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5032_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5032_End7" name="Complete">
        <bpmn:incoming>W5032_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5032_Annotation8">
        <bpmn:text>Controls: - CTL-751 (ensure controlled execution — Shareholder Services, Equity Records, Dividend &amp; IR Analytics (PA-173.3).) | - CTL-751: activist/ownership monitored (W5010/W5029); response playbooks maintained; disclosure-controls enforced (W5017/W5019); board-involved (VS-36)
Owner: VP Investor Relations / VP Legal &amp; Compliance (VS-100) / CFO / Strategy (VS-33)</bpmn:text>
      </bpmn:textAnnotation>
