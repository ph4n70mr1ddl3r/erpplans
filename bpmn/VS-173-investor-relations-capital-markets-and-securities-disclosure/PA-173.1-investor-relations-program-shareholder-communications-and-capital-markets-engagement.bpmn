        <bpmndi:BPMNShape id="W5010_Task6_di" bpmnElement="W5010_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5010_Start3_di" bpmnElement="W5010_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5010_End7_di" bpmnElement="W5010_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5010_Annotation8_di" bpmnElement="W5010_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5010_Flow10_di" bpmnElement="W5010_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5010_Flow11_di" bpmnElement="W5010_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5010_Flow12_di" bpmnElement="W5010_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5010_Flow13_di" bpmnElement="W5010_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5010_Assoc9_di" bpmnElement="W5010_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5011" name="W5011. Periodic Investor Communications — Earnings, Results &amp; Guidance Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly/annual close (VS-17); guidance cycle; investor calendar
Frequency: Quarterly + annual
Volume: ~4 quarterly + 1 annual results cycle per year × audiences
Owner: VP Investor Relations / CFO
Participants: CFO/CEO, R2R (VS-17), FP&amp;A (VS-17.4/VS-33), Treasury (VS-18), Legal (VS-100), ESG (VS-25)
Source: workflow W5011 — Periodic Investor Communications — Earnings, Results &amp; Guidance Management</bpmn:documentation>
      <bpmn:laneSet id="W5011_LaneSet2">
        <bpmn:lane id="W5011_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5011_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5011_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5011_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5011_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5011_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5011_Start3" name="Quarterly/annual close (VS-17); guidance cycle; investor calendar">
        <bpmn:outgoing>W5011_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5011_Task4" name="Prepare results &amp; earnings communications: the results press release, investor…">
        <bpmn:documentation>Step 1: Prepare results &amp; earnings communications: the results press release, investor presentation, financial &amp; segment commentary, MD&amp;A-style narrative, and guidance/range — all reconciled to the closed books (VS-17) and reviewed through disclosure controls (W5017) before release
Responsible (R): VP IR / Finance / FP&amp;A / Legal
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5011_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5011_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5011_Task5" name="Conduct the results engagement: earnings call/webcast (Q&amp;A prep, script…">
        <bpmn:documentation>Step 2: Conduct the results engagement: earnings call/webcast (Q&amp;A prep, script, hot-topics), investor portal publication (W5014), and analyst follow-up — all on fair-disclosure basis (W5017)
Responsible (R): VP IR / CFO / CEO
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5011_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5011_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5011_Task6" name="Manage guidance &amp; forward statements: set/affirm/withdraw guidance with…">
        <bpmn:documentation>Step 3: Manage guidance &amp; forward statements: set/affirm/withdraw guidance with disclosure-control sign-off (W5017), track consensus (W5013), and manage any guidance update/withdrawal as a disclosure event (W5019)
Responsible (R): VP IR / CFO / Legal
Accountable (A): CFO / CEO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5011_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5011_End7" name="Complete">
        <bpmn:incoming>W5011_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5011_Annotation8">
        <bpmn:text>Controls: - CTL-749 (ensure controlled execution — Investor Relations Program, Shareholder Communications &amp; Capital-Markets Engagement (PA-173.1).) | - CTL-749: results reconciled to closed books; forward statements disclosure-controlled (W5017); fair simultaneous release; script/legal-reviewed
Owner: VP Investor Relations / CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5011_Assoc9" sourceRef="W5011_Annotation8" targetRef="W5011_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5011_Flow10" sourceRef="W5011_Start3" targetRef="W5011_Task4" />
      <bpmn:sequenceFlow id="W5011_Flow11" sourceRef="W5011_Task4" targetRef="W5011_Task5" />
      <bpmn:sequenceFlow id="W5011_Flow12" sourceRef="W5011_Task5" targetRef="W5011_Task6" />
      <bpmn:sequenceFlow id="W5011_Flow13" sourceRef="W5011_Task6" targetRef="W5011_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5011_diag">
      <bpmndi:BPMNPlane id="W5011_plane" bpmnElement="W_W5011">
        <bpmndi:BPMNShape id="W5011_Lane1_di" bpmnElement="W5011_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_Task4_di" bpmnElement="W5011_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_Task5_di" bpmnElement="W5011_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_Task6_di" bpmnElement="W5011_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_Start3_di" bpmnElement="W5011_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_End7_di" bpmnElement="W5011_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5011_Annotation8_di" bpmnElement="W5011_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5011_Flow10_di" bpmnElement="W5011_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5011_Flow11_di" bpmnElement="W5011_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5011_Flow12_di" bpmnElement="W5011_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5011_Flow13_di" bpmnElement="W5011_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5011_Assoc9_di" bpmnElement="W5011_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5012" name="W5012. Investor Events, Analyst Day, Roadshow &amp; Conference Participation Management" isExecutable="false">
      <bpmn:documentation>Trigger: IR calendar; capital-markets strategy; transaction (VS-130); rating review
Frequency: Several per year + on-demand
Volume: ~4–8 analyst days/roadshows/conferences per year × audiences
Owner: VP Investor Relations
Participants: CFO/CEO, Strategy (VS-33), Marketing/Comms (VS-14), Corporate Security (VS-159), Legal (VS-100)
Source: workflow W5012 — Investor Events, Analyst Day, Roadshow &amp; Conference Participation Management</bpmn:documentation>
      <bpmn:laneSet id="W5012_LaneSet2">
        <bpmn:lane id="W5012_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5012_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5012_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5012_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5012_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5012_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5012_Start3" name="IR calendar; capital-markets strategy; transaction (VS-130); rating review">
        <bpmn:outgoing>W5012_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5012_Task4" name="Plan the event/roadshow: objective (strategic-story refresh, rating support…">
        <bpmn:documentation>Step 1: Plan the event/roadshow: objective (strategic-story refresh, rating support, transaction), audience/targeting (W5010), agenda, materials (reconciled to W5009 narrative &amp; disclosure-controlled W5017), logistics, and corporate-security coordination for principal appearances (links VS-159/W4684)
Responsible (R): VP IR / Strategy / Marketing / Security
Accountable (A): VP IR / CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W5012_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5012_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5012_Task5" name="Execute the event/roadshow: presentations, 1:1/1:few investor &amp; analyst…">
        <bpmn:documentation>Step 2: Execute the event/roadshow: presentations, 1:1/1:few investor &amp; analyst meetings (fair-disclosure basis W5017), conference participation, and Q&amp;A tracking/log
