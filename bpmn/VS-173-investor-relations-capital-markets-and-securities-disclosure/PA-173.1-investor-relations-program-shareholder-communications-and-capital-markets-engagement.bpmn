<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-173.1-investor-relations-program-shareholder-communications-and-capital-markets-engagement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5009" name="W5009. IR Program Strategy, Investor Audience &amp; Equity-Story / Capital-Markets Narrative Design" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual IR plan; capital-markets event; strategic-plan refresh (VS-33); transaction (VS-130)
Frequency: Annual + event-driven
Volume: 1 IR program across the 5 entities × investor/analyst/credit/lender audiences
Owner: VP Investor Relations / CFO / Strategy (VS-33)
Participants: CFO/CEO, Strategy (VS-33), Treasury (VS-18), R2R (VS-17), Governance (VS-36), Marketing/Comms (VS-14), ESG (VS-25), Legal (VS-100)
Source: workflow W5009 — IR Program Strategy, Investor Audience &amp; Equity-Story / Capital-Markets Narrative Design</bpmn:documentation>
      <bpmn:laneSet id="W5009_LaneSet2">
        <bpmn:lane id="W5009_Lane1" name="VP IR">
        <bpmn:flowNodeRef>W5009_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5009_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5009_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5009_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5009_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5009_Start3" name="Program launch; annual IR plan; capital-markets event; strategic-plan refresh (VS-33)…">
        <bpmn:outgoing>W5009_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5009_Task4" name="Set the IR strategy &amp; operating model: the investor/analyst/credit/lender…">
        <bpmn:documentation>Step 1: Set the IR strategy &amp; operating model: the investor/analyst/credit/lender audiences BuildRight engages, the equity story and capital-markets narrative (positioning, growth thesis, margin/cash-conversion story, multi-entity/intercompany clarity links VS-72), the disclosure posture (voluntary vs mandatory), the IR calendar (earnings, ASHM, ratings, events), and the IR KPIs (coverage, sentiment, valuation gap)
Responsible (R): VP IR / Strategy / CFO
Accountable (A): CFO / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5009_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5009_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5009_Task5" name="Build the equity-story &amp; narrative materials: the core IR deck, fact book…">
        <bpmn:documentation>Step 2: Build the equity-story &amp; narrative materials: the core IR deck, fact book, segment/financial summaries, capital-structure and liquidity narrative (links VS-18/VS-170), and the consistency check vs the strategic plan (VS-33), annual report (W5018), and management accounts (VS-17)
Responsible (R): VP IR / Finance / Strategy
Accountable (A): VP IR
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5009_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5009_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5009_Task6" name="Govern &amp; align: leadership/board sign-off on the narrative and forward…">
        <bpmn:documentation>Step 3: Govern &amp; align: leadership/board sign-off on the narrative and forward statements (links VS-36 governance), alignment of investor messaging with internal strategy, and the disclosure-controls linkage (W5017) so every external statement traces to approved, disclosed information
Responsible (R): VP IR / CFO / Legal / Governance
Accountable (A): CFO / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5009_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5009_End7" name="Complete">
        <bpmn:incoming>W5009_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5009_Annotation8">
        <bpmn:text>Controls: - CTL-749 (ensure controlled execution — Investor Relations Program, Shareholder Communications &amp; Capital-Markets Engagement (PA-173.1).) | - CTL-749: narrative board/leadership-approved; forward statements disclosure-controlled (W5017); messaging reconciled to accounts/strategy
Owner: VP Investor Relations / CFO / Strategy (VS-33)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5009_Assoc9" sourceRef="W5009_Annotation8" targetRef="W5009_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5009_Flow10" sourceRef="W5009_Start3" targetRef="W5009_Task4" />
      <bpmn:sequenceFlow id="W5009_Flow11" sourceRef="W5009_Task4" targetRef="W5009_Task5" />
      <bpmn:sequenceFlow id="W5009_Flow12" sourceRef="W5009_Task5" targetRef="W5009_Task6" />
      <bpmn:sequenceFlow id="W5009_Flow13" sourceRef="W5009_Task6" targetRef="W5009_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5009_diag">
      <bpmndi:BPMNPlane id="W5009_plane" bpmnElement="W_W5009">
        <bpmndi:BPMNShape id="W5009_Lane1_di" bpmnElement="W5009_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5009_Task4_di" bpmnElement="W5009_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5009_Task5_di" bpmnElement="W5009_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5009_Task6_di" bpmnElement="W5009_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5009_Start3_di" bpmnElement="W5009_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
