    <bpmn:process id="W_W4332" name="W4332. Housing Asset, Furniture/FF&amp;E Lifecycle &amp; Inventory" isExecutable="false">
      <bpmn:documentation>Trigger: Asset setup; lifecycle; damage/loss; move-out
Frequency: Per lifecycle + periodic verification
Volume: Housing FF&amp;E/assets across sites (beds, appliances, furniture)
Owner: Asset (VS-35) / Facilities (VS-138) / Housing Ops
Participants: Asset (VS-35), Facilities (VS-138), Housing Ops, Finance (VS-17.4/VS-40), Procurement (VS-34)
Source: workflow W4332 — Housing Asset, Furniture/FF&amp;E Lifecycle &amp; Inventory</bpmn:documentation>
      <bpmn:laneSet id="W4332_LaneSet3">
        <bpmn:lane id="W4332_Lane1" name="Asset">
        <bpmn:flowNodeRef>W4332_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4332_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4332_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4332_Lane2" name="Housing Ops">
        <bpmn:flowNodeRef>W4332_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4332_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4332_Start4" name="Asset setup; lifecycle; damage/loss; move-out">
        <bpmn:outgoing>W4332_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4332_Task5" name="Asset/Facilities register housing FF&amp;E (beds, mattresses, appliances, AC…">
        <bpmn:documentation>Step 1: Asset/Facilities register housing FF&amp;E (beds, mattresses, appliances, AC, furniture) as assets, set depreciation (VS-35), and tag for tracking
