    <bpmn:process id="W_W4331" name="W4331. Housing Cost Recovery, Rent/Utility Recharge &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; cost model (W4317)
Frequency: Monthly
Volume: Enterprise housing cost/recovery across sites
Owner: Finance (VS-17.4) / Shared Services (VS-72) / Housing Ops
Participants: Finance (VS-17.4), Payroll (VS-19.2), Shared Services (VS-72), Revenue Assurance (VS-118), HR (VS-103)
Source: workflow W4331 — Housing Cost Recovery, Rent/Utility Recharge &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W4331_LaneSet4">
        <bpmn:lane id="W4331_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4331_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4331_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4331_Lane2" name="Shared Services">
        <bpmn:flowNodeRef>W4331_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4331_Lane3" name="Revenue Assurance">
        <bpmn:flowNodeRef>W4331_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4331_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4331_Start5" name="Monthly close; cost model (W4317)">
        <bpmn:outgoing>W4331_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4331_Task6" name="Finance/Shared Services compile monthly housing cost (rent, utilities…">
        <bpmn:documentation>Step 1: Finance/Shared Services compile monthly housing cost (rent, utilities, maintenance, housekeeping, security) per site/unit per the cost model (W4317)
Responsible (R): Finance / Shared Services
Accountable (A): Finance Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4331_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4331_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4331_Task7" name="Shared Services/Payroll recharge resident share via payroll deduction…">
        <bpmn:documentation>Step 2: Shared Services/Payroll recharge resident share via payroll deduction (VS-19.2), allocate entity cost (VS-72), and process vendor/utility payments (VS-15)
Responsible (R): Shared Services / Payroll / AP
Accountable (A): Finance Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4331_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4331_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4331_Task8" name="Revenue Assurance/Finance reconcile recovery vs cost, detect leakage…">
        <bpmn:documentation>Step 3: Revenue Assurance/Finance reconcile recovery vs cost, detect leakage (under-recharge, un-billed utility, over-subsidy), and adjust
Responsible (R): Revenue Assurance / Finance
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4331_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4331_End9" name="Complete">
        <bpmn:incoming>W4331_Flow15</bpmn:incoming>
      </bpmn:endEvent>
