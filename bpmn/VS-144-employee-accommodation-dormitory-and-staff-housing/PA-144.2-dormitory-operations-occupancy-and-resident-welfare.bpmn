      <bpmndi:BPMNPlane id="W4321_plane" bpmnElement="W_W4321">
        <bpmndi:BPMNShape id="W4321_Lane1_di" bpmnElement="W4321_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
