      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4323" name="W4323. Resident Welfare, Grievance &amp; Conflict Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Resident grievance; conflict; welfare concern; incident
Frequency: Per case
Volume: Welfare/grievance cases (proportional to housed population)
Owner: HR (VS-84/VS-103) / Housing Ops / Warden
Participants: Labor Relations (VS-84), HR (VS-103), Housing Ops, HSE (VS-24), Ethics (VS-119), Resident
Source: workflow W4323 — Resident Welfare, Grievance &amp; Conflict Resolution</bpmn:documentation>
      <bpmn:laneSet id="W4323_LaneSet3">
        <bpmn:lane id="W4323_Lane1" name="Warden">
        <bpmn:flowNodeRef>W4323_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4323_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4323_Lane2" name="HR">
        <bpmn:flowNodeRef>W4323_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4323_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4323_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4323_Start4" name="Resident grievance; conflict; welfare concern; incident">
        <bpmn:outgoing>W4323_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4323_Task5" name="Warden/HR receive welfare concerns/grievances (roommate conflict, harassment…">
        <bpmn:documentation>Step 1: Warden/HR receive welfare concerns/grievances (roommate conflict, harassment, unsafe condition, mental-health), log confidentially, and acknowledge to the resident
Responsible (R): Warden / HR / Housing Ops
Accountable (A): Housing Ops Lead / HR Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4323_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4323_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4323_Task6" name="HR/Labor Relations investigate per VS-84/VS-119 (harassment/ethics escalation)…">
        <bpmn:documentation>Step 2: HR/Labor Relations investigate per VS-84/VS-119 (harassment/ethics escalation), take interim protection measures, and mediate/resolve
Responsible (R): HR / Labor Relations / Ethics
Accountable (A): CHRO / Ethics Lead
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4323_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4323_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4323_Task7" name="HR/Housing Ops document outcome, enforce consequence (eviction W4315 for…">
        <bpmn:documentation>Step 3: HR/Housing Ops document outcome, enforce consequence (eviction W4315 for serious breach), and monitor for retaliation/recurrence
Responsible (R): HR / Housing Ops
Accountable (A): CHRO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4323_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4323_End8" name="Complete">
        <bpmn:incoming>W4323_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4323_Annotation9">
        <bpmn:text>Controls: - CTL-663 (ensure controlled execution — Dormitory/Accommodation Operations, Occupancy &amp; Resident Welfare (PA-144.2).) | - CTL-663: grievance channel confidential; harassment escalated (VS-84/VS-119); anti-retaliation monitored
Owner: HR (VS-84/VS-103) / Housing Ops / Warden</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4323_Assoc10" sourceRef="W4323_Annotation9" targetRef="W4323_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4323_Flow11" sourceRef="W4323_Start4" targetRef="W4323_Task5" />
      <bpmn:sequenceFlow id="W4323_Flow12" sourceRef="W4323_Task5" targetRef="W4323_Task6" />
      <bpmn:sequenceFlow id="W4323_Flow13" sourceRef="W4323_Task6" targetRef="W4323_Task7" />
      <bpmn:sequenceFlow id="W4323_Flow14" sourceRef="W4323_Task7" targetRef="W4323_End8" />
    </bpmn:process>
