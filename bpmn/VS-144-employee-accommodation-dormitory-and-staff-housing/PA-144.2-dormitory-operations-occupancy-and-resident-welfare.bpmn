    <bpmn:process id="W_W4322" name="W4322. Occupancy Management, Bed Allocation &amp; Waitlist" isExecutable="false">
      <bpmn:documentation>Trigger: Vacancy; waitlisted applicant; capacity change
Frequency: Continuous
Volume: Per-site bed/occupancy management
Owner: Housing Ops / HR (VS-103)
Participants: HR (VS-103), Store/DC Ops (VS-07/VS-04), Facilities (VS-138), Finance (VS-17.4)
Source: workflow W4322 — Occupancy Management, Bed Allocation &amp; Waitlist</bpmn:documentation>
      <bpmn:laneSet id="W4322_LaneSet2">
        <bpmn:lane id="W4322_Lane1" name="Housing Ops">
        <bpmn:flowNodeRef>W4322_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4322_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4322_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4322_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4322_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4322_Start3" name="Vacancy; waitlisted applicant; capacity change">
        <bpmn:outgoing>W4322_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4322_Task4" name="Housing Ops maintain real-time bed/unit availability by site, apply allocation…">
        <bpmn:documentation>Step 1: Housing Ops maintain real-time bed/unit availability by site, apply allocation priority (W4316), and manage the waitlist for over-subscribed sites
Responsible (R): Housing Ops
Accountable (A): Housing Ops Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4322_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4322_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4322_Task5" name="Housing Ops balance gender/role-appropriate allocation (separate quarters where…">
        <bpmn:documentation>Step 2: Housing Ops balance gender/role-appropriate allocation (separate quarters where required), respect capacity limits (W4318), and document assignments
Responsible (R): Housing Ops / HR
Accountable (A): Housing Ops Lead
Duration: Per allocation</bpmn:documentation>
        <bpmn:incoming>W4322_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4322_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4322_Task6" name="Housing Ops/Finance forecast occupancy vs capacity to flag need for additional…">
        <bpmn:documentation>Step 3: Housing Ops/Finance forecast occupancy vs capacity to flag need for additional units (W4314) or cost recovery gaps, and report utilization
Responsible (R): Housing Ops / Finance
Accountable (A): Housing Ops Lead / CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4322_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4322_End7" name="Complete">
        <bpmn:incoming>W4322_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4322_Annotation8">
        <bpmn:text>Controls: - CTL-663 (ensure controlled execution — Dormitory/Accommodation Operations, Occupancy &amp; Resident Welfare (PA-144.2).) | - CTL-663: allocation within capacity (W4318); priority documented; gender/role-appropriate; occupancy tracked
Owner: Housing Ops / HR (VS-103)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4322_Assoc9" sourceRef="W4322_Annotation8" targetRef="W4322_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4322_Flow10" sourceRef="W4322_Start3" targetRef="W4322_Task4" />
      <bpmn:sequenceFlow id="W4322_Flow11" sourceRef="W4322_Task4" targetRef="W4322_Task5" />
      <bpmn:sequenceFlow id="W4322_Flow12" sourceRef="W4322_Task5" targetRef="W4322_Task6" />
      <bpmn:sequenceFlow id="W4322_Flow13" sourceRef="W4322_Task6" targetRef="W4322_End7" />
    </bpmn:process>
