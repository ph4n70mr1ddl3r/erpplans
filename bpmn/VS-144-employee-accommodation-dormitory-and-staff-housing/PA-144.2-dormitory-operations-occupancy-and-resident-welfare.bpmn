      <bpmndi:BPMNPlane id="W4322_plane" bpmnElement="W_W4322">
        <bpmndi:BPMNShape id="W4322_Lane1_di" bpmnElement="W4322_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
