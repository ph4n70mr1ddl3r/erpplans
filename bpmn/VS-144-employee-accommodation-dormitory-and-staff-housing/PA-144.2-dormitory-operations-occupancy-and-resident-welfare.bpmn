<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-144.2-dormitory-operations-occupancy-and-resident-welfare" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4321" name="W4321. Dormitory Daily Operations, Check-In/Out &amp; Front-Desk Management" isExecutable="false">
      <bpmn:documentation>Trigger: Resident assignment (W4316); daily operation
Frequency: Daily + per check-in/out
Volume: Per-site daily ops × ~housed-sites; check-in/out on assignment/move-out
Owner: Dormitory Warden/House Parent / Housing Ops
Participants: Housing Ops, HR (VS-103), Facilities (VS-138), Security (VS-23), Resident
Source: workflow W4321 — Dormitory Daily Operations, Check-In/Out &amp; Front-Desk Management</bpmn:documentation>
      <bpmn:laneSet id="W4321_LaneSet3">
        <bpmn:lane id="W4321_Lane1" name="Warden">
        <bpmn:flowNodeRef>W4321_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4321_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4321_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4321_Lane2" name="Housing Ops">
        <bpmn:flowNodeRef>W4321_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4321_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4321_Start4" name="Resident assignment (W4316); daily operation">
        <bpmn:outgoing>W4321_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4321_Task5" name="Warden/Housing Ops run daily front-desk operations — check-in (verify…">
        <bpmn:documentation>Step 1: Warden/Housing Ops run daily front-desk operations — check-in (verify assignment W4316, signed agreement W4315, orientation, key/access issuance, bed/unit handover) and check-out (key return, inspection W4334)
Responsible (R): Warden / Housing Ops
Accountable (A): Housing Ops Lead
Duration: Per check-in/out</bpmn:documentation>
        <bpmn:incoming>W4321_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4321_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4321_Task6" name="Warden/Housing Ops maintain the daily log (occupancy, incidents, maintenance…">
        <bpmn:documentation>Step 2: Warden/Housing Ops maintain the daily log (occupancy, incidents, maintenance requests, visitor register W4325), conduct rounds, and report exceptions
Responsible (R): Warden / Housing Ops
Accountable (A): Housing Ops Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4321_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4321_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4321_Task7" name="Housing Ops reconcile daily occupancy to the housing system/HRIS (W4320) and…">
        <bpmn:documentation>Step 3: Housing Ops reconcile daily occupancy to the housing system/HRIS (W4320) and escalate anomalies (unauthorized occupant, separation not released)
Responsible (R): Housing Ops
Accountable (A): Housing Ops Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4321_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4321_End8" name="Complete">
        <bpmn:incoming>W4321_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4321_Annotation9">
        <bpmn:text>Controls: - CTL-663 (ensure controlled execution — Dormitory/Accommodation Operations, Occupancy &amp; Resident Welfare (PA-144.2).) | - CTL-663: check-in assignment-verified; daily occupancy reconciled to HRIS; visitor register maintained (W4325)
Owner: Dormitory Warden/House Parent / Housing Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4321_Assoc10" sourceRef="W4321_Annotation9" targetRef="W4321_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4321_Flow11" sourceRef="W4321_Start4" targetRef="W4321_Task5" />
      <bpmn:sequenceFlow id="W4321_Flow12" sourceRef="W4321_Task5" targetRef="W4321_Task6" />
      <bpmn:sequenceFlow id="W4321_Flow13" sourceRef="W4321_Task6" targetRef="W4321_Task7" />
      <bpmn:sequenceFlow id="W4321_Flow14" sourceRef="W4321_Task7" targetRef="W4321_End8" />
    </bpmn:process>
