    <bpmn:process id="W_W4318" name="W4318. Housing Safety, Welfare &amp; DOLE/OSH Compliance Standard" isExecutable="false">
      <bpmn:documentation>Trigger: Housing operation; incident; regulatory review
Frequency: Standard + continuous adherence
Volume: All housing units/residents
Owner: HSE (VS-24) / Housing Ops / Compliance (VS-22)
Participants: HSE (VS-24), Facilities (VS-138), Fire/BFP, DOLE, HR (VS-103), Insurance (VS-26), Risk (VS-21.2)
Source: workflow W4318 — Housing Safety, Welfare &amp; DOLE/OSH Compliance Standard</bpmn:documentation>
      <bpmn:laneSet id="W4318_LaneSet3">
        <bpmn:lane id="W4318_Lane1" name="HSE">
        <bpmn:flowNodeRef>W4318_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4318_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4318_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4318_Lane2" name="Facilities">
