    <bpmn:process id="W_W4319" name="W4319. Housing Governance, Compliance &amp; Audit Framework" isExecutable="false">
      <bpmn:documentation>Trigger: Risk framework (W4318); audit cycle; regulatory change
Frequency: Annual + on change
Volume: One housing governance/compliance framework
Owner: Compliance (VS-22) / Audit (VS-21) / Housing Ops / Legal (VS-100.3)
Participants: Compliance (VS-22), Audit (VS-21), Legal (VS-100.3), HSE (VS-24), HR (VS-103), LGU (VS-76)
Source: workflow W4319 — Housing Governance, Compliance &amp; Audit Framework</bpmn:documentation>
      <bpmn:laneSet id="W4319_LaneSet3">
        <bpmn:lane id="W4319_Lane1" name="Compliance">
        <bpmn:flowNodeRef>W4319_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4319_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4319_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4319_Lane2" name="Audit">
