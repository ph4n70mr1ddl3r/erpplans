    <bpmn:process id="W_W4316" name="W4316. Housing Allocation, Assignment &amp; Occupancy Entitlement" isExecutable="false">
      <bpmn:documentation>Trigger: Eligible employee (new hire, transferee, night-shift); vacancy
Frequency: Per assignment + ongoing occupancy
Volume: Housing-eligible employee population × assignment cycles
Owner: Housing Ops / HR (VS-19/VS-103)
Participants: HR (VS-19/VS-103), Store/DC Ops (VS-07/VS-04), Facilities (VS-138), Finance (VS-17.4)
Source: workflow W4316 — Housing Allocation, Assignment &amp; Occupancy Entitlement</bpmn:documentation>
      <bpmn:laneSet id="W4316_LaneSet3">
        <bpmn:lane id="W4316_Lane1" name="HR">
        <bpmn:flowNodeRef>W4316_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4316_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4316_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4316_Lane2" name="Housing Ops">
        <bpmn:flowNodeRef>W4316_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4316_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4316_Start4" name="Eligible employee (new hire, transferee, night-shift); vacancy">
        <bpmn:outgoing>W4316_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4316_Task5" name="HR/Housing Ops verify employee eligibility per policy (W4315) and the site&#x27;s…">
        <bpmn:documentation>Step 1: HR/Housing Ops verify employee eligibility per policy (W4315) and the site&#x27;s housing availability (W4314), and apply allocation priority (transferee, key-role, hardship)
Responsible (R): HR / Housing Ops
Accountable (A): Housing Ops Lead
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4316_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4316_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4316_Task6" name="Housing Ops assign the unit/bed, issue the resident agreement (W4315), schedule…">
        <bpmn:documentation>Step 2: Housing Ops assign the unit/bed, issue the resident agreement (W4315), schedule move-in/check-in (W4321), and record occupancy in the housing system
Responsible (R): Housing Ops
Accountable (A): Housing Ops Lead
Duration: Per assignment</bpmn:documentation>
        <bpmn:incoming>W4316_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4316_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4316_Task7" name="HR/Housing Ops manage move-out/transfer (W4334), release the unit, and update…">
        <bpmn:documentation>Step 3: HR/Housing Ops manage move-out/transfer (W4334), release the unit, and update occupancy/cost records
Responsible (R): HR / Housing Ops
Accountable (A): Housing Ops Lead
Duration: Per move-out</bpmn:documentation>
        <bpmn:incoming>W4316_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4316_End8" name="Complete">
        <bpmn:incoming>W4316_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4316_Annotation9">
        <bpmn:text>Controls: - CTL-662 (ensure controlled execution — Housing Strategy, Portfolio &amp; Policy Framework (PA-144.1).) | - CTL-662: allocation per transparent criteria; occupancy reconciled to HRIS; move-out on separation triggers release
Owner: Housing Ops / HR (VS-19/VS-103)</bpmn:text>
      </bpmn:textAnnotation>
