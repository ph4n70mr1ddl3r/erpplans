    <bpmn:process id="W_W4315" name="W4315. Housing Policy, House Rules, Code of Conduct &amp; Resident Agreement" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4313); policy review; incident
Frequency: Annual + on change
Volume: One housing policy/resident-agreement framework
Owner: HR (VS-19/VS-103) / Housing Ops / Legal (VS-100.3)
Participants: Legal (VS-100.3), Labor Relations (VS-84), HSE (VS-24), Compliance (VS-22), Facilities (VS-138)
Source: workflow W4315 — Housing Policy, House Rules, Code of Conduct &amp; Resident Agreement</bpmn:documentation>
      <bpmn:laneSet id="W4315_LaneSet3">
        <bpmn:lane id="W4315_Lane1" name="HR">
        <bpmn:flowNodeRef>W4315_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4315_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4315_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4315_Lane2" name="Labor Relations">
        <bpmn:flowNodeRef>W4315_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4315_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4315_Start4" name="Strategy (W4313); policy review; incident">
        <bpmn:outgoing>W4315_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4315_Task5" name="HR/Legal draft the housing policy &amp; resident agreement — eligibility…">
        <bpmn:documentation>Step 1: HR/Legal draft the housing policy &amp; resident agreement — eligibility, allocation, occupancy terms, house rules (conduct, visitors, quiet hours, prohibited items/acts), termination/eviction, fee/deduction, and welfare/anti-harassment
Responsible (R): HR / Legal / Housing Ops
Accountable (A): CHRO / VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4315_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4315_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4315_Task6" name="Labor Relations/Legal ensure alignment with the Labor Code (DOLE), the…">
        <bpmn:documentation>Step 2: Labor Relations/Legal ensure alignment with the Labor Code (DOLE), the employment relationship, and anti-discrimination/anti-harassment (coordinate VS-84/VS-19)
Responsible (R): Labor Relations / Legal
Accountable (A): CHRO / VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4315_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4315_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4315_Task7" name="HR/Housing Ops communicate the policy to residents, obtain signed…">
        <bpmn:documentation>Step 3: HR/Housing Ops communicate the policy to residents, obtain signed acknowledgment at move-in (W4321), and review on incident/change
Responsible (R): HR / Housing Ops
Accountable (A): CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4315_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4315_End8" name="Complete">
        <bpmn:incoming>W4315_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4315_Annotation9">
        <bpmn:text>Controls: - CTL-662 (ensure controlled execution — Housing Strategy, Portfolio &amp; Policy Framework (PA-144.1).) | - CTL-662: resident agreement legally reviewed (DOLE-compliant); anti-harassment in place; signed acknowledgment at move-in
Owner: HR (VS-19/VS-103) / Housing Ops / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4315_Assoc10" sourceRef="W4315_Annotation9" targetRef="W4315_Start4" associationDirection="None" />
