        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4319_Start4" name="Risk framework (W4318); audit cycle; regulatory change">
        <bpmn:outgoing>W4319_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4319_Task5" name="Compliance/Legal identify housing regulatory obligations — LGU…">
        <bpmn:documentation>Step 1: Compliance/Legal identify housing regulatory obligations — LGU lodging/dormitory permits (VS-76), BFP fire-safety certificate, DOLE OSH, BIR (fringe benefit), barangay/community — and the compliance monitoring approach
Responsible (R): Compliance / Legal
Accountable (A): Compliance Lead / VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4319_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4319_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4319_Task6" name="Audit/Housing Ops define housing internal-control points (allocation SoD…">
        <bpmn:documentation>Step 2: Audit/Housing Ops define housing internal-control points (allocation SoD, deduction accuracy, vendor SLA, safety inspection) and schedule audits (VS-21)
Responsible (R): Audit / Housing Ops
Accountable (A): Audit Lead / CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4319_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4319_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4319_Task7" name="Compliance/Legal document the framework, lodge permits (VS-22/VS-76), retain…">
        <bpmn:documentation>Step 3: Compliance/Legal document the framework, lodge permits (VS-22/VS-76), retain records (VS-88), and respond to inspections/inquiries
Responsible (R): Compliance / Legal / Audit
Accountable (A): VP Legal / CHRO
Duration: Annual + per inquiry</bpmn:documentation>
        <bpmn:incoming>W4319_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4319_End8" name="Complete">
        <bpmn:incoming>W4319_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4319_Annotation9">
        <bpmn:text>Controls: - CTL-128 (ensure dormitory safety &amp; welfare compliance.) | - CTL-662: LGU/BFP/DOLE permits current; housing controls audited (VS-21); records retained (VS-88)
Owner: Compliance (VS-22) / Audit (VS-21) / Housing Ops / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
