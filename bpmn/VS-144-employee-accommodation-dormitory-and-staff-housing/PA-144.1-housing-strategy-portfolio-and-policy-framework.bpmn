        <bpmn:flowNodeRef>W4318_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4318_Start4" name="Housing operation; incident; regulatory review">
        <bpmn:outgoing>W4318_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4318_Task5" name="HSE/Housing Ops set the housing safety standard — fire/life-safety (BFP Fire…">
        <bpmn:documentation>Step 1: HSE/Housing Ops set the housing safety standard — fire/life-safety (BFP Fire Code: exits, extinguishers, smoke detection, no overcrowding), structural, electrical, sanitation/ventilation, capacity (floor-area/person), and DOLE OSH on employer-provided housing
Responsible (R): HSE / Housing Ops / Facilities
Accountable (A): HSE Mgr / CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4318_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4318_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4318_Task6" name="Facilities/HSE inspect each housing unit to standard, remediate deficiencies…">
        <bpmn:documentation>Step 2: Facilities/HSE inspect each housing unit to standard, remediate deficiencies (W4329), and maintain inspection records
Responsible (R): Facilities / HSE
Accountable (A): Housing Ops Lead / HSE Mgr
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4318_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4318_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4318_Task7" name="HSE/HR/Insurance manage welfare incidents (injury, fire, harassment, illness)…">
        <bpmn:documentation>Step 3: HSE/HR/Insurance manage welfare incidents (injury, fire, harassment, illness), investigate, file insurance (VS-26), and feed the risk register (VS-21.2)
Responsible (R): HSE / HR / Insurance / Risk
Accountable (A): HSE Mgr / Head of Internal Audit &amp; Risk
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W4318_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4318_End8" name="Complete">
        <bpmn:incoming>W4318_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4318_Annotation9">
        <bpmn:text>Controls: - CTL-128 (ensure dormitory safety &amp; welfare compliance.) | - CTL-662: BFP fire-safety &amp; DOLE-OSH housing standard met; capacity not exceeded; incidents reported &amp; insured (VS-26)
Owner: HSE (VS-24) / Housing Ops / Compliance (VS-22)</bpmn:text>
      </bpmn:textAnnotation>
