      <bpmn:sequenceFlow id="W4313_Flow13" sourceRef="W4313_Task6" targetRef="W4313_Task7" />
      <bpmn:sequenceFlow id="W4313_Flow14" sourceRef="W4313_Task7" targetRef="W4313_End8" />
    </bpmn:process>
