    <bpmn:process id="W_W1636" name="W1636. Vendor Consignment Unsold Inventory Return &amp; Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Consignment agreement review (typically quarterly) or vendor request
Frequency: ~12 consignment vendor reviews/quarter
Volume: ~300 SKUs on consignment from 12 key vendors
Owner: Buyer
Participants: Buyer, Category Manager, DC Returns Coordinator, AP Clerk
Source: workflow W1636 — Vendor Consignment Unsold Inventory Return &amp; Settlement</bpmn:documentation>
      <bpmn:laneSet id="W1636_LaneSet4">
        <bpmn:lane id="W1636_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W1636_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1636_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1636_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
