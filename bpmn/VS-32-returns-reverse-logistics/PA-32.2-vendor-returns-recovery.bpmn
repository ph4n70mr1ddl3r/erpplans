        <bpmndi:BPMNEdge id="W1631_Flow17_di" bpmnElement="W1631_Flow17"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1631_Flow18_di" bpmnElement="W1631_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1631_Flow19_di" bpmnElement="W1631_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1631_Assoc13_di" bpmnElement="W1631_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1632" name="W1632. Vendor RTV Credit Recovery &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: RTV shipment received by vendor
Frequency: ~50–80 vendor credit recoveries/month
Volume: Monthly RTV credit value: ~PHP 3–5M
Owner: AP Clerk
Participants: AP Clerk, Buyer, Controller
Source: workflow W1632 — Vendor RTV Credit Recovery &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1632_LaneSet3">
        <bpmn:lane id="W1632_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W1632_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1632_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1632_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1632_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1632_Lane2" name="Controller">
        <bpmn:flowNodeRef>W1632_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1632_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1632_Start4" name="RTV shipment received by vendor">
        <bpmn:outgoing>W1632_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1632_Task5" name="Vendor confirms receipt of RTV shipment; issues credit note or replacement…">
        <bpmn:documentation>Step 1: Vendor confirms receipt of RTV shipment; issues credit note or replacement shipment; AP Clerk tracks confirmation status
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1632_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1632_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1632_Task6" name="AP Clerk matches vendor credit note to RTV record: (a) verifies credit amount…">
        <bpmn:documentation>Step 2: AP Clerk matches vendor credit note to RTV record: (a) verifies credit amount matches expected value (purchase price or agreed settlement), (b) verifies credit note references correct PO and RMA numbers
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: 10 min/credit</bpmn:documentation>
        <bpmn:incoming>W1632_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1632_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1632_Task7" name="Credit applied: (a) system applies vendor credit against open AP (reduces…">
        <bpmn:documentation>Step 3: Credit applied: (a) system applies vendor credit against open AP (reduces amount due to vendor), (b) or vendor issues replacement shipment — processed as GR at no cost
Responsible (R): AP Clerk / System
Accountable (A): Controller
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1632_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1632_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1632_Task8" name="Monthly: Controller reviews RTV recovery report: (a) total RTV shipments vs…">
        <bpmn:documentation>Step 4: Monthly: Controller reviews RTV recovery report: (a) total RTV shipments vs. total credits received, (b) recovery rate (credits received ÷ RTV value shipped — target: &gt; 90%), (c) aging of unrecovered RTVs (&gt; 60 days escalated to Buyer), (d) vendor RTV performance score (feeds into vendor scorecard per W44)
Responsible (R): Controller
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1632_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1632_End9" name="Complete">
        <bpmn:incoming>W1632_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1632_Annotation10">
        <bpmn:text>Controls: - CTL-338 (ensure controlled execution — Vendor Returns &amp; Recovery (PA-32.2).) | - operational: AP Clerk review and approval gate
Owner: AP Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1632_Assoc11" sourceRef="W1632_Annotation10" targetRef="W1632_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1632_Flow12" sourceRef="W1632_Start4" targetRef="W1632_Task5" />
      <bpmn:sequenceFlow id="W1632_Flow13" sourceRef="W1632_Task5" targetRef="W1632_Task6" />
      <bpmn:sequenceFlow id="W1632_Flow14" sourceRef="W1632_Task6" targetRef="W1632_Task7" />
      <bpmn:sequenceFlow id="W1632_Flow15" sourceRef="W1632_Task7" targetRef="W1632_Task8" />
      <bpmn:sequenceFlow id="W1632_Flow16" sourceRef="W1632_Task8" targetRef="W1632_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1632_diag">
      <bpmndi:BPMNPlane id="W1632_plane" bpmnElement="W_W1632">
        <bpmndi:BPMNShape id="W1632_Lane1_di" bpmnElement="W1632_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Lane2_di" bpmnElement="W1632_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Task5_di" bpmnElement="W1632_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Task6_di" bpmnElement="W1632_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Task7_di" bpmnElement="W1632_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Task8_di" bpmnElement="W1632_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Start4_di" bpmnElement="W1632_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_End9_di" bpmnElement="W1632_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1632_Annotation10_di" bpmnElement="W1632_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1632_Flow12_di" bpmnElement="W1632_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1632_Flow13_di" bpmnElement="W1632_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1632_Flow14_di" bpmnElement="W1632_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1632_Flow15_di" bpmnElement="W1632_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1632_Flow16_di" bpmnElement="W1632_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1632_Assoc11_di" bpmnElement="W1632_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1633" name="W1633. Vendor Defective Product Investigation &amp; Root Cause Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Defect rate exceeds threshold for a vendor/product (3+ defects of same type in 30 days)
Frequency: ~10–15 investigations/month
Volume: Focus on high-impact defects (safety, high-value, high-volume)
Owner: Quality Manager
Participants: Quality Manager, Buyer, DC Quality Inspector, vendor quality team
Source: workflow W1633 — Vendor Defective Product Investigation &amp; Root Cause Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1633_LaneSet3">
        <bpmn:lane id="W1633_Lane1" name="System">
        <bpmn:flowNodeRef>W1633_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1633_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1633_Lane2" name="Quality Manager">
        <bpmn:flowNodeRef>W1633_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1633_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1633_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1633_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1633_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1633_Start4" name="Defect rate exceeds threshold for a vendor/product (3+ defects of same type in 30 days)">
        <bpmn:outgoing>W1633_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1633_Task5" name="System alerts Quality Manager when defect pattern detected: (a) same vendor…">
        <bpmn:documentation>Step 1: System alerts Quality Manager when defect pattern detected: (a) same vendor, same SKU, same defect type ≥ 3 occurrences in 30 days, (b) same vendor, different SKUs, similar defect type ≥ 5 occurrences in 30 days, (c) any safety-related defect pattern
Responsible (R): System
Accountable (A): Quality Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1633_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1633_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1633_Task6" name="Quality Manager initiates investigation: (a) collects defect samples and photos…">
        <bpmn:documentation>Step 2: Quality Manager initiates investigation: (a) collects defect samples and photos from DC/stores, (b) reviews GR inspection records for affected lots, (c) reviews customer complaint records for affected products, (d) categorizes root cause hypothesis: (i) manufacturing defect, (ii) packaging inadequacy, (iii) shipping/handling damage, (iv) specification mismatch
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1633_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1633_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1633_Task7" name="Quality Manager and Buyer engage vendor: (a) share defect evidence and data…">
        <bpmn:documentation>Step 3: Quality Manager and Buyer engage vendor: (a) share defect evidence and data, (b) request vendor root cause analysis, (c) agree on corrective action and timeline per W1610 (VCAR), (d) agree on immediate containment (hold shipments, substitute product, enhanced inspection)
Responsible (R): Quality Manager / Buyer
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1633_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1633_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1633_Task8" name="If vendor does not accept responsibility: (a) Quality Manager engages…">
        <bpmn:documentation>Step 4: If vendor does not accept responsibility: (a) Quality Manager engages third-party testing laboratory for independent analysis (cost: PHP 10–30K per test), (b) test results shared with vendor for resolution, (c) if dispute continues: escalate to Category Manager and VP Merchandising for commercial resolution
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1633_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1633_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1633_Task9" name="Investigation closed when: (a) root cause identified and corrective action…">
        <bpmn:documentation>Step 5: Investigation closed when: (a) root cause identified and corrective action implemented, (b) vendor VCAR closed per W1610, (c) enhanced inspection shows defect rate returned to normal
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1633_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1633_End10" name="Complete">
        <bpmn:incoming>W1633_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1633_Annotation11">
        <bpmn:text>Controls: - CTL-338 (ensure controlled execution — Vendor Returns &amp; Recovery (PA-32.2).) | - operational: Quality Manager review and approval gate
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1633_Assoc12" sourceRef="W1633_Annotation11" targetRef="W1633_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1633_Flow13" sourceRef="W1633_Start4" targetRef="W1633_Task5" />
      <bpmn:sequenceFlow id="W1633_Flow14" sourceRef="W1633_Task5" targetRef="W1633_Task6" />
      <bpmn:sequenceFlow id="W1633_Flow15" sourceRef="W1633_Task6" targetRef="W1633_Task7" />
      <bpmn:sequenceFlow id="W1633_Flow16" sourceRef="W1633_Task7" targetRef="W1633_Task8" />
