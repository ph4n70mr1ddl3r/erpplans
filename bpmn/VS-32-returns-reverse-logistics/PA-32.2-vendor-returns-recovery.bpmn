<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-32.2-vendor-returns-recovery" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1631" name="W1631. Vendor Return-to-Vendor (RTV) Shipment Planning &amp; Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: RTV authorization created (from W91, W1280, or W1626 disposition)
Frequency: ~200–300 RTV shipments/month
Volume: Consolidated into ~50–80 vendor shipments/month
Owner: DC Returns Coordinator
Participants: DC Returns Coordinator, Receiving Clerk, Buyer, Vendor
Source: workflow W1631 — Vendor Return-to-Vendor (RTV) Shipment Planning &amp; Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W1631_LaneSet4">
        <bpmn:lane id="W1631_Lane1" name="System">
        <bpmn:flowNodeRef>W1631_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1631_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1631_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1631_Lane2" name="DC Returns Coordinator">
        <bpmn:flowNodeRef>W1631_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1631_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1631_Lane3" name="Buyer">
        <bpmn:flowNodeRef>W1631_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1631_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1631_Start5" name="RTV authorization created (from W91, W1280, or W1626 disposition)">
        <bpmn:outgoing>W1631_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1631_Task6" name="System compiles RTV-eligible inventory: items with &quot;Return to Vendor&quot;…">
        <bpmn:documentation>Step 1: System compiles RTV-eligible inventory: items with &quot;Return to Vendor&quot; disposition from W91 (damaged/defective), W1280 (excess merchandise), or W1626 (customer return assessment); grouped by vendor
Responsible (R): System
Accountable (A): DC Returns Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1631_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1631_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1631_Task7" name="DC Returns Coordinator reviews RTV queue weekly: (a) prioritizes by: (i) vendor…">
        <bpmn:documentation>Step 2: DC Returns Coordinator reviews RTV queue weekly: (a) prioritizes by: (i) vendor credit value (high-value RTVs processed first), (ii) vendor RTV policy deadline (some vendors require RTV within 30 days of delivery), (iii) perishable/shelf-life urgency (cement, chemicals), (b) checks vendor RTV requirements: (i) RMA required from vendor (contact Buyer to obtain), (ii) original packaging required, (iii) specific carrier or ship-to address, (c) consolidates multiple RTV items for same vendor into single shipment
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1631_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1631_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1631_Task8" name="Buyer obtains RMA from vendor: (a) contacts vendor with RTV details (items…">
        <bpmn:documentation>Step 3: Buyer obtains RMA from vendor: (a) contacts vendor with RTV details (items, quantities, defect description, original PO reference), (b) vendor approves RMA with return authorization number, (c) vendor specifies return shipping terms (vendor pays, BuildRight pays, split)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 30 min/vendor</bpmn:documentation>
        <bpmn:incoming>W1631_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1631_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1631_Task9" name="DC Returns Coordinator prepares RTV shipment: (a) picks items from…">
        <bpmn:documentation>Step 4: DC Returns Coordinator prepares RTV shipment: (a) picks items from quarantine/damaged goods area, (b) packs per vendor requirements, (c) prints shipping label and packing list with RMA number, (d) stages for carrier pickup or vendor pickup
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 30 min/shipment</bpmn:documentation>
        <bpmn:incoming>W1631_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1631_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1631_Task10" name="Shipment processed in system: (a) inventory deducted from &quot;RTV Pending&quot; status…">
        <bpmn:documentation>Step 5: Shipment processed in system: (a) inventory deducted from &quot;RTV Pending&quot; status, (b) in-transit RTV inventory tracked, (c) AP Clerk notified of pending vendor credit
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1631_Flow18</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1631_End11" name="Complete">
        <bpmn:incoming>W1631_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1631_Annotation12">
        <bpmn:text>Controls: - CTL-338 (ensure controlled execution — Vendor Returns &amp; Recovery (PA-32.2).) | - operational: DC Returns Coordinator review and approval gate
Owner: DC Returns Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1631_Assoc13" sourceRef="W1631_Annotation12" targetRef="W1631_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1631_Flow14" sourceRef="W1631_Start5" targetRef="W1631_Task6" />
      <bpmn:sequenceFlow id="W1631_Flow15" sourceRef="W1631_Task6" targetRef="W1631_Task7" />
      <bpmn:sequenceFlow id="W1631_Flow16" sourceRef="W1631_Task7" targetRef="W1631_Task8" />
      <bpmn:sequenceFlow id="W1631_Flow17" sourceRef="W1631_Task8" targetRef="W1631_Task9" />
      <bpmn:sequenceFlow id="W1631_Flow18" sourceRef="W1631_Task9" targetRef="W1631_Task10" />
      <bpmn:sequenceFlow id="W1631_Flow19" sourceRef="W1631_Task10" targetRef="W1631_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1631_diag">
      <bpmndi:BPMNPlane id="W1631_plane" bpmnElement="W_W1631">
        <bpmndi:BPMNShape id="W1631_Lane1_di" bpmnElement="W1631_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
