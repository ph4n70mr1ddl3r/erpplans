        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1635_Start6" name="Season ends or promotion concludes; unsold seasonal/promotional inventory eligible for…">
        <bpmn:outgoing>W1635_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1635_Task7" name="Buyer reviews seasonal/promotional vendor agreements for return eligibility…">
        <bpmn:documentation>Step 1: Buyer reviews seasonal/promotional vendor agreements for return eligibility: (a) some vendor contracts include seasonal return provisions (unsold seasonal items returnable within 30 days of season end), (b) identifies eligible items, quantities, and return terms
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2 hours/season</bpmn:documentation>
        <bpmn:incoming>W1635_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1635_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1635_Task8" name="DC Returns Coordinator consolidates unsold seasonal inventory from stores and…">
        <bpmn:documentation>Step 2: DC Returns Coordinator consolidates unsold seasonal inventory from stores and DCs; identifies items meeting return criteria (unused, original packaging, within return window)
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: 4 hours/season</bpmn:documentation>
        <bpmn:incoming>W1635_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1635_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1635_Task9" name="Buyer obtains RMA from vendor; DC Returns Coordinator processes RTV shipment…">
        <bpmn:documentation>Step 3: Buyer obtains RMA from vendor; DC Returns Coordinator processes RTV shipment per W1631
Responsible (R): Buyer / DC Returns Coordinator
Accountable (A): Category Manager
Duration: Per W1631</bpmn:documentation>
        <bpmn:incoming>W1635_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1635_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1635_Task10" name="AP Clerk processes vendor credit per W1632">
        <bpmn:documentation>Step 4: AP Clerk processes vendor credit per W1632
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: Per W1632</bpmn:documentation>
        <bpmn:incoming>W1635_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1635_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1635_Task11" name="Items not eligible for vendor return: dispositioned per W93…">
        <bpmn:documentation>Step 5: Items not eligible for vendor return: dispositioned per W93 (markdown/clearance) or W91 (donate/scrap)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 hour/season</bpmn:documentation>
        <bpmn:incoming>W1635_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1635_End12" name="Complete">
        <bpmn:incoming>W1635_Flow20</bpmn:incoming>
      </bpmn:endEvent>
