    <bpmn:process id="W_W1635" name="W1635. Vendor Seasonal/Promotional Return Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Season ends or promotion concludes; unsold seasonal/promotional inventory eligible for vendor return
Frequency: ~6–8 seasonal return events/year (aligned with Philippine seasonal calendar)
Volume: ~500–1,000 units per seasonal event
Owner: Buyer
Participants: Buyer, Category Manager, DC Returns Coordinator, AP Clerk
Source: workflow W1635 — Vendor Seasonal/Promotional Return Processing</bpmn:documentation>
      <bpmn:laneSet id="W1635_LaneSet5">
        <bpmn:lane id="W1635_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W1635_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1635_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1635_Start6</bpmn:flowNodeRef>
