        <bpmn:flowNodeRef>W1636_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1636_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1636_Start5" name="Consignment agreement review (typically quarterly) or vendor request">
        <bpmn:outgoing>W1636_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1636_Task6" name="Quarterly: Buyer reviews consignment inventory performance: (a) sell-through…">
        <bpmn:documentation>Step 1: Quarterly: Buyer reviews consignment inventory performance: (a) sell-through rate per SKU per vendor, (b) aging of consignment inventory (&gt; 180 days unsold), (c) margin contribution of consignment vs. owned inventory
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2 hours/vendor</bpmn:documentation>
        <bpmn:incoming>W1636_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1636_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1636_Task7" name="For unsold consignment inventory: (a) Buyer negotiates with vendor: (i) return…">
        <bpmn:documentation>Step 2: For unsold consignment inventory: (a) Buyer negotiates with vendor: (i) return unsold inventory to vendor, (ii) convert to owned inventory at discounted price, (iii) markdown and sell at clearance, (b) vendor selects option; agreement documented
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1 hour/vendor</bpmn:documentation>
        <bpmn:incoming>W1636_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1636_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1636_Task8" name="If vendor requests return: DC Returns Coordinator processes RTV per W1631…">
        <bpmn:documentation>Step 3: If vendor requests return: DC Returns Coordinator processes RTV per W1631; consignment inventory physically returned to vendor
Responsible (R): DC Returns Coordinator
Accountable (A): DC Supervisor
Duration: Per W1631</bpmn:documentation>
        <bpmn:incoming>W1636_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1636_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1636_Task9" name="Settlement: (a) AP Clerk calculates consignment settlement: (i) sold inventory…">
        <bpmn:documentation>Step 4: Settlement: (a) AP Clerk calculates consignment settlement: (i) sold inventory — vendor payment at agreed consignment price, (ii) unsold returned inventory — no payment, (iii) markdown losses — per vendor agreement (vendor absorbs loss or shared), (b) system generates settlement report; payment processed per consignment terms
Responsible (R): AP Clerk
Accountable (A): Controller
Duration: 2 hours/quarter/vendor</bpmn:documentation>
        <bpmn:incoming>W1636_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1636_End10" name="Complete">
        <bpmn:incoming>W1636_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1636_Annotation11">
        <bpmn:text>Controls: - CTL-338 (ensure controlled execution — Vendor Returns &amp; Recovery (PA-32.2).) | - operational: Buyer review and approval gate
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1636_Assoc12" sourceRef="W1636_Annotation11" targetRef="W1636_Start5" associationDirection="None" />
