      </bpmn:startEvent>
      <bpmn:userTask id="W2914_Task5" name="Tax Accountant compiles Book of Sales/Transactions for SC/PWD per location (or…">
        <bpmn:documentation>Step 1: Tax Accountant compiles Book of Sales/Transactions for SC/PWD per location (or aggregated per BIR tolerance); validates against POS register
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2914_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2914_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2914_Task6" name="Tax Manager prepares quarterly SC/PWD Book-of-Sales summary report per RR…">
        <bpmn:documentation>Step 2: Tax Manager prepares quarterly SC/PWD Book-of-Sales summary report per RR 7-2010; reviews completeness
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2914_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2914_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2914_Task7" name="Tax Manager submits the SC/PWD quarterly summary to BIR/DOF via eFPS/letter…">
        <bpmn:documentation>Step 3: Tax Manager submits the SC/PWD quarterly summary to BIR/DOF via eFPS/letter; archives confirmation; tracks acknowledgment
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2914_Flow13</bpmn:incoming>
      </bpmn:userTask>
