    <bpmn:process id="W_W2913" name="W2913. SC/PWD/Solo Parent Tax Credit Computation &amp; Monthly Claim Buildup" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close
Frequency: Monthly
Volume: ~140K–225K transactions/month
Owner: Tax Accountant
Participants: Tax Accountant, Finance, IT
Source: workflow W2913 — SC/PWD/Solo Parent Tax Credit Computation &amp; Monthly Claim Buildup</bpmn:documentation>
      <bpmn:laneSet id="W2913_LaneSet4">
        <bpmn:lane id="W2913_Lane1" name="ERP automation">
