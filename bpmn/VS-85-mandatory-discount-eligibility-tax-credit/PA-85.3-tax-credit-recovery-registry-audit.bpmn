    <bpmn:process id="W_W2916" name="W2916. LGU Local Tax Credit &amp; Real Property Tax Exemption Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Annual LBT/RPT cycle
Frequency: Annual
Volume: ~150 LGUs (per the ~205-locations canon)
Owner: Tax Manager
Participants: Tax Manager, Regulatory Officer, Finance
Source: workflow W2916 — LGU Local Tax Credit &amp; Real Property Tax Exemption Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2916_LaneSet4">
        <bpmn:lane id="W2916_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W2916_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2916_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2916_Lane2" name="Regulatory Officer">
        <bpmn:flowNodeRef>W2916_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2916_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2916_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2916_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2916_Start5" name="Annual LBT/RPT cycle">
        <bpmn:outgoing>W2916_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2916_Task6" name="Tax Manager identifies LGU local-tax-credit opportunities (some LGUs grant…">
        <bpmn:documentation>Step 1: Tax Manager identifies LGU local-tax-credit opportunities (some LGUs grant credit for mandatory discounts granted to SC/PWD within their jurisdiction)
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2916_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2916_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2916_Task7" name="Regulatory Officer coordinates with LGU Treasurer; submits documentation…">
        <bpmn:documentation>Step 2: Regulatory Officer coordinates with LGU Treasurer; submits documentation; pursues credit against LBT/RPT where available
Responsible (R): Regulatory Officer
Accountable (A): Tax Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2916_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2916_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2916_Task8" name="Finance books any LGU credit; tracks jurisdiction-by-jurisdiction outcomes…">
        <bpmn:documentation>Step 3: Finance books any LGU credit; tracks jurisdiction-by-jurisdiction outcomes; refines annual claim strategy
Responsible (R): Finance
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2916_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2916_End9" name="Complete">
        <bpmn:incoming>W2916_Flow15</bpmn:incoming>
      </bpmn:endEvent>
