        <bpmn:outgoing>W2913_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2913_Task6" name="ERP aggregates SC/PWD/Solo Parent discount amount and associated VAT component…">
        <bpmn:documentation>Step 1: ERP aggregates SC/PWD/Solo Parent discount amount and associated VAT component from mandatory book per entity/month
Responsible (R): ERP automation
Accountable (A): Tax Accountant
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2913_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2913_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2913_Task7" name="Tax Accountant computes tax-credit-claimable amount (discount treated as…">
        <bpmn:documentation>Step 2: Tax Accountant computes tax-credit-claimable amount (discount treated as deductible from gross sales or VAT output per BIR rules); validates computation methodology
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2913_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2913_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2913_Task8" name="Tax Manager approves monthly claim buildup; books tax-credit receivable…">
        <bpmn:documentation>Step 3: Tax Manager approves monthly claim buildup; books tax-credit receivable; integrates into VAT return computation
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2913_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2913_End9" name="Complete">
        <bpmn:incoming>W2913_Flow15</bpmn:incoming>
      </bpmn:endEvent>
