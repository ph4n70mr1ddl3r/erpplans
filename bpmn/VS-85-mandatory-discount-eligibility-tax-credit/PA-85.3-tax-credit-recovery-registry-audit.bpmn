    <bpmn:process id="W_W2915" name="W2915. Tax Credit Certificate (TCC) Application &amp; Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Annual or large accumulated credit
Frequency: Annual + event-driven
Volume: Per entity
Owner: Tax Manager
Participants: Tax Manager, Tax Accountant, External Counsel
Source: workflow W2915 — Tax Credit Certificate (TCC) Application &amp; Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2915_LaneSet3">
        <bpmn:lane id="W2915_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W2915_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2915_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2915_Lane2" name="Tax Manager">
