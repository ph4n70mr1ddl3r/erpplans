        <bpmn:flowNodeRef>W2915_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2915_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2915_Start4" name="Annual or large accumulated credit">
        <bpmn:outgoing>W2915_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2915_Task5" name="Tax Accountant prepares TCC application with supporting schedules (accumulated…">
        <bpmn:documentation>Step 1: Tax Accountant prepares TCC application with supporting schedules (accumulated SC/PWD credit, 2552 history, VAT returns)
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2915_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2915_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2915_Task6" name="Tax Manager files TCC application with BIR; responds to BIR verification…">
        <bpmn:documentation>Step 2: Tax Manager files TCC application with BIR; responds to BIR verification queries; coordinates with External Counsel for complex cases
Responsible (R): Tax Manager / External Counsel
Accountable (A): CFO
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W2915_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2915_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2915_Task7" name="Tax Manager tracks TCC issuance; applies TCC against future tax liabilities or…">
        <bpmn:documentation>Step 3: Tax Manager tracks TCC issuance; applies TCC against future tax liabilities or pursues cash refund; books utilization
Responsible (R): Tax Manager
Accountable (A): CFO
Duration: Per TCC</bpmn:documentation>
        <bpmn:incoming>W2915_Flow13</bpmn:incoming>
      </bpmn:userTask>
