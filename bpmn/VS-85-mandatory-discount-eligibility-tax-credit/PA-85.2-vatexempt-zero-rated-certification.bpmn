    <bpmn:process id="W_W2905" name="W2905. PEZA/BOI VAT-Zero-Rated Sale Customer Onboarding &amp; Certificate Management" isExecutable="false">
      <bpmn:documentation>Trigger: New PEZA/BOI customer or renewal
Frequency: Event-driven + annual
Volume: ~50–150 registered entities
Owner: Tax Accountant
Participants: Tax Accountant, AR, Trade Sales
Source: workflow W2905 — PEZA/BOI VAT-Zero-Rated Sale Customer Onboarding &amp; Certificate Management</bpmn:documentation>
      <bpmn:laneSet id="W2905_LaneSet3">
        <bpmn:lane id="W2905_Lane1" name="Trade Sales">
        <bpmn:flowNodeRef>W2905_Task5</bpmn:flowNodeRef>
