        <bpmn:flowNodeRef>W2905_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2905_Start4" name="New PEZA/BOI customer or renewal">
        <bpmn:outgoing>W2905_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2905_Task5" name="Trade Sales obtains PEZA/BOI Certificate of VAT Zero-Rating and registration at…">
        <bpmn:documentation>Step 1: Trade Sales obtains PEZA/BOI Certificate of VAT Zero-Rating and registration at account setup; AR stores in customer master
Responsible (R): Trade Sales / AR
Accountable (A): Tax Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2905_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2905_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2905_Task6" name="Tax Accountant validates certificate currency and scope; configures…">
        <bpmn:documentation>Step 2: Tax Accountant validates certificate currency and scope; configures VAT-zero-rated treatment in customer/item tax code; audits renewal calendar
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W2905_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2905_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2905_Task7" name="Tax Accountant compiles zero-rated sales schedule monthly for 2550M; defends…">
        <bpmn:documentation>Step 3: Tax Accountant compiles zero-rated sales schedule monthly for 2550M; defends input VAT refund with BIR
Responsible (R): Tax Accountant
Accountable (A): Tax Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2905_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2905_End8" name="Complete">
        <bpmn:incoming>W2905_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2905_Annotation9">
        <bpmn:text>Controls: - CTL-236 (ensure mandatory-discount &amp; VAT-exemption compliance.) | - operational: annual renewal tracking
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
