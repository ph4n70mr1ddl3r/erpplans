    <bpmn:process id="W_W2906" name="W2906. Government / Diplomatic VAT-Exempt Purchase Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Government agency or diplomatic mission purchase
Frequency: Event-driven
Volume: ~100–300 transactions/year
Owner: Trade Sales Representative
Participants: Trade Sales, Tax Accountant, AR
Source: workflow W2906 — Government / Diplomatic VAT-Exempt Purchase Documentation</bpmn:documentation>
