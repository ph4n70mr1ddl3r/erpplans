    <bpmn:process id="W_W2438" name="W2438. Project Sales Order Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer approves quotation
Frequency: ~300–450 project orders/month
Volume: ~300–450/month; avg project value PHP 200K–1M
Owner: Project Consultant
Participants: Project Consultant, Store Manager, Finance
Source: workflow W2438 — Project Sales Order Processing</bpmn:documentation>
      <bpmn:laneSet id="W2438_LaneSet3">
        <bpmn:lane id="W2438_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2438_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2438_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2438_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2438_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2438_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2438_Start4" name="Customer approves quotation">
        <bpmn:outgoing>W2438_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2438_Task5" name="Project Consultant converts approved quotation to sales order: links all…">
        <bpmn:documentation>Step 1: Project Consultant converts approved quotation to sales order: links all materials to SKUs, confirms pricing, sets delivery schedule, allocates inventory from store/DC; deposit verified
Responsible (R): Project Consultant
Accountable (A): Store Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2438_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2438_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2438_Task6" name="Finance validates deposit payment; system reserves inventory; generates pick…">
        <bpmn:documentation>Step 2: Finance validates deposit payment; system reserves inventory; generates pick lists for store/DC; project entered into project tracking system with milestones
Responsible (R): Finance / System
Accountable (A): Project Consultant
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2438_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2438_End7" name="Complete">
        <bpmn:incoming>W2438_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2438_Annotation8">
        <bpmn:text>Controls: - CTL-428 (ensure controlled execution — Project Quotation &amp; Material Management (PA-66.2).) | - operational: Project Consultant sign-off on the workflow output
Owner: Project Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2438_Assoc9" sourceRef="W2438_Annotation8" targetRef="W2438_Start4" associationDirection="None" />
