      </bpmn:startEvent>
      <bpmn:userTask id="W2444_Task5" name="Project Consultant compiles warranty package: all installed products with…">
        <bpmn:documentation>Step 1: Project Consultant compiles warranty package: all installed products with individual warranty registration, installation warranty (1 year workmanship), care and maintenance guide
Responsible (R): Project Consultant
Accountable (A): Customer
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2444_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2444_Flow10</bpmn:outgoing>
      </bpmn:userTask>
