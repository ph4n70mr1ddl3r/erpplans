      </bpmn:startEvent>
      <bpmn:serviceTask id="W2445_Task5" name="Customer returns unused materials in saleable condition; Receiving Clerk…">
        <bpmn:documentation>Step 1: Customer returns unused materials in saleable condition; Receiving Clerk inspects and processes return; system credits customer account or issues refund; material restocked
Responsible (R): Receiving Clerk / System
Accountable (A): Store Manager
Duration: 15–30 min per return</bpmn:documentation>
        <bpmn:incoming>W2445_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2445_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2445_Task6" name="Finance adjusts project final cost for returned materials; damaged/unsaleable…">
        <bpmn:documentation>Step 2: Finance adjusts project final cost for returned materials; damaged/unsaleable returns processed per vendor return policy
Responsible (R): Finance
Accountable (A): Finance Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2445_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2445_End7" name="Complete">
        <bpmn:incoming>W2445_Flow12</bpmn:incoming>
      </bpmn:endEvent>
