    <bpmn:process id="W_W2441" name="W2441. Project Installation Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Customer opts for BuildRight-managed installation
Frequency: ~150–225 installations/month (~50% of projects)
Volume: ~150–225/month
Owner: Installation Coordinator
Participants: Installation Coord, Contractor, Project Consultant, Customer
Source: workflow W2441 — Project Installation Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2441_LaneSet3">
        <bpmn:lane id="W2441_Lane1" name="Installation Coordinator">
        <bpmn:flowNodeRef>W2441_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2441_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2441_Lane2" name="Contractor">
        <bpmn:flowNodeRef>W2441_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2441_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2441_Start4" name="Customer opts for BuildRight-managed installation">
        <bpmn:outgoing>W2441_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2441_Task5" name="Installation Coordinator assigns licensed contractor from BuildRight&#x27;s…">
        <bpmn:documentation>Step 1: Installation Coordinator assigns licensed contractor from BuildRight&#x27;s installer network (VS-12); provides project specifications; schedules installation dates; contractor confirms
Responsible (R): Installation Coordinator
Accountable (A): Project Consultant
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2441_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2441_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2441_Task6" name="Contractor performs installation; Project Consultant conducts quality check at…">
        <bpmn:documentation>Step 2: Contractor performs installation; Project Consultant conducts quality check at key milestones; customer signs milestone completions; contractor paid upon completion
Responsible (R): Contractor / Project Consultant
Accountable (A): Customer
Duration: 3–30 days per project</bpmn:documentation>
        <bpmn:incoming>W2441_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2441_End7" name="Complete">
        <bpmn:incoming>W2441_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2441_Annotation8">
        <bpmn:text>Controls: - CTL-428 (ensure controlled execution — Project Quotation &amp; Material Management (PA-66.2).) | - operational: Installation Coordinator sign-off on the workflow output
Owner: Installation Coordinator</bpmn:text>
      </bpmn:textAnnotation>
