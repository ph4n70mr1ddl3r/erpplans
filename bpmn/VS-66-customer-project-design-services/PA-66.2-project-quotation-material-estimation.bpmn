    <bpmn:process id="W_W2440" name="W2440. Project Delivery Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Materials ready; schedule delivery to customer site
Frequency: ~300–450 deliveries/month
Volume: ~300–450/month; often multi-drop
Owner: Logistics Coordinator
Participants: Logistics Coord, 3PL Partner, Project Consultant, Customer
Source: workflow W2440 — Project Delivery Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2440_LaneSet3">
        <bpmn:lane id="W2440_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2440_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2440_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2440_Lane2" name="3PL">
        <bpmn:flowNodeRef>W2440_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2440_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2440_Start4" name="Materials ready; schedule delivery to customer site">
        <bpmn:outgoing>W2440_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2440_Task5" name="Coordinator schedules delivery: coordinates with 3PL per VS-56 for bulky…">
        <bpmn:documentation>Step 1: Coordinator schedules delivery: coordinates with 3PL per VS-56 for bulky materials (tiles, lumber, cement); ensures customer or representative on-site for receipt; confirms delivery window
Responsible (R): Logistics Coordinator
Accountable (A): Project Consultant
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2440_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2440_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2440_Task6" name="3PL delivers; customer verifies quantity and condition; system updates goods…">
        <bpmn:documentation>Step 2: 3PL delivers; customer verifies quantity and condition; system updates goods delivered status; discrepancies reported and resolved within 48 hours
Responsible (R): 3PL / Customer / System
Accountable (A): Logistics Coordinator
Duration: 1 day delivery</bpmn:documentation>
        <bpmn:incoming>W2440_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2440_End7" name="Complete">
        <bpmn:incoming>W2440_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2440_Annotation8">
        <bpmn:text>Controls: - CTL-428 (ensure controlled execution — Project Quotation &amp; Material Management (PA-66.2).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
