    <bpmn:process id="W_W2439" name="W2439. Project Material Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Project requires materials not in stock
Frequency: ~100–150 procurement requests/month
Volume: ~100–150/month
Owner: Buyer
Participants: Buyer, Project Consultant, Vendor
Source: workflow W2439 — Project Material Procurement</bpmn:documentation>
      <bpmn:laneSet id="W2439_LaneSet2">
        <bpmn:lane id="W2439_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2439_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2439_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2439_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2439_Start3" name="Project requires materials not in stock">
        <bpmn:outgoing>W2439_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2439_Task4" name="Project Consultant identifies non-stock items; Buyer places special order with…">
        <bpmn:documentation>Step 1: Project Consultant identifies non-stock items; Buyer places special order with vendor; system creates PO linked to project; tracks delivery to store/DC; coordinates with project schedule
Responsible (R): Project Consultant / Buyer
Accountable (A): Category Manager
Duration: 2–3 days lead time</bpmn:documentation>
        <bpmn:incoming>W2439_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2439_End5" name="Complete">
        <bpmn:incoming>W2439_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2439_Annotation6">
        <bpmn:text>Controls: - CTL-428 (ensure controlled execution — Project Quotation &amp; Material Management (PA-66.2).) | - operational: Buyer sign-off on the workflow output
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2439_Assoc7" sourceRef="W2439_Annotation6" targetRef="W2439_Start3" associationDirection="None" />
