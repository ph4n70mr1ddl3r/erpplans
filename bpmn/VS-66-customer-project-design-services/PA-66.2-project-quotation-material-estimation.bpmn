    <bpmn:process id="W_W2445" name="W2445. Project Material Returns &amp; Surplus Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Project complete; surplus materials to return
Frequency: ~200–300 surplus return requests/month
Volume: ~200–300/month
Owner: Store Receiving Clerk
Participants: Receiving Clerk, Project Consultant, Finance
Source: workflow W2445 — Project Material Returns &amp; Surplus Handling</bpmn:documentation>
      <bpmn:laneSet id="W2445_LaneSet3">
        <bpmn:lane id="W2445_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2445_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2445_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
