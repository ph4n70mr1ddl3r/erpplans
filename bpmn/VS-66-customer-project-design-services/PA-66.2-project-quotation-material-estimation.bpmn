      <bpmn:sequenceFlow id="W2441_Flow11" sourceRef="W2441_Task5" targetRef="W2441_Task6" />
      <bpmn:sequenceFlow id="W2441_Flow12" sourceRef="W2441_Task6" targetRef="W2441_End7" />
    </bpmn:process>
