      <bpmn:sequenceFlow id="W2438_Flow11" sourceRef="W2438_Task5" targetRef="W2438_Task6" />
      <bpmn:sequenceFlow id="W2438_Flow12" sourceRef="W2438_Task6" targetRef="W2438_End7" />
    </bpmn:process>
