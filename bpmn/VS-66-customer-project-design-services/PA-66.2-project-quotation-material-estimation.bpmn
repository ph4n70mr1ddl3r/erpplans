    <bpmn:process id="W_W2443" name="W2443. Project Payment Collection &amp; Milestone Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Project milestone completed; payment due
Frequency: ~600–900 milestone payments/month (2–3 per project)
Volume: ~600–900/month
Owner: Finance Analyst
Participants: Finance Analyst, Project Consultant, Customer
Source: workflow W2443 — Project Payment Collection &amp; Milestone Billing</bpmn:documentation>
      <bpmn:laneSet id="W2443_LaneSet2">
