    <bpmn:process id="W_W2442" name="W2442. Project Change Order Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests change during execution
Frequency: ~100–150 change orders/month (~30% of projects)
Volume: ~100–150/month
Owner: Project Consultant
Participants: Project Consultant, Customer, Finance
Source: workflow W2442 — Project Change Order Management</bpmn:documentation>
      <bpmn:laneSet id="W2442_LaneSet2">
        <bpmn:lane id="W2442_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2442_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2442_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2442_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2442_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2442_Start3" name="Customer requests change during execution">
        <bpmn:outgoing>W2442_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2442_Task4" name="Customer requests change: additional materials, design modification, scope…">
        <bpmn:documentation>Step 1: Customer requests change: additional materials, design modification, scope change; Project Consultant evaluates impact on cost and timeline; prepares change order quotation
Responsible (R): Project Consultant
Accountable (A): Customer
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2442_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2442_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2442_Task5" name="Customer approves change order; Finance adjusts project value and payment…">
        <bpmn:documentation>Step 2: Customer approves change order; Finance adjusts project value and payment schedule; system updates material requirements; additional materials procured and delivered
Responsible (R): Project Consultant / Finance
Accountable (A): Store Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2442_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2442_End6" name="Complete">
        <bpmn:incoming>W2442_Flow11</bpmn:incoming>
      </bpmn:endEvent>
