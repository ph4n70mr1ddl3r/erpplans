      <bpmn:sequenceFlow id="W2433_Flow11" sourceRef="W2433_Task5" targetRef="W2433_Task6" />
      <bpmn:sequenceFlow id="W2433_Flow12" sourceRef="W2433_Task6" targetRef="W2433_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2433_diag">
      <bpmndi:BPMNPlane id="W2433_plane" bpmnElement="W_W2433">
        <bpmndi:BPMNShape id="W2433_Lane1_di" bpmnElement="W2433_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_Lane2_di" bpmnElement="W2433_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_Task5_di" bpmnElement="W2433_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_Task6_di" bpmnElement="W2433_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_Start4_di" bpmnElement="W2433_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_End7_di" bpmnElement="W2433_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2433_Annotation8_di" bpmnElement="W2433_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
