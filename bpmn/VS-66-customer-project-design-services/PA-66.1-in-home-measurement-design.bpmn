    <bpmn:process id="W_W2434" name="W2434. Project Quotation &amp; Pricing" isExecutable="false">
      <bpmn:documentation>Trigger: Material specification complete; pricing required
Frequency: ~400–600 quotes/month
Volume: ~400–600/month
Owner: Project Consultant
Participants: Project Consultant, Pricing Analyst, Finance
Source: workflow W2434 — Project Quotation &amp; Pricing</bpmn:documentation>
      <bpmn:laneSet id="W2434_LaneSet3">
        <bpmn:lane id="W2434_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2434_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2434_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2434_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2434_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2434_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2434_Start4" name="Material specification complete; pricing required">
        <bpmn:outgoing>W2434_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2434_Task5" name="Project Consultant prices all materials at trade/project price per VS-11…">
        <bpmn:documentation>Step 1: Project Consultant prices all materials at trade/project price per VS-11; includes delivery, installation (if BuildRight-managed), waste allowance; generates comprehensive project quotation
Responsible (R): Project Consultant
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2434_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2434_Flow10</bpmn:outgoing>
      </bpmn:userTask>
