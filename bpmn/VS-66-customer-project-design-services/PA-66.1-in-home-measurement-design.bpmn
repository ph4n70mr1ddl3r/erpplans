        <bpmn:outgoing>W2435_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2435_Task6" name="Customer approves final design and quotation; generates sales order; deposit…">
        <bpmn:documentation>Step 2: Customer approves final design and quotation; generates sales order; deposit collected (30–50% of project value); project enters execution phase
Responsible (R): Project Consultant / Cashier
Accountable (A): Customer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2435_Flow11</bpmn:incoming>
      </bpmn:userTask>
