    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2432" name="W2432. Kitchen &amp; Bathroom Design Proposal" isExecutable="false">
      <bpmn:documentation>Trigger: Measurement complete; design work begins
Frequency: ~150–300 design proposals/month (~25–35% of the ~600–900 measured projects per W2431 proceed to a full design; the rest take standard material estimates per W2433)
Volume: ~150–300/month; avg 4–8 hours per design
Owner: Design Consultant
Participants: Design Consultant, Project Consultant, Customer
Source: workflow W2432 — Kitchen &amp; Bathroom Design Proposal</bpmn:documentation>
      <bpmn:laneSet id="W2432_LaneSet2">
        <bpmn:lane id="W2432_Lane1" name="Design Consultant">
        <bpmn:flowNodeRef>W2432_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2432_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2432_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2432_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2432_Start3" name="Measurement complete; design work begins">
        <bpmn:outgoing>W2432_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2432_Task4" name="Design Consultant creates layout design using design software: 2D/3D floor plan…">
        <bpmn:documentation>Step 1: Design Consultant creates layout design using design software: 2D/3D floor plan with material specifications, fixture placement, color scheme; generates material list with quantities
Responsible (R): Design Consultant
Accountable (A): Project Consultant
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2432_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2432_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2432_Task5" name="Design package presented to customer: design boards, material samples, 3D…">
        <bpmn:documentation>Step 2: Design package presented to customer: design boards, material samples, 3D rendering, itemized material list, estimated project cost; Customer approves, requests modifications, or declines
Responsible (R): Design Consultant / Project Consultant
Accountable (A): Customer
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2432_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2432_End6" name="Complete">
        <bpmn:incoming>W2432_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2432_Annotation7">
        <bpmn:text>Controls: - CTL-427 (ensure controlled execution — In-Home Measurement &amp; Design Consultation (PA-66.1).) | - operational: Design Consultant sign-off on the workflow output
Owner: Design Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2432_Assoc8" sourceRef="W2432_Annotation7" targetRef="W2432_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2432_Flow9" sourceRef="W2432_Start3" targetRef="W2432_Task4" />
      <bpmn:sequenceFlow id="W2432_Flow10" sourceRef="W2432_Task4" targetRef="W2432_Task5" />
      <bpmn:sequenceFlow id="W2432_Flow11" sourceRef="W2432_Task5" targetRef="W2432_End6" />
    </bpmn:process>
