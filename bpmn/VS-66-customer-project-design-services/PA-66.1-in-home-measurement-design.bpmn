    <bpmn:process id="W_W2430" name="W2430. Customer Project Inquiry &amp; Qualification" isExecutable="false">
      <bpmn:documentation>Trigger: Customer inquires about project services in-store or online
Frequency: ~2,000–3,000 project inquiries/month
Volume: ~2K–3K/month; ~30% qualify for design consultation
Owner: Sales Associate / Project Consultant
Participants: Sales Associate, Project Consultant, Customer
Source: workflow W2430 — Customer Project Inquiry &amp; Qualification</bpmn:documentation>
      <bpmn:laneSet id="W2430_LaneSet3">
        <bpmn:lane id="W2430_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W2430_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2430_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2430_Lane2" name="Project Consultant">
        <bpmn:flowNodeRef>W2430_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2430_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2430_Start4" name="Customer inquires about project services in-store or online">
        <bpmn:outgoing>W2430_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2430_Task5" name="Sales Associate qualifies inquiry: project type (kitchen, bathroom, whole…">
        <bpmn:documentation>Step 1: Sales Associate qualifies inquiry: project type (kitchen, bathroom, whole house), budget range, timeline, property location; if project &gt;PHP 50K, refers to Project Consultant for design consultation
Responsible (R): Sales Associate
Accountable (A): Project Consultant
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2430_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2430_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2430_Task6" name="Project Consultant schedules in-home measurement visit: confirms date, prepares…">
        <bpmn:documentation>Step 2: Project Consultant schedules in-home measurement visit: confirms date, prepares measurement tools and product samples; provides customer with project intake form
Responsible (R): Project Consultant
Accountable (A): Customer
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2430_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2430_End7" name="Complete">
        <bpmn:incoming>W2430_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2430_Annotation8">
        <bpmn:text>Controls: - CTL-427 (ensure controlled execution — In-Home Measurement &amp; Design Consultation (PA-66.1).) | - CTL-427 (data-privacy — links to VS-91 / W53, RA 10173); Operational: Sales Associate / Project Consultant sign-off on the workflow output
Owner: Sales Associate / Project Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2430_Assoc9" sourceRef="W2430_Annotation8" targetRef="W2430_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2430_Flow10" sourceRef="W2430_Start4" targetRef="W2430_Task5" />
      <bpmn:sequenceFlow id="W2430_Flow11" sourceRef="W2430_Task5" targetRef="W2430_Task6" />
      <bpmn:sequenceFlow id="W2430_Flow12" sourceRef="W2430_Task6" targetRef="W2430_End7" />
    </bpmn:process>
