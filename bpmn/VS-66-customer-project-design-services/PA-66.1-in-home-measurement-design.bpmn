    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2433" name="W2433. Material Estimation &amp; Specification" isExecutable="false">
      <bpmn:documentation>Trigger: Design approved; detailed material take-off
Frequency: ~400–600 material estimates/month
Volume: ~400–600/month
Owner: Project Consultant
Participants: Project Consultant, Category Mgr, Merch Planner
Source: workflow W2433 — Material Estimation &amp; Specification</bpmn:documentation>
      <bpmn:laneSet id="W2433_LaneSet3">
        <bpmn:lane id="W2433_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2433_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2433_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2433_Lane2" name="System">
        <bpmn:flowNodeRef>W2433_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2433_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2433_Start4" name="Design approved; detailed material take-off">
        <bpmn:outgoing>W2433_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2433_Task5" name="Project Consultant performs detailed material take-off from approved design…">
        <bpmn:documentation>Step 1: Project Consultant performs detailed material take-off from approved design: tile sqm, paint liters, lumber board feet, pipe meters, wire meters, fixture counts, accessory quantities
Responsible (R): Project Consultant
Accountable (A): Design Consultant
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2433_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2433_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2433_Task6" name="System validates quantities against standard waste factors; checks inventory…">
        <bpmn:documentation>Step 2: System validates quantities against standard waste factors; checks inventory availability at nearest store/DC; identifies lead-time items (special order, import); generates material specification sheet
Responsible (R): System / Project Consultant
Accountable (A): Category Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2433_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2433_End7" name="Complete">
        <bpmn:incoming>W2433_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2433_Annotation8">
        <bpmn:text>Controls: - CTL-427 (ensure controlled execution — In-Home Measurement &amp; Design Consultation (PA-66.1).) | - operational: Project Consultant sign-off on the workflow output
Owner: Project Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2433_Assoc9" sourceRef="W2433_Annotation8" targetRef="W2433_Start4" associationDirection="None" />
