      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2431" name="W2431. In-Home Measurement Visit" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled measurement appointment
Frequency: ~600–900 visits/month
Volume: ~600–900/month; avg 2–3 hours per visit
Owner: Project Consultant
Participants: Project Consultant, Customer
Source: workflow W2431 — In-Home Measurement Visit</bpmn:documentation>
      <bpmn:laneSet id="W2431_LaneSet2">
        <bpmn:lane id="W2431_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2431_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2431_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2431_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2431_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2431_Start3" name="Scheduled measurement appointment">
        <bpmn:outgoing>W2431_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2431_Task4" name="Project Consultant visits customer&#x27;s home: measures rooms, documents existing…">
        <bpmn:documentation>Step 1: Project Consultant visits customer&#x27;s home: measures rooms, documents existing layout, photographs space, discusses customer&#x27;s vision and requirements, presents material samples
Responsible (R): Project Consultant
Accountable (A): Customer
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2431_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2431_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2431_Task5" name="Consultant creates rough sketch with dimensions; identifies potential…">
        <bpmn:documentation>Step 2: Consultant creates rough sketch with dimensions; identifies potential challenges (plumbing relocation, structural issues); discusses budget alignment; promises design proposal within 5 business days
Responsible (R): Project Consultant
Accountable (A): Customer
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2431_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2431_End6" name="Complete">
        <bpmn:incoming>W2431_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2431_Annotation7">
        <bpmn:text>Controls: - CTL-427 (ensure controlled execution — In-Home Measurement &amp; Design Consultation (PA-66.1).) | - operational: Project Consultant sign-off on the workflow output
Owner: Project Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2431_Assoc8" sourceRef="W2431_Annotation7" targetRef="W2431_Start3" associationDirection="None" />
