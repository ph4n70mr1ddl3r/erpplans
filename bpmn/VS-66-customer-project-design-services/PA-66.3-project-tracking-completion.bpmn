    <bpmn:process id="W_W2448" name="W2448. Project Quality Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Key milestones during installation
Frequency: Per project; 2–3 inspections per project
Volume: ~600–1,350 inspections/month
Owner: Project Consultant
Participants: Project Consultant, Contractor, Customer
Source: workflow W2448 — Project Quality Inspection</bpmn:documentation>
