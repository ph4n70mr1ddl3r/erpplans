      <bpmn:documentation>Trigger: Installation complete; final walkthrough
Frequency: ~300–450 completions/month
Volume: ~300–450/month
Owner: Project Consultant
Participants: Project Consultant, Contractor, Customer
Source: workflow W2449 — Project Completion &amp; Punch List</bpmn:documentation>
      <bpmn:laneSet id="W2449_LaneSet3">
        <bpmn:lane id="W2449_Lane1" name="Project Consultant">
        <bpmn:flowNodeRef>W2449_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2449_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2449_Lane2" name="Contractor">
        <bpmn:flowNodeRef>W2449_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2449_End7</bpmn:flowNodeRef>
