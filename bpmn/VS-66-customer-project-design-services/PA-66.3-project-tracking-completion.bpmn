    <bpmn:process id="W_W2451" name="W2451. Project Revenue &amp; Margin Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial analysis
Frequency: Monthly; ~300–450 completed projects
Volume: ~300–450 projects/month
Owner: FP&amp;A Analyst
Participants: FP&amp;A Analyst, Project Consultants, Finance Dir
Source: workflow W2451 — Project Revenue &amp; Margin Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2451_LaneSet2">
        <bpmn:lane id="W2451_Lane1" name="FP&amp;A Analyst">
