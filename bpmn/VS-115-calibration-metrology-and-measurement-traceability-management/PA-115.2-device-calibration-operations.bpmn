<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-115.2-device-calibration-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3625" name="W3625. POS Scale &amp; Weight-Based Item Calibration" isExecutable="false">
      <bpmn:documentation>Trigger: POS scale calibration cycle (W3619); new terminal/scale (links to VS-08); OOT trigger (W3634)
Frequency: Statutory cycle (typically annual DTI verification) + on install/OOT
Volume: 600 POS terminals with integrated/peripheral scales across 200 stores
Owner: Metrology Manager / Store Operations
Participants: Metrology Manager, Store Operations (links to VS-07), POS/IT (links to VS-08/VS-27), Calibration Technicians (W3622), Quality (links to VS-31), Compliance (links to VS-22)
Source: workflow W3625 — POS Scale &amp; Weight-Based Item Calibration</bpmn:documentation>
      <bpmn:laneSet id="W3625_LaneSet2">
        <bpmn:lane id="W3625_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3625_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3625_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3625_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3625_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3625_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3625_Start3" name="POS scale calibration cycle (W3619); new terminal/scale (links to VS-08); OOT trigger…">
        <bpmn:outgoing>W3625_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3625_Task4" name="Metrology Manager/Calibration Technicians calibrate each POS scale (integrated…">
        <bpmn:documentation>Step 1: Metrology Manager/Calibration Technicians calibrate each POS scale (integrated or peripheral) used for weight-based items: as-found verification at multiple test points across the range using certified test weights (traceability W3618), linearity/accuracy/eccentricity checks, adjustment as needed, as-left verification, and pass/fail/OOT determination (W3634)
Responsible (R): Metrology Manager / Calibration Technicians
Accountable (A): Quality Manager
Duration: Per scale</bpmn:documentation>
        <bpmn:incoming>W3625_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3625_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3625_Task5" name="Metrology Manager/Compliance secure DTI-BPS verification/seal for…">
        <bpmn:documentation>Step 2: Metrology Manager/Compliance secure DTI-BPS verification/seal for legal-for-trade POS scales: statutory verification by DTI or authorized entity, the verification seal/sticker (links to VS-22/W3633), and the legal-for-trade certificate; manage the seal integrity (tamper-evident) and prohibit unseal by non-authorized staff
Responsible (R): Metrology Manager / Compliance
Accountable (A): Quality Manager / VP Legal
Duration: Per statutory cycle</bpmn:documentation>
        <bpmn:incoming>W3625_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3625_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3625_Task6" name="Metrology Manager/Store Ops manage the POS-scale calibration cycle…">
        <bpmn:documentation>Step 3: Metrology Manager/Store Ops manage the POS-scale calibration cycle, return-to-service or quarantine if OOT (links to W3634/W3636), capture the record (W3624), and report POS-scale accuracy and DTI-compliance to governance (W3640); coordinate emergency swap for failed scales (links to VS-08/VS-27)
Responsible (R): Metrology Manager / Store Ops / POS-IT
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3625_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3625_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3625_End7" name="Complete">
        <bpmn:incoming>W3625_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3625_Annotation8">
        <bpmn:text>Controls: - CTL-575 (ensure controlled execution — Device Calibration Operations (PA-115.2).) | - operational: statutory verification and OOT response; operational: tamper-evident seals and access control
Owner: Metrology Manager / Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3625_Assoc9" sourceRef="W3625_Annotation8" targetRef="W3625_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3625_Flow10" sourceRef="W3625_Start3" targetRef="W3625_Task4" />
      <bpmn:sequenceFlow id="W3625_Flow11" sourceRef="W3625_Task4" targetRef="W3625_Task5" />
      <bpmn:sequenceFlow id="W3625_Flow12" sourceRef="W3625_Task5" targetRef="W3625_Task6" />
      <bpmn:sequenceFlow id="W3625_Flow13" sourceRef="W3625_Task6" targetRef="W3625_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3625_diag">
      <bpmndi:BPMNPlane id="W3625_plane" bpmnElement="W_W3625">
        <bpmndi:BPMNShape id="W3625_Lane1_di" bpmnElement="W3625_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
