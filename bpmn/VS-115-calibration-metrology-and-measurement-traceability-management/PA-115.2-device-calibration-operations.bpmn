      <bpmndi:BPMNPlane id="W3626_plane" bpmnElement="W_W3626">
        <bpmndi:BPMNShape id="W3626_Lane1_di" bpmnElement="W3626_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
