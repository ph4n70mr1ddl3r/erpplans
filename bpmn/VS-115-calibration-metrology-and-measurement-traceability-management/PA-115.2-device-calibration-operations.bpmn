      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3627" name="W3627. Cutting Equipment Measurement Calibration" isExecutable="false">
      <bpmn:documentation>Trigger: Cutting-equipment calibration cycle (W3619); new equipment; OOT/quality issue
Frequency: Usage/time-based
Volume: Store cutting equipment (lumber, pipe, wire, sheet cutting) across 200 stores
Owner: Metrology Manager / In-Store Services
Participants: Metrology Manager, In-Store Services (links to VS-09.1), Store Operations (links to VS-07), Facilities (links to VS-07.2), Calibration Technicians (W3622), Quality (links to VS-31)
Source: workflow W3627 — Cutting Equipment Measurement Calibration</bpmn:documentation>
      <bpmn:laneSet id="W3627_LaneSet2">
        <bpmn:lane id="W3627_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3627_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3627_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3627_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3627_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3627_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3627_Start3" name="Cutting-equipment calibration cycle (W3619); new equipment; OOT/quality issue">
        <bpmn:outgoing>W3627_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3627_Task4" name="Metrology Manager/Calibration Technicians calibrate cutting equipment…">
        <bpmn:documentation>Step 1: Metrology Manager/Calibration Technicians calibrate cutting equipment measurement (the length/angle measurement that determines cut length and customer charge): measuring scale/tape/stop on lumber cutters, pipe/wire length meters, sheet-cutting stops; verify against a traceable length standard (W3618), adjust, as-left verify, OOT determination (W3634)
Responsible (R): Metrology Manager / Calibration Technicians
Accountable (A): Quality Manager
Duration: Per equipment</bpmn:documentation>
        <bpmn:incoming>W3627_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3627_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3627_Task5" name="Metrology Manager/Services manage the cut-length measurement integrity that…">
        <bpmn:documentation>Step 2: Metrology Manager/Services manage the cut-length measurement integrity that drives yield and charge: ensure the displayed/measured cut length matches the actual delivered length (over-cut wastes material, under-cut under-charges and triggers customer dispute); manage blade/kerf compensation in the measurement
Responsible (R): Metrology Manager / Services
Accountable (A): Quality Manager / COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3627_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3627_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3627_Task6" name="Metrology Manager capture records (W3624), respond to OOT and customer…">
        <bpmn:documentation>Step 3: Metrology Manager capture records (W3624), respond to OOT and customer cut-length disputes (links to W3639/VS-13), and report cutting-measurement accuracy and yield impact to governance (W3640); coordinate with facility maintenance (links to VS-07.2) for the mechanical function
Responsible (R): Metrology Manager / Services / Facilities
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3627_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3627_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3627_End7" name="Complete">
        <bpmn:incoming>W3627_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3627_Annotation8">
        <bpmn:text>Controls: - CTL-575 (ensure controlled execution — Device Calibration Operations (PA-115.2).) | - operational: calibration and kerf compensation; operational: accuracy and dispute handling (W3639)
Owner: Metrology Manager / In-Store Services</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3627_Assoc9" sourceRef="W3627_Annotation8" targetRef="W3627_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3627_Flow10" sourceRef="W3627_Start3" targetRef="W3627_Task4" />
      <bpmn:sequenceFlow id="W3627_Flow11" sourceRef="W3627_Task4" targetRef="W3627_Task5" />
      <bpmn:sequenceFlow id="W3627_Flow12" sourceRef="W3627_Task5" targetRef="W3627_Task6" />
      <bpmn:sequenceFlow id="W3627_Flow13" sourceRef="W3627_Task6" targetRef="W3627_End7" />
    </bpmn:process>
