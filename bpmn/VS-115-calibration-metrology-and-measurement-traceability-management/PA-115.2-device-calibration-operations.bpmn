    <bpmn:process id="W_W3626" name="W3626. Catch-Weight &amp; Bulk Material Scale Calibration" isExecutable="false">
      <bpmn:documentation>Trigger: Bulk-scale calibration cycle (W3619); new scale; OOT trigger (W3634)
Frequency: Statutory + usage-based
Volume: Store and DC bulk scales (nails/fasteners bulk, lumber, bulk material)
Owner: Metrology Manager / DC &amp; Store Operations
Participants: Metrology Manager, DC Operations (links to VS-04), Store Operations (links to VS-07), Calibration Technicians (W3622), Quality (links to VS-31), Compliance (links to VS-22)
Source: workflow W3626 — Catch-Weight &amp; Bulk Material Scale Calibration</bpmn:documentation>
      <bpmn:laneSet id="W3626_LaneSet2">
        <bpmn:lane id="W3626_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3626_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3626_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3626_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3626_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3626_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3626_Start3" name="Bulk-scale calibration cycle (W3619); new scale; OOT trigger (W3634)">
        <bpmn:outgoing>W3626_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3626_Task4" name="Metrology Manager/Calibration Technicians calibrate catch-weight and…">
        <bpmn:documentation>Step 1: Metrology Manager/Calibration Technicians calibrate catch-weight and bulk-material scales: bench/platform/hanging scales used for nails-by-weight, bulk fasteners, and bulk material; multi-point verification, linearity/eccentricity, adjustment, as-left verification, OOT determination (W3634); align tolerance to the value-at-risk (small-weight accuracy for fasteners matters)
Responsible (R): Metrology Manager / Calibration Technicians
Accountable (A): Quality Manager
Duration: Per scale</bpmn:documentation>
        <bpmn:incoming>W3626_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3626_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3626_Task5" name="Metrology Manager/Compliance secure DTI verification/seal for legal-for-trade…">
        <bpmn:documentation>Step 2: Metrology Manager/Compliance secure DTI verification/seal for legal-for-trade catch-weight scales (W3633), manage the statutory cycle, and ensure legal-for-trade use only for commerce (process-control scales clearly labelled as non-trade)
Responsible (R): Metrology Manager / Compliance
Accountable (A): Quality Manager / VP Legal
Duration: Per statutory cycle</bpmn:documentation>
        <bpmn:incoming>W3626_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3626_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3626_Task6" name="Metrology Manager/Operations manage the bulk-scale calibration cycle and…">
        <bpmn:documentation>Step 3: Metrology Manager/Operations manage the bulk-scale calibration cycle and records (W3624), respond to OOT (W3634), and report accuracy/compliance to governance (W3640); coordinate with inventory accuracy (links to VS-05.1) where scale error affects stock records
Responsible (R): Metrology Manager / DC Ops / Store Ops
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3626_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3626_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3626_End7" name="Complete">
        <bpmn:incoming>W3626_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3626_Annotation8">
        <bpmn:text>Controls: - CTL-575 (ensure controlled execution — Device Calibration Operations (PA-115.2).) | - operational: tight tolerance and frequent verification; operational: clear labeling
Owner: Metrology Manager / DC &amp; Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3626_Assoc9" sourceRef="W3626_Annotation8" targetRef="W3626_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3626_Flow10" sourceRef="W3626_Start3" targetRef="W3626_Task4" />
      <bpmn:sequenceFlow id="W3626_Flow11" sourceRef="W3626_Task4" targetRef="W3626_Task5" />
      <bpmn:sequenceFlow id="W3626_Flow12" sourceRef="W3626_Task5" targetRef="W3626_Task6" />
      <bpmn:sequenceFlow id="W3626_Flow13" sourceRef="W3626_Task6" targetRef="W3626_End7" />
    </bpmn:process>
