        <bpmndi:BPMNShape id="W3635_Task5_di" bpmnElement="W3635_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3635_Task6_di" bpmnElement="W3635_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3635_Start3_di" bpmnElement="W3635_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3635_End7_di" bpmnElement="W3635_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3635_Annotation8_di" bpmnElement="W3635_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3635_Flow10_di" bpmnElement="W3635_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3635_Flow11_di" bpmnElement="W3635_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3635_Flow12_di" bpmnElement="W3635_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3635_Flow13_di" bpmnElement="W3635_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3635_Assoc9_di" bpmnElement="W3635_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3636" name="W3636. Device Lifecycle, Repair &amp; Retirement Management" isExecutable="false">
      <bpmn:documentation>Trigger: Device end-of-life; failure/OOT (W3634); refresh cycle
Frequency: Per device + refresh cycle
Volume: Measurement-device estate
Owner: Metrology Manager / Facilities-IT
Participants: Metrology Manager, Facilities (links to VS-20.3/VS-07.2), IT/ITAM (links to VS-27/VS-99), Procurement (links to VS-34), Finance (links to VS-35), Store/DC Operations, Vendor
Source: workflow W3636 — Device Lifecycle, Repair &amp; Retirement Management</bpmn:documentation>
      <bpmn:laneSet id="W3636_LaneSet2">
        <bpmn:lane id="W3636_Lane1" name="Metrology Manager">
        <bpmn:flowNodeRef>W3636_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3636_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3636_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3636_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3636_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3636_Start3" name="Device end-of-life; failure/OOT (W3634); refresh cycle">
        <bpmn:outgoing>W3636_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3636_Task4" name="Metrology Manager/Facilities manage device lifecycle: specification/procurement…">
        <bpmn:documentation>Step 1: Metrology Manager/Facilities manage device lifecycle: specification/procurement of new devices (links to VS-34) with calibration/metrology requirements specified, incoming acceptance calibration, deployment with initial verification (W3633), and the in-service maintenance (links to VS-07.2/VS-20.3); maintain the spare-pool for swap
Responsible (R): Metrology Manager / Facilities / Procurement
Accountable (A): Quality Manager / COO
Duration: Per device</bpmn:documentation>
        <bpmn:incoming>W3636_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3636_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3636_Task5" name="Metrology Manager/Vendor manage device repair: diagnose failure, in-house vs…">
        <bpmn:documentation>Step 2: Metrology Manager/Vendor manage device repair: diagnose failure, in-house vs. vendor repair, post-repair calibration and re-verification (W3633) before return to service, and the repair cost/benefit vs. replace decision; track repair history per device
Responsible (R): Metrology Manager / Vendor / Facilities
Accountable (A): Quality Manager
Duration: Per repair</bpmn:documentation>
        <bpmn:incoming>W3636_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3636_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3636_Task6" name="Metrology Manager/Finance/Facilities manage device retirement: end-of-life…">
        <bpmn:documentation>Step 3: Metrology Manager/Finance/Facilities manage device retirement: end-of-life assessment, disposal (electronic-waste for digital devices links to VS-73/VS-99.1, secure data wipe for connected devices), asset retirement (links to VS-35), and removal from the register (W3620); refresh on the technology cycle
Responsible (R): Metrology Manager / Facilities / Finance
Accountable (A): Quality Manager
Duration: Per retirement</bpmn:documentation>
        <bpmn:incoming>W3636_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3636_End7" name="Complete">
        <bpmn:incoming>W3636_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3636_Annotation8">
        <bpmn:text>Controls: - CTL-576 (ensure controlled execution — Weights &amp; Measures Compliance, MRM &amp; Measurement Analytics (PA-115.3).) | - operational: spare pool; operational: compliant disposal
Owner: Metrology Manager / Facilities-IT</bpmn:text>
      </bpmn:textAnnotation>
