        <bpmn:flowNodeRef>W3637_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3637_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3637_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3637_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3637_Start3" name="Annual budget cycle (links to VS-33.1); quarterly analytics; outsourcing review">
        <bpmn:outgoing>W3637_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3637_Task4" name="Metrology Manager/Finance capture the calibration program cost: in-house labor…">
        <bpmn:documentation>Step 1: Metrology Manager/Finance capture the calibration program cost: in-house labor and standards, external lab fees (W3621), DTI verification fees (W3633), spare-pool, device depreciation, and OOT-impact cost (W3634/W3635); allocate to stores/DC/category
Responsible (R): Metrology Manager / Finance / BI
Accountable (A): Quality Manager / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3637_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3637_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3637_Task5" name="Metrology Manager/Procurement analyze the in-house vs. external sourcing mix…">
        <bpmn:documentation>Step 2: Metrology Manager/Procurement analyze the in-house vs. external sourcing mix: cost, turnaround, quality, and coverage by device class; identify consolidation, volume-discount, and self-service opportunities; manage the make-vs-buy decision per device class
Responsible (R): Metrology Manager / Procurement / Finance
Accountable (A): Quality Manager / VP Supply Chain
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3637_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3637_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3637_Task6" name="Metrology Manager/Finance publish the calibration cost and service-level…">
        <bpmn:documentation>Step 3: Metrology Manager/Finance publish the calibration cost and service-level analytics to executives (links to VS-33.2) and governance (W3640), track cost-per-calibration and currency SLA over time, and feed optimization to the program strategy (W3617) and sourcing (W3621)
Responsible (R): Metrology Manager / Finance
Accountable (A): Quality Manager / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3637_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3637_End7" name="Complete">
        <bpmn:incoming>W3637_Flow13</bpmn:incoming>
      </bpmn:endEvent>
