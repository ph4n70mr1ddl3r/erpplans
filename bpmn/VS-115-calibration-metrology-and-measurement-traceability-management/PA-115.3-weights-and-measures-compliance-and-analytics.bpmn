    <bpmn:process id="W_W3639" name="W3639. Customer Measurement Dispute &amp; Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer measurement dispute (catch-weight charge, cut-length, paint color, bulk quantity)
Frequency: Per dispute
Volume: Customer measurement disputes
Owner: Metrology Manager / Customer Service
Participants: Metrology Manager, Customer Service (links to VS-13), Store/DC Operations, Quality (links to VS-31), Finance (links to VS-16/VS-17), Compliance (links to VS-22), Legal (links to VS-100)
Source: workflow W3639 — Customer Measurement Dispute &amp; Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3639_LaneSet3">
        <bpmn:lane id="W3639_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W3639_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3639_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3639_Lane2" name="Metrology Manager">
        <bpmn:flowNodeRef>W3639_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3639_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3639_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3639_Start4" name="Customer measurement dispute (catch-weight charge, cut-length, paint color, bulk quantity)">
        <bpmn:outgoing>W3639_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3639_Task5" name="Customer Service/Metrology Manager receive and log the measurement dispute…">
        <bpmn:documentation>Step 1: Customer Service/Metrology Manager receive and log the measurement dispute: transaction detail (catch-weight charge, cut length, paint color, bulk quantity), the device involved, the customer&#x27;s claim, and evidence (receipt, sample, photo); acknowledge within SLA (links to VS-13.1)
Responsible (R): Customer Service / Metrology Manager
Accountable (A): Metrology Manager
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3639_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3639_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3639_Task6" name="Metrology Manager investigate the dispute: verify the device calibration status…">
        <bpmn:documentation>Step 2: Metrology Manager investigate the dispute: verify the device calibration status (W3620/W3624), re-measure/re-weigh the item if available, assess whether the device was OOT (W3634), and determine validity; coordinate with the store/quality and the customer
Responsible (R): Metrology Manager / Quality / Store Ops
Accountable (A): Quality Manager
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3639_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3639_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3639_Task7" name="Metrology Manager/Customer Service/Finance resolve the dispute…">
        <bpmn:documentation>Step 3: Metrology Manager/Customer Service/Finance resolve the dispute: refund/adjustment for valid under/over-charge (links to VS-16/VS-17/W101), good-will gesture, and corrective action if device OOT (W3634); document, capture in dispute analytics (W3640), and feed prevention; manage escalation to DTI/consumer complaint if unresolved (links to VS-22)
Responsible (R): Metrology Manager / Customer Service / Finance / Legal
Accountable (A): Quality Manager / VP Customer
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3639_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3639_End8" name="Complete">
        <bpmn:incoming>W3639_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3639_Annotation9">
        <bpmn:text>Controls: - CTL-576 (ensure controlled execution — Weights &amp; Measures Compliance, MRM &amp; Measurement Analytics (PA-115.3).) | - operational: prompt investigation and resolution; operational: dispute analytics feeding OOT/correction
Owner: Metrology Manager / Customer Service</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3639_Assoc10" sourceRef="W3639_Annotation9" targetRef="W3639_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3639_Flow11" sourceRef="W3639_Start4" targetRef="W3639_Task5" />
      <bpmn:sequenceFlow id="W3639_Flow12" sourceRef="W3639_Task5" targetRef="W3639_Task6" />
      <bpmn:sequenceFlow id="W3639_Flow13" sourceRef="W3639_Task6" targetRef="W3639_Task7" />
      <bpmn:sequenceFlow id="W3639_Flow14" sourceRef="W3639_Task7" targetRef="W3639_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3639_diag">
      <bpmndi:BPMNPlane id="W3639_plane" bpmnElement="W_W3639">
        <bpmndi:BPMNShape id="W3639_Lane1_di" bpmnElement="W3639_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3639_Lane2_di" bpmnElement="W3639_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
