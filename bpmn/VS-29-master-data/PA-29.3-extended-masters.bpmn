      <bpmn:sequenceFlow id="W298_Flow18" sourceRef="W298_Task8" targetRef="W298_Task9" />
      <bpmn:sequenceFlow id="W298_Flow19" sourceRef="W298_Task9" targetRef="W298_Task10" />
      <bpmn:sequenceFlow id="W298_Flow20" sourceRef="W298_Task10" targetRef="W298_Task11" />
