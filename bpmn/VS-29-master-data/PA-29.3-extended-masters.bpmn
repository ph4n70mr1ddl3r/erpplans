      <bpmn:sequenceFlow id="W299_Flow22" sourceRef="W299_Task11" targetRef="W299_Task12" />
      <bpmn:sequenceFlow id="W299_Flow23" sourceRef="W299_Task12" targetRef="W299_Task13" />
      <bpmn:sequenceFlow id="W299_Flow24" sourceRef="W299_Task13" targetRef="W299_Task14" />
      <bpmn:sequenceFlow id="W299_Flow25" sourceRef="W299_Task14" targetRef="W299_End15" />
    </bpmn:process>
