    <bpmn:process id="W_W5354" name="W5354. Used Motor Oil, Lubricant &amp; Filter Collection &amp; Bulk Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer (DIY/auto/contractor) returns used oil/filters
Frequency: ~200–600 oil take-backs/store/yr
Volume: ~1–10 liters per visit; ~150k–400k liters/yr group-wide
Owner: Take-Back Counter Associate
Participants: HSE Officer, Oil Re-refinery Partner, Store Receiving
Source: workflow W5354 — Used Motor Oil, Lubricant &amp; Filter Collection &amp; Bulk Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W5354_LaneSet3">
