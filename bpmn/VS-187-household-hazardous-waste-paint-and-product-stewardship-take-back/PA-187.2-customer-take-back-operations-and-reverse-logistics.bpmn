    <bpmn:process id="W_W5353" name="W5353. Customer Paint Take-Back, Latex/Oil Sorting &amp; Usable Paint Reblending (PaintCare)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns leftover paint at the take-back counter
Frequency: ~1,500–4,000 paint take-backs/store/yr (highest-volume stream)
Volume: ~1–5 containers per visit; ~300k–800k containers/yr group-wide
Owner: Take-Back Counter Associate
Participants: HSE Officer, Paint Dept Supervisor, Reblending Partner
Source: workflow W5353 — Customer Paint Take-Back, Latex/Oil Sorting &amp; Usable Paint Reblending (PaintCare)</bpmn:documentation>
      <bpmn:laneSet id="W5353_LaneSet3">
        <bpmn:lane id="W5353_Lane1" name="Take-Back Associate">
