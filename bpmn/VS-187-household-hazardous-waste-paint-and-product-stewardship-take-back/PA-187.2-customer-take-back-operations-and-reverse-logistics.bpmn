      <bpmn:startEvent id="W5354_Start4" name="Customer (DIY/auto/contractor) returns used oil/filters">
        <bpmn:outgoing>W5354_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5354_Task5" name="Verify the container is used oil/lube only (no coolant/solvent/fuel mixed —…">
        <bpmn:documentation>Step 1: Verify the container is used oil/lube only (no coolant/solvent/fuel mixed — refusal script if contaminated).
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W5354_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5354_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5354_Task6" name="Transfer to the bunded oil-rated drum in the containment area (W5349); log…">
        <bpmn:documentation>Step 2: Transfer to the bunded oil-rated drum in the containment area (W5349); log liters to the ledger.
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5354_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5354_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5354_Task7" name="Drain/collect used oil filters into a separate rated container; log count.">
