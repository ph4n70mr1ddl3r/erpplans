    <bpmn:process id="W_W5355" name="W5355. Lead-Acid &amp; Lithium Battery Collection, Safe Storage &amp; Fire-Separation Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns used batteries (auto, power-tool, appliance, electronics)
Frequency: ~300–800 battery take-backs/store/yr
Volume: ~1–5 units per visit; ~150k–400k batteries/yr group-wide
Owner: Take-Back Counter Associate
Participants: HSE Officer, Battery Recycler Partner, BFP Fire Safety
Source: workflow W5355 — Lead-Acid &amp; Lithium Battery Collection, Safe Storage &amp; Fire-Separation Compliance</bpmn:documentation>
      <bpmn:laneSet id="W5355_LaneSet3">
        <bpmn:lane id="W5355_Lane1" name="Take-Back Associate">
        <bpmn:flowNodeRef>W5355_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5355_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5355_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5355_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5355_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5355_Lane2" name="HSE Officer">
        <bpmn:flowNodeRef>W5355_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5355_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5355_Start4" name="Customer returns used batteries (auto, power-tool, appliance, electronics)">
        <bpmn:outgoing>W5355_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5355_Task5" name="Identify chemistry: lead-acid (auto/UPS) vs. lithium-ion (power…">
        <bpmn:documentation>Step 1: Identify chemistry: lead-acid (auto/UPS) vs. lithium-ion (power tools/electronics) — distinct fire/storage profiles.
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5355_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5355_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5355_Task6" name="Inspect for damage/swelling/leak; tape terminals of lithium cells to prevent…">
        <bpmn:documentation>Step 2: Inspect for damage/swelling/leak; tape terminals of lithium cells to prevent short-circuit.
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W5355_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5355_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5355_Task7" name="Stage lead-acid in acid-rated containment; lithium in fire-separated…">
        <bpmn:documentation>Step 3: Stage lead-acid in acid-rated containment; lithium in fire-separated, non-conductive bins with sand/quench provision (BFP Fire Code).
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W5355_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5355_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5355_Task8" name="Log count/weight to the ledger per chemistry; issue incentive (W5350).">
        <bpmn:documentation>Step 4: Log count/weight to the ledger per chemistry; issue incentive (W5350).
Responsible (R): Take-Back Associate
Accountable (A): Take-Back Counter Associate
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5355_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5355_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5355_Task9" name="Monitor for swelling/thermal event; isolate any suspect cell in a quench…">
        <bpmn:documentation>Step 5: Monitor for swelling/thermal event; isolate any suspect cell in a quench container.
Responsible (R): HSE Officer
Accountable (A): Take-Back Counter Associate
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5355_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5355_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5355_End10" name="Complete">
        <bpmn:incoming>W5355_Flow18</bpmn:incoming>
      </bpmn:endEvent>
