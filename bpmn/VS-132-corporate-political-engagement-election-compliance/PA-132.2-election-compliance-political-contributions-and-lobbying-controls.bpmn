        <bpmn:outgoing>W4037_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4037_Task5" name="Legal/Compliance review and approve any hospitality/gift/meals involving public…">
        <bpmn:documentation>Step 2: Legal/Compliance review and approve any hospitality/gift/meals involving public officials (generally prohibited, with narrow exceptions), manage procurement interactions to avoid bid-process impropriety (links to VS-46/VS-03), and ensure no facilitation payments
Responsible (R): Legal / Compliance / Govt Affairs
Accountable (A): VP Legal
Duration: Per interaction</bpmn:documentation>
        <bpmn:incoming>W4037_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4037_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4037_Task6" name="Legal/Compliance log interactions, escalate concerns via speak-up (links to…">
