    <bpmn:process id="W_W4042" name="W4042. Public-Affairs Position Development, Submission &amp; Advocacy Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Policy consultation; legislative/regulatory proposal; advocacy opportunity
Frequency: On issue + maintained positions
Volume: Material policy issues
Owner: Government Affairs Manager / VP Legal
Participants: Govt Affairs (links to VS-104), Legal, Strategy (links to VS-33), affected business units, Compliance (links to VS-119), Corporate Communications (links to VS-14.3)
Source: workflow W4042 — Public-Affairs Position Development, Submission &amp; Advocacy Execution</bpmn:documentation>
      <bpmn:laneSet id="W4042_LaneSet2">
        <bpmn:lane id="W4042_Lane1" name="Govt Affairs">
        <bpmn:flowNodeRef>W4042_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4042_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4042_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4042_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4042_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4042_Start3" name="Policy consultation; legislative/regulatory proposal; advocacy opportunity">
        <bpmn:outgoing>W4042_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4042_Task4" name="Govt Affairs/Legal develop BuildRight&#x27;s position on material policy issues…">
        <bpmn:documentation>Step 1: Govt Affairs/Legal develop BuildRight&#x27;s position on material policy issues (retail tax/e-invoicing, consumer, labor, customs/tariff, energy, data privacy, property) with affected business input and Strategy alignment (links to VS-33), ensuring the position is lawful, evidence-based, and within competition guardrails (links to VS-129 W3965)
Responsible (R): Govt Affairs / Legal / affected BU
Accountable (A): Government Affairs Manager / VP Legal
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W4042_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4042_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4042_Task5" name="Govt Affairs submit positions (consultation responses, position papers…">
        <bpmn:documentation>Step 2: Govt Affairs submit positions (consultation responses, position papers, testimony) and execute advocacy per the lobbying/advocacy governance (links to W4028), the association protocol (links to VS-129 W3965), and anti-graft controls (links to W4037)
Responsible (R): Govt Affairs
Accountable (A): Government Affairs Manager
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W4042_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4042_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4042_Task6" name="Govt Affairs document submissions/advocacy (links to W4028/W4032), track…">
        <bpmn:documentation>Step 3: Govt Affairs document submissions/advocacy (links to W4028/W4032), track outcomes, and report to leadership/Board (links to VS-36)
Responsible (R): Govt Affairs
Accountable (A): Government Affairs Manager
Duration: Per issue + periodic</bpmn:documentation>
        <bpmn:incoming>W4042_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4042_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4042_End7" name="Complete">
        <bpmn:incoming>W4042_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4042_Annotation8">
        <bpmn:text>Controls: - CTL-628 (ensure controlled execution — Stakeholder &amp; Government Affairs Governance, Monitoring &amp; Analytics (PA-132.3).) | - operational: development process and Strategy alignment; operational: governance and controls
Owner: Government Affairs Manager / VP Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4042_Assoc9" sourceRef="W4042_Annotation8" targetRef="W4042_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4042_Flow10" sourceRef="W4042_Start3" targetRef="W4042_Task4" />
      <bpmn:sequenceFlow id="W4042_Flow11" sourceRef="W4042_Task4" targetRef="W4042_Task5" />
      <bpmn:sequenceFlow id="W4042_Flow12" sourceRef="W4042_Task5" targetRef="W4042_Task6" />
      <bpmn:sequenceFlow id="W4042_Flow13" sourceRef="W4042_Task6" targetRef="W4042_End7" />
    </bpmn:process>
