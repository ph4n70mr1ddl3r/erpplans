      <bpmn:sequenceFlow id="W4041_Flow12" sourceRef="W4041_Task5" targetRef="W4041_Task6" />
      <bpmn:sequenceFlow id="W4041_Flow13" sourceRef="W4041_Task6" targetRef="W4041_End7" />
    </bpmn:process>
