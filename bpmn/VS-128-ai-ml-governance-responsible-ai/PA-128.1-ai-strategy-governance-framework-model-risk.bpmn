        <bpmndi:BPMNShape id="W3930_Annotation8_di" bpmnElement="W3930_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3930_Flow10_di" bpmnElement="W3930_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3930_Flow11_di" bpmnElement="W3930_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3930_Flow12_di" bpmnElement="W3930_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3930_Flow13_di" bpmnElement="W3930_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3930_Assoc9_di" bpmnElement="W3930_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3931" name="W3931. AI Model Inventory, Registry &amp; Tiering" isExecutable="false">
      <bpmn:documentation>Trigger: New model; inventory cycle
Frequency: Continuous + periodic reconciliation
Volume: ~8–12 BuildRight-built production AI/ML models per the PA-30.2 canon (fraud, forecast, personalization, pricing, LP, chatbot, GenAI), plus vendor/embedded models outside this registry
Owner: AI Governance
Participants: AI Governance, Data Science (links to VS-30.2), business AI owners (VS-125/VS-126/VS-127/VS-14/VS-23), IT (links to VS-27), Privacy (links to VS-91), Risk (links to VS-21)
Source: workflow W3931 — AI Model Inventory, Registry &amp; Tiering</bpmn:documentation>
      <bpmn:laneSet id="W3931_LaneSet2">
        <bpmn:lane id="W3931_Lane1" name="AI Governance">
        <bpmn:flowNodeRef>W3931_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3931_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3931_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3931_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3931_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3931_Start3" name="New model; inventory cycle">
        <bpmn:outgoing>W3931_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3931_Task4" name="AI Governance maintain the enterprise model inventory/registry: model ID…">
        <bpmn:documentation>Step 1: AI Governance maintain the enterprise model inventory/registry: model ID, owner, purpose, data sources, tier, deployment, dependencies, version, status, last validation, and link to the use-case owner (e.g., fraud model → VS-125, forecast → VS-127, recommendation → VS-126)
Responsible (R): AI Governance / Data Science
Accountable (A): AI Governance Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3931_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3931_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3931_Task5" name="AI Governance/Risk tier each model by risk (high/medium/low) based on impact…">
        <bpmn:documentation>Step 2: AI Governance/Risk tier each model by risk (high/medium/low) based on impact (revenue, customer-harm potential, rights-affecting, safety, scale), data sensitivity (PII links to VS-91), and autonomy — driving the depth of controls (links to W3932)
Responsible (R): AI Governance / Risk
Accountable (A): AI Governance Lead
Duration: Per model</bpmn:documentation>
        <bpmn:incoming>W3931_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3931_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3931_Task6" name="AI Governance reconcile the registry to actual production models (discover…">
        <bpmn:documentation>Step 3: AI Governance reconcile the registry to actual production models (discover shadow models), retire decommissioned models (links to W3948), and report the inventory to the AI steering and audit (links to VS-21)
Responsible (R): AI Governance / IT / Risk
Accountable (A): AI Governance Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3931_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3931_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3931_End7" name="Complete">
        <bpmn:incoming>W3931_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3931_Annotation8">
        <bpmn:text>Controls: - CTL-147 (ensure AI model risk &amp; human-oversight control.) | - operational: discovery and registry control; operational: consistent tiering criteria
Owner: AI Governance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3931_Assoc9" sourceRef="W3931_Annotation8" targetRef="W3931_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3931_Flow10" sourceRef="W3931_Start3" targetRef="W3931_Task4" />
      <bpmn:sequenceFlow id="W3931_Flow11" sourceRef="W3931_Task4" targetRef="W3931_Task5" />
      <bpmn:sequenceFlow id="W3931_Flow12" sourceRef="W3931_Task5" targetRef="W3931_Task6" />
      <bpmn:sequenceFlow id="W3931_Flow13" sourceRef="W3931_Task6" targetRef="W3931_End7" />
    </bpmn:process>
