      <bpmndi:BPMNPlane id="W3931_plane" bpmnElement="W_W3931">
        <bpmndi:BPMNShape id="W3931_Lane1_di" bpmnElement="W3931_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
