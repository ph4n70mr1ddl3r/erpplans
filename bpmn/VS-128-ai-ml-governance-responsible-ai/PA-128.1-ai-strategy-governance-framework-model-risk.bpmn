        <bpmndi:BPMNShape id="W3931_Start3_di" bpmnElement="W3931_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3931_End7_di" bpmnElement="W3931_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3931_Annotation8_di" bpmnElement="W3931_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3931_Flow10_di" bpmnElement="W3931_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3931_Flow11_di" bpmnElement="W3931_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3931_Flow12_di" bpmnElement="W3931_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3931_Flow13_di" bpmnElement="W3931_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3931_Assoc9_di" bpmnElement="W3931_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3932" name="W3932. Model Risk Management &amp; Independent Validation" isExecutable="false">
      <bpmn:documentation>Trigger: New/deployed model (links to W3931); validation cycle
Frequency: Per model + periodic revalidation
Volume: Validation of all tier-1/2 models (~10–30)
Owner: Model Risk / AI Governance
Participants: Model Risk (independent — links to VS-21), AI Governance, Data Science (links to VS-30.2), business AI owners, Privacy (links to VS-91), Internal Audit (links to VS-21)
Source: workflow W3932 — Model Risk Management &amp; Independent Validation</bpmn:documentation>
      <bpmn:laneSet id="W3932_LaneSet3">
        <bpmn:lane id="W3932_Lane1" name="Model Risk">
        <bpmn:flowNodeRef>W3932_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3932_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3932_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3932_Lane2" name="AI Governance">
        <bpmn:flowNodeRef>W3932_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3932_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3932_Start4" name="New/deployed model (links to W3931); validation cycle">
        <bpmn:outgoing>W3932_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3932_Task5" name="Model Risk/AI-Governance run model-risk assessment per model: data…">
        <bpmn:documentation>Step 1: Model Risk/AI-Governance run model-risk assessment per model: data quality/lineage (links to VS-28.2), conceptual soundness, performance/accuracy, bias/fairness (links to W3937), explainability (links to W3938), privacy (links to W3939), and dependency/operational risk
Responsible (R): Model Risk / AI Governance
Accountable (A): Model Risk Lead
Duration: Per model</bpmn:documentation>
