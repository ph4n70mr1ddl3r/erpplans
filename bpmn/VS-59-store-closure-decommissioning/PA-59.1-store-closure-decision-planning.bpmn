      </bpmn:startEvent>
      <bpmn:userTask id="W2265_Task4" name="Develops plan: employee notification (DOLE 30-day notice), customer…">
        <bpmn:documentation>Step 1: Develops plan: employee notification (DOLE 30-day notice), customer communication (redirect to nearest store), vendor notification, media/PR, LGU notification; Legal reviews; HR prepares letters; Marketing prepares messaging
Responsible (R): VP Corp Comms / Legal / HR / Marketing
Accountable (A): CEO
Duration: 3–5 days + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2265_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2265_End5" name="Complete">
        <bpmn:incoming>W2265_Flow9</bpmn:incoming>
      </bpmn:endEvent>
