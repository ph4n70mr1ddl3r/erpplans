      </bpmn:startEvent>
      <bpmn:userTask id="W2264_Task4" name="CEO presents to Board with full business case, impact analysis, timeline; Board…">
        <bpmn:documentation>Step 1: CEO presents to Board with full business case, impact analysis, timeline; Board approves or requests analysis; approved closures assigned to Project Manager with 6-month timeline
Responsible (R): CEO
Accountable (A): Board
Duration: 2–3 hours + 1 day</bpmn:documentation>
        <bpmn:incoming>W2264_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2264_End5" name="Complete">
        <bpmn:incoming>W2264_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2264_Annotation6">
        <bpmn:text>Controls: - CTL-349: board governance — links to VS-36; operational: Board resolution documented
Owner: CEO</bpmn:text>
