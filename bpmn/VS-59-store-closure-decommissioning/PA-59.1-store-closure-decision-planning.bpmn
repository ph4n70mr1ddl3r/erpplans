    <bpmn:process id="W_W2264" name="W2264. Closure Decision &amp; Board Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Business case ready
Frequency: Ad-hoc; ~2–3/year
Volume: ~2–3 decisions/year
Owner: CEO
Participants: Board
Source: workflow W2264 — Closure Decision &amp; Board Approval</bpmn:documentation>
      <bpmn:laneSet id="W2264_LaneSet2">
        <bpmn:lane id="W2264_Lane1" name="CEO">
