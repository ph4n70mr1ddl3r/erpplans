    <bpmn:process id="W_W2262" name="W2262. Store Performance Trigger Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly store performance review
Frequency: Quarterly; 200 stores
Volume: ~2–3 flagged/quarter
Owner: VP Store Operations
Participants: VP Store Operations, CEO
Source: workflow W2262 — Store Performance Trigger Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2262_LaneSet2">
        <bpmn:lane id="W2262_Lane1" name="System">
        <bpmn:flowNodeRef>W2262_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2262_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2262_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2262_Start3" name="Quarterly store performance review">
        <bpmn:outgoing>W2262_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2262_Task4" name="System flags stores: sales/sqm &lt;60% of chain avg for 4 quarters, negative…">
        <bpmn:documentation>Step 1: System flags stores: sales/sqm &lt;60% of chain avg for 4 quarters, negative contribution margin 2+ quarters, lease renewal with unfavorable terms; VP presents to Executive Committee
Responsible (R): System / VP Store Operations
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2262_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2262_End5" name="Complete">
        <bpmn:incoming>W2262_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2262_Annotation6">
        <bpmn:text>Controls: - CTL-406 (ensure controlled execution — Store Closure Decision &amp; Planning (PA-59.1).) | - operational: fixed-asset verification — the store as a fixed asset; operational: CEO/ExComm review of flagged stores
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2262_Assoc7" sourceRef="W2262_Annotation6" targetRef="W2262_Start3" associationDirection="None" />
