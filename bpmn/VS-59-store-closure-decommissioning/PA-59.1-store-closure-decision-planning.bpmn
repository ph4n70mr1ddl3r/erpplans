    <bpmn:process id="W_W2263" name="W2263. Closure Business Case Development" isExecutable="false">
      <bpmn:documentation>Trigger: Executive Committee approves evaluation
Frequency: Ad-hoc; ~2–3/year
Volume: ~2–3 business cases/year
Owner: FP&amp;A Director
Participants: COO, Legal, HR, CFO
Source: workflow W2263 — Closure Business Case Development</bpmn:documentation>
      <bpmn:laneSet id="W2263_LaneSet2">
        <bpmn:lane id="W2263_Lane1" name="FP&amp;A Director">
        <bpmn:flowNodeRef>W2263_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2263_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2263_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2263_Start3" name="Executive Committee approves evaluation">
        <bpmn:outgoing>W2263_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2263_Task4" name="FP&amp;A develops: closure costs (lease penalty, severance, inventory write-down…">
        <bpmn:documentation>Step 1: FP&amp;A develops: closure costs (lease penalty, severance, inventory write-down, asset disposal) vs. savings (rent, staff, utilities); payback period, NPV; COO evaluates lease; Legal reviews; HR estimates severance
Responsible (R): FP&amp;A Director / COO / Legal / HR
Accountable (A): CFO
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2263_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2263_End5" name="Complete">
        <bpmn:incoming>W2263_Flow9</bpmn:incoming>
      </bpmn:endEvent>
