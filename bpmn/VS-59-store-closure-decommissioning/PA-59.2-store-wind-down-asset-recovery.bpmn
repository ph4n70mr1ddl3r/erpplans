      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2274" name="W2274. IT Systems Decommissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Month 5 of closure
Frequency: Per closure
Volume: 3 POS terminals + network
Owner: IT Operations Manager
Participants: IT Ops Manager, CIO
Source: workflow W2274 — IT Systems Decommissioning</bpmn:documentation>
      <bpmn:laneSet id="W2274_LaneSet2">
        <bpmn:lane id="W2274_Lane1" name="IT Ops Manager">
        <bpmn:flowNodeRef>W2274_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2274_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2274_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2274_Start3" name="Month 5 of closure">
        <bpmn:outgoing>W2274_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2274_Task4" name="Closes POS terminals, disconnects network/VPN, deactivates store in ERP…">
        <bpmn:documentation>Step 1: Closes POS terminals, disconnects network/VPN, deactivates store in ERP, archives data per retention, secure data destruction; removes from store locator
Responsible (R): IT Ops Manager
Accountable (A): CIO
Duration: 3–5 days + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2274_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2274_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2274_End5" name="Complete">
        <bpmn:incoming>W2274_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2274_Annotation6">
        <bpmn:text>Controls: - CTL-407: data-security on decommissioning — links to VS-27, VS-91; CTL-26 (IT-asset disposition — links to VS-99); operational: CIO sign-off
Owner: IT Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2274_Assoc7" sourceRef="W2274_Annotation6" targetRef="W2274_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2274_Flow8" sourceRef="W2274_Start3" targetRef="W2274_Task4" />
      <bpmn:sequenceFlow id="W2274_Flow9" sourceRef="W2274_Task4" targetRef="W2274_End5" />
    </bpmn:process>
