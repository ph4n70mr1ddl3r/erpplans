        <bpmndi:BPMNShape id="W2270_Start3_di" bpmnElement="W2270_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2270_End5_di" bpmnElement="W2270_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
