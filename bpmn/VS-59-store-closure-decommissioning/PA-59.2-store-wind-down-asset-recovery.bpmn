    <bpmn:process id="W_W2270" name="W2270. Inventory Liquidation Planning &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Month 2–4 of closure
Frequency: Per closure; 90-day window
Volume: ~35K SKUs; ~PHP 15–25M inventory
Owner: Merchandising Planner
Participants: Marketing, Store Manager, Category Manager
Source: workflow W2270 — Inventory Liquidation Planning &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W2270_LaneSet2">
        <bpmn:lane id="W2270_Lane1" name="Merch Planner">
        <bpmn:flowNodeRef>W2270_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2270_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2270_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2270_Start3" name="Month 2–4 of closure">
        <bpmn:outgoing>W2270_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2270_Task4" name="Designs strategy: transfer high-demand to nearby stores, progressive markdown…">
        <bpmn:documentation>Step 1: Designs strategy: transfer high-demand to nearby stores, progressive markdown (10→25→50→75%), bulk sale for residual; Marketing promotes; system tracks sell-through; remaining to DC or bulk
Responsible (R): Merch Planner / Marketing / Store Manager
Accountable (A): Category Manager
Duration: 1–2 weeks + 90 days</bpmn:documentation>
        <bpmn:incoming>W2270_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2270_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2270_End5" name="Complete">
        <bpmn:incoming>W2270_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2270_Annotation6">
        <bpmn:text>Controls: - CTL-176: asset-grade clearance disposition; CTL-21 (inventory-count integrity); operational: Category Manager sign-off
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2270_Assoc7" sourceRef="W2270_Annotation6" targetRef="W2270_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2270_Flow8" sourceRef="W2270_Start3" targetRef="W2270_Task4" />
      <bpmn:sequenceFlow id="W2270_Flow9" sourceRef="W2270_Task4" targetRef="W2270_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2270_diag">
