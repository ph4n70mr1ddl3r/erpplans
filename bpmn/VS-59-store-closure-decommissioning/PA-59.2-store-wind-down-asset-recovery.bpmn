        <bpmndi:BPMNShape id="W2271_Start3_di" bpmnElement="W2271_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2271_End5_di" bpmnElement="W2271_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2271_Annotation6_di" bpmnElement="W2271_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
