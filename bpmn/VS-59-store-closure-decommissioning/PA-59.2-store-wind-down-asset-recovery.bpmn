      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2273" name="W2273. Employee Redeployment &amp; Separation" isExecutable="false">
      <bpmn:documentation>Trigger: Month 1–5 of closure
Frequency: Per closure; ~29 employees
Volume: ~29 employees per store
Owner: CHRO
Participants: CHRO
Source: workflow W2273 — Employee Redeployment &amp; Separation</bpmn:documentation>
      <bpmn:laneSet id="W2273_LaneSet2">
        <bpmn:lane id="W2273_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W2273_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2273_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2273_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2273_Start3" name="Month 1–5 of closure">
        <bpmn:outgoing>W2273_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2273_Task4" name="Identifies redeployment: transfers to nearby stores (priority performers), DC…">
        <bpmn:documentation>Step 1: Identifies redeployment: transfers to nearby stores (priority performers), DC, HQ, new openings; for non-redeployed: 30-day notice, severance (0.5–1 month/year), clearance, final pay, DOLE reporting
Responsible (R): CHRO
Accountable (A): CHRO
Duration: 2–3 weeks + 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W2273_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2273_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2273_End5" name="Complete">
        <bpmn:incoming>W2273_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2273_Annotation6">
        <bpmn:text>Controls: - CTL-407: DOLE-compliant separation — links to VS-19 / W43, VS-84; CTL-172 (PPE/payroll-deduction on separation); operational: CHRO sign-off
Owner: CHRO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2273_Assoc7" sourceRef="W2273_Annotation6" targetRef="W2273_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2273_Flow8" sourceRef="W2273_Start3" targetRef="W2273_Task4" />
      <bpmn:sequenceFlow id="W2273_Flow9" sourceRef="W2273_Task4" targetRef="W2273_End5" />
    </bpmn:process>
