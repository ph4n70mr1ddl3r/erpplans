      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2272" name="W2272. Lease Termination &amp; Handover" isExecutable="false">
      <bpmn:documentation>Trigger: Month 5–6 of closure
Frequency: Per closure
Volume: 1 lease per store
Owner: COO / Legal
Participants: CEO
Source: workflow W2272 — Lease Termination &amp; Handover</bpmn:documentation>
      <bpmn:laneSet id="W2272_LaneSet2">
        <bpmn:lane id="W2272_Lane1" name="COO">
        <bpmn:flowNodeRef>W2272_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2272_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2272_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2272_Start3" name="Month 5–6 of closure">
        <bpmn:outgoing>W2272_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2272_Task4" name="Negotiates termination: executes clause, pays penalty, coordinates site…">
        <bpmn:documentation>Step 1: Negotiates termination: executes clause, pays penalty, coordinates site restoration, schedules handover inspection; Legal ensures documentation: inspection report, deposit return, mutual release
Responsible (R): COO / Legal
Accountable (A): CEO
Duration: 2–4 weeks + 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2272_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2272_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2272_End5" name="Complete">
        <bpmn:incoming>W2272_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2272_Annotation6">
        <bpmn:text>Controls: - CTL-221 (ensure controlled store-closure execution.) | - CTL-407: lease-termination accuracy — links to VS-42; operational: CEO sign-off on termination terms &gt;PHP 1M
Owner: COO / Legal</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2272_Assoc7" sourceRef="W2272_Annotation6" targetRef="W2272_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2272_Flow8" sourceRef="W2272_Start3" targetRef="W2272_Task4" />
      <bpmn:sequenceFlow id="W2272_Flow9" sourceRef="W2272_Task4" targetRef="W2272_End5" />
    </bpmn:process>
