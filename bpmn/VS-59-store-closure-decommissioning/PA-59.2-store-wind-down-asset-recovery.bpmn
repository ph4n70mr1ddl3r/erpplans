        <bpmndi:BPMNEdge id="W2274_Flow9_di" bpmnElement="W2274_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2274_Assoc7_di" bpmnElement="W2274_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2275" name="W2275. Final Financial Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Closure complete
Frequency: Per closure
Volume: Full store financial close
Owner: Finance Manager
Participants: CFO
Source: workflow W2275 — Final Financial Settlement</bpmn:documentation>
      <bpmn:laneSet id="W2275_LaneSet2">
        <bpmn:lane id="W2275_Lane1" name="Finance Manager">
        <bpmn:flowNodeRef>W2275_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2275_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2275_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2275_Start3" name="Closure complete">
        <bpmn:outgoing>W2275_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2275_Task4" name="Prepares final P&amp;L: closure costs, asset gains/losses, write-downs, severance…">
        <bpmn:documentation>Step 1: Prepares final P&amp;L: closure costs, asset gains/losses, write-downs, severance, lease penalty; closes cost center; settles payables; collects receivables; final tax filings; archives 10 years
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 5–10 days + 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2275_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2275_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2275_End5" name="Complete">
        <bpmn:incoming>W2275_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2275_Annotation6">
        <bpmn:text>Controls: - CTL-407 (ensure controlled execution — Store Wind-Down &amp; Asset Recovery (PA-59.2).) | - CTL-407: financial-close accuracy — links to VS-17; CTL-214 (tax-settlement &amp; filing integrity — links to VS-79 / W90); operational: CFO sign-off
Owner: Finance Manager</bpmn:text>
      </bpmn:textAnnotation>
