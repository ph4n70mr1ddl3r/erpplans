      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2271" name="W2271. Fixed Asset Recovery &amp; Disposal" isExecutable="false">
      <bpmn:documentation>Trigger: Month 4–5 of closure
Frequency: Per closure
Volume: ~PHP 5–10M in fixtures/equipment per closure (per W807)
Owner: Facilities Coordinator
Participants: Finance, COO
Source: workflow W2271 — Fixed Asset Recovery &amp; Disposal</bpmn:documentation>
      <bpmn:laneSet id="W2271_LaneSet2">
        <bpmn:lane id="W2271_Lane1" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W2271_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2271_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2271_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2271_Start3" name="Month 4–5 of closure">
        <bpmn:outgoing>W2271_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2271_Task4" name="Inventories assets: POS, shelving, forklifts, tools, office equipment…">
        <bpmn:documentation>Step 1: Inventories assets: POS, shelving, forklifts, tools, office equipment; determines reuse vs. disposal; reusable transferred to new stores/DCs; disposable sold or scrapped; Finance adjusts asset register
Responsible (R): Facilities Coordinator / Finance
Accountable (A): COO
Duration: 3–5 days + 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2271_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2271_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2271_End5" name="Complete">
        <bpmn:incoming>W2271_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2271_Annotation6">
        <bpmn:text>Controls: - CTL-26: asset disposal authorization — links to VS-35; CTL-184 (fixed-asset audit); operational: COO sign-off
Owner: Facilities Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2271_Assoc7" sourceRef="W2271_Annotation6" targetRef="W2271_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2271_Flow8" sourceRef="W2271_Start3" targetRef="W2271_Task4" />
      <bpmn:sequenceFlow id="W2271_Flow9" sourceRef="W2271_Task4" targetRef="W2271_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2271_diag">
