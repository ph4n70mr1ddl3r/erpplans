    <bpmn:process id="W_W2280" name="W2280. Post-Closure Financial Impact Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly post-closure
Frequency: Quarterly for 4 quarters
Volume: Full impact per closure
Owner: FP&amp;A Director
Participants: CEO
Source: workflow W2280 — Post-Closure Financial Impact Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2280_LaneSet2">
        <bpmn:lane id="W2280_Lane1" name="FP&amp;A Director">
        <bpmn:flowNodeRef>W2280_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2280_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2280_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2280_Start3" name="Quarterly post-closure">
        <bpmn:outgoing>W2280_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2280_Task4" name="Compares actual costs vs. estimates; tracks quarterly savings vs. projected…">
        <bpmn:documentation>Step 1: Compares actual costs vs. estimates; tracks quarterly savings vs. projected; calculates actual payback; reviews surrounding store impact; validates network P&amp;L
Responsible (R): FP&amp;A Director
Accountable (A): CEO
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2280_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2280_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2280_End5" name="Complete">
        <bpmn:incoming>W2280_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2280_Annotation6">
        <bpmn:text>Controls: - CTL-408 (ensure controlled execution — Staff Redeployment &amp; Post-Closure Analytics (PA-59.3).) | - CTL-408 (financial-impact accuracy — links to VS-17); operational: CEO quarterly review
Owner: FP&amp;A Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2280_Assoc7" sourceRef="W2280_Annotation6" targetRef="W2280_Start3" associationDirection="None" />
