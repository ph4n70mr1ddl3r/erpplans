    <bpmn:process id="W_W2283" name="W2283. Employee Redeployment Success Metrics" isExecutable="false">
      <bpmn:documentation>Trigger: 6 months post-redeployment
Frequency: 6 months after
Volume: ~15–20 redeployed employees
Owner: CHRO
Participants: CHRO
Source: workflow W2283 — Employee Redeployment Success Metrics</bpmn:documentation>
      <bpmn:laneSet id="W2283_LaneSet2">
        <bpmn:lane id="W2283_Lane1" name="CHRO">
        <bpmn:flowNodeRef>W2283_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2283_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2283_End5</bpmn:flowNodeRef>
