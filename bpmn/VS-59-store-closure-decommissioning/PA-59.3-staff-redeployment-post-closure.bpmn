      </bpmn:laneSet>
      <bpmn:startEvent id="W2283_Start3" name="6 months post-redeployment">
        <bpmn:outgoing>W2283_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2283_Task4" name="Surveys: satisfaction, performance, commute, retention at 6 and 12 months…">
        <bpmn:documentation>Step 1: Surveys: satisfaction, performance, commute, retention at 6 and 12 months; identifies best practices; updates HR policies
Responsible (R): CHRO
Accountable (A): CHRO
Duration: 3–5 days + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2283_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2283_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2283_End5" name="Complete">
        <bpmn:incoming>W2283_Flow9</bpmn:incoming>
      </bpmn:endEvent>
