    <bpmn:process id="W_W2281" name="W2281. Store Closure Database &amp; Knowledge Management" isExecutable="false">
      <bpmn:documentation>Trigger: Post-closure
Frequency: Per closure
Volume: Central knowledge base
Owner: Store Closure Project Manager
Participants: Closure PM, IT, COO
Source: workflow W2281 — Store Closure Database &amp; Knowledge Management</bpmn:documentation>
      <bpmn:laneSet id="W2281_LaneSet2">
        <bpmn:lane id="W2281_Lane1" name="Closure PM">
        <bpmn:flowNodeRef>W2281_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2281_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2281_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2281_Start3" name="Post-closure">
        <bpmn:outgoing>W2281_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2281_Task4" name="Compiles: business case, plan, timeline, actual costs, lessons learned…">
        <bpmn:documentation>Step 1: Compiles: business case, plan, timeline, actual costs, lessons learned, contacts, filings; stores in knowledge management system; accessible for future closures and new store openings (VS-37)
Responsible (R): Closure PM / IT
Accountable (A): COO
Duration: 3–5 days + 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2281_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2281_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2281_End5" name="Complete">
        <bpmn:incoming>W2281_Flow9</bpmn:incoming>
      </bpmn:endEvent>
