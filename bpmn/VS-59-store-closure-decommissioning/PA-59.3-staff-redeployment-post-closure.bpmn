    <bpmn:process id="W_W2284" name="W2284. Network Optimization Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Annual network review
Frequency: Annual; 200 stores
Volume: Full network
Owner: VP Store Operations
Participants: VP Store Operations, FP&amp;A Director, CEO
Source: workflow W2284 — Network Optimization Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2284_LaneSet2">
