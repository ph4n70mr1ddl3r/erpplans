    <bpmn:process id="W_W2282" name="W2282. Regional Sales Impact Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: 6 and 12 months post-closure
Frequency: 6 months and 12 months
Volume: 3–5 nearby stores
Owner: Analytics Manager
Participants: VP Store Operations
Source: workflow W2282 — Regional Sales Impact Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2282_LaneSet2">
        <bpmn:lane id="W2282_Lane1" name="Analytics Manager">
        <bpmn:flowNodeRef>W2282_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2282_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2282_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2282_Start3" name="6 and 12 months post-closure">
        <bpmn:outgoing>W2282_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2282_Task4" name="Assesses: total regional sales pre vs. post, market share change, competitor…">
        <bpmn:documentation>Step 1: Assesses: total regional sales pre vs. post, market share change, competitor activity; identifies if closure created competitor opportunity; recommends defensive actions
Responsible (R): Analytics Manager
Accountable (A): VP Store Operations
Duration: 2–3 days + 1 day</bpmn:documentation>
        <bpmn:incoming>W2282_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2282_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2282_End5" name="Complete">
