    <bpmn:process id="W_W2278" name="W2278. Redeployed Employee Onboarding at New Location" isExecutable="false">
      <bpmn:documentation>Trigger: Employee accepts transfer
Frequency: Per closure; ~29 staff redeployed (the 29-staff/store canon; balance separated per W2274)
Volume: ~15–20 per closure
Owner: HR Manager
Participants: Receiving Store Manager, CHRO
Source: workflow W2278 — Redeployed Employee Onboarding at New Location</bpmn:documentation>
      <bpmn:laneSet id="W2278_LaneSet2">
        <bpmn:lane id="W2278_Lane1" name="HR Manager">
        <bpmn:flowNodeRef>W2278_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2278_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2278_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2278_Start3" name="Employee accepts transfer">
        <bpmn:outgoing>W2278_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2278_Task4" name="HR processes movement in system, updates location, arranges relocation support…">
        <bpmn:documentation>Step 1: HR processes movement in system, updates location, arranges relocation support; receiving Store Manager plans orientation; 30-day check-in to assess adjustment
Responsible (R): HR Manager / Receiving Store Manager
Accountable (A): CHRO
Duration: 3–5 days + 1 week</bpmn:documentation>
        <bpmn:incoming>W2278_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2278_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2278_End5" name="Complete">
        <bpmn:incoming>W2278_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2278_Annotation6">
        <bpmn:text>Controls: - CTL-408 (ensure controlled execution — Staff Redeployment &amp; Post-Closure Analytics (PA-59.3).) | - CTL-408 (employee-master update — links to VS-19 / W292); operational: CHRO sign-off
Owner: HR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2278_Assoc7" sourceRef="W2278_Annotation6" targetRef="W2278_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2278_Flow8" sourceRef="W2278_Start3" targetRef="W2278_Task4" />
      <bpmn:sequenceFlow id="W2278_Flow9" sourceRef="W2278_Task4" targetRef="W2278_End5" />
    </bpmn:process>
