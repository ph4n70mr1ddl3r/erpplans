    <bpmn:process id="W_W2279" name="W2279. Customer Migration Success Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly post-closure
Frequency: Monthly for 12 months
Volume: ~15K–30K customers per store
Owner: Loyalty Program Manager
Participants: Loyalty Manager, VP Marketing
Source: workflow W2279 — Customer Migration Success Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2279_LaneSet2">
        <bpmn:lane id="W2279_Lane1" name="System">
        <bpmn:flowNodeRef>W2279_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2279_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2279_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2279_Start3" name="Monthly post-closure">
        <bpmn:outgoing>W2279_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2279_Task4" name="System tracks: loyalty members from closed store → purchases at nearby stores…">
        <bpmn:documentation>Step 1: System tracks: loyalty members from closed store → purchases at nearby stores; calculates retention and spend change; re-engagement campaigns for non-migrated customers
Responsible (R): System / Loyalty Manager
Accountable (A): VP Marketing
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2279_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2279_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2279_End5" name="Complete">
        <bpmn:incoming>W2279_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2279_Annotation6">
        <bpmn:text>Controls: - CTL-408 (ensure controlled execution — Staff Redeployment &amp; Post-Closure Analytics (PA-59.3).) | - CTL-408 (customer-data privacy — links to VS-91 / W53); operational: VP Marketing monthly review
Owner: Loyalty Program Manager</bpmn:text>
      </bpmn:textAnnotation>
