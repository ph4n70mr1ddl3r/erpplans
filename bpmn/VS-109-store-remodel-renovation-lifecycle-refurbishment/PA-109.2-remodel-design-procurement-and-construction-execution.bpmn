    <bpmn:process id="W_W3484" name="W3484. Remodel Mechanical, Electrical, Plumbing &amp; HVAC Works" isExecutable="false">
      <bpmn:documentation>Trigger: Construction sequence (W3483); design (W3477)
Frequency: Per remodel
Volume: MEP scope per store
Owner: Facilities / MEP Engineer
Participants: Facilities/MEP (links to VS-20.3), Contractor, Project Manager, HSE (links to VS-24), Energy Manager (links to VS-108)
Source: workflow W3484 — Remodel Mechanical, Electrical, Plumbing &amp; HVAC Works</bpmn:documentation>
      <bpmn:laneSet id="W3484_LaneSet2">
        <bpmn:lane id="W3484_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W3484_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3484_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3484_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3484_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3484_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3484_Start3" name="Construction sequence (W3483); design (W3477)">
        <bpmn:outgoing>W3484_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
