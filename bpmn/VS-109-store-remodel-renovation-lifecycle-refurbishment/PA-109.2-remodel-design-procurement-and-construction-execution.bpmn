    <bpmn:process id="W_W3482" name="W3482. Remodel Construction Vendor Selection &amp; Contracting" isExecutable="false">
      <bpmn:documentation>Trigger: Capex approved (W3476); scope-of-works (W3475)
Frequency: Per remodel
Volume: ~30–40 remodel contracts/year
Owner: Procurement / Real Estate
Participants: Procurement (links to VS-03/VS-34), Real Estate (links to VS-20), Legal (links to VS-100.3), Project Manager (links to VS-112), Contractor
Source: workflow W3482 — Remodel Construction Vendor Selection &amp; Contracting</bpmn:documentation>
      <bpmn:laneSet id="W3482_LaneSet4">
        <bpmn:lane id="W3482_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3482_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3482_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3482_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3482_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3482_Lane3" name="Project Manager">
        <bpmn:flowNodeRef>W3482_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3482_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3482_Start5" name="Capex approved (W3476); scope-of-works (W3475)">
        <bpmn:outgoing>W3482_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3482_Task6" name="Procurement/Real Estate select the general contractor / trade vendors…">
        <bpmn:documentation>Step 1: Procurement/Real Estate select the general contractor / trade vendors: pre-qualification, RFQ/RFP (links to VS-03), accreditation (links to VS-34.2), references on retail-remodel work, and HSE/insurance clearance (links to VS-24/VS-26); leverage framework/master agreements across the ~30–40/year program
Responsible (R): Procurement / Real Estate
Accountable (A): VP Store Operations
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3482_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3482_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3482_Task7" name="Legal/Real Estate negotiate and execute the contract: lump-sum vs GMP…">
        <bpmn:documentation>Step 2: Legal/Real Estate negotiate and execute the contract: lump-sum vs GMP, milestone payments (links to VS-40/W1820), liquidated damages, performance retention, warranty, HSE/permits allocation (links to VS-24/W3479), insurance (links to VS-26), and termination (links to VS-100.3/W402)
Responsible (R): Legal / Real Estate / Procurement
Accountable (A): COO / CFO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3482_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3482_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3482_Task8" name="Project Manager conduct the pre-construction kickoff: scope/walk-through…">
        <bpmn:documentation>Step 3: Project Manager conduct the pre-construction kickoff: scope/walk-through, schedule handshake (W3480), site HSE/rules, communications, change-control protocol (links to W3556), and acceptance criteria (W3488); confirm notice-to-proceed after permits (W3479)
Responsible (R): Project Manager / Contractor
Accountable (A): VP Store Operations
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3482_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3482_End9" name="Complete">
        <bpmn:incoming>W3482_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3482_Annotation10">
        <bpmn:text>Controls: - CTL-557 (ensure controlled execution — Remodel Design, Procurement &amp; Construction Execution (PA-109.2).) | - operational: pre-qualification and references; operational: clear contract and change control (W3556)
Owner: Procurement / Real Estate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3482_Assoc11" sourceRef="W3482_Annotation10" targetRef="W3482_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3482_Flow12" sourceRef="W3482_Start5" targetRef="W3482_Task6" />
      <bpmn:sequenceFlow id="W3482_Flow13" sourceRef="W3482_Task6" targetRef="W3482_Task7" />
      <bpmn:sequenceFlow id="W3482_Flow14" sourceRef="W3482_Task7" targetRef="W3482_Task8" />
      <bpmn:sequenceFlow id="W3482_Flow15" sourceRef="W3482_Task8" targetRef="W3482_End9" />
    </bpmn:process>
