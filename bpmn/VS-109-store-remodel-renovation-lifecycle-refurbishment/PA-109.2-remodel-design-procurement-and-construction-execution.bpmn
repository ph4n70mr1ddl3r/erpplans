      <bpmn:sequenceFlow id="W3483_Flow13" sourceRef="W3483_Task6" targetRef="W3483_Task7" />
      <bpmn:sequenceFlow id="W3483_Flow14" sourceRef="W3483_Task7" targetRef="W3483_End8" />
    </bpmn:process>
