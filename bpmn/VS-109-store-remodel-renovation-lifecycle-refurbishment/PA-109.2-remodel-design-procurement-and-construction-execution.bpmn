      <bpmndi:BPMNPlane id="W3481_plane" bpmnElement="W_W3481">
        <bpmndi:BPMNShape id="W3481_Lane1_di" bpmnElement="W3481_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
