      <bpmndi:BPMNPlane id="W3491_plane" bpmnElement="W_W3491">
        <bpmndi:BPMNShape id="W3491_Lane1_di" bpmnElement="W3491_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
