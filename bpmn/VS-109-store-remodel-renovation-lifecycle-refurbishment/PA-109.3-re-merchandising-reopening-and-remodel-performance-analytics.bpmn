      <bpmn:sequenceFlow id="W3490_Flow12" sourceRef="W3490_Task5" targetRef="W3490_Task6" />
      <bpmn:sequenceFlow id="W3490_Flow13" sourceRef="W3490_Task6" targetRef="W3490_Task7" />
      <bpmn:sequenceFlow id="W3490_Flow14" sourceRef="W3490_Task7" targetRef="W3490_End8" />
    </bpmn:process>
