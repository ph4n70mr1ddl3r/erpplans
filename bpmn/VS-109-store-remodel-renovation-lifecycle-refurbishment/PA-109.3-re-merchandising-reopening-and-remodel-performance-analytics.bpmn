      <bpmn:sequenceFlow id="W3491_Flow13" sourceRef="W3491_Task6" targetRef="W3491_Task7" />
      <bpmn:sequenceFlow id="W3491_Flow14" sourceRef="W3491_Task7" targetRef="W3491_End8" />
    </bpmn:process>
