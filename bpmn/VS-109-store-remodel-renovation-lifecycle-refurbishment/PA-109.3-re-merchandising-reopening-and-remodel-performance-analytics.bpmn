    <bpmn:process id="W_W3489" name="W3489. Remodel Soft Launch / Grand Re-opening &amp; Marketing" isExecutable="false">
      <bpmn:documentation>Trigger: Handover complete (W3488); re-opening date
Frequency: Per remodel
Volume: ~30–40 re-openings/year
Owner: Marketing / Store Manager
Participants: Marketing (links to VS-14), Store Manager (links to VS-07), Merchandising (links to VS-01), Loyalty (links to VS-13), Regional Manager (links to VS-07)
Source: workflow W3489 — Remodel Soft Launch / Grand Re-opening &amp; Marketing</bpmn:documentation>
      <bpmn:laneSet id="W3489_LaneSet3">
        <bpmn:lane id="W3489_Lane1" name="Marketing">
        <bpmn:flowNodeRef>W3489_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3489_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3489_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3489_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W3489_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3489_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3489_Start4" name="Handover complete (W3488); re-opening date">
        <bpmn:outgoing>W3489_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3489_Task5" name="Marketing/Store Manager plan the re-opening: soft-launch (staff/VIP/trade links…">
        <bpmn:documentation>Step 1: Marketing/Store Manager plan the re-opening: soft-launch (staff/VIP/trade links to VS-43) followed by grand re-opening event, local marketing (links to VS-14.1), loyalty-member and trade-account outreach (links to VS-13/VS-43), re-opening promotions (links to VS-58/VS-14), and PR/community (links to VS-14.3/VS-104)
Responsible (R): Marketing / Store Manager
Accountable (A): CMO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3489_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3489_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3489_Task6" name="Marketing/Merchandising execute re-opening offers, trade-area catchment…">
        <bpmn:documentation>Step 2: Marketing/Merchandising execute re-opening offers, trade-area catchment marketing, and signage/POS materials (links to VS-14.1/W3485); ensure the loyalty engine (links to VS-13), POS (links to VS-08), and ecommerce inventory/price sync (links to VS-10) reflect the new store state
Responsible (R): Marketing / Merchandising / IT
Accountable (A): CMO
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3489_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3489_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3489_Task7" name="Store Manager/Marketing run the re-opening event, capture…">
        <bpmn:documentation>Step 3: Store Manager/Marketing run the re-opening event, capture footfall/sales/feedback (links to VS-13/VS-44), and transition to steady-state operations (links to VS-07); report re-opening results to the program review (W3491/W3496)
Responsible (R): Store Manager / Marketing
Accountable (A): VP Store Operations
Duration: Per remodel</bpmn:documentation>
        <bpmn:incoming>W3489_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3489_End8" name="Complete">
        <bpmn:incoming>W3489_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3489_Annotation9">
        <bpmn:text>Controls: - CTL-558 (ensure controlled execution — Re-merchandising, Re-opening &amp; Remodel Performance Analytics (PA-109.3).) | - operational: targeted trade-area campaign; operational: ecommerce sync check (links to VS-10)
Owner: Marketing / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3489_Assoc10" sourceRef="W3489_Annotation9" targetRef="W3489_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3489_Flow11" sourceRef="W3489_Start4" targetRef="W3489_Task5" />
      <bpmn:sequenceFlow id="W3489_Flow12" sourceRef="W3489_Task5" targetRef="W3489_Task6" />
      <bpmn:sequenceFlow id="W3489_Flow13" sourceRef="W3489_Task6" targetRef="W3489_Task7" />
      <bpmn:sequenceFlow id="W3489_Flow14" sourceRef="W3489_Task7" targetRef="W3489_End8" />
    </bpmn:process>
