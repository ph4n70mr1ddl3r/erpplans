      <bpmndi:BPMNPlane id="W3489_plane" bpmnElement="W_W3489">
        <bpmndi:BPMNShape id="W3489_Lane1_di" bpmnElement="W3489_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
