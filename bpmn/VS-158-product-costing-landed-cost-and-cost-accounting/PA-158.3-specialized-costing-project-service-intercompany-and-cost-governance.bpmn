        <bpmndi:BPMNShape id="W4666_Start3_di" bpmnElement="W4666_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4666_End7_di" bpmnElement="W4666_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4666_Annotation8_di" bpmnElement="W4666_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4666_Flow10_di" bpmnElement="W4666_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4666_Flow11_di" bpmnElement="W4666_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4666_Flow12_di" bpmnElement="W4666_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4666_Flow13_di" bpmnElement="W4666_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4666_Assoc9_di" bpmnElement="W4666_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4667" name="W4667. Intercompany Cost Transfer &amp; Transfer-Pricing Cost Build" isExecutable="false">
      <bpmn:documentation>Trigger: Intercompany service/goods flow (VS-72); transfer-pricing review (VS-17.2)
Frequency: Per IC flow + quarterly TP review
Volume: 5-entity group; warehousing/distribution fees, ecommerce fulfillment fees, rent (VS-97)
Owner: Cost Accounting Manager
Participants: Intercompany/Shared Services (VS-72), Treasury (VS-18), Tax (VS-79), Controller
Source: workflow W4667 — Intercompany Cost Transfer &amp; Transfer-Pricing Cost Build</bpmn:documentation>
      <bpmn:laneSet id="W4667_LaneSet2">
        <bpmn:lane id="W4667_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4667_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4667_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4667_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4667_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4667_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4667_Start3" name="Intercompany service/goods flow (VS-72); transfer-pricing review (VS-17.2)">
        <bpmn:outgoing>W4667_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4667_Task4" name="Build the intercompany cost-transfer model: the cost-plus markup for BuildRight…">
        <bpmn:documentation>Step 1: Build the intercompany cost-transfer model: the cost-plus markup for BuildRight Logistics warehousing/distribution fees to Depot Inc., Digital Commerce per-order fulfillment fees, and Property Mgmt rent (at arm&#x27;s-length transfer pricing per VS-17.2 W612/W1299)
Responsible (R): Cost Accounting / Shared Services
Accountable (A): Controller / VP Tax
Duration: Per IC flow</bpmn:documentation>
        <bpmn:incoming>W4667_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4667_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4667_Task5" name="Compute the cost base for each IC service (actual operating cost of the serving…">
        <bpmn:documentation>Step 2: Compute the cost base for each IC service (actual operating cost of the serving entity + agreed markup); post IC cost to the receiving entity and IC revenue to the serving entity; eliminate on consolidation (VS-17.2)
Responsible (R): Cost Accounting / IC
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4667_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4667_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4667_Task6" name="Validate transfer-pricing alignment (arm&#x27;s-length) with TP documentation…">
        <bpmn:documentation>Step 3: Validate transfer-pricing alignment (arm&#x27;s-length) with TP documentation (VS-17.2 W1299/VS-72 W2594); adjust markups on the annual TP review and post IC reclass
Responsible (R): Cost Accounting / Tax / Treasury
Accountable (A): Controller / CFO
Duration: Quarterly + annual</bpmn:documentation>
        <bpmn:incoming>W4667_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4667_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4667_End7" name="Complete">
        <bpmn:incoming>W4667_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4667_Annotation8">
        <bpmn:text>Controls: - CTL-706 (ensure controlled execution — Specialized Costing (Project, Service, Intercompany) &amp; Cost Governance (PA-158.3).) | - CTL-706: IC markups arm&#x27;s-length (TP-documented); cost base reconciled; eliminated on consolidation
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4667_Assoc9" sourceRef="W4667_Annotation8" targetRef="W4667_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4667_Flow10" sourceRef="W4667_Start3" targetRef="W4667_Task4" />
      <bpmn:sequenceFlow id="W4667_Flow11" sourceRef="W4667_Task4" targetRef="W4667_Task5" />
      <bpmn:sequenceFlow id="W4667_Flow12" sourceRef="W4667_Task5" targetRef="W4667_Task6" />
      <bpmn:sequenceFlow id="W4667_Flow13" sourceRef="W4667_Task6" targetRef="W4667_End7" />
    </bpmn:process>
