    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4666" name="W4666. Service &amp; Installation Costing (Labor, Subcontractor, Burden)" isExecutable="false">
      <bpmn:documentation>Trigger: Service/installation sale (VS-12); service cost transaction; periodic refresh
Frequency: Per service type + periodic
Volume: Installation &amp; repair services (VS-12.1); tool rental; workshops
Owner: Cost Accounting Manager
Participants: Services (VS-12), HR/Labor (VS-19), Subcontractor mgmt, Controller
Source: workflow W4666 — Service &amp; Installation Costing (Labor, Subcontractor, Burden)</bpmn:documentation>
      <bpmn:laneSet id="W4666_LaneSet2">
        <bpmn:lane id="W4666_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4666_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4666_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4666_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4666_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4666_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4666_Start3" name="Service/installation sale (VS-12); service cost transaction; periodic refresh">
        <bpmn:outgoing>W4666_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4666_Task4" name="Build the service-cost standard: direct labor (loaded wage rate incl…">
        <bpmn:documentation>Step 1: Build the service-cost standard: direct labor (loaded wage rate incl. benefits/burden per VS-102), subcontractor rate, vehicle/tool cost, and service overhead; allocate to the service work order (W544)
Responsible (R): Cost Accounting / Services / HR
Accountable (A): Controller
Duration: Per service type</bpmn:documentation>
        <bpmn:incoming>W4666_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4666_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4666_Task5" name="Collect actual service cost (technician timesheet, subcontractor invoice…">
        <bpmn:documentation>Step 2: Collect actual service cost (technician timesheet, subcontractor invoice, vehicle/tool cost) to the work order; post service-cost variance (actual vs. standard)
Responsible (R): Cost Accounting / Services
Accountable (A): Controller
Duration: Per work order + monthly</bpmn:documentation>
        <bpmn:incoming>W4666_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4666_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4666_Task6" name="Analyze service margin by service type/technician/region; feed into service…">
        <bpmn:documentation>Step 3: Analyze service margin by service type/technician/region; feed into service pricing (VS-12) and the performance-obligation allocation for product+install bundles (W4627/W4634)
Responsible (R): Cost Accounting / Services
Accountable (A): Controller
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4666_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4666_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4666_End7" name="Complete">
        <bpmn:incoming>W4666_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4666_Annotation8">
        <bpmn:text>Controls: - CTL-706 (ensure controlled execution — Specialized Costing (Project, Service, Intercompany) &amp; Cost Governance (PA-158.3).) | - CTL-706: service cost built with loaded labor burden; actual collected to work order; variance analyzed monthly
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4666_Assoc9" sourceRef="W4666_Annotation8" targetRef="W4666_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4666_Flow10" sourceRef="W4666_Start3" targetRef="W4666_Task4" />
      <bpmn:sequenceFlow id="W4666_Flow11" sourceRef="W4666_Task4" targetRef="W4666_Task5" />
      <bpmn:sequenceFlow id="W4666_Flow12" sourceRef="W4666_Task5" targetRef="W4666_Task6" />
      <bpmn:sequenceFlow id="W4666_Flow13" sourceRef="W4666_Task6" targetRef="W4666_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4666_diag">
      <bpmndi:BPMNPlane id="W4666_plane" bpmnElement="W_W4666">
        <bpmndi:BPMNShape id="W4666_Lane1_di" bpmnElement="W4666_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4666_Task4_di" bpmnElement="W4666_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
