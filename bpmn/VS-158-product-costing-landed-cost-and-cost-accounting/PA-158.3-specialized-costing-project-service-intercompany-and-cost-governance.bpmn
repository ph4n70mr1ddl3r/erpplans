    <bpmn:process id="W_W4670" name="W4670. Cost-Master Data Governance, Change-Control &amp; Approval Matrix" isExecutable="false">
      <bpmn:documentation>Trigger: Cost-master change request; audit finding; governance review
Frequency: Per change + quarterly governance review
Volume: ~35K SKU cost records; vendor/contract cost data
Owner: Cost Accounting Manager
Participants: Master Data (VS-29), Merchandising (VS-01), Controller, Internal Audit (VS-21)
Source: workflow W4670 — Cost-Master Data Governance, Change-Control &amp; Approval Matrix</bpmn:documentation>
      <bpmn:laneSet id="W4670_LaneSet2">
        <bpmn:lane id="W4670_Lane1" name="Cost Accounting">
