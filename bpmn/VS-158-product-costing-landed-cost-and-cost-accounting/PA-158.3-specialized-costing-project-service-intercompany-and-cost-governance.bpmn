      <bpmndi:BPMNPlane id="W4667_plane" bpmnElement="W_W4667">
        <bpmndi:BPMNShape id="W4667_Lane1_di" bpmnElement="W4667_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4667_Task4_di" bpmnElement="W4667_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
