        <bpmndi:BPMNEdge id="W4649_Flow14_di" bpmnElement="W4649_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4649_Assoc10_di" bpmnElement="W4649_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4650" name="W4650. Purchase-Price, Vendor-Quote &amp; Should-Cost Data Aggregation" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor contract/quote update; new SKU sourcing; periodic refresh
Frequency: Per contract/quote + quarterly refresh
Volume: ~800–1,000 vendors; ~35K SKUs; top-20 vendors = 45% of COGS
Owner: Cost Accounting Manager
Participants: Procurement (VS-03), Merchandising (VS-01), Insights (VS-44), Pricing (VS-01.2)
Source: workflow W4650 — Purchase-Price, Vendor-Quote &amp; Should-Cost Data Aggregation</bpmn:documentation>
      <bpmn:laneSet id="W4650_LaneSet2">
        <bpmn:lane id="W4650_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4650_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4650_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4650_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4650_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4650_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4650_Start3" name="Vendor contract/quote update; new SKU sourcing; periodic refresh">
        <bpmn:outgoing>W4650_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4650_Task4" name="Aggregate purchase-price inputs into the cost engine: vendor contract/quote…">
        <bpmn:documentation>Step 1: Aggregate purchase-price inputs into the cost engine: vendor contract/quote price, price-protection claims (W161), volume-rebate estimates (VS-39, netted as a reduction of cost per W4664), and indexed/commodity-linked price clauses (VS-106)
Responsible (R): Cost Accounting / Procurement
Accountable (A): Controller
Duration: Quarterly + on change</bpmn:documentation>
        <bpmn:incoming>W4650_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4650_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4650_Task5" name="should-cost">
        <bpmn:documentation>Step 2: Build should-cost models for key categories (steel, cement, lumber, copper, paint) from raw-material indices + conversion/overhead estimates; compare to vendor quote to surface vendor margin and negotiation opportunity
Responsible (R): Cost Accounting / Insights / Procurement
Accountable (A): Controller / VP Merchandising
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W4650_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4650_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4650_Task6" name="Feed the validated purchase-price + should-cost data into the standard-cost…">
        <bpmn:documentation>Step 3: Feed the validated purchase-price + should-cost data into the standard-cost build (W4656); flag SKUs where vendor price exceeds should-cost threshold for procurement action (VS-03.3)
Responsible (R): Cost Accounting / Procurement
Accountable (A): Controller
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4650_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4650_End7" name="Complete">
        <bpmn:incoming>W4650_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4650_Annotation8">
        <bpmn:text>Controls: - CTL-704 (ensure controlled execution — Standard-Cost Setup, Landed-Cost &amp; Item Cost Roll (PA-158.1).) | - CTL-704: purchase-price reconciled to vendor contracts; rebate netting documented (no double-count); should-cost variances Controller-reviewed
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4650_Assoc9" sourceRef="W4650_Annotation8" targetRef="W4650_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4650_Flow10" sourceRef="W4650_Start3" targetRef="W4650_Task4" />
      <bpmn:sequenceFlow id="W4650_Flow11" sourceRef="W4650_Task4" targetRef="W4650_Task5" />
      <bpmn:sequenceFlow id="W4650_Flow12" sourceRef="W4650_Task5" targetRef="W4650_Task6" />
      <bpmn:sequenceFlow id="W4650_Flow13" sourceRef="W4650_Task6" targetRef="W4650_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4650_diag">
      <bpmndi:BPMNPlane id="W4650_plane" bpmnElement="W_W4650">
        <bpmndi:BPMNShape id="W4650_Lane1_di" bpmnElement="W4650_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
