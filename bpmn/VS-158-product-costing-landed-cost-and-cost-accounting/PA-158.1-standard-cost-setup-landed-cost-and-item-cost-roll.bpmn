<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-158.1-standard-cost-setup-landed-cost-and-item-cost-roll" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4649" name="W4649. Item Cost-Master &amp; Standard-Cost Policy Framework" isExecutable="false">
      <bpmn:documentation>Trigger: Cost-policy refresh; new item class; ERP setup
Frequency: Annual policy + per new item class
Volume: 1 cost-accounting policy; ~35K active SKUs across 13 categories
Owner: Cost Accounting Manager (Controller org)
Participants: Controller, Merchandising (VS-01), Master Data (VS-29), IT (VS-27/VS-113)
Source: workflow W4649 — Item Cost-Master &amp; Standard-Cost Policy Framework</bpmn:documentation>
      <bpmn:laneSet id="W4649_LaneSet3">
        <bpmn:lane id="W4649_Lane1" name="Cost Accounting Manager">
        <bpmn:flowNodeRef>W4649_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4649_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4649_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4649_Lane2" name="Cost Accounting">
        <bpmn:flowNodeRef>W4649_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4649_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4649_Start4" name="Cost-policy refresh; new item class; ERP setup">
        <bpmn:outgoing>W4649_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4649_Task5" name="Define the cost-element and cost-type taxonomy (material, freight-in, duty…">
        <bpmn:documentation>Step 1: Define the cost-element and cost-type taxonomy (material, freight-in, duty, brokerage, insurance, handling, overhead absorption), the valuation method policy (standard cost for merchandisable items; WAC at receipt per profile §6.3; actual for project/job), and the per-category overhead-absorption rules
Responsible (R): Cost Accounting Manager
Accountable (A): Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4649_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4649_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4649_Task6" name="Configure the item cost-master: cost element breakdown, standard-cost vs. WAC…">
        <bpmn:documentation>Step 2: Configure the item cost-master: cost element breakdown, standard-cost vs. WAC flag, lot/serial cost tracking for catch-weight/cut-to-length, kit/BOM linkage, and entity/location cost segments; align with master data governance (VS-29)
Responsible (R): Cost Accounting / Master Data / IT
Accountable (A): Controller / CIO
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4649_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4649_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4649_Task7" name="Publish the cost-accounting policy and the standard-cost update calendar; train…">
        <bpmn:documentation>Step 3: Publish the cost-accounting policy and the standard-cost update calendar; train merchandising/project teams on cost-data inputs and the variance-to-standard accountability model
Responsible (R): Cost Accounting Manager
Accountable (A): Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4649_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4649_End8" name="Complete">
        <bpmn:incoming>W4649_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4649_Annotation9">
        <bpmn:text>Controls: - CTL-704 (ensure controlled execution — Standard-Cost Setup, Landed-Cost &amp; Item Cost Roll (PA-158.1).) | - CTL-704: cost policy Controller-approved; cost-master changes via master-data governance (VS-29); valuation method documented per item class
Owner: Cost Accounting Manager (Controller org)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4649_Assoc10" sourceRef="W4649_Annotation9" targetRef="W4649_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4649_Flow11" sourceRef="W4649_Start4" targetRef="W4649_Task5" />
      <bpmn:sequenceFlow id="W4649_Flow12" sourceRef="W4649_Task5" targetRef="W4649_Task6" />
      <bpmn:sequenceFlow id="W4649_Flow13" sourceRef="W4649_Task6" targetRef="W4649_Task7" />
      <bpmn:sequenceFlow id="W4649_Flow14" sourceRef="W4649_Task7" targetRef="W4649_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4649_diag">
      <bpmndi:BPMNPlane id="W4649_plane" bpmnElement="W_W4649">
        <bpmndi:BPMNShape id="W4649_Lane1_di" bpmnElement="W4649_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4649_Lane2_di" bpmnElement="W4649_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
