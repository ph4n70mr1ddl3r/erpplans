      <bpmn:sequenceFlow id="W4656_Flow11" sourceRef="W4656_Task4" targetRef="W4656_Task5" />
      <bpmn:sequenceFlow id="W4656_Flow12" sourceRef="W4656_Task5" targetRef="W4656_Task6" />
      <bpmn:sequenceFlow id="W4656_Flow13" sourceRef="W4656_Task6" targetRef="W4656_End7" />
    </bpmn:process>
