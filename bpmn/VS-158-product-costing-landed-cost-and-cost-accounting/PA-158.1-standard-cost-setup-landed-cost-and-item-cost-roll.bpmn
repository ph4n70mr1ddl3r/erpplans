        <bpmndi:BPMNShape id="W4650_Start3_di" bpmnElement="W4650_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4650_End7_di" bpmnElement="W4650_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4650_Annotation8_di" bpmnElement="W4650_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4650_Flow10_di" bpmnElement="W4650_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4650_Flow11_di" bpmnElement="W4650_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4650_Flow12_di" bpmnElement="W4650_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4650_Flow13_di" bpmnElement="W4650_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4650_Assoc9_di" bpmnElement="W4650_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4651" name="W4651. Import Landed-Cost Build-Up: Freight, Duty, Brokerage, Insurance &amp; Port Freight" isExecutable="false">
      <bpmn:documentation>Trigger: Import PO receipt (VS-02.2); duty/freight invoice; periodic landed-cost run
Frequency: Per import shipment + monthly landed-cost run
Volume: ~400–600 import TEUs/month; ~40% of COGS is imported
Owner: Cost Accounting Manager
Participants: Imports/Customs (VS-02.2/VS-87), Treasury/FX (VS-18.3), Freight (VS-110), AP (VS-15)
Source: workflow W4651 — Import Landed-Cost Build-Up: Freight, Duty, Brokerage, Insurance &amp; Port Freight</bpmn:documentation>
      <bpmn:laneSet id="W4651_LaneSet2">
        <bpmn:lane id="W4651_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4651_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4651_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4651_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4651_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4651_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4651_Start3" name="Import PO receipt (VS-02.2); duty/freight invoice; periodic landed-cost run">
        <bpmn:outgoing>W4651_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4651_Task4" name="Build the landed-cost element stack per import shipment: ocean freight, marine…">
        <bpmn:documentation>Step 1: Build the landed-cost element stack per import shipment: ocean freight, marine insurance (W191), customs duty (VS-87), brokerage, demurrage/detention (W249), port freight/drayage (W1169), and FX conversion (actual or hedged rate per W80); allocate to SKUs by value, weight, volume, or cube per category policy
Responsible (R): Cost Accounting / Imports / Freight
Accountable (A): Controller
Duration: Per shipment + monthly</bpmn:documentation>
        <bpmn:incoming>W4651_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4651_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4651_Task5" name="Match the landed-cost elements to AP invoices (3-way, VS-15) and to the goods…">
        <bpmn:documentation>Step 2: Match the landed-cost elements to AP invoices (3-way, VS-15) and to the goods receipt (VS-04); post landed-cost adjustments to inventory/COGS; handle FX rate differences between hedged and actual (VS-18.3)
Responsible (R): Cost Accounting / AP
Accountable (A): Controller
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W4651_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4651_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4651_Task6" name="Reconcile total landed cost to the standard landed cost (W4656) and post the…">
        <bpmn:documentation>Step 3: Reconcile total landed cost to the standard landed cost (W4656) and post the landed-cost variance (W4658); analyze import-rate volatility vs. the commodity/FX hedge (VS-106/VS-18.3)
Responsible (R): Cost Accounting
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4651_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4651_End7" name="Complete">
        <bpmn:incoming>W4651_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4651_Annotation8">
        <bpmn:text>Controls: - CTL-704 (ensure controlled execution — Standard-Cost Setup, Landed-Cost &amp; Item Cost Roll (PA-158.1).) | - CTL-704: landed-cost allocation basis documented per category; 3-way matched to AP; FX rate source governed (VS-18.3); variance analyzed monthly
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4651_Assoc9" sourceRef="W4651_Annotation8" targetRef="W4651_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4651_Flow10" sourceRef="W4651_Start3" targetRef="W4651_Task4" />
      <bpmn:sequenceFlow id="W4651_Flow11" sourceRef="W4651_Task4" targetRef="W4651_Task5" />
      <bpmn:sequenceFlow id="W4651_Flow12" sourceRef="W4651_Task5" targetRef="W4651_Task6" />
      <bpmn:sequenceFlow id="W4651_Flow13" sourceRef="W4651_Task6" targetRef="W4651_End7" />
    </bpmn:process>
