        <bpmndi:BPMNShape id="W4658_Annotation8_di" bpmnElement="W4658_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4658_Flow10_di" bpmnElement="W4658_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4658_Flow11_di" bpmnElement="W4658_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4658_Flow12_di" bpmnElement="W4658_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4658_Flow13_di" bpmnElement="W4658_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4658_Assoc9_di" bpmnElement="W4658_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4659" name="W4659. Production / Conversion Variance for Kitting &amp; Build-to-Order" isExecutable="false">
      <bpmn:documentation>Trigger: Kit assembly / build-to-order (VS-92); monthly variance review
Frequency: Per assembly batch + monthly
Volume: DC kitting volume (VS-92.2); build-to-order assembly
Owner: Cost Accounting Manager
Participants: DC Ops (VS-04/VS-92), Merchandising (VS-92), Controller
Source: workflow W4659 — Production / Conversion Variance for Kitting &amp; Build-to-Order</bpmn:documentation>
      <bpmn:laneSet id="W4659_LaneSet2">
        <bpmn:lane id="W4659_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4659_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4659_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4659_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4659_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4659_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4659_Start3" name="Kit assembly / build-to-order (VS-92); monthly variance review">
        <bpmn:outgoing>W4659_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4659_Task4" name="Capture conversion variance: actual assembly labor/overhead + component…">
        <bpmn:documentation>Step 1: Capture conversion variance: actual assembly labor/overhead + component consumption vs. the kit standard cost (W4654); post material-usage and labor-rate/efficiency variances
Responsible (R): Cost Accounting / DC Ops
Accountable (A): Controller
Duration: Per batch + monthly</bpmn:documentation>
        <bpmn:incoming>W4659_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4659_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4659_Task5" name="Analyze conversion variance by kit/DC: identify yield loss, component…">
        <bpmn:documentation>Step 2: Analyze conversion variance by kit/DC: identify yield loss, component substitution, and labor-efficiency drivers; route to DC operations for corrective action
Responsible (R): Cost Accounting / DC Ops
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4659_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4659_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4659_Task6" name="Feed conversion variance into the kit-standard roll (W4654) and into…">
        <bpmn:documentation>Step 3: Feed conversion variance into the kit-standard roll (W4654) and into kitting-economics decisions (VS-92.3)
Responsible (R): Cost Accounting
Accountable (A): Controller
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4659_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4659_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4659_End7" name="Complete">
        <bpmn:incoming>W4659_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4659_Annotation8">
        <bpmn:text>Controls: - CTL-705 (ensure controlled execution — Cost Variance, Actual-vs-Standard &amp; Margin Analytics (PA-158.2).) | - CTL-705: conversion variance captured and decomposed; yield/efficiency drivers routed; variance feeds the kit roll
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4659_Assoc9" sourceRef="W4659_Annotation8" targetRef="W4659_Start3" associationDirection="None" />
