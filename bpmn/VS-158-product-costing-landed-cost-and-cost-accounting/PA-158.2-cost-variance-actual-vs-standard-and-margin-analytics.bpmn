      <bpmn:sequenceFlow id="W4659_Flow11" sourceRef="W4659_Task4" targetRef="W4659_Task5" />
      <bpmn:sequenceFlow id="W4659_Flow12" sourceRef="W4659_Task5" targetRef="W4659_Task6" />
      <bpmn:sequenceFlow id="W4659_Flow13" sourceRef="W4659_Task6" targetRef="W4659_End7" />
    </bpmn:process>
