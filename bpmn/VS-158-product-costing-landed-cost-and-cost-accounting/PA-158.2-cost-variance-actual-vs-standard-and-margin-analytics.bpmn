    <bpmn:process id="W_W4658" name="W4658. Landed-Cost Variance vs. Standard &amp; Import Rate Volatility Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Import landed-cost finalization (W4651); monthly variance review
Frequency: Per import shipment + monthly
Volume: ~400–600 import TEUs/month
Owner: Cost Accounting Manager
Participants: Imports (VS-02.2), Freight (VS-110), Treasury/FX (VS-18.3), Commodity (VS-106), Controller
Source: workflow W4658 — Landed-Cost Variance vs. Standard &amp; Import Rate Volatility Analysis</bpmn:documentation>
      <bpmn:laneSet id="W4658_LaneSet2">
        <bpmn:lane id="W4658_Lane1" name="Cost Accounting">
        <bpmn:flowNodeRef>W4658_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4658_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4658_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4658_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4658_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4658_Start3" name="Import landed-cost finalization (W4651); monthly variance review">
        <bpmn:outgoing>W4658_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4658_Task4" name="Compare actual landed cost (W4651) to standard landed cost; decompose the…">
        <bpmn:documentation>Step 1: Compare actual landed cost (W4651) to standard landed cost; decompose the variance into freight, duty, brokerage, insurance, demurrage, and FX components; post to the appropriate variance accounts
Responsible (R): Cost Accounting / Imports
Accountable (A): Controller
Duration: Per shipment + monthly</bpmn:documentation>
        <bpmn:incoming>W4658_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4658_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4658_Task5" name="Analyze import-rate volatility (ocean freight rates, FX, commodity-linked duty)…">
        <bpmn:documentation>Step 2: Analyze import-rate volatility (ocean freight rates, FX, commodity-linked duty) vs. the commodity/FX hedge posture (VS-106/VS-18.3); quantify unhedged exposure and pass-through adequacy (VS-106.3)
Responsible (R): Cost Accounting / Treasury / Commodity
Accountable (A): Controller / CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4658_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4658_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4658_Task6" name="Feed landed-cost variance into the standard roll (W4656) and into…">
        <bpmn:documentation>Step 3: Feed landed-cost variance into the standard roll (W4656) and into commodity-risk decisions (VS-106); recommend forward-buy/hedging/duty-optimization actions (VS-87/VS-110/VS-106)
Responsible (R): Cost Accounting / Treasury / Imports
Accountable (A): Controller / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4658_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4658_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4658_End7" name="Complete">
        <bpmn:incoming>W4658_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4658_Annotation8">
        <bpmn:text>Controls: - CTL-705 (ensure controlled execution — Cost Variance, Actual-vs-Standard &amp; Margin Analytics (PA-158.2).) | - CTL-705: landed-cost variance decomposed by element; volatility vs. hedge quantified monthly; variance feeds the roll and commodity decisions
Owner: Cost Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4658_Assoc9" sourceRef="W4658_Annotation8" targetRef="W4658_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4658_Flow10" sourceRef="W4658_Start3" targetRef="W4658_Task4" />
      <bpmn:sequenceFlow id="W4658_Flow11" sourceRef="W4658_Task4" targetRef="W4658_Task5" />
      <bpmn:sequenceFlow id="W4658_Flow12" sourceRef="W4658_Task5" targetRef="W4658_Task6" />
      <bpmn:sequenceFlow id="W4658_Flow13" sourceRef="W4658_Task6" targetRef="W4658_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4658_diag">
      <bpmndi:BPMNPlane id="W4658_plane" bpmnElement="W_W4658">
        <bpmndi:BPMNShape id="W4658_Lane1_di" bpmnElement="W4658_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
