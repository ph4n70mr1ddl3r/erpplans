      <bpmn:sequenceFlow id="W4387_Flow12" sourceRef="W4387_Task5" targetRef="W4387_Task6" />
      <bpmn:sequenceFlow id="W4387_Flow13" sourceRef="W4387_Task6" targetRef="W4387_Task7" />
      <bpmn:sequenceFlow id="W4387_Flow14" sourceRef="W4387_Task7" targetRef="W4387_End8" />
    </bpmn:process>
