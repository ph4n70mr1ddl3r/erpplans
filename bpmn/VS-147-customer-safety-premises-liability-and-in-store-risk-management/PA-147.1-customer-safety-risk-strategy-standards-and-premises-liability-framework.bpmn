    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4386" name="W4386. Customer Safety Standards, Hazard Register &amp; Risk Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4385); new hazard; incident learning
Frequency: Annual + on change
Volume: One customer-safety standards &amp; hazard register; ~205 site risk assessments
Owner: Customer Safety / HSE (VS-24) / Risk (VS-21)
Participants: HSE (VS-24), Store Ops (VS-07), IFM (VS-138), Risk (VS-21.2), Insurance (VS-26)
Source: workflow W4386 — Customer Safety Standards, Hazard Register &amp; Risk Assessment</bpmn:documentation>
      <bpmn:laneSet id="W4386_LaneSet3">
        <bpmn:lane id="W4386_Lane1" name="Customer Safety">
        <bpmn:flowNodeRef>W4386_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4386_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4386_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4386_Lane2" name="HSE">
        <bpmn:flowNodeRef>W4386_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4386_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4386_Start4" name="Strategy (W4385); new hazard; incident learning">
        <bpmn:outgoing>W4386_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4386_Task5" name="Customer Safety/HSE build the customer hazard register — slip/trip/fall…">
        <bpmn:documentation>Step 1: Customer Safety/HSE build the customer hazard register — slip/trip/fall, falling stock, shifted pallets, powered-equipment contact, chemical exposure, sharp/cut, parking, crowd, child — per zone and per merchandise type
Responsible (R): Customer Safety / HSE
Accountable (A): Head of Customer Safety
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4386_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4386_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4386_Task6" name="Customer Safety conduct site risk assessments (likelihood × severity ×…">
        <bpmn:documentation>Step 2: Customer Safety conduct site risk assessments (likelihood × severity × exposure), define the mandatory control set per hazard (engineering/administrative/PPE/signage), and set inspection frequency
Responsible (R): Customer Safety / HSE / Store Ops
Accountable (A): Head of Customer Safety / COO
Duration: Annual + per site</bpmn:documentation>
        <bpmn:incoming>W4386_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4386_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4386_Task7" name="HSE/Store Ops publish the standards, train store teams (W4406), and review on…">
        <bpmn:documentation>Step 3: HSE/Store Ops publish the standards, train store teams (W4406), and review on incident learning (W4402) or change
Responsible (R): HSE / Store Ops
Accountable (A): COO / Head of Customer Safety
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4386_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4386_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4386_End8" name="Complete">
        <bpmn:incoming>W4386_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4386_Annotation9">
        <bpmn:text>Controls: - CTL-164 (ensure customer safety &amp; premises-liability control.) | - CTL-671: hazard register maintained; risk-assessed per site; controls field-verified (W4393/W4407); reviewed on incident
Owner: Customer Safety / HSE (VS-24) / Risk (VS-21)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4386_Assoc10" sourceRef="W4386_Annotation9" targetRef="W4386_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4386_Flow11" sourceRef="W4386_Start4" targetRef="W4386_Task5" />
      <bpmn:sequenceFlow id="W4386_Flow12" sourceRef="W4386_Task5" targetRef="W4386_Task6" />
      <bpmn:sequenceFlow id="W4386_Flow13" sourceRef="W4386_Task6" targetRef="W4386_Task7" />
      <bpmn:sequenceFlow id="W4386_Flow14" sourceRef="W4386_Task7" targetRef="W4386_End8" />
    </bpmn:process>
