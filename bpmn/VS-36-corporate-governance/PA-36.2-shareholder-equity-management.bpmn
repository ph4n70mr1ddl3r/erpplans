    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1723" name="W1723. Annual Stockholders&#x27; Meeting Preparation &amp; Conduct" isExecutable="false">
      <bpmn:documentation>Trigger: Annual requirement per Revised Corporation Code
Frequency: Annual (5 entities × 1 meeting = 5 meetings; typically held consecutively on the same day)
Volume: 5 meetings/year
Owner: Corporate Secretary
Participants: Corporate Secretary, Board Chair, CEO, CFO, Stockholders, External Auditor
Source: workflow W1723 — Annual Stockholders&#x27; Meeting Preparation &amp; Conduct</bpmn:documentation>
      <bpmn:laneSet id="W1723_LaneSet3">
        <bpmn:lane id="W1723_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1723_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1723_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1723_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1723_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1723_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1723_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1723_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1723_Start4" name="Annual requirement per Revised Corporation Code">
        <bpmn:outgoing>W1723_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1723_Task5" name="Corporate Secretary prepares meeting notice: (a) date, time, venue (or virtual…">
        <bpmn:documentation>Step 1: Corporate Secretary prepares meeting notice: (a) date, time, venue (or virtual meeting platform), (b) agenda items per Revised Corporation Code requirements: (i) election of directors, (ii) approval of previous year&#x27;s financial statements, (iii) appointment of external auditor, (iv) declaration of dividends (if any), (v) other matters requiring stockholder approval, (c) notice distributed to all stockholders minimum 21 days before meeting per by-laws (or per Revised Corporation Code)
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1723_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1723_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1723_Task6" name="CFO and External Auditor prepare financial statement package for stockholder…">
        <bpmn:documentation>Step 2: CFO and External Auditor prepare financial statement package for stockholder review: (a) audited balance sheet, income statement, cash flow statement, statement of changes in equity, (b) notes to financial statements, (c) external auditor&#x27;s report (opinion)
Responsible (R): CFO / External Auditor
Accountable (A): Board
Duration: Part of annual close</bpmn:documentation>
        <bpmn:incoming>W1723_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1723_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1723_Task7" name="Stockholders&#x27; meeting conducted: (a) Corporate Secretary confirms quorum…">
        <bpmn:documentation>Step 3: Stockholders&#x27; meeting conducted: (a) Corporate Secretary confirms quorum (majority of outstanding shares per by-laws), (b) each agenda item presented and voted upon, (c) election of directors (if applicable), (d) stockholder questions addressed, (e) minutes recorded per W1716 process
Responsible (R): Corporate Secretary
Accountable (A): Board Chair
Duration: 1–3 hours</bpmn:documentation>
        <bpmn:incoming>W1723_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1723_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1723_Task8" name="Post-meeting: Corporate Secretary files SEC GIS within 30 days, processes any…">
        <bpmn:documentation>Step 4: Post-meeting: Corporate Secretary files SEC GIS within 30 days, processes any stockholder-approved actions (dividend payment, director elections, auditor appointment)
Responsible (R): Corporate Secretary
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1723_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1723_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1723_End9" name="Complete">
        <bpmn:incoming>W1723_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1723_Annotation10">
        <bpmn:text>Controls: - CTL-350 (ensure controlled execution — Shareholder &amp; Equity Management (PA-36.2).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1723_Assoc11" sourceRef="W1723_Annotation10" targetRef="W1723_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1723_Flow12" sourceRef="W1723_Start4" targetRef="W1723_Task5" />
      <bpmn:sequenceFlow id="W1723_Flow13" sourceRef="W1723_Task5" targetRef="W1723_Task6" />
      <bpmn:sequenceFlow id="W1723_Flow14" sourceRef="W1723_Task6" targetRef="W1723_Task7" />
      <bpmn:sequenceFlow id="W1723_Flow15" sourceRef="W1723_Task7" targetRef="W1723_Task8" />
      <bpmn:sequenceFlow id="W1723_Flow16" sourceRef="W1723_Task8" targetRef="W1723_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1723_diag">
      <bpmndi:BPMNPlane id="W1723_plane" bpmnElement="W_W1723">
        <bpmndi:BPMNShape id="W1723_Lane1_di" bpmnElement="W1723_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Lane2_di" bpmnElement="W1723_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Task5_di" bpmnElement="W1723_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Task6_di" bpmnElement="W1723_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Task7_di" bpmnElement="W1723_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Task8_di" bpmnElement="W1723_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Start4_di" bpmnElement="W1723_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_End9_di" bpmnElement="W1723_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1723_Annotation10_di" bpmnElement="W1723_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1723_Flow12_di" bpmnElement="W1723_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1723_Flow13_di" bpmnElement="W1723_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1723_Flow14_di" bpmnElement="W1723_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1723_Flow15_di" bpmnElement="W1723_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1723_Flow16_di" bpmnElement="W1723_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1723_Assoc11_di" bpmnElement="W1723_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1724" name="W1724. Stock Transfer &amp; Ownership Change Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Stockholder wishes to sell, gift, or otherwise transfer shares
Frequency: ~5–10 transfers/year (family corporation with limited activity)
Volume: Low volume but legally significant
Owner: Corporate Secretary
Participants: Corporate Secretary, Transferor, Transferee, Legal Counsel, Board
Source: workflow W1724 — Stock Transfer &amp; Ownership Change Processing</bpmn:documentation>
      <bpmn:laneSet id="W1724_LaneSet3">
        <bpmn:lane id="W1724_Lane1" name="Transferor">
        <bpmn:flowNodeRef>W1724_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1724_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1724_Lane2" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1724_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1724_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1724_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1724_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1724_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1724_Start4" name="Stockholder wishes to sell, gift, or otherwise transfer shares">
        <bpmn:outgoing>W1724_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1724_Task5" name="Transferor notifies Corporate Secretary of intent to transfer shares: (a)…">
        <bpmn:documentation>Step 1: Transferor notifies Corporate Secretary of intent to transfer shares: (a) provides stock certificate(s) for cancellation, (b) identifies transferee, (c) provides transfer documentation (deed of sale, donation, or inheritance documents)
Responsible (R): Transferor
Accountable (A): Corporate Secretary
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1724_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1724_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1724_Task6" name="Corporate Secretary verifies: (a) transferor is registered stockholder of the…">
        <bpmn:documentation>Step 2: Corporate Secretary verifies: (a) transferor is registered stockholder of the shares, (b) shares are not subject to lien, pledge, or lock-up, (c) transfer complies with by-laws (right of first refusal, board approval requirements), (d) transferee is qualified to hold shares (if by-laws impose restrictions)
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1724_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1724_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1724_Task7" name="Board approval (if required by by-laws): Corporate Secretary presents transfer…">
        <bpmn:documentation>Step 3: Board approval (if required by by-laws): Corporate Secretary presents transfer request to board; board approves or exercises right of first refusal (existing stockholders may have preemptive right to purchase shares before external transfer)
Responsible (R): Corporate Secretary
Accountable (A): Board
Duration: At next board meeting</bpmn:documentation>
        <bpmn:incoming>W1724_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1724_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1724_Task8" name="Corporate Secretary processes transfer: (a) cancels old stock certificate, (b)…">
        <bpmn:documentation>Step 4: Corporate Secretary processes transfer: (a) cancels old stock certificate, (b) issues new certificate to transferee, (c) updates stock ledger (removes from transferor, adds to transferee), (d) records transfer date, consideration (if disclosed), and supporting document reference
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1724_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1724_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1724_Task9" name="Tax compliance: (a) transfer subject to documentary stamp tax (DST) per NIRC —…">
        <bpmn:documentation>Step 5: Tax compliance: (a) transfer subject to documentary stamp tax (DST) per NIRC — Corporate Secretary ensures DST payment to BIR, (b) if transfer is sale: capital gains tax implications for transferor, (c) if transfer is donation: donor&#x27;s tax may apply, (d) Corporate Secretary maintains DST-proof documentation
Responsible (R): Corporate Secretary / Tax Accountant
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1724_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1724_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1724_End10" name="Complete">
        <bpmn:incoming>W1724_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1724_Annotation11">
        <bpmn:text>Controls: - CTL-350 (ensure controlled execution — Shareholder &amp; Equity Management (PA-36.2).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1724_Assoc12" sourceRef="W1724_Annotation11" targetRef="W1724_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1724_Flow13" sourceRef="W1724_Start4" targetRef="W1724_Task5" />
      <bpmn:sequenceFlow id="W1724_Flow14" sourceRef="W1724_Task5" targetRef="W1724_Task6" />
      <bpmn:sequenceFlow id="W1724_Flow15" sourceRef="W1724_Task6" targetRef="W1724_Task7" />
      <bpmn:sequenceFlow id="W1724_Flow16" sourceRef="W1724_Task7" targetRef="W1724_Task8" />
      <bpmn:sequenceFlow id="W1724_Flow17" sourceRef="W1724_Task8" targetRef="W1724_Task9" />
      <bpmn:sequenceFlow id="W1724_Flow18" sourceRef="W1724_Task9" targetRef="W1724_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1724_diag">
      <bpmndi:BPMNPlane id="W1724_plane" bpmnElement="W_W1724">
        <bpmndi:BPMNShape id="W1724_Lane1_di" bpmnElement="W1724_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1724_Lane2_di" bpmnElement="W1724_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1724_Task5_di" bpmnElement="W1724_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1724_Task6_di" bpmnElement="W1724_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1724_Task7_di" bpmnElement="W1724_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
