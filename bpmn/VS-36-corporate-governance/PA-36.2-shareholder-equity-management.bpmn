        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1727_Start4" name="Board decision, resignation, retirement, or removal of officer or director">
        <bpmn:outgoing>W1727_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1727_Task5" name="Officer change triggered by: (a) board appointment (new hire or promotion), (b)…">
        <bpmn:documentation>Step 1: Officer change triggered by: (a) board appointment (new hire or promotion), (b) resignation (written notice), (c) removal (board action with cause), (d) death or incapacity
Responsible (R): Corporate Secretary
Accountable (A): Board Chair / CEO
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1727_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1727_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1727_Task6" name="Board passes resolution appointing/removing officer per W1717; for directors…">
        <bpmn:documentation>Step 2: Board passes resolution appointing/removing officer per W1717; for directors: stockholder election or board action to fill vacancy per by-laws
Responsible (R): Board
Accountable (A): Board Chair
Duration: At board meeting or written consent</bpmn:documentation>
        <bpmn:incoming>W1727_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1727_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1727_Task7" name="Corporate Secretary updates records: (a) officer/director register, (b) stock…">
        <bpmn:documentation>Step 3: Corporate Secretary updates records: (a) officer/director register, (b) stock ledger (if officer is also stockholder), (c) bank signatory cards (for officer changes affecting banking authority), (d) SEC GIS (updated at next filing), (e) BIR registration (for authorized representatives), (f) internal authorization matrices (system access, approval limits)
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1727_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1727_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1727_Task8" name="Incoming officer: (a) receives orientation on corporate governance…">
        <bpmn:documentation>Step 4: Incoming officer: (a) receives orientation on corporate governance responsibilities, (b) signs acceptance letter, (c) updates bio on file, (d) added to bank signatory panel (if applicable), (e) system access configured per role
Responsible (R): Corporate Secretary / IT / Treasury
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1727_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1727_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1727_End9" name="Complete">
        <bpmn:incoming>W1727_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1727_Annotation10">
        <bpmn:text>Controls: - CTL-350 (ensure controlled execution — Shareholder &amp; Equity Management (PA-36.2).) | - operational: Corporate Secretary review and approval gate
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
