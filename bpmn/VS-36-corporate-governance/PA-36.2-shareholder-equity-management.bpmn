        <bpmndi:BPMNShape id="W1722_End9_di" bpmnElement="W1722_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1722_Annotation10_di" bpmnElement="W1722_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
