<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-36.2-shareholder-equity-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1722" name="W1722. Stock &amp; Transfer Ledger Management" isExecutable="false">
      <bpmn:documentation>Trigger: Stock issuance, transfer, or periodic reconciliation
Frequency: Continuous for transactions; monthly reconciliation
Volume: ~10–20 stock transactions/year (family corporation with limited transfers)
Owner: Corporate Secretary
Participants: Corporate Secretary, Stockholder, CFO, Legal Counsel
Source: workflow W1722 — Stock &amp; Transfer Ledger Management</bpmn:documentation>
      <bpmn:laneSet id="W1722_LaneSet3">
        <bpmn:lane id="W1722_Lane1" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1722_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1722_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1722_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1722_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1722_Lane2" name="System">
        <bpmn:flowNodeRef>W1722_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1722_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1722_Start4" name="Stock issuance, transfer, or periodic reconciliation">
        <bpmn:outgoing>W1722_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1722_Task5" name="Corporate Secretary maintains stock and transfer ledger for each of the 5…">
        <bpmn:documentation>Step 1: Corporate Secretary maintains stock and transfer ledger for each of the 5 entities: (a) stockholder name, address, TIN, (b) number of shares held, certificate numbers, (c) date of acquisition, (d) par value and total subscribed/paid-in capital, (e) pledges, liens, or encumbrances, (f) transfer history
Responsible (R): Corporate Secretary
Accountable (A): Legal Counsel
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1722_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1722_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1722_Task6" name="System maintains electronic stock ledger with: (a) automatic totaling of shares…">
        <bpmn:documentation>Step 2: System maintains electronic stock ledger with: (a) automatic totaling of shares outstanding per entity, (b) ownership percentage calculation, (c) link to SEC GIS filing data, (d) audit trail of all changes, (e) segregation by share class (if multiple classes exist)
Responsible (R): System
Accountable (A): Corporate Secretary
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1722_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1722_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1722_Task7" name="Monthly: Corporate Secretary reconciles stock ledger with: (a) equity accounts…">
        <bpmn:documentation>Step 3: Monthly: Corporate Secretary reconciles stock ledger with: (a) equity accounts in GL per entity (total shares outstanding × par value = issued capital stock in GL), (b) SEC registration records, (c) physical stock certificates on hand (if certificated shares)
Responsible (R): Corporate Secretary
Accountable (A): CFO
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1722_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1722_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1722_Task8" name="Annual: Stock ledger extract provided to External Auditor for confirmation of…">
        <bpmn:documentation>Step 4: Annual: Stock ledger extract provided to External Auditor for confirmation of equity balances and ownership as part of annual audit
Responsible (R): Corporate Secretary
Accountable (A): External Auditor
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1722_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1722_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1722_End9" name="Complete">
        <bpmn:incoming>W1722_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1722_Annotation10">
        <bpmn:text>Controls: - CTL-350 (ensure controlled execution — Shareholder &amp; Equity Management (PA-36.2).) | - operational: periodic reconciliation against source documents
Owner: Corporate Secretary</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1722_Assoc11" sourceRef="W1722_Annotation10" targetRef="W1722_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1722_Flow12" sourceRef="W1722_Start4" targetRef="W1722_Task5" />
      <bpmn:sequenceFlow id="W1722_Flow13" sourceRef="W1722_Task5" targetRef="W1722_Task6" />
      <bpmn:sequenceFlow id="W1722_Flow14" sourceRef="W1722_Task6" targetRef="W1722_Task7" />
      <bpmn:sequenceFlow id="W1722_Flow15" sourceRef="W1722_Task7" targetRef="W1722_Task8" />
      <bpmn:sequenceFlow id="W1722_Flow16" sourceRef="W1722_Task8" targetRef="W1722_End9" />
    </bpmn:process>
