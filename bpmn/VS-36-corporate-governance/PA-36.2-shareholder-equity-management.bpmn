    <bpmn:process id="W_W1725" name="W1725. Dividend Declaration &amp; Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: Board decision to declare dividend based on retained earnings and cash availability
Frequency: Annual or semi-annual (board discretion)
Volume: 1–2 dividend declarations/year
Owner: CFO
Participants: CFO, Corporate Secretary, Treasury, Stockholders
Source: workflow W1725 — Dividend Declaration &amp; Distribution</bpmn:documentation>
      <bpmn:laneSet id="W1725_LaneSet5">
        <bpmn:lane id="W1725_Lane1" name="CFO">
        <bpmn:flowNodeRef>W1725_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1725_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1725_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1725_Lane2" name="Board">
        <bpmn:flowNodeRef>W1725_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1725_Lane3" name="Corporate Secretary">
        <bpmn:flowNodeRef>W1725_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1725_Lane4" name="Treasury">
        <bpmn:flowNodeRef>W1725_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1725_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1725_Start6" name="Board decision to declare dividend based on retained earnings and cash availability">
        <bpmn:outgoing>W1725_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1725_Task7" name="CFO prepares dividend proposal for board: (a) available retained earnings per…">
        <bpmn:documentation>Step 1: CFO prepares dividend proposal for board: (a) available retained earnings per latest audited financial statements, (b) cash position and liquidity assessment, (c) proposed dividend rate (per share or as percentage of par value), (d) total dividend amount, (e) record date (determines which stockholders receive dividend), (f) payment date, (g) withholding tax implications (10% final withholding tax on cash dividends per Philippine tax law)
Responsible (R): CFO
Accountable (A): CEO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1725_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1725_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1725_Task8" name="Board approves dividend declaration; Corporate Secretary records resolution per…">
        <bpmn:documentation>Step 2: Board approves dividend declaration; Corporate Secretary records resolution per W1717
Responsible (R): Board
Accountable (A): Board Chair
Duration: At board meeting</bpmn:documentation>
        <bpmn:incoming>W1725_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1725_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1725_Task9" name="Corporate Secretary determines stockholders entitled to dividend as of record…">
        <bpmn:documentation>Step 3: Corporate Secretary determines stockholders entitled to dividend as of record date; calculates dividend per stockholder based on shares held
Responsible (R): Corporate Secretary
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1725_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1725_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1725_Task10" name="Treasury processes dividend payment: (a) bank transfer to each stockholder, (b)…">
        <bpmn:documentation>Step 4: Treasury processes dividend payment: (a) bank transfer to each stockholder, (b) 10% withholding tax remitted to BIR (BIR Form 1601-FQ, quarterly remittance of final withholding taxes), (c) stockholder receives net dividend and final tax withheld certificate (BIR Form 2306), (d) system records dividend payment in equity accounts: debit retained earnings, credit cash (net of WHT)
Responsible (R): Treasury / CFO
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1725_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1725_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1725_Task11" name="Tax filing: CFO includes dividend withholding in the quarterly BIR Form 1601-FQ…">
        <bpmn:documentation>Step 5: Tax filing: CFO includes dividend withholding in the quarterly BIR Form 1601-FQ filing; provides stockholders with final tax withheld certificates (BIR Form 2306) for their individual income tax returns
Responsible (R): CFO / Tax Accountant
Accountable (A): —
Duration: Part of quarterly filing</bpmn:documentation>
        <bpmn:incoming>W1725_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1725_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1725_End12" name="Complete">
        <bpmn:incoming>W1725_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1725_Annotation13">
        <bpmn:text>Controls: - CTL-350 (ensure controlled execution — Shareholder &amp; Equity Management (PA-36.2).) | - operational: CFO review and approval gate
Owner: CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1725_Assoc14" sourceRef="W1725_Annotation13" targetRef="W1725_Start6" associationDirection="None" />
