    <bpmn:process id="W_W2240" name="W2240. In-Store Coupon Printing &amp; Display" isExecutable="false">
      <bpmn:documentation>Trigger: Physical coupon campaign
Frequency: ~6 major campaigns/year
Volume: ~600K physical coupons/campaign
Owner: Marketing Operations Manager
Participants: Marketing Ops Mgr, VP Marketing
Source: workflow W2240 — In-Store Coupon Printing &amp; Display</bpmn:documentation>
      <bpmn:laneSet id="W2240_LaneSet2">
        <bpmn:lane id="W2240_Lane1" name="Marketing Ops Mgr">
        <bpmn:flowNodeRef>W2240_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2240_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2240_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2240_Start3" name="Physical coupon campaign">
        <bpmn:outgoing>W2240_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2240_Task4" name="Marketing Ops Manager coordinates physical coupon production and in-store…">
        <bpmn:documentation>Step 1: Marketing Ops Manager coordinates physical coupon production and in-store display: print, distribute to stores, display at entrance/aisle/checkout; tracks pickup and redemption
Responsible (R): Marketing Ops Mgr
Accountable (A): VP Marketing
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2240_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2240_End5" name="Complete">
        <bpmn:incoming>W2240_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2240_Annotation6">
        <bpmn:text>Controls: - CTL-198: print/display-asset tracking; operational: Marketing Ops Manager display-compliance sign-off
Owner: Marketing Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2240_Assoc7" sourceRef="W2240_Annotation6" targetRef="W2240_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2240_Flow8" sourceRef="W2240_Start3" targetRef="W2240_Task4" />
