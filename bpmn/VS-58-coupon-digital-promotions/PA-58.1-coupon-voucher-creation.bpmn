    <bpmn:process id="W_W2243" name="W2243. Loyalty Point Multiplier Campaign" isExecutable="false">
      <bpmn:documentation>Trigger: Loyalty campaign (double/triple points)
Frequency: ~6–8/year
Volume: ~600K members per campaign
Owner: Loyalty Program Manager
Participants: Loyalty Program Mgr, VP Marketing
Source: workflow W2243 — Loyalty Point Multiplier Campaign</bpmn:documentation>
      <bpmn:laneSet id="W2243_LaneSet2">
        <bpmn:lane id="W2243_Lane1" name="Loyalty Program Mgr">
        <bpmn:flowNodeRef>W2243_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2243_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2243_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2243_Start3" name="Loyalty campaign (double/triple points)">
        <bpmn:outgoing>W2243_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2243_Task4" name="Loyalty Program Manager configures the point-multiplier campaign (2x/3x points…">
        <bpmn:documentation>Step 1: Loyalty Program Manager configures the point-multiplier campaign (2x/3x points on eligible categories/days); communicates to the ~600K members; tracks the incremental basket and the loyalty-liability impact
Responsible (R): Loyalty Program Mgr
Accountable (A): VP Marketing
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2243_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2243_End5" name="Complete">
        <bpmn:incoming>W2243_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2243_Annotation6">
        <bpmn:text>Controls: - CTL-403 (ensure controlled execution — Coupon &amp; Voucher Creation &amp; Distribution (PA-58.1).) | - CTL-403 (loyalty-liability accuracy — links to VS-13 / W104); operational: VP Marketing sign-off
Owner: Loyalty Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2243_Assoc7" sourceRef="W2243_Annotation6" targetRef="W2243_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2243_Flow8" sourceRef="W2243_Start3" targetRef="W2243_Task4" />
      <bpmn:sequenceFlow id="W2243_Flow9" sourceRef="W2243_Task4" targetRef="W2243_End5" />
    </bpmn:process>
