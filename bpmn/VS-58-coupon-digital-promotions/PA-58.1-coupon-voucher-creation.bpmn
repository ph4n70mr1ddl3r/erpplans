    <bpmn:process id="W_W2242" name="W2242. Vendor-Funded Coupon Program" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor co-op promotional funding
Frequency: ~10–15 vendor-funded promos/year
Volume: ~10–15/year
Owner: Category Manager
Participants: Finance, VP Merchandising
Source: workflow W2242 — Vendor-Funded Coupon Program</bpmn:documentation>
      <bpmn:laneSet id="W2242_LaneSet2">
        <bpmn:lane id="W2242_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2242_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2242_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2242_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2242_Start3" name="Vendor co-op promotional funding">
        <bpmn:outgoing>W2242_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2242_Task4" name="Category Manager negotiates vendor-funded coupons: vendor funds the discount on…">
        <bpmn:documentation>Step 1: Category Manager negotiates vendor-funded coupons: vendor funds the discount on their products; terms recorded in the co-op agreement; Finance tracks the vendor reimbursement
Responsible (R): Category Manager / Finance
Accountable (A): VP Merchandising
Duration: Per promo</bpmn:documentation>
        <bpmn:incoming>W2242_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2242_End5" name="Complete">
        <bpmn:incoming>W2242_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2242_Annotation6">
        <bpmn:text>Controls: - CTL-39: co-op/rebate accuracy; CTL-48 (rebate-dispute resolution); operational: VP Merchandising sign-off
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2242_Assoc7" sourceRef="W2242_Annotation6" targetRef="W2242_Start3" associationDirection="None" />
