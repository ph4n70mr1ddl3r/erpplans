    <bpmn:process id="W_W2241" name="W2241. Coupon Budget &amp; Liability Management" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign launch
Frequency: ~18/year
Volume: ~PHP 50–100M annual promo budget
Owner: Finance Manager
Participants: CFO
Source: workflow W2241 — Coupon Budget &amp; Liability Management</bpmn:documentation>
      <bpmn:laneSet id="W2241_LaneSet2">
        <bpmn:lane id="W2241_Lane1" name="Finance Manager">
        <bpmn:flowNodeRef>W2241_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2241_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2241_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2241_Start3" name="Campaign launch">
        <bpmn:outgoing>W2241_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2241_Task4" name="Finance Manager sets the coupon budget per campaign; tracks the coupon…">
        <bpmn:documentation>Step 1: Finance Manager sets the coupon budget per campaign; tracks the coupon liability (unredeemed coupons as a PFRS 15 liability); monitors the redemption rate vs. budget; flags over-budget campaigns
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: Per campaign + monthly</bpmn:documentation>
        <bpmn:incoming>W2241_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2241_End5" name="Complete">
        <bpmn:incoming>W2241_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2241_Annotation6">
        <bpmn:text>Controls: - CTL-403 (coupon-liability accuracy — links to VS-157); CTL-44 (issued-count integrity); operational: CFO monthly sign-off
Owner: Finance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2241_Assoc7" sourceRef="W2241_Annotation6" targetRef="W2241_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2241_Flow8" sourceRef="W2241_Start3" targetRef="W2241_Task4" />
      <bpmn:sequenceFlow id="W2241_Flow9" sourceRef="W2241_Task4" targetRef="W2241_End5" />
    </bpmn:process>
