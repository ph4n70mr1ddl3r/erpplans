    <bpmn:process id="W_W2239" name="W2239. Digital Voucher Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: Campaign launch via digital channels
Frequency: ~18 campaigns/year + ad-hoc
Volume: ~500K–1M vouchers/year
Owner: Digital Marketing Manager
Participants: Digital Marketing Mgr, VP Marketing
Source: workflow W2239 — Digital Voucher Distribution</bpmn:documentation>
      <bpmn:laneSet id="W2239_LaneSet2">
        <bpmn:lane id="W2239_Lane1" name="Digital Marketing Mgr">
        <bpmn:flowNodeRef>W2239_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2239_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2239_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2239_Start3" name="Campaign launch via digital channels">
        <bpmn:outgoing>W2239_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2239_Task4" name="Digital Marketing Manager distributes vouchers via email, app push, SMS, social…">
        <bpmn:documentation>Step 1: Digital Marketing Manager distributes vouchers via email, app push, SMS, social media; targets segments per the campaign strategy; tracks distribution and claim rates
Responsible (R): Digital Marketing Mgr
Accountable (A): VP Marketing
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2239_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2239_End5" name="Complete">
        <bpmn:incoming>W2239_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2239_Annotation6">
        <bpmn:text>Controls: - CTL-403 (voucher-distribution authorization); CTL-44 (voucher-count integrity); operational: VP Marketing sign-off
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
