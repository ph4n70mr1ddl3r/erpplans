    <bpmn:process id="W_W2238" name="W2238. Coupon Design &amp; Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing campaign launch
Frequency: ~18 campaigns/year
Volume: ~18 designs/year
Owner: Marketing Promotions Manager
Participants: Marketing Promotions Mgr, VP Marketing
Source: workflow W2238 — Coupon Design &amp; Configuration</bpmn:documentation>
      <bpmn:laneSet id="W2238_LaneSet2">
        <bpmn:lane id="W2238_Lane1" name="Marketing Promotions Mgr">
        <bpmn:flowNodeRef>W2238_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2238_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2238_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2238_Start3" name="Marketing campaign launch">
        <bpmn:outgoing>W2238_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2238_Task4" name="Marketing Promotions Manager designs the coupon: discount type (PHP-off, %-off…">
        <bpmn:documentation>Step 1: Marketing Promotions Manager designs the coupon: discount type (PHP-off, %-off, BOGO), eligible SKUs/categories, min-spend, validity period, stacking rules, channel (POS/ecom/app), redemption limit per customer; configures in the promo-rule engine
Responsible (R): Marketing Promotions Mgr
Accountable (A): VP Marketing
Duration: 1–2 days/campaign</bpmn:documentation>
        <bpmn:incoming>W2238_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2238_End5" name="Complete">
        <bpmn:incoming>W2238_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2238_Annotation6">
        <bpmn:text>Controls: - CTL-196 (prevent coupon &amp; promo-code abuse.) | - CTL-403 (promo-rule authorization — links to VS-14); CTL-283 (DTI promo-permit compliance — review per W833); operational: VP Marketing sign-off
Owner: Marketing Promotions Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2238_Assoc7" sourceRef="W2238_Annotation6" targetRef="W2238_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2238_Flow8" sourceRef="W2238_Start3" targetRef="W2238_Task4" />
      <bpmn:sequenceFlow id="W2238_Flow9" sourceRef="W2238_Task4" targetRef="W2238_End5" />
    </bpmn:process>
