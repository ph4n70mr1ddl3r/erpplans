    <bpmn:process id="W_W2250" name="W2250. Coupon Return &amp; Reversal" isExecutable="false">
      <bpmn:documentation>Trigger: Customer returns item bought with coupon
Frequency: ~2K–3K/month
Volume: ~2K–3K/month
Owner: Customer Service Rep
Participants: CSA, Finance, CS Supervisor
Source: workflow W2250 — Coupon Return &amp; Reversal</bpmn:documentation>
      <bpmn:laneSet id="W2250_LaneSet2">
        <bpmn:lane id="W2250_Lane1" name="CSA">
        <bpmn:flowNodeRef>W2250_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2250_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2250_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2250_Start3" name="Customer returns item bought with coupon">
        <bpmn:outgoing>W2250_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2250_Task4" name="System processes the return: refunds the post-coupon price (not the full…">
        <bpmn:documentation>Step 1: System processes the return: refunds the post-coupon price (not the full price), reverses the coupon redemption (restores the coupon if still valid, or reduces the liability if expired), adjusts the vendor reimbursement if vendor-funded
Responsible (R): CSA / System / Finance
Accountable (A): CS Supervisor
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W2250_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2250_End5" name="Complete">
        <bpmn:incoming>W2250_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2250_Annotation6">
        <bpmn:text>Controls: - CTL-404 (ensure controlled execution — Coupon Redemption &amp; Fraud Prevention (PA-58.2).) | - operational: coupon-reversal integrity; CTL-179 (refunds/credits issued to original tender with exception approval); operational: CS Supervisor sign-off
Owner: Customer Service Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2250_Assoc7" sourceRef="W2250_Annotation6" targetRef="W2250_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2250_Flow8" sourceRef="W2250_Start3" targetRef="W2250_Task4" />
      <bpmn:sequenceFlow id="W2250_Flow9" sourceRef="W2250_Task4" targetRef="W2250_End5" />
    </bpmn:process>
