      <bpmn:documentation>Trigger: Customer claims digital coupon
Frequency: Per campaign
Volume: ~500K–1M claims/year
Owner: IT Integration Lead
Participants: CIO
Source: workflow W2252 — Digital Coupon Device &amp; Account Binding</bpmn:documentation>
      <bpmn:laneSet id="W2252_LaneSet2">
        <bpmn:lane id="W2252_Lane1" name="IT Integration Lead">
