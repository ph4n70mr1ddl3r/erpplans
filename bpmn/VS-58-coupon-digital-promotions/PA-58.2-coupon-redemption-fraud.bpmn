    <bpmn:process id="W_W2248" name="W2248. Multi-Coupon Stacking Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents multiple coupons
Frequency: ~5–10% of coupon transactions
Volume: ~5–10%
Owner: Cashier / POS System
Participants: Store Manager
Source: workflow W2248 — Multi-Coupon Stacking Management</bpmn:documentation>
      <bpmn:laneSet id="W2248_LaneSet2">
        <bpmn:lane id="W2248_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2248_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2248_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2248_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2248_Start3" name="Customer presents multiple coupons">
        <bpmn:outgoing>W2248_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2248_Task4" name="System evaluates stacking per the rules (stackable types, max-stack-count…">
        <bpmn:documentation>Step 1: System evaluates stacking per the rules (stackable types, max-stack-count, margin-floor); applies the allowed stack; blocks the disallowed with a clear reason; manager-override on exception
Responsible (R): Cashier / POS System
Accountable (A): Store Manager
Duration: 1–2 min</bpmn:documentation>
        <bpmn:incoming>W2248_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2248_End5" name="Complete">
        <bpmn:incoming>W2248_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2248_Annotation6">
        <bpmn:text>Controls: - CTL-404 (ensure controlled execution — Coupon Redemption &amp; Fraud Prevention (PA-58.2).) | - CTL-404 (stacking/margin guard — links to VS-57); operational: Store Manager override sign-off
Owner: Cashier / POS System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2248_Assoc7" sourceRef="W2248_Annotation6" targetRef="W2248_Start3" associationDirection="None" />
