    <bpmn:process id="W_W2251" name="W2251. Expired Coupon Exception Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents recently expired coupon
Frequency: ~500–1K/month
Volume: ~500–1K/month
Owner: Store Manager
Participants: Regional Ops Manager
Source: workflow W2251 — Expired Coupon Exception Handling</bpmn:documentation>
      <bpmn:laneSet id="W2251_LaneSet2">
        <bpmn:lane id="W2251_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2251_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2251_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2251_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2251_Start3" name="Customer presents recently expired coupon">
        <bpmn:outgoing>W2251_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2251_Task4" name="Cashier flags the expired coupon; Store Manager decides: honor as goodwill…">
        <bpmn:documentation>Step 1: Cashier flags the expired coupon; Store Manager decides: honor as goodwill (within a defined grace window, e.g., 7 days post-expiry), or decline; system applies if honored
Responsible (R): Store Manager
Accountable (A): Regional Ops Mgr
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W2251_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2251_End5" name="Complete">
        <bpmn:incoming>W2251_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2251_Annotation6">
        <bpmn:text>Controls: - CTL-404 (ensure controlled execution — Coupon Redemption &amp; Fraud Prevention (PA-58.2).) | - CTL-404 (coupon-expiry authorization); operational: Store Manager sign-off on beyond-grace honors
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2251_Assoc7" sourceRef="W2251_Annotation6" targetRef="W2251_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2251_Flow8" sourceRef="W2251_Start3" targetRef="W2251_Task4" />
      <bpmn:sequenceFlow id="W2251_Flow9" sourceRef="W2251_Task4" targetRef="W2251_End5" />
