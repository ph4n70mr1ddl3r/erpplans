    <bpmn:process id="W_W2249" name="W2249. Coupon Redemption Fraud Detection" isExecutable="false">
      <bpmn:documentation>Trigger: Real-time monitoring
Frequency: Real-time + weekly review
Volume: ~100–200 flagged/month
Owner: Loss Prevention Analyst
Participants: LP Analyst, Loss Prevention Mgr
Source: workflow W2249 — Coupon Redemption Fraud Detection</bpmn:documentation>
      <bpmn:laneSet id="W2249_LaneSet2">
        <bpmn:lane id="W2249_Lane1" name="System">
        <bpmn:flowNodeRef>W2249_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2249_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2249_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2249_Start3" name="Real-time monitoring">
        <bpmn:outgoing>W2249_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2249_Task4" name="System applies real-time fraud rules: velocity (rapid redemption from one…">
        <bpmn:documentation>Step 1: System applies real-time fraud rules: velocity (rapid redemption from one account/IP), unique-code reuse, counterfeit barcode, ineligible-SKU override; LP Analyst reviews flagged queue weekly; tunes rules
Responsible (R): System / LP Analyst
Accountable (A): Loss Prevention Mgr
Duration: Real-time + 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2249_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2249_End5" name="Complete">
        <bpmn:incoming>W2249_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2249_Annotation6">
        <bpmn:text>Controls: - CTL-404 (coupon-fraud — links to VS-125); CTL-44 (redemption integrity); operational: Loss Prevention Manager weekly sign-off
Owner: Loss Prevention Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2249_Assoc7" sourceRef="W2249_Annotation6" targetRef="W2249_Start3" associationDirection="None" />
