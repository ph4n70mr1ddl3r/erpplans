    <bpmn:process id="W_W2254" name="W2254. Campaign ROI Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Post-campaign
Frequency: Per campaign (~18/year)
Volume: 18 analyses/year
Owner: Marketing Analyst
Participants: VP Marketing
Source: workflow W2254 — Campaign ROI Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2254_LaneSet2">
        <bpmn:lane id="W2254_Lane1" name="Marketing Analyst">
        <bpmn:flowNodeRef>W2254_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2254_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2254_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2254_Start3" name="Post-campaign">
        <bpmn:outgoing>W2254_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2254_Task4" name="Marketing Analyst computes the campaign ROI: incremental sales vs. baseline…">
        <bpmn:documentation>Step 1: Marketing Analyst computes the campaign ROI: incremental sales vs. baseline, coupon cost, marketing cost, margin impact, new-customer acquisition; recommends next-campaign adjustments
Responsible (R): Marketing Analyst
Accountable (A): VP Marketing
Duration: 4–6 hours/campaign</bpmn:documentation>
        <bpmn:incoming>W2254_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2254_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2254_End5" name="Complete">
        <bpmn:incoming>W2254_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2254_Annotation6">
        <bpmn:text>Controls: - CTL-405 (ensure controlled execution — Digital Promotion Performance Analytics (PA-58.3).) | - CTL-405 (ROI-accuracy — links to VS-17); operational: VP Marketing sign-off
Owner: Marketing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2254_Assoc7" sourceRef="W2254_Annotation6" targetRef="W2254_Start3" associationDirection="None" />
