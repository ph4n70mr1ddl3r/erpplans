      </bpmn:startEvent>
      <bpmn:userTask id="W2255_Task4" name="Analyzes per-channel promo effectiveness: email, app, SMS, social; redemption…">
        <bpmn:documentation>Step 1: Analyzes per-channel promo effectiveness: email, app, SMS, social; redemption rate, cost-per-redemption, incremental sales, customer engagement by channel; recommends channel-mix adjustment
Responsible (R): Digital Marketing Mgr
Accountable (A): VP Marketing
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2255_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2255_Flow9</bpmn:outgoing>
