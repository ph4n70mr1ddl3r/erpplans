    <bpmn:process id="W_W2257" name="W2257. Promotion Halo Effect Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Post-major campaign
Frequency: 6/year
Volume: 6/year
Owner: Analytics Manager
Participants: VP Marketing
Source: workflow W2257 — Promotion Halo Effect Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2257_LaneSet2">
        <bpmn:lane id="W2257_Lane1" name="Analytics Manager">
        <bpmn:flowNodeRef>W2257_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2257_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2257_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2257_Start3" name="Post-major campaign">
        <bpmn:outgoing>W2257_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2257_Task4" name="Analytics Manager measures the halo effect: did the promo on Category A lift…">
        <bpmn:documentation>Step 1: Analytics Manager measures the halo effect: did the promo on Category A lift sales of non-promoted Category B (the halo)? Uses basket-analysis on the promo-period transactions
Responsible (R): Analytics Manager
Accountable (A): VP Marketing
Duration: 2–3 days/campaign</bpmn:documentation>
        <bpmn:incoming>W2257_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2257_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2257_End5" name="Complete">
        <bpmn:incoming>W2257_Flow9</bpmn:incoming>
      </bpmn:endEvent>
