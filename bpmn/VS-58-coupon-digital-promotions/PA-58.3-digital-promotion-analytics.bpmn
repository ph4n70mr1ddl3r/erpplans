      <bpmn:startEvent id="W2259_Start3" name="Monthly tech review">
        <bpmn:outgoing>W2259_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2259_Task4" name="IT Integration Lead monitors the 4 coupon-integration platforms (POS…">
        <bpmn:documentation>Step 1: IT Integration Lead monitors the 4 coupon-integration platforms (POS, ecommerce, app, CRM): API health, redemption latency, error rate, sync accuracy; identifies degradation and remediates
Responsible (R): IT Integration Lead
Accountable (A): CIO
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2259_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2259_Flow9</bpmn:outgoing>
