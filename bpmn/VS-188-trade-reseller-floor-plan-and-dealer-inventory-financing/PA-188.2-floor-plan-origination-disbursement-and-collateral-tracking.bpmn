      <bpmndi:BPMNPlane id="W5378_plane" bpmnElement="W_W5378">
        <bpmndi:BPMNShape id="W5378_Lane1_di" bpmnElement="W5378_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5378_Lane2_di" bpmnElement="W5378_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5378_Lane3_di" bpmnElement="W5378_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5378_Lane4_di" bpmnElement="W5378_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1370" height="170" /></bpmndi:BPMNShape>
