<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-188.2-floor-plan-origination-disbursement-and-collateral-tracking" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5377" name="W5377. Dealer Purchase/Floor-Plan Funding Request &amp; Loan Origination" isExecutable="false">
      <bpmn:documentation>Trigger: Dealer requests funding for a purchase/stocking order
Frequency: ~1–10 funding requests/dealer/month
Volume: ~10,000–40,000 originations/yr
Owner: Credit Analyst (Dealer Finance)
Participants: Dealer, Trade Account Manager, Credit Manager
Source: workflow W5377 — Dealer Purchase/Floor-Plan Funding Request &amp; Loan Origination</bpmn:documentation>
      <bpmn:laneSet id="W5377_LaneSet3">
        <bpmn:lane id="W5377_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5377_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5377_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5377_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5377_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5377_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5377_Lane2" name="Credit Manager">
        <bpmn:flowNodeRef>W5377_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5377_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5377_Start4" name="Dealer requests funding for a purchase/stocking order">
        <bpmn:outgoing>W5377_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5377_Task5" name="Receive the dealer&#x27;s funding request with the unit-level stocking list (SKU…">
        <bpmn:documentation>Step 1: Receive the dealer&#x27;s funding request with the unit-level stocking list (SKU, serial/VIN/lot, cost).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per request</bpmn:documentation>
        <bpmn:incoming>W5377_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5377_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5377_Task6" name="Verify against the dealer&#x27;s floor-plan limit and available headroom (W5370)…">
        <bpmn:documentation>Step 2: Verify against the dealer&#x27;s floor-plan limit and available headroom (W5370); check eligibility of categories.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per request</bpmn:documentation>
        <bpmn:incoming>W5377_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5377_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5377_Task7" name="Originate the floor-plan loan: principal, advance rate, curtailment schedule…">
        <bpmn:documentation>Step 3: Originate the floor-plan loan: principal, advance rate, curtailment schedule, rate (W5375), and RA 3765 disclosure (W5376).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per request</bpmn:documentation>
        <bpmn:incoming>W5377_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5377_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5377_Task8" name="Credit-decision per the authority matrix (CTL-12 separation); approve/decline…">
        <bpmn:documentation>Step 4: Credit-decision per the authority matrix (CTL-12 separation); approve/decline with documented reason.
Responsible (R): Credit Manager
Accountable (A): Credit Manager
Duration: per request</bpmn:documentation>
        <bpmn:incoming>W5377_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5377_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5377_Task9" name="Release to disbursement (W5378) and post the loan to the floor-plan ledger…">
        <bpmn:documentation>Step 5: Release to disbursement (W5378) and post the loan to the floor-plan ledger (W5379).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per request</bpmn:documentation>
        <bpmn:incoming>W5377_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5377_End10" name="Complete">
        <bpmn:incoming>W5377_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5377_Annotation11">
        <bpmn:text>Controls: - CTL-12: separate credit approval from sales; CTL-05 (prevent unauthorized credit-limit overrides); CTL-21 (origination accuracy).
Owner: Credit Analyst (Dealer Finance)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5377_Assoc12" sourceRef="W5377_Annotation11" targetRef="W5377_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5377_Flow13" sourceRef="W5377_Start4" targetRef="W5377_Task5" />
      <bpmn:sequenceFlow id="W5377_Flow14" sourceRef="W5377_Task5" targetRef="W5377_Task6" />
