    <bpmn:process id="W_W5378" name="W5378. Floor-Plan Disbursement to Vendor, Dual-Payee Check &amp; Supplier Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Approved origination (W5377)
Frequency: Per origination
Volume: ~10,000–40,000 disbursements/yr
Owner: Treasury/AP (Dealer Finance)
Participants: Supplier/Vendor, AP (VS-15), Finance
Source: workflow W5378 — Floor-Plan Disbursement to Vendor, Dual-Payee Check &amp; Supplier Settlement</bpmn:documentation>
      <bpmn:laneSet id="W5378_LaneSet5">
        <bpmn:lane id="W5378_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W5378_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5378_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5378_Lane2" name="AP">
        <bpmn:flowNodeRef>W5378_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5378_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5378_Lane3" name="Finance">
        <bpmn:flowNodeRef>W5378_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5378_Lane4" name="Credit Analyst">
        <bpmn:flowNodeRef>W5378_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5378_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5378_Start6" name="Approved origination (W5377)">
        <bpmn:outgoing>W5378_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5378_Task7" name="Generate the disbursement as a dual-payee instrument (BuildRight + dealer, or…">
        <bpmn:documentation>Step 1: Generate the disbursement as a dual-payee instrument (BuildRight + dealer, or BuildRight + supplier) to ensure funds reach the supplier/stock.
Responsible (R): Treasury/AP
Accountable (A): Credit Manager
Duration: per disbursement</bpmn:documentation>
        <bpmn:incoming>W5378_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5378_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5378_Task8" name="Pay the supplier directly (or the dealer against proof of purchase) per the…">
        <bpmn:documentation>Step 2: Pay the supplier directly (or the dealer against proof of purchase) per the floor-plan structure.
Responsible (R): AP
Accountable (A): Credit Manager
Duration: per disbursement</bpmn:documentation>
        <bpmn:incoming>W5378_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5378_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5378_Task9" name="Settle the supplier invoice (2-way/3-way match where applicable — VS-15) and…">
        <bpmn:documentation>Step 3: Settle the supplier invoice (2-way/3-way match where applicable — VS-15) and clear the payable.
Responsible (R): AP
Accountable (A): Credit Manager
Duration: per disbursement</bpmn:documentation>
        <bpmn:incoming>W5378_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5378_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5378_Task10" name="Post the disbursement to the floor-plan loan principal and the cash GL…">
        <bpmn:documentation>Step 4: Post the disbursement to the floor-plan loan principal and the cash GL (VS-17/VS-18).
Responsible (R): Finance
Accountable (A): Credit Manager
Duration: per disbursement</bpmn:documentation>
        <bpmn:incoming>W5378_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5378_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5378_Task11" name="Confirm unit receipt by the dealer (triggering collateral registration W5379).">
        <bpmn:documentation>Step 5: Confirm unit receipt by the dealer (triggering collateral registration W5379).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per disbursement</bpmn:documentation>
        <bpmn:incoming>W5378_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5378_End12" name="Complete">
        <bpmn:incoming>W5378_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5378_Annotation13">
        <bpmn:text>Controls: - CTL-14/CTL-44 (duplicate-invoice/payment guard); CTL-10 (separate payment initiation from approval); CTL-21 (posting accuracy).
Owner: Treasury/AP (Dealer Finance)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5378_Assoc14" sourceRef="W5378_Annotation13" targetRef="W5378_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W5378_Flow15" sourceRef="W5378_Start6" targetRef="W5378_Task7" />
      <bpmn:sequenceFlow id="W5378_Flow16" sourceRef="W5378_Task7" targetRef="W5378_Task8" />
