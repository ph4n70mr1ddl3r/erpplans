    <bpmn:process id="W_W5379" name="W5379. Unit-Level Collateral Registration, Serial/VIN Tracking &amp; Floor-Plan Ledger Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Dealer confirms unit receipt (W5378)
Frequency: Per funded unit/batch
Volume: ~50,000–200,000 funded units/yr
Owner: Credit Analyst (Dealer Finance)
Participants: Dealer, Collateral Registry, Finance
Source: workflow W5379 — Unit-Level Collateral Registration, Serial/VIN Tracking &amp; Floor-Plan Ledger Posting</bpmn:documentation>
      <bpmn:laneSet id="W5379_LaneSet3">
        <bpmn:lane id="W5379_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5379_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5379_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5379_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5379_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5379_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5379_Lane2" name="Finance">
        <bpmn:flowNodeRef>W5379_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5379_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5379_Start4" name="Dealer confirms unit receipt (W5378)">
        <bpmn:outgoing>W5379_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5379_Task5" name="Capture unit-level collateral identity: SKU, serial/VIN/lot, cost, dealer, and…">
        <bpmn:documentation>Step 1: Capture unit-level collateral identity: SKU, serial/VIN/lot, cost, dealer, and loan reference.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per unit</bpmn:documentation>
        <bpmn:incoming>W5379_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5379_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5379_Task6" name="Register the unit in the floor-plan/collateral ledger with BuildRight&#x27;s…">
        <bpmn:documentation>Step 2: Register the unit in the floor-plan/collateral ledger with BuildRight&#x27;s security interest (W5371).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per unit</bpmn:documentation>
        <bpmn:incoming>W5379_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5379_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5379_Task7" name="Post the funded unit to the dealer&#x27;s floor-plan loan balance (principal).">
        <bpmn:documentation>Step 3: Post the funded unit to the dealer&#x27;s floor-plan loan balance (principal).
Responsible (R): Finance
Accountable (A): Credit Manager
Duration: per unit</bpmn:documentation>
        <bpmn:incoming>W5379_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5379_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5379_Task8" name="Reconcile units funded ↔ disbursement ↔ supplier invoice ↔ dealer receipt.">
        <bpmn:documentation>Step 4: Reconcile units funded ↔ disbursement ↔ supplier invoice ↔ dealer receipt.
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per batch</bpmn:documentation>
        <bpmn:incoming>W5379_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5379_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5379_Task9" name="Enable unit-level curtailment tracking and OOT detection (W5382/W5385).">
        <bpmn:documentation>Step 5: Enable unit-level curtailment tracking and OOT detection (W5382/W5385).
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: per unit</bpmn:documentation>
        <bpmn:incoming>W5379_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5379_End10" name="Complete">
        <bpmn:incoming>W5379_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5379_Annotation11">
        <bpmn:text>Controls: - CTL-795 (ensure controlled execution — Loan Origination, Disbursement &amp; Inventory Collateral Tracking (PA-188.2).) | - operational: collateral-ledger accuracy; CTL-23 (OOT/fraud detection); CTL-26 (collateral registration).
Owner: Credit Analyst (Dealer Finance)</bpmn:text>
      </bpmn:textAnnotation>
