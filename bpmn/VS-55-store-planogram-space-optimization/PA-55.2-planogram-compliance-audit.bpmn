    <bpmn:process id="W_W2179" name="W2179. Fixture &amp; Display Equipment Inventory" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly; 200 stores
Frequency: Quarterly
Volume: ~200 fixture inventories/quarter
Owner: Store Manager
Participants: Store Manager, Facilities Coord, Merch Planner
Source: workflow W2179 — Fixture &amp; Display Equipment Inventory</bpmn:documentation>
      <bpmn:laneSet id="W2179_LaneSet3">
        <bpmn:lane id="W2179_Lane1" name="Store Staff">
        <bpmn:flowNodeRef>W2179_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2179_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2179_Lane2" name="Facilities Coord">
        <bpmn:flowNodeRef>W2179_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2179_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2179_Start4" name="Quarterly; 200 stores">
        <bpmn:outgoing>W2179_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2179_Task5" name="Store Manager inventories the fixtures (gondolas, pegboards, endcaps, specialty…">
        <bpmn:documentation>Step 1: Store Manager inventories the fixtures (gondolas, pegboards, endcaps, specialty displays); records the condition per fixture; photographs any damage; logs to the facility-asset register
Responsible (R): Store Staff
Accountable (A): Store Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2179_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2179_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2179_Task6" name="Facilities Coordinator reviews the repair/replacement needs by priority and…">
        <bpmn:documentation>Step 2: Facilities Coordinator reviews the repair/replacement needs by priority and budget; Merch Planner orders the new fixtures needed for the seasonal rotation (links to W2166)
Responsible (R): Facilities Coord / Merch Planner
Accountable (A): VP Store Operations
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2179_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2179_End7" name="Complete">
        <bpmn:incoming>W2179_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2179_Annotation8">
        <bpmn:text>Controls: - CTL-198: asset-grade fixture tracking; operational: Facilities Coordinator review of the quarterly inventory
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
