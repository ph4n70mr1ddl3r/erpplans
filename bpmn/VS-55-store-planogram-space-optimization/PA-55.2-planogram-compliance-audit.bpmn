    <bpmn:process id="W_W2180" name="W2180. Store Cleanliness &amp; Visual Standards Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly self-audit; monthly Regional audit
Frequency: Weekly + monthly
Volume: ~800 self + 200 Regional audits/month
Owner: Store Manager / Regional Ops Mgr
Participants: Store Manager, Regional Ops Mgr, Store Staff
Source: workflow W2180 — Store Cleanliness &amp; Visual Standards Audit</bpmn:documentation>
      <bpmn:laneSet id="W2180_LaneSet3">
        <bpmn:lane id="W2180_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2180_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2180_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2180_Lane2" name="Regional Ops Mgr">
        <bpmn:flowNodeRef>W2180_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2180_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2180_Start4" name="Weekly self-audit; monthly Regional audit">
        <bpmn:outgoing>W2180_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2180_Task5" name="Store Manager conducts the weekly visual walk (cleanliness, obstructions…">
        <bpmn:documentation>Step 1: Store Manager conducts the weekly visual walk (cleanliness, obstructions, lighting, signage condition); records issues with photos; resolves within 24 hours — a standing element of the VS-07 daily-ops cycle
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W2180_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2180_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2180_Task6" name="Regional Ops Manager conducts the monthly surprise audit using a 50-point…">
        <bpmn:documentation>Step 2: Regional Ops Manager conducts the monthly surprise audit using a 50-point scorecard (the VS-177 field-retail-standards rubric); results factor into the Store Manager performance review
Responsible (R): Regional Ops Mgr
Accountable (A): VP Store Operations
Duration: 45–60 min</bpmn:documentation>
        <bpmn:incoming>W2180_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2180_End7" name="Complete">
        <bpmn:incoming>W2180_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2180_Annotation8">
        <bpmn:text>Controls: - CTL-395 (ensure controlled execution — Planogram Compliance &amp; Audit (PA-55.2).) | - Operational: Regional Ops Manager monthly sign-off; scorecard calibration sessions quarterly
Owner: Store Manager / Regional Ops Mgr</bpmn:text>
      </bpmn:textAnnotation>
