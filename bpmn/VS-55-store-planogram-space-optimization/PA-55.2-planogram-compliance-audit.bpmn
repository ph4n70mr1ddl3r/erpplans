<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-55.2-planogram-compliance-audit" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2174" name="W2174. Planogram Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly per store
Frequency: Monthly; 200 stores
Volume: ~200 audits/month
Owner: Regional Operations Manager
Participants: Regional Ops Mgr, Store Manager, Merch Planner
Source: workflow W2174 — Planogram Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W2174_LaneSet2">
        <bpmn:lane id="W2174_Lane1" name="Regional Ops Mgr">
        <bpmn:flowNodeRef>W2174_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2174_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2174_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2174_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2174_Start3" name="Monthly per store">
        <bpmn:outgoing>W2174_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2174_Task4" name="Regional Ops Manager walks the store zone-by-zone comparing the actual shelf…">
        <bpmn:documentation>Step 1: Regional Ops Manager walks the store zone-by-zone comparing the actual shelf build to the current planogram (W2170 version); scores compliance on SKU position, facing count, label presence, and display execution per the W86 planogram-compliance standard
Responsible (R): Regional Ops Mgr
Accountable (A): VP Store Operations
Duration: 2–3 hours/store</bpmn:documentation>
        <bpmn:incoming>W2174_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2174_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2174_Task5" name="Photographs the non-compliant zones; uploads to the compliance system (links to…">
        <bpmn:documentation>Step 2: Photographs the non-compliant zones; uploads to the compliance system (links to VS-177 field-retail audit); Store Manager remediates within 48 hours; the monthly compliance scorecard feeds the Store Manager performance review (target ≥90%)
Responsible (R): Regional Ops Mgr / Store Manager
Accountable (A): VP Store Operations
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2174_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2174_End6" name="Complete">
        <bpmn:incoming>W2174_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2174_Annotation7">
        <bpmn:text>Controls: - CTL-51: planogram-master is the audit baseline; operational: Regional Ops Manager finding-closure sign-off
Owner: Regional Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2174_Assoc8" sourceRef="W2174_Annotation7" targetRef="W2174_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2174_Flow9" sourceRef="W2174_Start3" targetRef="W2174_Task4" />
      <bpmn:sequenceFlow id="W2174_Flow10" sourceRef="W2174_Task4" targetRef="W2174_Task5" />
      <bpmn:sequenceFlow id="W2174_Flow11" sourceRef="W2174_Task5" targetRef="W2174_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2174_diag">
      <bpmndi:BPMNPlane id="W2174_plane" bpmnElement="W_W2174">
        <bpmndi:BPMNShape id="W2174_Lane1_di" bpmnElement="W2174_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
