        <bpmndi:BPMNShape id="W2175_Task5_di" bpmnElement="W2175_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2175_Task6_di" bpmnElement="W2175_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2175_Start4_di" bpmnElement="W2175_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2175_End7_di" bpmnElement="W2175_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2175_Annotation8_di" bpmnElement="W2175_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2175_Flow10_di" bpmnElement="W2175_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2175_Flow11_di" bpmnElement="W2175_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2175_Flow12_di" bpmnElement="W2175_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2175_Assoc9_di" bpmnElement="W2175_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2176" name="W2176. Shelf Label &amp; Price Accuracy Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly or price change event
Frequency: Monthly per store + ad-hoc
Volume: ~200 audits/month + ad-hoc
Owner: Department Supervisor
Participants: Dept Supervisor, Store Manager, Pricing Analyst
Source: workflow W2176 — Shelf Label &amp; Price Accuracy Audit</bpmn:documentation>
      <bpmn:laneSet id="W2176_LaneSet3">
        <bpmn:lane id="W2176_Lane1" name="Department Supervisor">
        <bpmn:flowNodeRef>W2176_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2176_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2176_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2176_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2176_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2176_Start4" name="Monthly or price change event">
        <bpmn:outgoing>W2176_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2176_Task5" name="Supervisor audits the shelf labels against the system SRP using an RF gun…">
        <bpmn:documentation>Step 1: Supervisor audits the shelf labels against the system SRP using an RF gun: scans the label, the system shows the current SRP, any mismatch is flagged; checks for missing/damaged labels and promo-accuracy (the label matches the active promo per W262); corrects issues on the spot
Responsible (R): Department Supervisor
Accountable (A): Store Manager
Duration: 1–2 hours/section</bpmn:documentation>
        <bpmn:incoming>W2176_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2176_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2176_Task6" name="Store Manager reviews the monthly accuracy score (target ≥99%); below 97%…">
        <bpmn:documentation>Step 2: Store Manager reviews the monthly accuracy score (target ≥99%); below 97% triggers retraining (links to VS-19.4 L&amp;D) and a Pricing Analyst investigation into the price-file root cause
Responsible (R): Store Manager
Accountable (A): Regional Ops Mgr
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2176_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2176_End7" name="Complete">
        <bpmn:incoming>W2176_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2176_Annotation8">
        <bpmn:text>Controls: - CTL-195 (ensure planogram &amp; price-tag compliance.) | - CTL-395 (price-tag accuracy — links to VS-08 / W69, the price-compliance-audit control); operational: Store Manager monthly sign-off on the accuracy score
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2176_Assoc9" sourceRef="W2176_Annotation8" targetRef="W2176_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2176_Flow10" sourceRef="W2176_Start4" targetRef="W2176_Task5" />
      <bpmn:sequenceFlow id="W2176_Flow11" sourceRef="W2176_Task5" targetRef="W2176_Task6" />
      <bpmn:sequenceFlow id="W2176_Flow12" sourceRef="W2176_Task6" targetRef="W2176_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2176_diag">
      <bpmndi:BPMNPlane id="W2176_plane" bpmnElement="W_W2176">
        <bpmndi:BPMNShape id="W2176_Lane1_di" bpmnElement="W2176_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_Lane2_di" bpmnElement="W2176_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_Task5_di" bpmnElement="W2176_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_Task6_di" bpmnElement="W2176_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_Start4_di" bpmnElement="W2176_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_End7_di" bpmnElement="W2176_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2176_Annotation8_di" bpmnElement="W2176_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2176_Flow10_di" bpmnElement="W2176_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2176_Flow11_di" bpmnElement="W2176_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2176_Flow12_di" bpmnElement="W2176_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2176_Assoc9_di" bpmnElement="W2176_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2177" name="W2177. Endcap &amp; Promotional Display Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Promotional period start + mid-period
Frequency: ~12 checks/year × 200 stores
Volume: ~2,400 compliance checks/year
Owner: Merchandising Coordinator
Participants: Merch Coordinator, Store Manager, Marketing
Source: workflow W2177 — Endcap &amp; Promotional Display Compliance</bpmn:documentation>
      <bpmn:laneSet id="W2177_LaneSet2">
        <bpmn:lane id="W2177_Lane1" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2177_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2177_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2177_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2177_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2177_Start3" name="Promotional period start + mid-period">
        <bpmn:outgoing>W2177_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2177_Task4" name="Coordinator issues the display brief (the W2168 cross-merch or the W262 promo…">
        <bpmn:documentation>Step 1: Coordinator issues the display brief (the W2168 cross-merch or the W262 promo display spec); Store Manager sets up within 48 hours of the promo start and submits the photos; Coordinator reviews against the brief within 24 hours
Responsible (R): Merch Coordinator / Store Manager
Accountable (A): Marketing Manager
Duration: 4–6 hours/period</bpmn:documentation>
        <bpmn:incoming>W2177_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2177_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2177_Task5" name="Mid-period: verifies the display is maintained (restocked, clean, signage…">
        <bpmn:documentation>Step 2: Mid-period: verifies the display is maintained (restocked, clean, signage intact, not repurposed for other merchandise); flags depleted displays for replenishment per the promo-stock allocation
Responsible (R): Merch Coordinator
Accountable (A): VP Store Operations
Duration: 2–3 hours/period</bpmn:documentation>
        <bpmn:incoming>W2177_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2177_End6" name="Complete">
        <bpmn:incoming>W2177_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2177_Annotation7">
        <bpmn:text>Controls: - CTL-395 (ensure controlled execution — Planogram Compliance &amp; Audit (PA-55.2).) | - operational: promo/display spec currency; operational: Coordinator + Marketing joint review of compliance scores per promo
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2177_Assoc8" sourceRef="W2177_Annotation7" targetRef="W2177_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2177_Flow9" sourceRef="W2177_Start3" targetRef="W2177_Task4" />
      <bpmn:sequenceFlow id="W2177_Flow10" sourceRef="W2177_Task4" targetRef="W2177_Task5" />
      <bpmn:sequenceFlow id="W2177_Flow11" sourceRef="W2177_Task5" targetRef="W2177_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2177_diag">
      <bpmndi:BPMNPlane id="W2177_plane" bpmnElement="W_W2177">
        <bpmndi:BPMNShape id="W2177_Lane1_di" bpmnElement="W2177_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2177_Task4_di" bpmnElement="W2177_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2177_Task5_di" bpmnElement="W2177_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2177_Start3_di" bpmnElement="W2177_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2177_End6_di" bpmnElement="W2177_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2177_Annotation7_di" bpmnElement="W2177_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2177_Flow9_di" bpmnElement="W2177_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2177_Flow10_di" bpmnElement="W2177_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2177_Flow11_di" bpmnElement="W2177_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2177_Assoc8_di" bpmnElement="W2177_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2178" name="W2178. Store Walk-In Traffic &amp; Heatmap Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics from CCTV/counters
Frequency: Monthly; 200 stores
Volume: ~200 analyses/month
Owner: Analytics Manager
Participants: Analytics Manager, Store Design Mgr, Store Ops
Source: workflow W2178 — Store Walk-In Traffic &amp; Heatmap Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2178_LaneSet3">
        <bpmn:lane id="W2178_Lane1" name="System">
        <bpmn:flowNodeRef>W2178_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2178_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2178_Lane2" name="Analytics Manager">
        <bpmn:flowNodeRef>W2178_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2178_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2178_Start4" name="Monthly analytics from CCTV/counters">
        <bpmn:outgoing>W2178_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2178_Task5" name="System compiles the traffic data (visitor count, conversion, dwell time…">
        <bpmn:documentation>Step 1: System compiles the traffic data (visitor count, conversion, dwell time, peak-hour patterns) from the people-counters and CCTV analytics (where equipped); generates the heatmaps showing hot/cold zones and flow patterns
Responsible (R): System / Analytics Manager
Accountable (A): Store Design Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2178_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2178_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2178_Task6" name="Correlates with sales data; identifies high-traffic/low-conversion zones (an…">
        <bpmn:documentation>Step 2: Correlates with sales data; identifies high-traffic/low-conversion zones (an opportunity to fix conversion) and low-traffic/high-conversion zones (optimize access to capture more traffic)
Responsible (R): Analytics Manager
Accountable (A): VP Store Operations
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2178_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2178_End7" name="Complete">
        <bpmn:incoming>W2178_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2178_Annotation8">
        <bpmn:text>Controls: - CTL-395 (ensure controlled execution — Planogram Compliance &amp; Audit (PA-55.2).) | - CTL-395 (data-privacy — links to VS-91 / W53, RA 10173 compliance for any CCTV-analytics PII); operational: Analytics Manager methodology sign-off
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
