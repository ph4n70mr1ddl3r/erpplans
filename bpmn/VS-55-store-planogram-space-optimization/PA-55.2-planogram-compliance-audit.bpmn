        <bpmndi:BPMNShape id="W2174_End6_di" bpmnElement="W2174_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2174_Annotation7_di" bpmnElement="W2174_Annotation7"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2174_Flow9_di" bpmnElement="W2174_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2174_Flow10_di" bpmnElement="W2174_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2174_Flow11_di" bpmnElement="W2174_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2174_Assoc8_di" bpmnElement="W2174_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2175" name="W2175. Photo-Based Remote Compliance Check" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly photo submission
Frequency: Weekly from 200 stores
Volume: ~200 submissions/week
Owner: Merchandising Coordinator
Participants: Merch Coordinator, Store Manager, Regional Ops
Source: workflow W2175 — Photo-Based Remote Compliance Check</bpmn:documentation>
      <bpmn:laneSet id="W2175_LaneSet3">
        <bpmn:lane id="W2175_Lane1" name="Store Staff">
        <bpmn:flowNodeRef>W2175_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2175_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2175_Lane2" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2175_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2175_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2175_Start4" name="Weekly photo submission">
        <bpmn:outgoing>W2175_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2175_Task5" name="Store staff photographs each zone per the protocol (angle, lighting, full-zone…">
        <bpmn:documentation>Step 1: Store staff photographs each zone per the protocol (angle, lighting, full-zone coverage); uploads via the store-manager app with timestamp and geo-tag (the geo-tag prevents a photo from another store or a stock photo)
Responsible (R): Store Staff
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2175_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2175_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2175_Task6" name="Coordinator spot-checks ~40 stores/week; scores and flags issues; sends…">
        <bpmn:documentation>Step 2: Coordinator spot-checks ~40 stores/week; scores and flags issues; sends feedback within 48 hours; escalates non-responsive stores (no submission) to the Regional Ops Manager
Responsible (R): Merch Coordinator
Accountable (A): Merch Planner
Duration: 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2175_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2175_End7" name="Complete">
        <bpmn:incoming>W2175_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2175_Annotation8">
        <bpmn:text>Controls: - CTL-195 (ensure planogram &amp; price-tag compliance.) | - Operational: Coordinator weekly review; non-submission auto-flagged at 24 hours past the deadline
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2175_Assoc9" sourceRef="W2175_Annotation8" targetRef="W2175_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2175_Flow10" sourceRef="W2175_Start4" targetRef="W2175_Task5" />
      <bpmn:sequenceFlow id="W2175_Flow11" sourceRef="W2175_Task5" targetRef="W2175_Task6" />
      <bpmn:sequenceFlow id="W2175_Flow12" sourceRef="W2175_Task6" targetRef="W2175_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2175_diag">
      <bpmndi:BPMNPlane id="W2175_plane" bpmnElement="W_W2175">
        <bpmndi:BPMNShape id="W2175_Lane1_di" bpmnElement="W2175_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
