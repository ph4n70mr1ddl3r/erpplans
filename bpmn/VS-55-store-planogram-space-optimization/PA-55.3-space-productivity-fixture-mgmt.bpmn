        <bpmndi:BPMNShape id="W2182_Task5_di" bpmnElement="W2182_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2182_Task6_di" bpmnElement="W2182_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2182_Start4_di" bpmnElement="W2182_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2182_End7_di" bpmnElement="W2182_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2182_Annotation8_di" bpmnElement="W2182_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2182_Flow10_di" bpmnElement="W2182_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2182_Flow11_di" bpmnElement="W2182_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2182_Flow12_di" bpmnElement="W2182_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2182_Assoc9_di" bpmnElement="W2182_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2183" name="W2183. Fixture Procurement &amp; Budgeting" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget cycle or replacement need
Frequency: Annual; ~PHP 20–30M budget
Volume: ~10–15 new store packages + replacements/year
Owner: Facilities Coordinator
Participants: Facilities Coord, Store Design Mgr, CFO
Source: workflow W2183 — Fixture Procurement &amp; Budgeting</bpmn:documentation>
      <bpmn:laneSet id="W2183_LaneSet2">
        <bpmn:lane id="W2183_Lane1" name="Facilities Coordinator">
        <bpmn:flowNodeRef>W2183_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2183_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2183_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2183_Start3" name="Annual budget cycle or replacement need">
        <bpmn:outgoing>W2183_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2183_Task4" name="Coordinator compiles the fixture needs (new-store packages, replacements from…">
        <bpmn:documentation>Step 1: Coordinator compiles the fixture needs (new-store packages, replacements from the W2179 condition inventory, specialty displays from W2168); solicits 3–5 vendor bids per fixture class; recommends the award to CFO against the annual budget; manages the delivery schedule
Responsible (R): Facilities Coordinator
Accountable (A): VP Store Operations
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2183_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2183_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2183_End5" name="Complete">
        <bpmn:incoming>W2183_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2183_Annotation6">
        <bpmn:text>Controls: - CTL-396 (ensure controlled execution — Space Productivity &amp; Fixture Management (PA-55.3).) | - operational: capex-approval for new-store packages; asset-grade fixture tracking; operational: CFO sign-off on the award within the annual budget
Owner: Facilities Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2183_Assoc7" sourceRef="W2183_Annotation6" targetRef="W2183_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2183_Flow8" sourceRef="W2183_Start3" targetRef="W2183_Task4" />
      <bpmn:sequenceFlow id="W2183_Flow9" sourceRef="W2183_Task4" targetRef="W2183_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2183_diag">
      <bpmndi:BPMNPlane id="W2183_plane" bpmnElement="W_W2183">
        <bpmndi:BPMNShape id="W2183_Lane1_di" bpmnElement="W2183_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2183_Task4_di" bpmnElement="W2183_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2183_Start3_di" bpmnElement="W2183_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2183_End5_di" bpmnElement="W2183_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2183_Annotation6_di" bpmnElement="W2183_Annotation6"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2183_Flow8_di" bpmnElement="W2183_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2183_Flow9_di" bpmnElement="W2183_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2183_Assoc7_di" bpmnElement="W2183_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2184" name="W2184. Shelf Capacity &amp; Stocking Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly replenishment planning
Frequency: Monthly; 35,000 SKUs per store
Volume: 35,000 SKU capacity analyses/store
Owner: Merchandising Planner
Participants: Merch Planner, DC Ops, Store Manager
Source: workflow W2184 — Shelf Capacity &amp; Stocking Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2184_LaneSet3">
        <bpmn:lane id="W2184_Lane1" name="System">
        <bpmn:flowNodeRef>W2184_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2184_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2184_Lane2" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2184_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2184_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2184_Start4" name="Monthly replenishment planning">
        <bpmn:outgoing>W2184_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2184_Task5" name="System calculates the shelf capacity per SKU (facings × units-per-facing vs…">
        <bpmn:documentation>Step 1: System calculates the shelf capacity per SKU (facings × units-per-facing vs. weekly velocity); identifies the overfaced SKUs (reduce facings, free space) and the underfaced SKUs (increase facings to match velocity and avoid stockout-gaps)
Responsible (R): System / Merch Planner
Accountable (A): Category Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2184_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2184_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2184_Task6" name="Planner adjusts the minimum shelf quantities and the replenishment triggers per…">
        <bpmn:documentation>Step 2: Planner adjusts the minimum shelf quantities and the replenishment triggers per store format; feeds into the automated replenishment per VS-02 so the shelf stays stocked at the optimized capacity
Responsible (R): Merchandising Planner
Accountable (A): DC Operations
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2184_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2184_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2184_End7" name="Complete">
        <bpmn:incoming>W2184_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2184_Annotation8">
        <bpmn:text>Controls: - CTL-51: capacity-master currency; operational: Category Manager sign-off on the facing changes
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2184_Assoc9" sourceRef="W2184_Annotation8" targetRef="W2184_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2184_Flow10" sourceRef="W2184_Start4" targetRef="W2184_Task5" />
      <bpmn:sequenceFlow id="W2184_Flow11" sourceRef="W2184_Task5" targetRef="W2184_Task6" />
      <bpmn:sequenceFlow id="W2184_Flow12" sourceRef="W2184_Task6" targetRef="W2184_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2184_diag">
      <bpmndi:BPMNPlane id="W2184_plane" bpmnElement="W_W2184">
        <bpmndi:BPMNShape id="W2184_Lane1_di" bpmnElement="W2184_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_Lane2_di" bpmnElement="W2184_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_Task5_di" bpmnElement="W2184_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_Task6_di" bpmnElement="W2184_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_Start4_di" bpmnElement="W2184_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_End7_di" bpmnElement="W2184_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2184_Annotation8_di" bpmnElement="W2184_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2184_Flow10_di" bpmnElement="W2184_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2184_Flow11_di" bpmnElement="W2184_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2184_Flow12_di" bpmnElement="W2184_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2184_Assoc9_di" bpmnElement="W2184_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2185" name="W2185. Promotional Space ROI Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Post-promotional period
Frequency: 6/year (bi-monthly)
Volume: 6 analyses/year
Owner: FP&amp;A Analyst
Participants: FP&amp;A, Marketing Mgr, Category Mgr
Source: workflow W2185 — Promotional Space ROI Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2185_LaneSet2">
        <bpmn:lane id="W2185_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2185_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2185_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2185_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2185_Start3" name="Post-promotional period">
        <bpmn:outgoing>W2185_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2185_Task4" name="FP&amp;A calculates the incremental display sales vs. the standard-shelf baseline…">
        <bpmn:documentation>Step 1: FP&amp;A calculates the incremental display sales vs. the standard-shelf baseline (the lift attributable to the endcap/power-aisle placement), the display cost vs. the incremental margin; compares the endcap vs. power-aisle vs. inline-display effectiveness to inform the next promo&#x27;s space allocation
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W2185_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2185_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2185_End5" name="Complete">
        <bpmn:incoming>W2185_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2185_Annotation6">
        <bpmn:text>Controls: - CTL-396 (ensure controlled execution — Space Productivity &amp; Fixture Management (PA-55.3).) | - CTL-396 (promo-spend accuracy — links to VS-39 co-op, VS-17); operational: Finance Manager sign-off on the ROI methodology
Owner: FP&amp;A Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2185_Assoc7" sourceRef="W2185_Annotation6" targetRef="W2185_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2185_Flow8" sourceRef="W2185_Start3" targetRef="W2185_Task4" />
      <bpmn:sequenceFlow id="W2185_Flow9" sourceRef="W2185_Task4" targetRef="W2185_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2185_diag">
      <bpmndi:BPMNPlane id="W2185_plane" bpmnElement="W_W2185">
        <bpmndi:BPMNShape id="W2185_Lane1_di" bpmnElement="W2185_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2185_Task4_di" bpmnElement="W2185_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2185_Start3_di" bpmnElement="W2185_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2185_End5_di" bpmnElement="W2185_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2185_Annotation6_di" bpmnElement="W2185_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2185_Flow8_di" bpmnElement="W2185_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2185_Flow9_di" bpmnElement="W2185_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2185_Assoc7_di" bpmnElement="W2185_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2186" name="W2186. Store Format Segmentation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy review
Frequency: Annual; 200 stores in 3 formats
Volume: 200 stores across 3 segments
Owner: Store Design Manager
Participants: Store Design Mgr, VP Merch, COO
Source: workflow W2186 — Store Format Segmentation</bpmn:documentation>
      <bpmn:laneSet id="W2186_LaneSet3">
        <bpmn:lane id="W2186_Lane1" name="Store Design Manager">
        <bpmn:flowNodeRef>W2186_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2186_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2186_Lane2" name="COO">
        <bpmn:flowNodeRef>W2186_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2186_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2186_Start4" name="Annual strategy review">
        <bpmn:outgoing>W2186_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2186_Task5" name="Manager segments the 200 stores into 3 formats (large flagship ~20, standard…">
        <bpmn:documentation>Step 1: Manager segments the 200 stores into 3 formats (large flagship ~20, standard ~120, compact ~60) based on sqm, trade area, and historical performance; develops the format-specific planogram templates with curated assortments (the compact format carries a smaller SKU count per the W299 assortment-cluster master)
Responsible (R): Store Design Manager
Accountable (A): COO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2186_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2186_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2186_Task6" name="COO approves the format strategy; annual re-evaluation based on 12-month…">
        <bpmn:documentation>Step 2: COO approves the format strategy; annual re-evaluation based on 12-month performance — stores may upgrade or downgrade format if their trade area or performance has shifted materially
Responsible (R): COO
Accountable (A): CEO
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2186_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2186_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2186_End7" name="Complete">
        <bpmn:incoming>W2186_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2186_Annotation8">
        <bpmn:text>Controls: - CTL-51: store-cluster/format master currency; operational: COO sign-off on any format reassignment
Owner: Store Design Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2186_Assoc9" sourceRef="W2186_Annotation8" targetRef="W2186_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2186_Flow10" sourceRef="W2186_Start4" targetRef="W2186_Task5" />
      <bpmn:sequenceFlow id="W2186_Flow11" sourceRef="W2186_Task5" targetRef="W2186_Task6" />
      <bpmn:sequenceFlow id="W2186_Flow12" sourceRef="W2186_Task6" targetRef="W2186_End7" />
    </bpmn:process>
