<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-55.3-space-productivity-fixture-mgmt" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2182" name="W2182. Sales Per Square Meter Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics cycle — Sales Per Square Meter
Frequency: Monthly; 200 stores
Volume: ~1,600 zone-level analyses
Owner: Analytics Manager
Participants: Analytics Manager, Category Mgr, VP Merch, VP Store Operations
Source: workflow W2182 — Sales Per Square Meter Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2182_LaneSet3">
        <bpmn:lane id="W2182_Lane1" name="System">
        <bpmn:flowNodeRef>W2182_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2182_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2182_Lane2" name="Category Mgr">
        <bpmn:flowNodeRef>W2182_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2182_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2182_Start4" name="Monthly analytics cycle — Sales Per Square Meter">
        <bpmn:outgoing>W2182_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2182_Task5" name="System calculates the monthly sales/sqm per zone per store (the canonical…">
        <bpmn:documentation>Step 1: System calculates the monthly sales/sqm per zone per store (the canonical space-productivity metric); benchmarks each against the chain average and the top-quartile store for that format
Responsible (R): System
Accountable (A): Analytics Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2182_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2182_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2182_Task6" name="Category Manager drills into the underperformers (a zone/store that&#x27;s…">
        <bpmn:documentation>Step 2: Category Manager drills into the underperformers (a zone/store that&#x27;s bottom-quartile for its format); VP Store Operations works with the Store Manager on an improvement plan; the analysis feeds the W2166 space-reallocation and the W2171 layout optimization
Responsible (R): Category Mgr / VP Store Operations
Accountable (A): VP Merchandising
Duration: 3–4 hours</bpmn:documentation>
        <bpmn:incoming>W2182_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2182_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2182_End7" name="Complete">
        <bpmn:incoming>W2182_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2182_Annotation8">
        <bpmn:text>Controls: - CTL-396 (ensure controlled execution — Space Productivity &amp; Fixture Management (PA-55.3).) | - Operational: Analytics Manager methodology sign-off; VP Merchandising review of the format-tier benchmarking rules
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2182_Assoc9" sourceRef="W2182_Annotation8" targetRef="W2182_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2182_Flow10" sourceRef="W2182_Start4" targetRef="W2182_Task5" />
      <bpmn:sequenceFlow id="W2182_Flow11" sourceRef="W2182_Task5" targetRef="W2182_Task6" />
      <bpmn:sequenceFlow id="W2182_Flow12" sourceRef="W2182_Task6" targetRef="W2182_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2182_diag">
      <bpmndi:BPMNPlane id="W2182_plane" bpmnElement="W_W2182">
        <bpmndi:BPMNShape id="W2182_Lane1_di" bpmnElement="W2182_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
