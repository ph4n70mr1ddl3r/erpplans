      <bpmn:sequenceFlow id="W2189_Flow10" sourceRef="W2189_Task4" targetRef="W2189_Task5" />
      <bpmn:sequenceFlow id="W2189_Flow11" sourceRef="W2189_Task5" targetRef="W2189_End6" />
    </bpmn:process>
