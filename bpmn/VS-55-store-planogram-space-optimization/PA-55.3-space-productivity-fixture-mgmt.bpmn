      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2188" name="W2188. Planogram Performance Dashboard" isExecutable="false">
      <bpmn:documentation>Trigger: Real-time; monthly deep analysis
Frequency: Continuous; monthly deep dive
Volume: Chain-wide + 200 store views
Owner: Analytics Manager
Participants: Analytics Manager, Merch Planner, Category Mgrs
Source: workflow W2188 — Planogram Performance Dashboard</bpmn:documentation>
      <bpmn:laneSet id="W2188_LaneSet3">
        <bpmn:lane id="W2188_Lane1" name="System">
        <bpmn:flowNodeRef>W2188_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2188_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2188_Lane2" name="Analytics Manager">
        <bpmn:flowNodeRef>W2188_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2188_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2188_Start4" name="Real-time; monthly deep analysis">
        <bpmn:outgoing>W2188_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2188_Task5" name="Real-time dashboard surfaces the key planogram-performance metrics: sales/sqm…">
        <bpmn:documentation>Step 1: Real-time dashboard surfaces the key planogram-performance metrics: sales/sqm (W2182), compliance rate (W2174), stock-out rate by zone/store; daily flag review for anomalies (a compliance drop, a stock-out &gt;5%, a sales decline &gt;15%)
Responsible (R): System / Analytics Manager
Accountable (A): VP Merchandising
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W2188_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2188_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2188_Task6" name="Monthly deep-dive on 2–3 zones or categories with the Category Managers…">
        <bpmn:documentation>Step 2: Monthly deep-dive on 2–3 zones or categories with the Category Managers; quarterly comprehensive report to the Executive Committee with any capital recommendations (links to W2189)
Responsible (R): Analytics Manager
Accountable (A): VP Merchandising
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W2188_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2188_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2188_End7" name="Complete">
        <bpmn:incoming>W2188_Flow12</bpmn:incoming>
      </bpmn:endEvent>
