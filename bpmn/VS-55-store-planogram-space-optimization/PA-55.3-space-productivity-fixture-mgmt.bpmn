    <bpmn:process id="W_W2187" name="W2187. Seasonal Display Space Rotation" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-season planning (6 seasons/year)
Frequency: 6 rotations/year; 200 stores
Volume: ~1,200 rotations/year
Owner: Merchandising Planner
Participants: Merch Planner, Marketing, Store Ops
Source: workflow W2187 — Seasonal Display Space Rotation</bpmn:documentation>
      <bpmn:laneSet id="W2187_LaneSet2">
        <bpmn:lane id="W2187_Lane1" name="Merch Planner">
        <bpmn:flowNodeRef>W2187_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2187_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2187_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2187_Start3" name="Pre-season planning (6 seasons/year)">
        <bpmn:outgoing>W2187_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2187_Task4" name="Planner allocates the seasonal display space per format (the flagship gets more…">
        <bpmn:documentation>Step 1: Planner allocates the seasonal display space per format (the flagship gets more seasonal real estate than the compact); Marketing designs the visual package (signage, fixtures, décor); coordinates the DC staging and the 1-week store-changeover window per format wave
Responsible (R): Merch Planner / Marketing
Accountable (A): VP Marketing
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2187_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2187_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2187_End5" name="Complete">
        <bpmn:incoming>W2187_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2187_Annotation6">
        <bpmn:text>Controls: - CTL-396 (ensure controlled execution — Space Productivity &amp; Fixture Management (PA-55.3).) | - operational: seasonal-planogram currency; operational: VP Marketing sign-off on the visual package
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2187_Assoc7" sourceRef="W2187_Annotation6" targetRef="W2187_Start3" associationDirection="None" />
