    <bpmn:process id="W_W2173" name="W2173. Planogram Cost-Benefit Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Bi-monthly (seasonal rotations)
Frequency: 6 analyses/year
Volume: 6 analyses/year
Owner: FP&amp;A Analyst
Participants: FP&amp;A, Merch Planner, Category Mgr
Source: workflow W2173 — Planogram Cost-Benefit Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2173_LaneSet2">
        <bpmn:lane id="W2173_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2173_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2173_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2173_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2173_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2173_Start3" name="Bi-monthly (seasonal rotations)">
        <bpmn:outgoing>W2173_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2173_Task4" name="FP&amp;A calculates the change cost (reset labor, labels, fixtures, signage) vs…">
        <bpmn:documentation>Step 1: FP&amp;A calculates the change cost (reset labor, labels, fixtures, signage) vs. the projected benefit (sales uplift, margin improvement, inventory-cost reduction from better space allocation)
Responsible (R): FP&amp;A Analyst
Accountable (A): Finance Manager
Duration: 6–8 hours</bpmn:documentation>
        <bpmn:incoming>W2173_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2173_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2173_Task5" name="Post-rotation: measures the actual vs. projected uplift; incorporates the…">
        <bpmn:documentation>Step 2: Post-rotation: measures the actual vs. projected uplift; incorporates the learning into the next projection model so the cost-benefit estimates improve cycle-over-cycle
Responsible (R): FP&amp;A Analyst
Accountable (A): VP Merchandising
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2173_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2173_End6" name="Complete">
        <bpmn:incoming>W2173_Flow11</bpmn:incoming>
      </bpmn:endEvent>
