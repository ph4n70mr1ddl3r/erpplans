<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-55.1-planogram-design-space-allocation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2166" name="W2166. Seasonal Planogram Refresh" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal calendar trigger (6 rotations/year)
Frequency: Bi-monthly; 200 stores × 8 zones
Volume: ~1,600 planogram updates per rotation
Owner: Merchandising Planner
Participants: Merch Planner, Category Mgr, VP Store Operations
Source: workflow W2166 — Seasonal Planogram Refresh</bpmn:documentation>
      <bpmn:laneSet id="W2166_LaneSet4">
        <bpmn:lane id="W2166_Lane1" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2166_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2166_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2166_Lane2" name="Category Mgr">
        <bpmn:flowNodeRef>W2166_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2166_Lane3" name="System">
        <bpmn:flowNodeRef>W2166_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2166_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2166_Start5" name="Seasonal calendar trigger (6 rotations/year)">
        <bpmn:outgoing>W2166_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2166_Task6" name="Planner reviews category performance (sales/sqm, margin/sqm, turns — from…">
        <bpmn:documentation>Step 1: Planner reviews category performance (sales/sqm, margin/sqm, turns — from W2169) and designs the seasonal planogram with space-planning software assigning linear meterage per category
Responsible (R): Merchandising Planner
Accountable (A): Category Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2166_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2166_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2166_Task7" name="Category Manager validates the assortment alignment and cross-merchandising…">
        <bpmn:documentation>Step 2: Category Manager validates the assortment alignment and cross-merchandising (links to W2168); VP Store Operations reviews the format-specific adaptations for large/standard/compact stores (the planogram must flex to the 8,000–15,000 sqm range)
Responsible (R): Category Mgr / VP Store Operations
Accountable (A): VP Merchandising
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W2166_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2166_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2166_Task8" name="System generates the store-specific planogram packages (one per store-cluster…">
        <bpmn:documentation>Step 3: System generates the store-specific planogram packages (one per store-cluster format); distributes to stores via the VS-63 communication system with the compliance-photo requirement
Responsible (R): System
Accountable (A): Merchandising Planner
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2166_Flow14</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2166_End9" name="Complete">
        <bpmn:incoming>W2166_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2166_Annotation10">
        <bpmn:text>Controls: - CTL-394 (ensure controlled execution — Planogram Design &amp; Category Space Allocation (PA-55.1).) | - operational: Category Manager sign-off on each rotation&#x27;s planogram before distribution
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2166_Assoc11" sourceRef="W2166_Annotation10" targetRef="W2166_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2166_Flow12" sourceRef="W2166_Start5" targetRef="W2166_Task6" />
      <bpmn:sequenceFlow id="W2166_Flow13" sourceRef="W2166_Task6" targetRef="W2166_Task7" />
      <bpmn:sequenceFlow id="W2166_Flow14" sourceRef="W2166_Task7" targetRef="W2166_Task8" />
      <bpmn:sequenceFlow id="W2166_Flow15" sourceRef="W2166_Task8" targetRef="W2166_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2166_diag">
      <bpmndi:BPMNPlane id="W2166_plane" bpmnElement="W_W2166">
        <bpmndi:BPMNShape id="W2166_Lane1_di" bpmnElement="W2166_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
