        <bpmndi:BPMNEdge id="W2166_Flow13_di" bpmnElement="W2166_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2166_Flow14_di" bpmnElement="W2166_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2166_Flow15_di" bpmnElement="W2166_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2166_Assoc11_di" bpmnElement="W2166_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2167" name="W2167. New Product Shelf Placement" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU introduction (~200–300/month)
Frequency: ~200–300 placement decisions/month
Volume: ~200–300/month
Owner: Category Manager
Participants: Category Mgr, Merch Planner, Buyer
Source: workflow W2167 — New Product Shelf Placement</bpmn:documentation>
      <bpmn:laneSet id="W2167_LaneSet3">
        <bpmn:lane id="W2167_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W2167_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2167_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2167_Lane2" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2167_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2167_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2167_Start4" name="New SKU introduction (~200–300/month)">
        <bpmn:outgoing>W2167_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2167_Task5" name="Buyer submits the new SKU with dimensions, category, expected velocity (A/B/C…">
        <bpmn:documentation>Step 1: Buyer submits the new SKU with dimensions, category, expected velocity (A/B/C classification per the ABC analysis); Planner evaluates the available shelf space and the optimal position (eye-level for A-items, etc.)
Responsible (R): Buyer / Merch Planner
Accountable (A): Category Manager
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W2167_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2167_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2167_Task6" name="Planner assigns the position, facing count, minimum shelf quantity; determines…">
        <bpmn:documentation>Step 2: Planner assigns the position, facing count, minimum shelf quantity; determines the displaced SKU (the C-item that loses facing to make room); system pushes the update to stores with the shelf labels (links to W181 price-tag printing)
Responsible (R): Merchandising Planner
Accountable (A): Category Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W2167_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2167_End7" name="Complete">
        <bpmn:incoming>W2167_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2167_Annotation8">
        <bpmn:text>Controls: - CTL-394 (ensure controlled execution — Planogram Design &amp; Category Space Allocation (PA-55.1).) | - operational: Category Manager sign-off on the placement
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2167_Assoc9" sourceRef="W2167_Annotation8" targetRef="W2167_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2167_Flow10" sourceRef="W2167_Start4" targetRef="W2167_Task5" />
      <bpmn:sequenceFlow id="W2167_Flow11" sourceRef="W2167_Task5" targetRef="W2167_Task6" />
      <bpmn:sequenceFlow id="W2167_Flow12" sourceRef="W2167_Task6" targetRef="W2167_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2167_diag">
      <bpmndi:BPMNPlane id="W2167_plane" bpmnElement="W_W2167">
        <bpmndi:BPMNShape id="W2167_Lane1_di" bpmnElement="W2167_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_Lane2_di" bpmnElement="W2167_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_Task5_di" bpmnElement="W2167_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_Task6_di" bpmnElement="W2167_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_Start4_di" bpmnElement="W2167_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_End7_di" bpmnElement="W2167_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2167_Annotation8_di" bpmnElement="W2167_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2167_Flow10_di" bpmnElement="W2167_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2167_Flow11_di" bpmnElement="W2167_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2167_Flow12_di" bpmnElement="W2167_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2167_Assoc9_di" bpmnElement="W2167_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2168" name="W2168. Cross-Merchandising Display Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promotion requiring cross-merch display
Frequency: ~10–15 displays per rotation
Volume: ~2,000 implementations per rotation
Owner: Merchandising Planner
Participants: Merch Planner, Category Mgr, Marketing
Source: workflow W2168 — Cross-Merchandising Display Planning</bpmn:documentation>
      <bpmn:laneSet id="W2168_LaneSet3">
        <bpmn:lane id="W2168_Lane1" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2168_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2168_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2168_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2168_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2168_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2168_Start4" name="Seasonal promotion requiring cross-merch display">
        <bpmn:outgoing>W2168_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2168_Task5" name="Planner identifies the cross-merch opportunities from the POS basket-analysis…">
        <bpmn:documentation>Step 1: Planner identifies the cross-merch opportunities from the POS basket-analysis (a bathroom set, an electrical-starter corner, a garden-starter endcap — the complementary categories that co-purchase); designs the display layout with fixtures and signage
Responsible (R): Merchandising Planner
Accountable (A): Category Manager
Duration: 6–8 hours</bpmn:documentation>
        <bpmn:incoming>W2168_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2168_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2168_Task6" name="Marketing designs the POP materials; coordinates the print for 200 stores…">
        <bpmn:documentation>Step 2: Marketing designs the POP materials; coordinates the print for 200 stores; Store Ops communicates the display requirements with the compliance-photo return
Responsible (R): Marketing / Store Ops
Accountable (A): VP Marketing
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2168_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2168_End7" name="Complete">
        <bpmn:incoming>W2168_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2168_Annotation8">
        <bpmn:text>Controls: - CTL-394 (ensure controlled execution — Planogram Design &amp; Category Space Allocation (PA-55.1).) | - operational: Marketing + Planner joint sign-off on each cross-merch display
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2168_Assoc9" sourceRef="W2168_Annotation8" targetRef="W2168_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2168_Flow10" sourceRef="W2168_Start4" targetRef="W2168_Task5" />
      <bpmn:sequenceFlow id="W2168_Flow11" sourceRef="W2168_Task5" targetRef="W2168_Task6" />
      <bpmn:sequenceFlow id="W2168_Flow12" sourceRef="W2168_Task6" targetRef="W2168_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2168_diag">
      <bpmndi:BPMNPlane id="W2168_plane" bpmnElement="W_W2168">
        <bpmndi:BPMNShape id="W2168_Lane1_di" bpmnElement="W2168_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_Lane2_di" bpmnElement="W2168_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_Task5_di" bpmnElement="W2168_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_Task6_di" bpmnElement="W2168_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_Start4_di" bpmnElement="W2168_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_End7_di" bpmnElement="W2168_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2168_Annotation8_di" bpmnElement="W2168_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2168_Flow10_di" bpmnElement="W2168_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2168_Flow11_di" bpmnElement="W2168_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2168_Flow12_di" bpmnElement="W2168_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2168_Assoc9_di" bpmnElement="W2168_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2169" name="W2169. Space Productivity Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics cycle
Frequency: Monthly; 200 stores × 8 zones
Volume: ~1,600 zone-level analyses/month
Owner: Analytics Manager
Participants: Analytics Manager, Category Mgr, Merch Planner
Source: workflow W2169 — Space Productivity Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2169_LaneSet3">
        <bpmn:lane id="W2169_Lane1" name="System">
        <bpmn:flowNodeRef>W2169_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2169_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2169_Lane2" name="Category Mgr">
        <bpmn:flowNodeRef>W2169_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2169_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2169_Start4" name="Monthly analytics cycle">
        <bpmn:outgoing>W2169_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2169_Task5" name="System calculates sales/sqm, margin/sqm, turns/sqm per zone per store (the…">
        <bpmn:documentation>Step 1: System calculates sales/sqm, margin/sqm, turns/sqm per zone per store (the productivity metrics that drive the W2166 space allocation); identifies the top-performing and underperforming zones and stores
Responsible (R): System / Analytics Manager
Accountable (A): Category Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2169_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2169_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2169_Task6" name="Category Manager reviews the underperformers; Planner adjusts the planogram for…">
        <bpmn:documentation>Step 2: Category Manager reviews the underperformers; Planner adjusts the planogram for the next rotation (expand high-productivity zones, reduce or restructure low-productivity zones)
Responsible (R): Category Mgr / Merch Planner
Accountable (A): VP Merchandising
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W2169_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2169_End7" name="Complete">
        <bpmn:incoming>W2169_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2169_Annotation8">
        <bpmn:text>Controls: - CTL-394 (ensure controlled execution — Planogram Design &amp; Category Space Allocation (PA-55.1).) | - Operational: Analytics Manager methodology sign-off; Category Manager review of any zone-cut decision (strategic-purpose check)
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2169_Assoc9" sourceRef="W2169_Annotation8" targetRef="W2169_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2169_Flow10" sourceRef="W2169_Start4" targetRef="W2169_Task5" />
      <bpmn:sequenceFlow id="W2169_Flow11" sourceRef="W2169_Task5" targetRef="W2169_Task6" />
      <bpmn:sequenceFlow id="W2169_Flow12" sourceRef="W2169_Task6" targetRef="W2169_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2169_diag">
      <bpmndi:BPMNPlane id="W2169_plane" bpmnElement="W_W2169">
        <bpmndi:BPMNShape id="W2169_Lane1_di" bpmnElement="W2169_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_Lane2_di" bpmnElement="W2169_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_Task5_di" bpmnElement="W2169_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_Task6_di" bpmnElement="W2169_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_Start4_di" bpmnElement="W2169_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_End7_di" bpmnElement="W2169_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2169_Annotation8_di" bpmnElement="W2169_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2169_Flow10_di" bpmnElement="W2169_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
