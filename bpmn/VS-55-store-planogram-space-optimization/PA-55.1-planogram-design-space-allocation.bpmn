    <bpmn:process id="W_W2170" name="W2170. Planogram Version Control" isExecutable="false">
      <bpmn:documentation>Trigger: Every planogram change
Frequency: Continuous; ~500–800 changes/month
Volume: ~500–800 version updates/month
Owner: Merchandising Planner
Participants: Merch Planner, IT, Store Ops
Source: workflow W2170 — Planogram Version Control</bpmn:documentation>
      <bpmn:laneSet id="W2170_LaneSet2">
        <bpmn:lane id="W2170_Lane1" name="System">
