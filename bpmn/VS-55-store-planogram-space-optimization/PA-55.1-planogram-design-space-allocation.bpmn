    <bpmn:process id="W_W2171" name="W2171. Store Layout Zone Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review or new store design
Frequency: Annual per store; ~10–15 new stores/year
Volume: ~10–15 new + 20–30 optimizations/year
Owner: Store Design Manager
Participants: Store Design Mgr, VP Store Operations, VP Merch
Source: workflow W2171 — Store Layout Zone Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2171_LaneSet3">
        <bpmn:lane id="W2171_Lane1" name="Store Design Manager">
        <bpmn:flowNodeRef>W2171_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2171_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2171_Lane2" name="VP Merch">
        <bpmn:flowNodeRef>W2171_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2171_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2171_Start4" name="Annual review or new store design">
        <bpmn:outgoing>W2171_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2171_Task5" name="Store Design Manager analyzes the traffic flow, dwell time, and…">
        <bpmn:documentation>Step 1: Store Design Manager analyzes the traffic flow, dwell time, and conversion-by-zone (where sensor or POS-heatmap data exists); designs the optimized layout with expanded high-conversion zones and contracted low-conversion zones
Responsible (R): Store Design Manager
Accountable (A): COO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2171_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2171_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2171_Task6" name="VP Merchandising and COO review and approve with the expected ROI (links to…">
        <bpmn:documentation>Step 2: VP Merchandising and COO review and approve with the expected ROI (links to W2173); scheduled for a low-sales period to minimize disruption
Responsible (R): VP Merch / COO
Accountable (A): CEO
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2171_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2171_End7" name="Complete">
        <bpmn:incoming>W2171_Flow12</bpmn:incoming>
      </bpmn:endEvent>
