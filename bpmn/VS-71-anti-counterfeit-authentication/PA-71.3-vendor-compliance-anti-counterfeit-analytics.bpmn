    <bpmn:process id="W_W2567" name="W2567. Supply Chain Integrity Audit &amp; Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit calendar or incident-triggered audit
Frequency: Quarterly for Tier 1 vendors; annual for Tier 2
Volume: ~20–30 audits/year
Owner: Quality Assurance Manager
Participants: QA Mgr, LP Manager, Procurement, Vendor
Source: workflow W2567 — Supply Chain Integrity Audit &amp; Verification</bpmn:documentation>
      <bpmn:laneSet id="W2567_LaneSet2">
        <bpmn:lane id="W2567_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W2567_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2567_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2567_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2567_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2567_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2567_Start3" name="Annual audit calendar or incident-triggered audit">
        <bpmn:outgoing>W2567_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2567_Task4" name="QA Manager prepares audit scope: review vendor manufacturing and packaging…">
        <bpmn:documentation>Step 1: QA Manager prepares audit scope: review vendor manufacturing and packaging controls, serialization processes, raw material traceability, quality testing documentation, distribution chain integrity; for import vendors: include customs documentation verification and origin certification review
Responsible (R): QA Manager
Accountable (A): COO
Duration: 1–2 days prep</bpmn:documentation>
        <bpmn:incoming>W2567_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2567_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2567_Task5" name="QA conducts on-site or remote audit: physical inspection of manufacturing…">
        <bpmn:documentation>Step 2: QA conducts on-site or remote audit: physical inspection of manufacturing facility, review of quality control records, verification of serialization infrastructure, packaging line observation, sample product testing against BuildRight specifications
Responsible (R): QA Manager / LP Officer
Accountable (A): COO
Duration: 1–2 days on-site</bpmn:documentation>
        <bpmn:incoming>W2567_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2567_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2567_Task6" name="QA issues audit report: findings (critical/major/minor), corrective action…">
        <bpmn:documentation>Step 3: QA issues audit report: findings (critical/major/minor), corrective action requests with timeline, re-audit schedule for non-compliant vendors; LP Manager incorporates findings into vendor anti-counterfeit scorecard; Procurement uses findings in contract negotiations
Responsible (R): QA Manager / LP Manager
Accountable (A): COO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2567_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2567_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2567_End7" name="Complete">
        <bpmn:incoming>W2567_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2567_Annotation8">
        <bpmn:text>Controls: - CTL-444 (ensure controlled execution — Vendor Compliance &amp; Anti-Counterfeit Analytics (PA-71.3).) | - operational: Quality Assurance Manager review and approval gate
Owner: Quality Assurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2567_Assoc9" sourceRef="W2567_Annotation8" targetRef="W2567_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2567_Flow10" sourceRef="W2567_Start3" targetRef="W2567_Task4" />
      <bpmn:sequenceFlow id="W2567_Flow11" sourceRef="W2567_Task4" targetRef="W2567_Task5" />
      <bpmn:sequenceFlow id="W2567_Flow12" sourceRef="W2567_Task5" targetRef="W2567_Task6" />
      <bpmn:sequenceFlow id="W2567_Flow13" sourceRef="W2567_Task6" targetRef="W2567_End7" />
    </bpmn:process>
