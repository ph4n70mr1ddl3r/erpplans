        <bpmndi:BPMNEdge id="W2567_Assoc9_di" bpmnElement="W2567_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2568" name="W2568. Anti-Counterfeit Technology Evaluation &amp; Deployment" isExecutable="false">
      <bpmn:documentation>Trigger: Technology refresh cycle or emerging counterfeiting technique
Frequency: Annual evaluation; deployment as needed
Volume: 1–2 technology evaluations/year
Owner: IT Innovation Lead
Participants: IT Innovation, LP Manager, CIO, Category Manager
Source: workflow W2568 — Anti-Counterfeit Technology Evaluation &amp; Deployment</bpmn:documentation>
      <bpmn:laneSet id="W2568_LaneSet4">
        <bpmn:lane id="W2568_Lane1" name="IT Innovation Lead">
        <bpmn:flowNodeRef>W2568_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2568_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2568_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W2568_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2568_Lane3" name="IT Innovation">
        <bpmn:flowNodeRef>W2568_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2568_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2568_Start5" name="Technology refresh cycle or emerging counterfeiting technique">
        <bpmn:outgoing>W2568_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2568_Task6" name="IT Innovation evaluates anti-counterfeit technologies: NFC tags (vs. QR codes)…">
        <bpmn:documentation>Step 1: IT Innovation evaluates anti-counterfeit technologies: NFC tags (vs. QR codes), blockchain-based provenance tracking, AI-powered visual authentication (photo comparison), RFID for bulk scanning, invisible ink/taggant marking; assesses cost, accuracy, scalability, and vendor ecosystem compatibility
Responsible (R): IT Innovation Lead
Accountable (A): CIO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2568_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2568_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2568_Task7" name="LP Manager and Category Manager assess business case: counterfeit loss…">
        <bpmn:documentation>Step 2: LP Manager and Category Manager assess business case: counterfeit loss reduction potential, customer trust improvement, vendor adoption feasibility; prioritizes technologies by ROI and risk severity
Responsible (R): LP Manager / Category Manager
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2568_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2568_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2568_Task8" name="IT deploys approved technologies: pilot at 10 stores for 1 category, measure…">
        <bpmn:documentation>Step 3: IT deploys approved technologies: pilot at 10 stores for 1 category, measure authentication accuracy and operational impact, iterate, then rollout to full network; trains staff on new technology; integrates with existing authentication platform
Responsible (R): IT Innovation / Training
Accountable (A): CIO
Duration: 1–3 months</bpmn:documentation>
        <bpmn:incoming>W2568_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2568_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2568_End9" name="Complete">
        <bpmn:incoming>W2568_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2568_Annotation10">
        <bpmn:text>Controls: - CTL-444 (ensure controlled execution — Vendor Compliance &amp; Anti-Counterfeit Analytics (PA-71.3).) | - operational: IT Innovation Lead review and approval gate
Owner: IT Innovation Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2568_Assoc11" sourceRef="W2568_Annotation10" targetRef="W2568_Start5" associationDirection="None" />
