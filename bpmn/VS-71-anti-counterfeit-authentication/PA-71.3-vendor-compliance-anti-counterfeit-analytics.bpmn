<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-71.3-vendor-compliance-anti-counterfeit-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2566" name="W2566. Vendor Anti-Counterfeit Compliance Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor program cycle or new vendor onboarding
Frequency: Annual per vendor; per onboarding
Volume: ~800–1,000 vendors
Owner: Procurement Manager
Participants: Procurement Mgr, LP Manager, Legal, Quality
Source: workflow W2566 — Vendor Anti-Counterfeit Compliance Program Management</bpmn:documentation>
      <bpmn:laneSet id="W2566_LaneSet3">
        <bpmn:lane id="W2566_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2566_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2566_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2566_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2566_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W2566_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2566_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2566_Start4" name="Annual vendor program cycle or new vendor onboarding">
        <bpmn:outgoing>W2566_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2566_Task5" name="Procurement incorporates anti-counterfeit requirements into vendor onboarding…">
        <bpmn:documentation>Step 1: Procurement incorporates anti-counterfeit requirements into vendor onboarding: product authentication capabilities, serialization standards, packaging security features, supply chain traceability, brand protection cooperation clause; vendors of high-risk categories (power tools, electrical) must demonstrate compliance before activation
Responsible (R): Procurement / LP Manager
Accountable (A): VP Merchandising
Duration: Per onboarding (1–2 days)</bpmn:documentation>
        <bpmn:incoming>W2566_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2566_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2566_Task6" name="LP Manager defines vendor anti-counterfeit tier: Tier 1 (mandatory…">
        <bpmn:documentation>Step 2: LP Manager defines vendor anti-counterfeit tier: Tier 1 (mandatory serialization, quarterly audit) for power tools and premium electrical brands; Tier 2 (serialization recommended, annual audit) for mid-range tools and fixtures; Tier 3 (awareness only) for low-risk categories; updates tier classification annually
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W2566_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2566_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2566_Task7" name="Procurement monitors vendor compliance: tracks serialization rate, audit…">
        <bpmn:documentation>Step 3: Procurement monitors vendor compliance: tracks serialization rate, audit findings, counterfeit incident history; non-compliant vendors receive improvement plan with 90-day deadline; persistent non-compliance affects vendor scorecard and contract renewal
Responsible (R): Procurement / LP Manager
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2566_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2566_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2566_End8" name="Complete">
        <bpmn:incoming>W2566_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2566_Annotation9">
        <bpmn:text>Controls: - CTL-444 (ensure controlled execution — Vendor Compliance &amp; Anti-Counterfeit Analytics (PA-71.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2566_Assoc10" sourceRef="W2566_Annotation9" targetRef="W2566_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2566_Flow11" sourceRef="W2566_Start4" targetRef="W2566_Task5" />
      <bpmn:sequenceFlow id="W2566_Flow12" sourceRef="W2566_Task5" targetRef="W2566_Task6" />
      <bpmn:sequenceFlow id="W2566_Flow13" sourceRef="W2566_Task6" targetRef="W2566_Task7" />
      <bpmn:sequenceFlow id="W2566_Flow14" sourceRef="W2566_Task7" targetRef="W2566_End8" />
    </bpmn:process>
