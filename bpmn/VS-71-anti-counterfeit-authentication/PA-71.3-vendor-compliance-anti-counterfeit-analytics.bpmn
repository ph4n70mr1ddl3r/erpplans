    <bpmn:process id="W_W2573" name="W2573. Annual Anti-Counterfeit Strategy Review &amp; Program Update" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy cycle (Q1)
Frequency: Annual
Volume: 1 annual review
Owner: COO
Participants: COO, LP Manager, Category Mgr, CIO, CFO, VP Legal
Source: workflow W2573 — Annual Anti-Counterfeit Strategy Review &amp; Program Update</bpmn:documentation>
      <bpmn:laneSet id="W2573_LaneSet3">
        <bpmn:lane id="W2573_Lane1" name="LP Manager">
        <bpmn:flowNodeRef>W2573_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2573_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2573_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2573_Lane2" name="COO">
        <bpmn:flowNodeRef>W2573_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2573_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2573_Start4" name="Annual strategy cycle (Q1)">
        <bpmn:outgoing>W2573_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2573_Task5" name="LP Manager prepares annual anti-counterfeit program review: year-over-year…">
        <bpmn:documentation>Step 1: LP Manager prepares annual anti-counterfeit program review: year-over-year metrics comparison, program effectiveness assessment, technology ROI evaluation, vendor compliance trend, financial impact analysis, emerging threat assessment
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2573_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2573_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2573_Task6" name="Cross-functional strategy session: COO leads review with all stakeholders…">
        <bpmn:documentation>Step 2: Cross-functional strategy session: COO leads review with all stakeholders; assesses program performance vs. objectives; identifies gaps and emerging risks; sets next-year targets: counterfeit detection rate, vendor compliance rate, financial loss reduction, technology deployment milestones
Responsible (R): COO
Accountable (A): COO
Duration: Half day</bpmn:documentation>
        <bpmn:incoming>W2573_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2573_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2573_Task7" name="LP Manager develops annual action plan: budget request for technology…">
        <bpmn:documentation>Step 3: LP Manager develops annual action plan: budget request for technology investments, vendor engagement priorities, training calendar, enforcement focus areas, staffing needs; CFO approves budget; COO signs off on strategy
Responsible (R): LP Manager / CFO
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2573_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2573_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2573_End8" name="Complete">
        <bpmn:incoming>W2573_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2573_Annotation9">
        <bpmn:text>Controls: - CTL-444 (ensure controlled execution — Vendor Compliance &amp; Anti-Counterfeit Analytics (PA-71.3).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
