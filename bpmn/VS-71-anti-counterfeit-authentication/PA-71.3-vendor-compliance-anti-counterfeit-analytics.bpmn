      <bpmndi:BPMNPlane id="W2566_plane" bpmnElement="W_W2566">
        <bpmndi:BPMNShape id="W2566_Lane1_di" bpmnElement="W2566_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
