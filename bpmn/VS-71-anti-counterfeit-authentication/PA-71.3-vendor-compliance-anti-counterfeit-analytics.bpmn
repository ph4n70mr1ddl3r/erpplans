    <bpmn:process id="W_W2569" name="W2569. Counterfeit Financial Impact &amp; Loss Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial reporting cycle
Frequency: Monthly
Volume: 1 monthly report
Owner: LP Analyst
Participants: LP Analyst, LP Manager, Finance, COO
Source: workflow W2569 — Counterfeit Financial Impact &amp; Loss Reporting</bpmn:documentation>
      <bpmn:laneSet id="W2569_LaneSet4">
        <bpmn:lane id="W2569_Lane1" name="LP Analyst">
        <bpmn:flowNodeRef>W2569_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2569_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2569_Lane2" name="LP Manager">
        <bpmn:flowNodeRef>W2569_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2569_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2569_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2569_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2569_Start5" name="Monthly financial reporting cycle">
        <bpmn:outgoing>W2569_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2569_Task6" name="LP Analyst compiles counterfeit financial impact: direct losses (counterfeit…">
        <bpmn:documentation>Step 1: LP Analyst compiles counterfeit financial impact: direct losses (counterfeit products sold = margin loss + customer restitution cost), investigation costs (staff time, lab testing, legal fees), prevention costs (serialization infrastructure, training, technology), recovery (vendor credits, insurance claims, legal settlements)
Responsible (R): LP Analyst
Accountable (A): LP Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2569_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2569_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2569_Task7" name="LP Manager reviews financial impact report: total cost of counterfeiting vs…">
        <bpmn:documentation>Step 2: LP Manager reviews financial impact report: total cost of counterfeiting vs. prevention investment budget, cost per incident by category, ROI on anti-counterfeit program; compares against industry benchmarks (retail counterfeit loss typically 1–3% of category sales)
Responsible (R): LP Manager
Accountable (A): COO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2569_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2569_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2569_Task8" name="Finance incorporates counterfeit loss into category P&amp;L: adjusts gross margin…">
