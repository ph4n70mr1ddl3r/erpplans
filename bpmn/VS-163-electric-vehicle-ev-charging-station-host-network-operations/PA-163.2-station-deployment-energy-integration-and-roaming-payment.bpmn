      <bpmn:sequenceFlow id="W4780_Flow13" sourceRef="W4780_Task6" targetRef="W4780_Task7" />
      <bpmn:sequenceFlow id="W4780_Flow14" sourceRef="W4780_Task7" targetRef="W4780_End8" />
    </bpmn:process>
