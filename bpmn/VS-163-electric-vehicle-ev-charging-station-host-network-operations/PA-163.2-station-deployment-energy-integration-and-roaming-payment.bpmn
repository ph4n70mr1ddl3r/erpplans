      <bpmndi:BPMNPlane id="W4779_plane" bpmnElement="W_W4779">
        <bpmndi:BPMNShape id="W4779_Lane1_di" bpmnElement="W4779_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4779_Task4_di" bpmnElement="W4779_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4779_Task5_di" bpmnElement="W4779_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
