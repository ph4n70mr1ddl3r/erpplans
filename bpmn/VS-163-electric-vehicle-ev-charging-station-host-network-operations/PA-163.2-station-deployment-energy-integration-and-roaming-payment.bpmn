<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-163.2-station-deployment-energy-integration-and-roaming-payment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4777" name="W4777. EVSE Hardware Specification, Standards &amp; Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Own-operate deployment (W4776); EVSE refresh; CPO hardware selection (W4770)
Frequency: Per procurement batch
Volume: ~2–6 charge points/site; ~group-wide ports in phases
Owner: EV Program Manager / Procurement (VS-03/VS-34)
Participants: EVSE vendors, Energy (VS-108), Facilities (VS-138), TPRM (VS-161)
Source: workflow W4777 — EVSE Hardware Specification, Standards &amp; Procurement</bpmn:documentation>
      <bpmn:laneSet id="W4777_LaneSet3">
        <bpmn:lane id="W4777_Lane1" name="EV Program">
        <bpmn:flowNodeRef>W4777_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4777_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4777_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4777_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4777_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4777_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4777_Start4" name="Own-operate deployment (W4776); EVSE refresh; CPO hardware selection (W4770)">
        <bpmn:outgoing>W4777_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4777_Task5" name="Specify the EVSE hardware: charging level (AC L2 Type-2 up to 22 kW for…">
        <bpmn:documentation>Step 1: Specify the EVSE hardware: charging level (AC L2 Type-2 up to 22 kW for dwell/destination; DC fast-charge CCS2 50–150+ kW for high-traffic/throughway sites), connector standards for the PH market, smart/networked (OCPP-compliant), metering accuracy (DTI weights &amp; measures / VS-115), PWD-accessible design, durability for tropical/outdoor conditions, and cybersecurity hardening
Responsible (R): EV Program / Energy / Facilities
Accountable (A): EV Program Manager
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4777_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4777_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4777_Task6" name="Procure via RFP/panel: evaluate vendors on hardware, OCPP/OCPI compliance…">
        <bpmn:documentation>Step 2: Procure via RFP/panel: evaluate vendors on hardware, OCPP/OCPI compliance, warranty/parts (VS-31), TPRM cyber/financial DD (VS-161), and total cost of ownership; negotiate warranty, SLA, spare-parts lead time, and software-update commitment
Responsible (R): Procurement / EV Program / TPRM
Accountable (A): COO
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4777_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4777_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4777_Task7" name="Receive, asset-register (VS-35), and stage EVSE for installation (W4778)…">
        <bpmn:documentation>Step 3: Receive, asset-register (VS-35), and stage EVSE for installation (W4778); capture firmware baseline and certificates (electrical safety, DOE-EVCS provider accreditation where applicable); manage vendor performance ongoing (W4792)
Responsible (R): Procurement / Facilities / Asset Mgmt
Accountable (A): EV Program Manager
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W4777_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4777_End8" name="Complete">
        <bpmn:incoming>W4777_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4777_Annotation9">
        <bpmn:text>Controls: - CTL-720 (ensure controlled execution — Station Deployment, Energy Integration &amp; Roaming/Payment (PA-163.2).) | - CTL-720: OCPP/OCPI + cyber + metering-accuracy in spec; TPRM DD; warranty/parts SLA; assets registered (VS-35)
Owner: EV Program Manager / Procurement (VS-03/VS-34)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4777_Assoc10" sourceRef="W4777_Annotation9" targetRef="W4777_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4777_Flow11" sourceRef="W4777_Start4" targetRef="W4777_Task5" />
      <bpmn:sequenceFlow id="W4777_Flow12" sourceRef="W4777_Task5" targetRef="W4777_Task6" />
      <bpmn:sequenceFlow id="W4777_Flow13" sourceRef="W4777_Task6" targetRef="W4777_Task7" />
      <bpmn:sequenceFlow id="W4777_Flow14" sourceRef="W4777_Task7" targetRef="W4777_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4777_diag">
      <bpmndi:BPMNPlane id="W4777_plane" bpmnElement="W_W4777">
        <bpmndi:BPMNShape id="W4777_Lane1_di" bpmnElement="W4777_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_Lane2_di" bpmnElement="W4777_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_Task5_di" bpmnElement="W4777_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_Task6_di" bpmnElement="W4777_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_Task7_di" bpmnElement="W4777_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_Start4_di" bpmnElement="W4777_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4777_End8_di" bpmnElement="W4777_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
