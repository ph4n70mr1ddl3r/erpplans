    <bpmn:process id="W_W4778" name="W4778. Site Civil &amp; Electrical Construction, EVSE Installation &amp; Commissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Site selected (W4771) &amp; EVSE procured (W4777); capex approved (W4776)
Frequency: Per site
Volume: ~10–25 prioritized sites per phase (per the W4769 roadmap: ~400–1,200 ports across ~205 sites)
Owner: EV Program Manager / Facilities (VS-138) / Construction (VS-20)
Participants: Electrical contractor, Facilities (VS-138), Energy (VS-108), Real Estate (VS-97)
Source: workflow W4778 — Site Civil &amp; Electrical Construction, EVSE Installation &amp; Commissioning</bpmn:documentation>
      <bpmn:laneSet id="W4778_LaneSet2">
        <bpmn:lane id="W4778_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W4778_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4778_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4778_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4778_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4778_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4778_Start3" name="Site selected (W4771) &amp; EVSE procured (W4777); capex approved (W4776)">
        <bpmn:outgoing>W4778_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4778_Task4" name="Execute site civil &amp; electrical construction: trenching/conduit, EVSE…">
        <bpmn:documentation>Step 1: Execute site civil &amp; electrical construction: trenching/conduit, EVSE pad/foundations, electrical panel/transformer upgrades (coordinate utility W4779), PWD-accessible bay layout (RA 7277/BP 344), signage/wayfinding (VS-14), lighting, and protection from vehicles/weather; manage via the construction playbook (VS-20/VS-109)
Responsible (R): Facilities / Construction / Contractor
Accountable (A): EV Program Manager / Facilities Lead
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4778_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4778_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4778_Task5" name="Install and mechanically/electrically commission the EVSE: mount, connect to…">
        <bpmn:documentation>Step 2: Install and mechanically/electrically commission the EVSE: mount, connect to the electrical infrastructure (W4779) and to solar/storage where applicable (W4780), energize per Philippine Electrical Code safety standards, configure OCPP to the CSMS (W4781), and run the commissioning test suite (charge handshake, metering, emergency-stop, GFCI, comms)
Responsible (R): Facilities / EVSE vendor / Energy
Accountable (A): EV Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4778_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4778_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4778_Task6" name="Obtain electrical inspection &amp; certification (Philippine Electrical Code), the…">
        <bpmn:documentation>Step 3: Obtain electrical inspection &amp; certification (Philippine Electrical Code), the LGU installation permit sign-off (W4774), and as-built documentation; record assets (VS-35) and hand to operations with the site-acceptance test (W4784)
Responsible (R): Facilities / Compliance / Asset Mgmt
Accountable (A): EV Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4778_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4778_End7" name="Complete">
        <bpmn:incoming>W4778_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4778_Annotation8">
        <bpmn:text>Controls: - CTL-720 (ensure controlled execution — Station Deployment, Energy Integration &amp; Roaming/Payment (PA-163.2).) | - CTL-720: electrical (PEC) inspection passed; PWD-accessible bays; LGU permit signed; OCPP commissioning test passed; as-built recorded
Owner: EV Program Manager / Facilities (VS-138) / Construction (VS-20)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4778_Assoc9" sourceRef="W4778_Annotation8" targetRef="W4778_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4778_Flow10" sourceRef="W4778_Start3" targetRef="W4778_Task4" />
      <bpmn:sequenceFlow id="W4778_Flow11" sourceRef="W4778_Task4" targetRef="W4778_Task5" />
      <bpmn:sequenceFlow id="W4778_Flow12" sourceRef="W4778_Task5" targetRef="W4778_Task6" />
      <bpmn:sequenceFlow id="W4778_Flow13" sourceRef="W4778_Task6" targetRef="W4778_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4778_diag">
      <bpmndi:BPMNPlane id="W4778_plane" bpmnElement="W_W4778">
        <bpmndi:BPMNShape id="W4778_Lane1_di" bpmnElement="W4778_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
