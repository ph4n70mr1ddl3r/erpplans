        <bpmndi:BPMNEdge id="W4778_Flow11_di" bpmnElement="W4778_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4778_Flow12_di" bpmnElement="W4778_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4778_Flow13_di" bpmnElement="W4778_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4778_Assoc9_di" bpmnElement="W4778_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4779" name="W4779. Utility Interconnection, Metering &amp; Grid Service Connection" isExecutable="false">
      <bpmn:documentation>Trigger: Site construction (W4778); capacity upgrade
Frequency: Per site
Volume: ~10–25 sites per phase across multiple utilities (Meralco + electric cooperatives)
Owner: EV Program Manager / Energy (VS-120)
Participants: Meralco/electric cooperative, Energy (VS-108), Facilities (VS-138)
Source: workflow W4779 — Utility Interconnection, Metering &amp; Grid Service Connection</bpmn:documentation>
      <bpmn:laneSet id="W4779_LaneSet2">
        <bpmn:lane id="W4779_Lane1" name="Energy">
        <bpmn:flowNodeRef>W4779_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4779_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4779_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4779_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4779_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4779_Start3" name="Site construction (W4778); capacity upgrade">
        <bpmn:outgoing>W4779_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4779_Task4" name="Arrange the utility service connection/upgrade for the charging load…">
        <bpmn:documentation>Step 1: Arrange the utility service connection/upgrade for the charging load: application, load study, transformer/panel upgrade if needed, utility-side work, meter installation, and energization; manage lead times (can be the schedule-critical path)
Responsible (R): Energy / Facilities / Utility
Accountable (A): EV Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4779_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4779_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4779_Task5" name="Configure metering &amp; tariffs: sub-metering for charging energy (for billing…">
        <bpmn:documentation>Step 2: Configure metering &amp; tariffs: sub-metering for charging energy (for billing W4783 and cost-allocation W4772), the utility tariff structure (time-of-use, demand-charge management W4775), and net-metering where own solar exports (VS-108); verify meter accuracy (VS-115)
Responsible (R): Energy / Finance / Facilities
Accountable (A): EV Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4779_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4779_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4779_Task6" name="Coordinate grid services and reliability: voltage/flicker/quality compliance…">
        <bpmn:documentation>Step 3: Coordinate grid services and reliability: voltage/flicker/quality compliance, backup power (integrate with store generator/UPS VS-138 and own storage W4780), and brownout/typhoon continuity (the charger should fail-safe and recover per VS-69); manage interconnection agreements and records (VS-88)
Responsible (R): Energy / Facilities
Accountable (A): EV Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4779_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4779_End7" name="Complete">
        <bpmn:incoming>W4779_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4779_Annotation8">
        <bpmn:text>Controls: - CTL-720 (ensure controlled execution — Station Deployment, Energy Integration &amp; Roaming/Payment (PA-163.2).) | - CTL-720: utility connection before energization; sub-meter verified (VS-115); power-quality compliant; backup/fail-safe
Owner: EV Program Manager / Energy (VS-120)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4779_Assoc9" sourceRef="W4779_Annotation8" targetRef="W4779_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4779_Flow10" sourceRef="W4779_Start3" targetRef="W4779_Task4" />
      <bpmn:sequenceFlow id="W4779_Flow11" sourceRef="W4779_Task4" targetRef="W4779_Task5" />
      <bpmn:sequenceFlow id="W4779_Flow12" sourceRef="W4779_Task5" targetRef="W4779_Task6" />
      <bpmn:sequenceFlow id="W4779_Flow13" sourceRef="W4779_Task6" targetRef="W4779_End7" />
    </bpmn:process>
