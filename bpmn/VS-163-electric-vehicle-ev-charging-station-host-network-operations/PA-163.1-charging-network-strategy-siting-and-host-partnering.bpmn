      <bpmn:sequenceFlow id="W4769_Flow12" sourceRef="W4769_Task5" targetRef="W4769_Task6" />
      <bpmn:sequenceFlow id="W4769_Flow13" sourceRef="W4769_Task6" targetRef="W4769_End7" />
    </bpmn:process>
