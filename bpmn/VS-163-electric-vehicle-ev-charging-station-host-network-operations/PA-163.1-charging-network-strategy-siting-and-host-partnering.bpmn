      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4771" name="W4771. Charging Site Selection, Traffic/Demand Modeling &amp; Store-Pairing" isExecutable="false">
      <bpmn:documentation>Trigger: Rollout phase (W4769); new-store opening (VS-37); remodel (VS-109)
Frequency: Per site + phased
Volume: ~205 candidate sites; ~prioritized subset per phase
Owner: EV Program Manager / Real Estate (VS-97)
Participants: Store Ops (VS-07), Energy (VS-108), Merchandising (basket), Analytics (VS-28)
Source: workflow W4771 — Charging Site Selection, Traffic/Demand Modeling &amp; Store-Pairing</bpmn:documentation>
      <bpmn:laneSet id="W4771_LaneSet4">
        <bpmn:lane id="W4771_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4771_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4771_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4771_Lane2" name="EV Program">
        <bpmn:flowNodeRef>W4771_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4771_Lane3" name="Real Estate">
        <bpmn:flowNodeRef>W4771_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4771_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4771_Start5" name="Rollout phase (W4769); new-store opening (VS-37); remodel (VS-109)">
        <bpmn:outgoing>W4771_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4771_Task6" name="Model EV-charging demand per site: regional EV density…">
        <bpmn:documentation>Step 1: Model EV-charging demand per site: regional EV density (NCR/CALABARZON/Cebu/Davao first), store traffic, dwell-time/basket potential, proximity to highways/destinations, competitor/host-network gaps, and BuildRight&#x27;s own EV-fleet charging need (VS-06/VS-61 green-fleet transition)
Responsible (R): Analytics / Real Estate / EV Program
Accountable (A): EV Program Manager
Duration: Per phase</bpmn:documentation>
        <bpmn:incoming>W4771_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4771_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4771_Task7" name="Select and prioritize sites: rank by demand model + basket-uplift + grid/solar…">
        <bpmn:documentation>Step 2: Select and prioritize sites: rank by demand model + basket-uplift + grid/solar feasibility (VS-108) + capex; pair each charging site with the store&#x27;s basket strategy (a high-lumber-yard store charges while loading a pickup W4758; an appliance/furniture store captures longer dwell); sequence into the capex plan (W4776)
Responsible (R): EV Program / Real Estate / Merchandising
Accountable (A): COO
Duration: Per phase</bpmn:documentation>
        <bpmn:incoming>W4771_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4771_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4771_Task8" name="Confirm site feasibility: parking-bay availability (PWD-accessible bays per RA…">
        <bpmn:documentation>Step 3: Confirm site feasibility: parking-bay availability (PWD-accessible bays per RA 7277), electrical capacity (W4774 utility), structural/civil for EVSE pads, signage/wayfinding (VS-14), and integration with any remodel (VS-109) or new-store (VS-37) scope
Responsible (R): Real Estate / Facilities (VS-138) / Energy
Accountable (A): EV Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4771_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4771_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4771_End9" name="Complete">
        <bpmn:incoming>W4771_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4771_Annotation10">
        <bpmn:text>Controls: - CTL-719 (ensure controlled execution — Charging Network Strategy, Siting &amp; Host Partnering (PA-163.1).) | - CTL-719: sites ranked by demand+basket+feasibility; phased rollout; PWD-accessible bays included
Owner: EV Program Manager / Real Estate (VS-97)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4771_Assoc11" sourceRef="W4771_Annotation10" targetRef="W4771_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4771_Flow12" sourceRef="W4771_Start5" targetRef="W4771_Task6" />
      <bpmn:sequenceFlow id="W4771_Flow13" sourceRef="W4771_Task6" targetRef="W4771_Task7" />
      <bpmn:sequenceFlow id="W4771_Flow14" sourceRef="W4771_Task7" targetRef="W4771_Task8" />
      <bpmn:sequenceFlow id="W4771_Flow15" sourceRef="W4771_Task8" targetRef="W4771_End9" />
    </bpmn:process>
