      <bpmn:sequenceFlow id="W4770_Flow12" sourceRef="W4770_Task5" targetRef="W4770_Task6" />
      <bpmn:sequenceFlow id="W4770_Flow13" sourceRef="W4770_Task6" targetRef="W4770_Task7" />
      <bpmn:sequenceFlow id="W4770_Flow14" sourceRef="W4770_Task7" targetRef="W4770_End8" />
    </bpmn:process>
