        <bpmndi:BPMNShape id="W4785_Task6_di" bpmnElement="W4785_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4785_Task7_di" bpmnElement="W4785_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4785_Start4_di" bpmnElement="W4785_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4785_End8_di" bpmnElement="W4785_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4785_Annotation9_di" bpmnElement="W4785_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4785_Flow11_di" bpmnElement="W4785_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4785_Flow12_di" bpmnElement="W4785_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4785_Flow13_di" bpmnElement="W4785_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4785_Flow14_di" bpmnElement="W4785_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4785_Assoc10_di" bpmnElement="W4785_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4786" name="W4786. Reactive Fault Triage, Field Repair &amp; Vendor Dispatch" isExecutable="false">
      <bpmn:documentation>Trigger: CSMS fault alert (W4781); customer-reported fault; session failure
Frequency: Per fault
Volume: ~30–80 faults/month at scale (scales with network size &amp; utilization)
Owner: EV Program Manager / Facilities (VS-138) / IT (VS-27)
Participants: EVSE technician, CPO/vendor, Store Ops (VS-07), IT (VS-27)
Source: workflow W4786 — Reactive Fault Triage, Field Repair &amp; Vendor Dispatch</bpmn:documentation>
      <bpmn:laneSet id="W4786_LaneSet2">
        <bpmn:lane id="W4786_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W4786_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4786_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4786_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4786_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4786_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4786_Start3" name="CSMS fault alert (W4781); customer-reported fault; session failure">
        <bpmn:outgoing>W4786_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4786_Task4" name="Triage the fault from CSMS data: classify…">
        <bpmn:documentation>Step 1: Triage the fault from CSMS data: classify (hardware/electrical/software/connectivity/payment), severity (safety-critical vs degraded), and scope (single charger vs site vs network); safety-critical faults → immediate isolation/de-energization (W4787)
Responsible (R): Facilities / IT / EV Program
Accountable (A): EV Program Manager
Duration: Per fault</bpmn:documentation>
        <bpmn:incoming>W4786_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4786_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4786_Task5" name="Dispatch repair: in-house technician for simple fixes (restart, connector…">
        <bpmn:documentation>Step 2: Dispatch repair: in-house technician for simple fixes (restart, connector, fuse, cleaning) or CPO/vendor field service under SLA (W4770); manage spare-parts (VS-31), substitute routing of drivers to adjacent chargers/sites, and the repair SLA
Responsible (R): Facilities / CPO / Procurement
Accountable (A): EV Program Manager
Duration: Per fault</bpmn:documentation>
        <bpmn:incoming>W4786_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4786_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4786_Task6" name="Restore, retest, and return to service: verify the fix end-to-end (charge…">
        <bpmn:documentation>Step 3: Restore, retest, and return to service: verify the fix end-to-end (charge test), update the asset/fault record (VS-35/W4781), feed root-cause to PM/analytics (W4785/W4792), and if a recurring manufacturer defect, escalate to vendor/warranty (W4770)
Responsible (R): Facilities / EV Program
Accountable (A): EV Program Manager
Duration: Per fault</bpmn:documentation>
        <bpmn:incoming>W4786_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4786_End7" name="Complete">
        <bpmn:incoming>W4786_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4786_Annotation8">
        <bpmn:text>Controls: - CTL-721 (ensure controlled execution — Operations, Maintenance, Compliance &amp; Network Analytics (PA-163.3).) | - CTL-721: faults triaged &amp; dispatched per SLA; safety-critical faults isolated immediately; fixes retested; root-cause fed to PM
Owner: EV Program Manager / Facilities (VS-138) / IT (VS-27)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4786_Assoc9" sourceRef="W4786_Annotation8" targetRef="W4786_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4786_Flow10" sourceRef="W4786_Start3" targetRef="W4786_Task4" />
      <bpmn:sequenceFlow id="W4786_Flow11" sourceRef="W4786_Task4" targetRef="W4786_Task5" />
      <bpmn:sequenceFlow id="W4786_Flow12" sourceRef="W4786_Task5" targetRef="W4786_Task6" />
      <bpmn:sequenceFlow id="W4786_Flow13" sourceRef="W4786_Task6" targetRef="W4786_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4786_diag">
      <bpmndi:BPMNPlane id="W4786_plane" bpmnElement="W_W4786">
        <bpmndi:BPMNShape id="W4786_Lane1_di" bpmnElement="W4786_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_Task4_di" bpmnElement="W4786_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_Task5_di" bpmnElement="W4786_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_Task6_di" bpmnElement="W4786_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_Start3_di" bpmnElement="W4786_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_End7_di" bpmnElement="W4786_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4786_Annotation8_di" bpmnElement="W4786_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4786_Flow10_di" bpmnElement="W4786_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4786_Flow11_di" bpmnElement="W4786_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4786_Flow12_di" bpmnElement="W4786_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4786_Flow13_di" bpmnElement="W4786_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4786_Assoc9_di" bpmnElement="W4786_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4787" name="W4787. Charging-Site Safety, Emergency Response &amp; Incident Management" isExecutable="false">
      <bpmn:documentation>Trigger: Safety-critical fault (W4786); fire/shock/arc incident; vehicle incident at a bay
Frequency: Per event (rare)
Volume: Rare: ~2–6 safety events/year, scaling with network size
Owner: EV Program Manager / Safety (VS-24) / Facilities (VS-138)
Participants: Safety Officer (VS-24), BFP, Facilities, Legal (VS-100), Insurance (VS-26)
Source: workflow W4787 — Charging-Site Safety, Emergency Response &amp; Incident Management</bpmn:documentation>
      <bpmn:laneSet id="W4787_LaneSet3">
        <bpmn:lane id="W4787_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W4787_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4787_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4787_Lane2" name="Safety">
        <bpmn:flowNodeRef>W4787_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4787_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4787_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4787_Start4" name="Safety-critical fault (W4786); fire/shock/arc incident; vehicle incident at a bay">
        <bpmn:outgoing>W4787_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4787_Task5" name="Respond to the safety event: emergency-stop/isolation/de-energization of the…">
        <bpmn:documentation>Step 1: Respond to the safety event: emergency-stop/isolation/de-energization of the affected EVSE, scene safety, call emergency services (BFP fire / medical) if needed, evacuate/cordon the bay, and notify Safety (VS-24), Facilities, Legal (VS-100), and Insurance (VS-26) for serious events
Responsible (R): Facilities / Store Ops / Safety
Accountable (A): Safety Officer / EV Program Manager
Duration: Per event (urgent)</bpmn:documentation>
        <bpmn:incoming>W4787_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4787_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4787_Task6" name="Investigate and document: preserve the EVSE/fault data (CSMS W4781), gather…">
        <bpmn:documentation>Step 2: Investigate and document: preserve the EVSE/fault data (CSMS W4781), gather statements/photos, coordinate with the EVSE vendor/CPO, and determine root cause (electrical, thermal, vehicle-side, misuse); manage any injury/property-damage claim (VS-26) and regulatory notification (BFP/DOE/DOLE per VS-24)
Responsible (R): Safety / Facilities / Legal / CPO
Accountable (A): Safety Officer / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4787_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4787_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4787_Task7" name="Remediate and prevent: corrective action on the affected EVSE and fleet-wide if…">
        <bpmn:documentation>Step 3: Remediate and prevent: corrective action on the affected EVSE and fleet-wide if systemic (e.g., firmware recall, connector model replacement), update the safety case/procedures, and feed lessons to continuous improvement (VS-133) and the audit (W4791)
Responsible (R): Safety / Facilities / EV Program
Accountable (A): Safety Officer / EV Program Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4787_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4787_End8" name="Complete">
        <bpmn:incoming>W4787_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4787_Annotation9">
        <bpmn:text>Controls: - CTL-721 (ensure controlled execution — Operations, Maintenance, Compliance &amp; Network Analytics (PA-163.3).) | - CTL-721: safety events isolated immediately; emergency services engaged; evidence preserved; corrective action + fleet-wide if systemic
Owner: EV Program Manager / Safety (VS-24) / Facilities (VS-138)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4787_Assoc10" sourceRef="W4787_Annotation9" targetRef="W4787_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4787_Flow11" sourceRef="W4787_Start4" targetRef="W4787_Task5" />
      <bpmn:sequenceFlow id="W4787_Flow12" sourceRef="W4787_Task5" targetRef="W4787_Task6" />
      <bpmn:sequenceFlow id="W4787_Flow13" sourceRef="W4787_Task6" targetRef="W4787_Task7" />
      <bpmn:sequenceFlow id="W4787_Flow14" sourceRef="W4787_Task7" targetRef="W4787_End8" />
    </bpmn:process>
