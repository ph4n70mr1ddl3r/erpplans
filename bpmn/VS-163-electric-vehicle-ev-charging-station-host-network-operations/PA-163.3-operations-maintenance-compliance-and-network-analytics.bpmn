<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-163.3-operations-maintenance-compliance-and-network-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4785" name="W4785. Preventive Maintenance, Cleaning &amp; EVSE Health Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Calendar/metering interval; CSMS health alert (W4781); post-storm (VS-69)
Frequency: Per EVSE quarterly + continuous monitoring
Volume: ~all charge points across ~205 sites
Owner: EV Program Manager / Facilities (VS-138)
Participants: Facilities/EVSE technician, CPO/vendor (W4770), Energy (VS-108)
Source: workflow W4785 — Preventive Maintenance, Cleaning &amp; EVSE Health Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W4785_LaneSet3">
        <bpmn:lane id="W4785_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W4785_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4785_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4785_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4785_Lane2" name="IT">
        <bpmn:flowNodeRef>W4785_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4785_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4785_Start4" name="Calendar/metering interval; CSMS health alert (W4781); post-storm (VS-69)">
        <bpmn:outgoing>W4785_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4785_Task5" name="Run the PM schedule per EVSE: connector/cable wear inspection, cooling/fan…">
        <bpmn:documentation>Step 1: Run the PM schedule per EVSE: connector/cable wear inspection, cooling/fan, ground-fault/RCD test, emergency-stop test, firmware/OCPP health, metering check (VS-115), signage/wayfinding condition, and the electrical-safety visual; trigger from the CSMS asset register
Responsible (R): Facilities / EVSE Technician
Accountable (A): EV Program Manager / Facilities Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4785_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4785_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4785_Task6" name="Monitor EVSE health continuously via the CSMS (W4781): uptime, fault codes…">
        <bpmn:documentation>Step 2: Monitor EVSE health continuously via the CSMS (W4781): uptime, fault codes, session-success rate, connector utilization, temperature, and connectivity; auto-flag degradation (e.g., rising fault rate, connector wear) before failure; coordinate with the CPO/vendor SLA
Responsible (R): IT / Facilities / EV Program
Accountable (A): EV Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4785_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4785_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4785_Task7" name="Clean and maintain the bay: cable management, screen/camera cleaning, bay…">
        <bpmn:documentation>Step 3: Clean and maintain the bay: cable management, screen/camera cleaning, bay cleaning (VS-138), weatherproofing (tropical/outdoor), and post-typhoon inspection (VS-69) for water/debris damage; keep the bay safe and presentable (customer-experience VS-13)
Responsible (R): Facilities / Store Ops
Accountable (A): Facilities Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4785_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4785_End8" name="Complete">
        <bpmn:incoming>W4785_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4785_Annotation9">
        <bpmn:text>Controls: - CTL-140 (ensure EV-charging uptime &amp; tariff compliance.) | - CTL-721: quarterly PM per EVSE; health monitored continuously; connectors/safety devices tested; bay maintained
Owner: EV Program Manager / Facilities (VS-138)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4785_Assoc10" sourceRef="W4785_Annotation9" targetRef="W4785_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4785_Flow11" sourceRef="W4785_Start4" targetRef="W4785_Task5" />
      <bpmn:sequenceFlow id="W4785_Flow12" sourceRef="W4785_Task5" targetRef="W4785_Task6" />
      <bpmn:sequenceFlow id="W4785_Flow13" sourceRef="W4785_Task6" targetRef="W4785_Task7" />
      <bpmn:sequenceFlow id="W4785_Flow14" sourceRef="W4785_Task7" targetRef="W4785_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4785_diag">
      <bpmndi:BPMNPlane id="W4785_plane" bpmnElement="W_W4785">
        <bpmndi:BPMNShape id="W4785_Lane1_di" bpmnElement="W4785_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4785_Lane2_di" bpmnElement="W4785_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
