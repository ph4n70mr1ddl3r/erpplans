    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4788" name="W4788. Accessibility, Bay Compliance &amp; Customer-Assistance Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Site launch (W4784); accessibility audit (VS-76/VS-21); customer-assistance need
Frequency: Continuous + periodic audit
Volume: ~200–400 PWD/assisted charging customers/month across the network
Owner: EV Program Manager / Store Ops (VS-07) / Compliance
Participants: Store Ops (VS-07), Compliance (VS-22), CX (VS-13)
Source: workflow W4788 — Accessibility, Bay Compliance &amp; Customer-Assistance Operations</bpmn:documentation>
      <bpmn:laneSet id="W4788_LaneSet3">
        <bpmn:lane id="W4788_Lane1" name="Store Ops">
        <bpmn:flowNodeRef>W4788_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4788_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4788_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4788_Lane2" name="CX">
        <bpmn:flowNodeRef>W4788_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4788_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4788_Start4" name="Site launch (W4784); accessibility audit (VS-76/VS-21); customer-assistance need">
        <bpmn:outgoing>W4788_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4788_Task5" name="Maintain PWD-accessible charge bays and accessibility compliance: accessible…">
        <bpmn:documentation>Step 1: Maintain PWD-accessible charge bays and accessibility compliance: accessible bay width/clearance, reachable connector height, accessible payment/QR, wayfinding/signage (RA 7277/BP 344, links VS-76), and assistance availability; audit periodically
Responsible (R): Store Ops / Compliance / Facilities
Accountable (A): EV Program Manager / Compliance
Duration: Continuous + periodic</bpmn:documentation>
        <bpmn:incoming>W4788_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4788_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4788_Task6" name="Provide customer assistance at the bay: store-team help to start a charge…">
        <bpmn:documentation>Step 2: Provide customer assistance at the bay: store-team help to start a charge (especially for PWD/senior/less-tech-savvy drivers per VS-85 mandatory-discount-eligible segments), connector/plug assistance, and troubleshooting before escalation (W4786); brief per OCM (W4784)
Responsible (R): Store Ops / EV Program
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4788_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4788_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4788_Task7" name="Manage the accessibility customer experience and feedback: capture EV-driver…">
        <bpmn:documentation>Step 3: Manage the accessibility customer experience and feedback: capture EV-driver accessibility feedback/NPS (VS-13), remediate barriers (VS-133), and ensure mandatory-discount/treatment-compliant service for eligible customers (VS-85) at the charging service
Responsible (R): CX / Store Ops / Compliance
Accountable (A): EV Program Manager / CX
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4788_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4788_End8" name="Complete">
        <bpmn:incoming>W4788_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4788_Annotation9">
        <bpmn:text>Controls: - CTL-140 (ensure EV-charging uptime &amp; tariff compliance.) | - CTL-721: PWD-accessible bays per RA 7277/BP 344; assistance available; eligible customers treated per VS-85; audited periodically
Owner: EV Program Manager / Store Ops (VS-07) / Compliance</bpmn:text>
      </bpmn:textAnnotation>
