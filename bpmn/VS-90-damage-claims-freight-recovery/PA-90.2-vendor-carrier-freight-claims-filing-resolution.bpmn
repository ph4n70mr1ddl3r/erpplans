        <bpmn:outgoing>W3032_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3032_Task6" name="Claims Mgr maintains claim aging dashboard: open claims by counterparty, age…">
        <bpmn:documentation>Step 1: Claims Mgr maintains claim aging dashboard: open claims by counterparty, age, value, recovery rate, denial rate
Responsible (R): Claims Mgr
Accountable (A): Claims Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3032_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3032_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3032_Task7" name="Supply Chain Analytics produces recovery analytics: recovery % by…">
        <bpmn:documentation>Step 2: Supply Chain Analytics produces recovery analytics: recovery % by vendor/carrier/lane, trend, and recovery-value leakage
Responsible (R): Supply Chain Analytics
Accountable (A): Supply Chain Analytics Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3032_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3032_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3032_Task8" name="Vendor Mgmt/Logistics feed claim performance into vendor scorecard (links to…">
        <bpmn:documentation>Step 3: Vendor Mgmt/Logistics feed claim performance into vendor scorecard (links to VS-67) and carrier performance review (links to VS-56); drives corrective action
Responsible (R): Vendor Mgmt / Logistics
Accountable (A): Vendor Management Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3032_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3032_End9" name="Complete">
        <bpmn:incoming>W3032_Flow15</bpmn:incoming>
      </bpmn:endEvent>
