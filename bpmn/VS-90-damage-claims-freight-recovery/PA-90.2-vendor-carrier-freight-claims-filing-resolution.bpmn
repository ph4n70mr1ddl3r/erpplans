    <bpmn:process id="W_W3025" name="W3025. Vendor Shortage, Damage &amp; Non-Conformance Claim Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor-attributable discrepancy confirmed
Frequency: Continuous
Volume: ~800–1,000 vendors; subset of receipts
Owner: Vendor Management Manager
Participants: Vendor Mgmt, AP, Quality, Inventory Control
Source: workflow W3025 — Vendor Shortage, Damage &amp; Non-Conformance Claim Filing</bpmn:documentation>
      <bpmn:laneSet id="W3025_LaneSet3">
        <bpmn:lane id="W3025_Lane1" name="Vendor Mgmt">
        <bpmn:flowNodeRef>W3025_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3025_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3025_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3025_Lane2" name="Quality">
        <bpmn:flowNodeRef>W3025_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3025_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3025_Start4" name="Vendor-attributable discrepancy confirmed">
        <bpmn:outgoing>W3025_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3025_Task5" name="Vendor Mgmt/AP files vendor claim via vendor portal (links to VS-03) with…">
        <bpmn:documentation>Step 1: Vendor Mgmt/AP files vendor claim via vendor portal (links to VS-03) with discrepancy details, evidence (W3020), quantity, and claimed value (cost + handling)
Responsible (R): Vendor Mgmt / AP
Accountable (A): Vendor Management Manager
Duration: Per claim (&lt;vendor SLA)</bpmn:documentation>
        <bpmn:incoming>W3025_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3025_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3025_Task6" name="Quality provides non-conformance detail (spec deviation, wrong item…">
        <bpmn:documentation>Step 2: Quality provides non-conformance detail (spec deviation, wrong item, defective); supports liability assertion
Responsible (R): Quality
Accountable (A): Quality Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3025_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3025_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3025_Task7" name="Vendor Mgmt tracks claim to vendor acknowledgment; pursues credit memo…">
        <bpmn:documentation>Step 3: Vendor Mgmt tracks claim to vendor acknowledgment; pursues credit memo, replacement, or debit per purchase terms; updates damage case
Responsible (R): Vendor Mgmt
Accountable (A): Vendor Management Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3025_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3025_End8" name="Complete">
        <bpmn:incoming>W3025_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3025_Annotation9">
        <bpmn:text>Controls: - CTL-500 (ensure controlled execution — Vendor, Carrier &amp; Freight Claims Filing &amp; Resolution (PA-90.2).) | - operational: automated claim-trigger at goods-receipt discrepancy
Owner: Vendor Management Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3025_Assoc10" sourceRef="W3025_Annotation9" targetRef="W3025_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3025_Flow11" sourceRef="W3025_Start4" targetRef="W3025_Task5" />
      <bpmn:sequenceFlow id="W3025_Flow12" sourceRef="W3025_Task5" targetRef="W3025_Task6" />
      <bpmn:sequenceFlow id="W3025_Flow13" sourceRef="W3025_Task6" targetRef="W3025_Task7" />
      <bpmn:sequenceFlow id="W3025_Flow14" sourceRef="W3025_Task7" targetRef="W3025_End8" />
    </bpmn:process>
