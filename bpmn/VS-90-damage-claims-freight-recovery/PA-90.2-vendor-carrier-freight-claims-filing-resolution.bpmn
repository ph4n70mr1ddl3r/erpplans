    <bpmn:process id="W_W3031" name="W3031. Claim Denial Dispute, Escalation &amp; Legal Handoff" isExecutable="false">
      <bpmn:documentation>Trigger: Claim denied or settlement unacceptable
Frequency: Event-driven
Volume: Subset of claims
Owner: Claims Manager
Participants: Claims Mgr, Legal, Vendor Mgmt/Logistics, Finance
Source: workflow W3031 — Claim Denial Dispute, Escalation &amp; Legal Handoff</bpmn:documentation>
      <bpmn:laneSet id="W3031_LaneSet4">
        <bpmn:lane id="W3031_Lane1" name="Claims Mgr">
        <bpmn:flowNodeRef>W3031_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3031_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3031_Lane2" name="Vendor Mgmt">
