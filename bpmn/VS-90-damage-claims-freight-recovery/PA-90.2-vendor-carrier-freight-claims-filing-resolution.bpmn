    <bpmn:process id="W_W3027" name="W3027. Import Container Damage, Short-Landing &amp; Surveyor Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Import container discrepancy (damage, short-landing, contamination)
Frequency: ~400–600 TEUs/month; subset with discrepancy
Volume: Import vendors ~40% of COGS
Owner: Import &amp; Customs Manager
Participants: Import/Customs, Logistics, Surveyor, Broker, Finance
Source: workflow W3027 — Import Container Damage, Short-Landing &amp; Surveyor Coordination</bpmn:documentation>
      <bpmn:laneSet id="W3027_LaneSet3">
        <bpmn:lane id="W3027_Lane1" name="Import">
        <bpmn:flowNodeRef>W3027_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3027_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3027_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3027_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3027_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3027_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3027_Start4" name="Import container discrepancy (damage, short-landing, contamination)">
        <bpmn:outgoing>W3027_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3027_Task5" name="Import/Customs engages independent marine surveyor at port for container…">
        <bpmn:documentation>Step 1: Import/Customs engages independent marine surveyor at port for container damage/short-landing; obtains survey report before container leaves terminal
Responsible (R): Import / Customs
Accountable (A): Import &amp; Customs Manager
Duration: Per event (&lt;port free-time)</bpmn:documentation>
        <bpmn:incoming>W3027_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3027_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3027_Task6" name="Import/Customs/Broker files claim against ocean carrier, marine insurer, or…">
        <bpmn:documentation>Step 2: Import/Customs/Broker files claim against ocean carrier, marine insurer, or vendor per bill of lading and Incoterms; preserves lien rights
Responsible (R): Import / Customs / Broker
Accountable (A): Import &amp; Customs Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3027_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3027_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3027_Task7" name="Finance/Logistics coordinate with marine insurance and customs (duty refund on…">
        <bpmn:documentation>Step 3: Finance/Logistics coordinate with marine insurance and customs (duty refund on damaged/destroyed imports per BIR rules); reconcile recovery
Responsible (R): Finance / Logistics
Accountable (A): Finance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3027_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3027_End8" name="Complete">
        <bpmn:incoming>W3027_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3027_Annotation9">
        <bpmn:text>Controls: - CTL-500 (ensure controlled execution — Vendor, Carrier &amp; Freight Claims Filing &amp; Resolution (PA-90.2).) | - operational: mandatory pre-gate-out port-discharge survey gate with findings photographed and attached to the claim file
Owner: Import &amp; Customs Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3027_Assoc10" sourceRef="W3027_Annotation9" targetRef="W3027_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3027_Flow11" sourceRef="W3027_Start4" targetRef="W3027_Task5" />
      <bpmn:sequenceFlow id="W3027_Flow12" sourceRef="W3027_Task5" targetRef="W3027_Task6" />
      <bpmn:sequenceFlow id="W3027_Flow13" sourceRef="W3027_Task6" targetRef="W3027_Task7" />
      <bpmn:sequenceFlow id="W3027_Flow14" sourceRef="W3027_Task7" targetRef="W3027_End8" />
    </bpmn:process>
