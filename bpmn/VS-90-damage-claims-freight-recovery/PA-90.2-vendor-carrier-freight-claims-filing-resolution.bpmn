    <bpmn:process id="W_W3026" name="W3026. Freight Carrier / 3PL Damage &amp; Shortage Claim Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Carrier/3PL-attributable transit damage or shortage
Frequency: Continuous
Volume: Owned fleet (20%) + 3PL (80%); inter-island + last-mile
Owner: Logistics Manager
Participants: Logistics, Inventory Control, AP, 3PL/Carrier
Source: workflow W3026 — Freight Carrier / 3PL Damage &amp; Shortage Claim Filing</bpmn:documentation>
      <bpmn:laneSet id="W3026_LaneSet3">
        <bpmn:lane id="W3026_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W3026_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3026_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3026_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3026_Lane2" name="Inventory Control">
        <bpmn:flowNodeRef>W3026_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3026_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3026_Start4" name="Carrier/3PL-attributable transit damage or shortage">
        <bpmn:outgoing>W3026_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3026_Task5" name="Logistics files carrier/3PL claim with waybill, delivery exception, photos…">
        <bpmn:documentation>Step 1: Logistics files carrier/3PL claim with waybill, delivery exception, photos (W3020), and claimed value within carrier notice window (typically 7–15 days)
Responsible (R): Logistics
Accountable (A): Logistics Manager
Duration: Per claim (&lt;window)</bpmn:documentation>
        <bpmn:incoming>W3026_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3026_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3026_Task6" name="Inventory Control confirms transit-leg responsibility via seal/tracking…">
        <bpmn:documentation>Step 2: Inventory Control confirms transit-leg responsibility via seal/tracking evidence; differentiates pickup damage vs. in-transit vs. delivery
Responsible (R): Inventory Control
Accountable (A): Inventory Control Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3026_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3026_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3026_Task7" name="Logistics/AP track carrier settlement (credit/refund/offset against freight…">
        <bpmn:documentation>Step 3: Logistics/AP track carrier settlement (credit/refund/offset against freight payable); reconcile to damage case; pursue denial disputes (W3031)
Responsible (R): Logistics / AP
Accountable (A): Logistics Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3026_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3026_End8" name="Complete">
        <bpmn:incoming>W3026_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3026_Annotation9">
        <bpmn:text>Controls: - CTL-500 (ensure controlled execution — Vendor, Carrier &amp; Freight Claims Filing &amp; Resolution (PA-90.2).) | - operational: claim-trigger automation and short SLA
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3026_Assoc10" sourceRef="W3026_Annotation9" targetRef="W3026_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3026_Flow11" sourceRef="W3026_Start4" targetRef="W3026_Task5" />
      <bpmn:sequenceFlow id="W3026_Flow12" sourceRef="W3026_Task5" targetRef="W3026_Task6" />
      <bpmn:sequenceFlow id="W3026_Flow13" sourceRef="W3026_Task6" targetRef="W3026_Task7" />
      <bpmn:sequenceFlow id="W3026_Flow14" sourceRef="W3026_Task7" targetRef="W3026_End8" />
    </bpmn:process>
