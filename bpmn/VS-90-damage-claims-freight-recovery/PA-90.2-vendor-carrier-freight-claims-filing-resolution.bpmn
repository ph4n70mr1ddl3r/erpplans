        <bpmn:flowNodeRef>W3031_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3031_Start5" name="Claim denied or settlement unacceptable">
        <bpmn:outgoing>W3031_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3031_Task6" name="Claims Mgr documents denial rationale; assesses dispute viability (evidence…">
        <bpmn:documentation>Step 1: Claims Mgr documents denial rationale; assesses dispute viability (evidence strength, contract terms, materiality); escalates within escalation tiers
Responsible (R): Claims Mgr
Accountable (A): Claims Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3031_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3031_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3031_Task7" name="Vendor Mgmt/Logistics pursue commercial escalation with counterparty; Legal…">
        <bpmn:documentation>Step 2: Vendor Mgmt/Logistics pursue commercial escalation with counterparty; Legal issues demand letter where contract supports
Responsible (R): Vendor Mgmt / Logistics / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3031_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3031_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3031_Task8" name="Legal evaluates litigation/arbitration for material claims; coordinates with…">
        <bpmn:documentation>Step 3: Legal evaluates litigation/arbitration for material claims; coordinates with finance write-off decision for non-recoverable amounts; closes case
Responsible (R): Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3031_Flow14</bpmn:incoming>
      </bpmn:userTask>
