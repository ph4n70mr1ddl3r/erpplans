    <bpmn:process id="W_W3029" name="W3029. Claim Negotiation, Settlement &amp; Credit/Refund Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Counterparty responds to claim
Frequency: Per claim
Volume: Enterprise claims
Owner: Claims Manager
Participants: Claims Mgr, Vendor Mgmt/Logistics, AP/AR, Finance
Source: workflow W3029 — Claim Negotiation, Settlement &amp; Credit/Refund Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3029_LaneSet3">
        <bpmn:lane id="W3029_Lane1" name="Claims Mgr">
        <bpmn:flowNodeRef>W3029_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3029_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3029_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3029_Lane2" name="AP">
        <bpmn:flowNodeRef>W3029_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3029_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3029_Start4" name="Counterparty responds to claim">
        <bpmn:outgoing>W3029_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3029_Task5" name="Claims Mgr/Vendor Mgmt/Logistics negotiate settlement with counterparty…">
        <bpmn:documentation>Step 1: Claims Mgr/Vendor Mgmt/Logistics negotiate settlement with counterparty; defends claim with evidence; agrees credit memo, refund, replacement, or freight offset
Responsible (R): Claims Mgr / Vendor Mgmt / Logistics
Accountable (A): Claims Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3029_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3029_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3029_Task6" name="AP/AR posts settlement: vendor credit memo, carrier offset, AR/customer-side…">
        <bpmn:documentation>Step 2: AP/AR posts settlement: vendor credit memo, carrier offset, AR/customer-side (W3036), or cash refund; reconciles to damage case and GL
Responsible (R): AP / AR
Accountable (A): Finance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3029_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3029_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3029_Task7" name="Claims Mgr closes claim in case system with settlement value and recovery %…">
        <bpmn:documentation>Step 3: Claims Mgr closes claim in case system with settlement value and recovery %; flags residual for insurance/subrogation (W3030) or dispute (W3031)
Responsible (R): Claims Mgr
Accountable (A): Claims Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3029_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3029_End8" name="Complete">
        <bpmn:incoming>W3029_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3029_Annotation9">
        <bpmn:text>Controls: - CTL-75 (detect and recover freight &amp; receiving damage.) | - operational: settlement SLAs and escalation tiers
Owner: Claims Manager</bpmn:text>
      </bpmn:textAnnotation>
