        <bpmn:lane id="W3030_Lane1" name="Risk">
        <bpmn:flowNodeRef>W3030_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3030_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3030_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3030_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3030_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3030_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3030_Start4" name="Claim settlement short of full recovery, or insured event">
        <bpmn:outgoing>W3030_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3030_Task5" name="Risk/Insurance evaluates cargo/transit/goods-in-transit and property policies…">
        <bpmn:documentation>Step 1: Risk/Insurance evaluates cargo/transit/goods-in-transit and property policies for recovery beyond counterparty settlement; avoids double-recovery
Responsible (R): Risk / Insurance
Accountable (A): Risk &amp; Insurance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3030_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3030_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3030_Task6" name="Risk/Insurance files insurer claim with evidence package (W3028) and settlement…">
        <bpmn:documentation>Step 2: Risk/Insurance files insurer claim with evidence package (W3028) and settlement record; pursues subrogation against responsible carrier/vendor
Responsible (R): Risk / Insurance
Accountable (A): Risk &amp; Insurance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3030_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3030_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3030_Task7" name="Finance posts insurer recovery; reconciles total recovery vs. loss; coordinates…">
        <bpmn:documentation>Step 3: Finance posts insurer recovery; reconciles total recovery vs. loss; coordinates vendor/carrier recovery (W3025/3026) and customer recovery (W3038) to net total
Responsible (R): Finance
Accountable (A): Finance Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W3030_Flow13</bpmn:incoming>
      </bpmn:userTask>
