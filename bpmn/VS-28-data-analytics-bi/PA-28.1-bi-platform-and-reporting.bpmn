      <bpmn:sequenceFlow id="W1250_Flow14" sourceRef="W1250_Task5" targetRef="W1250_Task6" />
      <bpmn:sequenceFlow id="W1250_Flow15" sourceRef="W1250_Task6" targetRef="W1250_Task7" />
      <bpmn:sequenceFlow id="W1250_Flow16" sourceRef="W1250_Task7" targetRef="W1250_Task8" />
      <bpmn:sequenceFlow id="W1250_Flow17" sourceRef="W1250_Task8" targetRef="W1250_End9" />
    </bpmn:process>
