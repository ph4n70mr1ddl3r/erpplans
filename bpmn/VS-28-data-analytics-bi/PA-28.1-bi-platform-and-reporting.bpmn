    <bpmn:process id="W_W885" name="W885. Monthly Executive Reporting Package Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — monthly, typically completed by 5th business day of following month
Frequency: Monthly (12 packages per year)
Volume: 1 comprehensive package per month distributed to Executive Committee and Board of Directors
Owner: BI Manager / Finance Controller
Participants: BI Analyst, Finance Analyst, Department Heads (data contributors), COO, CFO
Source: workflow W885 — Monthly Executive Reporting Package Preparation</bpmn:documentation>
      <bpmn:laneSet id="W885_LaneSet7">
        <bpmn:lane id="W885_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W885_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W885_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W885_Lane2" name="BI Analyst">
        <bpmn:flowNodeRef>W885_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W885_Lane3" name="Supply Chain Analyst">
        <bpmn:flowNodeRef>W885_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W885_Lane4" name="HR Analyst">
        <bpmn:flowNodeRef>W885_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W885_Lane5" name="BI Manager">
        <bpmn:flowNodeRef>W885_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W885_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W885_Lane6" name="CFO">
        <bpmn:flowNodeRef>W885_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W885_End16</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W885_Start8" name="Scheduled — monthly, typically completed by 5th business day of following month">
        <bpmn:outgoing>W885_Flow19</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W885_Task9" name="Compile financial data — Finance Analyst extracts: (a) P&amp;L by entity and…">
        <bpmn:documentation>Step 1: Compile financial data — Finance Analyst extracts: (a) P&amp;L by entity and consolidated, (b) balance sheet, (c) cash flow statement, (d) working capital analysis, (e) capex tracking, (f) budget vs. actual with variance commentary
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W885_Flow19</bpmn:incoming>
        <bpmn:outgoing>W885_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task10" name="Compile operational data — BI Analyst extracts: (a) same-store sales growth…">
        <bpmn:documentation>Step 2: Compile operational data — BI Analyst extracts: (a) same-store sales growth, (b) foot traffic and conversion rate, (c) average transaction value, (d) gross margin by category, (e) inventory turns and days-of-supply, (f) ecommerce metrics (GMV, conversion, AOV), (g) customer acquisition and retention
Responsible (R): BI Analyst
Accountable (A): BI Manager
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W885_Flow20</bpmn:incoming>
        <bpmn:outgoing>W885_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task11" name="Compile supply chain data — (a) vendor OTIF performance, (b) DC throughput and…">
        <bpmn:documentation>Step 3: Compile supply chain data — (a) vendor OTIF performance, (b) DC throughput and productivity, (c) delivery performance to stores, (d) import container status, (e) procurement cost savings
Responsible (R): Supply Chain Analyst
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W885_Flow21</bpmn:incoming>
        <bpmn:outgoing>W885_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task12" name="Compile HR and organizational data — (a) headcount by entity, (b) turnover…">
        <bpmn:documentation>Step 4: Compile HR and organizational data — (a) headcount by entity, (b) turnover rate, (c) open positions and time-to-fill, (d) training completion, (e) employee satisfaction score
Responsible (R): HR Analyst
Accountable (A): CHRO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W885_Flow22</bpmn:incoming>
        <bpmn:outgoing>W885_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task13" name="Assemble executive package — BI Manager consolidates all data into standardized…">
        <bpmn:documentation>Step 5: Assemble executive package — BI Manager consolidates all data into standardized executive presentation: (a) CEO summary (1 page), (b) financial highlights (2 pages), (c) operational scorecard (2 pages), (d) category performance (1 page), (e) store heatmap and regional analysis (1 page), (f) key initiatives and risks (1 page), (g) detailed appendix; ensure visual consistency and narrative clarity
Responsible (R): BI Manager
Accountable (A): COO
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W885_Flow23</bpmn:incoming>
        <bpmn:outgoing>W885_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task14" name="Executive review and commentary — CFO and COO review draft; add management…">
        <bpmn:documentation>Step 6: Executive review and commentary — CFO and COO review draft; add management commentary on material variances, strategic initiatives, and forward-looking outlook; iterate until approved
Responsible (R): CFO / COO
Accountable (A): CEO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W885_Flow24</bpmn:incoming>
        <bpmn:outgoing>W885_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W885_Task15" name="Distribute executive package — publish to Board portal, email to Executive…">
        <bpmn:documentation>Step 7: Distribute executive package — publish to Board portal, email to Executive Committee, upload to document management system, and schedule management review meeting (typically 10th business day)
Responsible (R): BI Manager
Accountable (A): CFO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W885_Flow25</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W885_End16" name="Complete">
        <bpmn:incoming>W885_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W885_Annotation17">
        <bpmn:text>Controls: - CTL-222 (ensure BI data governance &amp; reporting integrity.) | - operational: BI Manager / Finance Controller review and approval gate
Owner: BI Manager / Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
