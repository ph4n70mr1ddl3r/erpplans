        <bpmndi:BPMNShape id="W1567_Annotation10_di" bpmnElement="W1567_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1567_Flow12_di" bpmnElement="W1567_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1567_Flow13_di" bpmnElement="W1567_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1567_Flow14_di" bpmnElement="W1567_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1567_Flow15_di" bpmnElement="W1567_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1567_Flow16_di" bpmnElement="W1567_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1567_Assoc11_di" bpmnElement="W1567_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1568" name="W1568. Executive Strategy Dashboard, C-Suite Performance Reporting &amp; Board-Level Analytics Package" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly executive review cycle; monthly board reporting cycle; or ad-hoc executive inquiry
Frequency: Weekly dashboard refresh; monthly board reporting package; quarterly strategy review deck
Volume: 5 C-suite executives (CEO, CFO, COO, CIO, CMO) + CHRO + VP Legal = 7 primary users; board of directors receives monthly package
Owner: BI Analytics Manager
Participants: BI Analytics Manager, Data Analyst, Senior Data Scientist, CEO, CFO, COO, CIO, CMO, CHRO, Board of Directors
Source: workflow W1568 — Executive Strategy Dashboard, C-Suite Performance Reporting &amp; Board-Level Analytics Package</bpmn:documentation>
      <bpmn:laneSet id="W1568_LaneSet3">
        <bpmn:lane id="W1568_Lane1" name="BI Analytics Manager">
        <bpmn:flowNodeRef>W1568_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1568_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1568_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1568_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1568_Lane2" name="Data Analyst">
        <bpmn:flowNodeRef>W1568_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1568_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1568_Start4" name="Weekly executive review cycle; monthly board reporting cycle; or ad-hoc executive inquiry">
        <bpmn:outgoing>W1568_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1568_Task5" name="Executive dashboard design">
        <bpmn:documentation>Step 1: Executive dashboard design: BI Analytics Manager designs the C-suite dashboard with the following views: (a) CEO View: (i) total revenue vs. plan vs. prior year (daily, MTD, YTD), (ii) same-store sales growth by region, (iii) EBITDA margin trend, (iv) customer satisfaction score trend, (v) strategic initiative tracker (new store openings, ecommerce growth, sustainability targets); (b) CFO View: (i) revenue and gross margin by entity, (ii) cash flow dashboard (operating, investing, financing), (iii) AP aging summary, (iv) AR aging and collection rate, (v) capex spend vs. budget; (c) COO View: (i) supply chain scorecard (fill rate, on-time delivery, DC throughput), (ii) store operations scorecard (sales/sqm, shrinkage rate, customer complaint rate), (iii) safety dashboard (total incidents, lost-time injuries, days since last major incident); (d) CIO View: (i) system uptime (POS and back-office), (ii) IT service desk metrics (ticket volume, resolution time), (iii) cybersecurity dashboard (threat detections, vulnerability patch status); (e) CMO View: (i) marketing ROI by channel (paid social, email, influencer per W1558, local ads per W1559), (ii) ecommerce metrics (orders, GMV, conversion rate), (iii) loyalty program metrics (member growth, active rate, redemption rate)
Responsible (R): BI Analytics Manager / Data Analyst
Accountable (A): CEO
Duration: Initial design: 60 hours; quarterly refresh: 12 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1568_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1568_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1568_Task6" name="Monthly board reporting package">
        <bpmn:documentation>Step 2: Monthly board reporting package: Data Analyst compiles monthly board package: (a) Financial Summary: (i) consolidated P&amp;L vs. budget with variance commentary, (ii) balance sheet highlights (inventory value, cash position, debt), (iii) cash flow summary; (b) Operational Highlights: (i) same-store sales growth by region, (ii) new store openings and pipeline, (iii) ecommerce growth and penetration %, (iv) supply chain performance; (c) Strategic Initiatives: (i) progress on annual strategic priorities, (ii) key milestones achieved, (iii) risks and mitigating actions; (d) People: (i) headcount by entity, (ii) turnover rate, (iii) open positions; (e) Risk &amp; Compliance: (i) significant incidents, (ii) regulatory update, (iii) insurance claims summary; (f) CEO commentary letter: 1-page narrative summarizing the month&#x27;s performance, challenges, and outlook
Responsible (R): Data Analyst / BI Analytics Manager / CFO
Accountable (A): CEO
Duration: 8–10 hours/month</bpmn:documentation>
        <bpmn:incoming>W1568_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1568_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1568_Task7" name="Quarterly strategy review deck">
        <bpmn:documentation>Step 3: Quarterly strategy review deck: BI Analytics Manager prepares quarterly strategy review presentation: (a) 30–40 slide deck covering: (i) quarterly financial performance vs. plan and prior year, (ii) market analysis (competitive landscape, consumer trends), (iii) strategic initiative deep-dive (2–3 initiatives per quarter — e.g., ecommerce expansion, sustainability program, new store format test), (iv) customer analytics deep-dive per W1452, (v) supply chain and inventory analytics per W1399, (vi) financial outlook for next quarter; (b) Senior Data Scientist contributes advanced analytics: (i) predictive revenue forecast for next quarter, (ii) what-if scenario modeling (e.g., &quot;What if typhoon season is worse than expected?&quot;), (iii) competitive intelligence from market data
Responsible (R): BI Analytics Manager / Senior Data Scientist / CFO
Accountable (A): CEO
Duration: 20–30 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1568_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1568_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1568_Task8" name="Ad-hoc executive inquiry support">
        <bpmn:documentation>Step 4: Ad-hoc executive inquiry support: BI Analytics Manager supports ad-hoc data requests from C-suite: (a) CEO asks: &quot;How are our new stores (opened in the last 12 months) performing vs. plan?&quot;; (b) CFO asks: &quot;What is our exposure to vendor X who just declared bankruptcy?&quot;; (c) COO asks: &quot;Which stores have the highest shrinkage rate and what are the common characteristics?&quot;; (d) turnaround time: same-day for simple queries, 2–3 days for complex analysis; (e) frequent ad-hoc queries are candidates for addition to the standard dashboard
Responsible (R): BI Analytics Manager / Data Analyst
Accountable (A): CFO
Duration: ~4 hours/week</bpmn:documentation>
