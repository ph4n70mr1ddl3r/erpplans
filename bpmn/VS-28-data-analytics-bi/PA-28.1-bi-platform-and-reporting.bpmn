      <bpmndi:BPMNPlane id="W879_plane" bpmnElement="W_W879">
        <bpmndi:BPMNShape id="W879_Lane1_di" bpmnElement="W879_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W879_Lane2_di" bpmnElement="W879_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
