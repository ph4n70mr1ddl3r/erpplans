        <bpmndi:BPMNEdge id="W879_Assoc13_di" bpmnElement="W879_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W880" name="W880. BI Dashboard Development, Enhancement &amp; User Request Management" isExecutable="false">
      <bpmn:documentation>Trigger: User request for new dashboard or enhancement; or scheduled quarterly platform improvement
Frequency: ~10–15 new dashboard requests per quarter; ~5–8 enhancement requests per month
Volume: ~60–80 dashboard projects per year; backlog of 15–20 active development items
Owner: BI Developer / BI Manager
Participants: Business Requestor, BI Developer, BI Manager, Data Architect, UX Designer
Source: workflow W880 — BI Dashboard Development, Enhancement &amp; User Request Management</bpmn:documentation>
      <bpmn:laneSet id="W880_LaneSet4">
        <bpmn:lane id="W880_Lane1" name="Business Requestor">
        <bpmn:flowNodeRef>W880_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W880_Lane2" name="BI Developer">
        <bpmn:flowNodeRef>W880_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W880_Lane3" name="Business Requestor + BI Developer">
        <bpmn:flowNodeRef>W880_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W880_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W880_Start5" name="User request for new dashboard or enhancement; or scheduled quarterly platform improvement">
        <bpmn:outgoing>W880_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W880_Task6" name="Receive and log dashboard request — business user submits request via ticketing…">
        <bpmn:documentation>Step 1: Receive and log dashboard request — business user submits request via ticketing system: (a) business question to answer, (b) target audience, (c) required data elements, (d) desired refresh frequency, (e) priority; BI Manager triages and assigns
Responsible (R): Business Requestor
Accountable (A): BI Manager
Duration: 15 min (request)</bpmn:documentation>
        <bpmn:incoming>W880_Flow16</bpmn:incoming>
        <bpmn:outgoing>W880_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task7" name="Conduct requirements workshop — BI Developer meets with requestor to: (a)…">
        <bpmn:documentation>Step 2: Conduct requirements workshop — BI Developer meets with requestor to: (a) understand business process and decision context, (b) define KPIs and visualization requirements, (c) identify data sources and availability, (d) agree on interactivity (filters, drill-down), (e) prototype wireframe
Responsible (R): BI Developer
Accountable (A): BI Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W880_Flow17</bpmn:incoming>
        <bpmn:outgoing>W880_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task8" name="Design data model and ETL — if required data is not in warehouse: (a) design…">
        <bpmn:documentation>Step 3: Design data model and ETL — if required data is not in warehouse: (a) design dimensional model additions, (b) build ETL pipeline to extract from source system, (c) validate data quality, (d) schedule refresh cadence
Responsible (R): BI Developer / Data Architect
Accountable (A): BI Manager
Duration: 8–16 hours</bpmn:documentation>
        <bpmn:incoming>W880_Flow18</bpmn:incoming>
        <bpmn:outgoing>W880_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task9" name="Develop dashboard — build visualization: (a) create measures and calculated…">
        <bpmn:documentation>Step 4: Develop dashboard — build visualization: (a) create measures and calculated fields, (b) design layout and charts, (c) implement interactivity (filters, drill-down, tooltips), (d) apply corporate visual standards, (e) optimize query performance
Responsible (R): BI Developer
Accountable (A): BI Manager
Duration: 16–40 hours</bpmn:documentation>
        <bpmn:incoming>W880_Flow19</bpmn:incoming>
        <bpmn:outgoing>W880_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task10" name="User acceptance testing — requestor validates: (a) numbers match source system…">
        <bpmn:documentation>Step 5: User acceptance testing — requestor validates: (a) numbers match source system, (b) visualizations answer business questions, (c) interactivity works as expected, (d) performance is acceptable (load time &lt; 10 seconds); document and fix issues
Responsible (R): Business Requestor + BI Developer
Accountable (A): BI Manager
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W880_Flow20</bpmn:incoming>
        <bpmn:outgoing>W880_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task11" name="Deploy to production — publish dashboard to BI portal; configure access…">
        <bpmn:documentation>Step 6: Deploy to production — publish dashboard to BI portal; configure access permissions; set refresh schedule; add to report catalog; notify users; provide brief user guide
Responsible (R): BI Developer
Accountable (A): BI Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W880_Flow21</bpmn:incoming>
        <bpmn:outgoing>W880_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W880_Task12" name="Post-deployment monitoring — monitor usage analytics for 30 days: (a) adoption…">
        <bpmn:documentation>Step 7: Post-deployment monitoring — monitor usage analytics for 30 days: (a) adoption rate, (b) user feedback, (c) performance metrics, (d) data accuracy issues; iterate based on feedback
Responsible (R): BI Developer
Accountable (A): BI Manager
Duration: 2 hours (over 30 days)</bpmn:documentation>
        <bpmn:incoming>W880_Flow22</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W880_End13" name="Complete">
        <bpmn:incoming>W880_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W880_Annotation14">
        <bpmn:text>Controls: - CTL-222 (ensure BI data governance &amp; reporting integrity.) | - operational: data may not exist in source systems or may be poor quality
Owner: BI Developer / BI Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W880_Assoc15" sourceRef="W880_Annotation14" targetRef="W880_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W880_Flow16" sourceRef="W880_Start5" targetRef="W880_Task6" />
      <bpmn:sequenceFlow id="W880_Flow17" sourceRef="W880_Task6" targetRef="W880_Task7" />
      <bpmn:sequenceFlow id="W880_Flow18" sourceRef="W880_Task7" targetRef="W880_Task8" />
      <bpmn:sequenceFlow id="W880_Flow19" sourceRef="W880_Task8" targetRef="W880_Task9" />
      <bpmn:sequenceFlow id="W880_Flow20" sourceRef="W880_Task9" targetRef="W880_Task10" />
      <bpmn:sequenceFlow id="W880_Flow21" sourceRef="W880_Task10" targetRef="W880_Task11" />
      <bpmn:sequenceFlow id="W880_Flow22" sourceRef="W880_Task11" targetRef="W880_Task12" />
      <bpmn:sequenceFlow id="W880_Flow23" sourceRef="W880_Task12" targetRef="W880_End13" />
    </bpmn:process>
