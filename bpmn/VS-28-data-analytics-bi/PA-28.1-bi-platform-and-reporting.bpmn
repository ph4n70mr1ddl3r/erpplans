<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-28.1-bi-platform-and-reporting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W879" name="W879. Daily Report Distribution &amp; Automated Dashboard Refresh" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled — daily at 06:00 AM (before store opening) for morning reports; continuous refresh for real-time dashboards
Frequency: Daily (365 days/year — automated with exception monitoring)
Volume: 15–20 automated report distributions per day; 5 real-time dashboards refreshed continuously
Owner: BI Operations Analyst / IT Operations
Participants: BI Manager, Store Managers (report recipients), Regional Managers, Finance Controller, COO
Source: workflow W879 — Daily Report Distribution &amp; Automated Dashboard Refresh</bpmn:documentation>
      <bpmn:laneSet id="W879_LaneSet3">
        <bpmn:lane id="W879_Lane1" name="BI Operations Analyst">
        <bpmn:flowNodeRef>W879_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W879_Lane2" name="BI System">
        <bpmn:flowNodeRef>W879_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W879_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W879_Start4" name="Scheduled — daily at 06:00 AM (before store opening) for morning reports; continuous…">
        <bpmn:outgoing>W879_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W879_Task5" name="ETL batch completion verification — confirm overnight data warehouse refresh…">
        <bpmn:documentation>Step 1: ETL batch completion verification — confirm overnight data warehouse refresh completed successfully (sales, inventory, finance, HR feeds); check for errors or data latency; if failed, initiate W881 exception handling
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W879_Flow14</bpmn:incoming>
        <bpmn:outgoing>W879_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W879_Task6" name="Automated report generation and distribution — system generates: (a) Daily…">
        <bpmn:documentation>Step 2: Automated report generation and distribution — system generates: (a) Daily Sales Flash (by store, region, chain), (b) Daily Inventory Alert (stock-outs, overstock, aging), (c) Daily Cash Reconciliation Summary, (d) Daily POS Performance Report, (e) Daily ecommerce Dashboard; distribute via email and portal per recipient distribution lists
Responsible (R): BI System (automated)
Accountable (A): BI Manager
Duration: 15 min (automated)</bpmn:documentation>
        <bpmn:incoming>W879_Flow15</bpmn:incoming>
        <bpmn:outgoing>W879_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W879_Task7" name="Dashboard refresh validation — verify real-time dashboards reflect current…">
        <bpmn:documentation>Step 3: Dashboard refresh validation — verify real-time dashboards reflect current data: (a) Executive KPI Dashboard, (b) Store Operations Dashboard, (c) Supply Chain Dashboard, (d) Finance Dashboard, (e) Customer Experience Dashboard; check timestamp and data freshness
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W879_Flow16</bpmn:incoming>
        <bpmn:outgoing>W879_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W879_Task8" name="Investigate and resolve data discrepancies — if daily report numbers don&#x27;t…">
        <bpmn:documentation>Step 4: Investigate and resolve data discrepancies — if daily report numbers don&#x27;t match source system (e.g., POS sales don&#x27;t match finance posting), trace data lineage, identify root cause (ETL error, timing difference, data quality issue), and issue corrected report if material
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 30–60 min per discrepancy</bpmn:documentation>
        <bpmn:incoming>W879_Flow17</bpmn:incoming>
        <bpmn:outgoing>W879_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W879_Task9" name="Monitor report delivery success — check email delivery logs; re-send failed…">
        <bpmn:documentation>Step 5: Monitor report delivery success — check email delivery logs; re-send failed distributions; follow up with recipients who report access issues; maintain distribution list accuracy
Responsible (R): BI Operations Analyst
Accountable (A): BI Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W879_Flow18</bpmn:incoming>
        <bpmn:outgoing>W879_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W879_Task10" name="End-of-day data snapshot — at store close (varies by region, 8–10 PM), capture…">
        <bpmn:documentation>Step 6: End-of-day data snapshot — at store close (varies by region, 8–10 PM), capture final daily snapshot for next morning reports; verify POS close-of-day batch completion feeds
Responsible (R): BI System (automated)
Accountable (A): BI Operations Analyst
Duration: 15 min (automated)</bpmn:documentation>
        <bpmn:incoming>W879_Flow19</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W879_End11" name="Complete">
        <bpmn:incoming>W879_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W879_Annotation12">
        <bpmn:text>Controls: - CTL-222 (ensure BI data governance &amp; reporting integrity.) | - operational: quarterly
Owner: BI Operations Analyst / IT Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W879_Assoc13" sourceRef="W879_Annotation12" targetRef="W879_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W879_Flow14" sourceRef="W879_Start4" targetRef="W879_Task5" />
      <bpmn:sequenceFlow id="W879_Flow15" sourceRef="W879_Task5" targetRef="W879_Task6" />
      <bpmn:sequenceFlow id="W879_Flow16" sourceRef="W879_Task6" targetRef="W879_Task7" />
      <bpmn:sequenceFlow id="W879_Flow17" sourceRef="W879_Task7" targetRef="W879_Task8" />
      <bpmn:sequenceFlow id="W879_Flow18" sourceRef="W879_Task8" targetRef="W879_Task9" />
      <bpmn:sequenceFlow id="W879_Flow19" sourceRef="W879_Task9" targetRef="W879_Task10" />
      <bpmn:sequenceFlow id="W879_Flow20" sourceRef="W879_Task10" targetRef="W879_End11" />
    </bpmn:process>
