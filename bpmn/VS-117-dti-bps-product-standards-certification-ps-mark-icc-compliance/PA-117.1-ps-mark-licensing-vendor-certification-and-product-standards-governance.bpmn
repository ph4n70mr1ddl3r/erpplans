      <bpmn:sequenceFlow id="W3667_Flow11" sourceRef="W3667_Task4" targetRef="W3667_Task5" />
      <bpmn:sequenceFlow id="W3667_Flow12" sourceRef="W3667_Task5" targetRef="W3667_Task6" />
      <bpmn:sequenceFlow id="W3667_Flow13" sourceRef="W3667_Task6" targetRef="W3667_End7" />
    </bpmn:process>
