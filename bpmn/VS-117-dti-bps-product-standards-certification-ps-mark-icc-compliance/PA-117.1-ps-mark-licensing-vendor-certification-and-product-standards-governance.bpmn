        <bpmndi:BPMNEdge id="W3666_Flow11_di" bpmnElement="W3666_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3666_Flow12_di" bpmnElement="W3666_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3666_Flow13_di" bpmnElement="W3666_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3666_Assoc9_di" bpmnElement="W3666_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3667" name="W3667. Vendor/Manufacturer PS Mark License Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor onboarding (links to VS-03.1); license expiry; renewal cycle
Frequency: Per vendor + ongoing (license validity 1–3 years)
Volume: ~800–1,000 vendors; regulated-category vendor subset
Owner: Product Compliance Manager / Vendor Management
Participants: Product Compliance Manager, Vendor Mgmt (links to VS-03), Merchandising (links to VS-01), Legal (links to VS-100.3), Quality (links to VS-31), Vendor Scorecard (links to VS-67)
Source: workflow W3667 — Vendor/Manufacturer PS Mark License Management</bpmn:documentation>
      <bpmn:laneSet id="W3667_LaneSet2">
        <bpmn:lane id="W3667_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3667_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3667_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3667_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3667_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3667_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3667_Start3" name="Vendor onboarding (links to VS-03.1); license expiry; renewal cycle">
        <bpmn:outgoing>W3667_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3667_Task4" name="Product Compliance Manager/Vendor Mgmt capture and verify vendor/manufacturer…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Vendor Mgmt capture and verify vendor/manufacturer PS Mark License data for regulated products: license number, scope (product/standard covered), validity period, issuing BPS office, and the supporting factory audit/testing evidence; verify authenticity via DTI-BPS and the vendor portal (links to W3670)
Responsible (R): Product Compliance Manager / Vendor Mgmt
Accountable (A): Product Compliance Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W3667_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3667_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3667_Task5" name="Product Compliance Manager maintain the PS-license register with expiry…">
        <bpmn:documentation>Step 2: Product Compliance Manager maintain the PS-license register with expiry tracking, renewal reminders (90/60/30-day), and the license-to-SKU mapping; gate sourcing on valid license (no PO for a regulated locally-manufactured product without active PS License)
Responsible (R): Product Compliance Manager / Vendor Mgmt / Merchandising
Accountable (A): Product Compliance Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3667_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3667_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3667_Task6" name="Product Compliance Manager manage PS-license lapse and renewal: coordinate…">
        <bpmn:documentation>Step 3: Product Compliance Manager manage PS-license lapse and renewal: coordinate vendor renewal, factory re-audit, and BPS re-issuance; on lapse, block new PO, assess in-stock sell-down authorization vs. Consumer Act, and feed to vendor scorecard (links to VS-67) and audit (links to W3672)
Responsible (R): Product Compliance Manager / Vendor Mgmt
Accountable (A): Product Compliance Manager
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W3667_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3667_End7" name="Complete">
        <bpmn:incoming>W3667_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3667_Annotation8">
        <bpmn:text>Controls: - CTL-157 (ensure PS Mark / ICC certification coverage.) | - operational: expiry tracking and PO gating; operational: DTI-BPS verification (W3670)
Owner: Product Compliance Manager / Vendor Management</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3667_Assoc9" sourceRef="W3667_Annotation8" targetRef="W3667_Start3" associationDirection="None" />
