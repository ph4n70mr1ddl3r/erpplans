      <bpmn:sequenceFlow id="W3671_Flow11" sourceRef="W3671_Task4" targetRef="W3671_Task5" />
      <bpmn:sequenceFlow id="W3671_Flow12" sourceRef="W3671_Task5" targetRef="W3671_Task6" />
      <bpmn:sequenceFlow id="W3671_Flow13" sourceRef="W3671_Task6" targetRef="W3671_End7" />
    </bpmn:process>
