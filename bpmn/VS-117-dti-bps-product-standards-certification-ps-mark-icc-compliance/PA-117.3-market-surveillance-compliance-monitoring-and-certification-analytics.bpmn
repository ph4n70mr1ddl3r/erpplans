      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3682" name="W3682. DTI Market Surveillance Response &amp; Oplan Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: DTI-BPS market-surveillance notice; Oplan inspection; consumer/regulator complaint
Frequency: On event
Volume: Periodic DTI market-surveillance activity
Owner: Product Compliance Manager / Regulatory Officer
Participants: Product Compliance Manager, Regulatory Officer (links to VS-22), Legal (links to VS-100.3), Store Ops (links to VS-07), Merchandising (links to VS-01), Vendor Mgmt (links to VS-03), Audit (links to VS-21), Government Affairs (links to VS-104)
Source: workflow W3682 — DTI Market Surveillance Response &amp; Oplan Coordination</bpmn:documentation>
      <bpmn:laneSet id="W3682_LaneSet2">
        <bpmn:lane id="W3682_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3682_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3682_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3682_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3682_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3682_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3682_Start3" name="DTI-BPS market-surveillance notice; Oplan inspection; consumer/regulator complaint">
        <bpmn:outgoing>W3682_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3682_Task4" name="Product Compliance Manager/Regulatory Officer receive and triage the DTI…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Regulatory Officer receive and triage the DTI market-surveillance action (Oplan visit, test-purchase, sampling notice, or complaint): confirm scope (product/store/standard), assemble the certification evidence (links to W3666–W3668), and coordinate the BuildRight response team
Responsible (R): Product Compliance Manager / Regulatory Officer / Legal
Accountable (A): Product Compliance Manager
Duration: On event</bpmn:documentation>
        <bpmn:incoming>W3682_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3682_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3682_Task5" name="Product Compliance Manager/Legal manage the inspection/response: present…">
        <bpmn:documentation>Step 2: Product Compliance Manager/Legal manage the inspection/response: present current certificates/licenses/technical files, witness any sampling, manage the finding, and respond to DTI within deadlines; coordinate store cooperation (links to VS-07) and vendor involvement (links to VS-03)
Responsible (R): Product Compliance Manager / Legal / Store Ops / Vendor Mgmt
Accountable (A): VP Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3682_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3682_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3682_Task6" name="Product Compliance Manager manage the outcome: on a sustained finding, execute…">
        <bpmn:documentation>Step 3: Product Compliance Manager manage the outcome: on a sustained finding, execute stop-sell/withdrawal (links to W3684) and corrective action, manage any penalty/fine, and report the market-surveillance event and outcome to governance (links to W3665/VS-36), audit (links to VS-21), and government-affairs intelligence (links to VS-104)
Responsible (R): Product Compliance Manager / Regulatory Officer / Legal
Accountable (A): VP Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3682_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3682_End7" name="Complete">
        <bpmn:incoming>W3682_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3682_Annotation8">
        <bpmn:text>Controls: - CTL-582 (ensure controlled execution — Market Surveillance, Compliance Monitoring &amp; Certification Analytics (PA-117.3).) | - operational: in-market monitoring (W3681) and documentation (W3668); operational: proactive compliance and rapid response
Owner: Product Compliance Manager / Regulatory Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3682_Assoc9" sourceRef="W3682_Annotation8" targetRef="W3682_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3682_Flow10" sourceRef="W3682_Start3" targetRef="W3682_Task4" />
      <bpmn:sequenceFlow id="W3682_Flow11" sourceRef="W3682_Task4" targetRef="W3682_Task5" />
      <bpmn:sequenceFlow id="W3682_Flow12" sourceRef="W3682_Task5" targetRef="W3682_Task6" />
      <bpmn:sequenceFlow id="W3682_Flow13" sourceRef="W3682_Task6" targetRef="W3682_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3682_diag">
      <bpmndi:BPMNPlane id="W3682_plane" bpmnElement="W_W3682">
        <bpmndi:BPMNShape id="W3682_Lane1_di" bpmnElement="W3682_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
