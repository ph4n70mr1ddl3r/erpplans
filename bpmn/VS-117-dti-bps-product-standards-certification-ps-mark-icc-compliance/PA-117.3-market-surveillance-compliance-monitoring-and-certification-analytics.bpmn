        <bpmndi:BPMNShape id="W3682_Start3_di" bpmnElement="W3682_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3682_End7_di" bpmnElement="W3682_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3682_Annotation8_di" bpmnElement="W3682_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3682_Flow10_di" bpmnElement="W3682_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3682_Flow11_di" bpmnElement="W3682_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3682_Flow12_di" bpmnElement="W3682_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3682_Flow13_di" bpmnElement="W3682_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3682_Assoc9_di" bpmnElement="W3682_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3683" name="W3683. Consumer Complaint &amp; Certification Non-Conformance Investigation" isExecutable="false">
      <bpmn:documentation>Trigger: Consumer complaint (links to VS-13); quality non-conformance; field failure
Frequency: On event
Volume: Low frequency; links to product liability (W185)
Owner: Product Compliance Manager / Quality
Participants: Product Compliance Manager, Quality (links to VS-31), Customer Service (links to VS-13), Legal (links to VS-100.3/W185), Merchandising (links to VS-01), Vendor Mgmt (links to VS-03), Risk (links to VS-21.2)
Source: workflow W3683 — Consumer Complaint &amp; Certification Non-Conformance Investigation</bpmn:documentation>
      <bpmn:laneSet id="W3683_LaneSet2">
        <bpmn:lane id="W3683_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3683_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3683_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3683_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3683_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3683_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3683_Start3" name="Consumer complaint (links to VS-13); quality non-conformance; field failure">
        <bpmn:outgoing>W3683_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3683_Task4" name="Product Compliance Manager/Quality triage a consumer complaint or field failure…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Quality triage a consumer complaint or field failure on a regulated product for a potential certification non-conformance: capture the product/SKU, batch, the failure mode, and the certification status; determine if the issue indicates a standards/certification deficiency (vs. isolated defect)
Responsible (R): Product Compliance Manager / Quality / Customer Service
Accountable (A): Product Compliance Manager
Duration: On event</bpmn:documentation>
        <bpmn:incoming>W3683_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3683_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3683_Task5" name="Product Compliance Manager/Quality investigate: sample and re-test against the…">
        <bpmn:documentation>Step 2: Product Compliance Manager/Quality investigate: sample and re-test against the PNS (links to W3676/W3680), review the vendor&#x27;s PS License/testing evidence, and determine whether the product fails its certified standard; coordinate with product liability/consumer safety (links to W185) and recall (links to VS-89) where a safety deficiency is indicated
Responsible (R): Product Compliance Manager / Quality / Lab
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3683_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3683_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3683_Task6" name="Product Compliance Manager manage the outcome: on confirmed certification…">
        <bpmn:documentation>Step 3: Product Compliance Manager manage the outcome: on confirmed certification non-conformance, trigger stop-sell/corrective action (links to W3684), notify DTI-BPS if required, drive vendor CAPA (links to W3670), and recover cost (links to W3686); feed learning to standards mapping (W3666) and quality (links to VS-31)
Responsible (R): Product Compliance Manager / Vendor Mgmt / Legal
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3683_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3683_End7" name="Complete">
        <bpmn:incoming>W3683_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3683_Annotation8">
        <bpmn:text>Controls: - CTL-582 (ensure controlled execution — Market Surveillance, Compliance Monitoring &amp; Certification Analytics (PA-117.3).) | - operational: re-test and vendor review; operational: regulatory triage
Owner: Product Compliance Manager / Quality</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3683_Assoc9" sourceRef="W3683_Annotation8" targetRef="W3683_Start3" associationDirection="None" />
