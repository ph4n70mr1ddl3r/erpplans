        <bpmn:lane id="W3686_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3686_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3686_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3686_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3686_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3686_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3686_Start3" name="Sample failure (W3679); non-conformance corrective action (W3684); DTI penalty">
        <bpmn:outgoing>W3686_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3686_Task4" name="Product Compliance Manager/Finance quantify the recoverable certification-event…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Finance quantify the recoverable certification-event cost: product loss/re-export/destruction, freight and demurrage, re-procurement differential, re-test, stop-sale revenue loss, and any DTI fine/penalty attributable to vendor non-conformance
Responsible (R): Product Compliance Manager / Finance / Quality
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3686_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3686_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3686_Task5" name="Product Compliance Manager/Vendor Mgmt/Legal pursue vendor recovery per…">
        <bpmn:documentation>Step 2: Product Compliance Manager/Vendor Mgmt/Legal pursue vendor recovery per contract indemnity: issue the debit memo/chargeback (links to VS-15/W245), negotiate settlement, and manage vendor dispute (links to VS-03.3/W869); coordinate with legal on contested recovery (links to VS-100)
Responsible (R): Product Compliance Manager / Vendor Mgmt / Legal / Finance
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3686_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3686_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3686_Task6" name="Product Compliance Manager capture recovery to closure, feed the event to the…">
        <bpmn:documentation>Step 3: Product Compliance Manager capture recovery to closure, feed the event to the vendor scorecard (links to VS-67) and vendor CAPA (links to W3670), and report recovery performance to program analytics (links to W3688) and governance (links to W3665)
Responsible (R): Product Compliance Manager / Vendor Mgmt / Finance
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3686_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3686_End7" name="Complete">
        <bpmn:incoming>W3686_Flow13</bpmn:incoming>
      </bpmn:endEvent>
