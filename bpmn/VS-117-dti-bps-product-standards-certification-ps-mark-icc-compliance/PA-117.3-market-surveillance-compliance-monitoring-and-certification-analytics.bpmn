        <bpmndi:BPMNEdge id="W3683_Flow11_di" bpmnElement="W3683_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3683_Flow12_di" bpmnElement="W3683_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3683_Flow13_di" bpmnElement="W3683_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3683_Assoc9_di" bpmnElement="W3683_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3684" name="W3684. Stop-Sale, Withdrawal &amp; Certification Corrective Action" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed non-conformance (W3683); market-surveillance finding (W3682); license lapse (W3670)
Frequency: On event
Volume: Low frequency; cross-200-store impact
Owner: Product Compliance Manager / Merchandising
Participants: Product Compliance Manager, Merchandising (links to VS-01), Store Ops (links to VS-07), DC (links to VS-04), Quality (links to VS-31), Import (links to VS-02.2), POS (links to VS-08), Recall (links to VS-89), Legal (links to VS-100.3)
Source: workflow W3684 — Stop-Sale, Withdrawal &amp; Certification Corrective Action</bpmn:documentation>
      <bpmn:laneSet id="W3684_LaneSet2">
        <bpmn:lane id="W3684_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3684_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3684_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3684_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3684_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3684_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3684_Start3" name="Confirmed non-conformance (W3683); market-surveillance finding (W3682); license lapse…">
        <bpmn:outgoing>W3684_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3684_Task4" name="Product Compliance Manager/Merchandising place the affected regulated product…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Merchandising place the affected regulated product on stop-sale across stores, DC, ecommerce, and marketplace (links to VS-08/VS-04/VS-10/VS-65): set the SKU non-saleable, quarantine on-hand stock, and halt new PO/import pending corrective action
Responsible (R): Product Compliance Manager / Merchandising / Store Ops / DC
Accountable (A): Product Compliance Manager
Duration: On event</bpmn:documentation>
        <bpmn:incoming>W3684_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3684_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3684_Task5" name="Product Compliance Manager/Quality determine the corrective action: vendor…">
        <bpmn:documentation>Step 2: Product Compliance Manager/Quality determine the corrective action: vendor re-certification/re-test/re-marking, product rework, or withdrawal/destruction; coordinate the in-market withdrawal (links to VS-32 reverse logistics) and assess recall triggering (links to VS-89) where consumer safety is at issue
Responsible (R): Product Compliance Manager / Quality / Vendor Mgmt
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3684_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3684_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3684_Task6" name="Product Compliance Manager manage re-certification and re-release: confirm the…">
        <bpmn:documentation>Step 3: Product Compliance Manager manage re-certification and re-release: confirm the corrective action, re-verify certification/mark, lift the stop-sell, and restock; capture the event cost and feed to vendor recovery (links to W3686), quality CAPA (links to VS-31), and program analytics (links to W3688)
Responsible (R): Product Compliance Manager / Merchandising / Quality
Accountable (A): Product Compliance Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3684_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3684_End7" name="Complete">
        <bpmn:incoming>W3684_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3684_Annotation8">
        <bpmn:text>Controls: - CTL-582 (ensure controlled execution — Market Surveillance, Compliance Monitoring &amp; Certification Analytics (PA-117.3).) | - operational: rapid corrective action and re-release; operational: system-enforced stop-sell and DC/store reconciliation
Owner: Product Compliance Manager / Merchandising</bpmn:text>
      </bpmn:textAnnotation>
