        <bpmn:outgoing>W3685_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3685_Task4" name="Product Compliance Manager/Finance capture the full certification cost per…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Finance capture the full certification cost per regulated SKU/shipment: BPS fees, accredited-lab testing, ICC stickers, inspection/witness labor, demurrage from certification delay, and re-test/failure cost; allocate to landed cost (links to W144/VS-02.2) and COGS (links to VS-17)
Responsible (R): Product Compliance Manager / Finance / Import
Accountable (A): Product Compliance Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3685_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3685_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3685_Task5" name="Product Compliance Manager/BI analyze certification lead-time and cost: ICC…">
        <bpmn:documentation>Step 2: Product Compliance Manager/BI analyze certification lead-time and cost: ICC cycle-time by product/lab/lane, cost-per-SKU, cost-as-% of landed cost, and demurrage-attributable-to-certification; benchmark and identify optimization (lab selection, parallel filing, supplier shift to SOC)
Responsible (R): Product Compliance Manager / BI / Finance
Accountable (A): Product Compliance Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3685_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3685_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3685_Task6" name="Product Compliance Manager publish certification cost/lead-time analytics to…">
        <bpmn:documentation>Step 3: Product Compliance Manager publish certification cost/lead-time analytics to merchandising (links to VS-01 — sourcing/pricing implications), FP&amp;A (links to VS-17.4), and program governance (links to W3665); drive cost-reduction and lead-time actions into the program
Responsible (R): Product Compliance Manager / Finance / BI
Accountable (A): Product Compliance Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3685_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3685_End7" name="Complete">
        <bpmn:incoming>W3685_Flow13</bpmn:incoming>
      </bpmn:endEvent>
