<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-117.3-market-surveillance-compliance-monitoring-and-certification-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3681" name="W3681. In-Market Compliance Monitoring &amp; Store Shelf Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monitoring cycle; risk-based audit; new product on shelf
Frequency: Periodic + risk-based
Volume: 200 stores; regulated-SKU subset
Owner: Product Compliance Manager / Store Operations
Participants: Product Compliance Manager, Store Ops (links to VS-07), LP (links to VS-23), Quality (links to VS-31), Merchandising (links to VS-01), Audit (links to VS-21)
Source: workflow W3681 — In-Market Compliance Monitoring &amp; Store Shelf Audit</bpmn:documentation>
      <bpmn:laneSet id="W3681_LaneSet2">
        <bpmn:lane id="W3681_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3681_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3681_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3681_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3681_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3681_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3681_Start3" name="Monitoring cycle; risk-based audit; new product on shelf">
        <bpmn:outgoing>W3681_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3681_Task4" name="Product Compliance Manager/Store Ops conduct periodic in-market certification…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Store Ops conduct periodic in-market certification compliance audits across stores and DCs: verify PS Mark/ICC mark presence on regulated products on shelf, match to current certificates/licenses (links to W3666/W3667), and flag missing/expired marks for action
Responsible (R): Product Compliance Manager / Store Ops / LP
Accountable (A): Product Compliance Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3681_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3681_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3681_Task5" name="Product Compliance Manager manage exceptions: investigate a regulated product…">
        <bpmn:documentation>Step 2: Product Compliance Manager manage exceptions: investigate a regulated product found on shelf without valid certification, determine root cause (PO/GR gating failure, license lapse, sticker not applied), and trigger stop-sell (links to W3684) and corrective action
Responsible (R): Product Compliance Manager / Quality / Store Ops
Accountable (A): Product Compliance Manager
Duration: On finding</bpmn:documentation>
        <bpmn:incoming>W3681_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3681_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3681_Task6" name="Product Compliance Manager/Audit publish compliance-monitoring results…">
        <bpmn:documentation>Step 3: Product Compliance Manager/Audit publish compliance-monitoring results: certification-conformance rate by category/store/vendor, recurring failure patterns, and the corrective-action backlog; report to program governance (links to W3665) and audit (links to VS-21)
Responsible (R): Product Compliance Manager / Audit
Accountable (A): Product Compliance Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3681_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3681_End7" name="Complete">
        <bpmn:incoming>W3681_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3681_Annotation8">
        <bpmn:text>Controls: - CTL-582 (ensure controlled execution — Market Surveillance, Compliance Monitoring &amp; Certification Analytics (PA-117.3).) | - operational: periodic audit; operational: exception root-cause and gating fix
Owner: Product Compliance Manager / Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3681_Assoc9" sourceRef="W3681_Annotation8" targetRef="W3681_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3681_Flow10" sourceRef="W3681_Start3" targetRef="W3681_Task4" />
      <bpmn:sequenceFlow id="W3681_Flow11" sourceRef="W3681_Task4" targetRef="W3681_Task5" />
      <bpmn:sequenceFlow id="W3681_Flow12" sourceRef="W3681_Task5" targetRef="W3681_Task6" />
      <bpmn:sequenceFlow id="W3681_Flow13" sourceRef="W3681_Task6" targetRef="W3681_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3681_diag">
      <bpmndi:BPMNPlane id="W3681_plane" bpmnElement="W_W3681">
        <bpmndi:BPMNShape id="W3681_Lane1_di" bpmnElement="W3681_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
