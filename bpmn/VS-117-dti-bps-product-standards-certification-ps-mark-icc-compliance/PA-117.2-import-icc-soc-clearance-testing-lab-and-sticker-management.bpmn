        <bpmndi:BPMNEdge id="W3673_Flow11_di" bpmnElement="W3673_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3673_Flow12_di" bpmnElement="W3673_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3673_Flow13_di" bpmnElement="W3673_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3673_Assoc9_di" bpmnElement="W3673_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3674" name="W3674. Shipment Documentation &amp; BPS Documentary Review" isExecutable="false">
      <bpmn:documentation>Trigger: ICC/SOC application (W3673); BPS review request
Frequency: Per shipment
Volume: Per regulated import shipment
Owner: Import Coordinator / Customs Broker
Participants: Import Coordinator, Customs Broker, Product Compliance Manager, Vendor, Legal (links to VS-100.3), Records (links to VS-88)
Source: workflow W3674 — Shipment Documentation &amp; BPS Documentary Review</bpmn:documentation>
      <bpmn:laneSet id="W3674_LaneSet2">
        <bpmn:lane id="W3674_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W3674_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3674_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3674_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3674_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3674_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3674_Start3" name="ICC/SOC application (W3673); BPS review request">
        <bpmn:outgoing>W3674_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3674_Task4" name="Import Coordinator/Customs Broker assemble and submit the documentary package…">
        <bpmn:documentation>Step 1: Import Coordinator/Customs Broker assemble and submit the documentary package for BPS review: validated Bill of Lading, Packing List, Commercial Invoice, Certificate of Origin, the foreign maker&#x27;s PS License (for SOC), test reports where required, and the product/standard identification
Responsible (R): Import Coordinator / Customs Broker
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3674_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3674_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3674_Task5" name="Import Coordinator manages the BPS documentary-review loop: respond to queries…">
        <bpmn:documentation>Step 2: Import Coordinator manages the BPS documentary-review loop: respond to queries, correct deficiencies, and confirm product-to-standard classification with BPS; coordinate with the vendor for missing/incorrect origin documents
Responsible (R): Import Coordinator / Vendor
Accountable (A): Product Compliance Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W3674_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3674_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3674_Task6" name="Import Coordinator/Records archive the complete documentary package to the…">
        <bpmn:documentation>Step 3: Import Coordinator/Records archive the complete documentary package to the technical file (links to W3668) and ICC register (links to W3672) per retention (links to VS-88), supporting customs entry (links to VS-87) and future audit
Responsible (R): Import Coordinator / Records
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3674_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3674_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3674_End7" name="Complete">
        <bpmn:incoming>W3674_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3674_Annotation8">
        <bpmn:text>Controls: - CTL-581 (ensure controlled execution — Import ICC/SOC Clearance, Testing Lab &amp; Sticker Management (PA-117.2).) | - operational: pre-shipment vendor coordination; operational: Product Compliance review
Owner: Import Coordinator / Customs Broker</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3674_Assoc9" sourceRef="W3674_Annotation8" targetRef="W3674_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3674_Flow10" sourceRef="W3674_Start3" targetRef="W3674_Task4" />
      <bpmn:sequenceFlow id="W3674_Flow11" sourceRef="W3674_Task4" targetRef="W3674_Task5" />
      <bpmn:sequenceFlow id="W3674_Flow12" sourceRef="W3674_Task5" targetRef="W3674_Task6" />
      <bpmn:sequenceFlow id="W3674_Flow13" sourceRef="W3674_Task6" targetRef="W3674_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3674_diag">
      <bpmndi:BPMNPlane id="W3674_plane" bpmnElement="W_W3674">
        <bpmndi:BPMNShape id="W3674_Lane1_di" bpmnElement="W3674_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
