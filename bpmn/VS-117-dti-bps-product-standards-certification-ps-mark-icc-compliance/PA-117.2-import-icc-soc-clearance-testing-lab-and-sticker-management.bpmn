        <bpmndi:BPMNShape id="W3675_Task6_di" bpmnElement="W3675_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3675_Task7_di" bpmnElement="W3675_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3675_Start4_di" bpmnElement="W3675_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3675_End8_di" bpmnElement="W3675_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3675_Annotation9_di" bpmnElement="W3675_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3675_Flow11_di" bpmnElement="W3675_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3675_Flow12_di" bpmnElement="W3675_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3675_Flow13_di" bpmnElement="W3675_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3675_Flow14_di" bpmnElement="W3675_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3675_Assoc10_di" bpmnElement="W3675_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3676" name="W3676. Accredited Laboratory Testing &amp; Results Management" isExecutable="false">
      <bpmn:documentation>Trigger: BPS sampling (W3675); test request
Frequency: Per shipment (and per PS License factory audit)
Volume: Per regulated shipment / per product re-test
Owner: Product Compliance Manager / Quality
Participants: Product Compliance Manager, Quality (links to VS-31), Accredited Lab (links to W3680), Import Coordinator, Vendor, DC
Source: workflow W3676 — Accredited Laboratory Testing &amp; Results Management</bpmn:documentation>
      <bpmn:laneSet id="W3676_LaneSet2">
        <bpmn:lane id="W3676_Lane1" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3676_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3676_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3676_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3676_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3676_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3676_Start3" name="BPS sampling (W3675); test request">
        <bpmn:outgoing>W3676_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3676_Task4" name="Product Compliance Manager/Quality dispatch samples to the DTI-accredited…">
        <bpmn:documentation>Step 1: Product Compliance Manager/Quality dispatch samples to the DTI-accredited laboratory and manage the test program: confirm the applicable PNS test methods (e.g., tensile/yield for steel, compressive strength for cement, electrical safety for wires/breakers), the sample integrity, and the test scope
Responsible (R): Product Compliance Manager / Quality / Lab
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3676_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3676_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3676_Task5" name="Product Compliance Manager/Lab track testing to completion (5–10 days typical)…">
        <bpmn:documentation>Step 2: Product Compliance Manager/Lab track testing to completion (5–10 days typical), manage re-test where a result is borderline/inconclusive, and capture the test report into the technical file (links to W3668) and ICC application (links to W3673)
Responsible (R): Product Compliance Manager / Lab
Accountable (A): Product Compliance Manager
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W3676_Flow11</bpmn:incoming>
