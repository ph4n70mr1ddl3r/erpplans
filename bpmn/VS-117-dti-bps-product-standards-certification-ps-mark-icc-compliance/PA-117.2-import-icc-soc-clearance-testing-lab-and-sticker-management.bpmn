      <bpmn:sequenceFlow id="W3680_Flow12" sourceRef="W3680_Task5" targetRef="W3680_Task6" />
      <bpmn:sequenceFlow id="W3680_Flow13" sourceRef="W3680_Task6" targetRef="W3680_End7" />
    </bpmn:process>
