<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-117.2-import-icc-soc-clearance-testing-lab-and-sticker-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3673" name="W3673. Import ICC/SOC Application &amp; PCIMS Portal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Import PO for regulated product (links to VS-02.2/W2B); shipment departure
Frequency: Per import shipment of regulated goods
Volume: ~10–15 regulated import shipments/month (~400–600 TEUs/month total imports)
Owner: Import Coordinator / Product Compliance Manager
Participants: Import Coordinator, Product Compliance Manager, Customs Broker (links to VS-87), Buyer (links to VS-01), Vendor (links to VS-03), DC (links to VS-04)
Source: workflow W3673 — Import ICC/SOC Application &amp; PCIMS Portal Management</bpmn:documentation>
      <bpmn:laneSet id="W3673_LaneSet2">
        <bpmn:lane id="W3673_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W3673_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3673_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3673_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3673_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3673_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3673_Start3" name="Import PO for regulated product (links to VS-02.2/W2B); shipment departure">
        <bpmn:outgoing>W3673_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3673_Task4" name="Import Coordinator/Product Compliance Manager file the ICC or SOC application…">
        <bpmn:documentation>Step 1: Import Coordinator/Product Compliance Manager file the ICC or SOC application via DTI&#x27;s PCIMS portal upon shipment departure from origin: select ICC (foreign maker without PS License) vs. SOC (foreign maker holds valid PS License), attach the Bill of Lading, Packing List, Commercial Invoice, and Certificate of Origin, and pay the BPS fee
Responsible (R): Import Coordinator / Product Compliance Manager
Accountable (A): Product Compliance Manager
Duration: 1 hour/shipment</bpmn:documentation>
        <bpmn:incoming>W3673_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3673_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3673_Task5" name="Import Coordinator manages the PCIMS application lifecycle: track status…">
        <bpmn:documentation>Step 2: Import Coordinator manages the PCIMS application lifecycle: track status, respond to BPS queries, manage the documentary-review loop (W3674), and coordinate timing against vessel arrival, customs release (links to VS-87), and DC delivery (links to VS-04) to minimize port dwell/demurrage (links to W249)
Responsible (R): Import Coordinator / Customs Broker
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3673_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3673_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3673_Task6" name="Import Coordinator/Product Compliance Manager maintain the ICC/SOC application…">
        <bpmn:documentation>Step 3: Import Coordinator/Product Compliance Manager maintain the ICC/SOC application register, forecast upcoming regulated-import demand for BPS resource/lab planning (links to W3680), and report ICC cycle-time and clearance rate to program analytics (links to W3685)
Responsible (R): Import Coordinator / Product Compliance Manager
Accountable (A): Product Compliance Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3673_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3673_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3673_End7" name="Complete">
        <bpmn:incoming>W3673_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3673_Annotation8">
        <bpmn:text>Controls: - CTL-581 (ensure controlled execution — Import ICC/SOC Clearance, Testing Lab &amp; Sticker Management (PA-117.2).) | - operational: checklist and pre-submission review; operational: early filing and lab planning (W3680)
Owner: Import Coordinator / Product Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3673_Assoc9" sourceRef="W3673_Annotation8" targetRef="W3673_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3673_Flow10" sourceRef="W3673_Start3" targetRef="W3673_Task4" />
      <bpmn:sequenceFlow id="W3673_Flow11" sourceRef="W3673_Task4" targetRef="W3673_Task5" />
      <bpmn:sequenceFlow id="W3673_Flow12" sourceRef="W3673_Task5" targetRef="W3673_Task6" />
      <bpmn:sequenceFlow id="W3673_Flow13" sourceRef="W3673_Task6" targetRef="W3673_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3673_diag">
      <bpmndi:BPMNPlane id="W3673_plane" bpmnElement="W_W3673">
        <bpmndi:BPMNShape id="W3673_Lane1_di" bpmnElement="W3673_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
