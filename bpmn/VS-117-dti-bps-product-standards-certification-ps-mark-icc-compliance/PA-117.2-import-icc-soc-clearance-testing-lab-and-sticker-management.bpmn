      <bpmn:sequenceFlow id="W3675_Flow12" sourceRef="W3675_Task5" targetRef="W3675_Task6" />
      <bpmn:sequenceFlow id="W3675_Flow13" sourceRef="W3675_Task6" targetRef="W3675_Task7" />
      <bpmn:sequenceFlow id="W3675_Flow14" sourceRef="W3675_Task7" targetRef="W3675_End8" />
    </bpmn:process>
