        <bpmndi:BPMNShape id="W3674_Start3_di" bpmnElement="W3674_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3674_End7_di" bpmnElement="W3674_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3674_Annotation8_di" bpmnElement="W3674_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3674_Flow10_di" bpmnElement="W3674_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3674_Flow11_di" bpmnElement="W3674_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3674_Flow12_di" bpmnElement="W3674_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3674_Flow13_di" bpmnElement="W3674_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3674_Assoc9_di" bpmnElement="W3674_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3675" name="W3675. DTI Inspection, Sampling &amp; Witness Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Shipment arrival at port/DC; BPS inspection notice
Frequency: Per shipment (inspection may be random/witnessed)
Volume: Per regulated import shipment
Owner: Import Coordinator / Product Compliance Manager
Participants: Import Coordinator, Product Compliance Manager, DTI Inspector, Customs Broker (links to VS-87), DC/QC (links to VS-04/VS-31), Vendor
Source: workflow W3675 — DTI Inspection, Sampling &amp; Witness Coordination</bpmn:documentation>
      <bpmn:laneSet id="W3675_LaneSet3">
        <bpmn:lane id="W3675_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W3675_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3675_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3675_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3675_Lane2" name="Product Compliance Manager">
        <bpmn:flowNodeRef>W3675_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3675_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3675_Start4" name="Shipment arrival at port/DC; BPS inspection notice">
        <bpmn:outgoing>W3675_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3675_Task5" name="Import Coordinator/Product Compliance Manager coordinate the DTI physical…">
        <bpmn:documentation>Step 1: Import Coordinator/Product Compliance Manager coordinate the DTI physical inspection and sampling upon arrival: schedule the BPS inspector at port or DC, confirm the lot/sample location, and arrange BuildRight witness (QC/Product Compliance) per BPS procedure
Responsible (R): Import Coordinator / Product Compliance Manager / DC-QC
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3675_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3675_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3675_Task6" name="Product Compliance Manager/QC witness the BPS inspection and sampling: confirm…">
        <bpmn:documentation>Step 2: Product Compliance Manager/QC witness the BPS inspection and sampling: confirm representative random sampling per the PNS sampling plan, document the sample draw (quantities, lot/batch, photos), and manage chain-of-custody to the accredited lab (links to W3676)
Responsible (R): Product Compliance Manager / QC
Accountable (A): Product Compliance Manager
Duration: 4 hours/shipment</bpmn:documentation>
        <bpmn:incoming>W3675_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3675_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3675_Task7" name="Import Coordinator manages post-inspection: release of the unsampled balance…">
        <bpmn:documentation>Step 3: Import Coordinator manages post-inspection: release of the unsampled balance (where BPS permits), hold of sampled lots pending test results (links to W3676), and coordination with customs release (links to W3677) and DC putaway (links to VS-04)
Responsible (R): Import Coordinator / DC
Accountable (A): Product Compliance Manager
Duration: Per shipment</bpmn:documentation>
        <bpmn:incoming>W3675_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3675_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3675_End8" name="Complete">
        <bpmn:incoming>W3675_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3675_Annotation9">
        <bpmn:text>Controls: - CTL-581 (ensure controlled execution — Import ICC/SOC Clearance, Testing Lab &amp; Sticker Management (PA-117.2).) | - operational: witnessed sampling and PNS procedure; operational: expediting testing (W3676)
Owner: Import Coordinator / Product Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3675_Assoc10" sourceRef="W3675_Annotation9" targetRef="W3675_Start4" associationDirection="None" />
