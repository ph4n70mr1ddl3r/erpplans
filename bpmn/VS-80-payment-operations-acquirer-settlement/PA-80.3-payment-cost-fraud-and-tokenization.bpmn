        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2798_Start5" name="Suspected breach, terminal compromise, or acquirer incident notice">
        <bpmn:outgoing>W2798_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2798_Task6" name="IT Incident contains incident (isolate terminal/system); IT Security starts…">
        <bpmn:documentation>Step 1: IT Incident contains incident (isolate terminal/system); IT Security starts forensic capture; Payment Ops Manager notifies acquirer/scheme per agreement
Responsible (R): IT Incident / IT Security
Accountable (A): Payment Operations Manager
Duration: 1–4 hours</bpmn:documentation>
        <bpmn:incoming>W2798_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2798_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2798_Task7" name="Payment Ops Manager coordinates PCI-PFI (PCI Forensic Investigator) engagement…">
        <bpmn:documentation>Step 2: Payment Ops Manager coordinates PCI-PFI (PCI Forensic Investigator) engagement if breach suspected; notifies BSP and NPC where cardholder/personal data involved
Responsible (R): Payment Ops Manager / Legal
Accountable (A): CFO
Duration: 24–72 hours</bpmn:documentation>
        <bpmn:incoming>W2798_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2798_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2798_Task8" name="Legal manages regulatory notification and customer notification per Data…">
        <bpmn:documentation>Step 3: Legal manages regulatory notification and customer notification per Data Privacy Act; Payment Ops Manager executes remediation and post-incident review
Responsible (R): Legal / Payment Ops Manager
Accountable (A): CFO
Duration: Weeks</bpmn:documentation>
        <bpmn:incoming>W2798_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2798_End9" name="Complete">
        <bpmn:incoming>W2798_Flow15</bpmn:incoming>
      </bpmn:endEvent>
