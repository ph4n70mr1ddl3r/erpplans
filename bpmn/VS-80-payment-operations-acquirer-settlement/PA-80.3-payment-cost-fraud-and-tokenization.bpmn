    <bpmn:process id="W_W2800" name="W2800. Payment Channel Performance, Cost-to-Serve &amp; Tender Mix Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly management reporting
Frequency: Monthly + quarterly board
Volume: All tenders, all channels
Owner: Finance Analyst
Participants: Finance Analyst, Payment Ops Manager, FP&amp;A, Marketing
Source: workflow W2800 — Payment Channel Performance, Cost-to-Serve &amp; Tender Mix Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2800_LaneSet4">
        <bpmn:lane id="W2800_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2800_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2800_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2800_Lane2" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2800_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2800_Lane3" name="FP&amp;A">
        <bpmn:flowNodeRef>W2800_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2800_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2800_Start5" name="Monthly management reporting">
        <bpmn:outgoing>W2800_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2800_Task6" name="Finance Analyst prepares payment dashboard: tender mix %, cost-per-transaction…">
        <bpmn:documentation>Step 1: Finance Analyst prepares payment dashboard: tender mix %, cost-per-transaction by tender, settlement timing, dispute/chargeback ratio, fraud rate
Responsible (R): Finance Analyst
Accountable (A): Payment Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2800_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2800_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2800_Task7" name="Payment Ops Manager reports to FP&amp;A and Marketing; recommends tender-mix…">
        <bpmn:documentation>Step 2: Payment Ops Manager reports to FP&amp;A and Marketing; recommends tender-mix strategy (e-wallet incentives to reduce cash handling cost, BNPL expansion in appliances)
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2800_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2800_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2800_Task8" name="FP&amp;A incorporates payment cost into financial plan; benchmarks vs. industry…">
        <bpmn:documentation>Step 3: FP&amp;A incorporates payment cost into financial plan; benchmarks vs. industry; presents quarterly to Executive Committee
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2800_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2800_End9" name="Complete">
        <bpmn:incoming>W2800_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2800_Annotation10">
        <bpmn:text>Controls: - CTL-471 (ensure controlled execution — Payment Cost, Fraud &amp; Tokenization Governance (PA-80.3).) | - operational: data-driven migration incentives
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
