    <bpmn:process id="W_W2795" name="W2795. Payment Fraud Rule &amp; Velocity/Limit Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: Fraud pattern detected or periodic rule tuning
Frequency: Monthly review; event-driven
Volume: ~42,900 ecommerce orders/month; CNP fraud exposure
Owner: Fraud Operations Analyst
Participants: Fraud Ops Analyst, Ecommerce, LP, Payment Ops Manager
Source: workflow W2795 — Payment Fraud Rule &amp; Velocity/Limit Configuration</bpmn:documentation>
      <bpmn:laneSet id="W2795_LaneSet3">
        <bpmn:lane id="W2795_Lane1" name="Fraud Ops Analyst">
        <bpmn:flowNodeRef>W2795_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2795_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2795_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2795_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W2795_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2795_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2795_Start4" name="Fraud pattern detected or periodic rule tuning">
        <bpmn:outgoing>W2795_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2795_Task5" name="Fraud Ops Analyst monitors fraud signals (velocity, BIN risk, device…">
        <bpmn:documentation>Step 1: Fraud Ops Analyst monitors fraud signals (velocity, BIN risk, device fingerprint mismatch, address mismatch); tunes fraud-scoring rules in gateway/ecommerce
Responsible (R): Fraud Ops Analyst
Accountable (A): Payment Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2795_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2795_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2795_Task6" name="Ecommerce/LP reviews manual-review queue; approves/declines flagged orders…">
        <bpmn:documentation>Step 2: Ecommerce/LP reviews manual-review queue; approves/declines flagged orders; contacts customer for verification on borderline cases
Responsible (R): Ecommerce / LP
Accountable (A): Fraud Ops Analyst
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2795_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2795_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2795_Task7" name="Fraud Ops Analyst updates velocity limits and blocklists; reports fraud rate…">
        <bpmn:documentation>Step 3: Fraud Ops Analyst updates velocity limits and blocklists; reports fraud rate vs. target (&lt; 0.1%) and chargeback ratio vs. scheme threshold (1% Visa/MC)
Responsible (R): Fraud Ops Analyst
Accountable (A): Payment Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2795_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2795_End8" name="Complete">
        <bpmn:incoming>W2795_Flow14</bpmn:incoming>
      </bpmn:endEvent>
