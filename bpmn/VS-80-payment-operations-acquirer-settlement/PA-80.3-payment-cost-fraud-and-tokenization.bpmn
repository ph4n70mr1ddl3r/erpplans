    <bpmn:process id="W_W2796" name="W2796. Terminal Key Injection, HSM &amp; PIN Security Management" isExecutable="false">
      <bpmn:documentation>Trigger: Terminal provisioning or key injection cycle
Frequency: Event-driven; ~600 terminals
Volume: ~600 POS terminals across 200 stores (3/store); key injection at provisioning + periodic rotation per scheme mandates
Owner: IT Security Manager
Participants: IT Security, Terminal Vendor, Payment Ops Manager
Source: workflow W2796 — Terminal Key Injection, HSM &amp; PIN Security Management</bpmn:documentation>
      <bpmn:laneSet id="W2796_LaneSet4">
        <bpmn:lane id="W2796_Lane1" name="Terminal Vendor">
        <bpmn:flowNodeRef>W2796_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2796_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2796_Lane2" name="IT Security">
        <bpmn:flowNodeRef>W2796_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2796_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2796_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2796_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2796_Start5" name="Terminal provisioning or key injection cycle">
        <bpmn:outgoing>W2796_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2796_Task6" name="Terminal vendor injects cryptographic keys (under dual-control) at secured…">
        <bpmn:documentation>Step 1: Terminal vendor injects cryptographic keys (under dual-control) at secured facility or remotely via HSM; documents key-injection certificate
Responsible (R): Terminal Vendor / IT Security
Accountable (A): IT Security Manager
Duration: Per terminal</bpmn:documentation>
        <bpmn:incoming>W2796_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2796_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2796_Task7" name="IT Security maintains Hardware Security Module (HSM) for key…">
        <bpmn:documentation>Step 2: IT Security maintains Hardware Security Module (HSM) for key generation/storage; rotates keys per scheme mandates; audits access logs
Responsible (R): IT Security
Accountable (A): IT Security Manager
Duration: Per rotation</bpmn:documentation>
        <bpmn:incoming>W2796_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2796_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2796_Task8" name="Payment Ops Manager validates terminal encryption (PIN block, SRED) before…">
        <bpmn:documentation>Step 3: Payment Ops Manager validates terminal encryption (PIN block, SRED) before deployment; archives key-injection certificates for audit
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: Per deployment</bpmn:documentation>
