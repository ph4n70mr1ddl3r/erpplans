    <bpmn:process id="W_W2798" name="W2798. Payment System Incident, Breach &amp; Forensic Response" isExecutable="false">
      <bpmn:documentation>Trigger: Suspected breach, terminal compromise, or acquirer incident notice
Frequency: Event-driven; rare
Volume: ~1–5 incidents/year
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, IT Security, IT Incident, Legal, BSP/NPC (if breach), Acquirer
Source: workflow W2798 — Payment System Incident, Breach &amp; Forensic Response</bpmn:documentation>
      <bpmn:laneSet id="W2798_LaneSet4">
        <bpmn:lane id="W2798_Lane1" name="IT Incident">
        <bpmn:flowNodeRef>W2798_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2798_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
