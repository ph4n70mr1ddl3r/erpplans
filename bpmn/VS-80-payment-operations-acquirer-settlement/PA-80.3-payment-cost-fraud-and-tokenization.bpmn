    <bpmn:process id="W_W2794" name="W2794. Cardholder Data Environment (CDE) Boundary &amp; Tokenization Vault Governance" isExecutable="false">
      <bpmn:documentation>Trigger: New system touching PAN or scope change
Frequency: Continuous governance
Volume: Tokenization vault servicing ecommerce + repeat customers
Owner: IT Security Manager
Participants: IT Security, Ecommerce, Payment Ops Manager
Source: workflow W2794 — Cardholder Data Environment (CDE) Boundary &amp; Tokenization Vault Governance</bpmn:documentation>
      <bpmn:laneSet id="W2794_LaneSet3">
        <bpmn:lane id="W2794_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W2794_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2794_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2794_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2794_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W2794_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2794_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2794_Start4" name="New system touching PAN or scope change">
        <bpmn:outgoing>W2794_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2794_Task5" name="IT Security maintains CDE boundary diagram; enforces network segmentation…">
        <bpmn:documentation>Step 1: IT Security maintains CDE boundary diagram; enforces network segmentation; validates no PAN storage outside vault/tokenization
Responsible (R): IT Security
Accountable (A): Payment Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2794_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2794_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2794_Task6" name="IT Security governs tokenization vault (format-preserving tokens for repeat…">
        <bpmn:documentation>Step 2: IT Security governs tokenization vault (format-preserving tokens for repeat customers, vaulted card for subscription/installation services); manages key rotation
Responsible (R): IT Security
Accountable (A): IT Security Manager
Duration: Per rotation</bpmn:documentation>
        <bpmn:incoming>W2794_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2794_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2794_Task7" name="Ecommerce/Payment Ops Manager ensures all integrations use tokens not raw PAN…">
        <bpmn:documentation>Step 3: Ecommerce/Payment Ops Manager ensures all integrations use tokens not raw PAN; validates no PAN in logs/screenshots/error messages
Responsible (R): Ecommerce / Payment Ops Manager
Accountable (A): Payment Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2794_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2794_End8" name="Complete">
        <bpmn:incoming>W2794_Flow14</bpmn:incoming>
      </bpmn:endEvent>
