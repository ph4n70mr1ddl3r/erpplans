    <bpmn:process id="W_W2793" name="W2793. PCI-DSS SAQ Scope Management &amp; Annual Self-Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual PCI-DSS attestation; scope change
Frequency: Annual + event-driven
Volume: 1 enterprise SAQ-D (or P2PE SAQ) covering 600 terminals + ecommerce
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, IT Security, QSA (if applicable), Compliance
Source: workflow W2793 — PCI-DSS SAQ Scope Management &amp; Annual Self-Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2793_LaneSet4">
        <bpmn:lane id="W2793_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W2793_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2793_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2793_Lane2" name="Compliance">
        <bpmn:flowNodeRef>W2793_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2793_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2793_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2793_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2793_Start5" name="Annual PCI-DSS attestation; scope change">
        <bpmn:outgoing>W2793_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2793_Task6" name="IT Security maps PCI-DSS scope (CDE, connected systems, people); selects…">
        <bpmn:documentation>Step 1: IT Security maps PCI-DSS scope (CDE, connected systems, people); selects appropriate SAQ (P2PE for stores with validated terminals; SAQ-D for ecommerce)
Responsible (R): IT Security
Accountable (A): Payment Operations Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2793_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2793_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2793_Task7" name="Compliance validates control evidence (network segmentation, access controls…">
        <bpmn:documentation>Step 2: Compliance validates control evidence (network segmentation, access controls, encryption, logging); runs internal ASV vulnerability scan quarterly
Responsible (R): Compliance / IT Security
Accountable (A): Payment Operations Manager
Duration: Quarterly + Annual</bpmn:documentation>
        <bpmn:incoming>W2793_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2793_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2793_Task8" name="Payment Ops Manager completes SAQ and Attestation of Compliance (AOC); submits…">
        <bpmn:documentation>Step 3: Payment Ops Manager completes SAQ and Attestation of Compliance (AOC); submits to acquirer/scheme; archives for 12 months
Responsible (R): Payment Ops Manager / QSA
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2793_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2793_End9" name="Complete">
        <bpmn:incoming>W2793_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2793_Annotation10">
        <bpmn:text>Controls: - CTL-471 (ensure controlled execution — Payment Cost, Fraud &amp; Tokenization Governance (PA-80.3).) | - operational: annual scope review and segmentation validation
Owner: Payment Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
