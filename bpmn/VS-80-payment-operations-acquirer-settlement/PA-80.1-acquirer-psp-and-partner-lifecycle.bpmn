      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2779" name="W2779. Payment Gateway (PayMongo/Dragonpay) Configuration &amp; Key Rotation" isExecutable="false">
      <bpmn:documentation>Trigger: Gateway onboarding, key expiry, or security event
Frequency: Annual key rotation; event-driven
Volume: ~3 gateway relationships
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, IT Security, Ecommerce, Treasury
Source: workflow W2779 — Payment Gateway (PayMongo/Dragonpay) Configuration &amp; Key Rotation</bpmn:documentation>
      <bpmn:laneSet id="W2779_LaneSet4">
        <bpmn:lane id="W2779_Lane1" name="IT Security">
        <bpmn:flowNodeRef>W2779_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2779_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2779_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W2779_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2779_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2779_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2779_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2779_Start5" name="Gateway onboarding, key expiry, or security event">
        <bpmn:outgoing>W2779_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2779_Task6" name="IT Security provisions API keys, webhook secrets, and merchant credentials in…">
        <bpmn:documentation>Step 1: IT Security provisions API keys, webhook secrets, and merchant credentials in secrets vault; configures 3-D Secure (3DS) for card-not-present; scopes tokens per channel
Responsible (R): IT Security
Accountable (A): Payment Ops Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2779_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2779_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2779_Task7" name="Ecommerce integrates gateway into checkout (redirect, direct, or hosted…">
        <bpmn:documentation>Step 2: Ecommerce integrates gateway into checkout (redirect, direct, or hosted fields); configures payment method routing and fallback; tests in sandbox
Responsible (R): Ecommerce / IT
Accountable (A): Payment Ops Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2779_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2779_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2779_Task8" name="Payment Ops Manager rotates keys annually and post-incident; coordinates…">
        <bpmn:documentation>Step 3: Payment Ops Manager rotates keys annually and post-incident; coordinates zero-downtime cutover; archives key inventory and PCI-DSS scope attestation
Responsible (R): Payment Ops Manager / IT Security
Accountable (A): Finance Controller
Duration: Per rotation</bpmn:documentation>
        <bpmn:incoming>W2779_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2779_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2779_End9" name="Complete">
        <bpmn:incoming>W2779_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2779_Annotation10">
        <bpmn:text>Controls: - CTL-469 (ensure controlled execution — Acquirer, PSP &amp; Payment Partner Lifecycle Management (PA-80.1).) | - operational: vault-managed keys and quarterly access review
Owner: Payment Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2779_Assoc11" sourceRef="W2779_Annotation10" targetRef="W2779_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2779_Flow12" sourceRef="W2779_Start5" targetRef="W2779_Task6" />
      <bpmn:sequenceFlow id="W2779_Flow13" sourceRef="W2779_Task6" targetRef="W2779_Task7" />
