<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-80.1-acquirer-psp-and-partner-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2777" name="W2777. Acquirer &amp; Card Scheme Registration, MID/MCC Setup" isExecutable="false">
      <bpmn:documentation>Trigger: New store opening, new tender type, or acquirer expansion
Frequency: Event-driven; ~10–15 new stores/year + periodic
Volume: 200 stores × ~4 acquirer relationships (BDO, BPI, Metrobank, Chinabank)
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, IT, Store Ops, Finance
Source: workflow W2777 — Acquirer &amp; Card Scheme Registration, MID/MCC Setup</bpmn:documentation>
      <bpmn:laneSet id="W2777_LaneSet3">
        <bpmn:lane id="W2777_Lane1" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2777_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2777_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2777_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2777_Lane2" name="IT">
        <bpmn:flowNodeRef>W2777_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2777_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2777_Start4" name="New store opening, new tender type, or acquirer expansion">
        <bpmn:outgoing>W2777_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2777_Task5" name="Payment Ops Manager submits merchant application to acquiring bank per…">
        <bpmn:documentation>Step 1: Payment Ops Manager submits merchant application to acquiring bank per entity/location; provides SEC docs, BIR 2303, mayor&#x27;s permit, store photos; specifies MID and MCC
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: 2–4 weeks/round</bpmn:documentation>
        <bpmn:incoming>W2777_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2777_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2777_Task6" name="IT configures terminal profiles (Visa/Mastercard/JCB/UnionPay/BancNet accept…">
        <bpmn:documentation>Step 2: IT configures terminal profiles (Visa/Mastercard/JCB/UnionPay/BancNet accept marks), MID/TID, and settlement routing in POS terminal management system
Responsible (R): IT
Accountable (A): Payment Ops Manager
Duration: 1–2 days/store</bpmn:documentation>
        <bpmn:incoming>W2777_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2777_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2777_Task7" name="Payment Ops Manager validates test transactions (live + reversal) end-to-end…">
        <bpmn:documentation>Step 3: Payment Ops Manager validates test transactions (live + reversal) end-to-end before go-live; archives acquirer confirmation and fee schedule
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: 1 day/store</bpmn:documentation>
        <bpmn:incoming>W2777_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2777_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2777_End8" name="Complete">
        <bpmn:incoming>W2777_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2777_Annotation9">
        <bpmn:text>Controls: - CTL-215 (ensure card/e-wallet settlement &amp; chargeback control.) | - operational: 8-week pre-opening checklist
Owner: Payment Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2777_Assoc10" sourceRef="W2777_Annotation9" targetRef="W2777_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2777_Flow11" sourceRef="W2777_Start4" targetRef="W2777_Task5" />
      <bpmn:sequenceFlow id="W2777_Flow12" sourceRef="W2777_Task5" targetRef="W2777_Task6" />
      <bpmn:sequenceFlow id="W2777_Flow13" sourceRef="W2777_Task6" targetRef="W2777_Task7" />
      <bpmn:sequenceFlow id="W2777_Flow14" sourceRef="W2777_Task7" targetRef="W2777_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2777_diag">
      <bpmndi:BPMNPlane id="W2777_plane" bpmnElement="W_W2777">
        <bpmndi:BPMNShape id="W2777_Lane1_di" bpmnElement="W2777_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2777_Lane2_di" bpmnElement="W2777_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
