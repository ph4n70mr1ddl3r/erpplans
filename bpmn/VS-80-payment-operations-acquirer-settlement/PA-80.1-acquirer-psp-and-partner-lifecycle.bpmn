      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2778" name="W2778. E-Wallet (GCash/Maya) Merchant Onboarding &amp; QR/Intent Integration" isExecutable="false">
      <bpmn:documentation>Trigger: New e-wallet partner or store enablement
Frequency: Event-driven + annual review
Volume: 200 stores × 2 e-wallets; ~15% of POS tender
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, Ecommerce, IT, Finance
Source: workflow W2778 — E-Wallet (GCash/Maya) Merchant Onboarding &amp; QR/Intent Integration</bpmn:documentation>
      <bpmn:laneSet id="W2778_LaneSet4">
        <bpmn:lane id="W2778_Lane1" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2778_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2778_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2778_Lane2" name="IT">
        <bpmn:flowNodeRef>W2778_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2778_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2778_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2778_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2778_Start5" name="New e-wallet partner or store enablement">
        <bpmn:outgoing>W2778_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2778_Task6" name="Payment Ops Manager registers merchant accounts with GCash/Maya per entity…">
        <bpmn:documentation>Step 1: Payment Ops Manager registers merchant accounts with GCash/Maya per entity; configures dynamic QR, merchant-intent API, and cash-in/cash-out capability
Responsible (R): Payment Ops Manager
Accountable (A): Finance Controller
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2778_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2778_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2778_Task7" name="IT integrates e-wallet API with POS (QR generation, payment notification…">
        <bpmn:documentation>Step 2: IT integrates e-wallet API with POS (QR generation, payment notification callback, status polling) and ecommerce checkout; certifies sandbox testing
Responsible (R): IT / Ecommerce
Accountable (A): Payment Ops Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2778_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2778_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2778_Task8" name="Finance validates daily settlement files (DCS) vs. POS capture; reconciles…">
        <bpmn:documentation>Step 3: Finance validates daily settlement files (DCS) vs. POS capture; reconciles e-wallet fee deductions (1.5–2%) and rebates; archives partner agreements
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: Per settlement</bpmn:documentation>
        <bpmn:incoming>W2778_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2778_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2778_End9" name="Complete">
        <bpmn:incoming>W2778_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2778_Annotation10">
        <bpmn:text>Controls: - CTL-469 (ensure controlled execution — Acquirer, PSP &amp; Payment Partner Lifecycle Management (PA-80.1).) | - operational: fallback to manual QR + status reconciliation
Owner: Payment Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2778_Assoc11" sourceRef="W2778_Annotation10" targetRef="W2778_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2778_Flow12" sourceRef="W2778_Start5" targetRef="W2778_Task6" />
      <bpmn:sequenceFlow id="W2778_Flow13" sourceRef="W2778_Task6" targetRef="W2778_Task7" />
      <bpmn:sequenceFlow id="W2778_Flow14" sourceRef="W2778_Task7" targetRef="W2778_Task8" />
      <bpmn:sequenceFlow id="W2778_Flow15" sourceRef="W2778_Task8" targetRef="W2778_End9" />
    </bpmn:process>
