    <bpmn:process id="W_W2780" name="W2780. BNPL (Home Credit/Billease) Provider Integration &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: BNPL provider agreement or expansion
Frequency: Event-driven
Volume: ~3–4 BNPL partners; significant for appliance/category sales
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, Category Manager, IT, Finance
Source: workflow W2780 — BNPL (Home Credit/Billease) Provider Integration &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W2780_LaneSet4">
        <bpmn:lane id="W2780_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2780_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2780_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2780_Lane2" name="IT">
        <bpmn:flowNodeRef>W2780_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2780_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2780_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2780_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2780_Start5" name="BNPL provider agreement or expansion">
        <bpmn:outgoing>W2780_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2780_Task6" name="Category Manager negotiates BNPL placement on appliance/category SKUs; defines…">
        <bpmn:documentation>Step 1: Category Manager negotiates BNPL placement on appliance/category SKUs; defines commission/discount rate split (typically 4–8% MDR-equivalent)
Responsible (R): Category Manager / Payment Ops Manager
Accountable (A): VP Merchandising
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W2780_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2780_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2780_Task7" name="IT integrates BNPL approval API at POS/checkout; cashier triggers application…">
        <bpmn:documentation>Step 2: IT integrates BNPL approval API at POS/checkout; cashier triggers application; receives instant approval/decline; captures reference
