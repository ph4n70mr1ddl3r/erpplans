    <bpmn:process id="W_W2784" name="W2784. Multi-Entity Merchant Settlement Hierarchy &amp; GL Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: New entity, new partner, or restructure
Frequency: Event-driven + annual validation
Volume: 5 entities × ~10 partners
Owner: Payment Operations Manager
Participants: Payment Ops Mgr, Finance, Master Data
Source: workflow W2784 — Multi-Entity Merchant Settlement Hierarchy &amp; GL Mapping</bpmn:documentation>
      <bpmn:laneSet id="W2784_LaneSet4">
        <bpmn:lane id="W2784_Lane1" name="Master Data">
        <bpmn:flowNodeRef>W2784_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2784_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2784_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2784_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2784_Lane3" name="Payment Ops Manager">
        <bpmn:flowNodeRef>W2784_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2784_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2784_Start5" name="New entity, new partner, or restructure">
        <bpmn:outgoing>W2784_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2784_Task6" name="Master Data maintains settlement hierarchy mapping MID/Partner/Entity to GL…">
        <bpmn:documentation>Step 1: Master Data maintains settlement hierarchy mapping MID/Partner/Entity to GL clearing, fee, and bank settlement accounts; validates uniqueness and completeness
Responsible (R): Master Data
Accountable (A): Payment Operations Manager
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W2784_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2784_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2784_Task7" name="Finance configures per-entity settlement GL posting rules; ensures intercompany…">
        <bpmn:documentation>Step 2: Finance configures per-entity settlement GL posting rules; ensures intercompany clearing for cross-entity transactions (e.g., Digital Commerce collects, Depot fulfills)
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W2784_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2784_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2784_Task8" name="Payment Ops Manager runs annual integrity test: simulate settlement file across…">
        <bpmn:documentation>Step 3: Payment Ops Manager runs annual integrity test: simulate settlement file across all entities; verify GL postings and bank credits reconcile to expected
Responsible (R): Payment Ops Manager / Finance
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2784_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2784_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2784_End9" name="Complete">
        <bpmn:incoming>W2784_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2784_Annotation10">
        <bpmn:text>Controls: - CTL-215 (ensure card/e-wallet settlement &amp; chargeback control.) | - operational: annual integrity test and segregation controls
Owner: Payment Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
