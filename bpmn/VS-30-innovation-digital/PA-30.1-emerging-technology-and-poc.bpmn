      <bpmn:sequenceFlow id="W1569_Flow16" sourceRef="W1569_Task6" targetRef="W1569_Task7" />
      <bpmn:sequenceFlow id="W1569_Flow17" sourceRef="W1569_Task7" targetRef="W1569_Task8" />
