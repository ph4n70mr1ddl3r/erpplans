    <bpmn:process id="W_W208" name="W208. Retail Analytics &amp; AI-Driven Inventory Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic replenishment cycle (W4) or promotion planning (W13)
Frequency: Weekly / Monthly
Volume: Covers all 35,000 active SKUs
Owner: Supply Chain Planning Manager
Participants: Data Scientist, Supply Planner, Category Manager
Source: workflow W208 — Retail Analytics &amp; AI-Driven Inventory Optimization</bpmn:documentation>
      <bpmn:laneSet id="W208_LaneSet4">
        <bpmn:lane id="W208_Lane1" name="System">
        <bpmn:flowNodeRef>W208_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W208_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W208_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W208_Lane2" name="Data Scientist">
        <bpmn:flowNodeRef>W208_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W208_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W208_Lane3" name="Supply Planner">
        <bpmn:flowNodeRef>W208_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W208_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W208_Start5" name="Periodic replenishment cycle (W4) or promotion planning (W13)">
        <bpmn:outgoing>W208_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W208_Task6" name="Data Aggregation">
        <bpmn:documentation>Step 1: Data Aggregation: Ingest historical sales, inventory levels, promotional history, and external factors (weather, holidays) into Data Lake
Responsible (R): System
Accountable (A): Data Scientist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W208_Flow14</bpmn:incoming>
        <bpmn:outgoing>W208_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W208_Task7" name="Demand Forecasting">
        <bpmn:documentation>Step 2: Demand Forecasting: AI model generates granular forecasts by SKU, by store, for the next 4-8 weeks
Responsible (R): System
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W208_Flow15</bpmn:incoming>
        <bpmn:outgoing>W208_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W208_Task8" name="Optimization">
        <bpmn:documentation>Step 3: Optimization: Model suggests optimal Reorder Points (ROP) and Safety Stock levels to minimize carrying costs while maintaining 97% service level
Responsible (R): Data Scientist
Accountable (A): VP Supply Chain
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W208_Flow16</bpmn:incoming>
        <bpmn:outgoing>W208_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W208_Task9" name="S&amp;OP Integration">
        <bpmn:documentation>Step 4: S&amp;OP Integration: Feed optimized parameters back into ERP replenishment engine (W31)
Responsible (R): Supply Planner
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W208_Flow17</bpmn:incoming>
        <bpmn:outgoing>W208_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W208_Task10" name="Impact Measurement">
        <bpmn:documentation>Step 5: Impact Measurement: Compare actual stock-outs and inventory turns against pre-optimization baseline
Responsible (R): Data Scientist
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W208_Flow18</bpmn:incoming>
        <bpmn:outgoing>W208_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W208_End11" name="Complete">
