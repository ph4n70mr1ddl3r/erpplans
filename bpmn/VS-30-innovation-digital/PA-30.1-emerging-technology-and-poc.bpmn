<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-30.1-emerging-technology-and-poc" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W202" name="W202. Predictive Maintenance for Industrial Assets" isExecutable="false">
      <bpmn:documentation>Trigger: Sensor alert from critical equipment (e.g., DC Conveyor, Generator, Forklift)
Frequency: Real-time monitoring
Volume: Covers 200 stores + 4 DCs with critical equipment
Owner: Maintenance Manager
Participants: IT (IoT Team), Maintenance, Vendor
Source: workflow W202 — Predictive Maintenance for Industrial Assets</bpmn:documentation>
      <bpmn:laneSet id="W202_LaneSet3">
        <bpmn:lane id="W202_Lane1" name="System">
        <bpmn:flowNodeRef>W202_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W202_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W202_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W202_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W202_Lane2" name="Technician">
        <bpmn:flowNodeRef>W202_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W202_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W202_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W202_Start4" name="Sensor alert from critical equipment (e.g., DC Conveyor, Generator, Forklift)">
        <bpmn:outgoing>W202_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W202_Task5" name="IoT Monitoring">
        <bpmn:documentation>Step 1: IoT Monitoring: Sensors track vibration, temperature, and duty cycles of DC assets
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W202_Flow13</bpmn:incoming>
        <bpmn:outgoing>W202_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W202_Task6" name="Anomaly Detection">
        <bpmn:documentation>Step 2: Anomaly Detection: ML model identifies patterns preceding failure (e.g., &quot;Motor temp rising &gt; 10% above norm&quot;)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W202_Flow14</bpmn:incoming>
        <bpmn:outgoing>W202_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W202_Task7" name="Predictive Work Order">
        <bpmn:documentation>Step 3: Predictive Work Order: System auto-generates Work Order in W188; flags as &quot;Predictive - High Urgency&quot; before failure occurs
Responsible (R): System
Accountable (A): Maintenance Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W202_Flow15</bpmn:incoming>
        <bpmn:outgoing>W202_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W202_Task8" name="Execution">
        <bpmn:documentation>Step 4: Execution: Technician performs targeted repair (e.g., bearing replacement) instead of waiting for scheduled PM
Responsible (R): Technician
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W202_Flow16</bpmn:incoming>
        <bpmn:outgoing>W202_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W202_Task9" name="Validation">
        <bpmn:documentation>Step 5: Validation: Technician confirms sensor data returned to normal; closes Work Order
Responsible (R): Technician
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W202_Flow17</bpmn:incoming>
        <bpmn:outgoing>W202_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W202_End10" name="Complete">
        <bpmn:incoming>W202_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W202_Annotation11">
        <bpmn:text>Controls: - CTL-331 (ensure controlled execution — Emerging Technology &amp; PoC (PA-30.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Maintenance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W202_Assoc12" sourceRef="W202_Annotation11" targetRef="W202_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W202_Flow13" sourceRef="W202_Start4" targetRef="W202_Task5" />
      <bpmn:sequenceFlow id="W202_Flow14" sourceRef="W202_Task5" targetRef="W202_Task6" />
      <bpmn:sequenceFlow id="W202_Flow15" sourceRef="W202_Task6" targetRef="W202_Task7" />
      <bpmn:sequenceFlow id="W202_Flow16" sourceRef="W202_Task7" targetRef="W202_Task8" />
      <bpmn:sequenceFlow id="W202_Flow17" sourceRef="W202_Task8" targetRef="W202_Task9" />
      <bpmn:sequenceFlow id="W202_Flow18" sourceRef="W202_Task9" targetRef="W202_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W202_diag">
      <bpmndi:BPMNPlane id="W202_plane" bpmnElement="W_W202">
        <bpmndi:BPMNShape id="W202_Lane1_di" bpmnElement="W202_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Lane2_di" bpmnElement="W202_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Task5_di" bpmnElement="W202_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Task6_di" bpmnElement="W202_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Task7_di" bpmnElement="W202_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Task8_di" bpmnElement="W202_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Task9_di" bpmnElement="W202_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Start4_di" bpmnElement="W202_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_End10_di" bpmnElement="W202_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W202_Annotation11_di" bpmnElement="W202_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W202_Flow13_di" bpmnElement="W202_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Flow14_di" bpmnElement="W202_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Flow15_di" bpmnElement="W202_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Flow16_di" bpmnElement="W202_Flow16"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Flow17_di" bpmnElement="W202_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Flow18_di" bpmnElement="W202_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W202_Assoc12_di" bpmnElement="W202_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W203" name="W203. Computer Vision for Inventory &amp; Planogram Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic store audit; or Stock Associate walkthrough
Frequency: Daily/Weekly
Volume: Covers 200 stores planogram compliance
Owner: Store Manager
Participants: Stock Associate, Merchandising Team, Data Scientist
Source: workflow W203 — Computer Vision for Inventory &amp; Planogram Audit</bpmn:documentation>
      <bpmn:laneSet id="W203_LaneSet5">
        <bpmn:lane id="W203_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W203_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W203_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W203_Lane2" name="System">
        <bpmn:flowNodeRef>W203_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W203_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W203_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W203_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W203_Lane3" name="IT Ops">
        <bpmn:flowNodeRef>W203_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W203_Lane4" name="Merchandising Team">
        <bpmn:flowNodeRef>W203_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W203_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W203_Start6" name="Periodic store audit; or Stock Associate walkthrough">
        <bpmn:outgoing>W203_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W203_Task7" name="Image Capture">
        <bpmn:documentation>Step 1: Image Capture: Stock Associate takes photos of shelves/aisles using mobile app
Responsible (R): Stock Associate
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W203_Flow17</bpmn:incoming>
        <bpmn:outgoing>W203_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W203_Task8" name="CV Analysis">
        <bpmn:documentation>Step 2: CV Analysis: Computer Vision model identifies: (a) Out-of-stocks; (b) Planogram non-compliance (W86); (c) Missing shelf labels (W63)
Responsible (R): System
Accountable (A): —
Duration: &lt; 1 min</bpmn:documentation>
        <bpmn:incoming>W203_Flow18</bpmn:incoming>
        <bpmn:outgoing>W203_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W203_Task9" name="Exception Handling for Poor-Quality Images">
        <bpmn:documentation>Step 3: Exception Handling for Poor-Quality Images: System flags images with blur, obstruction, or insufficient lighting; prompts Associate to retake or routes to manual review queue
Responsible (R): System
Accountable (A): Stock Associate
Duration: &lt; 2 min</bpmn:documentation>
        <bpmn:incoming>W203_Flow19</bpmn:incoming>
        <bpmn:outgoing>W203_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W203_Task10" name="Action Alerts">
        <bpmn:documentation>Step 4: Action Alerts: System pushes task to Associate&#x27;s app: &quot;Replenish SKU 123 from backroom&quot; or &quot;Fix Planogram on Aisle 4&quot;
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W203_Flow20</bpmn:incoming>
        <bpmn:outgoing>W203_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W203_Task11" name="Edge Device Management &amp; Health Monitoring">
        <bpmn:documentation>Step 5: Edge Device Management &amp; Health Monitoring: IT monitors camera devices and mobile app health across stores; tracks battery, storage, firmware version, and connectivity status
Responsible (R): IT Ops
Accountable (A): Data Scientist
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W203_Flow21</bpmn:incoming>
        <bpmn:outgoing>W203_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W203_Task12" name="Model Retraining Pipeline with Human Corrections">
        <bpmn:documentation>Step 6: Model Retraining Pipeline with Human Corrections: Merchandising team reviews flagged discrepancies and submits corrections/feedback; corrections feed into model retraining dataset to improve accuracy over time
Responsible (R): Merchandising Team
Accountable (A): Data Scientist
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W203_Flow22</bpmn:incoming>
        <bpmn:outgoing>W203_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W203_Task13" name="Compliance Score &amp; ROI Measurement">
        <bpmn:documentation>Step 7: Compliance Score &amp; ROI Measurement: System generates &quot;Shelf Health&quot; score per store for Regional Manager review; dashboard reports labor hours saved vs. manual audits to quantify ROI
Responsible (R): System
Accountable (A): Merch Mgr
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W203_Flow23</bpmn:incoming>
        <bpmn:outgoing>W203_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W203_End14" name="Complete">
        <bpmn:incoming>W203_Flow24</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W203_Annotation15">
        <bpmn:text>Controls: - CTL-223 (ensure responsible AI/ML &amp; pilot governance.) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W203_Assoc16" sourceRef="W203_Annotation15" targetRef="W203_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W203_Flow17" sourceRef="W203_Start6" targetRef="W203_Task7" />
      <bpmn:sequenceFlow id="W203_Flow18" sourceRef="W203_Task7" targetRef="W203_Task8" />
      <bpmn:sequenceFlow id="W203_Flow19" sourceRef="W203_Task8" targetRef="W203_Task9" />
      <bpmn:sequenceFlow id="W203_Flow20" sourceRef="W203_Task9" targetRef="W203_Task10" />
      <bpmn:sequenceFlow id="W203_Flow21" sourceRef="W203_Task10" targetRef="W203_Task11" />
      <bpmn:sequenceFlow id="W203_Flow22" sourceRef="W203_Task11" targetRef="W203_Task12" />
      <bpmn:sequenceFlow id="W203_Flow23" sourceRef="W203_Task12" targetRef="W203_Task13" />
      <bpmn:sequenceFlow id="W203_Flow24" sourceRef="W203_Task13" targetRef="W203_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W203_diag">
      <bpmndi:BPMNPlane id="W203_plane" bpmnElement="W_W203">
        <bpmndi:BPMNShape id="W203_Lane1_di" bpmnElement="W203_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W203_Lane2_di" bpmnElement="W203_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W203_Lane3_di" bpmnElement="W203_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W203_Lane4_di" bpmnElement="W203_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W203_Task7_di" bpmnElement="W203_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
