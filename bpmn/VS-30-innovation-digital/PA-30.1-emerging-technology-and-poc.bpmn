    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1570_diag">
      <bpmndi:BPMNPlane id="W1570_plane" bpmnElement="W_W1570">
        <bpmndi:BPMNShape id="W1570_Lane1_di" bpmnElement="W1570_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1570_Lane2_di" bpmnElement="W1570_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1570_Lane3_di" bpmnElement="W1570_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1570_Task6_di" bpmnElement="W1570_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
