        <bpmndi:BPMNShape id="W203_End14_di" bpmnElement="W203_End14"><dc:Bounds x="1890" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W203_Annotation15_di" bpmnElement="W203_Annotation15"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
