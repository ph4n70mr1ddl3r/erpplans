      <bpmn:sequenceFlow id="W690_Flow24" sourceRef="W690_Task13" targetRef="W690_Task14" />
      <bpmn:sequenceFlow id="W690_Flow25" sourceRef="W690_Task14" targetRef="W690_End15" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W690_diag">
      <bpmndi:BPMNPlane id="W690_plane" bpmnElement="W_W690">
        <bpmndi:BPMNShape id="W690_Lane1_di" bpmnElement="W690_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
