    <bpmn:process id="W_W2477" name="W2477. Vendor Development ROI Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Annual measurement of development program effectiveness
Frequency: Annual
Volume: All vendor development activities
Owner: FP&amp;A Analyst
Participants: FP&amp;A Analyst, Procurement Mgr, VP Supply Chain
Source: workflow W2477 — Vendor Development ROI Measurement</bpmn:documentation>
      <bpmn:laneSet id="W2477_LaneSet2">
        <bpmn:lane id="W2477_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2477_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2477_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2477_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2477_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2477_Start3" name="Annual measurement of development program effectiveness">
        <bpmn:outgoing>W2477_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2477_Task4" name="Measures the ROI of the VS-67.3 development portfolio: program cost (BuildRight…">
        <bpmn:documentation>Step 1: Measures the ROI of the VS-67.3 development portfolio: program cost (BuildRight labor + co-investment + training delivery) vs. vendor-performance improvement (quality-defect reduction, OTD improvement, cost savings from improved terms/JBPs, innovation-revenue lift); attributes improvement to specific development activities where traceable
Responsible (R): FP&amp;A Analyst
Accountable (A): CFO
Duration: 3–5 days/year</bpmn:documentation>
        <bpmn:incoming>W2477_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2477_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2477_Task5" name="Identifies the most impactful development activities (e.g., W2472 technology…">
        <bpmn:documentation>Step 2: Identifies the most impactful development activities (e.g., W2472 technology enablement may show the highest KPI lift per dollar); recommends next-year budget allocation across W2470–W2476
Responsible (R): FP&amp;A Analyst / Procurement Manager
Accountable (A): CFO / VP Supply Chain
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W2477_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2477_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2477_End6" name="Complete">
        <bpmn:incoming>W2477_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2477_Annotation7">
        <bpmn:text>Controls: - CTL-39: rebate accuracy — cost-savings from JBPs validated against the rebate agreement; operational: CFO sign-off on the ROI methodology and budget-allocation recommendation
Owner: FP&amp;A Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2477_Assoc8" sourceRef="W2477_Annotation7" targetRef="W2477_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2477_Flow9" sourceRef="W2477_Start3" targetRef="W2477_Task4" />
      <bpmn:sequenceFlow id="W2477_Flow10" sourceRef="W2477_Task4" targetRef="W2477_Task5" />
      <bpmn:sequenceFlow id="W2477_Flow11" sourceRef="W2477_Task5" targetRef="W2477_End6" />
    </bpmn:process>
