        <bpmndi:BPMNShape id="W2475_Start3_di" bpmnElement="W2475_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2475_End6_di" bpmnElement="W2475_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
