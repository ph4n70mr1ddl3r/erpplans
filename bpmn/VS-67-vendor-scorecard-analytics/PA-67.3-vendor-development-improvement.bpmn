        <bpmndi:BPMNShape id="W2476_Task5_di" bpmnElement="W2476_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2476_Start3_di" bpmnElement="W2476_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2476_End6_di" bpmnElement="W2476_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2476_Annotation7_di" bpmnElement="W2476_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
