<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-67.3-vendor-development-improvement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2470" name="W2470. Vendor Capability Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor development need identified
Frequency: ~20–30 assessments/year
Volume: ~20–30/year
Owner: Procurement Manager
Participants: Procurement Mgr, Quality Mgr, Category Mgr, VP Supply Chain
Source: workflow W2470 — Vendor Capability Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2470_LaneSet2">
        <bpmn:lane id="W2470_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2470_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2470_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2470_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2470_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2470_Start3" name="Vendor development need identified">
        <bpmn:outgoing>W2470_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2470_Task4" name="Procurement conducts a structured capability assessment across six dimensions…">
        <bpmn:documentation>Step 1: Procurement conducts a structured capability assessment across six dimensions: production capacity (can the vendor absorb BuildRight&#x27;s growth?), quality systems (ISO/process maturity), logistics capability (drop-ship, cross-dock, import handling), technology readiness (EDI/API/e-invoice maturity for W2472), financial stability (links to W2475), sustainability practices (links to W2474); identifies the highest-leverage development areas
Responsible (R): Procurement Manager / Quality Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days per assessment</bpmn:documentation>
        <bpmn:incoming>W2470_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2470_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2470_Task5" name="Documents the assessment with evidence (site-visit notes for strategic vendors…">
        <bpmn:documentation>Step 2: Documents the assessment with evidence (site-visit notes for strategic vendors, self-assessment questionnaire for others) and feeds the findings into the W2471/W2472/W2474 development plans and the W2463 quarterly review
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 0.5–1 day per assessment</bpmn:documentation>
        <bpmn:incoming>W2470_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2470_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2470_End6" name="Complete">
        <bpmn:incoming>W2470_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2470_Annotation7">
        <bpmn:text>Controls: - CTL-50: vendor-master integrity — assessment outcome recorded against the vendor record as a controlled change; operational: Quality Manager co-signs the quality-systems dimension
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2470_Assoc8" sourceRef="W2470_Annotation7" targetRef="W2470_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2470_Flow9" sourceRef="W2470_Start3" targetRef="W2470_Task4" />
      <bpmn:sequenceFlow id="W2470_Flow10" sourceRef="W2470_Task4" targetRef="W2470_Task5" />
      <bpmn:sequenceFlow id="W2470_Flow11" sourceRef="W2470_Task5" targetRef="W2470_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2470_diag">
      <bpmndi:BPMNPlane id="W2470_plane" bpmnElement="W_W2470">
        <bpmndi:BPMNShape id="W2470_Lane1_di" bpmnElement="W2470_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2470_Task4_di" bpmnElement="W2470_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2470_Task5_di" bpmnElement="W2470_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2470_Start3_di" bpmnElement="W2470_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2470_End6_di" bpmnElement="W2470_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2470_Annotation7_di" bpmnElement="W2470_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2470_Flow9_di" bpmnElement="W2470_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2470_Flow10_di" bpmnElement="W2470_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2470_Flow11_di" bpmnElement="W2470_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2470_Assoc8_di" bpmnElement="W2470_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2471" name="W2471. Vendor Training &amp; Development Program" isExecutable="false">
      <bpmn:documentation>Trigger: Capability gap identified; training designed
Frequency: ~10–15 vendor training events/year
Volume: ~10–15 events/year
Owner: Procurement Manager
Participants: Procurement Mgr, Quality Mgr, IT, Vendor
Source: workflow W2471 — Vendor Training &amp; Development Program</bpmn:documentation>
      <bpmn:laneSet id="W2471_LaneSet2">
        <bpmn:lane id="W2471_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2471_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2471_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2471_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2471_Start3" name="Capability gap identified; training designed">
        <bpmn:outgoing>W2471_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2471_Task4" name="Designs and delivers targeted training to close a W2470-identified gap…">
        <bpmn:documentation>Step 1: Designs and delivers targeted training to close a W2470-identified gap: BuildRight quality standards and packaging requirements, delivery-scheduling and ASN discipline, vendor-portal usage (W593), BIR-compliant invoice formatting (links to VS-79), e-invoicing onboarding; delivered on-site (for strategic vendors) or virtual (for breadth); tracks post-training adoption in the next scorecard cycle
Responsible (R): Procurement Manager / Quality Manager
Accountable (A): VP Supply Chain
Duration: 1–2 days per event</bpmn:documentation>
        <bpmn:incoming>W2471_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2471_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2471_End5" name="Complete">
        <bpmn:incoming>W2471_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2471_Annotation6">
        <bpmn:text>Controls: - Operational: training completion recorded as a prerequisite for tier-up consideration (W2464); CTL-06 vendor-master carries the training-compliance flag
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2471_Assoc7" sourceRef="W2471_Annotation6" targetRef="W2471_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2471_Flow8" sourceRef="W2471_Start3" targetRef="W2471_Task4" />
      <bpmn:sequenceFlow id="W2471_Flow9" sourceRef="W2471_Task4" targetRef="W2471_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2471_diag">
      <bpmndi:BPMNPlane id="W2471_plane" bpmnElement="W_W2471">
        <bpmndi:BPMNShape id="W2471_Lane1_di" bpmnElement="W2471_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2471_Task4_di" bpmnElement="W2471_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2471_Start3_di" bpmnElement="W2471_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2471_End5_di" bpmnElement="W2471_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2471_Annotation6_di" bpmnElement="W2471_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2471_Flow8_di" bpmnElement="W2471_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2471_Flow9_di" bpmnElement="W2471_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2471_Assoc7_di" bpmnElement="W2471_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2472" name="W2472. Vendor Technology Enablement" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor needs system upgrade for BuildRight integration
Frequency: ~5–10 technology enablement projects/year
Volume: ~5–10/year
Owner: IT Integration Lead
Participants: IT Integration Lead, Procurement Mgr, Vendor IT
Source: workflow W2472 — Vendor Technology Enablement</bpmn:documentation>
      <bpmn:laneSet id="W2472_LaneSet2">
        <bpmn:lane id="W2472_Lane1" name="IT Integration Lead">
        <bpmn:flowNodeRef>W2472_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2472_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2472_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2472_Start3" name="Vendor needs system upgrade for BuildRight integration">
        <bpmn:outgoing>W2472_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2472_Task4" name="IT helps vendors integrate with BuildRight&#x27;s systems: EDI/API for PO and…">
        <bpmn:documentation>Step 1: IT helps vendors integrate with BuildRight&#x27;s systems: EDI/API for PO and order-status exchange, ASN (advance shipping notice) for inbound visibility, e-invoicing for automated AP matching (improves the W2455 invoice-accuracy KPI), vendor-portal adoption for self-service PO/ASN/invoice; provides documentation, sandbox access, and technical support through go-live
Responsible (R): IT Integration Lead
Accountable (A): CIO
Duration: 5–10 days per vendor</bpmn:documentation>
        <bpmn:incoming>W2472_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2472_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2472_End5" name="Complete">
        <bpmn:incoming>W2472_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2472_Annotation6">
        <bpmn:text>Controls: - CTL-42 (bank-account-change guard — a vendor integrating e-invoicing is also a moment where bank details may be &quot;updated,&quot; so the out-of-band verification control applies); CTL-44 (duplicate-invoice guard — the e-invoice integration must not bypass dedup)
Owner: IT Integration Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2472_Assoc7" sourceRef="W2472_Annotation6" targetRef="W2472_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2472_Flow8" sourceRef="W2472_Start3" targetRef="W2472_Task4" />
      <bpmn:sequenceFlow id="W2472_Flow9" sourceRef="W2472_Task4" targetRef="W2472_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2472_diag">
      <bpmndi:BPMNPlane id="W2472_plane" bpmnElement="W_W2472">
        <bpmndi:BPMNShape id="W2472_Lane1_di" bpmnElement="W2472_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2472_Task4_di" bpmnElement="W2472_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2472_Start3_di" bpmnElement="W2472_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2472_End5_di" bpmnElement="W2472_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2472_Annotation6_di" bpmnElement="W2472_Annotation6"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2472_Flow8_di" bpmnElement="W2472_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2472_Flow9_di" bpmnElement="W2472_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2472_Assoc7_di" bpmnElement="W2472_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2473" name="W2473. Joint Business Planning with Strategic Vendors" isExecutable="false">
      <bpmn:documentation>Trigger: Annual joint business planning cycle
Frequency: Annual; top 20 strategic vendors
Volume: ~20 joint plans/year
Owner: VP Supply Chain / VP Merchandising
Participants: VP Supply Chain, VP Merch, Category Mgrs, Strategic Vendors
Source: workflow W2473 — Joint Business Planning with Strategic Vendors</bpmn:documentation>
      <bpmn:laneSet id="W2473_LaneSet3">
        <bpmn:lane id="W2473_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W2473_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2473_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2473_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2473_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2473_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2473_Start4" name="Annual joint business planning cycle">
        <bpmn:outgoing>W2473_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2473_Task5" name="Joint planning session with each of the top 20 strategic vendors: review…">
        <bpmn:documentation>Step 1: Joint planning session with each of the top 20 strategic vendors: review prior-year performance against last year&#x27;s joint plan, align on next-year growth targets and category strategy, discuss new-product development (links to W2476 innovation), agree volume commitments and pricing (links to VS-39 rebates), set collaboration goals (sustainability, technology, joint marketing)
Responsible (R): VP Supply Chain / VP Merchandising
Accountable (A): CEO
Duration: 1–2 days per vendor</bpmn:documentation>
        <bpmn:incoming>W2473_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2473_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2473_Task6" name="Documents the joint business plan (JBP) in a shared artifact; category Manager…">
        <bpmn:documentation>Step 2: Documents the joint business plan (JBP) in a shared artifact; category Manager tracks JBP commitments quarterly against actuals and surfaces misses in the W2463 strategic-vendor review
Responsible (R): Category Manager
Accountable (A): VP Supply Chain
Duration: Quarterly, absorbed into W2463</bpmn:documentation>
        <bpmn:incoming>W2473_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2473_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2473_End7" name="Complete">
        <bpmn:incoming>W2473_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2473_Annotation8">
        <bpmn:text>Controls: - CTL-39 (rebate accuracy — JBP pricing terms flow into the rebate agreement and are CTL-39-validated); operational: CEO sign-off on JBPs with the top 5 vendors (materiality control)
Owner: VP Supply Chain / VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2473_Assoc9" sourceRef="W2473_Annotation8" targetRef="W2473_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2473_Flow10" sourceRef="W2473_Start4" targetRef="W2473_Task5" />
      <bpmn:sequenceFlow id="W2473_Flow11" sourceRef="W2473_Task5" targetRef="W2473_Task6" />
      <bpmn:sequenceFlow id="W2473_Flow12" sourceRef="W2473_Task6" targetRef="W2473_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2473_diag">
      <bpmndi:BPMNPlane id="W2473_plane" bpmnElement="W_W2473">
        <bpmndi:BPMNShape id="W2473_Lane1_di" bpmnElement="W2473_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_Lane2_di" bpmnElement="W2473_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_Task5_di" bpmnElement="W2473_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_Task6_di" bpmnElement="W2473_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_Start4_di" bpmnElement="W2473_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_End7_di" bpmnElement="W2473_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2473_Annotation8_di" bpmnElement="W2473_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2473_Flow10_di" bpmnElement="W2473_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2473_Flow11_di" bpmnElement="W2473_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2473_Flow12_di" bpmnElement="W2473_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2473_Assoc9_di" bpmnElement="W2473_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2474" name="W2474. Vendor Sustainability Development" isExecutable="false">
      <bpmn:documentation>Trigger: ESG improvement need identified per VS-25
Frequency: ~10–15 vendors/year needing sustainability development
Volume: ~10–15/year
Owner: ESG Manager / Procurement Mgr
Participants: ESG Mgr, Procurement Mgr, Vendor, VP Supply Chain
Source: workflow W2474 — Vendor Sustainability Development</bpmn:documentation>
      <bpmn:laneSet id="W2474_LaneSet2">
        <bpmn:lane id="W2474_Lane1" name="ESG Manager">
        <bpmn:flowNodeRef>W2474_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2474_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2474_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2474_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2474_Start3" name="ESG improvement need identified per VS-25">
        <bpmn:outgoing>W2474_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2474_Task4" name="ESG Manager works with the vendor on the identified gap: environmental…">
        <bpmn:documentation>Step 1: ESG Manager works with the vendor on the identified gap: environmental compliance (DENR effluent/emissions, hazardous-waste per VS-24/W82), labor standards (DOLE, links to VS-19 and VS-131 human-rights due diligence), sustainable packaging (recyclable/reduced material), carbon-footprint reduction (scope-3 emissions per VS-25); sets improvement targets with dates
Responsible (R): ESG Manager / Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/year per vendor</bpmn:documentation>
        <bpmn:incoming>W2474_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2474_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2474_Task5" name="Tracks sustainability progress quarterly via evidence (certificates, audit…">
        <bpmn:documentation>Step 2: Tracks sustainability progress quarterly via evidence (certificates, audit reports, emissions data); feeds the sustainability dimension of the W2458 scorecard and the W2619 corporate ESG rollup
Responsible (R): ESG Manager
Accountable (A): VP Supply Chain
Duration: Absorbed into VS-25 reporting</bpmn:documentation>
        <bpmn:incoming>W2474_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2474_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2474_End6" name="Complete">
        <bpmn:incoming>W2474_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2474_Annotation7">
        <bpmn:text>Controls: - CTL-227: sustainability-equipment evidence &amp; data integrity; operational: ESG Manager attestation on the sustainability-dimension data feeding W2458
Owner: ESG Manager / Procurement Mgr</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2474_Assoc8" sourceRef="W2474_Annotation7" targetRef="W2474_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2474_Flow9" sourceRef="W2474_Start3" targetRef="W2474_Task4" />
      <bpmn:sequenceFlow id="W2474_Flow10" sourceRef="W2474_Task4" targetRef="W2474_Task5" />
