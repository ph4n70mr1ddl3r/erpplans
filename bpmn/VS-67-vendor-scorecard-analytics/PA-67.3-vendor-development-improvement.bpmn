        <bpmndi:BPMNEdge id="W2475_Flow10_di" bpmnElement="W2475_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2475_Flow11_di" bpmnElement="W2475_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2475_Assoc8_di" bpmnElement="W2475_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2476" name="W2476. Vendor Innovation Partnership Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual innovation challenge or ongoing partnership
Frequency: Annual; ~10–15 innovative vendors
Volume: ~10–15 vendors/year
Owner: VP Merchandising
Participants: VP Merch, Category Mgrs, Procurement Mgr, VP Supply Chain
Source: workflow W2476 — Vendor Innovation Partnership Program</bpmn:documentation>
      <bpmn:laneSet id="W2476_LaneSet2">
        <bpmn:lane id="W2476_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W2476_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2476_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2476_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2476_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2476_Start3" name="Annual innovation challenge or ongoing partnership">
        <bpmn:outgoing>W2476_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2476_Task4" name="VP Merchandising invites innovative vendors (from the W2458…">
        <bpmn:documentation>Step 1: VP Merchandising invites innovative vendors (from the W2458 innovation-dimension leaders and open submissions) to propose: new products (links to VS-01 assortment), packaging improvements (links to VS-111), display innovations, sustainability solutions (links to W2474); evaluates proposals against category strategy; pilots promising innovations in 5–10 select stores
Responsible (R): VP Merchandising / Category Manager
Accountable (A): CEO
Duration: 5–10 days/year</bpmn:documentation>
        <bpmn:incoming>W2476_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2476_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2476_Task5" name="Scales successful pilots to chain-wide rollout; formalizes the innovation in…">
        <bpmn:documentation>Step 2: Scales successful pilots to chain-wide rollout; formalizes the innovation in the JBP (W2473) and the vendor&#x27;s innovation-dimension score (W2458); recognizes contributors in the W2467 awards
Responsible (R): VP Merchandising / Category Manager
Accountable (A): VP Supply Chain
Duration: Per pilot</bpmn:documentation>
        <bpmn:incoming>W2476_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2476_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2476_End6" name="Complete">
        <bpmn:incoming>W2476_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2476_Annotation7">
        <bpmn:text>Controls: - CTL-37: warranty claim validity — relevant for piloted products entering the warranty pool; operational: Legal review of IP terms before scaling any vendor-proposed innovation
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2476_Assoc8" sourceRef="W2476_Annotation7" targetRef="W2476_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2476_Flow9" sourceRef="W2476_Start3" targetRef="W2476_Task4" />
      <bpmn:sequenceFlow id="W2476_Flow10" sourceRef="W2476_Task4" targetRef="W2476_Task5" />
      <bpmn:sequenceFlow id="W2476_Flow11" sourceRef="W2476_Task5" targetRef="W2476_End6" />
    </bpmn:process>
