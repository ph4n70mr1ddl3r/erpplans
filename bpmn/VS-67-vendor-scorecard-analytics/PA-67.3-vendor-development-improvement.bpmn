    <bpmn:process id="W_W2475" name="W2475. Vendor Financial Health Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly financial review of strategic vendors
Frequency: Quarterly; top 50 strategic vendors
Volume: ~50 vendors/quarter
Owner: Finance Controller
Participants: Finance Dir, Procurement Mgr, VP Supply Chain
Source: workflow W2475 — Vendor Financial Health Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2475_LaneSet2">
        <bpmn:lane id="W2475_Lane1" name="Finance Controller">
        <bpmn:flowNodeRef>W2475_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2475_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2475_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2475_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2475_Start3" name="Quarterly financial review of strategic vendors">
        <bpmn:outgoing>W2475_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2475_Task4" name="Finance monitors vendor financial health for the top 50 strategic vendors…">
        <bpmn:documentation>Step 1: Finance monitors vendor financial health for the top 50 strategic vendors: third-party credit reports, payment-behavior trends (BuildRight&#x27;s own AP aging for the vendor), public news alerts for financial distress (bankruptcy filings, layoffs, ownership changes); identifies at-risk vendors for supply-continuity planning
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2475_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2475_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2475_Task5" name="For at-risk vendors: recommends risk-mitigation actions — dual-sourcing for…">
        <bpmn:documentation>Step 2: For at-risk vendors: recommends risk-mitigation actions — dual-sourcing for critical categories (links to VS-02 supply planning), reduced inventory exposure (consignment/VMI shift per VS-45), or accelerated W2466 delisting if the vendor is both underperforming and financially distressed
Responsible (R): Finance Controller / Procurement Manager
Accountable (A): CFO
Duration: 2–3 hours/at-risk vendor</bpmn:documentation>
        <bpmn:incoming>W2475_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2475_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2475_End6" name="Complete">
        <bpmn:incoming>W2475_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2475_Annotation7">
        <bpmn:text>Controls: - CTL-42 (bank-account-change guard — a financially-distressed vendor may attempt to reroute payments, so the control is heightened during at-risk status); CTL-48 (rebate exposure — at-risk-vendor open rebates flagged for Finance review)
Owner: Finance Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2475_Assoc8" sourceRef="W2475_Annotation7" targetRef="W2475_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2475_Flow9" sourceRef="W2475_Start3" targetRef="W2475_Task4" />
      <bpmn:sequenceFlow id="W2475_Flow10" sourceRef="W2475_Task4" targetRef="W2475_Task5" />
      <bpmn:sequenceFlow id="W2475_Flow11" sourceRef="W2475_Task5" targetRef="W2475_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2475_diag">
      <bpmndi:BPMNPlane id="W2475_plane" bpmnElement="W_W2475">
        <bpmndi:BPMNShape id="W2475_Lane1_di" bpmnElement="W2475_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
