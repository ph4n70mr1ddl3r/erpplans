      <bpmn:sequenceFlow id="W2466_Flow11" sourceRef="W2466_Task5" targetRef="W2466_Task6" />
      <bpmn:sequenceFlow id="W2466_Flow12" sourceRef="W2466_Task6" targetRef="W2466_End7" />
    </bpmn:process>
