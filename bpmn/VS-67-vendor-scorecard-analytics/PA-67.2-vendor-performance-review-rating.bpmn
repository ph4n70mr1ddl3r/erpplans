    <bpmn:process id="W_W2468" name="W2468. Vendor Scorecard System Enhancement" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly system review
Frequency: Quarterly; continuous improvement
Volume: Scorecard system serving ~800–1,000 vendors
Owner: IT Business Analyst
Participants: IT Business Analyst, Procurement Mgr, VP Supply Chain
Source: workflow W2468 — Vendor Scorecard System Enhancement</bpmn:documentation>
      <bpmn:laneSet id="W2468_LaneSet2">
        <bpmn:lane id="W2468_Lane1" name="IT Business Analyst">
        <bpmn:flowNodeRef>W2468_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2468_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2468_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2468_Start3" name="Quarterly system review">
        <bpmn:outgoing>W2468_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2468_Task4" name="IT reviews the scorecard system end-to-end: reporting capabilities…">
        <bpmn:documentation>Step 1: IT reviews the scorecard system end-to-end: reporting capabilities, data-visualization usability, integration completeness (are all W2455 source feeds flowing?), user feedback from Buyers/Category Managers; implements prioritized enhancements — new KPIs (e.g., sustainability dimension), better dashboards (mobile access for Buyers on the floor), faster calc-cycle latency
Responsible (R): IT Business Analyst
Accountable (A): CIO
Duration: 5–10 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2468_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2468_End5" name="Complete">
        <bpmn:incoming>W2468_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2468_Annotation6">
        <bpmn:text>Controls: - CTL-51: master-data/stale-data checks — applies to the scorecard fact table the enhancements touch; operational: enhancements released via W132 change management with Procurement Manager UAT sign-off
Owner: IT Business Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2468_Assoc7" sourceRef="W2468_Annotation6" targetRef="W2468_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2468_Flow8" sourceRef="W2468_Start3" targetRef="W2468_Task4" />
      <bpmn:sequenceFlow id="W2468_Flow9" sourceRef="W2468_Task4" targetRef="W2468_End5" />
    </bpmn:process>
