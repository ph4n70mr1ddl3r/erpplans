<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-67.2-vendor-performance-review-rating" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2462" name="W2462. Monthly Vendor Performance Report" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle
Frequency: Monthly; ~800–1,000 vendors
Volume: ~800–1,000 vendor performance reports/month
Owner: Procurement Analyst
Participants: Procurement Analyst, Procurement Mgr, VP Supply Chain
Source: workflow W2462 — Monthly Vendor Performance Report</bpmn:documentation>
      <bpmn:laneSet id="W2462_LaneSet2">
        <bpmn:lane id="W2462_Lane1" name="Procurement Analyst">
        <bpmn:flowNodeRef>W2462_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2462_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2462_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2462_Start3" name="Monthly reporting cycle">
        <bpmn:outgoing>W2462_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2462_Task4" name="Generates the monthly report package from the W2458 scorecard output: top-20…">
        <bpmn:documentation>Step 1: Generates the monthly report package from the W2458 scorecard output: top-20 performers, bottom-20 performers, biggest movers (±15 points month-over-month), new additions (first-scored vendors from W2460), KPI trend lines per dimension; distributes to Category Managers and Buyers with action-prompt annotations (each bottom-20 / biggest-mover entry carries a &quot;review required by&quot; tag)
Responsible (R): Procurement Analyst
Accountable (A): Procurement Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2462_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2462_End5" name="Complete">
        <bpmn:incoming>W2462_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2462_Annotation6">
        <bpmn:text>Controls: - CTL-48: rebate-dispute frequency surfaced as a scorecard input — visible in the monthly report; operational: Procurement Manager sign-off on the published report
Owner: Procurement Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2462_Assoc7" sourceRef="W2462_Annotation6" targetRef="W2462_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2462_Flow8" sourceRef="W2462_Start3" targetRef="W2462_Task4" />
      <bpmn:sequenceFlow id="W2462_Flow9" sourceRef="W2462_Task4" targetRef="W2462_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2462_diag">
      <bpmndi:BPMNPlane id="W2462_plane" bpmnElement="W_W2462">
        <bpmndi:BPMNShape id="W2462_Lane1_di" bpmnElement="W2462_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2462_Task4_di" bpmnElement="W2462_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2462_Start3_di" bpmnElement="W2462_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2462_End5_di" bpmnElement="W2462_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2462_Annotation6_di" bpmnElement="W2462_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2462_Flow8_di" bpmnElement="W2462_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2462_Flow9_di" bpmnElement="W2462_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2462_Assoc7_di" bpmnElement="W2462_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2463" name="W2463. Quarterly Strategic Vendor Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review cycle
Frequency: Quarterly; top 50 strategic vendors
Volume: ~50 vendor reviews/quarter
Owner: Category Manager
Participants: Category Mgr, Procurement Mgr, Vendor, VP Supply Chain
Source: workflow W2463 — Quarterly Strategic Vendor Review</bpmn:documentation>
      <bpmn:laneSet id="W2463_LaneSet2">
        <bpmn:lane id="W2463_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2463_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2463_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2463_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2463_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2463_Start3" name="Quarterly review cycle">
        <bpmn:outgoing>W2463_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2463_Task4" name="Category Manager conducts a structured review with the strategic vendor…">
        <bpmn:documentation>Step 1: Category Manager conducts a structured review with the strategic vendor: presents the W2458 scorecard with the W2461 benchmark percentile, discusses strengths and improvement areas, agrees 90-day improvement targets documented in a joint action plan; vendor presents their roadmap (new products, capacity, sustainability initiatives)
Responsible (R): Category Manager / Vendor
Accountable (A): VP Supply Chain
Duration: 1–2 hours/vendor/quarter</bpmn:documentation>
        <bpmn:incoming>W2463_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2463_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2463_Task5" name="Category Manager records the agreed targets in the supplier-performance module…">
        <bpmn:documentation>Step 2: Category Manager records the agreed targets in the supplier-performance module so the next quarter&#x27;s review opens with a scorecard-vs-target view; escalates any target miss to the W2465 PIP workflow if a threshold breach accompanies it
Responsible (R): Category Manager
Accountable (A): Procurement Manager
Duration: 30 min/vendor/quarter</bpmn:documentation>
        <bpmn:incoming>W2463_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2463_End6" name="Complete">
        <bpmn:incoming>W2463_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2463_Annotation7">
        <bpmn:text>Controls: - CTL-177 (ensure vendor scorecard data quality &amp; performance action.) | - Operational: VP Supply Chain reviews any strategic-vendor target miss before it escalates to W2465 (prevents a single Category Manager from unilaterally PIP-ing a strategic relationship)
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2463_Assoc8" sourceRef="W2463_Annotation7" targetRef="W2463_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2463_Flow9" sourceRef="W2463_Start3" targetRef="W2463_Task4" />
      <bpmn:sequenceFlow id="W2463_Flow10" sourceRef="W2463_Task4" targetRef="W2463_Task5" />
      <bpmn:sequenceFlow id="W2463_Flow11" sourceRef="W2463_Task5" targetRef="W2463_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2463_diag">
      <bpmndi:BPMNPlane id="W2463_plane" bpmnElement="W_W2463">
        <bpmndi:BPMNShape id="W2463_Lane1_di" bpmnElement="W2463_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2463_Task4_di" bpmnElement="W2463_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2463_Task5_di" bpmnElement="W2463_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2463_Start3_di" bpmnElement="W2463_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2463_End6_di" bpmnElement="W2463_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2463_Annotation7_di" bpmnElement="W2463_Annotation7"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2463_Flow9_di" bpmnElement="W2463_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2463_Flow10_di" bpmnElement="W2463_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2463_Flow11_di" bpmnElement="W2463_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2463_Assoc8_di" bpmnElement="W2463_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2464" name="W2464. Annual Vendor Tier Classification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual classification review
Frequency: Annual; ~800–1,000 vendors classified
Volume: ~800–1,000 classifications/year
Owner: VP Supply Chain
Participants: VP Supply Chain, Procurement Mgr, Category Mgrs, CFO
Source: workflow W2464 — Annual Vendor Tier Classification</bpmn:documentation>
      <bpmn:laneSet id="W2464_LaneSet2">
        <bpmn:lane id="W2464_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W2464_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2464_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2464_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2464_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2464_Start3" name="Annual classification review">
        <bpmn:outgoing>W2464_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2464_Task4" name="VP Supply Chain classifies vendors into five tiers from the annual scorecard…">
        <bpmn:documentation>Step 1: VP Supply Chain classifies vendors into five tiers from the annual scorecard rollup: (a) Strategic/Platinum — top 20 vendors (~45% of COGS), (b) Preferred/Gold — next 50, (c) Approved/Silver — standard, (d) Probation/Bronze — underperforming, (e) Watch/At-Risk — potential for delisting per W2466
Responsible (R): VP Supply Chain
Accountable (A): CFO
Duration: 5–10 days/year</bpmn:documentation>
        <bpmn:incoming>W2464_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2464_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2464_Task5" name="Tier determines commercial treatment: PO allocation priority, payment terms…">
        <bpmn:documentation>Step 2: Tier determines commercial treatment: PO allocation priority, payment terms, co-op marketing budget (links to VS-39 rebates), strategic-collaboration level (joint business planning), vendor-development investment (links to VS-67.3)
Responsible (R): VP Supply Chain / CFO
Accountable (A): CEO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2464_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2464_End6" name="Complete">
        <bpmn:incoming>W2464_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2464_Annotation7">
        <bpmn:text>Controls: - CTL-06 (vendor-master integrity — the tier tag must be current, since it drives payment terms and allocation); operational: CFO approval on tier changes affecting Strategic/Platinum vendors (commercial-materiality control)
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2464_Assoc8" sourceRef="W2464_Annotation7" targetRef="W2464_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2464_Flow9" sourceRef="W2464_Start3" targetRef="W2464_Task4" />
      <bpmn:sequenceFlow id="W2464_Flow10" sourceRef="W2464_Task4" targetRef="W2464_Task5" />
      <bpmn:sequenceFlow id="W2464_Flow11" sourceRef="W2464_Task5" targetRef="W2464_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2464_diag">
      <bpmndi:BPMNPlane id="W2464_plane" bpmnElement="W_W2464">
        <bpmndi:BPMNShape id="W2464_Lane1_di" bpmnElement="W2464_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2464_Task4_di" bpmnElement="W2464_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2464_Task5_di" bpmnElement="W2464_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2464_Start3_di" bpmnElement="W2464_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2464_End6_di" bpmnElement="W2464_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2464_Annotation7_di" bpmnElement="W2464_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2464_Flow9_di" bpmnElement="W2464_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2464_Flow10_di" bpmnElement="W2464_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2464_Flow11_di" bpmnElement="W2464_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2464_Assoc8_di" bpmnElement="W2464_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2465" name="W2465. Vendor Performance Improvement Plan (PIP)" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor falls below performance threshold
Frequency: ~20–30 PIPs/year
Volume: ~20–30/year
Owner: Procurement Manager
Participants: Procurement Mgr, Category Mgr, Vendor, VP Supply Chain
Source: workflow W2465 — Vendor Performance Improvement Plan (PIP)</bpmn:documentation>
      <bpmn:laneSet id="W2465_LaneSet2">
        <bpmn:lane id="W2465_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2465_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2465_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2465_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2465_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2465_Start3" name="Vendor falls below performance threshold">
        <bpmn:outgoing>W2465_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2465_Task4" name="Procurement Manager issues a formal PIP to the underperforming vendor: cites…">
        <bpmn:documentation>Step 1: Procurement Manager issues a formal PIP to the underperforming vendor: cites the specific KPIs below threshold (from W2458), the required improvement levels, the 90-day timeline, and the consequences if not met (volume reduction or escalation to W2466 delisting); documents in the vendor record
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2–3 hours per PIP</bpmn:documentation>
        <bpmn:incoming>W2465_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2465_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2465_Task5" name="Monthly check-ins during the PIP window: vendor reports corrective actions…">
        <bpmn:documentation>Step 2: Monthly check-ins during the PIP window: vendor reports corrective actions taken, Procurement validates improvement against the W2458 monthly scorecard; if targets met → graduate from PIP with the improved baseline locked; if not → escalate to the W2466 delisting review
Responsible (R): Procurement Manager / Vendor
Accountable (A): VP Supply Chain
Duration: 1 hour/month per PIP</bpmn:documentation>
        <bpmn:incoming>W2465_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2465_End6" name="Complete">
        <bpmn:incoming>W2465_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2465_Annotation7">
        <bpmn:text>Controls: - CTL-48: rebate-dispute pattern is one PIP trigger — commercial and performance signals converge here; operational: PIP-outcome follow-through sampled in the W2459 quarterly audit
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2465_Assoc8" sourceRef="W2465_Annotation7" targetRef="W2465_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2465_Flow9" sourceRef="W2465_Start3" targetRef="W2465_Task4" />
      <bpmn:sequenceFlow id="W2465_Flow10" sourceRef="W2465_Task4" targetRef="W2465_Task5" />
      <bpmn:sequenceFlow id="W2465_Flow11" sourceRef="W2465_Task5" targetRef="W2465_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2465_diag">
      <bpmndi:BPMNPlane id="W2465_plane" bpmnElement="W_W2465">
        <bpmndi:BPMNShape id="W2465_Lane1_di" bpmnElement="W2465_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2465_Task4_di" bpmnElement="W2465_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2465_Task5_di" bpmnElement="W2465_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2465_Start3_di" bpmnElement="W2465_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2465_End6_di" bpmnElement="W2465_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2465_Annotation7_di" bpmnElement="W2465_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2465_Flow9_di" bpmnElement="W2465_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2465_Flow10_di" bpmnElement="W2465_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2465_Flow11_di" bpmnElement="W2465_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2465_Assoc8_di" bpmnElement="W2465_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2466" name="W2466. Vendor Delisting Decision &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor consistently underperforms despite PIP
Frequency: ~5–10 delistings/year
Volume: ~5–10/year
Owner: VP Supply Chain
Participants: VP Supply Chain, Category Mgr, Procurement, Finance, Legal
Source: workflow W2466 — Vendor Delisting Decision &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W2466_LaneSet3">
        <bpmn:lane id="W2466_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W2466_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2466_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2466_Lane2" name="Category Mgr">
        <bpmn:flowNodeRef>W2466_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2466_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2466_Start4" name="Vendor consistently underperforms despite PIP">
        <bpmn:outgoing>W2466_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2466_Task5" name="VP Supply Chain initiates the delisting: documents the performance history, the…">
        <bpmn:documentation>Step 1: VP Supply Chain initiates the delisting: documents the performance history, the W2465 PIP results, the quantified business impact (stockouts, quality costs, expedite fees); confirms an alternative vendor is qualified and can absorb the volume (links to VS-02 supply planning); presents the recommendation to the Category Manager and CFO
Responsible (R): VP Supply Chain
Accountable (A): CFO
Duration: 3–5 days per delisting</bpmn:documentation>
        <bpmn:incoming>W2466_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2466_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2466_Task6" name="Category Manager approves the alternative sourcing; Procurement transitions the…">
        <bpmn:documentation>Step 2: Category Manager approves the alternative sourcing; Procurement transitions the volume over a defined ramp-down; Finance settles final payments and any open rebates/consignment (links to VS-39, VS-45); Legal reviews contractual obligations and termination notice; vendor-portal access revoked (links to VS-28/W593) and the vendor-master set to &quot;inactive — do not pay&quot; (CTL-06)
Responsible (R): Category Mgr / Procurement / Finance / Legal
Accountable (A): VP Supply Chain
Duration: 30–60 days</bpmn:documentation>
        <bpmn:incoming>W2466_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2466_End7" name="Complete">
        <bpmn:incoming>W2466_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2466_Annotation8">
        <bpmn:text>Controls: - CTL-06: vendor-master status — the &quot;do not pay&quot; block is the key fraud-prevention control on a delisted vendor; CTL-42 (bank-account-change guard — prevents a delisted vendor&#x27;s last-payment reroute); operational: CFO + Legal sign-off on every delisting
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2466_Assoc9" sourceRef="W2466_Annotation8" targetRef="W2466_Start4" associationDirection="None" />
