    <bpmn:process id="W_W2467" name="W2467. Vendor Recognition &amp; Award Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor awards
Frequency: Annual; top performers recognized
Volume: 10–15 vendors recognized/year
Owner: VP Supply Chain
Participants: VP Supply Chain, Procurement Mgr, Category Mgrs, CEO
Source: workflow W2467 — Vendor Recognition &amp; Award Program</bpmn:documentation>
      <bpmn:laneSet id="W2467_LaneSet2">
        <bpmn:lane id="W2467_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W2467_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2467_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2467_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2467_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2467_Start3" name="Annual vendor awards">
        <bpmn:outgoing>W2467_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2467_Task4" name="VP Supply Chain identifies award recipients from the annual W2464 tier…">
        <bpmn:documentation>Step 1: VP Supply Chain identifies award recipients from the annual W2464 tier classification and W2458 scorecard: Vendor of the Year (highest composite), Quality Excellence (best quality dimension), Delivery Reliability (best OTD/fill), Innovation Partner (best innovation dimension / new-SKU contribution), Sustainability Champion (best ESG/sustainable-sourcing evidence per VS-25/VS-131); coordinates a recognition event (annual supplier summit or virtual)
Responsible (R): VP Supply Chain
Accountable (A): CEO
Duration: 3–5 days/year</bpmn:documentation>
        <bpmn:incoming>W2467_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2467_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2467_Task5" name="Awards carry commercial weight: increased PO allocation priority, preferred…">
        <bpmn:documentation>Step 2: Awards carry commercial weight: increased PO allocation priority, preferred payment terms, co-marketing opportunities, and a strategic-partnership discussion (joint business planning); reinforces the performance culture and signals to the vendor base what excellence looks like
Responsible (R): VP Supply Chain / Procurement Mgr
Accountable (A): Category Mgr
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2467_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2467_End6" name="Complete">
        <bpmn:incoming>W2467_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2467_Annotation7">
        <bpmn:text>Controls: - CTL-431 (ensure controlled execution — Vendor Performance Review &amp; Rating (PA-67.2).) | - Operational: CEO sign-off on Vendor of the Year (reputational-materiality control); award selection criteria documented and retained (audit trail for any &quot;why not us&quot; vendor query)
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2467_Assoc8" sourceRef="W2467_Annotation7" targetRef="W2467_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2467_Flow9" sourceRef="W2467_Start3" targetRef="W2467_Task4" />
      <bpmn:sequenceFlow id="W2467_Flow10" sourceRef="W2467_Task4" targetRef="W2467_Task5" />
      <bpmn:sequenceFlow id="W2467_Flow11" sourceRef="W2467_Task5" targetRef="W2467_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2467_diag">
      <bpmndi:BPMNPlane id="W2467_plane" bpmnElement="W_W2467">
        <bpmndi:BPMNShape id="W2467_Lane1_di" bpmnElement="W2467_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
