      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2469" name="W2469. Cross-Functional Vendor Feedback Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly cross-functional input
Frequency: Quarterly; 5 functions (Procurement, Quality, Finance, Store Ops, Merchandising)
Volume: 5 functional inputs/quarter
Owner: Procurement Manager
Participants: Procurement Mgr, Quality Mgr, Finance Mgr, VP Store Operations, Category Mgrs
Source: workflow W2469 — Cross-Functional Vendor Feedback Integration</bpmn:documentation>
      <bpmn:laneSet id="W2469_LaneSet2">
        <bpmn:lane id="W2469_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2469_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2469_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2469_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2469_Start3" name="Quarterly cross-functional input">
        <bpmn:outgoing>W2469_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2469_Task4" name="Procurement collects structured cross-functional feedback per strategic vendor…">
        <bpmn:documentation>Step 1: Procurement collects structured cross-functional feedback per strategic vendor: Quality (inspection trends from W110/W681), Finance (invoice-dispute frequency and payment-terms compliance from W7/W100), Store Ops (delivery-quality / receiving experience from W3/W681), Merchandising (product quality and trend-responsiveness from VS-01/VS-14); integrates the weighted signals into the qualitative dimension of the W2458 composite
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2469_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2469_End5" name="Complete">
        <bpmn:incoming>W2469_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2469_Annotation6">
        <bpmn:text>Controls: - CTL-24: receiving-fraud detection — Store Ops feedback that surfaces anomalous receiving patterns feeds back into CTL-24&#x27;s monitoring; operational: cross-functional inputs retained as audit trail for any subsequent W2465 PIP or W2466 delisting decision
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2469_Assoc7" sourceRef="W2469_Annotation6" targetRef="W2469_Start3" associationDirection="None" />
