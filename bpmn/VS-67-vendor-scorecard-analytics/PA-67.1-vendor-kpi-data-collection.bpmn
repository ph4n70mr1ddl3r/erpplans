    <bpmn:process id="W_W2459" name="W2459. Vendor Scorecard Data Quality Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly data quality audit
Frequency: Quarterly; ~200 vendor scorecards spot-checked
Volume: ~200 spot-checks/quarter
Owner: Data Quality Analyst
Participants: Data Quality Analyst, Procurement Analyst
Source: workflow W2459 — Vendor Scorecard Data Quality Audit</bpmn:documentation>
      <bpmn:laneSet id="W2459_LaneSet2">
        <bpmn:lane id="W2459_Lane1" name="Data Quality Analyst">
        <bpmn:flowNodeRef>W2459_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2459_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2459_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2459_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2459_Start3" name="Quarterly data quality audit">
        <bpmn:outgoing>W2459_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2459_Task4" name="Audits scorecard integrity: validates data sources (W2455 transactional facts…">
        <bpmn:documentation>Step 1: Audits scorecard integrity: validates data sources (W2455 transactional facts reconcile to GL/PO counts), checks for missing data periods, verifies calculation accuracy (re-computes a sample of 10 composite scores by hand), identifies vendors with anomalous override frequency from W2458
Responsible (R): Data Quality Analyst
Accountable (A): Procurement Manager
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2459_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2459_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2459_Task5" name="Issues a data-quality attestation with the audit findings; any integrity…">
        <bpmn:documentation>Step 2: Issues a data-quality attestation with the audit findings; any integrity failure triggers a scorecard re-publication for the affected vendors and a root-cause fix in the W2455 collection pipeline
Responsible (R): Data Quality Analyst
Accountable (A): Procurement Manager
Duration: 1–2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W2459_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2459_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2459_End6" name="Complete">
        <bpmn:incoming>W2459_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2459_Annotation7">
        <bpmn:text>Controls: - CTL-51: stale/incomplete master data — applies to the vendor-master tags driving the scorecard; operational: Data Quality Analyst attestation filed each quarter before the next cycle&#x27;s publication
Owner: Data Quality Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2459_Assoc8" sourceRef="W2459_Annotation7" targetRef="W2459_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2459_Flow9" sourceRef="W2459_Start3" targetRef="W2459_Task4" />
      <bpmn:sequenceFlow id="W2459_Flow10" sourceRef="W2459_Task4" targetRef="W2459_Task5" />
      <bpmn:sequenceFlow id="W2459_Flow11" sourceRef="W2459_Task5" targetRef="W2459_End6" />
    </bpmn:process>
