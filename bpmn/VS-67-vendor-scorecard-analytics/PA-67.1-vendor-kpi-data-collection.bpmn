        <bpmndi:BPMNShape id="W2454_Start3_di" bpmnElement="W2454_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2454_End7_di" bpmnElement="W2454_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2454_Annotation8_di" bpmnElement="W2454_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2454_Flow10_di" bpmnElement="W2454_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2454_Flow11_di" bpmnElement="W2454_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2454_Flow12_di" bpmnElement="W2454_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2454_Flow13_di" bpmnElement="W2454_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2454_Assoc9_di" bpmnElement="W2454_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2455" name="W2455. Automated Vendor Data Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous transaction processing
Frequency: Continuous; ~1,200 POs and ~6,715 invoices/month
Volume: ~800–1,000 vendors with transaction data
Owner: System / Data Quality Analyst
Participants: System, Data Quality Analyst, Procurement
Source: workflow W2455 — Automated Vendor Data Collection</bpmn:documentation>
      <bpmn:laneSet id="W2455_LaneSet3">
        <bpmn:lane id="W2455_Lane1" name="System">
        <bpmn:flowNodeRef>W2455_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2455_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2455_Lane2" name="Data Quality Analyst">
        <bpmn:flowNodeRef>W2455_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2455_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2455_Start4" name="Continuous transaction processing">
        <bpmn:outgoing>W2455_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2455_Task5" name="System auto-collects vendor transaction data on each closed document: PO…">
        <bpmn:documentation>Step 1: System auto-collects vendor transaction data on each closed document: PO delivery date vs. promised date (on-time), PO quantity vs. GR received quantity (fill rate), GR quality flags from W110/W681 (rejection rate), 3-way-match variance from W7 (invoice accuracy), RFQ-to-response timestamp from W2 (responsiveness)
Responsible (R): System
Accountable (A): Data Quality Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2455_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2455_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2455_Task6" name="Data Quality Analyst monitors nightly collection job: reviews exception log…">
        <bpmn:documentation>Step 2: Data Quality Analyst monitors nightly collection job: reviews exception log (missing GR, unmatched invoice, orphaned RFQ); resolves source-system gaps or escalates to MDM (VS-29) for vendor-master fixes; confirms nightly record count within expected band before the monthly calc (W2458) reads the dataset
Responsible (R): Data Quality Analyst
Accountable (A): Procurement Manager
Duration: 30–60 min/day</bpmn:documentation>
        <bpmn:incoming>W2455_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2455_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2455_End7" name="Complete">
        <bpmn:incoming>W2455_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2455_Annotation8">
        <bpmn:text>Controls: - CTL-44 (duplicate-invoice guard — prevents a double-counted invoice from inflating accuracy KPI); CTL-24 (receiving-fraud detection — fraudulent GR would corrupt fill-rate KPI)
Owner: System / Data Quality Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2455_Assoc9" sourceRef="W2455_Annotation8" targetRef="W2455_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2455_Flow10" sourceRef="W2455_Start4" targetRef="W2455_Task5" />
      <bpmn:sequenceFlow id="W2455_Flow11" sourceRef="W2455_Task5" targetRef="W2455_Task6" />
      <bpmn:sequenceFlow id="W2455_Flow12" sourceRef="W2455_Task6" targetRef="W2455_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2455_diag">
      <bpmndi:BPMNPlane id="W2455_plane" bpmnElement="W_W2455">
        <bpmndi:BPMNShape id="W2455_Lane1_di" bpmnElement="W2455_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_Lane2_di" bpmnElement="W2455_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_Task5_di" bpmnElement="W2455_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_Task6_di" bpmnElement="W2455_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_Start4_di" bpmnElement="W2455_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_End7_di" bpmnElement="W2455_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2455_Annotation8_di" bpmnElement="W2455_Annotation8"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2455_Flow10_di" bpmnElement="W2455_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2455_Flow11_di" bpmnElement="W2455_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2455_Flow12_di" bpmnElement="W2455_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2455_Assoc9_di" bpmnElement="W2455_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2456" name="W2456. Vendor Quality Data Aggregation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly quality data compilation
Frequency: Monthly; from VS-31 quality inspection results
Volume: ~2,400 quality inspections/month feeding vendor scores
Owner: Quality Manager
Participants: Quality Mgr, Procurement Mgr, DC Quality Inspectors
Source: workflow W2456 — Vendor Quality Data Aggregation</bpmn:documentation>
      <bpmn:laneSet id="W2456_LaneSet2">
        <bpmn:lane id="W2456_Lane1" name="Quality Manager">
        <bpmn:flowNodeRef>W2456_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2456_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2456_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2456_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2456_Start3" name="Monthly quality data compilation">
        <bpmn:outgoing>W2456_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2456_Task4" name="Quality Manager aggregates per-vendor quality data from VS-31 inspections: pass…">
        <bpmn:documentation>Step 1: Quality Manager aggregates per-vendor quality data from VS-31 inspections: pass rate, defect-type breakdown (cosmetic, functional, packaging, short-dated), complaint rate (from VS-13/W41), recall incidents (from VS-89/W29); feeds the quality dimension (30% weight) of the vendor scorecard
Responsible (R): Quality Manager
Accountable (A): VP Supply Chain
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2456_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2456_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2456_Task5" name="Flags vendors with declining quality trends (3-month rolling defect rate…">
        <bpmn:documentation>Step 2: Flags vendors with declining quality trends (3-month rolling defect rate trending up, or any single-month defect spike &gt;2× trailing average); routes flagged vendors to the W2462/W2463 corrective-action workflow
Responsible (R): Quality Manager
Accountable (A): Procurement Manager
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W2456_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2456_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2456_End6" name="Complete">
        <bpmn:incoming>W2456_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2456_Annotation7">
        <bpmn:text>Controls: - CTL-24: receiving-fraud / inspection integrity — falsified inspections would corrupt the quality KPI; operational: Quality Manager sign-off on the monthly quality-dimension extract before it feeds W2458
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2456_Assoc8" sourceRef="W2456_Annotation7" targetRef="W2456_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2456_Flow9" sourceRef="W2456_Start3" targetRef="W2456_Task4" />
      <bpmn:sequenceFlow id="W2456_Flow10" sourceRef="W2456_Task4" targetRef="W2456_Task5" />
      <bpmn:sequenceFlow id="W2456_Flow11" sourceRef="W2456_Task5" targetRef="W2456_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2456_diag">
      <bpmndi:BPMNPlane id="W2456_plane" bpmnElement="W_W2456">
        <bpmndi:BPMNShape id="W2456_Lane1_di" bpmnElement="W2456_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2456_Task4_di" bpmnElement="W2456_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2456_Task5_di" bpmnElement="W2456_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2456_Start3_di" bpmnElement="W2456_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2456_End6_di" bpmnElement="W2456_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2456_Annotation7_di" bpmnElement="W2456_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2456_Flow9_di" bpmnElement="W2456_Flow9"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2456_Flow10_di" bpmnElement="W2456_Flow10"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2456_Flow11_di" bpmnElement="W2456_Flow11"><di:waypoint x="790" y="165" /><di:waypoint x="840" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2456_Assoc8_di" bpmnElement="W2456_Assoc8"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2457" name="W2457. Vendor Survey &amp; Qualitative Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor relationship survey
Frequency: Annual; ~100 strategic vendors surveyed
Volume: ~100 vendors
Owner: Procurement Manager
Participants: Procurement Mgr, Category Mgrs, Buyers
Source: workflow W2457 — Vendor Survey &amp; Qualitative Assessment</bpmn:documentation>
      <bpmn:laneSet id="W2457_LaneSet3">
        <bpmn:lane id="W2457_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W2457_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2457_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2457_Lane2" name="Procurement Manager">
        <bpmn:flowNodeRef>W2457_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2457_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2457_Start4" name="Annual vendor relationship survey">
        <bpmn:outgoing>W2457_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2457_Task5" name="Procurement conducts the internal vendor-relationship survey: Category Managers…">
        <bpmn:documentation>Step 1: Procurement conducts the internal vendor-relationship survey: Category Managers and Buyers rate the ~100 strategic vendors on five qualitative dimensions — communication clarity, flexibility (order-change accommodation), problem-resolution speed, innovation contribution, strategic alignment with BuildRight&#x27;s category plan
Responsible (R): Category Managers / Buyers
Accountable (A): Procurement Manager
Duration: 5–10 days/year (distributed across ~15 raters)</bpmn:documentation>
        <bpmn:incoming>W2457_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2457_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2457_Task6" name="Procurement Manager normalizes scores (remove rater bias via z-score per…">
        <bpmn:documentation>Step 2: Procurement Manager normalizes scores (remove rater bias via z-score per rater), weights by the rater&#x27;s transaction volume with the vendor, and produces the qualitative score that supplements the transactional KPIs in the composite (W2458)
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W2457_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2457_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2457_End7" name="Complete">
        <bpmn:incoming>W2457_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2457_Annotation8">
        <bpmn:text>Controls: - CTL-430 (ensure controlled execution — Vendor KPI Definition &amp; Data Collection (PA-67.1).) | - Operational: Procurement Manager review of any vendor where qualitative and transactional scores diverge by &gt;2 tiers (a control on gaming — a vendor beloved by Buyers but with poor OTD warrants investigation)
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2457_Assoc9" sourceRef="W2457_Annotation8" targetRef="W2457_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2457_Flow10" sourceRef="W2457_Start4" targetRef="W2457_Task5" />
      <bpmn:sequenceFlow id="W2457_Flow11" sourceRef="W2457_Task5" targetRef="W2457_Task6" />
      <bpmn:sequenceFlow id="W2457_Flow12" sourceRef="W2457_Task6" targetRef="W2457_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2457_diag">
      <bpmndi:BPMNPlane id="W2457_plane" bpmnElement="W_W2457">
        <bpmndi:BPMNShape id="W2457_Lane1_di" bpmnElement="W2457_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_Lane2_di" bpmnElement="W2457_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_Task5_di" bpmnElement="W2457_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_Task6_di" bpmnElement="W2457_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_Start4_di" bpmnElement="W2457_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_End7_di" bpmnElement="W2457_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2457_Annotation8_di" bpmnElement="W2457_Annotation8"><dc:Bounds x="160" y="460" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2457_Flow10_di" bpmnElement="W2457_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2457_Flow11_di" bpmnElement="W2457_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2457_Flow12_di" bpmnElement="W2457_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2457_Assoc9_di" bpmnElement="W2457_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2458" name="W2458. Vendor Score Calculation &amp; Weighting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly score calculation cycle
Frequency: Monthly; ~800–1,000 vendors scored
Volume: ~800–1,000 scores/month
Owner: System / Procurement Analyst
Participants: System, Procurement Analyst, Procurement Mgr
Source: workflow W2458 — Vendor Score Calculation &amp; Weighting</bpmn:documentation>
      <bpmn:laneSet id="W2458_LaneSet3">
        <bpmn:lane id="W2458_Lane1" name="System">
        <bpmn:flowNodeRef>W2458_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2458_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2458_Lane2" name="Procurement Analyst">
        <bpmn:flowNodeRef>W2458_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2458_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2458_Start4" name="Monthly score calculation cycle">
        <bpmn:outgoing>W2458_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2458_Task5" name="System calculates the composite score per vendor: weighted average of all KPI…">
        <bpmn:documentation>Step 1: System calculates the composite score per vendor: weighted average of all KPI dimensions per the W2454 framework (quality 30%, delivery 25%, cost 20%, responsiveness 15%, innovation 10%); applies the cross-dimensional penalty (a bottom-quartile result in any one dimension caps the composite at &quot;B&quot; regardless of average); generates the monthly vendor ranking
Responsible (R): System
Accountable (A): Procurement Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2458_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2458_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2458_Task6" name="Procurement Analyst reviews the scores: validates data accuracy against source…">
        <bpmn:documentation>Step 2: Procurement Analyst reviews the scores: validates data accuracy against source extracts, investigates anomalous month-over-month swings (&gt;15 points), adjusts for exceptional circumstances (force majeure, seasonal volume spikes, documented BuildRight-caused delays from W2455); publishes the monthly vendor scorecard to Category Managers and the VP Supply Chain
Responsible (R): Procurement Analyst
Accountable (A): Procurement Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2458_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2458_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2458_End7" name="Complete">
        <bpmn:incoming>W2458_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2458_Annotation8">
        <bpmn:text>Controls: - CTL-48: rebate-dispute frequency is itself a vendor-scorecard input — links the commercial and performance views; operational: override log reviewed in the W2459 quarterly audit
Owner: System / Procurement Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2458_Assoc9" sourceRef="W2458_Annotation8" targetRef="W2458_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2458_Flow10" sourceRef="W2458_Start4" targetRef="W2458_Task5" />
      <bpmn:sequenceFlow id="W2458_Flow11" sourceRef="W2458_Task5" targetRef="W2458_Task6" />
      <bpmn:sequenceFlow id="W2458_Flow12" sourceRef="W2458_Task6" targetRef="W2458_End7" />
    </bpmn:process>
