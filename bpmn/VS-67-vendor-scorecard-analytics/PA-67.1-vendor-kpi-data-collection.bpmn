      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2460" name="W2460. New Vendor Baseline Performance Establishment" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarded; first 6 months
Frequency: ~5–10 new vendors/month
Volume: ~5–10/month
Owner: Buyer
Participants: Buyer, Procurement Mgr, Quality Mgr
Source: workflow W2460 — New Vendor Baseline Performance Establishment</bpmn:documentation>
      <bpmn:laneSet id="W2460_LaneSet2">
        <bpmn:lane id="W2460_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W2460_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2460_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2460_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2460_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2460_Start3" name="New vendor onboarded; first 6 months">
        <bpmn:outgoing>W2460_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2460_Task4" name="For the vendor&#x27;s first 6 months: enhanced monitoring on all KPIs at weekly (not…">
        <bpmn:documentation>Step 1: For the vendor&#x27;s first 6 months: enhanced monitoring on all KPIs at weekly (not monthly) cadence; establishes the baseline performance against which future months are compared; any KPI below threshold triggers an immediate corrective discussion (not waiting for the monthly cycle)
Responsible (R): Buyer / Procurement Mgr
Accountable (A): VP Supply Chain
Duration: 1–2 hours/week per new vendor</bpmn:documentation>
        <bpmn:incoming>W2460_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2460_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2460_Task5" name="At month 6: Buyer and Quality Manager conduct a baseline-establishment review —…">
        <bpmn:documentation>Step 2: At month 6: Buyer and Quality Manager conduct a baseline-establishment review — confirm the vendor is performing within the negotiated commitments (vs. the sales-pitch promises), set the formal performance baseline, and transition the vendor from enhanced to standard monthly monitoring
Responsible (R): Buyer / Quality Manager
Accountable (A): Procurement Manager
Duration: 2–3 hours/vendor at month 6</bpmn:documentation>
        <bpmn:incoming>W2460_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2460_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2460_End6" name="Complete">
        <bpmn:incoming>W2460_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2460_Annotation7">
        <bpmn:text>Controls: - CTL-06: vendor-onboarding integrity — the negotiated commitments must be documented at onboarding to be measurable at month 6; operational: month-6 review sign-off by Buyer + Quality Manager
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2460_Assoc8" sourceRef="W2460_Annotation7" targetRef="W2460_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2460_Flow9" sourceRef="W2460_Start3" targetRef="W2460_Task4" />
      <bpmn:sequenceFlow id="W2460_Flow10" sourceRef="W2460_Task4" targetRef="W2460_Task5" />
      <bpmn:sequenceFlow id="W2460_Flow11" sourceRef="W2460_Task5" targetRef="W2460_End6" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2460_diag">
      <bpmndi:BPMNPlane id="W2460_plane" bpmnElement="W_W2460">
        <bpmndi:BPMNShape id="W2460_Lane1_di" bpmnElement="W2460_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2460_Task4_di" bpmnElement="W2460_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2460_Task5_di" bpmnElement="W2460_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2460_Start3_di" bpmnElement="W2460_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2460_End6_di" bpmnElement="W2460_End6"><dc:Bounds x="840" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2460_Annotation7_di" bpmnElement="W2460_Annotation7"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
