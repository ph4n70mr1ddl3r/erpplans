<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-67.1-vendor-kpi-data-collection" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2454" name="W2454. Vendor KPI Framework Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual KPI review or new vendor category
Frequency: Annual review; continuous monitoring
Volume: ~20 KPIs tracked for ~800–1,000 vendors
Owner: Procurement Manager
Participants: Procurement Mgr, Category Mgrs, VP Supply Chain
Source: workflow W2454 — Vendor KPI Framework Management</bpmn:documentation>
      <bpmn:laneSet id="W2454_LaneSet2">
        <bpmn:lane id="W2454_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2454_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2454_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2454_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2454_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2454_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2454_Start3" name="Annual KPI review or new vendor category">
        <bpmn:outgoing>W2454_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2454_Task4" name="Procurement Manager maintains the KPI framework across seven dimensions: (a)…">
        <bpmn:documentation>Step 1: Procurement Manager maintains the KPI framework across seven dimensions: (a) on-time delivery rate (target ≥95%), (b) order fill rate (target ≥98%), (c) quality rejection rate (target &lt;2%), (d) invoice accuracy (target ≥99%), (e) responsiveness to RFQ/orders (target &lt;48 hours), (f) price competitiveness vs. market index, (g) innovation contribution (new-SKU introduction, joint promotions)
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2–3 days/year + 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2454_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2454_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2454_Task5" name="Reviews and adjusts KPI weights by vendor category — import vs. local…">
        <bpmn:documentation>Step 2: Reviews and adjusts KPI weights by vendor category — import vs. local, strategic vs. tactical, merchandise vs. non-merchandise — so the composite reflects current business priorities (e.g., import vendors weighted harder on delivery due to lead-time risk; local vendors weighted harder on responsiveness)
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W2454_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2454_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2454_Task6" name="Documents framework version, effective date, and rationale in the procurement…">
        <bpmn:documentation>Step 3: Documents framework version, effective date, and rationale in the procurement policy repository; communicates changes to Category Managers and Buyers before the next scoring cycle so no mid-period surprises invalidate vendor reviews
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2–4 hours/version</bpmn:documentation>
        <bpmn:incoming>W2454_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2454_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2454_End7" name="Complete">
        <bpmn:incoming>W2454_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2454_Annotation8">
        <bpmn:text>Controls: - CTL-06 (vendor-master integrity — category tag accuracy drives the right KPI set); operational: framework version approved by VP Supply Chain before the monthly calc reads it (W2458)
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2454_Assoc9" sourceRef="W2454_Annotation8" targetRef="W2454_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2454_Flow10" sourceRef="W2454_Start3" targetRef="W2454_Task4" />
      <bpmn:sequenceFlow id="W2454_Flow11" sourceRef="W2454_Task4" targetRef="W2454_Task5" />
      <bpmn:sequenceFlow id="W2454_Flow12" sourceRef="W2454_Task5" targetRef="W2454_Task6" />
      <bpmn:sequenceFlow id="W2454_Flow13" sourceRef="W2454_Task6" targetRef="W2454_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2454_diag">
      <bpmndi:BPMNPlane id="W2454_plane" bpmnElement="W_W2454">
        <bpmndi:BPMNShape id="W2454_Lane1_di" bpmnElement="W2454_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2454_Task4_di" bpmnElement="W2454_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2454_Task5_di" bpmnElement="W2454_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
