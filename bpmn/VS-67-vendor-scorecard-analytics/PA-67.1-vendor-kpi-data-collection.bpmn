      <bpmndi:BPMNPlane id="W2461_plane" bpmnElement="W_W2461">
        <bpmndi:BPMNShape id="W2461_Lane1_di" bpmnElement="W2461_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
