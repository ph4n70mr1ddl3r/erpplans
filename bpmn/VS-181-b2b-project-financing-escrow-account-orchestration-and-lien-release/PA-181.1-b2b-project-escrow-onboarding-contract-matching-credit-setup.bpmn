        <bpmn:outgoing>W5203_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5203_Task4" name="Review developer&#x27;s construction timeline and material delivery schedule (e.g…">
        <bpmn:documentation>Step 1: Review developer&#x27;s construction timeline and material delivery schedule (e.g. concrete rebar for Month 1, tiles for Month 6).
Responsible (R): Supply Chain Planner / Project Coordinator
Accountable (A): Supply Chain Planner / Project Coordinator
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5203_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5203_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5203_Task5" name="Generate project-specific material requirements forecast (in SKUs and volumes).">
        <bpmn:documentation>Step 2: Generate project-specific material requirements forecast (in SKUs and volumes).
Responsible (R): Supply Chain Planner / Project Coordinator
Accountable (A): Supply Chain Planner / Project Coordinator
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5203_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5203_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5203_Task6" name="Draft the Staging Plan: schedule warehouse allocation locks at nearest DC to…">
        <bpmn:documentation>Step 3: Draft the Staging Plan: schedule warehouse allocation locks at nearest DC to reserve stock for upcoming project phases (VS-77).
Responsible (R): Supply Chain Planner / Project Coordinator
Accountable (A): Supply Chain Planner / Project Coordinator
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5203_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5203_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5203_Task7" name="Review staging plans monthly; adjust forecast based on construction progress…">
        <bpmn:documentation>Step 4: Review staging plans monthly; adjust forecast based on construction progress reports.
Responsible (R): Supply Chain Planner / Project Coordinator
Accountable (A): Supply Chain Planner / Project Coordinator
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5203_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5203_End8" name="Complete">
        <bpmn:incoming>W5203_Flow15</bpmn:incoming>
      </bpmn:endEvent>
