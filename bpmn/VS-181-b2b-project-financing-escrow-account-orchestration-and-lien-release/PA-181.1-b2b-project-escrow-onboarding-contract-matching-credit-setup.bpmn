    <bpmn:process id="W_W5203" name="W5203. B2B Project Materials Requirements Forecasting &amp; Staging Plan" isExecutable="false">
      <bpmn:documentation>Trigger: Approved project schedule / project onboarding (W5201)
Frequency: Monthly per project
Volume: Monitoring ~100–120 active construction projects
Owner: Supply Chain Planner / Project Coordinator
Participants: General Contractor Site Engineer, S&amp;OP Planner (VS-127), DC Manager (VS-04)
Source: workflow W5203 — B2B Project Materials Requirements Forecasting &amp; Staging Plan</bpmn:documentation>
      <bpmn:laneSet id="W5203_LaneSet2">
        <bpmn:lane id="W5203_Lane1" name="Supply Chain Planner">
        <bpmn:flowNodeRef>W5203_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5203_Task5</bpmn:flowNodeRef>
