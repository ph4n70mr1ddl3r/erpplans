      <bpmn:sequenceFlow id="W4007_Flow12" sourceRef="W4007_Task5" targetRef="W4007_Task6" />
      <bpmn:sequenceFlow id="W4007_Flow13" sourceRef="W4007_Task6" targetRef="W4007_Task7" />
      <bpmn:sequenceFlow id="W4007_Flow14" sourceRef="W4007_Task7" targetRef="W4007_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4007_diag">
      <bpmndi:BPMNPlane id="W4007_plane" bpmnElement="W_W4007">
