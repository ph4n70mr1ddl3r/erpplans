    <bpmn:process id="W_W4008" name="W4008. Conflict-Affected, Indigenous Peoples &amp; Land-Rights Risk Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Saliency (W4002); raw-material sourcing (timber, minerals, palm)
Frequency: Annual + on sourcing change
Volume: Salient raw-material categories
Owner: Sustainability/ESG Manager / VP Supply Chain
Participants: Sustainability, Procurement/Global Sourcing (links to VS-03/VS-122), Legal, Insights (links to VS-44), external advisors, stakeholders
Source: workflow W4008 — Conflict-Affected, Indigenous Peoples &amp; Land-Rights Risk Assessment</bpmn:documentation>
      <bpmn:laneSet id="W4008_LaneSet2">
        <bpmn:lane id="W4008_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W4008_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4008_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4008_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4008_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4008_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4008_Start3" name="Saliency (W4002); raw-material sourcing (timber, minerals, palm)">
        <bpmn:outgoing>W4008_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4008_Task4" name="Sustainability/Procurement assess land-rights, indigenous-peoples, and…">
        <bpmn:documentation>Step 1: Sustainability/Procurement assess land-rights, indigenous-peoples, and conflict-affected-area risk for raw-material sourcing (timber/lumber legality and deforestation links to VS-25.2, minerals from conflict-affected areas, palm/latex, quarrying for tiles/cement), using source intelligence and certification (FSC, PEFC for timber)
Responsible (R): Sustainability / Procurement / Insights
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4008_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4008_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4008_Task5" name="Sustainability/Procurement require evidence (legality, certification…">
        <bpmn:documentation>Step 2: Sustainability/Procurement require evidence (legality, certification, free-prior-informed-consent where relevant) and embed sourcing restrictions for high-risk origins; coordinate with anti-counterfeit/anti-illegal-logging concerns (links to VS-71) and sanctions (links to VS-86)
Responsible (R): Sustainability / Procurement / Legal
Accountable (A): VP Supply Chain
Duration: Per high-risk category</bpmn:documentation>
        <bpmn:incoming>W4008_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4008_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4008_Task6" name="Sustainability document findings, engage stakeholders (W4021), and report…">
        <bpmn:documentation>Step 3: Sustainability document findings, engage stakeholders (W4021), and report (W4020); refresh on change
Responsible (R): Sustainability
Accountable (A): Sustainability/ESG Manager
Duration: Annual + on change</bpmn:documentation>
        <bpmn:incoming>W4008_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4008_End7" name="Complete">
        <bpmn:incoming>W4008_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4008_Annotation8">
        <bpmn:text>Controls: - CTL-73 (ensure human-rights supply-chain due diligence.) | - operational: certification and legality evidence; operational: FPIC and restrictions
Owner: Sustainability/ESG Manager / VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4008_Assoc9" sourceRef="W4008_Annotation8" targetRef="W4008_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4008_Flow10" sourceRef="W4008_Start3" targetRef="W4008_Task4" />
      <bpmn:sequenceFlow id="W4008_Flow11" sourceRef="W4008_Task4" targetRef="W4008_Task5" />
      <bpmn:sequenceFlow id="W4008_Flow12" sourceRef="W4008_Task5" targetRef="W4008_Task6" />
      <bpmn:sequenceFlow id="W4008_Flow13" sourceRef="W4008_Task6" targetRef="W4008_End7" />
    </bpmn:process>
