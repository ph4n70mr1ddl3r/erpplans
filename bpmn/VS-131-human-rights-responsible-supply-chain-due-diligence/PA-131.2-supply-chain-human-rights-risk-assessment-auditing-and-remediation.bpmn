<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-131.2-supply-chain-human-rights-risk-assessment-auditing-and-remediation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4009" name="W4009. Supplier Human Rights Risk Assessment &amp; Tiering" isExecutable="false">
      <bpmn:documentation>Trigger: Onboarding; periodic; risk-model update (W4006)
Frequency: Per supplier + periodic refresh
Volume: ~800–1,000 vendors
Owner: VP Supply Chain / Sustainability/ESG Manager
Participants: Procurement (links to VS-03/VS-122), Sustainability, Global Sourcing (links to VS-122), Legal, third-party risk-data providers
Source: workflow W4009 — Supplier Human Rights Risk Assessment &amp; Tiering</bpmn:documentation>
      <bpmn:laneSet id="W4009_LaneSet2">
        <bpmn:lane id="W4009_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W4009_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4009_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4009_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4009_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4009_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4009_Start3" name="Onboarding; periodic; risk-model update (W4006)">
        <bpmn:outgoing>W4009_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4009_Task4" name="Procurement/Sustainability conduct the supplier human-rights risk assessment…">
        <bpmn:documentation>Step 1: Procurement/Sustainability conduct the supplier human-rights risk assessment using the model (W4006), geography/category risk, questionnaire (self-assessment), certifications, media/NGO/sanctions screening (links to VS-86), and prior-audit history
Responsible (R): Procurement / Sustainability
Accountable (A): VP Supply Chain
Duration: Per supplier</bpmn:documentation>
        <bpmn:incoming>W4009_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4009_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4009_Task5" name="Procurement/Sustainability tier each supplier (low / enhanced / high) and…">
        <bpmn:documentation>Step 2: Procurement/Sustainability tier each supplier (low / enhanced / high) and define the DD intensity: low = self-assessment + code; enhanced = audit/capability; high = enhanced audit + traceability + remediation tracking
Responsible (R): Procurement / Sustainability
Accountable (A): VP Supply Chain
Duration: Per supplier</bpmn:documentation>
        <bpmn:incoming>W4009_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4009_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4009_Task6" name="Procurement integrate tiering into vendor master (links to VS-29) and scorecard…">
        <bpmn:documentation>Step 3: Procurement integrate tiering into vendor master (links to VS-29) and scorecard (links to VS-67), trigger audits (W4010), and refresh on cycle or event
Responsible (R): Procurement / Sustainability
Accountable (A): VP Supply Chain
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4009_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4009_End7" name="Complete">
        <bpmn:incoming>W4009_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4009_Annotation8">
        <bpmn:text>Controls: - CTL-73 (ensure human-rights supply-chain due diligence.) | - operational: multi-input assessment and refresh; operational: audit of high-risk suppliers
Owner: VP Supply Chain / Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4009_Assoc9" sourceRef="W4009_Annotation8" targetRef="W4009_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4009_Flow10" sourceRef="W4009_Start3" targetRef="W4009_Task4" />
      <bpmn:sequenceFlow id="W4009_Flow11" sourceRef="W4009_Task4" targetRef="W4009_Task5" />
      <bpmn:sequenceFlow id="W4009_Flow12" sourceRef="W4009_Task5" targetRef="W4009_Task6" />
      <bpmn:sequenceFlow id="W4009_Flow13" sourceRef="W4009_Task6" targetRef="W4009_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4009_diag">
      <bpmndi:BPMNPlane id="W4009_plane" bpmnElement="W_W4009">
        <bpmndi:BPMNShape id="W4009_Lane1_di" bpmnElement="W4009_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_Task4_di" bpmnElement="W4009_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_Task5_di" bpmnElement="W4009_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_Task6_di" bpmnElement="W4009_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_Start3_di" bpmnElement="W4009_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_End7_di" bpmnElement="W4009_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4009_Annotation8_di" bpmnElement="W4009_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4009_Flow10_di" bpmnElement="W4009_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4009_Flow11_di" bpmnElement="W4009_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4009_Flow12_di" bpmnElement="W4009_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4009_Flow13_di" bpmnElement="W4009_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4009_Assoc9_di" bpmnElement="W4009_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4010" name="W4010. Social Compliance Audit, Verification &amp; Capability Building" isExecutable="false">
      <bpmn:documentation>Trigger: Enhanced/high-risk tier (W4009); audit cycle
Frequency: Per cycle (1–3 years by risk) + on trigger
Volume: High/enhanced-risk vendors
Owner: Sustainability/ESG Manager / VP Supply Chain
Participants: Sustainability, Procurement (links to VS-03/VS-122), accredited third-party social auditors (SMETA/SA8000/amfori BSCI), Global Sourcing (links to VS-122), Compliance
Source: workflow W4010 — Social Compliance Audit, Verification &amp; Capability Building</bpmn:documentation>
      <bpmn:laneSet id="W4010_LaneSet2">
        <bpmn:lane id="W4010_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W4010_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4010_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4010_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4010_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4010_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4010_Start3" name="Enhanced/high-risk tier (W4009); audit cycle">
        <bpmn:outgoing>W4010_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4010_Task4" name="Sustainability/Procurement plan and commission accredited third-party…">
        <bpmn:documentation>Step 1: Sustainability/Procurement plan and commission accredited third-party social-compliance audits for high/enhanced-risk vendors/factories (labor, health &amp; safety, environment, ethics, management systems), unannounced/semi-announced where warranted
Responsible (R): Sustainability / Procurement
Accountable (A): Sustainability/ESG Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4010_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4010_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4010_Task5" name="Sustainability review audit findings, verify accuracy (links to W4011 worker…">
        <bpmn:documentation>Step 2: Sustainability review audit findings, verify accuracy (links to W4011 worker voice), classify non-conformances (critical/major/minor), and issue corrective-action requirements (links to W4012)
Responsible (R): Sustainability / auditors
Accountable (A): Sustainability/ESG Manager
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W4010_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4010_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4010_Task6" name="Sustainability/Procurement build supplier capability (training, toolkits, peer…">
        <bpmn:documentation>Step 3: Sustainability/Procurement build supplier capability (training, toolkits, peer benchmarking), track closure (W4012), and integrate outcomes into the scorecard (links to VS-67) and sourcing decisions (W4014)
Responsible (R): Sustainability / Procurement
Accountable (A): Sustainability/ESG Manager / VP Supply Chain
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4010_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4010_End7" name="Complete">
        <bpmn:incoming>W4010_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4010_Annotation8">
        <bpmn:text>Controls: - CTL-624 (ensure controlled execution — Supply Chain Human Rights Risk Assessment, Auditing &amp; Remediation (PA-131.2).) | - operational: unannounced audits and worker voice; operational: capability building and closure tracking
Owner: Sustainability/ESG Manager / VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4010_Assoc9" sourceRef="W4010_Annotation8" targetRef="W4010_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4010_Flow10" sourceRef="W4010_Start3" targetRef="W4010_Task4" />
      <bpmn:sequenceFlow id="W4010_Flow11" sourceRef="W4010_Task4" targetRef="W4010_Task5" />
      <bpmn:sequenceFlow id="W4010_Flow12" sourceRef="W4010_Task5" targetRef="W4010_Task6" />
      <bpmn:sequenceFlow id="W4010_Flow13" sourceRef="W4010_Task6" targetRef="W4010_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4010_diag">
      <bpmndi:BPMNPlane id="W4010_plane" bpmnElement="W_W4010">
        <bpmndi:BPMNShape id="W4010_Lane1_di" bpmnElement="W4010_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_Task4_di" bpmnElement="W4010_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_Task5_di" bpmnElement="W4010_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_Task6_di" bpmnElement="W4010_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_Start3_di" bpmnElement="W4010_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_End7_di" bpmnElement="W4010_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4010_Annotation8_di" bpmnElement="W4010_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4010_Flow10_di" bpmnElement="W4010_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4010_Flow11_di" bpmnElement="W4010_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4010_Flow12_di" bpmnElement="W4010_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4010_Flow13_di" bpmnElement="W4010_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4010_Assoc9_di" bpmnElement="W4010_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4011" name="W4011. On-Site Assessment, Worker Voice &amp; Grievance Verification" isExecutable="false">
      <bpmn:documentation>Trigger: High-risk audit; worker-grievance signal; direct assessment need
Frequency: Per high-risk supplier + on signal
Volume: High-risk vendors/factories
Owner: Sustainability/ESG Manager
Participants: Sustainability, Procurement, external assessors, worker-voice technology providers, local stakeholders
Source: workflow W4011 — On-Site Assessment, Worker Voice &amp; Grievance Verification</bpmn:documentation>
      <bpmn:laneSet id="W4011_LaneSet2">
        <bpmn:lane id="W4011_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W4011_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4011_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4011_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4011_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4011_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4011_Start3" name="High-risk audit; worker-grievance signal; direct assessment need">
        <bpmn:outgoing>W4011_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4011_Task4" name="Sustainability/external-assessors conduct on-site assessment beyond paperwork…">
        <bpmn:documentation>Step 1: Sustainability/external-assessors conduct on-site assessment beyond paperwork: worker interviews (confidential, multiple shifts), document verification (payroll, age/ID, hours), and physical inspection (safety, dormitories where relevant)
Responsible (R): Sustainability / assessors
Accountable (A): Sustainability/ESG Manager
Duration: Per high-risk supplier</bpmn:documentation>
        <bpmn:incoming>W4011_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4011_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4011_Task5" name="Sustainability deploy/leverage worker-voice channels (anonymous surveys…">
        <bpmn:documentation>Step 2: Sustainability deploy/leverage worker-voice channels (anonymous surveys, hotlines, technology tools) to verify audit findings and surface hidden issues (forced-labor indicators, harassment, wage/hour violations)
Responsible (R): Sustainability / worker-voice provider
Accountable (A): Sustainability/ESG Manager
Duration: Per supplier + ongoing</bpmn:documentation>
        <bpmn:incoming>W4011_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4011_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4011_Task6" name="Sustainability cross-verify audit vs worker-voice vs documents, investigate…">
        <bpmn:documentation>Step 3: Sustainability cross-verify audit vs worker-voice vs documents, investigate discrepancies, and feed verified findings into corrective action (W4012) and grievance remediation (W4013)
Responsible (R): Sustainability
Accountable (A): Sustainability/ESG Manager
Duration: Per assessment</bpmn:documentation>
        <bpmn:incoming>W4011_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4011_End7" name="Complete">
        <bpmn:incoming>W4011_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4011_Annotation8">
        <bpmn:text>Controls: - CTL-624 (ensure controlled execution — Supply Chain Human Rights Risk Assessment, Auditing &amp; Remediation (PA-131.2).) | - operational: worker-voice interviews conducted on-site with confidentiality safeguards and retaliation monitoring via the grievance channel
Owner: Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4011_Assoc9" sourceRef="W4011_Annotation8" targetRef="W4011_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4011_Flow10" sourceRef="W4011_Start3" targetRef="W4011_Task4" />
      <bpmn:sequenceFlow id="W4011_Flow11" sourceRef="W4011_Task4" targetRef="W4011_Task5" />
      <bpmn:sequenceFlow id="W4011_Flow12" sourceRef="W4011_Task5" targetRef="W4011_Task6" />
      <bpmn:sequenceFlow id="W4011_Flow13" sourceRef="W4011_Task6" targetRef="W4011_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4011_diag">
      <bpmndi:BPMNPlane id="W4011_plane" bpmnElement="W_W4011">
        <bpmndi:BPMNShape id="W4011_Lane1_di" bpmnElement="W4011_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_Task4_di" bpmnElement="W4011_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_Task5_di" bpmnElement="W4011_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_Task6_di" bpmnElement="W4011_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_Start3_di" bpmnElement="W4011_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_End7_di" bpmnElement="W4011_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4011_Annotation8_di" bpmnElement="W4011_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4011_Flow10_di" bpmnElement="W4011_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4011_Flow11_di" bpmnElement="W4011_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4011_Flow12_di" bpmnElement="W4011_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4011_Flow13_di" bpmnElement="W4011_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4011_Assoc9_di" bpmnElement="W4011_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4012" name="W4012. Non-Conformance, Corrective Action &amp; Remediation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Audit/assessment finding; grievance (W4013)
Frequency: Per finding
Volume: Findings from audits/assessments
Owner: Sustainability/ESG Manager / VP Supply Chain
Participants: Sustainability, Procurement (links to VS-03/VS-67/VS-122), affected vendor, Compliance, Legal (links to VS-100), affected workers/community
Source: workflow W4012 — Non-Conformance, Corrective Action &amp; Remediation Management</bpmn:documentation>
      <bpmn:laneSet id="W4012_LaneSet2">
        <bpmn:lane id="W4012_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W4012_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4012_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4012_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4012_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4012_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4012_Start3" name="Audit/assessment finding; grievance (W4013)">
        <bpmn:outgoing>W4012_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4012_Task4" name="Sustainability issue corrective-action plans (CAPs) per finding with root…">
        <bpmn:documentation>Step 1: Sustainability issue corrective-action plans (CAPs) per finding with root cause, required remediation (e.g., back-pay, reimbursement of recruitment fees, safety fixes, age-verification systems), owner, and deadline; require supplier commitment
Responsible (R): Sustainability / Procurement
Accountable (A): Sustainability/ESG Manager
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4012_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4012_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4012_Task5" name="Sustainability/Procurement track CAP closure, verify remediation (re-payment…">
        <bpmn:documentation>Step 2: Sustainability/Procurement track CAP closure, verify remediation (re-payment evidence, re-inspection, worker confirmation), and address systemic causes (management systems); escalate critical/major findings
Responsible (R): Sustainability / Procurement
Accountable (A): Sustainability/ESG Manager / VP Supply Chain
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4012_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4012_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4012_Task6" name="Sustainability provide/leverage remedy for affected workers/community, document…">
        <bpmn:documentation>Step 3: Sustainability provide/leverage remedy for affected workers/community, document remediation outcomes, and feed into sourcing decisions (W4014), reporting (W4020), and continuous improvement (W4019)
Responsible (R): Sustainability / Procurement / Legal
Accountable (A): Sustainability/ESG Manager
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4012_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4012_End7" name="Complete">
