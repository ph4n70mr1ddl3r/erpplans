    <bpmn:process id="W_W4016" name="W4016. Living Wage, Working Hours &amp; Wage-Data Assurance Program" isExecutable="false">
      <bpmn:documentation>Trigger: Saliency (W4002); living-wage commitment; wage/hour finding
Frequency: Annual + on finding
Volume: High-risk suppliers/geographies
Owner: Sustainability/ESG Manager / VP Supply Chain
Participants: Sustainability, Procurement (links to VS-03/VS-122), Insights, external wage-benchmark providers, HR (links to VS-102 for own-ops parity)
Source: workflow W4016 — Living Wage, Working Hours &amp; Wage-Data Assurance Program</bpmn:documentation>
      <bpmn:laneSet id="W4016_LaneSet3">
        <bpmn:lane id="W4016_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W4016_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4016_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4016_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4016_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4016_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4016_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4016_Start4" name="Saliency (W4002); living-wage commitment; wage/hour finding">
        <bpmn:outgoing>W4016_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4016_Task5" name="Sustainability/Procurement assess living-wage gaps and working-hours compliance…">
        <bpmn:documentation>Step 1: Sustainability/Procurement assess living-wage gaps and working-hours compliance in high-risk supplier geographies using living-wage benchmarks (vs legal minimum) and hour/wage data, and identify categories/geographies of concern
Responsible (R): Sustainability / Insights / Procurement
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4016_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4016_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4016_Task6" name="Procurement/Sustainability work with suppliers on closing living-wage gaps…">
        <bpmn:documentation>Step 2: Procurement/Sustainability work with suppliers on closing living-wage gaps (wage ladders, pricing that supports legal/living wage) and hours compliance (no excessive overtime, voluntary overtime), verified via audit (W4010) and wage-data assurance
Responsible (R): Procurement / Sustainability
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W4016_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4016_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4016_Task7" name="Sustainability report progress (links to W4020), engage stakeholders (W4021)…">
        <bpmn:documentation>Step 3: Sustainability report progress (links to W4020), engage stakeholders (W4021), and align with BuildRight&#x27;s own compensation philosophy (links to VS-102) and worker-voice (W4013)
Responsible (R): Sustainability / Procurement
Accountable (A): Sustainability/ESG Manager
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W4016_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4016_End8" name="Complete">
        <bpmn:incoming>W4016_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4016_Annotation9">
        <bpmn:text>Controls: - CTL-624 (ensure controlled execution — Supply Chain Human Rights Risk Assessment, Auditing &amp; Remediation (PA-131.2).) | - operational: living-wage benchmarking; operational: hour-data assurance and audit
Owner: Sustainability/ESG Manager / VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4016_Assoc10" sourceRef="W4016_Annotation9" targetRef="W4016_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4016_Flow11" sourceRef="W4016_Start4" targetRef="W4016_Task5" />
      <bpmn:sequenceFlow id="W4016_Flow12" sourceRef="W4016_Task5" targetRef="W4016_Task6" />
      <bpmn:sequenceFlow id="W4016_Flow13" sourceRef="W4016_Task6" targetRef="W4016_Task7" />
      <bpmn:sequenceFlow id="W4016_Flow14" sourceRef="W4016_Task7" targetRef="W4016_End8" />
    </bpmn:process>
