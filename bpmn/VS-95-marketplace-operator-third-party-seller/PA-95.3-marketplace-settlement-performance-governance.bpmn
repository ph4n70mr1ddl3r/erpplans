        <bpmndi:BPMNEdge id="W3154_Flow13_di" bpmnElement="W3154_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3154_Flow14_di" bpmnElement="W3154_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3154_Flow15_di" bpmnElement="W3154_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3154_Assoc11_di" bpmnElement="W3154_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3155" name="W3155. Seller Quality, Complaint &amp; Dispute Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Customer complaint about 3P order; seller-buyer dispute
Frequency: Continuous
Volume: Subset of marketplace orders
Owner: Marketplace Manager
Participants: Marketplace Mgr, CS (links to VS-13), Seller, Quality, Finance
Source: workflow W3155 — Seller Quality, Complaint &amp; Dispute Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3155_LaneSet4">
        <bpmn:lane id="W3155_Lane1" name="CS">
        <bpmn:flowNodeRef>W3155_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3155_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3155_Lane2" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3155_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3155_Lane3" name="Finance">
        <bpmn:flowNodeRef>W3155_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3155_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3155_Start5" name="Customer complaint about 3P order; seller-buyer dispute">
        <bpmn:outgoing>W3155_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3155_Task6" name="CS (links to VS-13) capture complaint: not-as-described, defective, counterfeit…">
        <bpmn:documentation>Step 1: CS (links to VS-13) capture complaint: not-as-described, defective, counterfeit (escalate W3156), wrong item, late delivery; route to seller with SLA for response
Responsible (R): CS / Seller
Accountable (A): Marketplace Manager
Duration: Per complaint (&lt;24 hr response)</bpmn:documentation>
        <bpmn:incoming>W3155_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3155_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3155_Task7" name="Marketplace Mgr mediate dispute between buyer and seller; evaluate evidence…">
        <bpmn:documentation>Step 2: Marketplace Mgr mediate dispute between buyer and seller; evaluate evidence (photos, listing, comms); decide remedy (refund, replacement, partial credit, deny); document decision
Responsible (R): Marketplace Mgr / CS
Accountable (A): GM, Digital Commerce Inc.
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3155_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3155_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3155_Task8" name="Finance execute remedy (refund — links to VS-80, settlement debit — W3153)…">
        <bpmn:documentation>Step 3: Finance execute remedy (refund — links to VS-80, settlement debit — W3153); track complaint themes and per-seller dispute rate to scorecard (W3154); drive systemic fixes
Responsible (R): Finance / Marketplace Mgr
Accountable (A): Finance Manager
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3155_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3155_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3155_End9" name="Complete">
        <bpmn:incoming>W3155_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3155_Annotation10">
        <bpmn:text>Controls: - CTL-516 (ensure controlled execution — Marketplace Settlement, Seller Performance &amp; Governance (PA-95.3).) | - operational: documented dispute policy and transparent evidence-based decisions
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3155_Assoc11" sourceRef="W3155_Annotation10" targetRef="W3155_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3155_Flow12" sourceRef="W3155_Start5" targetRef="W3155_Task6" />
      <bpmn:sequenceFlow id="W3155_Flow13" sourceRef="W3155_Task6" targetRef="W3155_Task7" />
      <bpmn:sequenceFlow id="W3155_Flow14" sourceRef="W3155_Task7" targetRef="W3155_Task8" />
      <bpmn:sequenceFlow id="W3155_Flow15" sourceRef="W3155_Task8" targetRef="W3155_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3155_diag">
      <bpmndi:BPMNPlane id="W3155_plane" bpmnElement="W_W3155">
        <bpmndi:BPMNShape id="W3155_Lane1_di" bpmnElement="W3155_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Lane2_di" bpmnElement="W3155_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Lane3_di" bpmnElement="W3155_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Task6_di" bpmnElement="W3155_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Task7_di" bpmnElement="W3155_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Task8_di" bpmnElement="W3155_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Start5_di" bpmnElement="W3155_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_End9_di" bpmnElement="W3155_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3155_Annotation10_di" bpmnElement="W3155_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3155_Flow12_di" bpmnElement="W3155_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3155_Flow13_di" bpmnElement="W3155_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3155_Flow14_di" bpmnElement="W3155_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3155_Flow15_di" bpmnElement="W3155_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3155_Assoc11_di" bpmnElement="W3155_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3156" name="W3156. Seller Fraud, Counterfeit &amp; Policy Violation Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Brand-owner complaint (links to VS-71); customer counterfeit report; automated detection
Frequency: Event-driven
Volume: Subset of sellers
Owner: Marketplace Manager
Participants: Marketplace Mgr, Brand Protection (links to VS-71), Legal, LP (links to VS-23), Seller Operations
Source: workflow W3156 — Seller Fraud, Counterfeit &amp; Policy Violation Handling</bpmn:documentation>
      <bpmn:laneSet id="W3156_LaneSet3">
        <bpmn:lane id="W3156_Lane1" name="Brand Protection">
        <bpmn:flowNodeRef>W3156_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3156_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3156_Lane2" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3156_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3156_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3156_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3156_Start4" name="Brand-owner complaint (links to VS-71); customer counterfeit report; automated detection">
        <bpmn:outgoing>W3156_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3156_Task5" name="Brand Protection/LP detect violation: counterfeit (links to VS-71)…">
        <bpmn:documentation>Step 1: Brand Protection/LP detect violation: counterfeit (links to VS-71), unauthorized seller, IP infringement, prohibited items (hazmat — links to VS-24, recalled — links to VS-89), review manipulation, payment fraud (links to W3147)
Responsible (R): Brand Protection / LP
Accountable (A): Marketplace Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3156_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3156_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3156_Task6" name="Marketplace Mgr/Legal investigate: evidence (test buy, document review), seller…">
        <bpmn:documentation>Step 2: Marketplace Mgr/Legal investigate: evidence (test buy, document review), seller response opportunity, decide action (listing removal, account restriction, suspension, termination — W3144, legal referral)
Responsible (R): Marketplace Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3156_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3156_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3156_Task7" name="Execute action: remove listings, withhold payout (links to W3153), refund…">
        <bpmn:documentation>Step 3: Execute action: remove listings, withhold payout (links to W3153), refund affected buyers (links to VS-80), report to authorities (DTI/NPC/IP owner) where required, retain records (links to VS-88); feed into seller scoring (W3154)
Responsible (R): Marketplace Mgr / Finance / Legal
Accountable (A): Marketplace Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3156_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3156_Flow14</bpmn:outgoing>
      </bpmn:userTask>
