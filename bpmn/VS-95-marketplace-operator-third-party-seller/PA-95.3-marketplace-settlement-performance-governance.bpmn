    <bpmn:process id="W_W3159" name="W3159. Marketplace Data Privacy, Seller Data Governance &amp; DPA Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Marketplace launch; DPA obligations; privacy incident
Frequency: Continuous + annual
Volume: All marketplace participants
Owner: Data Protection Officer (DPO)
Participants: DPO, Marketplace Mgr, Legal, IT Security (links to VS-27), Seller
Source: workflow W3159 — Marketplace Data Privacy, Seller Data Governance &amp; DPA Compliance</bpmn:documentation>
      <bpmn:laneSet id="W3159_LaneSet2">
        <bpmn:lane id="W3159_Lane1" name="DPO">
        <bpmn:flowNodeRef>W3159_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3159_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3159_Task6</bpmn:flowNodeRef>
