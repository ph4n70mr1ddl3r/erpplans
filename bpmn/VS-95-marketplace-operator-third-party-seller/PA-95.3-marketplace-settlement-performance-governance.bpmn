    <bpmn:process id="W_W3160" name="W3160. Marketplace P&amp;L, Take-Rate &amp; Growth Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly P&amp;L cycle; strategy review
Frequency: Monthly + quarterly
Volume: Marketplace-wide
Owner: Marketplace Director
Participants: Marketplace Director, Finance, BI (links to VS-28), Ecommerce (links to VS-10), Category (links to VS-01)
Source: workflow W3160 — Marketplace P&amp;L, Take-Rate &amp; Growth Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3160_LaneSet4">
        <bpmn:lane id="W3160_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W3160_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3160_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3160_Lane2" name="Marketplace Director">
        <bpmn:flowNodeRef>W3160_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3160_Lane3" name="GM, Digital Commerce Inc.">
        <bpmn:flowNodeRef>W3160_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3160_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3160_Start5" name="Monthly/quarterly P&amp;L cycle; strategy review">
        <bpmn:outgoing>W3160_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3160_Task6" name="BI/Finance (links to VS-28) compute marketplace P&amp;L: GMV, take-rate…">
        <bpmn:documentation>Step 1: BI/Finance (links to VS-28) compute marketplace P&amp;L: GMV, take-rate (commission+fees ÷ GMV), net revenue, returns/chargebacks, ops cost (CS, fraud, payouts), technology amortization, buyer-protection reserve, contribution margin
Responsible (R): BI Analyst / Finance
Accountable (A): Marketplace Director
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3160_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3160_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3160_Task7" name="Marketplace Director analyze growth: GMV trend, seller count/active, SKUs…">
        <bpmn:documentation>Step 2: Marketplace Director analyze growth: GMV trend, seller count/active, SKUs, category mix, buyer conversion, basket size, repeat-purchase, share of ecommerce (vs. 1P); benchmark vs. external marketplaces (links to VS-65)
Responsible (R): Marketplace Director / BI
Accountable (A): GM, Digital Commerce Inc.
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3160_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3160_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3160_Task8" name="Steering committee reviews P&amp;L and growth; reallocates investment (seller…">
        <bpmn:documentation>Step 3: Steering committee reviews P&amp;L and growth; reallocates investment (seller acquisition, technology, retail-media — links to VS-48), adjusts commission (W3141), refines strategy (W3137); report to Board (links to VS-36)
Responsible (R): GM, Digital Commerce Inc. / CFO
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3160_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3160_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3160_End9" name="Complete">
        <bpmn:incoming>W3160_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3160_Annotation10">
        <bpmn:text>Controls: - CTL-516 (ensure controlled execution — Marketplace Settlement, Seller Performance &amp; Governance (PA-95.3).) | - operational: milestone-gated investment and clear take-rate target
Owner: Marketplace Director</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3160_Assoc11" sourceRef="W3160_Annotation10" targetRef="W3160_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3160_Flow12" sourceRef="W3160_Start5" targetRef="W3160_Task6" />
      <bpmn:sequenceFlow id="W3160_Flow13" sourceRef="W3160_Task6" targetRef="W3160_Task7" />
      <bpmn:sequenceFlow id="W3160_Flow14" sourceRef="W3160_Task7" targetRef="W3160_Task8" />
      <bpmn:sequenceFlow id="W3160_Flow15" sourceRef="W3160_Task8" targetRef="W3160_End9" />
    </bpmn:process>
