<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-95.3-marketplace-settlement-performance-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3153" name="W3153. Marketplace Commission, Fee Deduction &amp; Seller Payout" isExecutable="false">
      <bpmn:documentation>Trigger: Payout cycle (e.g., bi-weekly/monthly); order completion
Frequency: Per payout cycle
Volume: All sellers with completed orders
Owner: Marketplace Manager
Participants: Marketplace Mgr, Finance, AP/Treasury (links to VS-15/VS-18), Seller
Source: workflow W3153 — Marketplace Commission, Fee Deduction &amp; Seller Payout</bpmn:documentation>
      <bpmn:laneSet id="W3153_LaneSet3">
        <bpmn:lane id="W3153_Lane1" name="System">
        <bpmn:flowNodeRef>W3153_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3153_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3153_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3153_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3153_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3153_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3153_Start4" name="Payout cycle (e.g., bi-weekly/monthly); order completion">
        <bpmn:outgoing>W3153_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3153_Task5" name="System computes per-seller settlement: gross GMV (links to VS-10) − commission…">
        <bpmn:documentation>Step 1: System computes per-seller settlement: gross GMV (links to VS-10) − commission % (W3141) − fees (listing, fulfillment, advertising — W3141/W3152) − returns/refunds (W3151) − withholding tax (W3157) − holdback reserve; produce seller statement
Responsible (R): System / Finance
Accountable (A): Finance Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3153_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3153_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3153_Task6" name="Finance/AP (links to VS-15) review settlement; reconcile to order/returns…">
        <bpmn:documentation>Step 2: Finance/AP (links to VS-15) review settlement; reconcile to order/returns records; resolve disputes; Treasury (links to VS-18) disburse net payout to seller&#x27;s verified bank account
Responsible (R): Finance Analyst / Treasury
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3153_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3153_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3153_Task7" name="System posts settlement entries: marketplace revenue (commission/fees), VAT…">
        <bpmn:documentation>Step 3: System posts settlement entries: marketplace revenue (commission/fees), VAT output (W3157), AP to seller, withholdings remitted to BIR (links to VS-79); archive statement per records (links to VS-88)
Responsible (R): System / Finance
Accountable (A): Finance Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3153_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3153_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W3153_End8" name="Complete">
        <bpmn:incoming>W3153_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3153_Annotation9">
        <bpmn:text>Controls: - CTL-516 (ensure controlled execution — Marketplace Settlement, Seller Performance &amp; Governance (PA-95.3).) | - operational: automated reconciliation and dispute window
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3153_Assoc10" sourceRef="W3153_Annotation9" targetRef="W3153_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3153_Flow11" sourceRef="W3153_Start4" targetRef="W3153_Task5" />
      <bpmn:sequenceFlow id="W3153_Flow12" sourceRef="W3153_Task5" targetRef="W3153_Task6" />
      <bpmn:sequenceFlow id="W3153_Flow13" sourceRef="W3153_Task6" targetRef="W3153_Task7" />
      <bpmn:sequenceFlow id="W3153_Flow14" sourceRef="W3153_Task7" targetRef="W3153_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3153_diag">
      <bpmndi:BPMNPlane id="W3153_plane" bpmnElement="W_W3153">
        <bpmndi:BPMNShape id="W3153_Lane1_di" bpmnElement="W3153_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Lane2_di" bpmnElement="W3153_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Task5_di" bpmnElement="W3153_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Task6_di" bpmnElement="W3153_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Task7_di" bpmnElement="W3153_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Start4_di" bpmnElement="W3153_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_End8_di" bpmnElement="W3153_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3153_Annotation9_di" bpmnElement="W3153_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
