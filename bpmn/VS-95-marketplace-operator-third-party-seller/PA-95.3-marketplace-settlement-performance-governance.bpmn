      <bpmn:startEvent id="W3157_Start4" name="Order transaction; payout cycle; BIR filing">
        <bpmn:outgoing>W3157_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3157_Task5" name="Tax Mgr structure marketplace taxation: distinguish…">
        <bpmn:documentation>Step 1: Tax Mgr structure marketplace taxation: distinguish BuildRight-as-marketplace-operator revenue (commission/fees — VATable) from seller revenue (sale of goods — VAT/percentage tax per seller&#x27;s BIR status); apply withholding obligations per CREATE/train law and BIR marketplace rules
Responsible (R): Tax Manager
Accountable (A): Tax Manager
Duration: Setup + ongoing</bpmn:documentation>
        <bpmn:incoming>W3157_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3157_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3157_Task6" name="System compute per-transaction: VAT on BuildRight commission; pass-through of…">
        <bpmn:documentation>Step 2: System compute per-transaction: VAT on BuildRight commission; pass-through of seller VAT/percentage tax to buyer where applicable; creditable withholding tax (EWT/CWT) on seller payout per BIR rules; generate BIR-compliant invoices (links to VS-79)
Responsible (R): System / Finance
Accountable (A): Tax Manager
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W3157_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3157_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3157_Task7" name="Tax Mgr remit BuildRight VAT/EWT (links to VS-79); issue Form 2307 to sellers…">
        <bpmn:documentation>Step 3: Tax Mgr remit BuildRight VAT/EWT (links to VS-79); issue Form 2307 to sellers for withheld tax; sellers remit own output VAT/income tax; facilitate BIR audit response (links to VS-21)
Responsible (R): Tax Manager / Finance
Accountable (A): Tax Manager
Duration: Monthly/quarterly</bpmn:documentation>
        <bpmn:incoming>W3157_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3157_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3157_End8" name="Complete">
        <bpmn:incoming>W3157_Flow14</bpmn:incoming>
      </bpmn:endEvent>
