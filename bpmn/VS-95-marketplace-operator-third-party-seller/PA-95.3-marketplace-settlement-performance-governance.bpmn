        <bpmndi:BPMNEdge id="W3153_Flow12_di" bpmnElement="W3153_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3153_Flow13_di" bpmnElement="W3153_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3153_Flow14_di" bpmnElement="W3153_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3153_Assoc10_di" bpmnElement="W3153_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3154" name="W3154. Seller Performance Scorecard &amp; Tier Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily/weekly/monthly scorecard cycle; tier review
Frequency: Daily KPI + monthly tier review
Volume: All active sellers
Owner: Marketplace Manager
Participants: Marketplace Mgr, Seller Operations, BI (links to VS-28), Finance
Source: workflow W3154 — Seller Performance Scorecard &amp; Tier Management</bpmn:documentation>
      <bpmn:laneSet id="W3154_LaneSet4">
        <bpmn:lane id="W3154_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W3154_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3154_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3154_Lane2" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3154_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3154_Lane3" name="Seller Operations">
        <bpmn:flowNodeRef>W3154_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3154_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3154_Start5" name="Daily/weekly/monthly scorecard cycle; tier review">
        <bpmn:outgoing>W3154_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3154_Task6" name="BI (links to VS-28) compute per-seller KPIs: order defect rate, cancellation…">
        <bpmn:documentation>Step 1: BI (links to VS-28) compute per-seller KPIs: order defect rate, cancellation rate, late-ship rate, valid tracking rate, return rate, customer-satisfaction (CSAT/NPS), dispute rate, listing-quality; benchmark vs. peers
Responsible (R): BI Analyst
Accountable (A): Marketplace Manager
Duration: Daily/weekly</bpmn:documentation>
        <bpmn:incoming>W3154_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3154_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3154_Task7" name="Marketplace Mgr assign performance tier (Excellent / Good / Warning / At-Risk /…">
        <bpmn:documentation>Step 2: Marketplace Mgr assign performance tier (Excellent / Good / Warning / At-Risk / Suspended) per thresholds; trigger benefits (W3143) or remediation/penalty path; communicate to seller
Responsible (R): Marketplace Mgr
Accountable (A): GM, Digital Commerce Inc.
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3154_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3154_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3154_Task8" name="For At-Risk/Suspended: Seller Operations implement Performance Improvement…">
        <bpmn:documentation>Step 3: For At-Risk/Suspended: Seller Operations implement Performance Improvement Plan, restrict catalog/buy-box, hold payout reserve; escalate to offboarding (W3144) if uncorrected
Responsible (R): Seller Operations
Accountable (A): Marketplace Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3154_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3154_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3154_End9" name="Complete">
        <bpmn:incoming>W3154_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3154_Annotation10">
        <bpmn:text>Controls: - CTL-516 (ensure controlled execution — Marketplace Settlement, Seller Performance &amp; Governance (PA-95.3).) | - operational: verified-purchase reviews and audit
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3154_Assoc11" sourceRef="W3154_Annotation10" targetRef="W3154_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3154_Flow12" sourceRef="W3154_Start5" targetRef="W3154_Task6" />
      <bpmn:sequenceFlow id="W3154_Flow13" sourceRef="W3154_Task6" targetRef="W3154_Task7" />
      <bpmn:sequenceFlow id="W3154_Flow14" sourceRef="W3154_Task7" targetRef="W3154_Task8" />
      <bpmn:sequenceFlow id="W3154_Flow15" sourceRef="W3154_Task8" targetRef="W3154_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3154_diag">
      <bpmndi:BPMNPlane id="W3154_plane" bpmnElement="W_W3154">
        <bpmndi:BPMNShape id="W3154_Lane1_di" bpmnElement="W3154_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3154_Lane2_di" bpmnElement="W3154_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3154_Lane3_di" bpmnElement="W3154_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
