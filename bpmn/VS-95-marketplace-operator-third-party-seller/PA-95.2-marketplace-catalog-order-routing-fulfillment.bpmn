      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3146" name="W3146. First-Party vs Third-Party Offer Comparison &amp; Buy-Box" isExecutable="false">
      <bpmn:documentation>Trigger: Offer change; buy-box recompute
Frequency: Continuous (real-time)
Volume: All multi-offer SKUs
Owner: Marketplace Manager
Participants: Marketplace Mgr, Ecommerce (links to VS-10), Category (links to VS-01), Finance
Source: workflow W3146 — First-Party vs Third-Party Offer Comparison &amp; Buy-Box</bpmn:documentation>
      <bpmn:laneSet id="W3146_LaneSet4">
        <bpmn:lane id="W3146_Lane1" name="System">
        <bpmn:flowNodeRef>W3146_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3146_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3146_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W3146_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3146_Lane3" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3146_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3146_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3146_Start5" name="Offer change; buy-box recompute">
        <bpmn:outgoing>W3146_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3146_Task6" name="System computes buy-box winner per multi-offer SKU using weighted algorithm…">
        <bpmn:documentation>Step 1: System computes buy-box winner per multi-offer SKU using weighted algorithm: total price (item + shipping + tax), seller performance (W3154), fulfillment speed, in-stock, returns policy; surfaces &quot;Other Sellers&quot; panel for runners-up
Responsible (R): System
Accountable (A): Marketplace Manager
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W3146_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3146_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3146_Task7" name="Category (links to VS-01) sets 1P/3P rules: categories where 1P wins by policy…">
        <bpmn:documentation>Step 2: Category (links to VS-01) sets 1P/3P rules: categories where 1P wins by policy (private label — links to VS-41, controlled brands), categories open to 3P, and categories where 3P complements 1P (vendor direct-ship for out-of-stock)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W3146_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3146_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3146_Task8" name="Marketplace Mgr monitor buy-box distribution: 1P share vs. 3P share, seller…">
        <bpmn:documentation>Step 3: Marketplace Mgr monitor buy-box distribution: 1P share vs. 3P share, seller diversity, price competitiveness; flag anomalies (price war, seller dominance) and adjust rules
Responsible (R): Marketplace Mgr / BI
Accountable (A): Marketplace Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3146_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3146_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3146_End9" name="Complete">
        <bpmn:incoming>W3146_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3146_Annotation10">
        <bpmn:text>Controls: - CTL-515 (ensure controlled execution — Marketplace Catalog, Order Routing &amp; Seller Fulfillment (PA-95.2).) | - operational: transparent, performance-based algorithm and documented rules
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3146_Assoc11" sourceRef="W3146_Annotation10" targetRef="W3146_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3146_Flow12" sourceRef="W3146_Start5" targetRef="W3146_Task6" />
      <bpmn:sequenceFlow id="W3146_Flow13" sourceRef="W3146_Task6" targetRef="W3146_Task7" />
      <bpmn:sequenceFlow id="W3146_Flow14" sourceRef="W3146_Task7" targetRef="W3146_Task8" />
      <bpmn:sequenceFlow id="W3146_Flow15" sourceRef="W3146_Task8" targetRef="W3146_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3146_diag">
      <bpmndi:BPMNPlane id="W3146_plane" bpmnElement="W_W3146">
        <bpmndi:BPMNShape id="W3146_Lane1_di" bpmnElement="W3146_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Lane2_di" bpmnElement="W3146_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Lane3_di" bpmnElement="W3146_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Task6_di" bpmnElement="W3146_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Task7_di" bpmnElement="W3146_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Task8_di" bpmnElement="W3146_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Start5_di" bpmnElement="W3146_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_End9_di" bpmnElement="W3146_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3146_Annotation10_di" bpmnElement="W3146_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3146_Flow12_di" bpmnElement="W3146_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3146_Flow13_di" bpmnElement="W3146_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3146_Flow14_di" bpmnElement="W3146_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3146_Flow15_di" bpmnElement="W3146_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3146_Assoc11_di" bpmnElement="W3146_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3147" name="W3147. Marketplace Order Capture, Fraud Screening &amp; Routing" isExecutable="false">
      <bpmn:documentation>Trigger: Customer places marketplace order
Frequency: Continuous
Volume: Per marketplace order
Owner: Marketplace Manager
Participants: Marketplace Mgr, Ecommerce (links to VS-10), Fraud/LP (links to VS-23), Seller Operations
Source: workflow W3147 — Marketplace Order Capture, Fraud Screening &amp; Routing</bpmn:documentation>
      <bpmn:laneSet id="W3147_LaneSet4">
        <bpmn:lane id="W3147_Lane1" name="Ecommerce">
        <bpmn:flowNodeRef>W3147_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3147_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3147_Lane2" name="Fraud Analyst">
        <bpmn:flowNodeRef>W3147_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3147_Lane3" name="System">
        <bpmn:flowNodeRef>W3147_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3147_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3147_Start5" name="Customer places marketplace order">
        <bpmn:outgoing>W3147_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W3147_Task6" name="Ecommerce (links to VS-10) captures order; for multi-seller basket (W3149)…">
        <bpmn:documentation>Step 1: Ecommerce (links to VS-10) captures order; for multi-seller basket (W3149) splits into per-seller sub-orders; reserves seller inventory (W3150); computes total price incl. shipping, tax, fees
Responsible (R): Ecommerce / System
Accountable (A): Marketplace Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3147_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3147_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W3147_Task7" name="Fraud/LP (links to VS-23) screen order: payment fraud, fake/compromised…">
        <bpmn:documentation>Step 2: Fraud/LP (links to VS-23) screen order: payment fraud, fake/compromised account, first-party fraud, promo abuse (links to W3152); velocity rules, device fingerprint, address risk; hold/cancel/review suspicious orders
Responsible (R): Fraud Analyst / System
Accountable (A): Marketplace Manager
Duration: Per order (real-time)</bpmn:documentation>
        <bpmn:incoming>W3147_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3147_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W3147_Task8" name="Marketplace routes sub-order to seller (or to BuildRight fulfillment —…">
        <bpmn:documentation>Step 3: Marketplace routes sub-order to seller (or to BuildRight fulfillment — Fulfilled-by-BuildRight — links to VS-93) with fulfillment SLA, shipping label, customer address; seller acknowledges and begins fulfillment (W3148)
Responsible (R): System / Seller
Accountable (A): Marketplace Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3147_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3147_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W3147_End9" name="Complete">
        <bpmn:incoming>W3147_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3147_Annotation10">
        <bpmn:text>Controls: - CTL-86 (ensure marketplace seller &amp; tax compliance.) | - operational: multi-signal fraud screening and seller vetting (W3138)
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3147_Assoc11" sourceRef="W3147_Annotation10" targetRef="W3147_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3147_Flow12" sourceRef="W3147_Start5" targetRef="W3147_Task6" />
      <bpmn:sequenceFlow id="W3147_Flow13" sourceRef="W3147_Task6" targetRef="W3147_Task7" />
      <bpmn:sequenceFlow id="W3147_Flow14" sourceRef="W3147_Task7" targetRef="W3147_Task8" />
      <bpmn:sequenceFlow id="W3147_Flow15" sourceRef="W3147_Task8" targetRef="W3147_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3147_diag">
      <bpmndi:BPMNPlane id="W3147_plane" bpmnElement="W_W3147">
        <bpmndi:BPMNShape id="W3147_Lane1_di" bpmnElement="W3147_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Lane2_di" bpmnElement="W3147_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Lane3_di" bpmnElement="W3147_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Task6_di" bpmnElement="W3147_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Task7_di" bpmnElement="W3147_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Task8_di" bpmnElement="W3147_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Start5_di" bpmnElement="W3147_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_End9_di" bpmnElement="W3147_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3147_Annotation10_di" bpmnElement="W3147_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3147_Flow12_di" bpmnElement="W3147_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3147_Flow13_di" bpmnElement="W3147_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3147_Flow14_di" bpmnElement="W3147_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3147_Flow15_di" bpmnElement="W3147_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3147_Assoc11_di" bpmnElement="W3147_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3148" name="W3148. Seller Fulfillment SLA, Shipment Tracking &amp; POD" isExecutable="false">
      <bpmn:documentation>Trigger: Seller accepts sub-order
Frequency: Per order
Volume: Per marketplace order
Owner: Marketplace Manager
Participants: Marketplace Mgr, Seller, Carrier/3PL (links to VS-56), CS (links to VS-13)
Source: workflow W3148 — Seller Fulfillment SLA, Shipment Tracking &amp; POD</bpmn:documentation>
      <bpmn:laneSet id="W3148_LaneSet4">
        <bpmn:lane id="W3148_Lane1" name="Seller">
        <bpmn:flowNodeRef>W3148_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3148_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3148_Lane2" name="System">
        <bpmn:flowNodeRef>W3148_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3148_Lane3" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3148_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3148_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3148_Start5" name="Seller accepts sub-order">
        <bpmn:outgoing>W3148_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3148_Task6" name="Seller fulfills per SLA (e.g., ship within 24–48 hr); for BuildRight-fulfilled…">
        <bpmn:documentation>Step 1: Seller fulfills per SLA (e.g., ship within 24–48 hr); for BuildRight-fulfilled (links to VS-93), follow dark-store/DC dispatch SLA; generate carrier label, manifest, hand-off to carrier
Responsible (R): Seller / Carrier
Accountable (A): Marketplace Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3148_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3148_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3148_Task7" name="System captures tracking events (carrier API — links to VS-56); push to…">
        <bpmn:documentation>Step 2: System captures tracking events (carrier API — links to VS-56); push to customer (links to VS-10/VS-13); on delivery, capture POD/e-signature; auto-close order on confirmed delivery
Responsible (R): System / Carrier
Accountable (A): Marketplace Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3148_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3148_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3148_Task8" name="Marketplace Mgr monitor SLA adherence (ship-on-time %, delivery-on-time %…">
        <bpmn:documentation>Step 3: Marketplace Mgr monitor SLA adherence (ship-on-time %, delivery-on-time %, cancellation rate, late-ship rate); under-performers flagged in seller scorecard (W3154) and remediation/penalty path
Responsible (R): Marketplace Mgr / Seller Ops
Accountable (A): Marketplace Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3148_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3148_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3148_End9" name="Complete">
        <bpmn:incoming>W3148_Flow15</bpmn:incoming>
      </bpmn:endEvent>
