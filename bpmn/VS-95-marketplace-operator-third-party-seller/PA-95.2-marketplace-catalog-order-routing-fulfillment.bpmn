        <bpmndi:BPMNShape id="W3145_Task7_di" bpmnElement="W3145_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3145_Task8_di" bpmnElement="W3145_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
