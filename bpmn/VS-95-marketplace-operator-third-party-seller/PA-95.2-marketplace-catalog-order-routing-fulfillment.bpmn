    <bpmn:process id="W_W3152" name="W3152. Seller-Initiated Promotions, Coupons &amp; Co-Funded Campaigns" isExecutable="false">
      <bpmn:documentation>Trigger: Seller promotion request; marketplace campaign cycle
Frequency: Per promotion + campaign cycle
Volume: ~50–500 active seller promotions
Owner: Marketplace Manager
Participants: Marketplace Mgr, Marketing (links to VS-14), Retail Media (links to VS-48), Finance, Seller
Source: workflow W3152 — Seller-Initiated Promotions, Coupons &amp; Co-Funded Campaigns</bpmn:documentation>
      <bpmn:laneSet id="W3152_LaneSet4">
        <bpmn:lane id="W3152_Lane1" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3152_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3152_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3152_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W3152_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3152_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3152_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3152_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3152_Start5" name="Seller promotion request; marketplace campaign cycle">
        <bpmn:outgoing>W3152_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3152_Task6" name="Seller proposes promotion (discount %, coupon, bundle, free shipping, flash…">
        <bpmn:documentation>Step 1: Seller proposes promotion (discount %, coupon, bundle, free shipping, flash sale); Marketplace Mgr reviews for compliance (MAP/price-floor — links to VS-01, competition law, anti-dumping) and approve/decline
Responsible (R): Marketplace Mgr / Seller
Accountable (A): Marketplace Manager
Duration: Per promotion</bpmn:documentation>
        <bpmn:incoming>W3152_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3152_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3152_Task7" name="For co-funded campaigns (BuildRight + seller): Marketing (links to VS-14)…">
        <bpmn:documentation>Step 2: For co-funded campaigns (BuildRight + seller): Marketing (links to VS-14) structures campaign (featured placement, email, push, retail-media — links to VS-48); agree cost-share, KPIs, and reporting
Responsible (R): Marketing / Seller
Accountable (A): VP Marketing
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W3152_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3152_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3152_Task8" name="Finance execute seller fee for promotional placement (commission engine —…">
        <bpmn:documentation>Step 3: Finance execute seller fee for promotional placement (commission engine — W3141) and reconcile; report promotional lift per seller and to scorecard (W3154)
Responsible (R): Finance Analyst / Marketplace Mgr
Accountable (A): Finance Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W3152_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3152_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3152_End9" name="Complete">
        <bpmn:incoming>W3152_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3152_Annotation10">
        <bpmn:text>Controls: - CTL-515 (ensure controlled execution — Marketplace Catalog, Order Routing &amp; Seller Fulfillment (PA-95.2).) | - operational: 1P/3P price rules (W3146) and review
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3152_Assoc11" sourceRef="W3152_Annotation10" targetRef="W3152_Start5" associationDirection="None" />
