    <bpmn:process id="W_W3150" name="W3150. Seller Inventory Sync, Reservation &amp; Oversell Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Seller inventory change; order reservation; sync failure
Frequency: Continuous (real-time)
Volume: All 3P listings
Owner: Marketplace Manager
Participants: Marketplace Mgr, IT, Seller, Ecommerce (links to VS-10)
Source: workflow W3150 — Seller Inventory Sync, Reservation &amp; Oversell Prevention</bpmn:documentation>
      <bpmn:laneSet id="W3150_LaneSet4">
        <bpmn:lane id="W3150_Lane1" name="Seller">
        <bpmn:flowNodeRef>W3150_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3150_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3150_Lane2" name="System">
        <bpmn:flowNodeRef>W3150_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3150_Lane3" name="IT">
        <bpmn:flowNodeRef>W3150_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3150_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3150_Start5" name="Seller inventory change; order reservation; sync failure">
        <bpmn:outgoing>W3150_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3150_Task6" name="Seller maintains inventory via API (real-time), bulk upload, or portal; system…">
        <bpmn:documentation>Step 1: Seller maintains inventory via API (real-time), bulk upload, or portal; system syncs to listing availability; quality rules for stale feeds (auto-delist if feed &gt; 24 hr stale)
Responsible (R): Seller / IT
Accountable (A): Marketplace Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3150_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3150_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W3150_Task7" name="On order placement: system atomically reserves seller inventory; on oversell…">
        <bpmn:documentation>Step 2: On order placement: system atomically reserves seller inventory; on oversell (concurrent orders exceed available): cancel, offer back-order, or substitute per seller policy; refund customer if cancelled (links to VS-80)
Responsible (R): System
Accountable (A): Marketplace Manager
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W3150_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3150_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W3150_Task8" name="IT monitor sync health: API uptime, feed freshness, reservation accuracy; alert…">
        <bpmn:documentation>Step 3: IT monitor sync health: API uptime, feed freshness, reservation accuracy; alert on anomalies; reconcile against seller reported inventory weekly
Responsible (R): IT / Seller Ops
Accountable (A): Marketplace Manager
Duration: Daily/weekly</bpmn:documentation>
        <bpmn:incoming>W3150_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3150_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3150_End9" name="Complete">
        <bpmn:incoming>W3150_Flow15</bpmn:incoming>
      </bpmn:endEvent>
