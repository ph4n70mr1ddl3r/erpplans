<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-95.2-marketplace-catalog-order-routing-fulfillment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3145" name="W3145. Unified Marketplace Catalog &amp; Search Merchandising" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous catalog ops; search-relevance review
Frequency: Continuous + monthly review
Volume: ~10K–50K 3P SKUs + 35K 1P SKUs unified
Owner: Marketplace Manager
Participants: Marketplace Mgr, Catalog Ops (links to VS-01/VS-10), Ecommerce (links to VS-10), BI (links to VS-28)
Source: workflow W3145 — Unified Marketplace Catalog &amp; Search Merchandising</bpmn:documentation>
      <bpmn:laneSet id="W3145_LaneSet4">
        <bpmn:lane id="W3145_Lane1" name="Catalog Ops">
        <bpmn:flowNodeRef>W3145_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3145_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3145_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W3145_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3145_Lane3" name="Marketplace Mgr">
        <bpmn:flowNodeRef>W3145_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3145_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3145_Start5" name="Continuous catalog ops; search-relevance review">
        <bpmn:outgoing>W3145_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3145_Task6" name="Catalog Ops merge 1P and 3P offers into unified catalog per product taxonomy…">
        <bpmn:documentation>Step 1: Catalog Ops merge 1P and 3P offers into unified catalog per product taxonomy (links to VS-01); each SKU page may show 1P offer + multiple 3P offers with buy-box logic (W3146)
Responsible (R): Catalog Ops
Accountable (A): Marketplace Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3145_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3145_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3145_Task7" name="Ecommerce tune search relevance: combine title/spec/keyword/category; boost by…">
        <bpmn:documentation>Step 2: Ecommerce tune search relevance: combine title/spec/keyword/category; boost by listing quality (W3140), seller performance (W3154), conversion, and sponsorship (links to VS-48 retail media); apply merchandising rules (featured, new arrivals, top-rated)
Responsible (R): Ecommerce / BI
Accountable (A): Marketplace Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3145_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3145_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3145_Task8" name="Marketplace Mgr monitors catalog health: duplicate listings, miscategorization…">
        <bpmn:documentation>Step 3: Marketplace Mgr monitors catalog health: duplicate listings, miscategorization, prohibited items (links to W3156 policy), price anomalies, out-of-date content; remediate with sellers
Responsible (R): Marketplace Mgr / Seller Ops
Accountable (A): Marketplace Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3145_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3145_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3145_End9" name="Complete">
        <bpmn:incoming>W3145_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3145_Annotation10">
        <bpmn:text>Controls: - CTL-515 (ensure controlled execution — Marketplace Catalog, Order Routing &amp; Seller Fulfillment (PA-95.2).) | - operational: dedup rules and quality gating
Owner: Marketplace Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3145_Assoc11" sourceRef="W3145_Annotation10" targetRef="W3145_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3145_Flow12" sourceRef="W3145_Start5" targetRef="W3145_Task6" />
      <bpmn:sequenceFlow id="W3145_Flow13" sourceRef="W3145_Task6" targetRef="W3145_Task7" />
      <bpmn:sequenceFlow id="W3145_Flow14" sourceRef="W3145_Task7" targetRef="W3145_Task8" />
      <bpmn:sequenceFlow id="W3145_Flow15" sourceRef="W3145_Task8" targetRef="W3145_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3145_diag">
      <bpmndi:BPMNPlane id="W3145_plane" bpmnElement="W_W3145">
        <bpmndi:BPMNShape id="W3145_Lane1_di" bpmnElement="W3145_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3145_Lane2_di" bpmnElement="W3145_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
