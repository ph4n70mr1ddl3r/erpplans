    <bpmn:process id="W_W3363" name="W3363. Industry Standard, Code &amp; Best-Practice Development Participation" isExecutable="false">
      <bpmn:documentation>Trigger: Standard/code development; best-practice initiative
Frequency: Per initiative
Volume: Active standards/codes
Owner: Government Affairs Manager
Participants: Govt Affairs Mgr, affected SMEs (Quality per VS-31, Sustainability per VS-25, Privacy per VS-91, Tax per VS-79), Legal (links to VS-100)
Source: workflow W3363 — Industry Standard, Code &amp; Best-Practice Development Participation</bpmn:documentation>
      <bpmn:laneSet id="W3363_LaneSet3">
        <bpmn:lane id="W3363_Lane1" name="Govt Affairs Mgr">
        <bpmn:flowNodeRef>W3363_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3363_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3363_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3363_Lane2" name="SMEs">
        <bpmn:flowNodeRef>W3363_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3363_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3363_Start4" name="Standard/code development; best-practice initiative">
        <bpmn:outgoing>W3363_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3363_Task5" name="Govt Affairs Mgr identify standards/code/best-practice initiatives relevant to…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr identify standards/code/best-practice initiatives relevant to BuildRight (product safety/DTI-BPS links to VS-31/VS-89, sustainability/BERDE links to VS-25/VS-78, data privacy links to VS-91, retail/ecommerce codes) and engage SMEs
Responsible (R): Govt Affairs Mgr / SMEs
Accountable (A): VP Legal &amp; Compliance
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3363_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3363_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3363_Task6" name="SMEs/Govt Affairs Mgr participate in development (working groups, public…">
        <bpmn:documentation>Step 2: SMEs/Govt Affairs Mgr participate in development (working groups, public comment, pilots), contribute BuildRight&#x27;s expertise and data, and advocate for practical, BuildRight-favorable outcomes
Responsible (R): SMEs / Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3363_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3363_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3363_Task7" name="Govt Affairs Mgr cascade adopted standards/codes to compliance readiness (links…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr cascade adopted standards/codes to compliance readiness (links to VS-22.3/VS-31), capture BuildRight&#x27;s contribution, and track adoption/impact (W3368)
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W3363_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3363_End8" name="Complete">
        <bpmn:incoming>W3363_Flow14</bpmn:incoming>
      </bpmn:endEvent>
