        <bpmn:outgoing>W3376_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3376_Task4" name="Govt Affairs Mgr/VP Legal &amp; Compliance develop the annual external-affairs…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr/VP Legal &amp; Compliance develop the annual external-affairs plan: objectives (policy outcomes, industry influence, reputation, risk mitigation), initiatives, KPIs, and budget (W3375); align to corporate strategy (links to VS-33)
Responsible (R): Govt Affairs Mgr / VP Legal &amp; Compliance
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3376_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3376_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3376_Task5" name="Govt Affairs Mgr track KPIs quarterly (policy engagements W3356, submissions…">
        <bpmn:documentation>Step 2: Govt Affairs Mgr track KPIs quarterly (policy engagements W3356, submissions W3357, coalition activity W3358, industry footprint W3362/W3368, reputation W3370, risk indicators W3374), and report to leadership
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3376_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3376_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3376_Task6" name="Govt Affairs Mgr/VP Legal &amp; Compliance present the external-affairs report to…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr/VP Legal &amp; Compliance present the external-affairs report to the board (links to VS-36.1): policy landscape, key engagements and outcomes, industry standing, political/regulatory risks, and recommendations
Responsible (R): Govt Affairs Mgr / VP Legal &amp; Compliance
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3376_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3376_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3376_End7" name="Complete">
        <bpmn:incoming>W3376_Flow13</bpmn:incoming>
      </bpmn:endEvent>
