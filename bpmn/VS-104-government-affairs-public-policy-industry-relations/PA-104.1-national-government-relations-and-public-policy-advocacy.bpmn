      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3355" name="W3355. Public Policy Position Development &amp; Advocacy Campaign Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Material policy issue identified (W3354)
Frequency: Per issue
Volume: ~10–20 active issues/year
Owner: Government Affairs Manager
Participants: Govt Affairs Mgr, VP Legal &amp; Compliance, affected business units, CEO, Legal (links to VS-100), Comms (links to VS-14.3)
Source: workflow W3355 — Public Policy Position Development &amp; Advocacy Campaign Execution</bpmn:documentation>
      <bpmn:laneSet id="W3355_LaneSet2">
        <bpmn:lane id="W3355_Lane1" name="Govt Affairs Mgr">
        <bpmn:flowNodeRef>W3355_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3355_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3355_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3355_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3355_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3355_Start3" name="Material policy issue identified (W3354)">
        <bpmn:outgoing>W3355_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3355_Task4" name="Govt Affairs Mgr/Legal develop BuildRight&#x27;s policy position on the issue…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr/Legal develop BuildRight&#x27;s policy position on the issue: analysis, options (support/oppose/amend), recommended position, rationale, and ask; obtain executive sign-off per authority (links to VS-36)
Responsible (R): Govt Affairs Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W3355_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3355_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3355_Task5" name="Govt Affairs Mgr execute the advocacy campaign: targeted meetings (W3356)…">
        <bpmn:documentation>Step 2: Govt Affairs Mgr execute the advocacy campaign: targeted meetings (W3356), written submissions (W3357), coalition building (W3358), and selective public/industry communication (coordinate with Comms links to VS-14.3); track progress
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W3355_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3355_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3355_Task6" name="Govt Affairs Mgr report outcome, capture lessons, update position/strategy as…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr report outcome, capture lessons, update position/strategy as the issue evolves, and document the position and engagement record (links to VS-88) for audit and continuity
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per issue</bpmn:documentation>
        <bpmn:incoming>W3355_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3355_End7" name="Complete">
        <bpmn:incoming>W3355_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3355_Annotation8">
        <bpmn:text>Controls: - CTL-541 (ensure controlled execution — National Government Relations &amp; Public Policy Advocacy (PA-104.1).) | - operational: cross-functional review; operational: executive sign-off
Owner: Government Affairs Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3355_Assoc9" sourceRef="W3355_Annotation8" targetRef="W3355_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3355_Flow10" sourceRef="W3355_Start3" targetRef="W3355_Task4" />
      <bpmn:sequenceFlow id="W3355_Flow11" sourceRef="W3355_Task4" targetRef="W3355_Task5" />
      <bpmn:sequenceFlow id="W3355_Flow12" sourceRef="W3355_Task5" targetRef="W3355_Task6" />
      <bpmn:sequenceFlow id="W3355_Flow13" sourceRef="W3355_Task6" targetRef="W3355_End7" />
    </bpmn:process>
