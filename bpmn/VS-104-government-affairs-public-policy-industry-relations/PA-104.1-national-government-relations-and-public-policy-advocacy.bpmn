      <bpmn:startEvent id="W3360_Start3" name="Advocacy activity; contribution/invitation; compliance review">
        <bpmn:outgoing>W3360_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3360_Task4" name="Govt Affairs Mgr/Legal maintain the political-activity and ethics framework…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr/Legal maintain the political-activity and ethics framework: code of conduct for government engagement, gift/entertainment limits (links to VS-86.3 anti-bribery), political-contribution policy, and lobbying disclosure obligations
Responsible (R): Govt Affairs Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3360_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3360_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3360_Task5" name="Govt Affairs Mgr screen all engagements, hospitality, and contributions against…">
        <bpmn:documentation>Step 2: Govt Affairs Mgr screen all engagements, hospitality, and contributions against the framework and anti-corruption policy (links to VS-86.3); obtain required approvals and maintain records (links to VS-88)
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3360_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3360_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3360_Task6" name="Govt Affairs Mgr/Compliance maintain disclosure records, support internal audit…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr/Compliance maintain disclosure records, support internal audit (links to VS-21.1) and any government inquiry (links to VS-22.2/VS-100), and report compliance to the board/audit committee (links to VS-36)
Responsible (R): Govt Affairs Mgr / Compliance
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3360_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3360_End7" name="Complete">
        <bpmn:incoming>W3360_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3360_Annotation8">
        <bpmn:text>Controls: - CTL-155 (ensure lawful political engagement &amp; lobbying disclosure.) | - operational: ethics framework and screening; operational: records and review
Owner: Government Affairs Manager</bpmn:text>
      </bpmn:textAnnotation>
