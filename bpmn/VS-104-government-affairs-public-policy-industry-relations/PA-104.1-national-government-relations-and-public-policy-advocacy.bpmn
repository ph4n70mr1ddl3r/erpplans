<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-104.1-national-government-relations-and-public-policy-advocacy" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3353" name="W3353. National Government Stakeholder Mapping &amp; Relationship Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning; new stakeholder; leadership change
Frequency: Continuous + annual
Volume: National stakeholder map (Congress, agencies, regulators)
Owner: Government Affairs Manager
Participants: Govt Affairs Mgr, VP Legal &amp; Compliance, CEO, Entity leadership
Source: workflow W3353 — National Government Stakeholder Mapping &amp; Relationship Management</bpmn:documentation>
      <bpmn:laneSet id="W3353_LaneSet2">
        <bpmn:lane id="W3353_Lane1" name="Govt Affairs Mgr">
        <bpmn:flowNodeRef>W3353_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3353_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3353_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3353_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3353_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3353_Start3" name="Annual planning; new stakeholder; leadership change">
        <bpmn:outgoing>W3353_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3353_Task4" name="Govt Affairs Mgr build and maintain the national stakeholder map: legislators…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr build and maintain the national stakeholder map: legislators (Senators, Representatives, relevant committees — trade, labor, finance, ways &amp; means), executive agencies (DTI, DOLE, BIR, BSP, NTC, DENR, DTI-BPS, ARTA, FDA), regulators, and local-government leagues at the national level
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3353_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3353_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3353_Task5" name="Govt Affairs Mgr cultivate and manage relationships: briefings, meetings, site…">
        <bpmn:documentation>Step 2: Govt Affairs Mgr cultivate and manage relationships: briefings, meetings, site visits, information sharing, and BuildRight positioning as a credible industry voice; coordinate executive participation (W3359)
Responsible (R): Govt Affairs Mgr / Leadership
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3353_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3353_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3353_Task6" name="Govt Affairs Mgr track engagement (CRM-style), relationship health, and issues…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr track engagement (CRM-style), relationship health, and issues per stakeholder; brief leadership and coordinate with LGU relationship work (links to VS-76.3) and labor liaison (links to VS-84.3 W2894)
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3353_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3353_End7" name="Complete">
        <bpmn:incoming>W3353_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3353_Annotation8">
        <bpmn:text>Controls: - CTL-541 (ensure controlled execution — National Government Relations &amp; Public Policy Advocacy (PA-104.1).) | - operational: proactive mapping; operational: ethics policy
Owner: Government Affairs Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3353_Assoc9" sourceRef="W3353_Annotation8" targetRef="W3353_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3353_Flow10" sourceRef="W3353_Start3" targetRef="W3353_Task4" />
      <bpmn:sequenceFlow id="W3353_Flow11" sourceRef="W3353_Task4" targetRef="W3353_Task5" />
      <bpmn:sequenceFlow id="W3353_Flow12" sourceRef="W3353_Task5" targetRef="W3353_Task6" />
      <bpmn:sequenceFlow id="W3353_Flow13" sourceRef="W3353_Task6" targetRef="W3353_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3353_diag">
      <bpmndi:BPMNPlane id="W3353_plane" bpmnElement="W_W3353">
        <bpmndi:BPMNShape id="W3353_Lane1_di" bpmnElement="W3353_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
