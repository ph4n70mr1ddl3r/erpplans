    <bpmn:process id="W_W3354" name="W3354. Legislative &amp; Regulatory Monitoring, Horizon Scanning &amp; Impact Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous; complements VS-22.3 regulatory-change management
Frequency: Continuous + monthly digest
Volume: Bills, IRRs, agency issuances, draft regulations
Owner: Government Affairs Manager
Participants: Govt Affairs Mgr, Legal (links to VS-100/VS-22.3), Compliance (links to VS-22), Tax (links to VS-79), affected business units
Source: workflow W3354 — Legislative &amp; Regulatory Monitoring, Horizon Scanning &amp; Impact Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3354_LaneSet2">
        <bpmn:lane id="W3354_Lane1" name="Govt Affairs Mgr">
        <bpmn:flowNodeRef>W3354_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3354_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3354_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3354_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3354_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3354_Start3" name="Continuous; complements VS-22.3 regulatory-change management">
        <bpmn:outgoing>W3354_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3354_Task4" name="Govt Affairs Mgr monitor legislative and regulatory activity: filed bills…">
        <bpmn:documentation>Step 1: Govt Affairs Mgr monitor legislative and regulatory activity: filed bills, pending IRRs, agency draft issuances, public consultations (BIR revenue regulations, DTI consumer rules, DOLE labor orders, BSP payments, DENR environmental, customs/tariff per VS-87, data privacy per VS-91); horizon-scan emerging issues
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3354_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3354_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3354_Task5" name="Govt Affairs Mgr/Legal assess business impact of each tracked item (revenue…">
        <bpmn:documentation>Step 2: Govt Affairs Mgr/Legal assess business impact of each tracked item (revenue, cost, compliance, operations) across BuildRight&#x27;s segments; prioritize by materiality and timeline; coordinate with regulatory-change execution (links to VS-22.3)
Responsible (R): Govt Affairs Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W3354_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3354_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3354_Task6" name="Govt Affairs Mgr publish monthly regulatory/legislative digest to leadership…">
        <bpmn:documentation>Step 3: Govt Affairs Mgr publish monthly regulatory/legislative digest to leadership and affected units, feed impacts into risk register (links to VS-21.2) and planning (links to VS-33), and brief executives on priority items (W3359)
Responsible (R): Govt Affairs Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3354_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3354_End7" name="Complete">
        <bpmn:incoming>W3354_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3354_Annotation8">
        <bpmn:text>Controls: - CTL-155 (ensure lawful political engagement &amp; lobbying disclosure.) | - operational: horizon scanning; operational: cross-functional impact assessment
Owner: Government Affairs Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3354_Assoc9" sourceRef="W3354_Annotation8" targetRef="W3354_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3354_Flow10" sourceRef="W3354_Start3" targetRef="W3354_Task4" />
      <bpmn:sequenceFlow id="W3354_Flow11" sourceRef="W3354_Task4" targetRef="W3354_Task5" />
      <bpmn:sequenceFlow id="W3354_Flow12" sourceRef="W3354_Task5" targetRef="W3354_Task6" />
      <bpmn:sequenceFlow id="W3354_Flow13" sourceRef="W3354_Task6" targetRef="W3354_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3354_diag">
      <bpmndi:BPMNPlane id="W3354_plane" bpmnElement="W_W3354">
        <bpmndi:BPMNShape id="W3354_Lane1_di" bpmnElement="W3354_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
