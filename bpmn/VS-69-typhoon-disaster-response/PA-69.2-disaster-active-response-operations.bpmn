        <bpmndi:BPMNShape id="W2512_Annotation10_di" bpmnElement="W2512_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2512_Flow12_di" bpmnElement="W2512_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2512_Flow13_di" bpmnElement="W2512_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2512_Flow14_di" bpmnElement="W2512_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2512_Flow15_di" bpmnElement="W2512_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2512_Assoc11_di" bpmnElement="W2512_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2513" name="W2513. Real-Time Disaster Operations Center Activation" isExecutable="false">
      <bpmn:documentation>Trigger: Multi-store/multi-DC typhoon impact event (Signal No. 3+ across 10+ stores)
Frequency: 3–5 activations per year
Volume: 1 operations center per event
Owner: COO
Participants: COO, VP Store Operations, VP Supply Chain, CIO, CHRO, CFO, CMO, VP Legal
Source: workflow W2513 — Real-Time Disaster Operations Center Activation</bpmn:documentation>
      <bpmn:laneSet id="W2513_LaneSet3">
        <bpmn:lane id="W2513_Lane1" name="COO">
        <bpmn:flowNodeRef>W2513_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2513_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2513_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2513_Lane2" name="Functional VPs">
        <bpmn:flowNodeRef>W2513_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2513_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2513_Start4" name="Multi-store/multi-DC typhoon impact event (Signal No. 3+ across 10+ stores)">
        <bpmn:outgoing>W2513_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2513_Task5" name="COO activates Disaster Operations Center at HQ (Davao) or virtual: establishes…">
        <bpmn:documentation>Step 1: COO activates Disaster Operations Center at HQ (Davao) or virtual: establishes command structure, communication channels, situation reporting cadence (every 2 hours during active event); assigns functional leads
Responsible (R): COO
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W2513_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2513_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2513_Task6" name="Functional leads provide situation reports: Store Ops (store status, damage…">
        <bpmn:documentation>Step 2: Functional leads provide situation reports: Store Ops (store status, damage, employee safety), Supply Chain (DC status, inventory, logistics), IT (system status, communication channels), HR (employee welfare), Finance (financial exposure), Legal (regulatory/liability)
Responsible (R): Functional VPs
Accountable (A): COO
Duration: Ongoing (every 2 hours)</bpmn:documentation>
        <bpmn:incoming>W2513_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2513_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2513_Task7" name="COO makes operational decisions: store closure/reopening, emergency procurement…">
        <bpmn:documentation>Step 3: COO makes operational decisions: store closure/reopening, emergency procurement authorization (up to PHP 200M), staff redeployment, customer communication, insurance notification; documents all decisions for post-event review
Responsible (R): COO
Accountable (A): CEO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2513_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2513_End8" name="Complete">
        <bpmn:incoming>W2513_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2513_Annotation9">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: COO review and approval gate
Owner: COO</bpmn:text>
      </bpmn:textAnnotation>
