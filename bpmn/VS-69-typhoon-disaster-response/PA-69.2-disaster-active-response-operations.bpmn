    <bpmn:process id="W_W2515" name="W2515. Disaster-Affected Employee Welfare &amp; Deployment Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Post-typhoon employee safety check process
Frequency: 3–5 events per year requiring welfare tracking
Volume: 50–2,000 employees per event
Owner: HR Operations Manager
Participants: HR Ops Mgr, Store Managers, DC Ops, CHRO, Employee Relations
Source: workflow W2515 — Disaster-Affected Employee Welfare &amp; Deployment Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2515_LaneSet3">
        <bpmn:lane id="W2515_Lane1" name="HR Operations Manager">
        <bpmn:flowNodeRef>W2515_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2515_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2515_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2515_Lane2" name="HR Ops">
        <bpmn:flowNodeRef>W2515_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2515_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2515_Start4" name="Post-typhoon employee safety check process">
        <bpmn:outgoing>W2515_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2515_Task5" name="HR Ops activates welfare check: automated SMS/IVR check-in to all employees in…">
        <bpmn:documentation>Step 1: HR Ops activates welfare check: automated SMS/IVR check-in to all employees in affected region; tracks response status (safe, affected, unreachable); Store/DC Managers supplement with direct calls to non-responders within 12 hours
Responsible (R): HR Operations Manager
Accountable (A): CHRO
Duration: 12–24 hours</bpmn:documentation>
        <bpmn:incoming>W2515_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2515_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2515_Task6" name="For affected employees: HR assesses needs (housing, medical, financial)…">
        <bpmn:documentation>Step 2: For affected employees: HR assesses needs (housing, medical, financial); activates emergency salary advance (up to PHP 20,000 tax-free); coordinates relief goods distribution from store inventory per company policy
Responsible (R): HR Ops / Employee Relations
Accountable (A): CHRO
Duration: 24–48 hours</bpmn:documentation>
        <bpmn:incoming>W2515_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2515_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2515_Task7" name="HR deploys replacement staff from unaffected stores to maintain minimum…">
        <bpmn:documentation>Step 3: HR deploys replacement staff from unaffected stores to maintain minimum operations at reopened locations; tracks overtime and hazard pay eligibility per DOLE advisory
Responsible (R): HR Operations Manager
Accountable (A): COO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2515_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2515_End8" name="Complete">
        <bpmn:incoming>W2515_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2515_Annotation9">
        <bpmn:text>Controls: - CTL-232 (ensure typhoon-response protocol execution.) | - operational: standard operating procedures; system-enforced validation rules
Owner: HR Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
