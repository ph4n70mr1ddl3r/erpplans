    <bpmn:process id="W_W2517" name="W2517. Active Typhoon Customer Safety &amp; In-Store Emergency Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Sudden weather deterioration while store is open with customers present
Frequency: 2–5 activations per store per year
Volume: Up to 200 stores; varies by typhoon track
Owner: Store Manager
Participants: Store Manager, All Staff, Customers
Source: workflow W2517 — Active Typhoon Customer Safety &amp; In-Store Emergency Protocol</bpmn:documentation>
      <bpmn:laneSet id="W2517_LaneSet3">
        <bpmn:lane id="W2517_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2517_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2517_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2517_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2517_Lane2" name="All Staff">
        <bpmn:flowNodeRef>W2517_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2517_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2517_Start4" name="Sudden weather deterioration while store is open with customers present">
        <bpmn:outgoing>W2517_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2517_Task5" name="Store Manager monitors weather conditions; at sudden deterioration: activates…">
        <bpmn:documentation>Step 1: Store Manager monitors weather conditions; at sudden deterioration: activates customer safety protocol via PA announcement; directs customers away from outdoor lumber yard, loading dock, and exterior areas
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W2517_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2517_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2517_Task6" name="If shelter-in-place required: guide customers to interior secure area (away…">
        <bpmn:documentation>Step 2: If shelter-in-place required: guide customers to interior secure area (away from large windows, overhead fixtures); provide water, first aid; maintain calm with regular PA updates every 15 minutes
Responsible (R): All Staff
Accountable (A): Store Manager
Duration: Duration of event</bpmn:documentation>
        <bpmn:incoming>W2517_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2517_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2517_Task7" name="When safe to do so: gradually resume operations or execute orderly closure…">
        <bpmn:documentation>Step 3: When safe to do so: gradually resume operations or execute orderly closure (W2510); document any customer incidents for insurance and liability purposes
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1–2 hours post-event</bpmn:documentation>
        <bpmn:incoming>W2517_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2517_End8" name="Complete">
        <bpmn:incoming>W2517_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2517_Annotation9">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2517_Assoc10" sourceRef="W2517_Annotation9" targetRef="W2517_Start4" associationDirection="None" />
