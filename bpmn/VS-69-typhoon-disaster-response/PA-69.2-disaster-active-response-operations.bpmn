    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2511" name="W2511. DC Emergency Shutdown &amp; Asset Protection" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 3+ in DC area or facility flooding risk assessment
Frequency: 2–4 shutdowns per DC per year
Volume: 4 DCs; typically 1–2 affected per event
Owner: DC Operations Manager
Participants: DC Ops Manager, Warehouse Supervisor, Safety Officer, VP Supply Chain
Source: workflow W2511 — DC Emergency Shutdown &amp; Asset Protection</bpmn:documentation>
      <bpmn:laneSet id="W2511_LaneSet4">
        <bpmn:lane id="W2511_Lane1" name="DC Ops Manager">
        <bpmn:flowNodeRef>W2511_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2511_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2511_Lane2" name="Warehouse Supervisor">
        <bpmn:flowNodeRef>W2511_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2511_Lane3" name="Safety Officer">
        <bpmn:flowNodeRef>W2511_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2511_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2511_Start5" name="PAGASA Signal No. 3+ in DC area or facility flooding risk assessment">
        <bpmn:outgoing>W2511_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2511_Task6" name="DC Ops Manager initiates emergency shutdown: halt all inbound/outbound…">
        <bpmn:documentation>Step 1: DC Ops Manager initiates emergency shutdown: halt all inbound/outbound operations, complete in-process picking/packing or secure at last checkpoint, stage all MHE (forklifts, reach trucks) at high ground, secure dock doors with flood barriers
Responsible (R): DC Ops Manager
Accountable (A): VP Supply Chain
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2511_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2511_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2511_Task7" name="Warehouse Supervisors execute critical asset protection: move high-value…">
        <bpmn:documentation>Step 2: Warehouse Supervisors execute critical asset protection: move high-value inventory (power tools, appliances) above flood line, seal chemical storage areas, secure server room with waterproof covers, activate UPS for graceful system shutdown
Responsible (R): Warehouse Supervisor / IT
Accountable (A): DC Ops Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2511_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2511_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2511_Task8" name="Safety Officer confirms all personnel evacuated; DC Ops Manager reports final…">
        <bpmn:documentation>Step 3: Safety Officer confirms all personnel evacuated; DC Ops Manager reports final status to Operations Center; maintains remote monitoring via security cameras where possible
Responsible (R): Safety Officer / DC Ops Manager
Accountable (A): VP Supply Chain
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W2511_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2511_End9" name="Complete">
        <bpmn:incoming>W2511_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2511_Annotation10">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2511_Assoc11" sourceRef="W2511_Annotation10" targetRef="W2511_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2511_Flow12" sourceRef="W2511_Start5" targetRef="W2511_Task6" />
      <bpmn:sequenceFlow id="W2511_Flow13" sourceRef="W2511_Task6" targetRef="W2511_Task7" />
      <bpmn:sequenceFlow id="W2511_Flow14" sourceRef="W2511_Task7" targetRef="W2511_Task8" />
      <bpmn:sequenceFlow id="W2511_Flow15" sourceRef="W2511_Task8" targetRef="W2511_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2511_diag">
      <bpmndi:BPMNPlane id="W2511_plane" bpmnElement="W_W2511">
        <bpmndi:BPMNShape id="W2511_Lane1_di" bpmnElement="W2511_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2511_Lane2_di" bpmnElement="W2511_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
