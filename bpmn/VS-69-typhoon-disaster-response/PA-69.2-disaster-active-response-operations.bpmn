<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-69.2-disaster-active-response-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2510" name="W2510. Store Emergency Closure Decision &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: PAGASA Signal No. 3+ in store area, local government evacuation order, or facility safety assessment
Frequency: 2–5 closures per store per year; region-wide events affect 20–60 stores simultaneously
Volume: Up to 200 stores for nationwide super typhoons
Owner: Regional Manager
Participants: Regional Manager, Store Manager, VP Store Operations, HR, Security
Source: workflow W2510 — Store Emergency Closure Decision &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W2510_LaneSet4">
        <bpmn:lane id="W2510_Lane1" name="Regional Manager">
        <bpmn:flowNodeRef>W2510_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2510_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2510_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2510_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2510_Lane3" name="System">
        <bpmn:flowNodeRef>W2510_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2510_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2510_Start5" name="PAGASA Signal No. 3+ in store area, local government evacuation order, or facility safety…">
        <bpmn:outgoing>W2510_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2510_Task6" name="Regional Manager assesses conditions per decision matrix: PAGASA signal, local…">
        <bpmn:documentation>Step 1: Regional Manager assesses conditions per decision matrix: PAGASA signal, local government advisory, road accessibility, staff safety, facility integrity; authorizes closure with VP Store Operations approval for multi-store events
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2510_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2510_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2510_Task7" name="Store Manager executes closure: announce to customers via PA system, complete…">
        <bpmn:documentation>Step 2: Store Manager executes closure: announce to customers via PA system, complete current transactions, secure cash in safe, power down non-essential systems, engage alarm, lock facility, escort remaining customers out safely
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2510_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2510_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2510_Task8" name="System automatically updates store status to &quot;Temporarily Closed&quot; on ecommerce…">
        <bpmn:documentation>Step 3: System automatically updates store status to &quot;Temporarily Closed&quot; on ecommerce, BOPIS, Google Business, and customer-facing channels; pauses all pending BOPIS orders with automated customer notification
Responsible (R): System / Store Ops
Accountable (A): VP Store Operations
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2510_Flow14</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2510_End9" name="Complete">
        <bpmn:incoming>W2510_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2510_Annotation10">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: Regional Manager review and approval gate
Owner: Regional Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2510_Assoc11" sourceRef="W2510_Annotation10" targetRef="W2510_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2510_Flow12" sourceRef="W2510_Start5" targetRef="W2510_Task6" />
      <bpmn:sequenceFlow id="W2510_Flow13" sourceRef="W2510_Task6" targetRef="W2510_Task7" />
      <bpmn:sequenceFlow id="W2510_Flow14" sourceRef="W2510_Task7" targetRef="W2510_Task8" />
      <bpmn:sequenceFlow id="W2510_Flow15" sourceRef="W2510_Task8" targetRef="W2510_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2510_diag">
      <bpmndi:BPMNPlane id="W2510_plane" bpmnElement="W_W2510">
        <bpmndi:BPMNShape id="W2510_Lane1_di" bpmnElement="W2510_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2510_Lane2_di" bpmnElement="W2510_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
