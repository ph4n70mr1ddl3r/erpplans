        <bpmndi:BPMNShape id="W2511_End9_di" bpmnElement="W2511_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2511_Annotation10_di" bpmnElement="W2511_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2511_Flow12_di" bpmnElement="W2511_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2511_Flow13_di" bpmnElement="W2511_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2511_Flow14_di" bpmnElement="W2511_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2511_Flow15_di" bpmnElement="W2511_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2511_Assoc11_di" bpmnElement="W2511_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2512" name="W2512. Emergency Merchandise Rapid Replenishment Dispatch" isExecutable="false">
      <bpmn:documentation>Trigger: Post-typhoon needs assessment or government/NGO emergency order
Frequency: 6–10 activations per year
Volume: 10–50 emergency deliveries per activation
Owner: Logistics Manager
Participants: Logistics Mgr, DC Ops, Procurement, Store Ops, Government/NGO Liaison
Source: workflow W2512 — Emergency Merchandise Rapid Replenishment Dispatch</bpmn:documentation>
      <bpmn:laneSet id="W2512_LaneSet4">
        <bpmn:lane id="W2512_Lane1" name="Supply Planning">
        <bpmn:flowNodeRef>W2512_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2512_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2512_Lane2" name="DC Ops">
        <bpmn:flowNodeRef>W2512_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2512_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W2512_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2512_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2512_Start5" name="Post-typhoon needs assessment or government/NGO emergency order">
        <bpmn:outgoing>W2512_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2512_Task6" name="Supply Chain receives post-disaster needs assessment from affected stores and…">
        <bpmn:documentation>Step 1: Supply Chain receives post-disaster needs assessment from affected stores and regional government; prioritizes dispatch: medical facility orders first, then essential supply stores, then general replenishment
Responsible (R): Supply Planning / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2512_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2512_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2512_Task7" name="DC Ops picks emergency orders with dedicated priority wave; Logistics Manager…">
        <bpmn:documentation>Step 2: DC Ops picks emergency orders with dedicated priority wave; Logistics Manager dispatches available trucks (owned fleet first, then 3PL surge); coordinates road access with local government
Responsible (R): DC Ops / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2512_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2512_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2512_Task8" name="Store Ops receives emergency delivery with expedited GR process (visual count…">
        <bpmn:documentation>Step 3: Store Ops receives emergency delivery with expedited GR process (visual count only, detailed matching deferred 48 hrs); updates inventory; begins emergency sales operations
Responsible (R): Store Manager / Receiving Clerk
Accountable (A): Regional Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2512_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2512_End9" name="Complete">
        <bpmn:incoming>W2512_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2512_Annotation10">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2512_Assoc11" sourceRef="W2512_Annotation10" targetRef="W2512_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2512_Flow12" sourceRef="W2512_Start5" targetRef="W2512_Task6" />
      <bpmn:sequenceFlow id="W2512_Flow13" sourceRef="W2512_Task6" targetRef="W2512_Task7" />
