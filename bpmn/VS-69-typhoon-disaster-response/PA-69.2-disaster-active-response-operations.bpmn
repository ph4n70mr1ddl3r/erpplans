    <bpmn:process id="W_W2514" name="W2514. Emergency Generator &amp; Power Contingency Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Commercial power outage at store or DC during/after typhoon
Frequency: 15–30 power outage activations per year across network
Volume: 10–50 simultaneous locations per major typhoon
Owner: Maintenance/Utility Staff
Participants: Maintenance Staff, Store Manager, DC Ops Manager, Facilities
Source: workflow W2514 — Emergency Generator &amp; Power Contingency Operations</bpmn:documentation>
      <bpmn:laneSet id="W2514_LaneSet4">
        <bpmn:lane id="W2514_Lane1" name="Maintenance">
        <bpmn:flowNodeRef>W2514_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2514_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2514_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2514_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2514_Lane3" name="Facilities Manager">
        <bpmn:flowNodeRef>W2514_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2514_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2514_Start5" name="Commercial power outage at store or DC during/after typhoon">
        <bpmn:outgoing>W2514_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2514_Task6" name="Maintenance activates backup generator: verifies fuel level (minimum 8-hour…">
        <bpmn:documentation>Step 1: Maintenance activates backup generator: verifies fuel level (minimum 8-hour runtime), starts generator, transfers load to backup, prioritizes circuits (POS, security, lighting, refrigeration for DC); logs activation time
Responsible (R): Maintenance / Utility Staff
Accountable (A): Store Manager / DC Ops Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2514_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2514_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2514_Task7" name="Store Manager confirms POS operation in offline mode; switches to cash-first…">
        <bpmn:documentation>Step 2: Store Manager confirms POS operation in offline mode; switches to cash-first tender policy if connectivity lost; monitors generator fuel consumption and arranges refueling logistics
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2514_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2514_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2514_Task8" name="Facilities tracks generator runtime, fuel consumption, and maintenance status…">
        <bpmn:documentation>Step 3: Facilities tracks generator runtime, fuel consumption, and maintenance status across affected locations; coordinates fuel resupply with suppliers; escalates if runtime &lt; 4 hours remaining
Responsible (R): Facilities Manager
Accountable (A): COO
Duration: Ongoing (every 4 hours)</bpmn:documentation>
        <bpmn:incoming>W2514_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2514_End9" name="Complete">
        <bpmn:incoming>W2514_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2514_Annotation10">
