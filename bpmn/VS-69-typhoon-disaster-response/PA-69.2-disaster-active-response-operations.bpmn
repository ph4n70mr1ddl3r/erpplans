    <bpmn:process id="W_W2516" name="W2516. Emergency Vendor Coordination &amp; Expedite Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Post-disaster demand surge or government/NGO emergency procurement request
Frequency: 6–10 activations per year
Volume: 50–200 emergency POs per major event
Owner: Procurement Manager
Participants: Procurement Mgr, Merchandising, Finance, Logistics, Vendors
Source: workflow W2516 — Emergency Vendor Coordination &amp; Expedite Procurement</bpmn:documentation>
      <bpmn:laneSet id="W2516_LaneSet4">
        <bpmn:lane id="W2516_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W2516_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2516_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2516_Lane2" name="Finance Manager">
        <bpmn:flowNodeRef>W2516_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2516_Lane3" name="Logistics Manager">
        <bpmn:flowNodeRef>W2516_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2516_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2516_Start5" name="Post-disaster demand surge or government/NGO emergency procurement request">
        <bpmn:outgoing>W2516_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2516_Task6" name="Procurement contacts key emergency vendors (tarps, plywood, nails…">
        <bpmn:documentation>Step 1: Procurement contacts key emergency vendors (tarps, plywood, nails, waterproofing, generators): confirms availability, negotiates emergency pricing (within DTI price freeze limits), secures allocation priority over competitors
Responsible (R): Procurement Manager / Buyers
Accountable (A): VP Merchandising
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2516_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2516_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2516_Task7" name="Finance fast-tracks emergency vendor payments: bypasses standard 30-day terms…">
        <bpmn:documentation>Step 2: Finance fast-tracks emergency vendor payments: bypasses standard 30-day terms for COD/advance payment to secure allocation; CFO authorizes emergency procurement budget (tiered: PHP 10M / Finance Controller; PHP 50M / CFO; PHP 200M / CEO)
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2516_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2516_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2516_Task8" name="Logistics arranges expedited transport: bypasses DC for direct-to-store…">
        <bpmn:documentation>Step 3: Logistics arranges expedited transport: bypasses DC for direct-to-store delivery where possible; coordinates vendor truck dispatch to hardest-hit stores
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W2516_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2516_End9" name="Complete">
        <bpmn:incoming>W2516_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2516_Annotation10">
        <bpmn:text>Controls: - CTL-437 (ensure controlled execution — Active Disaster Response &amp; Emergency Operations (PA-69.2).) | - operational: DTI enforcement and long-term vendor relationships
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2516_Assoc11" sourceRef="W2516_Annotation10" targetRef="W2516_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2516_Flow12" sourceRef="W2516_Start5" targetRef="W2516_Task6" />
      <bpmn:sequenceFlow id="W2516_Flow13" sourceRef="W2516_Task6" targetRef="W2516_Task7" />
      <bpmn:sequenceFlow id="W2516_Flow14" sourceRef="W2516_Task7" targetRef="W2516_Task8" />
      <bpmn:sequenceFlow id="W2516_Flow15" sourceRef="W2516_Task8" targetRef="W2516_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2516_diag">
      <bpmndi:BPMNPlane id="W2516_plane" bpmnElement="W_W2516">
        <bpmndi:BPMNShape id="W2516_Lane1_di" bpmnElement="W2516_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2516_Lane2_di" bpmnElement="W2516_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
