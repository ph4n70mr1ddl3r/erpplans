<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-148.3-lease-administration-compliance-and-optimization-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4425" name="W4425. Lease Accounting Period-End Close, Reconciliation &amp; Disclosures" isExecutable="false">
      <bpmn:documentation>Trigger: Month/quarter/year-end close
Frequency: Monthly + quarterly + annual
Volume: 5-entity lease portfolio each close
Owner: Lease Accounting / Controller / Consolidation (VS-17)
Participants: Controller, Consolidation (VS-17), Finance (VS-17.4), AP (VS-15), Treasury (VS-18), Audit (VS-21), External Auditor
Source: workflow W4425 — Lease Accounting Period-End Close, Reconciliation &amp; Disclosures</bpmn:documentation>
      <bpmn:laneSet id="W4425_LaneSet3">
        <bpmn:lane id="W4425_Lane1" name="Lease Accounting">
        <bpmn:flowNodeRef>W4425_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4425_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4425_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4425_Lane2" name="Controller">
        <bpmn:flowNodeRef>W4425_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4425_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4425_Start4" name="Month/quarter/year-end close">
        <bpmn:outgoing>W4425_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4425_Task5" name="Lease Accounting close the period — run final engine (W4417), reconcile…">
        <bpmn:documentation>Step 1: Lease Accounting close the period — run final engine (W4417), reconcile lease-accounting system to GL ROU/liability, to AP/cash (VS-15/VS-18), and to FA register (VS-35)
Responsible (R): Lease Accounting / Controller
Accountable (A): Controller
Duration: Per close</bpmn:documentation>
        <bpmn:incoming>W4425_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4425_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4425_Task6" name="PFRS 16 disclosures">
        <bpmn:documentation>Step 2: Lease Accounting/Consolidation run intercompany eliminations (W4424), validate consolidation, and prepare the PFRS 16 disclosures (maturity analysis, total cash outflow, ROU additions, depreciation/interest expense, variable/short-term/low-value expense, extensions/terminations/modifications)
Responsible (R): Lease Accounting / Consolidation / Finance
Accountable (A): Controller / CFO
Duration: Per close</bpmn:documentation>
        <bpmn:incoming>W4425_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4425_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4425_Task7" name="Controller/Audit review &amp; sign off, support external-audit (VS-21), and file…">
        <bpmn:documentation>Step 3: Controller/Audit review &amp; sign off, support external-audit (VS-21), and file the audited FS with SEC (links VS-22/VS-79)
Responsible (R): Controller / Audit
Accountable (A): CFO
Duration: Per close</bpmn:documentation>
        <bpmn:incoming>W4425_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4425_End8" name="Complete">
        <bpmn:incoming>W4425_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4425_Annotation9">
        <bpmn:text>Controls: - CTL-111 (ensure PFRS 16 lease-accounting completeness.) | - CTL-676: system reconciled to GL/AP/cash/FA monthly; eliminations validated; PFRS 16 disclosures complete; reviewed &amp; auditor-supported
Owner: Lease Accounting / Controller / Consolidation (VS-17)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4425_Assoc10" sourceRef="W4425_Annotation9" targetRef="W4425_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4425_Flow11" sourceRef="W4425_Start4" targetRef="W4425_Task5" />
      <bpmn:sequenceFlow id="W4425_Flow12" sourceRef="W4425_Task5" targetRef="W4425_Task6" />
      <bpmn:sequenceFlow id="W4425_Flow13" sourceRef="W4425_Task6" targetRef="W4425_Task7" />
      <bpmn:sequenceFlow id="W4425_Flow14" sourceRef="W4425_Task7" targetRef="W4425_End8" />
    </bpmn:process>
