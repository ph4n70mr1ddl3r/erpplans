        <bpmndi:BPMNEdge id="W4426_Assoc9_di" bpmnElement="W4426_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4427" name="W4427. Lease Accounting System (Technology) Configuration &amp; Integration" isExecutable="false">
      <bpmn:documentation>Trigger: System lifecycle; policy change (W4409); integration need
Frequency: Per lifecycle + continuous operation
Volume: One lease-accounting platform across 5 entities
Owner: Lease Accounting / IT (VS-27) / EA (VS-113)
Participants: IT (VS-27), EA (VS-113), Controller, BI (VS-28), Consolidation (VS-17), TBM (VS-135)
Source: workflow W4427 — Lease Accounting System (Technology) Configuration &amp; Integration</bpmn:documentation>
      <bpmn:laneSet id="W4427_LaneSet3">
        <bpmn:lane id="W4427_Lane1" name="Lease Accounting">
        <bpmn:flowNodeRef>W4427_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4427_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4427_Lane2" name="IT">
        <bpmn:flowNodeRef>W4427_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4427_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4427_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4427_Start4" name="System lifecycle; policy change (W4409); integration need">
        <bpmn:outgoing>W4427_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4427_Task5" name="Lease Accounting/EA/IT select/configure the lease-accounting platform — PFRS 16…">
        <bpmn:documentation>Step 1: Lease Accounting/EA/IT select/configure the lease-accounting platform — PFRS 16 engine (PV, depreciation, interest, remeasurement, elimination), multi-entity/multi-currency, integration to GL (VS-17), AP (VS-15), FA (VS-35), BI (VS-28)
Responsible (R): Lease Accounting / EA / IT / Controller
Accountable (A): Controller / CIO
Duration: Per lifecycle</bpmn:documentation>
        <bpmn:incoming>W4427_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4427_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4427_Task6" name="IT/EA integrate &amp; test — GL posting, AP/cash feed, FA-register link…">
        <bpmn:documentation>Step 2: IT/EA integrate &amp; test — GL posting, AP/cash feed, FA-register link, consolidation feed, index/CPI feed — and migrate the portfolio (W4426)
Responsible (R): IT / EA / Lease Accounting
Accountable (A): CIO
Duration: Per deployment</bpmn:documentation>
        <bpmn:incoming>W4427_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4427_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4427_Task7" name="IT/Lease Accounting govern the platform — security (VS-27.3), change (VS-27.1)…">
        <bpmn:documentation>Step 3: IT/Lease Accounting govern the platform — security (VS-27.3), change (VS-27.1), TBM cost (VS-135), roadmap — and optimize on analytics (W4431)
Responsible (R): IT / Lease Accounting / BI
Accountable (A): CIO / Controller
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4427_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4427_End8" name="Complete">
        <bpmn:incoming>W4427_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4427_Annotation9">
        <bpmn:text>Controls: - CTL-676 (ensure controlled execution — Lease Administration, Compliance &amp; Optimization Analytics (PA-148.3).) | - CTL-676: platform security-assessed (VS-27.3); integrated to GL/AP/FA/consolidation; engine config tested; cost governed (VS-135); reconciled (W4425)
Owner: Lease Accounting / IT (VS-27) / EA (VS-113)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4427_Assoc10" sourceRef="W4427_Annotation9" targetRef="W4427_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4427_Flow11" sourceRef="W4427_Start4" targetRef="W4427_Task5" />
      <bpmn:sequenceFlow id="W4427_Flow12" sourceRef="W4427_Task5" targetRef="W4427_Task6" />
      <bpmn:sequenceFlow id="W4427_Flow13" sourceRef="W4427_Task6" targetRef="W4427_Task7" />
      <bpmn:sequenceFlow id="W4427_Flow14" sourceRef="W4427_Task7" targetRef="W4427_End8" />
    </bpmn:process>
