        <bpmn:flowNodeRef>W4423_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4423_Start3" name="Closure (VS-59); abandonment; impairment indicator; lease end">
        <bpmn:outgoing>W4423_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4423_Task4" name="Lease Accounting test ROU assets for impairment when indicators exist (closure…">
        <bpmn:documentation>Step 1: Lease Accounting test ROU assets for impairment when indicators exist (closure, abandonment, under-performance), per IAS 36, and recognize impairment to P&amp;L
Responsible (R): Lease Accounting / Fixed Assets
Accountable (A): Controller / CFO
Duration: Per indicator</bpmn:documentation>
        <bpmn:incoming>W4423_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4423_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4423_Task5" name="Lease Accounting derecognize ROU/liability at lease end/termination (W4419)…">
        <bpmn:documentation>Step 2: Lease Accounting derecognize ROU/liability at lease end/termination (W4419), account for residual/MAKE-GOOD settlement, and dispose via fixed-asset register (VS-35)
Responsible (R): Lease Accounting / Fixed Assets
Accountable (A): Controller
Duration: Per end/termination</bpmn:documentation>
        <bpmn:incoming>W4423_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4423_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4423_Task6" name="Lease Accounting coordinate disposal with closure program (VS-59), update…">
        <bpmn:documentation>Step 3: Lease Accounting coordinate disposal with closure program (VS-59), update repository (W4426), and disclose material impairments (W4425)
Responsible (R): Lease Accounting / Store Ops
Accountable (A): Controller
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4423_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4423_Flow13</bpmn:outgoing>
      </bpmn:userTask>
