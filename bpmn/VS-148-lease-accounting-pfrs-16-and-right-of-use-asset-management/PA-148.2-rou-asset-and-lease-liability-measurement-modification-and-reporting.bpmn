    <bpmn:process id="W_W4423" name="W4423. Lease Impairment, Derecognition &amp; Disposal" isExecutable="false">
      <bpmn:documentation>Trigger: Closure (VS-59); abandonment; impairment indicator; lease end
Frequency: Per event
Volume: Derecognition/impairment events across portfolio (~10–15 closures/yr + lease ends)
Owner: Lease Accounting / Controller / Fixed Assets (VS-35)
Participants: Controller, Fixed Assets (VS-35), Store Ops (VS-07), Closure (VS-59), Real Estate (VS-97), Audit (VS-21)
Source: workflow W4423 — Lease Impairment, Derecognition &amp; Disposal</bpmn:documentation>
      <bpmn:laneSet id="W4423_LaneSet2">
        <bpmn:lane id="W4423_Lane1" name="Lease Accounting">
        <bpmn:flowNodeRef>W4423_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4423_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4423_Task6</bpmn:flowNodeRef>
