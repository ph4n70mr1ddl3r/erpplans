        <bpmndi:BPMNShape id="W4417_End8_di" bpmnElement="W4417_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4417_Annotation9_di" bpmnElement="W4417_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
