      <bpmn:sequenceFlow id="W4424_Flow11" sourceRef="W4424_Task4" targetRef="W4424_Task5" />
      <bpmn:sequenceFlow id="W4424_Flow12" sourceRef="W4424_Task5" targetRef="W4424_Task6" />
      <bpmn:sequenceFlow id="W4424_Flow13" sourceRef="W4424_Task6" targetRef="W4424_End7" />
    </bpmn:process>
