<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-148.2-rou-asset-and-lease-liability-measurement-modification-and-reporting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4417" name="W4417. Subsequent Measurement — Depreciation, Interest &amp; Payment Unwind" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close cycle
Frequency: Monthly per lease
Volume: ~205+ on-balance-sheet leases × 12 months
Owner: Lease Accounting / Controller
Participants: Controller, Finance (VS-17.4), Treasury (VS-18), IT (VS-27), Audit (VS-21)
Source: workflow W4417 — Subsequent Measurement — Depreciation, Interest &amp; Payment Unwind</bpmn:documentation>
      <bpmn:laneSet id="W4417_LaneSet3">
        <bpmn:lane id="W4417_Lane1" name="Lease Accounting">
        <bpmn:flowNodeRef>W4417_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4417_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4417_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4417_Lane2" name="Controller">
        <bpmn:flowNodeRef>W4417_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4417_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4417_Start4" name="Monthly close cycle">
        <bpmn:outgoing>W4417_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W4417_Task5" name="Lease Accounting run the monthly engine — depreciation of ROU asset on…">
        <bpmn:documentation>Step 1: Lease Accounting run the monthly engine — depreciation of ROU asset on straight-line over lease term; interest on lease liability (effective-interest method at discount rate W4412); reduction of liability for lease payment
Responsible (R): Lease Accounting / System
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4417_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4417_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W4417_Task6" name="Lease Accounting post journals (DR depreciation / CR ROU; DR interest / CR…">
        <bpmn:documentation>Step 2: Lease Accounting post journals (DR depreciation / CR ROU; DR interest / CR liability; DR liability / CR cash/AP) to GL (VS-17) and reconcile to lease-accounting system &amp; AP/cash (VS-15/VS-18)
Responsible (R): Lease Accounting / Controller
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4417_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4417_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4417_Task7" name="Controller/Audit review the monthly P&amp;L split (depreciation + interest…">
        <bpmn:documentation>Step 3: Controller/Audit review the monthly P&amp;L split (depreciation + interest, replacing former straight-line rent expense — a key PFRS 16 EBITDA effect), and investigate variances
Responsible (R): Controller / Finance / Audit
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4417_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4417_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4417_End8" name="Complete">
        <bpmn:incoming>W4417_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4417_Annotation9">
        <bpmn:text>Controls: - CTL-675 (ensure controlled execution — ROU Asset &amp; Lease Liability Measurement, Modification &amp; Reporting (PA-148.2).) | - CTL-675: system-calculated depreciation/interest; reconciled to GL/AP/cash (W4425); variances investigated; reviewed monthly
Owner: Lease Accounting / Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4417_Assoc10" sourceRef="W4417_Annotation9" targetRef="W4417_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4417_Flow11" sourceRef="W4417_Start4" targetRef="W4417_Task5" />
      <bpmn:sequenceFlow id="W4417_Flow12" sourceRef="W4417_Task5" targetRef="W4417_Task6" />
      <bpmn:sequenceFlow id="W4417_Flow13" sourceRef="W4417_Task6" targetRef="W4417_Task7" />
      <bpmn:sequenceFlow id="W4417_Flow14" sourceRef="W4417_Task7" targetRef="W4417_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4417_diag">
      <bpmndi:BPMNPlane id="W4417_plane" bpmnElement="W_W4417">
        <bpmndi:BPMNShape id="W4417_Lane1_di" bpmnElement="W4417_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4417_Lane2_di" bpmnElement="W4417_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4417_Task5_di" bpmnElement="W4417_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4417_Task6_di" bpmnElement="W4417_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4417_Task7_di" bpmnElement="W4417_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
