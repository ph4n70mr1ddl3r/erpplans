      <bpmn:sequenceFlow id="W4410_Flow11" sourceRef="W4410_Task4" targetRef="W4410_Task5" />
      <bpmn:sequenceFlow id="W4410_Flow12" sourceRef="W4410_Task5" targetRef="W4410_Task6" />
      <bpmn:sequenceFlow id="W4410_Flow13" sourceRef="W4410_Task6" targetRef="W4410_End7" />
    </bpmn:process>
