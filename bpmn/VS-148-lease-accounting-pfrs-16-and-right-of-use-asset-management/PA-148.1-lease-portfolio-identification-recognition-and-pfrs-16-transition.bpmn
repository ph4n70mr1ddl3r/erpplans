        <bpmndi:BPMNEdge id="W4410_Assoc9_di" bpmnElement="W4410_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4411" name="W4411. Lease Contract Data Capture &amp; Abstracting (Terms, Payments, Options)" isExecutable="false">
      <bpmn:documentation>Trigger: New/identified lease (W4410); amendment
Frequency: Per lease + on amendment
Volume: ~205+ leases abstracted; amendments ongoing
Owner: Lease Accounting / Lease Admin (VS-42)
Participants: Lease Admin (VS-42), Legal (VS-100), Real Estate (VS-97/VS-20), Treasury (VS-18), Tax (VS-79)
Source: workflow W4411 — Lease Contract Data Capture &amp; Abstracting (Terms, Payments, Options)</bpmn:documentation>
      <bpmn:laneSet id="W4411_LaneSet3">
        <bpmn:lane id="W4411_Lane1" name="Lease Accounting">
        <bpmn:flowNodeRef>W4411_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4411_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4411_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4411_Lane2" name="Legal">
        <bpmn:flowNodeRef>W4411_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4411_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4411_Start4" name="New/identified lease (W4410); amendment">
        <bpmn:outgoing>W4411_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4411_Task5" name="Lease Accounting/Lease Admin abstract each contract — commencement/term/end…">
        <bpmn:documentation>Step 1: Lease Accounting/Lease Admin abstract each contract — commencement/term/end, renewal/termination options, fixed payments, escalation/index, variable (turnover/usage), incentives/rent-free, initial direct costs, restoration/MAKE-GOOD, PWD/senior discounts, options-to-purchase
Responsible (R): Lease Accounting / Lease Admin
Accountable (A): Controller
Duration: Per lease</bpmn:documentation>
        <bpmn:incoming>W4411_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4411_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4411_Task6" name="Legal/Lease Admin interpret ambiguous clauses (renewal certainty, termination…">
        <bpmn:documentation>Step 2: Legal/Lease Admin interpret ambiguous clauses (renewal certainty, termination penalty, CPI linkage, sublet consent), and confirm tax treatment (VAT/WHT, documentary stamp) with Tax
Responsible (R): Legal / Lease Accounting / Tax
Accountable (A): Controller / VP Legal
Duration: Per lease</bpmn:documentation>
        <bpmn:incoming>W4411_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4411_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4411_Task7" name="Lease Accounting enter the abstract into the lease-accounting repository…">
        <bpmn:documentation>Step 3: Lease Accounting enter the abstract into the lease-accounting repository (W4426) with source-document link, evidence the data-quality check, and route for review
Responsible (R): Lease Accounting
Accountable (A): Controller
Duration: Per lease</bpmn:documentation>
        <bpmn:incoming>W4411_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4411_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4411_End8" name="Complete">
        <bpmn:incoming>W4411_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4411_Annotation9">
        <bpmn:text>Controls: - CTL-674 (ensure controlled execution — Lease Portfolio Identification, Recognition &amp; PFRS 16 Transition (PA-148.1).) | - CTL-674: structured abstract with all PFRS 16 data points; legal interpretation of ambiguous clauses; dual review; source-document linked
Owner: Lease Accounting / Lease Admin (VS-42)</bpmn:text>
      </bpmn:textAnnotation>
