      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2385" name="W2385. Seasonal Pricing &amp; Promotion Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal promotional pricing activation
Frequency: 6/year; aligned with merchandising calendar
Volume: ~6 seasonal pricing events/year
Owner: Pricing Analyst
Participants: Pricing Analyst, Category Mgr, Marketing
Source: workflow W2385 — Seasonal Pricing &amp; Promotion Setup</bpmn:documentation>
      <bpmn:laneSet id="W2385_LaneSet2">
        <bpmn:lane id="W2385_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2385_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2385_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2385_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2385_Start3" name="Seasonal promotional pricing activation">
        <bpmn:outgoing>W2385_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2385_Task4" name="Pricing Analyst sets seasonal pricing: launch price (may include early-bird…">
        <bpmn:documentation>Step 1: Pricing Analyst sets seasonal pricing: launch price (may include early-bird promo), regular price, planned markdown triggers (based on sell-through rate); configures in ERP per VS-57
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1–2 days/season</bpmn:documentation>
        <bpmn:incoming>W2385_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2385_End5" name="Complete">
        <bpmn:incoming>W2385_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2385_Annotation6">
        <bpmn:text>Controls: - CTL-421 (ensure controlled execution — Seasonal Planning &amp; Phase-In Management (PA-64.1).) | - CTL-421 (price/promo accuracy — links to VS-08 / W69 price-compliance audit); operational: Category Manager sign-off on the seasonal pricing plan
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2385_Assoc7" sourceRef="W2385_Annotation6" targetRef="W2385_Start3" associationDirection="None" />
