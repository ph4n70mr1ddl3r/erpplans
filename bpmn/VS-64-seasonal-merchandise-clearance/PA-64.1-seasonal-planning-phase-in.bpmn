      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2383" name="W2383. Seasonal Inventory Positioning at DCs" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal inventory arriving at DCs
Frequency: Pre-season; 6 cycles/year
Volume: ~4 DCs receiving seasonal inventory
Owner: DC Operations Manager
Participants: DC Ops Mgr, Merch Planner, Logistics Mgr
Source: workflow W2383 — Seasonal Inventory Positioning at DCs</bpmn:documentation>
      <bpmn:laneSet id="W2383_LaneSet2">
        <bpmn:lane id="W2383_Lane1" name="Merch Planner">
        <bpmn:flowNodeRef>W2383_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2383_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2383_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2383_Start3" name="Seasonal inventory arriving at DCs">
        <bpmn:outgoing>W2383_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2383_Task4" name="Merch Planner provides DC with seasonal allocation plan: quantity per SKU per…">
        <bpmn:documentation>Step 1: Merch Planner provides DC with seasonal allocation plan: quantity per SKU per store group; DC receives seasonal inventory; stages for store allocation; schedules outbound shipments aligned with store display readiness
Responsible (R): Merch Planner / DC Ops Mgr
Accountable (A): VP Supply Chain
Duration: 1–2 weeks/season</bpmn:documentation>
        <bpmn:incoming>W2383_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2383_End5" name="Complete">
        <bpmn:incoming>W2383_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2383_Annotation6">
        <bpmn:text>Controls: - CTL-21: seasonal inventory tracked separately to prevent commingling with sellable stock; operational: DC Ops Manager staging-plan sign-off
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2383_Assoc7" sourceRef="W2383_Annotation6" targetRef="W2383_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2383_Flow8" sourceRef="W2383_Start3" targetRef="W2383_Task4" />
      <bpmn:sequenceFlow id="W2383_Flow9" sourceRef="W2383_Task4" targetRef="W2383_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2383_diag">
      <bpmndi:BPMNPlane id="W2383_plane" bpmnElement="W_W2383">
        <bpmndi:BPMNShape id="W2383_Lane1_di" bpmnElement="W2383_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
