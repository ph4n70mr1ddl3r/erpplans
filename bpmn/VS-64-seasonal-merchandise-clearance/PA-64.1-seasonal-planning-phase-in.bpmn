<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-64.1-seasonal-planning-phase-in" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2382" name="W2382. Seasonal Assortment Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-season planning (3 months before season)
Frequency: 6 seasons/year; 13 categories reviewed
Volume: ~6 seasonal assortment plans/year
Owner: Category Manager
Participants: Category Mgr, Merch Planner, Buyer, VP Merchandising
Source: workflow W2382 — Seasonal Assortment Planning</bpmn:documentation>
      <bpmn:laneSet id="W2382_LaneSet3">
        <bpmn:lane id="W2382_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2382_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2382_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2382_Lane2" name="Merch Planner">
        <bpmn:flowNodeRef>W2382_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2382_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2382_Start4" name="Pre-season planning (3 months before season)">
        <bpmn:outgoing>W2382_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2382_Task5" name="Category Manager identifies seasonal opportunities per Philippine calendar…">
        <bpmn:documentation>Step 1: Category Manager identifies seasonal opportunities per Philippine calendar: summer (garden, aircon, outdoor), rainy (waterproofing, flood control), ber-months (holiday décor, gifts, appliances); selects seasonal SKUs
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2382_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2382_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2382_Task6" name="Merch Planner determines store-level assortment by format…">
        <bpmn:documentation>Step 2: Merch Planner determines store-level assortment by format (flagship/standard/compact); Buyer places seasonal POs with vendors; confirms delivery timeline 6–8 weeks before season start
Responsible (R): Merch Planner / Buyer
Accountable (A): Category Manager
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2382_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2382_End7" name="Complete">
        <bpmn:incoming>W2382_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2382_Annotation8">
        <bpmn:text>Controls: - CTL-39: rebate/co-op terms on seasonal POs validated; operational: VP Merchandising sign-off on the seasonal assortment plan
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2382_Assoc9" sourceRef="W2382_Annotation8" targetRef="W2382_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2382_Flow10" sourceRef="W2382_Start4" targetRef="W2382_Task5" />
      <bpmn:sequenceFlow id="W2382_Flow11" sourceRef="W2382_Task5" targetRef="W2382_Task6" />
      <bpmn:sequenceFlow id="W2382_Flow12" sourceRef="W2382_Task6" targetRef="W2382_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2382_diag">
      <bpmndi:BPMNPlane id="W2382_plane" bpmnElement="W_W2382">
        <bpmndi:BPMNShape id="W2382_Lane1_di" bpmnElement="W2382_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
