    <bpmn:process id="W_W2387" name="W2387. Seasonal Launch Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: First 2 weeks of seasonal selling
Frequency: 6/year; first 2 weeks of each season
Volume: 200 stores × 6 seasons
Owner: Merchandising Planner
Participants: Merch Planner, Category Mgr, Analytics Manager
Source: workflow W2387 — Seasonal Launch Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2387_LaneSet2">
        <bpmn:lane id="W2387_Lane1" name="System">
        <bpmn:flowNodeRef>W2387_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2387_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2387_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2387_Start3" name="First 2 weeks of seasonal selling">
        <bpmn:outgoing>W2387_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2387_Task4" name="System monitors daily sell-through: compares vs. plan; identifies slow starters…">
        <bpmn:documentation>Step 1: System monitors daily sell-through: compares vs. plan; identifies slow starters (may need markdown acceleration) and fast sellers (may need reorder); daily flash report to Category Manager
Responsible (R): System / Merch Planner
Accountable (A): Category Manager
Duration: 30 min/day during launch</bpmn:documentation>
        <bpmn:incoming>W2387_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2387_End5" name="Complete">
        <bpmn:incoming>W2387_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2387_Annotation6">
        <bpmn:text>Controls: - CTL-421 (ensure controlled execution — Seasonal Planning &amp; Phase-In Management (PA-64.1).) | - Operational: Category Manager daily-flash review sign-off during the launch window
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
