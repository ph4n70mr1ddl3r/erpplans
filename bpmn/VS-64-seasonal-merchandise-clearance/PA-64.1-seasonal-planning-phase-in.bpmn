    <bpmn:process id="W_W2388" name="W2388. Seasonal Vendor Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-season vendor alignment
Frequency: 6/year; ~50–100 seasonal vendors
Volume: ~50–100 vendors/season
Owner: Buyer
Participants: Buyer, Category Mgr, Vendor
Source: workflow W2388 — Seasonal Vendor Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2388_LaneSet2">
        <bpmn:lane id="W2388_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W2388_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2388_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2388_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2388_Start3" name="Pre-season vendor alignment">
        <bpmn:outgoing>W2388_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2388_Task4" name="Buyer confirms with vendors: delivery dates, quantities, quality standards…">
        <bpmn:documentation>Step 1: Buyer confirms with vendors: delivery dates, quantities, quality standards, marketing support (co-op funds), markdown support (return/swap agreements for unsold seasonal inventory)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1–2 weeks/season</bpmn:documentation>
        <bpmn:incoming>W2388_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2388_End5" name="Complete">
        <bpmn:incoming>W2388_Flow9</bpmn:incoming>
      </bpmn:endEvent>
