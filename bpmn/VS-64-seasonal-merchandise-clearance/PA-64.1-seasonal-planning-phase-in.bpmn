        <bpmn:lane id="W2389_Lane1" name="Merchandising Planner">
        <bpmn:flowNodeRef>W2389_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2389_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2389_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2389_Start3" name="Transition between seasons">
