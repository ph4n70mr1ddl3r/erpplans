      <bpmn:documentation>Trigger: Pre-season staff training
Frequency: 6/year; 200 stores × ~29 staff
Volume: ~5,800 staff training events/year
Owner: HR Training Manager
Participants: HR Training Mgr, Category Mgr, Store Managers
Source: workflow W2386 — Seasonal Staff Training &amp; Product Knowledge</bpmn:documentation>
      <bpmn:laneSet id="W2386_LaneSet2">
        <bpmn:lane id="W2386_Lane1" name="Category Mgr">
        <bpmn:flowNodeRef>W2386_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2386_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2386_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2386_Start3" name="Pre-season staff training">
        <bpmn:outgoing>W2386_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2386_Task4" name="Category Manager provides product knowledge materials: new seasonal products…">
        <bpmn:documentation>Step 1: Category Manager provides product knowledge materials: new seasonal products, features, selling points, FAQs; HR Training distributes via e-learning platform and store meeting guides
Responsible (R): Category Mgr / HR Training Manager
Accountable (A): CHRO
Duration: 1 week/season</bpmn:documentation>
        <bpmn:incoming>W2386_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2386_End5" name="Complete">
