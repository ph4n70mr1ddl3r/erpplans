    <bpmn:process id="W_W2389" name="W2389. Multi-Season Inventory Transition Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Transition between seasons
Frequency: 6/year; overlap period ~2–3 weeks
Volume: ~2–3 week transition per season
Owner: Merchandising Planner
Participants: Merch Planner, Category Mgr, DC Ops, Store Ops
Source: workflow W2389 — Multi-Season Inventory Transition Planning</bpmn:documentation>
