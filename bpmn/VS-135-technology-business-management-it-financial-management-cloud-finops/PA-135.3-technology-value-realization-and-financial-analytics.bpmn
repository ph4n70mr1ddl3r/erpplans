Responsible (R): FinOps Lead / Procurement
Accountable (A): CIO / CFO
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W4115_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4115_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4115_Task6" name="FinOps Lead report vendor financial performance and savings (W4113) to…">
