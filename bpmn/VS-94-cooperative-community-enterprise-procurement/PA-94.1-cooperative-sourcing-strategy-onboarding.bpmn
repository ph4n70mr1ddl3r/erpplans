    <bpmn:process id="W_W3114" name="W3114. Cooperative &amp; Social Enterprise Identification &amp; Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy defines a category gap; coop fair/trade mission; government livelihood program referral
Frequency: Continuous
Volume: ~30–80 candidates screened/year; ~10–25 onboarded
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, CDA-accredited Coop Dev&#x27;t Specialist, Quality, Legal, Finance, Sustainability Lead
Source: workflow W3114 — Cooperative &amp; Social Enterprise Identification &amp; Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W3114_LaneSet4">
        <bpmn:lane id="W3114_Lane1" name="Sustainability Sourcing Manager">
        <bpmn:flowNodeRef>W3114_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3114_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3114_Lane2" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3114_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3114_Lane3" name="Quality">
        <bpmn:flowNodeRef>W3114_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3114_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3114_Start5" name="Strategy defines a category gap; coop fair/trade mission; government livelihood program…">
        <bpmn:outgoing>W3114_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3114_Task6" name="Sources of candidates: CDA registry, DTI-BMED, DSWD-SLP/DOLE livelihood…">
        <bpmn:documentation>Step 1: Sources of candidates: CDA registry, DTI-BMED, DSWD-SLP/DOLE livelihood graduates, WFTO/local fair-trade rosters, social-enterprise incubators, indigenous peoples&#x27; councils (NCIP), trade missions; referral from VS-25 partners
Responsible (R): Sustainability Sourcing Manager
Accountable (A): Sustainability Sourcing Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3114_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3114_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3114_Task7" name="Sustainability Sourcing Mgr performs due diligence: legal status (CDA coop…">
        <bpmn:documentation>Step 2: Sustainability Sourcing Mgr performs due diligence: legal status (CDA coop registration / SEC social-enterprise / DTI business name), governance, financial viability, production capacity, labor standards (no child/forced labor — links to VS-86), environmental practices, references; documents as vendor master record distinct from VS-03 mainstream
Responsible (R): Sustainability Sourcing Mgr / Legal / Quality
Accountable (A): Sustainability Sourcing Manager
Duration: Per candidate (3–5 days)</bpmn:documentation>
        <bpmn:incoming>W3114_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3114_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3114_Task8" name="Quality/Sustainability validate product fit: sample evaluation, raw-material…">
        <bpmn:documentation>Step 3: Quality/Sustainability validate product fit: sample evaluation, raw-material provenance (links to VS-71 anti-counterfeit where relevant), compliance with product safety (links to VS-31/VS-89), and social impact baseline (members, wages, communities); recommend proceed/defer/decline
Responsible (R): Quality / Sustainability Lead
Accountable (A): Sustainability Sourcing Manager
Duration: Per candidate</bpmn:documentation>
        <bpmn:incoming>W3114_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3114_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3114_End9" name="Complete">
        <bpmn:incoming>W3114_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3114_Annotation10">
        <bpmn:text>Controls: - CTL-511 (ensure controlled execution — Cooperative &amp; Social Enterprise Sourcing Strategy &amp; Onboarding (PA-94.1).) | - operational: on-site visit, member rosters, and CDA/NCIP verification
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3114_Assoc11" sourceRef="W3114_Annotation10" targetRef="W3114_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3114_Flow12" sourceRef="W3114_Start5" targetRef="W3114_Task6" />
      <bpmn:sequenceFlow id="W3114_Flow13" sourceRef="W3114_Task6" targetRef="W3114_Task7" />
      <bpmn:sequenceFlow id="W3114_Flow14" sourceRef="W3114_Task7" targetRef="W3114_Task8" />
      <bpmn:sequenceFlow id="W3114_Flow15" sourceRef="W3114_Task8" targetRef="W3114_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3114_diag">
      <bpmndi:BPMNPlane id="W3114_plane" bpmnElement="W_W3114">
