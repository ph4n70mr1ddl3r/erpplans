    <bpmn:process id="W_W3120" name="W3120. Cooperative Offboarding, Exit &amp; Transition" isExecutable="false">
      <bpmn:documentation>Trigger: Coop non-performance; capacity exhaustion; category exit; coop graduates to mainstream vendor
Frequency: Event-driven
Volume: Per coop
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Category, Finance, Legal, Quality, Coop Representatives
Source: workflow W3120 — Cooperative Offboarding, Exit &amp; Transition</bpmn:documentation>
      <bpmn:laneSet id="W3120_LaneSet4">
        <bpmn:lane id="W3120_Lane1" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3120_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3120_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3120_Lane2" name="Category">
        <bpmn:flowNodeRef>W3120_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3120_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3120_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3120_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3120_Start5" name="Coop non-performance; capacity exhaustion; category exit; coop graduates to mainstream…">
        <bpmn:outgoing>W3120_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3120_Task6" name="Sustainability Sourcing Mgr documents exit rationale (performance, capacity…">
        <bpmn:documentation>Step 1: Sustainability Sourcing Mgr documents exit rationale (performance, capacity, strategic); for under-performance, provides cure period and improvement plan before termination (fair-trade duty of care)
Responsible (R): Sustainability Sourcing Mgr
Accountable (A): VP Merchandising
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3120_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3120_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3120_Task7" name="Category/Planning identify replacement source (another coop, mainstream vendor…">
        <bpmn:documentation>Step 2: Category/Planning identify replacement source (another coop, mainstream vendor — links to VS-03, or private label — links to VS-41); transition inventory and PO commitments without stranding coop (honour open POs)
Responsible (R): Category / Planning
Accountable (A): VP Merchandising
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3120_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3120_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3120_Task8" name="Legal terminates contract per terms; Finance settles final dues; Sustainability…">
        <bpmn:documentation>Step 3: Legal terminates contract per terms; Finance settles final dues; Sustainability Lead supports transition (graduation to mainstream, alternative buyers, or wind-down with dignity); record impact outcomes for posterity
Responsible (R): Legal / Finance / Sustainability Lead
Accountable (A): VP Legal &amp; Compliance
Duration: Per exit</bpmn:documentation>
        <bpmn:incoming>W3120_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3120_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3120_End9" name="Complete">
        <bpmn:incoming>W3120_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3120_Annotation10">
        <bpmn:text>Controls: - CTL-511 (ensure controlled execution — Cooperative &amp; Social Enterprise Sourcing Strategy &amp; Onboarding (PA-94.1).) | - operational: responsible-exit policy gate — cure-period log, transition-support plan, and exit sign-off before any termination
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
