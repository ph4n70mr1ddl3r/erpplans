    <bpmn:process id="W_W3113" name="W3113. Cooperative Sourcing Strategy &amp; Category Coverage Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual category strategy; ESG/social-impact target setting (links to VS-25); new community-partnership opportunity
Frequency: Annual + event-driven
Volume: ~5–10 candidate categories; ~30–80 potential coop suppliers
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Category Mgmt (links to VS-01), Sustainability Lead (links to VS-25), Legal, Finance
Source: workflow W3113 — Cooperative Sourcing Strategy &amp; Category Coverage Planning</bpmn:documentation>
      <bpmn:laneSet id="W3113_LaneSet4">
        <bpmn:lane id="W3113_Lane1" name="Sustainability Sourcing Manager">
        <bpmn:flowNodeRef>W3113_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3113_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3113_Lane2" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3113_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3113_Lane3" name="VP Merchandising">
        <bpmn:flowNodeRef>W3113_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3113_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3113_Start5" name="Annual category strategy; ESG/social-impact target setting (links to VS-25); new…">
        <bpmn:outgoing>W3113_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3113_Task6" name="Sustainability Sourcing Manager + Category (links to VS-01) scan assortment for…">
        <bpmn:documentation>Step 1: Sustainability Sourcing Manager + Category (links to VS-01) scan assortment for categories where coops/social-enterprises are competitive and impactful: garden/plants, home décor/furniture, handcrafted hardware, baskets/packaging, indigenous materials; size addressable spend and impact
Responsible (R): Sustainability Sourcing Manager
Accountable (A): VP Merchandising
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3113_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3113_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3113_Task7" name="Set category-by-category coop-sourcing targets (% of category buy), fair-trade…">
        <bpmn:documentation>Step 2: Set category-by-category coop-sourcing targets (% of category buy), fair-trade posture, and impact KPIs (livelihoods supported, beneficiaries, fair-wage premium); align to ESG roadmap (links to VS-25)
Responsible (R): Sustainability Sourcing Mgr / Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3113_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3113_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3113_Task8" name="Steering committee approves strategy and budget (capacity-building fund…">
        <bpmn:documentation>Step 3: Steering committee approves strategy and budget (capacity-building fund, advance-financing facility); publish to Category plans and integrate to S&amp;OP demand signal (links to VS-02)
Responsible (R): VP Merchandising / CFO
Accountable (A): CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W3113_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3113_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3113_End9" name="Complete">
        <bpmn:incoming>W3113_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3113_Annotation10">
        <bpmn:text>Controls: - CTL-511 (ensure controlled execution — Cooperative &amp; Social Enterprise Sourcing Strategy &amp; Onboarding (PA-94.1).) | - operational: traceable impact KPIs and third-party certification (W3130)
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3113_Assoc11" sourceRef="W3113_Annotation10" targetRef="W3113_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3113_Flow12" sourceRef="W3113_Start5" targetRef="W3113_Task6" />
      <bpmn:sequenceFlow id="W3113_Flow13" sourceRef="W3113_Task6" targetRef="W3113_Task7" />
      <bpmn:sequenceFlow id="W3113_Flow14" sourceRef="W3113_Task7" targetRef="W3113_Task8" />
      <bpmn:sequenceFlow id="W3113_Flow15" sourceRef="W3113_Task8" targetRef="W3113_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3113_diag">
      <bpmndi:BPMNPlane id="W3113_plane" bpmnElement="W_W3113">
