        <bpmn:flowNodeRef>W3117_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3117_Start5" name="Capability gap; demand growth; livelihood-program grant">
        <bpmn:outgoing>W3117_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3117_Task6" name="Capacity-Building Partner (NGO, government livelihood officer, technical…">
        <bpmn:documentation>Step 1: Capacity-Building Partner (NGO, government livelihood officer, technical trainer) delivers targeted programs: production technique, quality/standardization, packaging/labeling, business/financial literacy, digital tools; co-funded by BuildRight capacity fund or government livelihood grant
Responsible (R): Capacity-Building Partner
Accountable (A): Sustainability Sourcing Manager
Duration: Per program (4–12 weeks)</bpmn:documentation>
        <bpmn:incoming>W3117_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3117_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3117_Task7" name="Sustainability Sourcing Mgr aligns BuildRight demand plan (links to VS-02) to…">
        <bpmn:documentation>Step 2: Sustainability Sourcing Mgr aligns BuildRight demand plan (links to VS-02) to coop production capacity and harvest/seasonal cycle (W3123); plans production in batches that fit coop labor and lead time
Responsible (R): Sustainability Sourcing Mgr
Accountable (A): VP Merchandising
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3117_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3117_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3117_Task8" name="Coop Representatives confirm capacity, accept production plan, and report…">
        <bpmn:documentation>Step 3: Coop Representatives confirm capacity, accept production plan, and report progress; Quality provides feedback loop to continuously lift capability; graduate coops to larger commitments (links to W3133)
Responsible (R): Coop Representatives / Quality
Accountable (A): Sustainability Sourcing Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3117_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3117_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3117_End9" name="Complete">
        <bpmn:incoming>W3117_Flow15</bpmn:incoming>
      </bpmn:endEvent>
