      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3115" name="W3115. Cooperative Onboarding, Capability Assessment &amp; Certification" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate passes due diligence
Frequency: Per onboarding (~10–25/year)
Volume: Per coop
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Quality, Capacity-Building Partner, Finance, IT, Coop Representatives
Source: workflow W3115 — Cooperative Onboarding, Capability Assessment &amp; Certification</bpmn:documentation>
      <bpmn:laneSet id="W3115_LaneSet3">
        <bpmn:lane id="W3115_Lane1" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3115_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3115_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3115_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3115_Lane2" name="Quality">
        <bpmn:flowNodeRef>W3115_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3115_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3115_Start4" name="Candidate passes due diligence">
        <bpmn:outgoing>W3115_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3115_Task5" name="Sustainability Sourcing Mgr onboards coop into vendor master with extended…">
        <bpmn:documentation>Step 1: Sustainability Sourcing Mgr onboards coop into vendor master with extended attributes: coop name, CDA registration #, member count, beneficiary community, governance, bank account for direct-to-beneficiary settlement, certification status; integrates to VS-03 vendor portal if applicable
Responsible (R): Sustainability Sourcing Mgr / IT
Accountable (A): Sustainability Sourcing Manager
Duration: Per onboarding (2–3 days)</bpmn:documentation>
        <bpmn:incoming>W3115_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3115_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3115_Task6" name="Quality/ Capacity-Building Partner conduct capability assessment against…">
        <bpmn:documentation>Step 2: Quality/ Capacity-Building Partner conduct capability assessment against BuildRight product specification: production capacity (units/week), lead time, quality consistency, packaging/labeling ability, traceability, and gap list
Responsible (R): Quality / Capacity-Building Partner
Accountable (A): Sustainability Sourcing Manager
Duration: Per onboarding (1–2 weeks)</bpmn:documentation>
        <bpmn:incoming>W3115_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3115_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3115_Task7" name="Sustainability Sourcing Mgr plans certification path: target…">
        <bpmn:documentation>Step 3: Sustainability Sourcing Mgr plans certification path: target fair-trade/social-enterprise certifications (WFTO, local fair-trade, Go Lokal!, DTI-BMED), product-safety marks (PS/ICC, FDA-LTO where applicable — links to VS-22/VS-31); set timeline
Responsible (R): Sustainability Sourcing Mgr / Regulatory
Accountable (A): Sustainability Sourcing Manager
Duration: Per onboarding</bpmn:documentation>
        <bpmn:incoming>W3115_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3115_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3115_End8" name="Complete">
        <bpmn:incoming>W3115_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3115_Annotation9">
        <bpmn:text>Controls: - CTL-68 (ensure cooperative vendor qualification &amp; settlement integrity.) | - operational: capacity-building (W3117) and pilot-first sourcing
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3115_Assoc10" sourceRef="W3115_Annotation9" targetRef="W3115_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3115_Flow11" sourceRef="W3115_Start4" targetRef="W3115_Task5" />
      <bpmn:sequenceFlow id="W3115_Flow12" sourceRef="W3115_Task5" targetRef="W3115_Task6" />
      <bpmn:sequenceFlow id="W3115_Flow13" sourceRef="W3115_Task6" targetRef="W3115_Task7" />
      <bpmn:sequenceFlow id="W3115_Flow14" sourceRef="W3115_Task7" targetRef="W3115_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3115_diag">
      <bpmndi:BPMNPlane id="W3115_plane" bpmnElement="W_W3115">
        <bpmndi:BPMNShape id="W3115_Lane1_di" bpmnElement="W3115_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Lane2_di" bpmnElement="W3115_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Task5_di" bpmnElement="W3115_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Task6_di" bpmnElement="W3115_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Task7_di" bpmnElement="W3115_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Start4_di" bpmnElement="W3115_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_End8_di" bpmnElement="W3115_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3115_Annotation9_di" bpmnElement="W3115_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3115_Flow11_di" bpmnElement="W3115_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3115_Flow12_di" bpmnElement="W3115_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3115_Flow13_di" bpmnElement="W3115_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3115_Flow14_di" bpmnElement="W3115_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3115_Assoc10_di" bpmnElement="W3115_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3116" name="W3116. Cooperative Pricing, Fair-Trade Terms &amp; Contract Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Pre-contract; renewal; cost-change
Frequency: Per contract + event-driven
Volume: Per coop-contract
Owner: Sustainability Sourcing Manager
Participants: Sustainability Sourcing Mgr, Category (links to VS-01), Legal, Finance, Coop Representatives
Source: workflow W3116 — Cooperative Pricing, Fair-Trade Terms &amp; Contract Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W3116_LaneSet4">
        <bpmn:lane id="W3116_Lane1" name="Sustainability Sourcing Mgr">
        <bpmn:flowNodeRef>W3116_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3116_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3116_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W3116_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3116_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3116_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3116_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3116_Start5" name="Pre-contract; renewal; cost-change">
        <bpmn:outgoing>W3116_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3116_Task6" name="Sustainability Sourcing Mgr/Category determine fair-trade price…">
        <bpmn:documentation>Step 1: Sustainability Sourcing Mgr/Category determine fair-trade price: cost-of-sustainable-production + living-wage labor cost + fair margin (not least-cost); benchmark vs. mainstream (links to VS-01) and fair-trade floors; document fair-wage premium vs. prevailing
Responsible (R): Sustainability Sourcing Mgr / Category
Accountable (A): VP Merchandising
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3116_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3116_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3116_Task7" name="Legal/Sustainability negotiate contract: price, volume commitment (minimum…">
        <bpmn:documentation>Step 2: Legal/Sustainability negotiate contract: price, volume commitment (minimum offtake to support coop planning), payment terms (favorable — e.g., 50% advance, balance on delivery), exclusivity/IP (indigenous designs — links to IPRA W3134), tenure, impact-reporting obligations, audit rights
Responsible (R): Legal Counsel / Sustainability Sourcing Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3116_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3116_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3116_Task8" name="Sustainability Sourcing Mgr/Finance set up direct-to-coop-account /…">
        <bpmn:documentation>Step 3: Sustainability Sourcing Mgr/Finance set up direct-to-coop-account / direct-to-beneficiary settlement (links to W3126) and advance-financing facility (links to W3127); record contract and pricing in master data (links to VS-29)
Responsible (R): Finance Analyst / IT
Accountable (A): Sustainability Sourcing Manager
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3116_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3116_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3116_End9" name="Complete">
        <bpmn:incoming>W3116_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3116_Annotation10">
        <bpmn:text>Controls: - CTL-511 (ensure controlled execution — Cooperative &amp; Social Enterprise Sourcing Strategy &amp; Onboarding (PA-94.1).) | - operational: living-wage pricing methodology and documented premium
Owner: Sustainability Sourcing Manager</bpmn:text>
      </bpmn:textAnnotation>
