    <bpmn:process id="W_W3136" name="W3136. Cooperative Program Performance &amp; ROI Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly/annual program review; strategy refinement
Frequency: Quarterly + annual
Volume: Program-wide
Owner: Sustainability Lead
Participants: Sustainability Lead, Finance, BI (links to VS-28), Sustainability Sourcing Mgr, Category (links to VS-01)
Source: workflow W3136 — Cooperative Program Performance &amp; ROI Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3136_LaneSet4">
        <bpmn:lane id="W3136_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W3136_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3136_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3136_Lane2" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3136_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3136_Lane3" name="Sustainability">
        <bpmn:flowNodeRef>W3136_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3136_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3136_Start5" name="Quarterly/annual program review; strategy refinement">
        <bpmn:outgoing>W3136_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3136_Task6" name="BI/Finance (links to VS-28) compute program economics: total coop spend…">
        <bpmn:documentation>Step 1: BI/Finance (links to VS-28) compute program economics: total coop spend, fair-wage premium, capacity-building investment, advance-financing cost, defect/return cost, vs. mainstream baseline; compute cost-per-impact (livelihood, beneficiary)
Responsible (R): BI Analyst / Finance
Accountable (A): Sustainability Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3136_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3136_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3136_Task7" name="Sustainability Lead/Category measure commercial outcomes: sell-through, margin…">
        <bpmn:documentation>Step 2: Sustainability Lead/Category measure commercial outcomes: sell-through, margin, customer preference for fair-trade, brand-equity lift (links to VS-14/VS-44); compare vs. mainstream equivalent SKUs
Responsible (R): Sustainability Lead / Category
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3136_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3136_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3136_Task8" name="Steering committee reviews ROI and impact; rebalances portfolio (add/exit coops…">
        <bpmn:documentation>Step 3: Steering committee reviews ROI and impact; rebalances portfolio (add/exit coops — W3114/W3120), adjusts capacity-building allocation, refines strategy (W3113); reports to Board/ESG committee
Responsible (R): Sustainability/ESG Manager / VP Merchandising
Accountable (A): CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3136_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3136_End9" name="Complete">
        <bpmn:incoming>W3136_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3136_Annotation10">
        <bpmn:text>Controls: - CTL-513 (ensure controlled execution — Impact Measurement, Fair-Trade Compliance &amp; Development Program (PA-94.3).) | - operational: balanced scorecard and willingness-to-pay research (links to VS-44)
Owner: Sustainability Lead</bpmn:text>
      </bpmn:textAnnotation>
