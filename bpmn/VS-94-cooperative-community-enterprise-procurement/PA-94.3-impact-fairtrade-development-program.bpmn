<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-94.3-impact-fairtrade-development-program" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3129" name="W3129. Social Impact Measurement &amp; Beneficiary Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly impact cycle; coop onboarding; program milestone
Frequency: Quarterly + event-driven
Volume: All active coop suppliers and beneficiaries
Owner: Sustainability Lead
Participants: Sustainability Lead, Sustainability Sourcing Mgr, Coop Representatives, Impact Analyst
Source: workflow W3129 — Social Impact Measurement &amp; Beneficiary Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3129_LaneSet3">
        <bpmn:lane id="W3129_Lane1" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3129_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3129_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3129_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3129_Lane2" name="Impact Analyst">
        <bpmn:flowNodeRef>W3129_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3129_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3129_Start4" name="Quarterly impact cycle; coop onboarding; program milestone">
        <bpmn:outgoing>W3129_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3129_Task5" name="Sustainability Lead defines impact KPIs aligned to recognized frameworks (GRI…">
        <bpmn:documentation>Step 1: Sustainability Lead defines impact KPIs aligned to recognized frameworks (GRI, IRIS+, SDGs): livelihoods supported, direct beneficiaries (coop members + dependents), fair-wage premium paid vs. prevailing, training hours delivered, community projects co-funded
Responsible (R): Sustainability Lead / Impact Analyst
Accountable (A): Sustainability/ESG Manager
Duration: Annual design</bpmn:documentation>
        <bpmn:incoming>W3129_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3129_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3129_Task6" name="Impact Analyst collects verified data per coop: member roster, wage/earnings…">
        <bpmn:documentation>Step 2: Impact Analyst collects verified data per coop: member roster, wage/earnings uplift (baseline vs. current), training completion, infrastructure/equipment invested; reconcile to BuildRight payments (W3126) and capacity programs (W3117)
Responsible (R): Impact Analyst / Coop
Accountable (A): Sustainability Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3129_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3129_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3129_Task7" name="Sustainability Lead publishes impact scorecard into BuildRight ESG system…">
        <bpmn:documentation>Step 3: Sustainability Lead publishes impact scorecard into BuildRight ESG system (links to VS-25); auditable evidence retained (records — links to VS-88); feeds external reporting (W3130, W3132)
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3129_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3129_End8" name="Complete">
        <bpmn:incoming>W3129_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3129_Annotation9">
        <bpmn:text>Controls: - CTL-513 (ensure controlled execution — Impact Measurement, Fair-Trade Compliance &amp; Development Program (PA-94.3).) | - operational: triangulation, sampling audit, and third-party verification (W3130)
Owner: Sustainability Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3129_Assoc10" sourceRef="W3129_Annotation9" targetRef="W3129_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3129_Flow11" sourceRef="W3129_Start4" targetRef="W3129_Task5" />
      <bpmn:sequenceFlow id="W3129_Flow12" sourceRef="W3129_Task5" targetRef="W3129_Task6" />
      <bpmn:sequenceFlow id="W3129_Flow13" sourceRef="W3129_Task6" targetRef="W3129_Task7" />
      <bpmn:sequenceFlow id="W3129_Flow14" sourceRef="W3129_Task7" targetRef="W3129_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3129_diag">
      <bpmndi:BPMNPlane id="W3129_plane" bpmnElement="W_W3129">
        <bpmndi:BPMNShape id="W3129_Lane1_di" bpmnElement="W3129_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3129_Lane2_di" bpmnElement="W3129_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
