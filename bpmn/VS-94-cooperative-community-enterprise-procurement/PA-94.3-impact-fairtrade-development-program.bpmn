        <bpmndi:BPMNEdge id="W3130_Flow14_di" bpmnElement="W3130_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3130_Assoc10_di" bpmnElement="W3130_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3131" name="W3131. Cooperative Income &amp; Livelihood Outcome Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Annual livelihood-outcome cycle; government-partner reporting (W3119)
Frequency: Annual + per-program
Volume: All coop beneficiaries
Owner: Sustainability Lead
Participants: Sustainability Lead, Impact Analyst, Coop Representatives, Government Partners
Source: workflow W3131 — Cooperative Income &amp; Livelihood Outcome Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3131_LaneSet3">
        <bpmn:lane id="W3131_Lane1" name="Impact Analyst">
        <bpmn:flowNodeRef>W3131_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3131_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3131_Lane2" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3131_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3131_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3131_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3131_Start4" name="Annual livelihood-outcome cycle; government-partner reporting (W3119)">
        <bpmn:outgoing>W3131_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3131_Task5" name="Impact Analyst measures livelihood outcomes per coop: household income uplift…">
        <bpmn:documentation>Step 1: Impact Analyst measures livelihood outcomes per coop: household income uplift, poverty-line graduation, employment created (full-time/equivalent), women/youth/indigenous representation, asset accumulation
Responsible (R): Impact Analyst
Accountable (A): Sustainability Lead
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3131_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3131_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3131_Task6" name="Sustainability Lead reports to government livelihood partners (DSWD-SLP, DOLE…">
        <bpmn:documentation>Step 2: Sustainability Lead reports to government livelihood partners (DSWD-SLP, DOLE, DTI-BMED — links to W3119) per MOA; complies with partner data standards; supports program renewal
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3131_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3131_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3131_Task7" name="Sustainability Lead publishes anonymized aggregate outcomes in BuildRight ESG…">
        <bpmn:documentation>Step 3: Sustainability Lead publishes anonymized aggregate outcomes in BuildRight ESG report (links to VS-25) and annual report; informs strategy refinement (W3113) and capacity-building (W3117)
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3131_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3131_End8" name="Complete">
        <bpmn:incoming>W3131_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3131_Annotation9">
        <bpmn:text>Controls: - CTL-513 (ensure controlled execution — Impact Measurement, Fair-Trade Compliance &amp; Development Program (PA-94.3).) | - operational: conservative attribution and baseline-control methodology
Owner: Sustainability Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3131_Assoc10" sourceRef="W3131_Annotation9" targetRef="W3131_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3131_Flow11" sourceRef="W3131_Start4" targetRef="W3131_Task5" />
      <bpmn:sequenceFlow id="W3131_Flow12" sourceRef="W3131_Task5" targetRef="W3131_Task6" />
      <bpmn:sequenceFlow id="W3131_Flow13" sourceRef="W3131_Task6" targetRef="W3131_Task7" />
      <bpmn:sequenceFlow id="W3131_Flow14" sourceRef="W3131_Task7" targetRef="W3131_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3131_diag">
      <bpmndi:BPMNPlane id="W3131_plane" bpmnElement="W_W3131">
        <bpmndi:BPMNShape id="W3131_Lane1_di" bpmnElement="W3131_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3131_Lane2_di" bpmnElement="W3131_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
