    <bpmn:process id="W_W3132" name="W3132. ESG / Sustainability Disclosure &amp; Storytelling Content" isExecutable="false">
      <bpmn:documentation>Trigger: Annual ESG report; marketing campaign; product storytelling need
Frequency: Annual + campaign-driven
Volume: ~5–20 storytelling assets/year
Owner: Sustainability Lead
Participants: Sustainability Lead, Marketing (links to VS-14), Legal, DPO (links to VS-91), Coop Representatives
Source: workflow W3132 — ESG / Sustainability Disclosure &amp; Storytelling Content</bpmn:documentation>
      <bpmn:laneSet id="W3132_LaneSet4">
        <bpmn:lane id="W3132_Lane1" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3132_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3132_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3132_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W3132_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3132_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W3132_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3132_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3132_Start5" name="Annual ESG report; marketing campaign; product storytelling need">
        <bpmn:outgoing>W3132_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3132_Task6" name="Sustainability Lead/Marketing develop authentic storytelling content…">
        <bpmn:documentation>Step 1: Sustainability Lead/Marketing develop authentic storytelling content: coop/artisan stories, product provenance, impact metrics, photo/video with informed consent (links to VS-91 data privacy and IPRA W3134 for indigenous)
Responsible (R): Sustainability Lead / Marketing
Accountable (A): Sustainability/ESG Manager
Duration: Per asset</bpmn:documentation>
        <bpmn:incoming>W3132_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3132_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3132_Task7" name="Legal/DPO review claims (anti-greenwashing — DTI fair-trade), consent/privacy…">
        <bpmn:documentation>Step 2: Legal/DPO review claims (anti-greenwashing — DTI fair-trade), consent/privacy (links to VS-91), and IP/indigenous-cultural-property rights (links to W3134); approve before publication
Responsible (R): Legal Counsel / DPO
Accountable (A): VP Legal &amp; Compliance
Duration: Per asset</bpmn:documentation>
        <bpmn:incoming>W3132_Flow13</bpmn:incoming>
