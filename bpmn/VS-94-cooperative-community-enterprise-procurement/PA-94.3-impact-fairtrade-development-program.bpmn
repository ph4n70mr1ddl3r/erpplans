    <bpmn:process id="W_W3135" name="W3135. Cooperative Risk, Governance &amp; Anti-Exploitation Safeguard" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic risk review; whistleblower/alert; audit finding
Frequency: Quarterly + event-driven
Volume: All coop suppliers
Owner: Sustainability Lead
Participants: Sustainability Lead, Internal Audit (links to VS-21), Legal, Sustainability Sourcing Mgr, Coop Representatives
Source: workflow W3135 — Cooperative Risk, Governance &amp; Anti-Exploitation Safeguard</bpmn:documentation>
      <bpmn:laneSet id="W3135_LaneSet2">
        <bpmn:lane id="W3135_Lane1" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3135_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3135_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3135_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3135_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3135_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3135_Start3" name="Periodic risk review; whistleblower/alert; audit finding">
        <bpmn:outgoing>W3135_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3135_Task4" name="Sustainability Lead/Internal Audit (links to VS-21) screen coops for…">
        <bpmn:documentation>Step 1: Sustainability Lead/Internal Audit (links to VS-21) screen coops for exploitation risk: coercion, middleman skim of fair-trade price, child/forced labor (links to VS-86), unsafe conditions (links to VS-24), environmental harm (links to VS-25/VS-73); whistleblower channel available
Responsible (R): Sustainability Lead / Internal Audit
Accountable (A): Sustainability/ESG Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3135_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3135_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3135_Task5" name="For flagged risk: investigate; engage coop leadership and members separately to…">
        <bpmn:documentation>Step 2: For flagged risk: investigate; engage coop leadership and members separately to detect middleman/coercion; remediate via governance support, capacity-building (W3117), or sanctions/offboarding (W3120)
Responsible (R): Sustainability Lead / Legal
Accountable (A): Sustainability/ESG Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3135_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3135_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3135_Task6" name="Sustainability Lead reports anti-exploitation outcomes to Board/ESG committee…">
        <bpmn:documentation>Step 3: Sustainability Lead reports anti-exploitation outcomes to Board/ESG committee (links to VS-36/VS-25); ensures safeguards auditable by third parties (W3130) and regulators
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3135_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3135_End7" name="Complete">
        <bpmn:incoming>W3135_Flow13</bpmn:incoming>
      </bpmn:endEvent>
