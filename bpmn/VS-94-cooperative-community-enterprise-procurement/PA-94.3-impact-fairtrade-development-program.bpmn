        <bpmndi:BPMNShape id="W3129_Task6_di" bpmnElement="W3129_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3129_Task7_di" bpmnElement="W3129_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
