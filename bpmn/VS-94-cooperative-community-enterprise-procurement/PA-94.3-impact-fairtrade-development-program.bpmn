    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3130" name="W3130. Fair-Trade Certification &amp; Third-Party Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Certification cycle; new coop; certification renewal
Frequency: Annual + per-cycle
Volume: Per coop / BuildRight program-level
Owner: Sustainability Lead
Participants: Sustainability Lead, Sustainability Sourcing Mgr, Third-Party Auditor, Coop Representatives, Legal
Source: workflow W3130 — Fair-Trade Certification &amp; Third-Party Audit</bpmn:documentation>
      <bpmn:laneSet id="W3130_LaneSet3">
        <bpmn:lane id="W3130_Lane1" name="Sustainability Lead">
        <bpmn:flowNodeRef>W3130_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3130_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3130_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3130_Lane2" name="Third-Party Auditor">
        <bpmn:flowNodeRef>W3130_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3130_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3130_Start4" name="Certification cycle; new coop; certification renewal">
        <bpmn:outgoing>W3130_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3130_Task5" name="Sustainability Lead selects appropriate certification (WFTO, local fair-trade…">
        <bpmn:documentation>Step 1: Sustainability Lead selects appropriate certification (WFTO, local fair-trade body, Go Lokal!, social-enterprise cert, ethical-sourcing audit); engage accredited third-party auditor
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3130_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3130_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3130_Task6" name="Auditor conducts on-site audit: fair-wage compliance, no child/forced labor…">
        <bpmn:documentation>Step 2: Auditor conducts on-site audit: fair-wage compliance, no child/forced labor (links to VS-86), safe working conditions (links to VS-24), environmental compliance (links to VS-25/VS-73), traceability and records (links to VS-88), governance
Responsible (R): Third-Party Auditor
Accountable (A): Sustainability Lead
Duration: Per audit</bpmn:documentation>
        <bpmn:incoming>W3130_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3130_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3130_Task7" name="Sustainability Lead closes any non-conformities via capacity-building (W3117)…">
        <bpmn:documentation>Step 3: Sustainability Lead closes any non-conformities via capacity-building (W3117); publishes certification status; uses certification in marketing claims (links to VS-14/VS-25) and as anti-greenwashing safeguard
Responsible (R): Sustainability Lead / Coop
Accountable (A): Sustainability/ESG Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3130_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3130_End8" name="Complete">
        <bpmn:incoming>W3130_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3130_Annotation9">
        <bpmn:text>Controls: - CTL-513 (ensure controlled execution — Impact Measurement, Fair-Trade Compliance &amp; Development Program (PA-94.3).) | - operational: certification calendar and renewal alerts
Owner: Sustainability Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3130_Assoc10" sourceRef="W3130_Annotation9" targetRef="W3130_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3130_Flow11" sourceRef="W3130_Start4" targetRef="W3130_Task5" />
      <bpmn:sequenceFlow id="W3130_Flow12" sourceRef="W3130_Task5" targetRef="W3130_Task6" />
      <bpmn:sequenceFlow id="W3130_Flow13" sourceRef="W3130_Task6" targetRef="W3130_Task7" />
      <bpmn:sequenceFlow id="W3130_Flow14" sourceRef="W3130_Task7" targetRef="W3130_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3130_diag">
      <bpmndi:BPMNPlane id="W3130_plane" bpmnElement="W_W3130">
        <bpmndi:BPMNShape id="W3130_Lane1_di" bpmnElement="W3130_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3130_Lane2_di" bpmnElement="W3130_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
