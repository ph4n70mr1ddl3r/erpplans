      <bpmn:startEvent id="W3134_Start4" name="Indigenous-community sourcing opportunity; ancestral-domain product (handicraft, forest…">
        <bpmn:outgoing>W3134_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3134_Task5" name="Sustainability Lead/NCIP Liaison engage indigenous community per Indigenous…">
        <bpmn:documentation>Step 1: Sustainability Lead/NCIP Liaison engage indigenous community per Indigenous Peoples Rights Act (IPRA / RA 8371): Free, Prior and Informed Consent (FPIC) through NCIP process; respect ancestral-domain sovereignty and community decision structures
Responsible (R): Sustainability Lead / NCIP Liaison
Accountable (A): Sustainability/ESG Manager
Duration: Per engagement (3–9 months)</bpmn:documentation>
        <bpmn:incoming>W3134_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3134_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3134_Task6" name="Legal structures benefit-sharing, intellectual property (traditional designs…">
        <bpmn:documentation>Step 2: Legal structures benefit-sharing, intellectual property (traditional designs, cultural heritage), and Cultural Heritage / Traditional Knowledge agreements; ensure fair share of proceeds flows to community per NCIP-approved plan
Responsible (R): Legal Counsel / NCIP
Accountable (A): VP Legal &amp; Compliance
Duration: Per engagement</bpmn:documentation>
        <bpmn:incoming>W3134_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3134_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3134_Task7" name="Sustainability Lead implements ongoing engagement: respect community protocols…">
        <bpmn:documentation>Step 3: Sustainability Lead implements ongoing engagement: respect community protocols, no extraction without consent, benefit-share audit, and storytelling only with FPIC (links to W3132); report outcomes (links to W3129)
Responsible (R): Sustainability Lead
Accountable (A): Sustainability/ESG Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3134_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3134_End8" name="Complete">
        <bpmn:incoming>W3134_Flow14</bpmn:incoming>
      </bpmn:endEvent>
