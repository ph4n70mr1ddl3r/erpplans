    <bpmn:process id="W_W5266" name="W5266. DTS Training Expense Accounting and BIR Deduction Ledgers Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Approved stipend payroll disbursements (W5265)
Frequency: Monthly accounting close
Volume: ~200-300 journal entries monthly
Owner: Tax Accountant
Participants: Cost Accountant, Chief Accountant (VS-17.1), HR Compliance Manager
Source: workflow W5266 — DTS Training Expense Accounting and BIR Deduction Ledgers Setup</bpmn:documentation>
      <bpmn:laneSet id="W5266_LaneSet4">
        <bpmn:lane id="W5266_Lane1" name="Cost Accountant">
        <bpmn:flowNodeRef>W5266_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5266_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5266_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W5266_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5266_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5266_Lane3" name="Chief Accountant">
        <bpmn:flowNodeRef>W5266_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5266_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5266_Start5" name="Approved stipend payroll disbursements (W5265)">
        <bpmn:outgoing>W5266_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5266_Task6" name="Compile all monthly DTS program expenses: stipends, school fees, uniforms…">
        <bpmn:documentation>Step 1: Compile all monthly DTS program expenses: stipends, school fees, uniforms, materials.
Responsible (R): Cost Accountant
Accountable (A): Tax Accountant
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5266_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5266_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5266_Task7" name="Classify and post eligible training expenses to dedicated DTS tax ledger…">
        <bpmn:documentation>Step 2: Classify and post eligible training expenses to dedicated DTS tax ledger accounts.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5266_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5266_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5266_Task8" name="Perform double-entry ledger check ensuring no mixing of standard opex and DTS…">
        <bpmn:documentation>Step 3: Perform double-entry ledger check ensuring no mixing of standard opex and DTS accounts.
Responsible (R): Chief Accountant
Accountable (A): Tax Accountant
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5266_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5266_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5266_Task9" name="Verify tax deductions tracking matches BIR rules for 50% additional deduction…">
        <bpmn:documentation>Step 4: Verify tax deductions tracking matches BIR rules for 50% additional deduction under RA 7686.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5266_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5266_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5266_End10" name="Complete">
        <bpmn:incoming>W5266_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5266_Annotation11">
        <bpmn:text>Controls: - CTL-34: complete tax-compliance controls; Chief Accountant sign-off required.
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5266_Assoc12" sourceRef="W5266_Annotation11" targetRef="W5266_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5266_Flow13" sourceRef="W5266_Start5" targetRef="W5266_Task6" />
      <bpmn:sequenceFlow id="W5266_Flow14" sourceRef="W5266_Task6" targetRef="W5266_Task7" />
      <bpmn:sequenceFlow id="W5266_Flow15" sourceRef="W5266_Task7" targetRef="W5266_Task8" />
      <bpmn:sequenceFlow id="W5266_Flow16" sourceRef="W5266_Task8" targetRef="W5266_Task9" />
      <bpmn:sequenceFlow id="W5266_Flow17" sourceRef="W5266_Task9" targetRef="W5266_End10" />
    </bpmn:process>
