        <bpmn:documentation>Step 2: Verify deduction allocations matching company entities.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5272_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5272_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5272_Task6" name="Upload the filed ITR schedules and BIR assessment records to corporate tax…">
