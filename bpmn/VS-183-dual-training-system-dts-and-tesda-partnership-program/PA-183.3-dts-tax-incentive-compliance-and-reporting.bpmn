    <bpmn:process id="W_W5269" name="W5269. BIR Certificate of DTS Training Expense Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual tax close (typically March/April)
Frequency: Annually during tax season
Volume: ~5-8 corporate BIR filings audited annually
Owner: Tax Accountant
Participants: External Tax Auditor, Finance Controller (VS-17.4), Bureau of Internal Revenue (BIR) Officer
Source: workflow W5269 — BIR Certificate of DTS Training Expense Audit</bpmn:documentation>
      <bpmn:laneSet id="W5269_LaneSet3">
        <bpmn:lane id="W5269_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W5269_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5269_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5269_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5269_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5269_Lane2" name="External Tax Auditor">
        <bpmn:flowNodeRef>W5269_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5269_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5269_Start4" name="Annual tax close (typically March/April)">
        <bpmn:outgoing>W5269_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5269_Task5" name="Compile annual DTS tax audit package: ledger receipts, MOA agreements, TESDA…">
        <bpmn:documentation>Step 1: Compile annual DTS tax audit package: ledger receipts, MOA agreements, TESDA accreditations.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1-2 days</bpmn:documentation>
        <bpmn:incoming>W5269_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5269_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5269_Task6" name="Audit records against the RA 7686 additional-deduction requirements (50% of DTS…">
        <bpmn:documentation>Step 2: Audit records against the RA 7686 additional-deduction requirements (50% of DTS system expenses, capped at 5% of direct labor cost) claimed in the annual income tax return.
Responsible (R): External Tax Auditor
Accountable (A): Tax Accountant
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W5269_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5269_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5269_Task7" name="Submit audited package to BIR during annual income tax return filing.">
        <bpmn:documentation>Step 3: Submit audited package to BIR during annual income tax return filing.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5269_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5269_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5269_Task8" name="Track BIR clearance verification and save final assessment certificate.">
        <bpmn:documentation>Step 4: Track BIR clearance verification and save final assessment certificate.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5269_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5269_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5269_End9" name="Complete">
        <bpmn:incoming>W5269_Flow16</bpmn:incoming>
      </bpmn:endEvent>
