    <bpmn:process id="W_W5265" name="W5265. DTS Allowance Stipend Calculation Payroll Matching and Disbursement" isExecutable="false">
      <bpmn:documentation>Trigger: Approved attendance sheets (W5257)
Frequency: Semi-monthly payroll cycle
Volume: ~400-600 stipend calculations monthly
Owner: Payroll Analyst
Participants: Store HR Administrator, Treasury specialist, Bank Officer
Source: workflow W5265 — DTS Allowance Stipend Calculation Payroll Matching and Disbursement</bpmn:documentation>
      <bpmn:laneSet id="W5265_LaneSet4">
        <bpmn:lane id="W5265_Lane1" name="Store HR Administrator">
        <bpmn:flowNodeRef>W5265_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5265_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5265_Lane2" name="Payroll Analyst">
        <bpmn:flowNodeRef>W5265_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5265_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5265_Lane3" name="Treasury Specialist">
        <bpmn:flowNodeRef>W5265_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5265_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5265_Start5" name="Approved attendance sheets (W5257)">
        <bpmn:outgoing>W5265_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5265_Task6" name="Compile approved attendance records and calculate student stipends (typically…">
        <bpmn:documentation>Step 1: Compile approved attendance records and calculate student stipends (typically 75% of minimum wage).
Responsible (R): Store HR Administrator
Accountable (A): Payroll Analyst
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5265_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5265_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5265_Task7" name="Match stipend calculations with non-employee profiles to confirm active program…">
        <bpmn:documentation>Step 2: Match stipend calculations with non-employee profiles to confirm active program status.
Responsible (R): Payroll Analyst
Accountable (A): Payroll Analyst
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5265_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5265_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5265_Task8" name="Generate direct-deposit bank upload file and submit to Treasury.">
        <bpmn:documentation>Step 3: Generate direct-deposit bank upload file and submit to Treasury.
Responsible (R): Payroll Analyst
Accountable (A): Payroll Analyst
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5265_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5265_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5265_Task9" name="Approve bank transfer and reconcile stipend disbursement.">
        <bpmn:documentation>Step 4: Approve bank transfer and reconcile stipend disbursement.
Responsible (R): Treasury Specialist
Accountable (A): Payroll Analyst
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5265_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5265_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5265_End10" name="Complete">
        <bpmn:incoming>W5265_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5265_Annotation11">
        <bpmn:text>Controls: - CTL-13: Separate payroll computation from approval; CFO payment approval.
Owner: Payroll Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5265_Assoc12" sourceRef="W5265_Annotation11" targetRef="W5265_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5265_Flow13" sourceRef="W5265_Start5" targetRef="W5265_Task6" />
      <bpmn:sequenceFlow id="W5265_Flow14" sourceRef="W5265_Task6" targetRef="W5265_Task7" />
