    <bpmn:process id="W_W5267" name="W5267. Monthly TESDA Compliance Report Compilation and Submission" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly calendar close
Frequency: Monthly reporting cycle
Volume: ~10-15 reports generated monthly
Owner: HR Compliance Specialist
Participants: TVI Coordinator, Store Manager, TESDA Regional Officer
Source: workflow W5267 — Monthly TESDA Compliance Report Compilation and Submission</bpmn:documentation>
      <bpmn:laneSet id="W5267_LaneSet3">
        <bpmn:lane id="W5267_Lane1" name="HR Compliance Specialist">
        <bpmn:flowNodeRef>W5267_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5267_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5267_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5267_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5267_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W5267_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5267_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5267_Start4" name="Monthly calendar close">
        <bpmn:outgoing>W5267_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5267_Task5" name="Aggregate monthly data: active trainees, attendance rates, task log completion…">
        <bpmn:documentation>Step 1: Aggregate monthly data: active trainees, attendance rates, task log completion, stipends paid.
Responsible (R): HR Compliance Specialist
Accountable (A): HR Compliance Specialist
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5267_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5267_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5267_Task6" name="Draft official TESDA DTS compliance report matching local agency formats.">
        <bpmn:documentation>Step 2: Draft official TESDA DTS compliance report matching local agency formats.
Responsible (R): HR Compliance Specialist
Accountable (A): HR Compliance Specialist
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5267_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5267_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5267_Task7" name="Secure Store Manager signature and verify documentation accuracy.">
        <bpmn:documentation>Step 3: Secure Store Manager signature and verify documentation accuracy.
Responsible (R): Store Manager
Accountable (A): HR Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5267_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5267_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5267_Task8" name="Submit compliance packet to TESDA Provincial Office and log receipt.">
        <bpmn:documentation>Step 4: Submit compliance packet to TESDA Provincial Office and log receipt.
Responsible (R): HR Compliance Specialist
Accountable (A): HR Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5267_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5267_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5267_End9" name="Complete">
        <bpmn:incoming>W5267_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5267_Annotation10">
        <bpmn:text>Controls: - CTL-781: TESDA/DTS compliance controls; HR-L&amp;D Manager approval required.
Owner: HR Compliance Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5267_Assoc11" sourceRef="W5267_Annotation10" targetRef="W5267_Start4" associationDirection="None" />
