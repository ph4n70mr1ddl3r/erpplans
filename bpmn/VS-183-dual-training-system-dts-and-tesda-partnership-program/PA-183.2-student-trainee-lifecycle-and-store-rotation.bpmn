    <bpmn:process id="W_W5258" name="W5258. In-Store Skills Mentoring Trainee Logbook and Output Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Daily practical session completion
Frequency: Daily per trainee
Volume: ~200-300 logs verified daily
Owner: Store Department Supervisor
Participants: Student Trainee, Department Mentor
Source: workflow W5258 — In-Store Skills Mentoring Trainee Logbook and Output Verification</bpmn:documentation>
      <bpmn:laneSet id="W5258_LaneSet4">
        <bpmn:lane id="W5258_Lane1" name="Student Trainee">
        <bpmn:flowNodeRef>W5258_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5258_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5258_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5258_Lane2" name="Department Mentor">
        <bpmn:flowNodeRef>W5258_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5258_Lane3" name="Store Department Supervisor">
        <bpmn:flowNodeRef>W5258_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5258_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5258_Start5" name="Daily practical session completion">
        <bpmn:outgoing>W5258_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5258_Task6" name="Execute assigned training task (e.g., custom tinting matching, bulk tile…">
        <bpmn:documentation>Step 1: Execute assigned training task (e.g., custom tinting matching, bulk tile receipt checking).
Responsible (R): Student Trainee
Accountable (A): Store Department Supervisor
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5258_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5258_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5258_Task7" name="Record completed tasks, learnings, and duration in paper/digital logbook.">
        <bpmn:documentation>Step 2: Record completed tasks, learnings, and duration in paper/digital logbook.
Responsible (R): Student Trainee
Accountable (A): Store Department Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5258_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5258_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5258_Task8" name="Review trainee output quality and verify logbook entries.">
        <bpmn:documentation>Step 3: Review trainee output quality and verify logbook entries.
Responsible (R): Department Mentor
Accountable (A): Store Department Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5258_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5258_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5258_Task9" name="Sign off logbook sheet confirming competency development.">
        <bpmn:documentation>Step 4: Sign off logbook sheet confirming competency development.
Responsible (R): Store Department Supervisor
Accountable (A): Store Department Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5258_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5258_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5258_End10" name="Complete">
        <bpmn:incoming>W5258_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5258_Annotation11">
        <bpmn:text>Controls: - CTL-133 (ensure DTS/TESDA training compliance.) | - operational: supervisor verification control; periodic spot checks by Store Manager.
Owner: Store Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
