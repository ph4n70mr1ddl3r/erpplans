    <bpmn:process id="W_W5259" name="W5259. Store Department Rotation and Skills Diversification Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Completion of current department block (per 30-day block schedule)
Frequency: Monthly per trainee
Volume: ~200-300 rotation transitions monthly
Owner: Store HR Administrator
Participants: Student Trainee, Store Manager, Department Mentor
Source: workflow W5259 — Store Department Rotation and Skills Diversification Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W5259_LaneSet2">
        <bpmn:lane id="W5259_Lane1" name="Store HR Administrator">
        <bpmn:flowNodeRef>W5259_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5259_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5259_Task6</bpmn:flowNodeRef>
