    <bpmn:process id="W_W5257" name="W5257. Student Biometric Time and Attendance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Daily shift schedule starting
Frequency: Daily per trainee
Volume: ~400–600 punches/day (in/out for ~200–300 trainees)
Owner: Store HR Administrator
Participants: Student Trainee, Department Supervisor, TVI Coordinator
Source: workflow W5257 — Student Biometric Time and Attendance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W5257_LaneSet4">
        <bpmn:lane id="W5257_Lane1" name="Student Trainee">
        <bpmn:flowNodeRef>W5257_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5257_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5257_Lane2" name="Store HR Administrator">
        <bpmn:flowNodeRef>W5257_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5257_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5257_Lane3" name="Department Supervisor">
        <bpmn:flowNodeRef>W5257_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5257_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5257_Start5" name="Daily shift schedule starting">
        <bpmn:outgoing>W5257_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5257_Task6" name="Scan fingerprint/biometrics at store entrance terminal at shift start/end.">
        <bpmn:documentation>Step 1: Scan fingerprint/biometrics at store entrance terminal at shift start/end.
Responsible (R): Student Trainee
Accountable (A): Store HR Administrator
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5257_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5257_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5257_Task7" name="Review daily attendance exception report (tardiness, absences).">
        <bpmn:documentation>Step 2: Review daily attendance exception report (tardiness, absences).
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W5257_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5257_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5257_Task8" name="Verify trainee absence reasons and check doctor notes/excuses.">
        <bpmn:documentation>Step 3: Verify trainee absence reasons and check doctor notes/excuses.
Responsible (R): Department Supervisor
Accountable (A): Store HR Administrator
Duration: 10 min/incident</bpmn:documentation>
        <bpmn:incoming>W5257_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5257_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5257_Task9" name="Transmit verified attendance logs to TVI Coordinator weekly.">
        <bpmn:documentation>Step 4: Transmit verified attendance logs to TVI Coordinator weekly.
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W5257_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5257_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5257_End10" name="Complete">
        <bpmn:incoming>W5257_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5257_Annotation11">
        <bpmn:text>Controls: - CTL-13: payroll/time verification controls; SM review on attendance reports.
Owner: Store HR Administrator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5257_Assoc12" sourceRef="W5257_Annotation11" targetRef="W5257_Start5" associationDirection="None" />
