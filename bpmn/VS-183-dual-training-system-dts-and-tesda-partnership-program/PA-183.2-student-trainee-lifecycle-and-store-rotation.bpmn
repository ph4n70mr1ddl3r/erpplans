        <bpmn:flowNodeRef>W5259_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5259_Start3" name="Completion of current department block (per 30-day block schedule)">
        <bpmn:outgoing>W5259_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5259_Task4" name="Review rotation matrix mapping trainees to open department slots (lumber yard…">
        <bpmn:documentation>Step 1: Review rotation matrix mapping trainees to open department slots (lumber yard, tools, paint).
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5259_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5259_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5259_Task5" name="Assess trainee competency readiness for transition (verified W5258).">
        <bpmn:documentation>Step 2: Assess trainee competency readiness for transition (verified W5258).
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5259_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5259_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5259_Task6" name="Update department assignment flags in HRIS schedule builder.">
        <bpmn:documentation>Step 3: Update department assignment flags in HRIS schedule builder.
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5259_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5259_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5259_Task7" name="Conduct handover meeting between outgoing and incoming department mentors.">
        <bpmn:documentation>Step 4: Conduct handover meeting between outgoing and incoming department mentors.
Responsible (R): Store HR Administrator
Accountable (A): Store HR Administrator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5259_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5259_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5259_End8" name="Complete">
        <bpmn:incoming>W5259_Flow15</bpmn:incoming>
      </bpmn:endEvent>
