      <bpmn:startEvent id="W5256_Start3" name="Approaching agreement expiry (60 days prior)">
        <bpmn:outgoing>W5256_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5256_Task4" name="Compile partnership KPI scorecard: student graduation rate, retention, OHS…">
        <bpmn:documentation>Step 1: Compile partnership KPI scorecard: student graduation rate, retention, OHS compliance, tax savings.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W5256_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5256_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5256_Task5" name="Conduct contract review and audit partner TVI records.">
        <bpmn:documentation>Step 2: Conduct contract review and audit partner TVI records.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 3 hours</bpmn:documentation>
        <bpmn:incoming>W5256_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5256_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5256_Task6" name="Negotiate contract renewal adjustments (stipends, volume slots).">
        <bpmn:documentation>Step 3: Negotiate contract renewal adjustments (stipends, volume slots).
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5256_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5256_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5256_Task7" name="Execute agreement renewal and update compliance log.">
        <bpmn:documentation>Step 4: Execute agreement renewal and update compliance log.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5256_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5256_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5256_End8" name="Complete">
        <bpmn:incoming>W5256_Flow15</bpmn:incoming>
      </bpmn:endEvent>
