    <bpmn:process id="W_W5251" name="W5251. DTS Training Plan and Curriculum Design Collaboration" isExecutable="false">
      <bpmn:documentation>Trigger: Signed MOA with TVI partner (W5250)
Frequency: Per program cycle
Volume: ~10-15 curriculum blocks designed annually
Owner: HR-L&amp;D Specialist
Participants: TVI Coordinator, Category Manager (VS-01.1), Store Manager (VS-07)
Source: workflow W5251 — DTS Training Plan and Curriculum Design Collaboration</bpmn:documentation>
      <bpmn:laneSet id="W5251_LaneSet3">
        <bpmn:lane id="W5251_Lane1" name="HR-L&amp;D Specialist">
        <bpmn:flowNodeRef>W5251_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5251_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5251_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5251_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5251_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W5251_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5251_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5251_Start4" name="Signed MOA with TVI partner (W5250)">
        <bpmn:outgoing>W5251_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5251_Task5" name="Synchronize school technical curriculum with practical store operations blocks…">
        <bpmn:documentation>Step 1: Synchronize school technical curriculum with practical store operations blocks (60/40 mix).
Responsible (R): HR-L&amp;D Specialist
Accountable (A): HR-L&amp;D Specialist
Duration: 3-4 hours</bpmn:documentation>
        <bpmn:incoming>W5251_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5251_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5251_Task6" name="Define competencies: custom paint mixing, tool mechanics, safety, customer…">
        <bpmn:documentation>Step 2: Define competencies: custom paint mixing, tool mechanics, safety, customer service consultations.
Responsible (R): HR-L&amp;D Specialist
Accountable (A): HR-L&amp;D Specialist
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5251_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5251_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5251_Task7" name="Review training plan with Category Manager for technical accuracy.">
        <bpmn:documentation>Step 3: Review training plan with Category Manager for technical accuracy.
Responsible (R): Category Manager
Accountable (A): HR-L&amp;D Specialist
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5251_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5251_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5251_Task8" name="Submit training curriculum to TESDA for approval.">
        <bpmn:documentation>Step 4: Submit training curriculum to TESDA for approval.
Responsible (R): HR-L&amp;D Specialist
Accountable (A): HR-L&amp;D Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5251_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5251_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5251_End9" name="Complete">
        <bpmn:incoming>W5251_Flow16</bpmn:incoming>
      </bpmn:endEvent>
