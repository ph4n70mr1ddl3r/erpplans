    <bpmn:process id="W_W5249" name="W5249. TESDA DTS Dual Training Accreditation and Site Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic L&amp;D plan and TVI alignment target (VS-19.4)
Frequency: Annually per store cluster
Volume: ~10-15 accreditation inspections annually
Owner: HR-L&amp;D Manager
Participants: TVI Coordinator, TESDA Regional Inspector, Facilities Standards Manager (VS-138)
Source: workflow W5249 — TESDA DTS Dual Training Accreditation and Site Inspection</bpmn:documentation>
      <bpmn:laneSet id="W5249_LaneSet4">
        <bpmn:lane id="W5249_Lane1" name="HR-L&amp;D Manager">
        <bpmn:flowNodeRef>W5249_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5249_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5249_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5249_Lane2" name="Facilities Standards Manager">
        <bpmn:flowNodeRef>W5249_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5249_Lane3" name="TESDA Regional Inspector">
        <bpmn:flowNodeRef>W5249_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5249_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5249_Start5" name="Strategic L&amp;D plan and TVI alignment target (VS-19.4)">
        <bpmn:outgoing>W5249_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5249_Task6" name="Submit DTS accreditation application to local TESDA Provincial Office.">
        <bpmn:documentation>Step 1: Submit DTS accreditation application to local TESDA Provincial Office.
Responsible (R): HR-L&amp;D Manager
Accountable (A): HR-L&amp;D Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5249_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5249_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5249_Task7" name="Coordinate TESDA physical site inspection of store/DC training facilities.">
        <bpmn:documentation>Step 2: Coordinate TESDA physical site inspection of store/DC training facilities.
Responsible (R): Facilities Standards Manager
Accountable (A): HR-L&amp;D Manager
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5249_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5249_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5249_Task8" name="Verify OHS standards, training tools, and supervisor qualifications against…">
        <bpmn:documentation>Step 3: Verify OHS standards, training tools, and supervisor qualifications against TESDA guidelines.
Responsible (R): TESDA Regional Inspector
Accountable (A): HR-L&amp;D Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5249_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5249_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5249_Task9" name="Secure DTS Certificate of Accreditation and upload to compliance library.">
        <bpmn:documentation>Step 4: Secure DTS Certificate of Accreditation and upload to compliance library.
Responsible (R): HR-L&amp;D Manager
Accountable (A): HR-L&amp;D Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5249_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5249_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5249_End10" name="Complete">
        <bpmn:incoming>W5249_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5249_Annotation11">
        <bpmn:text>Controls: - CTL-41: LGU/agency permit renewal alert engine; HR-L&amp;D Manager formal sign-off.
Owner: HR-L&amp;D Manager</bpmn:text>
      </bpmn:textAnnotation>
