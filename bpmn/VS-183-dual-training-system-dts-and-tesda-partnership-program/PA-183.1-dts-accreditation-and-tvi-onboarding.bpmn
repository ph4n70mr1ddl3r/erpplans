    <bpmn:process id="W_W5250" name="W5250. Technical-Vocational Institution TVI Partner Screening and SLA" isExecutable="false">
      <bpmn:documentation>Trigger: TESDA DTS accreditation approved (W5249)
Frequency: Per TVI engagement
Volume: ~5-8 TVI contracts executed annually
Owner: HR Compliance Manager
Participants: TVI Director, VP Legal (VS-100), Chief Accountant (VS-17)
Source: workflow W5250 — Technical-Vocational Institution TVI Partner Screening and SLA</bpmn:documentation>
      <bpmn:laneSet id="W5250_LaneSet3">
        <bpmn:lane id="W5250_Lane1" name="HR Compliance Manager">
        <bpmn:flowNodeRef>W5250_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5250_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5250_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5250_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5250_Lane2" name="VP Legal">
        <bpmn:flowNodeRef>W5250_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5250_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5250_Start4" name="TESDA DTS accreditation approved (W5249)">
        <bpmn:outgoing>W5250_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5250_Task5" name="Vet candidate TVIs (technical-vocational schools) for curriculum alignment and…">
        <bpmn:documentation>Step 1: Vet candidate TVIs (technical-vocational schools) for curriculum alignment and TESDA status.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5250_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5250_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5250_Task6" name="Draft DTS Memoradum of Agreement (MOA) and SLA defining student allowances…">
        <bpmn:documentation>Step 2: Draft DTS Memoradum of Agreement (MOA) and SLA defining student allowances, curriculum blocks, and coordinator liaison rules.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5250_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5250_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5250_Task7" name="Review legal liabilities, insurance, and tax structure with VP Legal.">
        <bpmn:documentation>Step 3: Review legal liabilities, insurance, and tax structure with VP Legal.
Responsible (R): VP Legal
Accountable (A): HR Compliance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5250_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5250_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5250_Task8" name="Execute MOA and register TVI in vendor master system.">
        <bpmn:documentation>Step 4: Execute MOA and register TVI in vendor master system.
Responsible (R): HR Compliance Manager
Accountable (A): HR Compliance Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5250_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5250_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5250_End9" name="Complete">
        <bpmn:incoming>W5250_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5250_Annotation10">
        <bpmn:text>Controls: - CTL-06: Prevent unauthorized vendor onboarding; board authorization limits adhered to.
Owner: HR Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
