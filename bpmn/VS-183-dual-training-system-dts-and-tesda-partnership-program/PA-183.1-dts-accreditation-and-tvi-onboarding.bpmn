    <bpmn:process id="W_W5256" name="W5256. Annual DTS Partnership Performance Audit and Contract Renewal" isExecutable="false">
      <bpmn:documentation>Trigger: Approaching agreement expiry (60 days prior)
Frequency: Annually per partnership agreement
Volume: ~5-8 audits annually
Owner: HR Compliance Manager
Participants: TVI Director, Store Manager, Chief Accountant (VS-17)
Source: workflow W5256 — Annual DTS Partnership Performance Audit and Contract Renewal</bpmn:documentation>
      <bpmn:laneSet id="W5256_LaneSet2">
        <bpmn:lane id="W5256_Lane1" name="HR Compliance Manager">
        <bpmn:flowNodeRef>W5256_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5256_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5256_Task6</bpmn:flowNodeRef>
