      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2348" name="W2348. Sample Display Performance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly analytics review
Frequency: Quarterly; 200 stores
Volume: ~200 stores analyzed quarterly
Owner: Analytics Manager
Participants: Analytics Manager, Category Mgr, VP Merchandising
Source: workflow W2348 — Sample Display Performance Review</bpmn:documentation>
      <bpmn:laneSet id="W2348_LaneSet2">
        <bpmn:lane id="W2348_Lane1" name="Analytics Manager">
        <bpmn:flowNodeRef>W2348_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2348_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2348_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2348_Start3" name="Quarterly analytics review">
        <bpmn:outgoing>W2348_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2348_Task4" name="Analytics Manager measures display performance: sales per display zone…">
        <bpmn:documentation>Step 1: Analytics Manager measures display performance: sales per display zone, sample-to-order conversion rate (from W2340), dwell time at displays (where sensor-equipped), customer feedback on displays; identifies the top- and bottom-performing displays and the damage-frequency patterns (from W2343)
Responsible (R): Analytics Manager
Accountable (A): Category Manager
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2348_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2348_End5" name="Complete">
        <bpmn:incoming>W2348_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2348_Annotation6">
        <bpmn:text>Controls: - CTL-416 (ensure controlled execution — Display Maintenance &amp; Sample Refresh (PA-62.2).) | - Operational: Analytics Manager methodology sign-off (attribution rules documented); Category Manager review of any display with conversion below threshold
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2348_Assoc7" sourceRef="W2348_Annotation6" targetRef="W2348_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2348_Flow8" sourceRef="W2348_Start3" targetRef="W2348_Task4" />
      <bpmn:sequenceFlow id="W2348_Flow9" sourceRef="W2348_Task4" targetRef="W2348_End5" />
    </bpmn:process>
