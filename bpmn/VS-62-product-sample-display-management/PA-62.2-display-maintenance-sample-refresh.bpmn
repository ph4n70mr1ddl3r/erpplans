      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2349" name="W2349. Sample Display Decommissioning" isExecutable="false">
      <bpmn:documentation>Trigger: Product delisted or display program ended
Frequency: ~50–100 decommissions/year
Volume: ~50–100/year
Owner: Merchandising Coordinator
Participants: Merch Coordinator, Store Manager, Facilities
Source: workflow W2349 — Sample Display Decommissioning</bpmn:documentation>
      <bpmn:laneSet id="W2349_LaneSet2">
        <bpmn:lane id="W2349_Lane1" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2349_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2349_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2349_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2349_Start3" name="Product delisted or display program ended">
        <bpmn:outgoing>W2349_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2349_Task4" name="Coordinator issues the decommission: remove the samples, dismantle the fixture…">
        <bpmn:documentation>Step 1: Coordinator issues the decommission: remove the samples, dismantle the fixture, return the vendor-owned displays (per the W2347 agreement terms), dispose/recycle the BuildRight-owned materials (per VS-73 waste streams); restore the zone to the standard planogram
Responsible (R): Merch Coordinator / Store Manager / Facilities
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2349_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2349_End5" name="Complete">
        <bpmn:incoming>W2349_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2349_Annotation6">
        <bpmn:text>Controls: - CTL-198: asset-grade display disposition; operational: Merch Coordinator decommission sign-off per program
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2349_Assoc7" sourceRef="W2349_Annotation6" targetRef="W2349_Start3" associationDirection="None" />
