        <bpmndi:BPMNShape id="W2342_Task5_di" bpmnElement="W2342_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2342_Task6_di" bpmnElement="W2342_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2342_Start4_di" bpmnElement="W2342_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2342_End7_di" bpmnElement="W2342_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2342_Annotation8_di" bpmnElement="W2342_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2342_Flow10_di" bpmnElement="W2342_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2342_Flow11_di" bpmnElement="W2342_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2342_Flow12_di" bpmnElement="W2342_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2342_Assoc9_di" bpmnElement="W2342_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2343" name="W2343. Damaged Sample Replacement Process" isExecutable="false">
      <bpmn:documentation>Trigger: Store reports damaged or missing sample
Frequency: Ad-hoc; ~500–800 replacements/month
Volume: ~500–800/month across 200 stores
Owner: Store Department Supervisor
Participants: Dept Supervisor, Merch Coordinator, DC Ops
Source: workflow W2343 — Damaged Sample Replacement Process</bpmn:documentation>
      <bpmn:laneSet id="W2343_LaneSet2">
        <bpmn:lane id="W2343_Lane1" name="Dept Supervisor">
        <bpmn:flowNodeRef>W2343_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2343_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2343_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2343_Start3" name="Store reports damaged or missing sample">
        <bpmn:outgoing>W2343_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2343_Task4" name="Supervisor reports the damaged sample in the system: sample-ID, damage type…">
        <bpmn:documentation>Step 1: Supervisor reports the damaged sample in the system: sample-ID, damage type, photo evidence; system generates the replacement order; Merch Coordinator approves (or auto-approved if below threshold); replacement shipped with the next DC delivery
Responsible (R): Dept Supervisor / System
Accountable (A): Merch Coordinator
Duration: 10 min + 3–5 days delivery</bpmn:documentation>
        <bpmn:incoming>W2343_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2343_End5" name="Complete">
        <bpmn:incoming>W2343_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2343_Annotation6">
        <bpmn:text>Controls: - CTL-416 (ensure controlled execution — Display Maintenance &amp; Sample Refresh (PA-62.2).) | - operational: sample-SKU transaction integrity; operational: photo-evidence requirement per damage report
Owner: Store Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2343_Assoc7" sourceRef="W2343_Annotation6" targetRef="W2343_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2343_Flow8" sourceRef="W2343_Start3" targetRef="W2343_Task4" />
      <bpmn:sequenceFlow id="W2343_Flow9" sourceRef="W2343_Task4" targetRef="W2343_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2343_diag">
      <bpmndi:BPMNPlane id="W2343_plane" bpmnElement="W_W2343">
        <bpmndi:BPMNShape id="W2343_Lane1_di" bpmnElement="W2343_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2343_Task4_di" bpmnElement="W2343_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2343_Start3_di" bpmnElement="W2343_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2343_End5_di" bpmnElement="W2343_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2343_Annotation6_di" bpmnElement="W2343_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2343_Flow8_di" bpmnElement="W2343_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2343_Flow9_di" bpmnElement="W2343_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2343_Assoc7_di" bpmnElement="W2343_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2344" name="W2344. Sample Display Area Cleaning &amp; Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly scheduled maintenance
Frequency: Weekly; 200 stores
Volume: ~200 stores/week
Owner: Store Staff
Participants: Store Staff, Department Supervisor
Source: workflow W2344 — Sample Display Area Cleaning &amp; Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2344_LaneSet2">
        <bpmn:lane id="W2344_Lane1" name="Store Staff">
        <bpmn:flowNodeRef>W2344_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2344_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2344_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2344_Start3" name="Weekly scheduled maintenance">
        <bpmn:outgoing>W2344_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2344_Task4" name="Designated staff cleans the sample displays weekly: dust tile boards, wipe…">
        <bpmn:documentation>Step 1: Designated staff cleans the sample displays weekly: dust tile boards, wipe countertop chips, replace faded color cards, clean the display fixtures, organize the sample order; logs completion in the VS-07 daily-ops checklist
Responsible (R): Store Staff
Accountable (A): Department Supervisor
Duration: 30–45 min/week</bpmn:documentation>
        <bpmn:incoming>W2344_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2344_End5" name="Complete">
        <bpmn:incoming>W2344_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2344_Annotation6">
        <bpmn:text>Controls: - CTL-416 (ensure controlled execution — Display Maintenance &amp; Sample Refresh (PA-62.2).) | - Operational: Department Supervisor weekly sign-off on the cleaning checklist
Owner: Store Staff</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2344_Assoc7" sourceRef="W2344_Annotation6" targetRef="W2344_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2344_Flow8" sourceRef="W2344_Start3" targetRef="W2344_Task4" />
      <bpmn:sequenceFlow id="W2344_Flow9" sourceRef="W2344_Task4" targetRef="W2344_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2344_diag">
      <bpmndi:BPMNPlane id="W2344_plane" bpmnElement="W_W2344">
        <bpmndi:BPMNShape id="W2344_Lane1_di" bpmnElement="W2344_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2344_Task4_di" bpmnElement="W2344_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2344_Start3_di" bpmnElement="W2344_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2344_End5_di" bpmnElement="W2344_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2344_Annotation6_di" bpmnElement="W2344_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2344_Flow8_di" bpmnElement="W2344_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2344_Flow9_di" bpmnElement="W2344_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2344_Assoc7_di" bpmnElement="W2344_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2345" name="W2345. Sample Display Signage &amp; Pricing Update" isExecutable="false">
      <bpmn:documentation>Trigger: Price change or new sample added
Frequency: ~200–300 updates/month
Volume: ~200–300/month
Owner: Store Department Supervisor
Participants: Dept Supervisor, Pricing Analyst, Merch Coord
Source: workflow W2345 — Sample Display Signage &amp; Pricing Update</bpmn:documentation>
      <bpmn:laneSet id="W2345_LaneSet2">
        <bpmn:lane id="W2345_Lane1" name="Dept Supervisor">
        <bpmn:flowNodeRef>W2345_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2345_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2345_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2345_Start3" name="Price change or new sample added">
        <bpmn:outgoing>W2345_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2345_Task4" name="System generates the sample pricing labels when the parent SKU&#x27;s SRP changes…">
        <bpmn:documentation>Step 1: System generates the sample pricing labels when the parent SKU&#x27;s SRP changes (the sample-SKU→parent-SKU link from W2334 surfaces the price-change impact); Supervisor prints and applies the labels to the sample display; ensures the sample SKU, product name, price, and order-availability match the current data
Responsible (R): Dept Supervisor / System
Accountable (A): Store Manager
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W2345_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2345_End5" name="Complete">
        <bpmn:incoming>W2345_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2345_Annotation6">
        <bpmn:text>Controls: - CTL-416 (ensure controlled execution — Display Maintenance &amp; Sample Refresh (PA-62.2).) | - CTL-416 (price-tag accuracy — links to VS-08 / W69 price-compliance audit, DTI price-freeze compliance); operational: Department Supervisor label-application sign-off
Owner: Store Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2345_Assoc7" sourceRef="W2345_Annotation6" targetRef="W2345_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2345_Flow8" sourceRef="W2345_Start3" targetRef="W2345_Task4" />
      <bpmn:sequenceFlow id="W2345_Flow9" sourceRef="W2345_Task4" targetRef="W2345_End5" />
    </bpmn:process>
