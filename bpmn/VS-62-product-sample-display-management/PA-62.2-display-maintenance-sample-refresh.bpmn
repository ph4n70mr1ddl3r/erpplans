    <bpmn:process id="W_W2346" name="W2346. Interactive Display Technology Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly maintenance or malfunction
Frequency: Monthly; ~50 stores with tablet/kiosk displays
Volume: ~50 stores/month
Owner: IT Support
Participants: IT Support, Store Manager, Digital PM
Source: workflow W2346 — Interactive Display Technology Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2346_LaneSet2">
        <bpmn:lane id="W2346_Lane1" name="IT Support">
        <bpmn:flowNodeRef>W2346_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2346_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2346_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2346_Start3" name="Monthly maintenance or malfunction">
        <bpmn:outgoing>W2346_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2346_Task4" name="IT Support maintains the interactive sample displays: in-store tablets running…">
        <bpmn:documentation>Step 1: IT Support maintains the interactive sample displays: in-store tablets running the AR visualizer (W2339), digital kiosks with the product catalog; updates the software, replaces damaged tablets, troubleshoots connectivity (links to VS-27 IT ops)
Responsible (R): IT Support
Accountable (A): CIO
Duration: 2–3 hours/store/month</bpmn:documentation>
        <bpmn:incoming>W2346_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2346_End5" name="Complete">
        <bpmn:incoming>W2346_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2346_Annotation6">
        <bpmn:text>Controls: - CTL-416 (ensure controlled execution — Display Maintenance &amp; Sample Refresh (PA-62.2).) | - CTL-416 (IT-asset tracking — links to VS-99); operational: IT Support monthly maintenance log per device
Owner: IT Support</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2346_Assoc7" sourceRef="W2346_Annotation6" targetRef="W2346_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2346_Flow8" sourceRef="W2346_Start3" targetRef="W2346_Task4" />
      <bpmn:sequenceFlow id="W2346_Flow9" sourceRef="W2346_Task4" targetRef="W2346_End5" />
    </bpmn:process>
