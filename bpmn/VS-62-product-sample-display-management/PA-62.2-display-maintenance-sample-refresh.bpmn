    <bpmn:process id="W_W2347" name="W2347. Vendor-Funded Display Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor offers branded display fixture
Frequency: ~10–15 vendor display programs/year
Volume: ~10–15 programs/year
Owner: Category Manager
Participants: Category Mgr, Marketing, Vendor, Store Ops
Source: workflow W2347 — Vendor-Funded Display Program Management</bpmn:documentation>
      <bpmn:laneSet id="W2347_LaneSet3">
        <bpmn:lane id="W2347_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2347_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2347_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2347_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W2347_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2347_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2347_Start4" name="Vendor offers branded display fixture">
        <bpmn:outgoing>W2347_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2347_Task5" name="Vendor proposes a branded display (e.g., a Bosch power-tool wall, a Boysen…">
        <bpmn:documentation>Step 1: Vendor proposes a branded display (e.g., a Bosch power-tool wall, a Boysen paint station); Category Manager evaluates: brand alignment, customer experience, space requirement (against the VS-55 space-allocation plan), vendor funding level (is the vendor paying for the fixture and installation?)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 days/program</bpmn:documentation>
        <bpmn:incoming>W2347_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2347_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2347_Task6" name="Approved displays: vendor provides the fixture and installation; Store Ops…">
        <bpmn:documentation>Step 2: Approved displays: vendor provides the fixture and installation; Store Ops coordinates the placement; Category Manager monitors the performance (traffic, conversion, sales lift) vs. the standard display baseline to validate the program
Responsible (R): Vendor / Store Ops / Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 weeks install + ongoing</bpmn:documentation>
        <bpmn:incoming>W2347_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2347_End7" name="Complete">
        <bpmn:incoming>W2347_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2347_Annotation8">
        <bpmn:text>Controls: - CTL-39: co-op/rebate accuracy — the vendor funding validated; CTL-48 (rebate-dispute resolution if the vendor disputes the funding obligation); operational: VP Merchandising sign-off on any vendor display &gt;PHP 500K fixture value
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2347_Assoc9" sourceRef="W2347_Annotation8" targetRef="W2347_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2347_Flow10" sourceRef="W2347_Start4" targetRef="W2347_Task5" />
      <bpmn:sequenceFlow id="W2347_Flow11" sourceRef="W2347_Task5" targetRef="W2347_Task6" />
      <bpmn:sequenceFlow id="W2347_Flow12" sourceRef="W2347_Task6" targetRef="W2347_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2347_diag">
      <bpmndi:BPMNPlane id="W2347_plane" bpmnElement="W_W2347">
