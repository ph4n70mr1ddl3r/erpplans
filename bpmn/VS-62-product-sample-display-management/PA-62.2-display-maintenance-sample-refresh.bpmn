<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-62.2-display-maintenance-sample-refresh" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2342" name="W2342. Monthly Display Condition Inspection" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inspection cycle
Frequency: Monthly; 200 stores × 8 zones
Volume: ~1,600 zone inspections/month
Owner: Regional Operations Manager
Participants: Regional Ops Mgr, Store Manager, Merch Coord
Source: workflow W2342 — Monthly Display Condition Inspection</bpmn:documentation>
      <bpmn:laneSet id="W2342_LaneSet3">
        <bpmn:lane id="W2342_Lane1" name="Regional Ops Mgr">
        <bpmn:flowNodeRef>W2342_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2342_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2342_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2342_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2342_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2342_Start4" name="Monthly inspection cycle">
        <bpmn:outgoing>W2342_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2342_Task5" name="Regional Ops Manager (or designated field auditor) inspects the sample displays…">
        <bpmn:documentation>Step 1: Regional Ops Manager (or designated field auditor) inspects the sample displays across ~8 zones per store: condition, cleanliness, completeness (samples present vs. the W2337 minimum threshold), pricing-label accuracy (links to W2345), visual-merchandising standard adherence (links to VS-55 planogram); scores each zone on a standard rubric
Responsible (R): Regional Ops Mgr
Accountable (A): VP Store Operations
Duration: 2–3 hours/store</bpmn:documentation>
        <bpmn:incoming>W2342_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2342_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2342_Task6" name="Store Manager remediates the findings within 48 hours; damaged samples replaced…">
        <bpmn:documentation>Step 2: Store Manager remediates the findings within 48 hours; damaged samples replaced from the store reserve or ordered from the DC (W2343); persistent issues escalated to the Merchandising Coordinator for a program-level fix
Responsible (R): Store Manager
Accountable (A): Regional Ops Mgr
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2342_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2342_End7" name="Complete">
        <bpmn:incoming>W2342_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2342_Annotation8">
        <bpmn:text>Controls: - CTL-195: display integrity — a display that misrepresents product is a consumer-protection risk per W2682; operational: Regional Ops Manager finding-closure sign-off
Owner: Regional Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2342_Assoc9" sourceRef="W2342_Annotation8" targetRef="W2342_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2342_Flow10" sourceRef="W2342_Start4" targetRef="W2342_Task5" />
      <bpmn:sequenceFlow id="W2342_Flow11" sourceRef="W2342_Task5" targetRef="W2342_Task6" />
      <bpmn:sequenceFlow id="W2342_Flow12" sourceRef="W2342_Task6" targetRef="W2342_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2342_diag">
      <bpmndi:BPMNPlane id="W2342_plane" bpmnElement="W_W2342">
        <bpmndi:BPMNShape id="W2342_Lane1_di" bpmnElement="W2342_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
