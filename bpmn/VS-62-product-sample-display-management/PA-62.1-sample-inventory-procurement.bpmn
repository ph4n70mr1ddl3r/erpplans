    <bpmn:process id="W_W2341" name="W2341. Seasonal Sample Refresh Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal transition (6 rotations/year)
Frequency: 6/year; 200 stores
Volume: ~1,200 seasonal sample refreshes/year
Owner: Merchandising Coordinator
Participants: Merch Coordinator, Store Managers, DC Ops
Source: workflow W2341 — Seasonal Sample Refresh Execution</bpmn:documentation>
      <bpmn:laneSet id="W2341_LaneSet2">
        <bpmn:lane id="W2341_Lane1" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2341_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2341_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2341_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2341_Start3" name="Seasonal transition (6 rotations/year)">
        <bpmn:outgoing>W2341_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2341_Task4" name="Coordinator issues the seasonal sample-refresh instructions: remove the…">
        <bpmn:documentation>Step 1: Coordinator issues the seasonal sample-refresh instructions: remove the off-season samples (return-to-vendor or recycle per VS-73), install the new-season samples; DC pre-stages the seasonal sample kits; stores execute during the planogram rotation per VS-55 (samples rotate with the merchandise reset)
Responsible (R): Merch Coordinator / DC / Store Manager
Accountable (A): Merchandising Planner
Duration: 1–2 weeks per rotation</bpmn:documentation>
        <bpmn:incoming>W2341_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2341_End5" name="Complete">
        <bpmn:incoming>W2341_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2341_Annotation6">
        <bpmn:text>Controls: - CTL-198: asset-grade sample disposition; operational: Merch Coordinator sign-off on the rotation completion per store cluster
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2341_Assoc7" sourceRef="W2341_Annotation6" targetRef="W2341_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2341_Flow8" sourceRef="W2341_Start3" targetRef="W2341_Task4" />
      <bpmn:sequenceFlow id="W2341_Flow9" sourceRef="W2341_Task4" targetRef="W2341_End5" />
    </bpmn:process>
