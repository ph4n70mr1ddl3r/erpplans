      <bpmn:sequenceFlow id="W2339_Flow11" sourceRef="W2339_Task5" targetRef="W2339_Task6" />
      <bpmn:sequenceFlow id="W2339_Flow12" sourceRef="W2339_Task6" targetRef="W2339_End7" />
    </bpmn:process>
