    <bpmn:process id="W_W2339" name="W2339. Digital Sample &amp; Augmented Reality Tool Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly app update or new feature launch
Frequency: Quarterly app updates; continuous availability
Volume: ~42,900 ecommerce customers + in-store tablet users
Owner: Digital Product Manager
Participants: Digital PM, IT, Category Mgr, Vendor
Source: workflow W2339 — Digital Sample &amp; Augmented Reality Tool Management</bpmn:documentation>
      <bpmn:laneSet id="W2339_LaneSet3">
        <bpmn:lane id="W2339_Lane1" name="Digital PM">
        <bpmn:flowNodeRef>W2339_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2339_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2339_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2339_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2339_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2339_Start4" name="Quarterly app update or new feature launch">
        <bpmn:outgoing>W2339_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2339_Task5" name="Digital PM manages the AR/3D visualization tools in the BuildRight app and…">
        <bpmn:documentation>Step 1: Digital PM manages the AR/3D visualization tools in the BuildRight app and in-store tablets: tile visualizer (see tile on your room floor), paint color visualizer (see the wall color), countertop preview; updates the product catalog quarterly with new SKUs enabled for visualization
Responsible (R): Digital PM / IT
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2339_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2339_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2339_Task6" name="Category Manager validates the color/texture accuracy of the digital samples…">
        <bpmn:documentation>Step 2: Category Manager validates the color/texture accuracy of the digital samples vs. the physical (the digital must match the physical sample which must match the actual product); coordinates with the vendor for the digital assets (3D models, high-res textures)
Responsible (R): Category Manager / Vendor
Accountable (A): Digital PM
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2339_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2339_End7" name="Complete">
        <bpmn:incoming>W2339_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2339_Annotation8">
        <bpmn:text>Controls: - CTL-51: digital-asset/SKU master currency; operational: Category Manager quarterly accuracy sign-off
Owner: Digital Product Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2339_Assoc9" sourceRef="W2339_Annotation8" targetRef="W2339_Start4" associationDirection="None" />
