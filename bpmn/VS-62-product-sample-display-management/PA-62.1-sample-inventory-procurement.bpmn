    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2335" name="W2335. Paint Color Card &amp; Swatch Management" isExecutable="false">
      <bpmn:documentation>Trigger: Seasonal refresh or new paint line introduction
Frequency: Semi-annual; ~200 stores × 200 color cards
Volume: ~40,000 color cards per refresh cycle
Owner: Category Manager (Paint)
Participants: Category Mgr, Paint Vendor, Store Ops
Source: workflow W2335 — Paint Color Card &amp; Swatch Management</bpmn:documentation>
      <bpmn:laneSet id="W2335_LaneSet3">
        <bpmn:lane id="W2335_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2335_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2335_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2335_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2335_Lane2" name="DC">
        <bpmn:flowNodeRef>W2335_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2335_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2335_Start4" name="Seasonal refresh or new paint line introduction">
        <bpmn:outgoing>W2335_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2335_Task5" name="Category Manager orders the updated color-card sets from the paint vendor: all…">
        <bpmn:documentation>Step 1: Category Manager orders the updated color-card sets from the paint vendor: all available tints with BuildRight&#x27;s current pricing printed on each card; vendor prints and delivers to the DC
Responsible (R): Category Manager
Accountable (A): Vendor
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2335_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2335_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2335_Task6" name="DC distributes to stores; Paint Station staff replaces the old cards with the…">
        <bpmn:documentation>Step 2: DC distributes to stores; Paint Station staff replaces the old cards with the new set (old cards recycled per VS-73 waste streams); system tracks the distribution and confirms receipt per store
Responsible (R): DC / Store Staff
Accountable (A): Store Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2335_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2335_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2335_Task7" name="Category Manager validates the color-card accuracy against the actual tinted…">
        <bpmn:documentation>Step 3: Category Manager validates the color-card accuracy against the actual tinted paint (the card is a representation; the mixed paint must match) via a sample-verification at a few stores each cycle
Responsible (R): Category Manager
Accountable (A): Vendor
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W2335_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2335_End8" name="Complete">
        <bpmn:incoming>W2335_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2335_Annotation9">
        <bpmn:text>Controls: - CTL-179: warranty/return integrity — a color-mismatch return traces back to the card accuracy; operational: Category Manager cycle-verification sign-off
Owner: Category Manager (Paint)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2335_Assoc10" sourceRef="W2335_Annotation9" targetRef="W2335_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2335_Flow11" sourceRef="W2335_Start4" targetRef="W2335_Task5" />
      <bpmn:sequenceFlow id="W2335_Flow12" sourceRef="W2335_Task5" targetRef="W2335_Task6" />
      <bpmn:sequenceFlow id="W2335_Flow13" sourceRef="W2335_Task6" targetRef="W2335_Task7" />
      <bpmn:sequenceFlow id="W2335_Flow14" sourceRef="W2335_Task7" targetRef="W2335_End8" />
    </bpmn:process>
