    <bpmn:process id="W_W2340" name="W2340. Sample-to-Order Conversion Process" isExecutable="false">
      <bpmn:documentation>Trigger: Customer selects product based on sample display
Frequency: Continuous; ~2,000–3,000 sample-assisted sales/month
Volume: ~2K–3K/month across tile, flooring, countertop categories
Owner: Sales Associate
Participants: Sales Associate, Customer, CRM
Source: workflow W2340 — Sample-to-Order Conversion Process</bpmn:documentation>
      <bpmn:laneSet id="W2340_LaneSet3">
        <bpmn:lane id="W2340_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W2340_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2340_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2340_Lane2" name="System">
        <bpmn:flowNodeRef>W2340_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2340_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2340_Start4" name="Customer selects product based on sample display">
        <bpmn:outgoing>W2340_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2340_Task5" name="Sales Associate assists the customer at the sample display; identifies the…">
        <bpmn:documentation>Step 1: Sales Associate assists the customer at the sample display; identifies the selected sample; scans the sample barcode or looks up the SKU in the system; checks sellable inventory and current pricing; creates a quote or sales order (special order for countertops per W38)
Responsible (R): Sales Associate
Accountable (A): Department Supervisor
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2340_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2340_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2340_Task6" name="System logs the sample-assisted sale: sample-ID → parent-SKU → transaction…">
        <bpmn:documentation>Step 2: System logs the sample-assisted sale: sample-ID → parent-SKU → transaction; tracks the conversion rate per sample per store; feeds the sample-ROI analytics that justify the W2338 sample-program spend
Responsible (R): System
Accountable (A): Category Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2340_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2340_End7" name="Complete">
        <bpmn:incoming>W2340_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2340_Annotation8">
        <bpmn:text>Controls: - CTL-415 (ensure controlled execution — Sample Inventory Procurement &amp; Distribution (PA-62.1).) | - operational: sample-SKU transaction integrity — the attribution link must not corrupt sellable-inventory financials; operational: Department Supervisor visibility on sample-assisted sale rate
Owner: Sales Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2340_Assoc9" sourceRef="W2340_Annotation8" targetRef="W2340_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2340_Flow10" sourceRef="W2340_Start4" targetRef="W2340_Task5" />
      <bpmn:sequenceFlow id="W2340_Flow11" sourceRef="W2340_Task5" targetRef="W2340_Task6" />
      <bpmn:sequenceFlow id="W2340_Flow12" sourceRef="W2340_Task6" targetRef="W2340_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2340_diag">
      <bpmndi:BPMNPlane id="W2340_plane" bpmnElement="W_W2340">
        <bpmndi:BPMNShape id="W2340_Lane1_di" bpmnElement="W2340_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
