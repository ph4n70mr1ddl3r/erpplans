<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-62.1-sample-inventory-procurement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2334" name="W2334. Tile &amp; Flooring Sample Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly sample refresh or new product launch
Frequency: Quarterly; ~200 stores × 8–10 tile sample boards
Volume: ~1,600–2,000 tile sample boards/quarter
Owner: Category Manager (Tiles)
Participants: Category Mgr, Vendor, Merch Planner, DC Ops
Source: workflow W2334 — Tile &amp; Flooring Sample Procurement</bpmn:documentation>
      <bpmn:laneSet id="W2334_LaneSet4">
        <bpmn:lane id="W2334_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2334_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2334_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2334_Lane2" name="Vendor">
        <bpmn:flowNodeRef>W2334_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2334_Lane3" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2334_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2334_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2334_Start5" name="Quarterly sample refresh or new product launch">
        <bpmn:outgoing>W2334_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2334_Task6" name="Category Manager selects the tile/flooring SKUs requiring physical sample…">
        <bpmn:documentation>Step 1: Category Manager selects the tile/flooring SKUs requiring physical sample displays (the A/B movers where a tactile sample lifts conversion); coordinates with the vendor for sample production — physical tile pieces mounted on display boards with the SKU, price, and spec card
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2334_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2334_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2334_Task7" name="Vendor delivers the sample boards to the DC; DC distributes to the 200 stores…">
        <bpmn:documentation>Step 2: Vendor delivers the sample boards to the DC; DC distributes to the 200 stores via the regular replenishment cycle (samples ride alongside merchandise POs to avoid a separate freight line); Store Manager merchandises the samples in the Tile Gallery zone per the VS-55 planogram
Responsible (R): Vendor / DC / Store Manager
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2334_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2334_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2334_Task8" name="System tags each sample board with a sample-SKU (distinct from the sellable…">
        <bpmn:documentation>Step 3: System tags each sample board with a sample-SKU (distinct from the sellable SKU) so sample inventory is tracked separately from sellable inventory and the W2340 sample-to-order conversion can attribute the sale
Responsible (R): Merch Coordinator
Accountable (A): Category Manager
Duration: Per refresh</bpmn:documentation>
        <bpmn:incoming>W2334_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2334_End9" name="Complete">
        <bpmn:incoming>W2334_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2334_Annotation10">
        <bpmn:text>Controls: - CTL-415 (ensure controlled execution — Sample Inventory Procurement &amp; Distribution (PA-62.1).) | - operational: sample inventory tracked separately — prevents a sample-SKU transaction from corrupting sellable-inventory counts; operational: Store Manager display-condition check in the VS-07 daily walk
Owner: Category Manager (Tiles)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2334_Assoc11" sourceRef="W2334_Annotation10" targetRef="W2334_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2334_Flow12" sourceRef="W2334_Start5" targetRef="W2334_Task6" />
      <bpmn:sequenceFlow id="W2334_Flow13" sourceRef="W2334_Task6" targetRef="W2334_Task7" />
      <bpmn:sequenceFlow id="W2334_Flow14" sourceRef="W2334_Task7" targetRef="W2334_Task8" />
      <bpmn:sequenceFlow id="W2334_Flow15" sourceRef="W2334_Task8" targetRef="W2334_End9" />
    </bpmn:process>
