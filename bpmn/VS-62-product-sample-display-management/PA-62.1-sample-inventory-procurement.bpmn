    <bpmn:process id="W_W2338" name="W2338. Sample Vendor Negotiation &amp; Cost Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor review for sample costs
Frequency: Annual; ~20 sample vendors
Volume: ~20 vendor negotiations/year
Owner: Category Manager
Participants: Category Mgr, Procurement, Finance
Source: workflow W2338 — Sample Vendor Negotiation &amp; Cost Management</bpmn:documentation>
      <bpmn:laneSet id="W2338_LaneSet2">
        <bpmn:lane id="W2338_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2338_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2338_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2338_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2338_Start3" name="Annual vendor review for sample costs">
        <bpmn:outgoing>W2338_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2338_Task4" name="Category Manager negotiates the sample costs with each of the ~20 sample…">
        <bpmn:documentation>Step 1: Category Manager negotiates the sample costs with each of the ~20 sample vendors: tile boards, color cards, countertop chips; samples are typically vendor-funded (the vendor absorbs the cost as a co-marketing investment) or cost-shared; the negotiated terms feed the vendor co-op budget per VS-39
Responsible (R): Category Manager / Procurement
Accountable (A): Finance Manager
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W2338_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2338_End5" name="Complete">
        <bpmn:incoming>W2338_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2338_Annotation6">
        <bpmn:text>Controls: - CTL-39 (rebate/co-op accuracy — the sample cost-sharing validated against the agreement); CTL-48 (rebate-dispute resolution if the vendor disputes the cost-share)
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2338_Assoc7" sourceRef="W2338_Annotation6" targetRef="W2338_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2338_Flow8" sourceRef="W2338_Start3" targetRef="W2338_Task4" />
      <bpmn:sequenceFlow id="W2338_Flow9" sourceRef="W2338_Task4" targetRef="W2338_End5" />
    </bpmn:process>
