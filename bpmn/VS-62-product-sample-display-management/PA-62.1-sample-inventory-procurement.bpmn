        <bpmndi:BPMNShape id="W2335_Annotation9_di" bpmnElement="W2335_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2335_Flow11_di" bpmnElement="W2335_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2335_Flow12_di" bpmnElement="W2335_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2335_Flow13_di" bpmnElement="W2335_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2335_Flow14_di" bpmnElement="W2335_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2335_Assoc10_di" bpmnElement="W2335_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2336" name="W2336. Countertop &amp; Surface Material Sample Distribution" isExecutable="false">
      <bpmn:documentation>Trigger: New product launch or annual refresh
Frequency: Annual + new launches; ~200 stores × 5–8 samples
Volume: ~1,000–1,600 countertop samples/cycle
Owner: Category Manager (Building Materials)
Participants: Category Mgr, Vendor, Merch Planner, DC Ops
Source: workflow W2336 — Countertop &amp; Surface Material Sample Distribution</bpmn:documentation>
      <bpmn:laneSet id="W2336_LaneSet3">
        <bpmn:lane id="W2336_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2336_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2336_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2336_Lane2" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2336_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2336_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2336_Start4" name="New product launch or annual refresh">
        <bpmn:outgoing>W2336_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2336_Task5" name="Manager selects the countertop SKUs for sample display (granite, quartz…">
        <bpmn:documentation>Step 1: Manager selects the countertop SKUs for sample display (granite, quartz, laminate — the materials where the tactile/visual sample is decisive); vendor produces the sample chips; distributed via the DC; stores display in the dedicated countertop zone
Responsible (R): Category Manager / Vendor
Accountable (A): VP Merchandising
Duration: 2–3 days + 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2336_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2336_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2336_Task6" name="System tags the countertop sample chips with sample-SKUs tied to the sellable…">
        <bpmn:documentation>Step 2: System tags the countertop sample chips with sample-SKUs tied to the sellable parent (the full-slab SKU), enabling the W2340 sample-to-order attribution
Responsible (R): Merch Coordinator
Accountable (A): Category Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W2336_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2336_End7" name="Complete">
        <bpmn:incoming>W2336_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2336_Annotation8">
        <bpmn:text>Controls: - CTL-179: warranty/return integrity — a variation-dispute return; operational: &quot;natural variation&quot; disclosure standard on every stone sample
Owner: Category Manager (Building Materials)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2336_Assoc9" sourceRef="W2336_Annotation8" targetRef="W2336_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2336_Flow10" sourceRef="W2336_Start4" targetRef="W2336_Task5" />
      <bpmn:sequenceFlow id="W2336_Flow11" sourceRef="W2336_Task5" targetRef="W2336_Task6" />
      <bpmn:sequenceFlow id="W2336_Flow12" sourceRef="W2336_Task6" targetRef="W2336_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2336_diag">
      <bpmndi:BPMNPlane id="W2336_plane" bpmnElement="W_W2336">
        <bpmndi:BPMNShape id="W2336_Lane1_di" bpmnElement="W2336_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_Lane2_di" bpmnElement="W2336_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="740" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_Task5_di" bpmnElement="W2336_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_Task6_di" bpmnElement="W2336_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_Start4_di" bpmnElement="W2336_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_End7_di" bpmnElement="W2336_End7"><dc:Bounds x="840" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2336_Annotation8_di" bpmnElement="W2336_Annotation8"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2336_Flow10_di" bpmnElement="W2336_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2336_Flow11_di" bpmnElement="W2336_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2336_Flow12_di" bpmnElement="W2336_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2336_Assoc9_di" bpmnElement="W2336_Assoc9"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2337" name="W2337. Sample Inventory Tracking &amp; Replenishment" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly inventory review of sample stock
Frequency: Monthly; 200 stores
Volume: ~200 store sample inventories/month
Owner: Merchandising Coordinator
Participants: Merch Coordinator, Store Manager, DC Ops
Source: workflow W2337 — Sample Inventory Tracking &amp; Replenishment</bpmn:documentation>
      <bpmn:laneSet id="W2337_LaneSet3">
        <bpmn:lane id="W2337_Lane1" name="System">
        <bpmn:flowNodeRef>W2337_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2337_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2337_Lane2" name="Merch Coordinator">
        <bpmn:flowNodeRef>W2337_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2337_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2337_Start4" name="Monthly inventory review of sample stock">
        <bpmn:outgoing>W2337_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2337_Task5" name="System tracks the sample inventory per store: tile boards, color cards…">
        <bpmn:documentation>Step 1: System tracks the sample inventory per store: tile boards, color cards, countertop chips, fabric swatches — each as a tracked sample-SKU; flags stores with damaged/missing samples below the minimum threshold (e.g., &lt;6 of 10 tile boards present)
Responsible (R): System / Merch Coordinator
Accountable (A): Merchandising Planner
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2337_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2337_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2337_Task6" name="Coordinator generates replenishment orders for the below-threshold stores…">
        <bpmn:documentation>Step 2: Coordinator generates replenishment orders for the below-threshold stores; samples picked at the DC and shipped with the regular store delivery; Store Manager confirms receipt and re-displays
Responsible (R): Merch Coordinator / DC
Accountable (A): Store Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2337_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2337_End7" name="Complete">
        <bpmn:incoming>W2337_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2337_Annotation8">
        <bpmn:text>Controls: - CTL-51: stale/incomplete sample master — the sample-SKU must be current; operational: Merch Coordinator monthly review of the sample-presence rate per store
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2337_Assoc9" sourceRef="W2337_Annotation8" targetRef="W2337_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2337_Flow10" sourceRef="W2337_Start4" targetRef="W2337_Task5" />
      <bpmn:sequenceFlow id="W2337_Flow11" sourceRef="W2337_Task5" targetRef="W2337_Task6" />
      <bpmn:sequenceFlow id="W2337_Flow12" sourceRef="W2337_Task6" targetRef="W2337_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2337_diag">
      <bpmndi:BPMNPlane id="W2337_plane" bpmnElement="W_W2337">
        <bpmndi:BPMNShape id="W2337_Lane1_di" bpmnElement="W2337_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
