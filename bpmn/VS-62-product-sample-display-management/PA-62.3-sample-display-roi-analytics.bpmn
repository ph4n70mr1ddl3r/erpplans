<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-62.3-sample-display-roi-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2350" name="W2350. Sample Program Cost Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial analysis
Frequency: Monthly; all sample programs
Volume: All sample categories
Owner: Finance Analyst
Participants: Finance Analyst, Category Mgr, VP Merchandising
Source: workflow W2350 — Sample Program Cost Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2350_LaneSet2">
        <bpmn:lane id="W2350_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2350_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2350_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2350_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2350_Start3" name="Monthly financial analysis">
        <bpmn:outgoing>W2350_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2350_Task4" name="Finance Analyst tracks the full sample-program cost per category: sample…">
        <bpmn:documentation>Step 1: Finance Analyst tracks the full sample-program cost per category: sample procurement (W2334–W2336), distribution (DC freight allocation), display maintenance (W2343/W2344 labor + materials), digital tool cost (W2339/W2346); computes the total sample-program cost per category per quarter, split by BuildRight-funded vs. vendor-funded (from W2338)
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2350_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2350_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2350_End5" name="Complete">
        <bpmn:incoming>W2350_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2350_Annotation6">
        <bpmn:text>Controls: - CTL-39: co-op/rebate accuracy — the vendor-funded portion validated; operational: Finance Manager monthly sign-off on the cost report
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2350_Assoc7" sourceRef="W2350_Annotation6" targetRef="W2350_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2350_Flow8" sourceRef="W2350_Start3" targetRef="W2350_Task4" />
      <bpmn:sequenceFlow id="W2350_Flow9" sourceRef="W2350_Task4" targetRef="W2350_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2350_diag">
      <bpmndi:BPMNPlane id="W2350_plane" bpmnElement="W_W2350">
        <bpmndi:BPMNShape id="W2350_Lane1_di" bpmnElement="W2350_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2350_Task4_di" bpmnElement="W2350_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2350_Start3_di" bpmnElement="W2350_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2350_End5_di" bpmnElement="W2350_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2350_Annotation6_di" bpmnElement="W2350_Annotation6"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
