        <bpmndi:BPMNEdge id="W2350_Flow9_di" bpmnElement="W2350_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2350_Assoc7_di" bpmnElement="W2350_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2351" name="W2351. Sample-to-Order Conversion Rate Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analysis cycle — Sample-to-Order Conversion Rate
Frequency: Monthly; 200 stores
Volume: ~200 stores/month
Owner: Analytics Manager
Participants: Analytics Manager, Category Mgr, Sales Associates
Source: workflow W2351 — Sample-to-Order Conversion Rate Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2351_LaneSet2">
        <bpmn:lane id="W2351_Lane1" name="Analytics Manager">
        <bpmn:flowNodeRef>W2351_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2351_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2351_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2351_Start3" name="Monthly analysis cycle — Sample-to-Order Conversion Rate">
        <bpmn:outgoing>W2351_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2351_Task4" name="Analytics Manager computes the sample-to-order conversion rate: % of sample…">
        <bpmn:documentation>Step 1: Analytics Manager computes the sample-to-order conversion rate: % of sample interactions (W2340 sample-assisted sales ÷ estimated sample interactions, where interaction is captured by sample-SKU scan or zone-traffic sensor); by category, by sample-SKU, by store; identifies the highest-converting samples and the underperformers; recommends display changes (add/expand the winners, retire the losers)
Responsible (R): Analytics Manager
Accountable (A): Category Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2351_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2351_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2351_End5" name="Complete">
        <bpmn:incoming>W2351_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2351_Annotation6">
        <bpmn:text>Controls: - CTL-417 (ensure controlled execution — Sample &amp; Display ROI Analytics (PA-62.3).) | - Operational: Analytics Manager methodology sign-off (numerator/denominator definitions documented)
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2351_Assoc7" sourceRef="W2351_Annotation6" targetRef="W2351_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2351_Flow8" sourceRef="W2351_Start3" targetRef="W2351_Task4" />
      <bpmn:sequenceFlow id="W2351_Flow9" sourceRef="W2351_Task4" targetRef="W2351_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2351_diag">
      <bpmndi:BPMNPlane id="W2351_plane" bpmnElement="W_W2351">
        <bpmndi:BPMNShape id="W2351_Lane1_di" bpmnElement="W2351_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2351_Task4_di" bpmnElement="W2351_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2351_Start3_di" bpmnElement="W2351_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2351_End5_di" bpmnElement="W2351_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2351_Annotation6_di" bpmnElement="W2351_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2351_Flow8_di" bpmnElement="W2351_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2351_Flow9_di" bpmnElement="W2351_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2351_Assoc7_di" bpmnElement="W2351_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2352" name="W2352. Display Zone Sales Attribution" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly deep analysis
Frequency: Quarterly; display zones across 200 stores
Volume: ~1,600 zones analyzed
Owner: Analytics Manager
Participants: Analytics Manager, Category Mgr, VP Merchandising
Source: workflow W2352 — Display Zone Sales Attribution</bpmn:documentation>
      <bpmn:laneSet id="W2352_LaneSet2">
        <bpmn:lane id="W2352_Lane1" name="Analytics Manager">
        <bpmn:flowNodeRef>W2352_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2352_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2352_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2352_Start3" name="Quarterly deep analysis">
        <bpmn:outgoing>W2352_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2352_Task4" name="Analytics Manager attributes sales to the display zones: compares sales per sqm…">
        <bpmn:documentation>Step 1: Analytics Manager attributes sales to the display zones: compares sales per sqm in the sample-display zones vs. comparable non-display zones in the same category (a quasi-controlled comparison); measures the uplift attributable to the sample presence to justify the space allocation
Responsible (R): Analytics Manager
Accountable (A): VP Merchandising
Duration: 3–5 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2352_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2352_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2352_End5" name="Complete">
        <bpmn:incoming>W2352_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2352_Annotation6">
        <bpmn:text>Controls: - CTL-417 (ensure controlled execution — Sample &amp; Display ROI Analytics (PA-62.3).) | - Operational: Analytics Manager methodology sign-off (comparable-zone selection documented); VP Merchandising review of the attribution before it feeds space decisions
Owner: Analytics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2352_Assoc7" sourceRef="W2352_Annotation6" targetRef="W2352_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2352_Flow8" sourceRef="W2352_Start3" targetRef="W2352_Task4" />
      <bpmn:sequenceFlow id="W2352_Flow9" sourceRef="W2352_Task4" targetRef="W2352_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2352_diag">
      <bpmndi:BPMNPlane id="W2352_plane" bpmnElement="W_W2352">
        <bpmndi:BPMNShape id="W2352_Lane1_di" bpmnElement="W2352_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2352_Task4_di" bpmnElement="W2352_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2352_Start3_di" bpmnElement="W2352_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2352_End5_di" bpmnElement="W2352_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2352_Annotation6_di" bpmnElement="W2352_Annotation6"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
