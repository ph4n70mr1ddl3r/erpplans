        <bpmndi:BPMNShape id="W2353_Lane1_di" bpmnElement="W2353_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2353_Task4_di" bpmnElement="W2353_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2353_Start3_di" bpmnElement="W2353_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2353_End5_di" bpmnElement="W2353_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2353_Annotation6_di" bpmnElement="W2353_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2353_Flow8_di" bpmnElement="W2353_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2353_Flow9_di" bpmnElement="W2353_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2353_Assoc7_di" bpmnElement="W2353_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2354" name="W2354. Customer Feedback on Sample Experience" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly survey cycle — Customer Feedback Sample Experience
Frequency: Quarterly; ~500 respondents
Volume: ~500 respondents/quarter
Owner: Customer Experience Manager
Participants: CX Manager, Category Mgr, Marketing Research
Source: workflow W2354 — Customer Feedback on Sample Experience</bpmn:documentation>
      <bpmn:laneSet id="W2354_LaneSet2">
        <bpmn:lane id="W2354_Lane1" name="CX Manager">
        <bpmn:flowNodeRef>W2354_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2354_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2354_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2354_Start3" name="Quarterly survey cycle — Customer Feedback Sample Experience">
        <bpmn:outgoing>W2354_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2354_Task4" name="CX Manager fields a sample-experience survey: customer satisfaction with the…">
        <bpmn:documentation>Step 1: CX Manager fields a sample-experience survey: customer satisfaction with the sample displays, usefulness of physical samples (which categories most need a tactile sample?), interest in the digital/AR tools (W2339), suggestions for improvement; the findings feed the display strategy (W2357 roadmap) and the per-category display decisions
Responsible (R): CX Manager
Accountable (A): VP Marketing
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2354_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2354_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2354_End5" name="Complete">
        <bpmn:incoming>W2354_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2354_Annotation6">
        <bpmn:text>Controls: - CTL-417 (ensure controlled execution — Sample &amp; Display ROI Analytics (PA-62.3).) | - Operational: CX Manager methodology sign-off; Category Manager review of category-specific findings
Owner: Customer Experience Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2354_Assoc7" sourceRef="W2354_Annotation6" targetRef="W2354_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2354_Flow8" sourceRef="W2354_Start3" targetRef="W2354_Task4" />
      <bpmn:sequenceFlow id="W2354_Flow9" sourceRef="W2354_Task4" targetRef="W2354_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2354_diag">
      <bpmndi:BPMNPlane id="W2354_plane" bpmnElement="W_W2354">
        <bpmndi:BPMNShape id="W2354_Lane1_di" bpmnElement="W2354_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2354_Task4_di" bpmnElement="W2354_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2354_Start3_di" bpmnElement="W2354_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2354_End5_di" bpmnElement="W2354_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2354_Annotation6_di" bpmnElement="W2354_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2354_Flow8_di" bpmnElement="W2354_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2354_Flow9_di" bpmnElement="W2354_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2354_Assoc7_di" bpmnElement="W2354_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2355" name="W2355. Digital vs. Physical Sample Effectiveness" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual comparison
Frequency: Semi-annual
Volume: Digital tool users vs. in-store sample users
Owner: Digital Product Manager
Participants: Digital PM, Analytics Manager, Category Mgr
Source: workflow W2355 — Digital vs. Physical Sample Effectiveness</bpmn:documentation>
      <bpmn:laneSet id="W2355_LaneSet2">
        <bpmn:lane id="W2355_Lane1" name="Digital PM">
        <bpmn:flowNodeRef>W2355_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2355_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2355_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2355_Start3" name="Semi-annual comparison">
        <bpmn:outgoing>W2355_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2355_Task4" name="Digital PM compares the digital tool (AR visualizer, W2339) vs. the physical…">
        <bpmn:documentation>Step 1: Digital PM compares the digital tool (AR visualizer, W2339) vs. the physical sample: usage → conversion rate, cost-per-conversion (digital tool cost vs. physical sample cost from W2350), customer preference (from W2354); recommends the channel-investment split (which categories benefit more from a physical sample vs. a digital tool)
Responsible (R): Digital PM / Analytics Manager
Accountable (A): VP Marketing
Duration: 3–5 days/semi-annual</bpmn:documentation>
        <bpmn:incoming>W2355_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2355_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2355_End5" name="Complete">
        <bpmn:incoming>W2355_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2355_Annotation6">
