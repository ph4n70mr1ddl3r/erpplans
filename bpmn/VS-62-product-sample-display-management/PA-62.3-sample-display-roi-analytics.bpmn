        <bpmndi:BPMNEdge id="W2352_Flow9_di" bpmnElement="W2352_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2352_Assoc7_di" bpmnElement="W2352_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2353" name="W2353. Sample Program Annual ROI" isExecutable="false">
      <bpmn:documentation>Trigger: Annual comprehensive review
Frequency: Annual
Volume: Full sample program
Owner: FP&amp;A Analyst
Participants: FP&amp;A, Category Mgrs, VP Merchandising
Source: workflow W2353 — Sample Program Annual ROI</bpmn:documentation>
      <bpmn:laneSet id="W2353_LaneSet2">
        <bpmn:lane id="W2353_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2353_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2353_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2353_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2353_Start3" name="Annual comprehensive review">
        <bpmn:outgoing>W2353_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2353_Task4" name="FP&amp;A Analyst computes the annual sample-program ROI: total program cost (from…">
        <bpmn:documentation>Step 1: FP&amp;A Analyst computes the annual sample-program ROI: total program cost (from W2350) vs. the incremental revenue attributed to sample displays (from W2352 uplift × category margin); ROI by category; recommends next-year budget allocation across categories and across physical vs. digital (W2355)
Responsible (R): FP&amp;A Analyst
Accountable (A): CFO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2353_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2353_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2353_End5" name="Complete">
        <bpmn:incoming>W2353_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2353_Annotation6">
        <bpmn:text>Controls: - CTL-417 (ensure controlled execution — Sample &amp; Display ROI Analytics (PA-62.3).) | - CTL-417 (budget-allocation accuracy — links to VS-17 / W26); operational: CFO sign-off on the ROI methodology and budget recommendation
Owner: FP&amp;A Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2353_Assoc7" sourceRef="W2353_Annotation6" targetRef="W2353_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2353_Flow8" sourceRef="W2353_Start3" targetRef="W2353_Task4" />
      <bpmn:sequenceFlow id="W2353_Flow9" sourceRef="W2353_Task4" targetRef="W2353_End5" />
    </bpmn:process>
