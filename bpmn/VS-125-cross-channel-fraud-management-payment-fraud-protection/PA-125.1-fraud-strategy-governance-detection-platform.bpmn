      <bpmn:sequenceFlow id="W3858_Flow12" sourceRef="W3858_Task5" targetRef="W3858_Task6" />
      <bpmn:sequenceFlow id="W3858_Flow13" sourceRef="W3858_Task6" targetRef="W3858_End7" />
    </bpmn:process>
