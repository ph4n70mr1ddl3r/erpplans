        <bpmndi:BPMNShape id="W4155_Start3_di" bpmnElement="W4155_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4155_End7_di" bpmnElement="W4155_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4155_Annotation8_di" bpmnElement="W4155_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4155_Flow10_di" bpmnElement="W4155_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4155_Flow11_di" bpmnElement="W4155_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4155_Flow12_di" bpmnElement="W4155_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4155_Flow13_di" bpmnElement="W4155_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4155_Assoc9_di" bpmnElement="W4155_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4156" name="W4156. How-To &amp; Rich Content Authoring (Guides, Video, 360°)" isExecutable="false">
      <bpmn:documentation>Trigger: Category enrichment; content-strategy gap; SEO/performance objective
Frequency: Continuous (prioritized backlog)
Volume: High-consideration categories (paint, tiling, plumbing, electrical, lumber)
Owner: Content Marketing Lead (VS-14) / DAM
Participants: Trade specialists, Marketing (VS-14), Ecommerce (VS-10), Associate-enablement (VS-124)
Source: workflow W4156 — How-To &amp; Rich Content Authoring (Guides, Video, 360°)</bpmn:documentation>
      <bpmn:laneSet id="W4156_LaneSet2">
        <bpmn:lane id="W4156_Lane1" name="Content Marketing Lead">
        <bpmn:flowNodeRef>W4156_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4156_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4156_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4156_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4156_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4156_Start3" name="Category enrichment; content-strategy gap; SEO/performance objective">
        <bpmn:outgoing>W4156_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4156_Task4" name="Content/Marketing identify rich-content priorities from search analytics…">
        <bpmn:documentation>Step 1: Content/Marketing identify rich-content priorities from search analytics (VS-10), customer questions (VS-13), and selling gaps (VS-124), and plan the content (how-to guide, project calculator, video, 360° view, comparison table)
Responsible (R): Content Marketing Lead / SEO
Accountable (A): Director Marketing
Duration: Per asset</bpmn:documentation>
        <bpmn:incoming>W4156_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4156_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4156_Task5" name="Content/Trade specialist author the rich content (consultative how-to —…">
        <bpmn:documentation>Step 2: Content/Trade specialist author the rich content (consultative how-to — distinct from spec), produce video/360°, and bind to the product/category in DAM (W4153) and PDP
Responsible (R): Content Marketing Lead / Trade Specialist / Studio
Accountable (A): Director Marketing
Duration: Per asset</bpmn:documentation>
        <bpmn:incoming>W4156_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4156_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4156_Task6" name="Content review/approve (brand, accuracy, safety claims), publish to the…">
