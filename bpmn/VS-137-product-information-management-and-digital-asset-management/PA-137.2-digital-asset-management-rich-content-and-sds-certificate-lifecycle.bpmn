        <bpmn:outgoing>W4160_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4160_Task4" name="PIM/QA run pre-publish QA — completeness gate (W4147), rendering check on…">
        <bpmn:documentation>Step 1: PIM/QA run pre-publish QA — completeness gate (W4147), rendering check on web/storefront/app/marketplace, image-load, spec-display, and mobile-responsiveness
Responsible (R): PIM QA / Ecommerce
Accountable (A): PIM Content Lead
Duration: Per publish</bpmn:documentation>
        <bpmn:incoming>W4160_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4160_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4160_Task5" name="PIM/QA run periodic content audits — accuracy sample (price/spec/SDS…">
        <bpmn:documentation>Step 2: PIM/QA run periodic content audits — accuracy sample (price/spec/SDS correctness), broken-image/link check, channel-consistency check across the 6 channels — and log defects
Responsible (R): PIM QA / Audit
Accountable (A): PIM Content Lead
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4160_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4160_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4160_Task6" name="PIM/QA triage defects to owners (W4147), remediate, verify fix, and report…">
        <bpmn:documentation>Step 3: PIM/QA triage defects to owners (W4147), remediate, verify fix, and report content-quality KPIs to governance (W4147/VS-133)
Responsible (R): PIM QA
Accountable (A): PIM Owner
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4160_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4160_End7" name="Complete">
        <bpmn:incoming>W4160_Flow13</bpmn:incoming>
      </bpmn:endEvent>
