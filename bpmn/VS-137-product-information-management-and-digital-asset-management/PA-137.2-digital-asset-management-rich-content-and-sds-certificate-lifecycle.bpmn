      <bpmn:sequenceFlow id="W4155_Flow11" sourceRef="W4155_Task4" targetRef="W4155_Task5" />
      <bpmn:sequenceFlow id="W4155_Flow12" sourceRef="W4155_Task5" targetRef="W4155_Task6" />
      <bpmn:sequenceFlow id="W4155_Flow13" sourceRef="W4155_Task6" targetRef="W4155_End7" />
    </bpmn:process>
