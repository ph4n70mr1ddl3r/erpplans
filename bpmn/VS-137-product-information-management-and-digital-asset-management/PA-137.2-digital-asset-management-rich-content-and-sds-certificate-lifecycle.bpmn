      <bpmndi:BPMNPlane id="W4155_plane" bpmnElement="W_W4155">
        <bpmndi:BPMNShape id="W4155_Lane1_di" bpmnElement="W4155_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
