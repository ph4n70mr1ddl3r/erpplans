      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4154" name="W4154. Product Image &amp; Media Production Lifecycle" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU; rebrand; channel requirement (marketplace image spec); refresh cycle
Frequency: Continuous (~150–230 new SKUs/mo + refresh backlog)
Volume: Multiple images/SKU (main, alternate, lifestyle, in-context); ~35,000 SKUs
Owner: DAM Manager / Studio Lead
Participants: Studio/photography, Marketing (VS-14), Vendor (supplied assets), Ecommerce (VS-10)
Source: workflow W4154 — Product Image &amp; Media Production Lifecycle</bpmn:documentation>
      <bpmn:laneSet id="W4154_LaneSet3">
        <bpmn:lane id="W4154_Lane1" name="Studio Lead">
        <bpmn:flowNodeRef>W4154_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4154_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4154_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4154_Lane2" name="DAM Manager">
        <bpmn:flowNodeRef>W4154_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4154_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4154_Start4" name="New SKU; rebrand; channel requirement (marketplace image spec); refresh cycle">
        <bpmn:outgoing>W4154_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4154_Task5" name="DAM/Studio define the image standard per category (count, angles…">
        <bpmn:documentation>Step 1: DAM/Studio define the image standard per category (count, angles, white-background vs lifestyle, resolution, marketplace/Lazada-Shopee specs links to VS-65) and the production plan prioritizing A/B items
Responsible (R): Studio Lead / Marketing
Accountable (A): DAM Manager
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W4154_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4154_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4154_Task6" name="DAM/Studio shoot/produce or ingest vendor-supplied media, post-process…">
        <bpmn:documentation>Step 2: DAM/Studio shoot/produce or ingest vendor-supplied media, post-process (crop/retouch/color-manage), and ingest into DAM with bound metadata (W4153)
Responsible (R): Studio Lead / DAM
Accountable (A): DAM Manager
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W4154_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4154_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4154_Task7" name="DAM/Marketing review/approve (brand standards, accuracy), version (W4158), and…">
        <bpmn:documentation>Step 3: DAM/Marketing review/approve (brand standards, accuracy), version (W4158), and publish to channels (W4159); re-shoot on quality-fail
Responsible (R): DAM Manager / Marketing
Accountable (A): DAM Manager
Duration: Per SKU</bpmn:documentation>
        <bpmn:incoming>W4154_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4154_End8" name="Complete">
        <bpmn:incoming>W4154_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4154_Annotation9">
        <bpmn:text>Controls: - CTL-642 (ensure controlled execution — Digital Asset Management, Rich Content &amp; SDS/Certificate Lifecycle (PA-137.2).) | - CTL-642: brand-approval gate before publish; marketplace-spec compliance check
Owner: DAM Manager / Studio Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4154_Assoc10" sourceRef="W4154_Annotation9" targetRef="W4154_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4154_Flow11" sourceRef="W4154_Start4" targetRef="W4154_Task5" />
      <bpmn:sequenceFlow id="W4154_Flow12" sourceRef="W4154_Task5" targetRef="W4154_Task6" />
      <bpmn:sequenceFlow id="W4154_Flow13" sourceRef="W4154_Task6" targetRef="W4154_Task7" />
      <bpmn:sequenceFlow id="W4154_Flow14" sourceRef="W4154_Task7" targetRef="W4154_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4154_diag">
      <bpmndi:BPMNPlane id="W4154_plane" bpmnElement="W_W4154">
        <bpmndi:BPMNShape id="W4154_Lane1_di" bpmnElement="W4154_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4154_Lane2_di" bpmnElement="W4154_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
