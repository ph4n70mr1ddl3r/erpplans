    <bpmn:process id="W_W4162" name="W4162. Price, Promotion &amp; Availability Content Sync" isExecutable="false">
      <bpmn:documentation>Trigger: Price change (VS-57/VS-16); promotion (VS-58); availability change (VS-05)
Frequency: Real-time / near-real-time
Volume: 35,000 SKUs × 6 channels; ~2.8M monthly POS + ~42,900 ecommerce orders/mo
Owner: PIM Content Lead / Ecommerce Operations (VS-10) / Pricing (VS-57)
Participants: Pricing (VS-57), Ecommerce (VS-10), Promotion (VS-58), Inventory (VS-05)
Source: workflow W4162 — Price, Promotion &amp; Availability Content Sync</bpmn:documentation>
      <bpmn:laneSet id="W4162_LaneSet2">
        <bpmn:lane id="W4162_Lane1" name="PIM Content Lead">
        <bpmn:flowNodeRef>W4162_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4162_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4162_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4162_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4162_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4162_Start3" name="Price change (VS-57/VS-16); promotion (VS-58); availability change (VS-05)">
        <bpmn:outgoing>W4162_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4162_Task4" name="PIM/Ecommerce/Pricing sync price content (SRP, trade price, promo price) from…">
        <bpmn:documentation>Step 1: PIM/Ecommerce/Pricing sync price content (SRP, trade price, promo price) from the authoritative pricing source (VS-57/VS-16) to all channels in real-time, with display-price computation (VAT-inclusive, mandatory-discount links to VS-85)
Responsible (R): PIM Content Lead / Pricing / Ecommerce Ops
Accountable (A): Director Ecommerce
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W4162_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4162_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4162_Task5" name="PIM/Ecommerce sync promotion content (badges, callouts, validity links to…">
        <bpmn:documentation>Step 2: PIM/Ecommerce sync promotion content (badges, callouts, validity links to VS-58) and availability (per-store real-time stock links to VS-10 §8.4) consistently across channels
Responsible (R): PIM Content Lead / Ecommerce Ops
Accountable (A): Director Ecommerce
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W4162_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4162_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4162_Task6" name="PIM/Ecommerce monitor sync latency/errors, reconcile price/availability…">
        <bpmn:documentation>Step 3: PIM/Ecommerce monitor sync latency/errors, reconcile price/availability discrepancies (links to VS-118 revenue-assurance price integrity), and escalate stale data
Responsible (R): PIM Content Lead / Ecommerce Ops
Accountable (A): Director Ecommerce
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4162_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4162_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4162_End7" name="Complete">
        <bpmn:incoming>W4162_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4162_Annotation8">
        <bpmn:text>Controls: - CTL-643 (ensure controlled execution — Content Syndication, Channel Publishing &amp; PIM Analytics (PA-137.3).) | - CTL-643: single authoritative pricing source; real-time sync with discrepancy monitoring (VS-118)
Owner: PIM Content Lead / Ecommerce Operations (VS-10) / Pricing (VS-57)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4162_Assoc9" sourceRef="W4162_Annotation8" targetRef="W4162_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4162_Flow10" sourceRef="W4162_Start3" targetRef="W4162_Task4" />
      <bpmn:sequenceFlow id="W4162_Flow11" sourceRef="W4162_Task4" targetRef="W4162_Task5" />
      <bpmn:sequenceFlow id="W4162_Flow12" sourceRef="W4162_Task5" targetRef="W4162_Task6" />
      <bpmn:sequenceFlow id="W4162_Flow13" sourceRef="W4162_Task6" targetRef="W4162_End7" />
    </bpmn:process>
