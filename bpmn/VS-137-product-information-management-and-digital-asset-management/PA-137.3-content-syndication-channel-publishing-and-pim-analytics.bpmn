    <bpmn:process id="W_W4163" name="W4163. Product Content Performance &amp; SEO Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic review; SEO/content-strategy cycle
Frequency: Weekly/monthly
Volume: 35,000 SKUs; web/app/marketplace/search analytics
Owner: PIM Content Lead / Ecommerce Analytics (VS-28/VS-10)
Participants: SEO (VS-10), Marketing (VS-14), Ecommerce (VS-10), Insights (VS-44)
Source: workflow W4163 — Product Content Performance &amp; SEO Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4163_LaneSet2">
        <bpmn:lane id="W4163_Lane1" name="PIM Content Lead">
        <bpmn:flowNodeRef>W4163_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4163_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4163_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4163_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4163_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4163_Start3" name="Periodic review; SEO/content-strategy cycle">
        <bpmn:outgoing>W4163_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4163_Task4" name="PIM/Ecommerce/SEO measure content performance — PDP views, search ranking…">
        <bpmn:documentation>Step 1: PIM/Ecommerce/SEO measure content performance — PDP views, search ranking, click-through, bounce, time-on-page, search-term gaps (zero-result queries) — per SKU/category/channel
Responsible (R): PIM Content Lead / SEO / Analytics
Accountable (A): Director Ecommerce
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W4163_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4163_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4163_Task5" name="PIM/SEO identify content gaps (low-completeness SKUs, missing keywords, poor…">
        <bpmn:documentation>Step 2: PIM/SEO identify content gaps (low-completeness SKUs, missing keywords, poor images) and prioritize enrichment (links to W4149/W4156) by revenue/traffic impact
Responsible (R): PIM Content Lead / SEO
Accountable (A): Director Ecommerce
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4163_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4163_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4163_Task6" name="PIM/Marketing report content-performance KPIs, A/B test content variants, and…">
        <bpmn:documentation>Step 3: PIM/Marketing report content-performance KPIs, A/B test content variants, and feed learnings into category/content strategy (VS-01/VS-14)
Responsible (R): PIM Content Lead / Marketing
Accountable (A): Director Ecommerce
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4163_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4163_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4163_End7" name="Complete">
        <bpmn:incoming>W4163_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4163_Annotation8">
        <bpmn:text>Controls: - CTL-643 (ensure controlled execution — Content Syndication, Channel Publishing &amp; PIM Analytics (PA-137.3).) | - CTL-643: content KPIs tied to revenue/conversion (not vanity metrics); A/B-test governance
Owner: PIM Content Lead / Ecommerce Analytics (VS-28/VS-10)</bpmn:text>
      </bpmn:textAnnotation>
