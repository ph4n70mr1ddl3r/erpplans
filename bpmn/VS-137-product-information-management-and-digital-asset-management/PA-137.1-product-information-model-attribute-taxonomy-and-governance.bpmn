        <bpmndi:BPMNShape id="W4146_End7_di" bpmnElement="W4146_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4146_Annotation8_di" bpmnElement="W4146_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4146_Flow10_di" bpmnElement="W4146_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4146_Flow11_di" bpmnElement="W4146_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4146_Flow12_di" bpmnElement="W4146_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4146_Flow13_di" bpmnElement="W4146_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4146_Assoc9_di" bpmnElement="W4146_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4147" name="W4147. Data Governance, Ownership &amp; Completeness Standards" isExecutable="false">
      <bpmn:documentation>Trigger: Program setup; quality review; audit
Frequency: Quarterly governance + continuous monitoring
Volume: 35,000 SKUs × completeness scorecard
Owner: PIM Product Owner / Data Governance (VS-28.2)
Participants: Merchandising (VS-01), Ecommerce (VS-10), Legal/Compliance (VS-22/VS-91), Quality (VS-31)
Source: workflow W4147 — Data Governance, Ownership &amp; Completeness Standards</bpmn:documentation>
      <bpmn:laneSet id="W4147_LaneSet2">
        <bpmn:lane id="W4147_Lane1" name="PIM Owner">
        <bpmn:flowNodeRef>W4147_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4147_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4147_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4147_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4147_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4147_Start3" name="Program setup; quality review; audit">
        <bpmn:outgoing>W4147_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4147_Task4" name="PIM/Data Governance assign content ownership (RACI per attribute family — e.g…">
        <bpmn:documentation>Step 1: PIM/Data Governance assign content ownership (RACI per attribute family — e.g., specs to merchandising, marketing copy to marketing, assets to DAM team, compliance fields to legal/quality) and publish data-steward roles
Responsible (R): PIM Owner / Data Gov
Accountable (A): Director Ecommerce
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4147_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4147_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4147_Task5" name="PIM define completeness/quality scoring per SKU and per channel…">
        <bpmn:documentation>Step 2: PIM define completeness/quality scoring per SKU and per channel (mandatory-field coverage, image-count threshold, spec completeness, SDS presence for DG), and a channel-publication gate (no publish below threshold)
Responsible (R): PIM Owner / Ecommerce
Accountable (A): Director Ecommerce
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4147_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4147_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4147_Task6" name="PIM report content-quality KPIs to governance (links to VS-28.2 data quality…">
        <bpmn:documentation>Step 3: PIM report content-quality KPIs to governance (links to VS-28.2 data quality W2392, VS-133 OpEx), remediate with owners, and audit a sample for accuracy
Responsible (R): PIM Owner / Audit (VS-21)
Accountable (A): Director Ecommerce
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4147_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4147_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4147_End7" name="Complete">
        <bpmn:incoming>W4147_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4147_Annotation8">
        <bpmn:text>Controls: - CTL-149 (ensure product content accuracy &amp; rights compliance.) | - CTL-641: content RACI documented; channel-publication gate enforced (no publish &lt; threshold); sample audit (VS-21)
Owner: PIM Product Owner / Data Governance (VS-28.2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4147_Assoc9" sourceRef="W4147_Annotation8" targetRef="W4147_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4147_Flow10" sourceRef="W4147_Start3" targetRef="W4147_Task4" />
      <bpmn:sequenceFlow id="W4147_Flow11" sourceRef="W4147_Task4" targetRef="W4147_Task5" />
      <bpmn:sequenceFlow id="W4147_Flow12" sourceRef="W4147_Task5" targetRef="W4147_Task6" />
      <bpmn:sequenceFlow id="W4147_Flow13" sourceRef="W4147_Task6" targetRef="W4147_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4147_diag">
      <bpmndi:BPMNPlane id="W4147_plane" bpmnElement="W_W4147">
        <bpmndi:BPMNShape id="W4147_Lane1_di" bpmnElement="W4147_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_Task4_di" bpmnElement="W4147_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_Task5_di" bpmnElement="W4147_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_Task6_di" bpmnElement="W4147_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_Start3_di" bpmnElement="W4147_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_End7_di" bpmnElement="W4147_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4147_Annotation8_di" bpmnElement="W4147_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4147_Flow10_di" bpmnElement="W4147_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4147_Flow11_di" bpmnElement="W4147_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4147_Flow12_di" bpmnElement="W4147_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4147_Flow13_di" bpmnElement="W4147_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4147_Assoc9_di" bpmnElement="W4147_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4148" name="W4148. New-Product Content Onboarding &amp; Item Setup" isExecutable="false">
      <bpmn:documentation>Trigger: New SKU ranged (NPI/assortment) links to VS-01.1; new vendor item
Frequency: Continuous (~5–8% SKU growth/yr = ~1,500–2,500 new active SKUs/yr)
Volume: ~150–230 new SKUs/month onboarding to content
Owner: PIM Content Lead / Merchandising Onboarding (VS-01.1)
Participants: Buyers (VS-01), Vendor (content source), DAM team, Ecommerce (VS-10), Compliance (VS-22/VS-117)
Source: workflow W4148 — New-Product Content Onboarding &amp; Item Setup</bpmn:documentation>
      <bpmn:laneSet id="W4148_LaneSet2">
        <bpmn:lane id="W4148_Lane1" name="PIM Content Lead">
        <bpmn:flowNodeRef>W4148_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4148_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4148_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4148_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4148_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4148_Start3" name="New SKU ranged (NPI/assortment) links to VS-01.1; new vendor item">
        <bpmn:outgoing>W4148_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4148_Task4" name="On NPI/range decision (VS-01.1), PIM create the product record skeleton from…">
        <bpmn:documentation>Step 1: On NPI/range decision (VS-01.1), PIM create the product record skeleton from the category template (W4146), capture core identity/classification, and trigger the content-intake tasks to owners
Responsible (R): PIM Content Lead / Buyer
Accountable (A): PIM Owner
Duration: Per SKU, ~15 min</bpmn:documentation>
        <bpmn:incoming>W4148_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4148_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4148_Task5" name="PIM/Buyer/Vendor capture specs, marketing copy, images, and compliance fields…">
        <bpmn:documentation>Step 2: PIM/Buyer/Vendor capture specs, marketing copy, images, and compliance fields (SDS for DG, PS/ICC cert for DTI-BPS-regulated links to VS-117), validating against completeness standards (W4147)
Responsible (R): PIM Content Lead / Vendor / Compliance
Accountable (A): Category Mgr
Duration: Per SKU, ~1–3 hrs</bpmn:documentation>
        <bpmn:incoming>W4148_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4148_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4148_Task6" name="PIM pass the completeness gate (W4147), publish to channels (W4159), and verify…">
        <bpmn:documentation>Step 3: PIM pass the completeness gate (W4147), publish to channels (W4159), and verify rendering on web/storefront before go-live
Responsible (R): PIM Content Lead / Ecommerce
Accountable (A): PIM Owner
Duration: Per SKU, ~15 min</bpmn:documentation>
