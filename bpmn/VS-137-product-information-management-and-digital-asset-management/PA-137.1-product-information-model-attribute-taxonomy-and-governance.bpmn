        <bpmndi:BPMNEdge id="W4145_Assoc9_di" bpmnElement="W4145_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4146" name="W4146. Attribute Taxonomy, Spec Schema &amp; Category Modeling" isExecutable="false">
      <bpmn:documentation>Trigger: Category review; new assortment; channel need (e.g., marketplace spec)
Frequency: Continuous + per category
Volume: ~13 departments (~40 categories) × tens of attributes each (e.g., tiles: material/size/thickness/PEI/water-absorption)
Owner: PIM Content Lead / Category Management (VS-01)
Participants: Category managers (VS-01), Ecommerce (VS-10), Trade specialists
Source: workflow W4146 — Attribute Taxonomy, Spec Schema &amp; Category Modeling</bpmn:documentation>
      <bpmn:laneSet id="W4146_LaneSet2">
        <bpmn:lane id="W4146_Lane1" name="PIM Content Lead">
        <bpmn:flowNodeRef>W4146_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4146_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4146_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4146_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4146_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4146_Start3" name="Category review; new assortment; channel need (e.g., marketplace spec)">
        <bpmn:outgoing>W4146_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4146_Task4" name="PIM/Category define the attribute set per category — distinguishing…">
        <bpmn:documentation>Step 1: PIM/Category define the attribute set per category — distinguishing (search/driving, e.g., power-tool wattage) vs supporting (display) attributes, units, allowed values, and mandatory-for-channel flags
Responsible (R): PIM Content Lead / Category Mgr
Accountable (A): PIM Owner
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W4146_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4146_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4146_Task5" name="PIM/Category model category-specific spec schemas and facets (filter taxonomy)…">
        <bpmn:documentation>Step 2: PIM/Category model category-specific spec schemas and facets (filter taxonomy) aligned to how customers/shopper search (links to VS-10 search, VS-44 insights W2831) and to DTI-BPS regulated attributes (VS-117)
Responsible (R): PIM Content Lead / Ecommerce
Accountable (A): PIM Owner
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W4146_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4146_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4146_Task6" name="PIM publish the category template to the PIM platform, train…">
        <bpmn:documentation>Step 3: PIM publish the category template to the PIM platform, train merchandising/enrichment teams, and govern attribute change requests
Responsible (R): PIM Content Lead
Accountable (A): PIM Owner
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4146_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4146_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4146_End7" name="Complete">
        <bpmn:incoming>W4146_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4146_Annotation8">
        <bpmn:text>Controls: - CTL-641 (ensure controlled execution — Product Information Model, Attribute Taxonomy &amp; Governance (PA-137.1).) | - CTL-641: attribute dictionary change-controlled; category templates reviewed by Category Mgr
Owner: PIM Content Lead / Category Management (VS-01)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4146_Assoc9" sourceRef="W4146_Annotation8" targetRef="W4146_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4146_Flow10" sourceRef="W4146_Start3" targetRef="W4146_Task4" />
      <bpmn:sequenceFlow id="W4146_Flow11" sourceRef="W4146_Task4" targetRef="W4146_Task5" />
      <bpmn:sequenceFlow id="W4146_Flow12" sourceRef="W4146_Task5" targetRef="W4146_Task6" />
      <bpmn:sequenceFlow id="W4146_Flow13" sourceRef="W4146_Task6" targetRef="W4146_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4146_diag">
      <bpmndi:BPMNPlane id="W4146_plane" bpmnElement="W_W4146">
        <bpmndi:BPMNShape id="W4146_Lane1_di" bpmnElement="W4146_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
