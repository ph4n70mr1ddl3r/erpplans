        <bpmndi:BPMNShape id="W1833_Annotation12_di" bpmnElement="W1833_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1833_Flow14_di" bpmnElement="W1833_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Flow15_di" bpmnElement="W1833_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Flow16_di" bpmnElement="W1833_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Flow17_di" bpmnElement="W1833_Flow17"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Flow18_di" bpmnElement="W1833_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Flow19_di" bpmnElement="W1833_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1833_Assoc13_di" bpmnElement="W1833_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1834" name="W1834. Private Label Purchase Order &amp; Import Logistics Management" isExecutable="false">
      <bpmn:documentation>Trigger: Product specification approved (W1832), pricing finalized (W1833), and launch date confirmed
Frequency: ~15–25 private label import orders/year; replenishment orders per W2A
Volume: Initial order: MOQ per SKU (5,000–20,000 units); replenishment per ROP/W2A
Owner: Buyer
Participants: Buyer, Import Coordinator, Quality Assurance Manager, DC Receiving, Finance
Source: workflow W1834 — Private Label Purchase Order &amp; Import Logistics Management</bpmn:documentation>
      <bpmn:laneSet id="W1834_LaneSet6">
        <bpmn:lane id="W1834_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W1834_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1834_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1834_Lane2" name="Quality Assurance Manager">
        <bpmn:flowNodeRef>W1834_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1834_Lane3" name="Import Coordinator">
        <bpmn:flowNodeRef>W1834_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1834_Lane4" name="DC Receiving">
        <bpmn:flowNodeRef>W1834_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1834_Lane5" name="Finance">
        <bpmn:flowNodeRef>W1834_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1834_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1834_Start7" name="Product specification approved (W1832), pricing finalized (W1833), and launch date…">
        <bpmn:outgoing>W1834_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1834_Task8" name="Buyer creates import PO per W2B with private label flag: (a) factory as vendor…">
        <bpmn:documentation>Step 1: Buyer creates import PO per W2B with private label flag: (a) factory as vendor, (b) SKU lines with quantities per MOQ or demand forecast, (c) specification reference document attached, (d) packaging and labeling requirements documented, (e) quality inspection requirements: pre-shipment inspection (PSI) at factory before shipment — mandatory for first 3 orders per factory; optional thereafter if quality score ≥ 95%, (f) LC or TT payment terms per factory agreement
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per W2B</bpmn:documentation>
        <bpmn:incoming>W1834_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1834_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1834_Task9" name="Quality Assurance Manager arranges pre-shipment inspection (PSI) through…">
        <bpmn:documentation>Step 2: Quality Assurance Manager arranges pre-shipment inspection (PSI) through third-party inspection firm (SGS, Bureau Veritas) or travels to factory: (a) inspect random sample per AQL (Acceptable Quality Level) 2.5 standard, (b) verify product conformance to approved specification (W1832), (c) verify packaging and labeling conformance, (d) verify quantity and packing, (e) if PSI fails: issue corrective action request to factory; Buyer negotiates rework or shipment delay; if critical failure: Buyer cancels shipment and sources alternative
Responsible (R): Quality Assurance Manager / Inspection Firm
Accountable (A): Category Manager
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1834_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1834_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1834_Task10" name="Import Coordinator manages logistics per W2B (import PO lifecycle): (a) freight…">
        <bpmn:documentation>Step 3: Import Coordinator manages logistics per W2B (import PO lifecycle): (a) freight booking, (b) customs documentation with correct HS codes for private label products, (c) DTI-BPS ICC clearance if required for product category (steel, electrical items), (d) coordinate delivery to DC
Responsible (R): Import Coordinator
Accountable (A): Buyer
Duration: Per W2B</bpmn:documentation>
        <bpmn:incoming>W1834_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1834_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1834_Task11" name="DC Receiving conducts heightened incoming quality inspection for private label…">
        <bpmn:documentation>Step 4: DC Receiving conducts heightened incoming quality inspection for private label (especially for first 3 orders from factory): (a) inspect per sampling plan: 10% of master cartons opened and inspected for first order; 5% for second and third orders; standard receiving inspection thereafter per W681, (b) verify product matches approved specification and reference sample retained from W1831.4, (c) verify packaging and labeling: barcodes scan correctly, labels comply with Philippine regulations, BuildRight branding applied per specification, (d) if quality issues found: quarantine stock, notify Quality Assurance Manager and Buyer; do not distribute to stores until resolved
Responsible (R): DC Receiving / Quality Assurance Manager
Accountable (A): DC Operations Manager
Duration: 1–2 hours/container</bpmn:documentation>
        <bpmn:incoming>W1834_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1834_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1834_Task12" name="Finance processes landed cost per W2B.12 and AP per W7; quality inspection…">
        <bpmn:documentation>Step 5: Finance processes landed cost per W2B.12 and AP per W7; quality inspection costs allocated to product landed cost
Responsible (R): Finance / AP
Accountable (A): Controller
Duration: Per W2B/W7</bpmn:documentation>
        <bpmn:incoming>W1834_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1834_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1834_End13" name="Complete">
        <bpmn:incoming>W1834_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1834_Annotation14">
        <bpmn:text>Controls: - CTL-364 (ensure controlled execution — Private Label Product Development &amp; Sourcing (PA-41.1).) | - operational: Buyer review and approval gate
Owner: Buyer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1834_Assoc15" sourceRef="W1834_Annotation14" targetRef="W1834_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W1834_Flow16" sourceRef="W1834_Start7" targetRef="W1834_Task8" />
