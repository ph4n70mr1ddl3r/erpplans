    <bpmn:process id="W_W1831" name="W1831. Private Label Factory Sourcing, Audit &amp; Qualification" isExecutable="false">
      <bpmn:documentation>Trigger: Category approved for private label development (W1830)
Frequency: ~4–6 new factory sourcing engagements/year; ~2–3 factory audits/year
Volume: Typically evaluate 3–5 factories per product category; qualify 1–2 per category
Owner: Buyer (Sourcing Lead)
Participants: Buyer, Quality Assurance Manager, Category Manager, Import Coordinator
Source: workflow W1831 — Private Label Factory Sourcing, Audit &amp; Qualification</bpmn:documentation>
      <bpmn:laneSet id="W1831_LaneSet3">
        <bpmn:lane id="W1831_Lane1" name="Buyer">
        <bpmn:flowNodeRef>W1831_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1831_Lane2" name="Quality Assurance Manager">
        <bpmn:flowNodeRef>W1831_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1831_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1831_Start4" name="Category approved for private label development (W1830)">
        <bpmn:outgoing>W1831_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1831_Task5" name="Buyer identifies candidate factories through: (a) existing vendor network —…">
        <bpmn:documentation>Step 1: Buyer identifies candidate factories through: (a) existing vendor network — current BuildRight vendors who also manufacture for other brands, (b) trade show contacts (Canton Fair, Philippine International Trade Fair), (c) sourcing platforms (Alibaba, Global Sources, ThomasNet), (d) industry referrals from Category Manager network, (e) factories already producing similar private label products for competitors (reverse engineering approach)
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1831_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1831_Task6" name="Buyer conducts preliminary screening of 3–5 factories per category: (a) factory…">
        <bpmn:documentation>Step 2: Buyer conducts preliminary screening of 3–5 factories per category: (a) factory profile: years in business, annual revenue, production capacity, export markets, (b) product capability: can they manufacture to BuildRight specifications? existing product catalog overlap with target category? (c) quality certifications: ISO 9001, ISO 14001 (environmental), BSCI (social compliance), product-specific certifications (e.g., CE marking for electrical items, PSA certification for pressure equipment), (d) compliance: Philippine import requirements (DTI-BPS ICC certification per W447, FDA for applicable items), (e) financial stability: trade references, bank references, Dun &amp; Bradstreet or equivalent credit report, (f) communication capability: English proficiency, responsiveness, willingness to work with Philippine import documentation
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1831_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1831_Task7" name="Buyer requests and evaluates product samples from 2–3 shortlisted factories…">
        <bpmn:documentation>Step 3: Buyer requests and evaluates product samples from 2–3 shortlisted factories: (a) evaluate against BuildRight specification requirements, (b) compare quality side-by-side with national brand benchmark products, (c) conduct internal testing (hand tool durability, fastener tensile strength, paint adhesion, PPE impact resistance — per product category), (d) request pricing: FOB, CIF Manila, MOQ per SKU, payment terms, lead time, (e) evaluate packaging capability: can factory apply BuildRight branding and packaging per specifications?
Responsible (R): Buyer / Quality Assurance Manager
Accountable (A): Category Manager
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1831_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1831_Task8" name="Quality Assurance Manager conducts factory audit (on-site for new factories…">
        <bpmn:documentation>Step 4: Quality Assurance Manager conducts factory audit (on-site for new factories; desk audit for factories already supplying BuildRight): (a) production process walkthrough: raw material storage, manufacturing lines, quality control checkpoints, finished goods warehousing, (b) quality management system review: incoming material inspection, in-process QC, final inspection, defect tracking, corrective action process, (c) social compliance assessment: working conditions, child labor policy, fire safety, waste disposal, (d) capacity verification: can factory meet BuildRight&#x27;s projected volume within required lead times without compromising quality?, (e) sample retention: QA Manager retains reference samples from factory audit for future quality comparison
Responsible (R): Quality Assurance Manager
Accountable (A): Category Manager
Duration: 2–3 days/factory (including travel for on-site audits)</bpmn:documentation>
        <bpmn:incoming>W1831_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1831_Task9" name="Buyer presents sourcing recommendation to Category Manager: (a) comparative…">
        <bpmn:documentation>Step 5: Buyer presents sourcing recommendation to Category Manager: (a) comparative matrix: factory capability, quality score, pricing, MOQ, lead time, risk assessment, (b) recommended factory selection with rationale, (c) negotiation strategy for contract terms, (d) fallback factory if primary selection fails during contract negotiation
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W1831_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1831_Task10" name="Upon factory selection: Buyer creates factory as approved vendor in ERP per W36…">
        <bpmn:documentation>Step 6: Upon factory selection: Buyer creates factory as approved vendor in ERP per W36 (vendor onboarding) with classification &quot;Private Label Manufacturer&quot;; adds factory to approved supplier list with product category scope, quality audit score, and renewal date
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per W36</bpmn:documentation>
        <bpmn:incoming>W1831_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1831_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1831_End11" name="Complete">
        <bpmn:incoming>W1831_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1831_Annotation12">
        <bpmn:text>Controls: - CTL-173 (prevent non-compliant private-label products from reaching shelf.) | - operational: Buyer (Sourcing Lead) review and approval gate
Owner: Buyer (Sourcing Lead)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1831_Assoc13" sourceRef="W1831_Annotation12" targetRef="W1831_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1831_Flow14" sourceRef="W1831_Start4" targetRef="W1831_Task5" />
      <bpmn:sequenceFlow id="W1831_Flow15" sourceRef="W1831_Task5" targetRef="W1831_Task6" />
      <bpmn:sequenceFlow id="W1831_Flow16" sourceRef="W1831_Task6" targetRef="W1831_Task7" />
      <bpmn:sequenceFlow id="W1831_Flow17" sourceRef="W1831_Task7" targetRef="W1831_Task8" />
      <bpmn:sequenceFlow id="W1831_Flow18" sourceRef="W1831_Task8" targetRef="W1831_Task9" />
      <bpmn:sequenceFlow id="W1831_Flow19" sourceRef="W1831_Task9" targetRef="W1831_Task10" />
      <bpmn:sequenceFlow id="W1831_Flow20" sourceRef="W1831_Task10" targetRef="W1831_End11" />
    </bpmn:process>
