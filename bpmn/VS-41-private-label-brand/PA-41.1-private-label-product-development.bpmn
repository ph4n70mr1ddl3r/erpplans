    <bpmn:process id="W_W1835" name="W1835. Private Label Product Lifecycle Performance Review &amp; Rationalization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly performance review cycle; annual portfolio rationalization
Frequency: Monthly dashboard; quarterly deep-dive by category; annual portfolio review
Volume: ~4,000–5,000 active private label SKUs under review
Owner: Category Manager
Participants: Category Manager, FP&amp;A, Buyer, Merchandise Planner, VP Merchandising
Source: workflow W1835 — Private Label Product Lifecycle Performance Review &amp; Rationalization</bpmn:documentation>
      <bpmn:laneSet id="W1835_LaneSet4">
        <bpmn:lane id="W1835_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1835_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1835_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1835_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1835_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1835_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1835_Lane3" name="Merchandise Planner">
        <bpmn:flowNodeRef>W1835_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1835_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1835_Start5" name="Monthly performance review cycle; annual portfolio rationalization">
        <bpmn:outgoing>W1835_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1835_Task6" name="Monthly private label performance dashboard: (a) sales volume by SKU vs…">
        <bpmn:documentation>Step 1: Monthly private label performance dashboard: (a) sales volume by SKU vs. forecast, (b) gross margin % by SKU vs. target, (c) inventory turns by SKU (target: ≥ 6x/year), (d) sell-through rate by SKU, (e) category penetration: private label volume as % of total category volume, (f) customer feedback: returns rate, complaint rate by SKU, (g) quality incident tracker: defect rate by factory, (h) stockout rate by SKU
Responsible (R): FP&amp;A / Merchandise Planner
Accountable (A): Category Manager
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1835_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1835_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1835_Task7" name="Quarterly category deep-dive: (a) top 20 and bottom 20 SKUs by margin…">
        <bpmn:documentation>Step 2: Quarterly category deep-dive: (a) top 20 and bottom 20 SKUs by margin contribution, (b) SKUs below minimum volume threshold (identify candidates for discontinuation), (c) SKUs with declining sales trend (investigate: quality issue? competition? seasonality?), (d) factory performance scorecard: on-time delivery, quality rejection rate, pricing competitiveness, (e) margin trend analysis: actual margin vs. model (W1833) — identify cost drift, (f) competitive intelligence: have competitors launched similar private label products?
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4–8 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1835_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1835_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1835_Task8" name="Annual portfolio rationalization: (a) discontinue bottom 10% of SKUs by volume…">
        <bpmn:documentation>Step 3: Annual portfolio rationalization: (a) discontinue bottom 10% of SKUs by volume if: (i) sell-through rate &lt; 50% of forecast for 2 consecutive quarters, (ii) gross margin below national brand equivalent, (iii) chronic quality issues unresolved after 2 corrective action rounds, (iv) factory reliability issues, (b) add new SKUs per W1830 opportunity assessment, (c) rebalance portfolio by category: increase private label share in high-performing categories; reduce in underperforming, (d) total portfolio target: maintain the ~4,000–5,000-SKU portfolio (~11–14% of active SKUs) as private label
Responsible (R): Category Manager / VP Merchandising
Accountable (A): VP Merchandising
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W1835_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1835_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1835_Task9" name="Discontinuation execution: (a) Merchandise Planner marks SKU as &quot;discontinued —…">
        <bpmn:documentation>Step 4: Discontinuation execution: (a) Merchandise Planner marks SKU as &quot;discontinued — sell-through&quot; per W1026 (product discontinuation process), (b) no new POs generated; existing inventory sold through at standard or clearance pricing, (c) if factory has outstanding commitments: Buyer negotiates cancellation or deferred delivery, (d) final inventory dispositioned per W220 (SLOB) or W93 (clearance pricing)
Responsible (R): Merchandise Planner / Buyer
Accountable (A): Category Manager
Duration: Per W1026</bpmn:documentation>
        <bpmn:incoming>W1835_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1835_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1835_End10" name="Complete">
        <bpmn:incoming>W1835_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1835_Annotation11">
        <bpmn:text>Controls: - CTL-364 (ensure controlled execution — Private Label Product Development &amp; Sourcing (PA-41.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1835_Assoc12" sourceRef="W1835_Annotation11" targetRef="W1835_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1835_Flow13" sourceRef="W1835_Start5" targetRef="W1835_Task6" />
      <bpmn:sequenceFlow id="W1835_Flow14" sourceRef="W1835_Task6" targetRef="W1835_Task7" />
      <bpmn:sequenceFlow id="W1835_Flow15" sourceRef="W1835_Task7" targetRef="W1835_Task8" />
      <bpmn:sequenceFlow id="W1835_Flow16" sourceRef="W1835_Task8" targetRef="W1835_Task9" />
      <bpmn:sequenceFlow id="W1835_Flow17" sourceRef="W1835_Task9" targetRef="W1835_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1835_diag">
      <bpmndi:BPMNPlane id="W1835_plane" bpmnElement="W_W1835">
        <bpmndi:BPMNShape id="W1835_Lane1_di" bpmnElement="W1835_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Lane2_di" bpmnElement="W1835_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Lane3_di" bpmnElement="W1835_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
