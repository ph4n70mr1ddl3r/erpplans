        <bpmndi:BPMNShape id="W1835_Task7_di" bpmnElement="W1835_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Task8_di" bpmnElement="W1835_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Task9_di" bpmnElement="W1835_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Start5_di" bpmnElement="W1835_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_End10_di" bpmnElement="W1835_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1835_Annotation11_di" bpmnElement="W1835_Annotation11"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1835_Flow13_di" bpmnElement="W1835_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1835_Flow14_di" bpmnElement="W1835_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1835_Flow15_di" bpmnElement="W1835_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1835_Flow16_di" bpmnElement="W1835_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1835_Flow17_di" bpmnElement="W1835_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1835_Assoc12_di" bpmnElement="W1835_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1836" name="W1836. Exclusive Brand Partnership Negotiation &amp; Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: Identification of national or regional brand willing to grant BuildRight exclusive distribution rights in the Philippines
Frequency: ~2–3 exclusive brand partnership evaluations/year
Volume: ~5–10 active exclusive brand partnerships at any time
Owner: VP Merchandising
Participants: VP Merchandising, Category Manager, Buyer, Legal Counsel, CMO
Source: workflow W1836 — Exclusive Brand Partnership Negotiation &amp; Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W1836_LaneSet6">
        <bpmn:lane id="W1836_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W1836_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1836_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1836_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1836_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1836_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W1836_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1836_Lane4" name="Buyer">
        <bpmn:flowNodeRef>W1836_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1836_Lane5" name="CMO">
        <bpmn:flowNodeRef>W1836_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1836_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1836_Start7" name="Identification of national or regional brand willing to grant BuildRight exclusive…">
        <bpmn:outgoing>W1836_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1836_Task8" name="VP Merchandising identifies exclusive brand opportunity: (a) international…">
        <bpmn:documentation>Step 1: VP Merchandising identifies exclusive brand opportunity: (a) international brand seeking Philippine market entry without direct investment, (b) brand that complements BuildRight&#x27;s assortment without competing with existing national brand relationships, (c) brand with strong reputation in home market but no Philippine distribution, (d) brand willing to grant BuildRight exclusive distribution for defined territory (Philippines) and channel (physical retail + ecommerce)
Responsible (R): VP Merchandising
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1836_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1836_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1836_Task9" name="Category Manager evaluates market potential: (a) brand awareness among…">
        <bpmn:documentation>Step 2: Category Manager evaluates market potential: (a) brand awareness among Philippine contractors and DIYers, (b) product gap analysis: does the brand fill an assortment gap or offer a superior alternative to current offerings? (c) pricing analysis: can the brand be positioned profitably in the Philippine market? (d) volume projection: realistic sales forecast for Year 1–3, (e) investment required: minimum stock order, marketing spend, in-store display investment
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1836_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1836_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1836_Task10" name="Legal Counsel negotiates exclusive distribution agreement: (a) territory…">
        <bpmn:documentation>Step 3: Legal Counsel negotiates exclusive distribution agreement: (a) territory definition: Philippines nationwide, (b) exclusivity scope: category-specific or brand-wide, (c) duration: typically 2–3 years with renewal option, (d) minimum purchase commitment: annual or quarterly volume targets, (e) pricing: import pricing (FOB or CIF), BuildRight&#x27;s margin target, (f) marketing support: brand co-op fund, product training, display materials, (g) performance clause: if BuildRight fails to meet minimum purchase commitment, exclusivity may be revoked, (h) termination clause: exit terms if partnership underperforms, (i) IP and trademark license for use in marketing materials, (j) data privacy compliance for shared customer data
Responsible (R): Legal Counsel / VP Merchandising
Accountable (A): CEO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1836_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1836_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1836_Task11" name="Buyer onboards brand per W36 (vendor onboarding) with classification &quot;Exclusive…">
        <bpmn:documentation>Step 4: Buyer onboards brand per W36 (vendor onboarding) with classification &quot;Exclusive Brand Partner&quot;: (a) create vendor master with exclusive brand flag, (b) load initial SKU assortment into item master, (c) set up pricing per agreement, (d) configure replenishment parameters, (e) create initial import PO per W2B
Responsible (R): Buyer
Accountable (A): Category Manager
Duration: Per W36 + W2B</bpmn:documentation>
        <bpmn:incoming>W1836_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1836_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1836_Task12" name="CMO launches exclusive brand in-store and online: (a) dedicated display area in…">
        <bpmn:documentation>Step 5: CMO launches exclusive brand in-store and online: (a) dedicated display area in relevant product section (e.g., premium European power tool brand in Tools section), (b) &quot;Exclusive at BuildRight&quot; signage and branding, (c) Sales Associate training on brand features and benefits, (d) ecommerce listing with exclusive brand messaging, (e) loyalty program double-points promotion for launch month
Responsible (R): CMO / Category Manager
Accountable (A): VP Merchandising
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1836_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1836_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1836_End13" name="Complete">
