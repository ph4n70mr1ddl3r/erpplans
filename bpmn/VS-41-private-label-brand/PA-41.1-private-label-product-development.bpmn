<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-41.1-private-label-product-development" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1830" name="W1830. Private Label Category Opportunity Assessment &amp; Product Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Annual category strategy review or margin gap identification by Category Manager
Frequency: Quarterly category opportunity reviews; ~2–4 new product development initiatives per year
Volume: Target portfolio of ~4,000–5,000 private label SKUs (~11–14% of active SKUs, per the W1265/W1513 canon) across 8–10 sub-categories
Owner: Category Manager
Participants: Category Manager, VP Merchandising, FP&amp;A, Market Research Analyst, Merchandise Planner
Source: workflow W1830 — Private Label Category Opportunity Assessment &amp; Product Selection</bpmn:documentation>
      <bpmn:laneSet id="W1830_LaneSet4">
        <bpmn:lane id="W1830_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1830_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1830_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1830_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1830_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1830_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1830_Lane3" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1830_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1830_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1830_Start5" name="Annual category strategy review or margin gap identification by Category Manager">
        <bpmn:outgoing>W1830_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1830_Task6" name="Category Manager identifies candidate categories for private label entry based…">
        <bpmn:documentation>Step 1: Category Manager identifies candidate categories for private label entry based on: (a) current gross margin vs. target margin — categories where national brand margins are below 25% are priority candidates, (b) category maturity — high-volume staple categories (hardware fasteners, hand tools, paint accessories, adhesives, PPE, cleaning supplies, storage, garden tools) where product differentiation is minimal and brand loyalty is low, (c) competitive landscape — categories where competitors (CitiHardware, Wilcon Depot) lack strong private label presence, (d) customer willingness — trade professionals and DIYers are willing to buy private label for commodity items (nails, screws, tarps, drop cloths, sandpaper, paint rollers) when quality meets specifications, (e) supply base availability — at least 3 qualified manufacturers in China, Taiwan, or Philippines capable of producing to specification
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–4 hours/category</bpmn:documentation>
        <bpmn:incoming>W1830_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1830_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1830_Task7" name="FP&amp;A builds financial model for each candidate category: (a) current category…">
        <bpmn:documentation>Step 2: FP&amp;A builds financial model for each candidate category: (a) current category sales volume and gross margin by SKU, (b) projected private label volume capture (% of category volume expected to shift from national brands to private label — typically 15–30% within 2 years), (c) private label cost estimate based on preliminary factory quotes and landed cost modeling (FOB cost + freight + duty + insurance + packaging + quality testing), (d) target retail price positioning (typically 15–25% below national brand SRP while maintaining 15–25% higher gross margin), (e) break-even analysis: minimum order quantity (MOQ) vs. expected sell-through timeline, (f) payback period on initial inventory investment, (g) projected annual margin improvement (PHP amount and % improvement)
Responsible (R): FP&amp;A
Accountable (A): Category Manager
Duration: 4–8 hours/category</bpmn:documentation>
        <bpmn:incoming>W1830_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1830_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1830_Task8" name="Market Research Analyst validates customer demand: (a) analyze loyalty program…">
        <bpmn:documentation>Step 3: Market Research Analyst validates customer demand: (a) analyze loyalty program purchase data for target customer segments — identify which customers buy commodity items frequently and would be receptive to a quality-equivalent private label alternative, (b) review customer complaint data for existing national brands — recurring quality issues indicate opportunity for BuildRight to offer a better alternative, (c) benchmark competitor private label offerings in Philippine hardware/DIY retail, (d) conduct informal store-level feedback with Sales Associates on customer willingness to switch, (e) present findings and recommendation to Category Manager
Responsible (R): Market Research Analyst
Accountable (A): Category Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1830_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1830_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1830_Task9" name="Category Manager and VP Merchandising make go/no-go decision per category: (a)…">
        <bpmn:documentation>Step 4: Category Manager and VP Merchandising make go/no-go decision per category: (a) if approved: define product scope (number of SKUs, target specifications, quality tier — &quot;BuildRight Essentials&quot; for economy or &quot;BuildRight Pro&quot; for professional grade), (b) set target launch date (typically 6–9 months from approval for imported items; 3–4 months for locally sourced), (c) assign Buyer as project lead for sourcing, (d) approve budget for factory sourcing, sample development, and initial order, (e) if not approved: document rationale and revisit at next quarterly review
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1830_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1830_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1830_End10" name="Complete">
        <bpmn:incoming>W1830_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1830_Annotation11">
        <bpmn:text>Controls: - CTL-364 (ensure controlled execution — Private Label Product Development &amp; Sourcing (PA-41.1).) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1830_Assoc12" sourceRef="W1830_Annotation11" targetRef="W1830_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1830_Flow13" sourceRef="W1830_Start5" targetRef="W1830_Task6" />
      <bpmn:sequenceFlow id="W1830_Flow14" sourceRef="W1830_Task6" targetRef="W1830_Task7" />
      <bpmn:sequenceFlow id="W1830_Flow15" sourceRef="W1830_Task7" targetRef="W1830_Task8" />
      <bpmn:sequenceFlow id="W1830_Flow16" sourceRef="W1830_Task8" targetRef="W1830_Task9" />
      <bpmn:sequenceFlow id="W1830_Flow17" sourceRef="W1830_Task9" targetRef="W1830_End10" />
    </bpmn:process>
