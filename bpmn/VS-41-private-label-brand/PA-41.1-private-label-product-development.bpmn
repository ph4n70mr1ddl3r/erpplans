    <bpmn:process id="W_W1833" name="W1833. Private Label Cost Modeling, Pricing Strategy &amp; Margin Target Setting" isExecutable="false">
      <bpmn:documentation>Trigger: Factory pricing received (W1831) and product specification finalized (W1832)
Frequency: Per product development initiative; annual cost review for existing private label portfolio
Volume: ~20–30 new SKU cost models/year; ~4,000–5,000 existing SKUs reviewed annually
Owner: FP&amp;A
Participants: FP&amp;A, Category Manager, Buyer, VP Merchandising
Source: workflow W1833 — Private Label Cost Modeling, Pricing Strategy &amp; Margin Target Setting</bpmn:documentation>
      <bpmn:laneSet id="W1833_LaneSet4">
        <bpmn:lane id="W1833_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1833_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1833_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1833_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1833_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1833_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1833_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1833_Lane3" name="VP Merchandising">
        <bpmn:flowNodeRef>W1833_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1833_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1833_Start5" name="Factory pricing received (W1831) and product specification finalized (W1832)">
        <bpmn:outgoing>W1833_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1833_Task6" name="FP&amp;A builds detailed landed cost model per SKU: (a) FOB cost per unit from…">
        <bpmn:documentation>Step 1: FP&amp;A builds detailed landed cost model per SKU: (a) FOB cost per unit from factory quote, (b) ocean freight estimate per unit (container utilization factor applied), (c) customs duty per HS code (0–15% depending on product category under ASEAN trade agreements), (d) 12% VAT on CIF + duty, (e) marine insurance, (f) port charges and demurrage buffer (W249), (g) customs broker fee per entry, (h) inland freight from port to DC, (i) DC handling cost per unit (pick, pack, ship), (j) packaging cost (if not included in FOB), (k) quality testing cost allocation per unit, (l) total landed cost per unit
Responsible (R): FP&amp;A
Accountable (A): Category Manager
Duration: 30 min/SKU</bpmn:documentation>
        <bpmn:incoming>W1833_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1833_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1833_Task7" name="Category Manager sets pricing strategy: (a) target retail price: 15–25% below…">
        <bpmn:documentation>Step 2: Category Manager sets pricing strategy: (a) target retail price: 15–25% below national brand SRP for equivalent product, (b) target gross margin: 40–55% (vs. 25–35% for national brands — private label should deliver 15–25% margin uplift), (c) quantity break pricing: tiered for trade professionals buying in bulk, (d) promotional pricing: define seasonal markdown parameters (max 20% discount still maintains 30%+ gross margin), (e) SRP positioning: ensure private label price point is visibly lower than national brand on shelf (psychological pricing: PHP 89 vs. national brand PHP 115)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 30 min/SKU</bpmn:documentation>
        <bpmn:incoming>W1833_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1833_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1833_Task8" name="FP&amp;A validates margin waterfall: (a) retail price − landed cost = gross margin…">
        <bpmn:documentation>Step 3: FP&amp;A validates margin waterfall: (a) retail price − landed cost = gross margin per unit and %, (b) gross margin − DC handling − store labor allocation − shrinkage allowance (1.5%) − markdown allowance (5%) = net margin per unit, (c) annual volume projection × net margin per unit = annual profit contribution, (d) compare to national brand profit contribution displaced: private label must deliver higher total profit contribution even at lower retail price, (e) if margin target not met: Buyer renegotiates FOB cost with factory or Category Manager adjusts retail price target
Responsible (R): FP&amp;A
Accountable (A): Category Manager
Duration: 15 min/SKU</bpmn:documentation>
        <bpmn:incoming>W1833_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1833_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1833_Task9" name="VP Merchandising approves pricing per tiered authority: (a) individual SKU SRP…">
        <bpmn:documentation>Step 4: VP Merchandising approves pricing per tiered authority: (a) individual SKU SRP changes: Category Manager authority, (b) category pricing strategy (target margin band): VP Merchandising approval, (c) if pricing strategy deviates from standard private label margin target (below 35% gross margin): CFO approval required
Responsible (R): VP Merchandising / CFO
Accountable (A): VP Merchandising
Duration: 30 min/batch</bpmn:documentation>
        <bpmn:incoming>W1833_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1833_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1833_Task10" name="Annual cost review for existing private label portfolio: (a) FP&amp;A compares…">
        <bpmn:documentation>Step 5: Annual cost review for existing private label portfolio: (a) FP&amp;A compares actual landed cost to model — identify cost drift from exchange rate changes, freight rate changes, factory price increases, (b) Category Manager reviews actual sell-through margin vs. target — identify SKUs below target margin, (c) Buyer renegotiates factory pricing or sources alternative factory for underperforming SKUs, (d) Category Manager recommends price adjustments, discontinuation, or SKU rationalization per W1835
Responsible (R): FP&amp;A / Category Manager
Accountable (A): VP Merchandising
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1833_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1833_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1833_End11" name="Complete">
        <bpmn:incoming>W1833_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1833_Annotation12">
        <bpmn:text>Controls: - CTL-364 (ensure controlled execution — Private Label Product Development &amp; Sourcing (PA-41.1).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1833_Assoc13" sourceRef="W1833_Annotation12" targetRef="W1833_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1833_Flow14" sourceRef="W1833_Start5" targetRef="W1833_Task6" />
