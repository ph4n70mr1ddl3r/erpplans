      <bpmn:sequenceFlow id="W1834_Flow18" sourceRef="W1834_Task9" targetRef="W1834_Task10" />
      <bpmn:sequenceFlow id="W1834_Flow19" sourceRef="W1834_Task10" targetRef="W1834_Task11" />
      <bpmn:sequenceFlow id="W1834_Flow20" sourceRef="W1834_Task11" targetRef="W1834_Task12" />
      <bpmn:sequenceFlow id="W1834_Flow21" sourceRef="W1834_Task12" targetRef="W1834_End13" />
    </bpmn:process>
