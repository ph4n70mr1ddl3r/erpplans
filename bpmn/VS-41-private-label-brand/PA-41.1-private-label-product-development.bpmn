      <bpmndi:BPMNPlane id="W1830_plane" bpmnElement="W_W1830">
        <bpmndi:BPMNShape id="W1830_Lane1_di" bpmnElement="W1830_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
