    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1840" name="W1840. Private Label Product Regulatory Compliance Testing &amp; Certification Renewal" isExecutable="false">
      <bpmn:documentation>Trigger: New product launch requiring certification; annual certification renewal; regulatory change
Frequency: ~10–15 new product certifications/year; ~20–30 renewal applications/year
Volume: Private label products requiring DTI-BPS ICC mark (steel products, electrical items, cement), FDA notification (household hazardous substances), DENR clearance (wood products from certain origins)
Owner: Quality Assurance Manager
Participants: QA Manager, Buyer, Import Coordinator, Regulatory Affairs (if dedicated role)
Source: workflow W1840 — Private Label Product Regulatory Compliance Testing &amp; Certification Renewal</bpmn:documentation>
      <bpmn:laneSet id="W1840_LaneSet2">
        <bpmn:lane id="W1840_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W1840_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1840_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1840_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1840_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1840_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1840_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1840_Start3" name="New product launch requiring certification; annual certification renewal; regulatory…">
        <bpmn:outgoing>W1840_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1840_Task4" name="QA Manager identifies regulatory requirements for each private label product…">
        <bpmn:documentation>Step 1: QA Manager identifies regulatory requirements for each private label product category: (a) DTI-BPS Philippine Standard (PS) Quality Mark or Import Commodity Clearance (ICC): required for steel products (rebar, nails, bolts), electrical products (wires, switches, breakers), cement, galvanized iron sheets, (b) FDA notification: required for household hazardous substances (paint thinners, solvents, adhesives, cleaning chemicals), (c) DENR clearance: required for wood products to verify legal sourcing and ISPM-15 compliance, (d) product-specific labeling requirements per Consumer Act RA 7394
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 4 hours/category (initial mapping)</bpmn:documentation>
        <bpmn:incoming>W1840_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1840_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1840_Task5" name="For new product certifications: (a) QA Manager submits product samples to…">
        <bpmn:documentation>Step 2: For new product certifications: (a) QA Manager submits product samples to BPS-accredited testing laboratory, (b) laboratory conducts testing per Philippine National Standard (PNS) or relevant international standard, (c) QA Manager submits test results and documentation to DTI-BPS for PS/ICC certification, (d) BPS issues certification (typically 3–6 months for new products), (e) products cannot be imported or sold until certification obtained
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 3–6 months</bpmn:documentation>
        <bpmn:incoming>W1840_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1840_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1840_Task6" name="For certification renewals: (a) system alerts QA Manager 90 days before…">
        <bpmn:documentation>Step 3: For certification renewals: (a) system alerts QA Manager 90 days before certification expiry, (b) QA Manager submits renewal application with updated product testing (if required), (c) BPS renews certification (typically 1–3 months), (d) if renewal delayed: products with expired certification must be removed from shelves until renewed
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 1–3 months</bpmn:documentation>
        <bpmn:incoming>W1840_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1840_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1840_Task7" name="For regulatory changes: (a) QA Manager monitors regulatory updates from DTI…">
        <bpmn:documentation>Step 4: For regulatory changes: (a) QA Manager monitors regulatory updates from DTI, FDA, DENR, BIR, (b) assesses impact on private label products, (c) if product reformulation or relabeling required: coordinates with Buyer and factory per W1832 (specification change process), (d) updated products retested and recertified before distribution
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1840_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1840_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1840_End8" name="Complete">
        <bpmn:incoming>W1840_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1840_Annotation9">
        <bpmn:text>Controls: - CTL-173 (prevent non-compliant private-label products from reaching shelf.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Quality Assurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1840_Assoc10" sourceRef="W1840_Annotation9" targetRef="W1840_Start3" associationDirection="None" />
