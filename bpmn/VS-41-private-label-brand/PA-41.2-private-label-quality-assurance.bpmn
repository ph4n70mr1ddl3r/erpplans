    <bpmn:process id="W_W1843" name="W1843. Private Label Packaging &amp; Labeling Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual compliance audit; new product launch; regulatory change affecting labeling
Frequency: Annual full audit; spot-checks on new receipts
Volume: ~4,000–5,000 active private label SKUs (per the W1265/W1513 canon)
Owner: Quality Assurance Manager
Participants: QA Manager, Category Manager, Legal Counsel
Source: workflow W1843 — Private Label Packaging &amp; Labeling Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W1843_LaneSet2">
        <bpmn:lane id="W1843_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W1843_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1843_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1843_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1843_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1843_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1843_Start3" name="Annual compliance audit; new product launch; regulatory change affecting labeling">
        <bpmn:outgoing>W1843_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1843_Task4" name="QA Manager conducts annual packaging and labeling audit: (a) select random…">
        <bpmn:documentation>Step 1: QA Manager conducts annual packaging and labeling audit: (a) select random sample of 50–100 private label SKUs from store shelves across 5–10 stores, (b) verify each label against Philippine labeling requirements per Consumer Act RA 7394 and DTI regulations: (i) product name and description, (ii) net quantity, (iii) name and address of manufacturer and distributor (BuildRight Depot Corp.), (iv) country of origin, (v) ingredients/material composition (where applicable), (vi) production date or lot number, (vii) expiry date (for shelf-life products), (viii) safety warnings in Filipino and English, (ix) SRP or price, (x) BPS/ICC mark (where required), (c) verify barcode scans correctly to correct SKU in POS system, (d) verify packaging structural integrity: does packaging protect product adequately during distribution?
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1843_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1843_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1843_Task5" name="Document findings and issue corrective actions: (a) minor labeling deficiencies…">
        <bpmn:documentation>Step 2: Document findings and issue corrective actions: (a) minor labeling deficiencies (missing Filipino translation, incorrect font size): issue CAR to Buyer for factory correction in next production run, (b) major labeling deficiencies (missing safety warnings, incorrect product information): immediate relabeling or removal from shelf until corrected, (c) barcode failures: work with Merchandise Planner and IT to resolve; remove from shelf if barcode cannot be scanned at POS
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1843_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1843_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1843_Task6" name="Spot-check on new receipts: (a) for first 3 receipts from a new factory or…">
        <bpmn:documentation>Step 3: Spot-check on new receipts: (a) for first 3 receipts from a new factory or after label redesign: QA Manager or DC Quality Inspector verifies labeling compliance on received goods, (b) if non-conforming: relabel at DC before distribution (cost charged to factory) or return to factory
Responsible (R): QA Manager / DC Quality Inspector
Accountable (A): Category Manager
Duration: 15–30 min/receipt</bpmn:documentation>
        <bpmn:incoming>W1843_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1843_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1843_End7" name="Complete">
        <bpmn:incoming>W1843_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1843_Annotation8">
        <bpmn:text>Controls: - CTL-365 (ensure controlled execution — Private Label Quality Assurance &amp; Compliance (PA-41.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Quality Assurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1843_Assoc9" sourceRef="W1843_Annotation8" targetRef="W1843_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1843_Flow10" sourceRef="W1843_Start3" targetRef="W1843_Task4" />
      <bpmn:sequenceFlow id="W1843_Flow11" sourceRef="W1843_Task4" targetRef="W1843_Task5" />
      <bpmn:sequenceFlow id="W1843_Flow12" sourceRef="W1843_Task5" targetRef="W1843_Task6" />
      <bpmn:sequenceFlow id="W1843_Flow13" sourceRef="W1843_Task6" targetRef="W1843_End7" />
    </bpmn:process>
