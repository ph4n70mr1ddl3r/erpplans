        <bpmndi:BPMNEdge id="W1844_Flow11_di" bpmnElement="W1844_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1844_Flow12_di" bpmnElement="W1844_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1844_Flow13_di" bpmnElement="W1844_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1844_Assoc9_di" bpmnElement="W1844_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1845" name="W1845. Private Label Supplier Social Compliance &amp; Environmental Audit Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual social compliance audit cycle; triggered by media report, NGO investigation, or customer concern about factory conditions
Frequency: Annual social compliance audit for Tier 1 factories; biennial for Tier 2; triggered for cause
Volume: ~8–12 social compliance audits/year
Owner: Quality Assurance Manager
Participants: QA Manager, Category Manager, Third-Party Auditor (BSCI, SMETA), Legal Counsel
Source: workflow W1845 — Private Label Supplier Social Compliance &amp; Environmental Audit Management</bpmn:documentation>
      <bpmn:laneSet id="W1845_LaneSet4">
        <bpmn:lane id="W1845_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W1845_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1845_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1845_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1845_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1845_Lane2" name="Third-Party Auditor">
        <bpmn:flowNodeRef>W1845_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1845_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W1845_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1845_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1845_Start5" name="Annual social compliance audit cycle; triggered by media report, NGO investigation, or…">
        <bpmn:outgoing>W1845_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1845_Task6" name="QA Manager schedules social compliance audits: (a) coordinate with factory…">
        <bpmn:documentation>Step 1: QA Manager schedules social compliance audits: (a) coordinate with factory quality audit schedule (W1838) to combine visits where possible, (b) select audit standard: BSCI (Business Social Compliance Initiative), SMETA (Sedex Members Ethical Trade Audit), or SA8000, (c) engage accredited third-party auditor
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1845_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1845_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1845_Task7" name="Third-party auditor conducts social compliance audit at factory: (a) working…">
        <bpmn:documentation>Step 2: Third-party auditor conducts social compliance audit at factory: (a) working conditions: hours, wages, overtime compliance with local labor laws, (b) health and safety: fire safety, machine guarding, chemical handling, personal protective equipment, (c) child labor and forced labor verification, (d) freedom of association, (e) environmental practices: waste disposal, emissions, water treatment, (f) dormitory conditions (if factory provides worker housing), (g) scoring per BSCI/SMETA methodology: critical, major, minor, observations
Responsible (R): Third-Party Auditor
Accountable (A): QA Manager
Duration: 1–2 days/audit</bpmn:documentation>
        <bpmn:incoming>W1845_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1845_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1845_Task8" name="Critical findings">
        <bpmn:documentation>Step 3: QA Manager reviews audit findings: (a) Critical findings (e.g., child labor, forced labor, imminent safety hazard): immediate order suspension; factory must remediate within 30 days; follow-up verification audit required before orders resume; Category Manager and VP Merchandising notified, (b) Major findings (e.g., excessive overtime, inadequate safety guards): corrective action plan required within 60 days; progress verification within 90 days, (c) Minor findings / observations: factory acknowledges and incorporates into continuous improvement plan; reviewed at next scheduled audit
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 2–4 hours/audit</bpmn:documentation>
        <bpmn:incoming>W1845_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1845_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1845_Task9" name="Annual: QA Manager presents social compliance summary to VP Merchandising and…">
        <bpmn:documentation>Step 4: Annual: QA Manager presents social compliance summary to VP Merchandising and Legal Counsel: (a) audit results by factory with trend comparison, (b) corrective action status and closure rate, (c) risk assessment: factories in regions with known labor or environmental issues, (d) recommendation for factory continuation or transition, (e) summary for ESG reporting per W25 (ESG &amp; Sustainability)
Responsible (R): QA Manager
Accountable (A): VP Merchandising
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1845_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1845_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1845_Task10" name="If triggered by media/NGO report: (a) Legal Counsel assesses legal and…">
        <bpmn:documentation>Step 5: If triggered by media/NGO report: (a) Legal Counsel assesses legal and reputational risk, (b) QA Manager arranges emergency for-cause audit within 2 weeks, (c) if allegations confirmed: immediate remediation plan or factory suspension, (d) CMO prepares media response if public communication required
Responsible (R): Legal Counsel / QA Manager
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1845_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1845_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1845_End11" name="Complete">
        <bpmn:incoming>W1845_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1845_Annotation12">
