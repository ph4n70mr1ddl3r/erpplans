        <bpmndi:BPMNEdge id="W1843_Flow11_di" bpmnElement="W1843_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1843_Flow12_di" bpmnElement="W1843_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1843_Flow13_di" bpmnElement="W1843_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1843_Assoc9_di" bpmnElement="W1843_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1844" name="W1844. Private Label Incoming Quality Trend Analysis &amp; Factory Scorecard Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle
Frequency: Monthly trend analysis; quarterly factory scorecard update
Volume: ~15–25 active private label factories
Owner: Quality Assurance Manager
Participants: QA Manager, Category Manager, Buyer
Source: workflow W1844 — Private Label Incoming Quality Trend Analysis &amp; Factory Scorecard Integration</bpmn:documentation>
      <bpmn:laneSet id="W1844_LaneSet2">
        <bpmn:lane id="W1844_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W1844_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1844_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1844_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1844_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1844_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1844_Start3" name="Monthly reporting cycle">
        <bpmn:outgoing>W1844_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1844_Task4" name="Monthly: QA Manager compiles incoming quality data for private label products…">
        <bpmn:documentation>Step 1: Monthly: QA Manager compiles incoming quality data for private label products: (a) defect rate by factory (defective units ÷ total received units × 100), (b) defect type distribution: cosmetic, functional, packaging, labeling, safety, (c) rejection rate: % of receipts rejected or requiring corrective action, (d) trend analysis: is quality improving, stable, or deteriorating by factory? (e) correlation analysis: defect rate vs. factory audit score — do factories with lower audit scores have higher defect rates?
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1844_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1844_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1844_Task5" name="Quarterly: QA Manager updates factory quality scorecard integrated with W44…">
        <bpmn:documentation>Step 2: Quarterly: QA Manager updates factory quality scorecard integrated with W44 (vendor performance): (a) quality dimension score (40% weight): defect rate, rejection rate, corrective action closure rate, (b) delivery dimension score (20% weight): on-time delivery, lead time consistency, (c) cost dimension score (20% weight): price competitiveness, landed cost variance, (d) responsiveness dimension score (20% weight): communication timeliness, complaint resolution speed, (e) overall weighted score → factory tier classification (Tier 1: ≥ 85%, Tier 2: 70–84%, Tier 3: &lt; 70%)
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 4–6 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1844_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1844_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1844_Task6" name="Quarterly: QA Manager presents quality trend report to Category Manager and VP…">
        <bpmn:documentation>Step 3: Quarterly: QA Manager presents quality trend report to Category Manager and VP Merchandising with recommendations: (a) factories for upgrade/downgrade in audit frequency, (b) factories requiring corrective action intervention, (c) factories recommended for transition (W1837), (d) product categories with quality issues requiring specification review (W1832)
Responsible (R): QA Manager
Accountable (A): VP Merchandising
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W1844_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1844_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1844_End7" name="Complete">
        <bpmn:incoming>W1844_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1844_Annotation8">
        <bpmn:text>Controls: - CTL-365 (ensure controlled execution — Private Label Quality Assurance &amp; Compliance (PA-41.2).) | - operational: Quality Assurance Manager review and approval gate
Owner: Quality Assurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1844_Assoc9" sourceRef="W1844_Annotation8" targetRef="W1844_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1844_Flow10" sourceRef="W1844_Start3" targetRef="W1844_Task4" />
      <bpmn:sequenceFlow id="W1844_Flow11" sourceRef="W1844_Task4" targetRef="W1844_Task5" />
      <bpmn:sequenceFlow id="W1844_Flow12" sourceRef="W1844_Task5" targetRef="W1844_Task6" />
      <bpmn:sequenceFlow id="W1844_Flow13" sourceRef="W1844_Task6" targetRef="W1844_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1844_diag">
      <bpmndi:BPMNPlane id="W1844_plane" bpmnElement="W_W1844">
        <bpmndi:BPMNShape id="W1844_Lane1_di" bpmnElement="W1844_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_Task4_di" bpmnElement="W1844_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_Task5_di" bpmnElement="W1844_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_Task6_di" bpmnElement="W1844_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_Start3_di" bpmnElement="W1844_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_End7_di" bpmnElement="W1844_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1844_Annotation8_di" bpmnElement="W1844_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
