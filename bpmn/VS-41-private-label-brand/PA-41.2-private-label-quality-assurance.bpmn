      <bpmndi:BPMNPlane id="W1838_plane" bpmnElement="W_W1838">
        <bpmndi:BPMNShape id="W1838_Lane1_di" bpmnElement="W1838_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
