      <bpmndi:BPMNPlane id="W1839_plane" bpmnElement="W_W1839">
        <bpmndi:BPMNShape id="W1839_Lane1_di" bpmnElement="W1839_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
