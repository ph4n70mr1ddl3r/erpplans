<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-41.2-private-label-quality-assurance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1838" name="W1838. Private Label Ongoing Production Quality Monitoring &amp; Factory Audit Program" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing program; periodic factory audits scheduled semi-annually or annually per factory risk tier
Frequency: Semi-annual audit for Tier 1 factories (top volume); annual for Tier 2; triggered for cause (quality incident, delivery failure)
Volume: ~15–25 active private label factories; ~20–30 scheduled audits/year (10 Tier-1 on-site + 10–20 Tier-2, many as desk audits) + ~2–4 for-cause audits
Owner: Quality Assurance Manager
Participants: QA Manager, Buyer, Factory Quality Team, Third-Party Auditor (SGS/BV)
Source: workflow W1838 — Private Label Ongoing Production Quality Monitoring &amp; Factory Audit Program</bpmn:documentation>
      <bpmn:laneSet id="W1838_LaneSet3">
        <bpmn:lane id="W1838_Lane1" name="QA Manager">
        <bpmn:flowNodeRef>W1838_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1838_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1838_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1838_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1838_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1838_Lane2" name="Third-Party Auditor">
        <bpmn:flowNodeRef>W1838_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1838_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1838_Start4" name="Ongoing program; periodic factory audits scheduled semi-annually or annually per factory…">
        <bpmn:outgoing>W1838_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1838_Task5" name="QA Manager schedules factory audit calendar at start of year: (a) tier…">
        <bpmn:documentation>Step 1: QA Manager schedules factory audit calendar at start of year: (a) tier factories by risk: Tier 1 (top 5 by volume — semi-annual), Tier 2 (remaining — annual), (b) coordinate audit dates with factory and Buyer (production schedule awareness), (c) select audit type: on-site for Tier 1 and new factories; desk audit (document review + video walkthrough) for Tier 2 with consistently high scores (≥ 90%), (d) engage third-party auditor for on-site audits in China/Taiwan (QA Manager does not travel for routine audits)
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1838_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1838_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1838_Task6" name="Pre-audit preparation: (a) QA Manager compiles factory performance data from…">
        <bpmn:documentation>Step 2: Pre-audit preparation: (a) QA Manager compiles factory performance data from previous period: defect rate, delivery performance, customer complaint rate, corrective action closure rate, (b) identify specific focus areas for this audit based on performance trends and known issues, (c) prepare audit checklist customized to product category and factory, (d) send audit notification to factory 2 weeks in advance with scope and documentation requirements
Responsible (R): QA Manager
Accountable (A): —
Duration: 2–4 hours/audit</bpmn:documentation>
        <bpmn:incoming>W1838_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1838_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1838_Task7" name="Conduct factory audit (on-site by third-party auditor or desk review by QA…">
        <bpmn:documentation>Step 3: Conduct factory audit (on-site by third-party auditor or desk review by QA Manager): (a) production process review: raw material control, manufacturing parameters, in-process QC, final inspection, (b) quality management system verification: documentation, calibration records, training records, corrective action logs, (c) product testing review: witness or review test results per BuildRight specification requirements, (d) social compliance walkthrough: working conditions, safety, environmental practices, (e) review factory&#x27;s own incoming material quality records (traceability to sub-suppliers), (f) scoring: rate factory on 50-point scale across quality, process, social compliance, environmental categories
Responsible (R): Third-Party Auditor / QA Manager
Accountable (A): QA Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1838_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1838_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1838_Task8" name="QA Manager reviews audit report and communicates results: (a) if score ≥ 85%…">
        <bpmn:documentation>Step 4: QA Manager reviews audit report and communicates results: (a) if score ≥ 85%: satisfactory — continue standard monitoring, (b) if score 70–84%: issue corrective action request (CAR) for identified non-conformances; factory must respond within 30 days with corrective action plan; follow-up verification within 90 days, (c) if score &lt; 70%: critical — Buyer notified; Category Manager reviews; if critical findings relate to product safety or regulatory compliance: halt orders until corrective actions verified, (d) share audit results with Buyer for vendor scorecard integration (W44)
Responsible (R): QA Manager
Accountable (A): Category Manager
Duration: 2–4 hours/audit</bpmn:documentation>
        <bpmn:incoming>W1838_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1838_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1838_Task9" name="Quarterly: QA Manager presents factory quality summary to Category Manager and…">
        <bpmn:documentation>Step 5: Quarterly: QA Manager presents factory quality summary to Category Manager and VP Merchandising: (a) audit score trends by factory, (b) open corrective action items and closure rate, (c) quality incidents by factory and resolution status, (d) recommendation for factory tier reclassification (upgrade/downgrade), (e) recommendation for factory transition (W1837) if chronic underperformance
Responsible (R): QA Manager
Accountable (A): VP Merchandising
Duration: 1 hour/quarter</bpmn:documentation>
        <bpmn:incoming>W1838_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1838_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1838_End10" name="Complete">
        <bpmn:incoming>W1838_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1838_Annotation11">
        <bpmn:text>Controls: - CTL-365 (ensure controlled execution — Private Label Quality Assurance &amp; Compliance (PA-41.2).) | - operational: Quality Assurance Manager review and approval gate
Owner: Quality Assurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1838_Assoc12" sourceRef="W1838_Annotation11" targetRef="W1838_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1838_Flow13" sourceRef="W1838_Start4" targetRef="W1838_Task5" />
      <bpmn:sequenceFlow id="W1838_Flow14" sourceRef="W1838_Task5" targetRef="W1838_Task6" />
      <bpmn:sequenceFlow id="W1838_Flow15" sourceRef="W1838_Task6" targetRef="W1838_Task7" />
      <bpmn:sequenceFlow id="W1838_Flow16" sourceRef="W1838_Task7" targetRef="W1838_Task8" />
      <bpmn:sequenceFlow id="W1838_Flow17" sourceRef="W1838_Task8" targetRef="W1838_Task9" />
      <bpmn:sequenceFlow id="W1838_Flow18" sourceRef="W1838_Task9" targetRef="W1838_End10" />
    </bpmn:process>
