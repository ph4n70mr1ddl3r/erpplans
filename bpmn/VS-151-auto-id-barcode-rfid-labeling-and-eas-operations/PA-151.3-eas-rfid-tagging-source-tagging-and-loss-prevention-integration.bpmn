        <bpmn:outgoing>W4497_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4497_Task6" name="Stores/LP operate EAS gates/deactivators daily (power-up test, sensitivity…">
        <bpmn:documentation>Step 1: Stores/LP operate EAS gates/deactivators daily (power-up test, sensitivity check, deactivator-pad function), logging health per W4485 standard
Responsible (R): Stores / LP
Accountable (A): Store Manager / LP Director
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4497_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4497_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4497_Task7" name="IT/LP monitor EAS exception alerts (gate triggers), classify (true alarm vs…">
        <bpmn:documentation>Step 2: IT/LP monitor EAS exception alerts (gate triggers), classify (true alarm vs false), and route true positives to LP response (W4501)
Responsible (R): IT / LP
Accountable (A): LP Director
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4497_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4497_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4497_Task8" name="IFM/IT maintain EAS hardware (gate calibration/deactivator replacement) via…">
        <bpmn:documentation>Step 3: IFM/IT maintain EAS hardware (gate calibration/deactivator replacement) via VS-138/VS-99, tuning sensitivity to minimize false alarms while catching real events
Responsible (R): IFM / IT
Accountable (A): LP Director / IFM Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4497_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4497_End9" name="Complete">
        <bpmn:incoming>W4497_Flow15</bpmn:incoming>
      </bpmn:endEvent>
