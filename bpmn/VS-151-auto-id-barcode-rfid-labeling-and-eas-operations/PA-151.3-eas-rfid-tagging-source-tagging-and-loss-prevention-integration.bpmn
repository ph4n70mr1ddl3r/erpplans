    <bpmn:process id="W_W4497" name="W4497. EAS System Operations (Gates, Deactivators, Exception Alerts)" isExecutable="false">
      <bpmn:documentation>Trigger: Store open (VS-07.1); alarm; system health check
Frequency: Daily ops + continuous monitoring
Volume: EAS gates at all 200 store exits + deactivators at 600 POS
Owner: Loss Prevention (VS-23) / Stores (VS-07) / IT (VS-27)
Participants: IFM (VS-138), ITAM (VS-99), Auto-ID Lead
Source: workflow W4497 — EAS System Operations (Gates, Deactivators, Exception Alerts)</bpmn:documentation>
      <bpmn:laneSet id="W4497_LaneSet4">
        <bpmn:lane id="W4497_Lane1" name="Stores">
