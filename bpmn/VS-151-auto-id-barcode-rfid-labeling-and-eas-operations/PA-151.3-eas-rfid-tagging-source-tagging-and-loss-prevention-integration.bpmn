    <bpmn:process id="W_W4499" name="W4499. RFID Infrastructure, Encoding &amp; Read-Zone Operations" isExecutable="false">
      <bpmn:documentation>Trigger: RFID program rollout; cycle-count (VS-05); real-time inventory (VS-60)
Frequency: Per program + continuous read-zone ops
Volume: RFID readers (handheld/fixed/smart-shelf) at RFID-enabled stores/DCs
Owner: Auto-ID Lead / IT (VS-27) / Inventory (VS-05)
Participants: DC (VS-04), Stores (VS-07), Omnichannel (VS-60), ITAM (VS-99)
Source: workflow W4499 — RFID Infrastructure, Encoding &amp; Read-Zone Operations</bpmn:documentation>
      <bpmn:laneSet id="W4499_LaneSet4">
        <bpmn:lane id="W4499_Lane1" name="Auto-ID Lead">
        <bpmn:flowNodeRef>W4499_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4499_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
