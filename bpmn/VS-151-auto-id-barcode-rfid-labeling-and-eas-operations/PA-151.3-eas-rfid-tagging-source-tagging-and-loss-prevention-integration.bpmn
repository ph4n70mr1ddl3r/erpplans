        <bpmn:flowNodeRef>W4503_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4503_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4503_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4503_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4503_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4503_Start4" name="Periodic review; program ROI; shrink trend">
        <bpmn:outgoing>W4503_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4503_Task5" name="LP/BI measure EAS/RFID performance (catch rate, false-alarm rate, tag coverage…">
        <bpmn:documentation>Step 1: LP/BI measure EAS/RFID performance (catch rate, false-alarm rate, tag coverage, read accuracy) and tag-ROI (shrink reduction vs tagging cost) by category/store
Responsible (R): LP / BI / Auto-ID Lead
Accountable (A): LP Director
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4503_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4503_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4503_Task6" name="LP/Merchandising correlate tagging coverage with shrink outcomes (VS-23/W840)…">
        <bpmn:documentation>Step 2: LP/Merchandising correlate tagging coverage with shrink outcomes (VS-23/W840), identify under-protected categories, and tune the W4484 tagging policy
Responsible (R): LP / Merchandising
Accountable (A): LP Director / VP Merch
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4503_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4503_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4503_Task7" name="Finance/LP report shrink impact vs the &lt; 1.5% target (profile §12.3) and…">
        <bpmn:documentation>Step 3: Finance/LP report shrink impact vs the &lt; 1.5% target (profile §12.3) and tagging spend (links to VS-17.4/VS-135), driving investment decisions
Responsible (R): Finance / LP
Accountable (A): CFO / LP Director
Duration: Quarterly</bpmn:documentation>
