    <bpmn:process id="W_W4503" name="W4503. EAS/RFID Performance, Tag-ROI &amp; Shrink Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic review; program ROI; shrink trend
Frequency: Monthly + quarterly
Volume: EAS/RFID/tagging performance vs shrink (&lt; 1.5% target) enterprise-wide
Owner: LP (VS-23) / Auto-ID Lead / BI (VS-28)
Participants: Merchandising (VS-01), Finance (VS-17.4), Revenue Assurance (VS-118)
Source: workflow W4503 — EAS/RFID Performance, Tag-ROI &amp; Shrink Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4503_LaneSet3">
        <bpmn:lane id="W4503_Lane1" name="LP">
