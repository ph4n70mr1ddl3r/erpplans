      <bpmn:startEvent id="W4504_Start4" name="Fraud incident (VS-23/VS-125); privacy review; audit">
        <bpmn:outgoing>W4504_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4504_Task5" name="LP/Fraud/Auto-ID Lead identify auto-ID fraud vectors (cloned/counterfeit…">
        <bpmn:documentation>Step 1: LP/Fraud/Auto-ID Lead identify auto-ID fraud vectors (cloned/counterfeit barcodes for price-switching, fake PS/ICC labels VS-117, RFID/EAS defeat, label-swap at return VS-32) and design countermeasures
Responsible (R): LP / Fraud / Auto-ID Lead
Accountable (A): LP Director / Head of Fraud
Duration: Annual + on incident</bpmn:documentation>
        <bpmn:incoming>W4504_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4504_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4504_Task6" name="LP/Auto-ID Lead deploy countermeasures (anti-clone 2D codes, tamper-evident…">
        <bpmn:documentation>Step 2: LP/Auto-ID Lead deploy countermeasures (anti-clone 2D codes, tamper-evident tags, return-receipt label match, EAS-defeat detection) and coordinate with Anti-Counterfeit (VS-71)
Responsible (R): LP / Auto-ID Lead
Accountable (A): LP Director
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4504_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4504_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4504_Task7" name="Compliance/Privacy/Audit ensure auto-ID practices respect data privacy…">
        <bpmn:documentation>Step 3: Compliance/Privacy/Audit ensure auto-ID practices respect data privacy (RFID/EAS event data on shoppers VS-91) and are audited (VS-21), with incident response (VS-23/VS-125)
Responsible (R): Compliance / Privacy / Audit
Accountable (A): VP Legal / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4504_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4504_End8" name="Complete">
        <bpmn:incoming>W4504_Flow14</bpmn:incoming>
      </bpmn:endEvent>
