        <bpmn:outgoing>W4499_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4499_Task6" name="Auto-ID Lead/IT design/deploy RFID read-zones (DC portals, store handhelds…">
        <bpmn:documentation>Step 1: Auto-ID Lead/IT design/deploy RFID read-zones (DC portals, store handhelds, smart-shelf) per the W4484 policy, encode tags to the GS1 EPC standard (W4482), and integrate reads to inventory (VS-05/VS-60)
Responsible (R): Auto-ID Lead / IT / Inventory
Accountable (A): CIO / Inventory Manager
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W4499_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4499_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4499_Task7" name="DC/Stores use RFID for cycle-counting (VS-05.1) and receiving (VS-04) — bulk…">
        <bpmn:documentation>Step 2: DC/Stores use RFID for cycle-counting (VS-05.1) and receiving (VS-04) — bulk scan vs line-by-line — improving count speed/accuracy toward the ≥97% target
Responsible (R): DC / Stores / Auto-ID Lead
Accountable (A): DC Manager / Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4499_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4499_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4499_Task8" name="IT/ITAM operate the RFID infrastructure (reader health, read-zone tuning…">
        <bpmn:documentation>Step 3: IT/ITAM operate the RFID infrastructure (reader health, read-zone tuning, interference mgmt) via VS-99/VS-138, and feed exceptions (reads-outside-expected) to LP (VS-23)
Responsible (R): IT / ITAM / LP
Accountable (A): CIO / LP Director
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4499_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4499_End9" name="Complete">
        <bpmn:incoming>W4499_Flow15</bpmn:incoming>
      </bpmn:endEvent>
