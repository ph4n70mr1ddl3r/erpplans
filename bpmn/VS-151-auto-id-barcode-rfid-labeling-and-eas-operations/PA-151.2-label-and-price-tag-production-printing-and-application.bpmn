    <bpmn:process id="W_W4490" name="W4490. Centralized Label/Price-Tag Print Job Management" isExecutable="false">
      <bpmn:documentation>Trigger: Price/promo change; new-item setup; reprint request
Frequency: Daily (price/promo), per onboarding
Volume: Print jobs across 35K SKUs × 200 stores; bi-monthly sale events
Owner: Auto-ID Lead / Pricing (VS-01.2)
Participants: IT (VS-27), PIM (VS-137), Stores (VS-07), Marketing (VS-14)
Source: workflow W4490 — Centralized Label/Price-Tag Print Job Management</bpmn:documentation>
      <bpmn:laneSet id="W4490_LaneSet4">
        <bpmn:lane id="W4490_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W4490_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4490_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4490_Lane2" name="IT">
        <bpmn:flowNodeRef>W4490_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4490_Lane3" name="Stores">
        <bpmn:flowNodeRef>W4490_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4490_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4490_Start5" name="Price/promo change; new-item setup; reprint request">
        <bpmn:outgoing>W4490_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4490_Task6" name="Pricing/Auto-ID Lead generate print jobs from the PIM/template library…">
        <bpmn:documentation>Step 1: Pricing/Auto-ID Lead generate print jobs from the PIM/template library (VS-137/W4483) — shelf-edge, hang-tag, adhesive — filtered by store/section/SKU and effective date
Responsible (R): Pricing / Auto-ID Lead
Accountable (A): VP Merch
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4490_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4490_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4490_Task7" name="IT distribute print jobs to store/DC printers (push to RF/PC printers), confirm…">
        <bpmn:documentation>Step 2: IT distribute print jobs to store/DC printers (push to RF/PC printers), confirm print receipt, and log the job for reconciliation (W4496)
Responsible (R): IT / Auto-ID Lead
Accountable (A): CIO
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4490_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4490_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4490_Task8" name="Stores execute the print job, apply labels (W4491/W4492), and close the job…">
        <bpmn:documentation>Step 3: Stores execute the print job, apply labels (W4491/W4492), and close the job with application confirmation/compliance (links to VS-63 task mgmt)
Responsible (R): Stores
Accountable (A): Store Manager
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4490_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4490_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4490_End9" name="Complete">
        <bpmn:incoming>W4490_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4490_Annotation10">
        <bpmn:text>Controls: - CTL-684 (ensure controlled execution — Label &amp; Price-Tag Production, Printing &amp; In-Store Application (PA-151.2).) | - CTL-684: print job receipt-confirmed &amp; application-compliance-closed; RA 7394 price current (VS-118)
Owner: Auto-ID Lead / Pricing (VS-01.2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4490_Assoc11" sourceRef="W4490_Annotation10" targetRef="W4490_Start5" associationDirection="None" />
