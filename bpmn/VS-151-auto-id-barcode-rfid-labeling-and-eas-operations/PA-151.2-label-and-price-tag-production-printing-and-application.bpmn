    <bpmn:process id="W_W4489" name="W4489. Label Production Fleet Operations &amp; Consumable Management" isExecutable="false">
      <bpmn:documentation>Trigger: Fleet ops; consumable reorder; new store (VS-37)
Frequency: Daily ops + per-store replenishment
Volume: Label printers + media (thermal rolls, tags, ribbons) across 200 stores + 4 DCs + HQ
Owner: Auto-ID Lead / IT (VS-27) / Stores (VS-07)
Participants: ITAM (VS-99), Procurement (VS-34), DC (VS-04), IFM (VS-138)
Source: workflow W4489 — Label Production Fleet Operations &amp; Consumable Management</bpmn:documentation>
      <bpmn:laneSet id="W4489_LaneSet4">
        <bpmn:lane id="W4489_Lane1" name="Stores">
        <bpmn:flowNodeRef>W4489_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4489_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
