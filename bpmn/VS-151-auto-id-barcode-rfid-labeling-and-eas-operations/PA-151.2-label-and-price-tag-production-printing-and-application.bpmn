        <bpmn:flowNodeRef>W4489_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4489_Start5" name="Fleet ops; consumable reorder; new store (VS-37)">
        <bpmn:outgoing>W4489_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4489_Task6" name="Stores/IT operate the per-store label-printer fleet (load media, replace…">
        <bpmn:documentation>Step 1: Stores/IT operate the per-store label-printer fleet (load media, replace ribbons, clean printheads), following the W4485 standard and IFM preventative maintenance (VS-138)
Responsible (R): Stores / IT
Accountable (A): Store Manager / IT Asset Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4489_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4489_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4489_Task7" name="Procurement/Auto-ID Lead manage consumable supply (media/ribbon min-max per…">
        <bpmn:documentation>Step 2: Procurement/Auto-ID Lead manage consumable supply (media/ribbon min-max per store, central reorder, vendor consolidation VS-34), with shrink-controlled media (links to VS-23 — media is a fraud/counterfeit vector)
Responsible (R): Procurement / Auto-ID Lead
Accountable (A): Procurement Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4489_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4489_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4489_Task8" name="IT/ITAM track printer fleet health, PM, and refresh via VS-99, and feed…">
        <bpmn:documentation>Step 3: IT/ITAM track printer fleet health, PM, and refresh via VS-99, and feed failures to the service desk (VS-27.1)
Responsible (R): IT / ITAM
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4489_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4489_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4489_End9" name="Complete">
        <bpmn:incoming>W4489_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4489_Annotation10">
        <bpmn:text>Controls: - CTL-684 (ensure controlled execution — Label &amp; Price-Tag Production, Printing &amp; In-Store Application (PA-151.2).) | - CTL-684: media supply chain-controlled (VS-23); printer fleet PM&#x27;d (VS-138/VS-99); RA 7394 stock continuity
Owner: Auto-ID Lead / IT (VS-27) / Stores (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
