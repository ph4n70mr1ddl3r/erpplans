    <bpmn:process id="W_W4492" name="W4492. Hang-Tag, Adhesive &amp; Bulk-Yard Tag Application" isExecutable="false">
      <bpmn:documentation>Trigger: Receiving (VS-07.3); new-item; tag damage
Frequency: Per receipt + daily
Volume: Hang-tags/adhesive on tools/hardware/appliances; bulk-yard tags on lumber/cement/tiles
Owner: Stores (VS-07) / DC (VS-04)
Participants: Receiving (VS-07.3), Merchandising (VS-01), LP (VS-23)
Source: workflow W4492 — Hang-Tag, Adhesive &amp; Bulk-Yard Tag Application</bpmn:documentation>
      <bpmn:laneSet id="W4492_LaneSet4">
        <bpmn:lane id="W4492_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W4492_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4492_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4492_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W4492_Task7</bpmn:flowNodeRef>
