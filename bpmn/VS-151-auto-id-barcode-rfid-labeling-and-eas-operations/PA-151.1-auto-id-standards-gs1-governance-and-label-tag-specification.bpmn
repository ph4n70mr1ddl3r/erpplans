      <bpmn:startEvent id="W4488_Start5" name="GTIN/format/tag change; price change; promo; system sync">
        <bpmn:outgoing>W4488_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4488_Task6" name="Auto-ID Lead/IT govern change control for GTIN/barcode/format/tag data…">
        <bpmn:documentation>Step 1: Auto-ID Lead/IT govern change control for GTIN/barcode/format/tag data (request, approve, effective-date, rollback) and the POS↔ERP↔PIM↔WMS synchronization (profile §14.3 near-real-time)
Responsible (R): Auto-ID Lead / IT / Master Data
Accountable (A): CIO / Master Data Manager
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4488_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4488_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4488_Task7" name="Pricing/Promotions push price/promo changes to shelf-edge labels and POS (links…">
        <bpmn:documentation>Step 2: Pricing/Promotions push price/promo changes to shelf-edge labels and POS (links to VS-01.2/VS-58), with reprint triggers and effective-time coordination (bi-monthly sale events)
Responsible (R): Pricing / Auto-ID Lead / IT
Accountable (A): VP Merch / CIO
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W4488_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4488_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4488_Task8" name="IT/Auto-ID Lead monitor sync health (latency &lt; 30s per profile §15.3)…">
        <bpmn:documentation>Step 3: IT/Auto-ID Lead monitor sync health (latency &lt; 30s per profile §15.3), reconcile POS-local cache vs central, and resolve drift before it reaches the customer (links to VS-118)
Responsible (R): IT / Auto-ID Lead
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4488_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4488_End9" name="Complete">
        <bpmn:incoming>W4488_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4488_Annotation10">
        <bpmn:text>Controls: - CTL-150 (ensure labeling &amp; Auto-ID data integrity.) | - CTL-683: auto-ID changes change-controlled &amp; effective-dated; sync latency monitored (&lt; 30s); cross-channel price/label reconciled (VS-118)
Owner: Auto-ID Lead / IT (VS-27) / Master Data (VS-29)</bpmn:text>
      </bpmn:textAnnotation>
