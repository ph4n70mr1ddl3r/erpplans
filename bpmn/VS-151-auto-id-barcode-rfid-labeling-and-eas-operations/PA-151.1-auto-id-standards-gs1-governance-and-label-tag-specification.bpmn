    <bpmn:process id="W_W4488" name="W4488. Auto-ID Change Control, Synchronization &amp; Master-Data Handshake" isExecutable="false">
      <bpmn:documentation>Trigger: GTIN/format/tag change; price change; promo; system sync
Frequency: Per change (frequent — price/promo daily)
Volume: Auto-ID data changes synced POS↔ERP↔PIM↔WMS (profile §14.3)
Owner: Auto-ID Lead / IT (VS-27) / Master Data (VS-29)
Participants: Pricing (VS-01.2), Promotions (VS-58), Ecommerce (VS-10), EA (VS-113)
Source: workflow W4488 — Auto-ID Change Control, Synchronization &amp; Master-Data Handshake</bpmn:documentation>
      <bpmn:laneSet id="W4488_LaneSet4">
        <bpmn:lane id="W4488_Lane1" name="Auto-ID Lead">
        <bpmn:flowNodeRef>W4488_Task6</bpmn:flowNodeRef>
