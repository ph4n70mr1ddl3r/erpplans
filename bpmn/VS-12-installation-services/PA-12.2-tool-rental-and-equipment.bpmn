    <bpmn:process id="W_W1376" name="W1376. Tool Rental Revenue Analytics, Utilization Optimization &amp; Store Performance Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly rental performance reporting cycle; or quarterly fleet review per W1172.6; or Category Manager requests store-level rental benchmarking
Frequency: Monthly reporting; quarterly deep-dive analysis
Volume: 200 stores × ~7–8 rental units each = ~1,500 units; ~1,000–1,500 rentals/month chain-wide
Owner: Rental Fleet Manager (HQ)
Participants: Rental Fleet Manager, Category Manager (Tools), VP Merchandising, Store Manager (store-level review), BI Analyst
Source: workflow W1376 — Tool Rental Revenue Analytics, Utilization Optimization &amp; Store Performance Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W1376_LaneSet4">
        <bpmn:lane id="W1376_Lane1" name="System">
        <bpmn:flowNodeRef>W1376_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1376_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1376_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1376_Lane2" name="BI Analyst">
        <bpmn:flowNodeRef>W1376_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1376_Lane3" name="Rental Fleet Manager">
        <bpmn:flowNodeRef>W1376_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1376_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1376_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1376_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1376_Start5" name="Monthly rental performance reporting cycle; or quarterly fleet review per W1172.6; or…">
        <bpmn:outgoing>W1376_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1376_Task6" name="System generates monthly rental performance report: (a) total rental revenue by…">
        <bpmn:documentation>Step 1: System generates monthly rental performance report: (a) total rental revenue by store, tool category, and unit; (b) utilization rate by unit (rental days ÷ available days); (c) average rental duration by tool category; (d) average revenue per rental day; (e) overdue rate by store; (f) breakdown rate by tool category and unit age; (g) consumable attach rate (revenue from blades, bits, fuel sold alongside rentals); (h) customer segment analysis (B2C DIYer vs. trade professional)
Responsible (R): System
Accountable (A): Rental Fleet Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1376_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1376_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1376_Task7" name="BI Analyst enriches report with: (a) rental revenue per sqm of store rental…">
        <bpmn:documentation>Step 2: BI Analyst enriches report with: (a) rental revenue per sqm of store rental display area; (b) rental gross margin (rental revenue minus depreciation, maintenance cost, parts cost, PPE cost); (c) trend analysis vs. prior month and same month prior year; (d) correlation between rental activity and store-level sales in complementary categories (e.g., tile cutter rentals correlated with tile sales)
Responsible (R): BI Analyst
Accountable (A): Rental Fleet Manager
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1376_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1376_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1376_Task8" name="Rental Fleet Manager produces store performance benchmarking: (a) rank all 200…">
        <bpmn:documentation>Step 3: Rental Fleet Manager produces store performance benchmarking: (a) rank all 200 stores by rental revenue, utilization rate, and gross margin; (b) identify top 20 stores (best practices to replicate) and bottom 20 stores (coaching or fleet reallocation); (c) compare stores within same geographic region to control for market differences; (d) flag stores where utilization &lt; 30% for three consecutive months as candidates for fleet reduction per W1172
Responsible (R): Rental Fleet Manager
Accountable (A): Category Manager
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1376_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1376_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1376_Task9" name="High demand, low supply stores">
        <bpmn:documentation>Step 4: Rental Fleet Manager identifies optimization actions: (a) High demand, low supply stores: recommend fleet augmentation per W1172 (add units to stores where utilization consistently &gt; 80%); (b) Low demand, high supply stores: recommend fleet redistribution (move underutilized units to high-demand stores); (c) Category expansion: tool categories with consistently high utilization and long waitlists per W1318 indicate demand for additional units or new tool types; (d) Category contraction: tool categories with &lt; 25% utilization across multiple stores flagged for potential removal; (e) Pricing optimization: tool categories with &gt; 90% utilization and no waitlist may be underpriced — price increase test recommended
Responsible (R): Rental Fleet Manager
Accountable (A): Category Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1376_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1376_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1376_Task10" name="Quarterly: Rental Fleet Manager presents rental performance review to Category…">
        <bpmn:documentation>Step 5: Quarterly: Rental Fleet Manager presents rental performance review to Category Manager and VP Merchandising: (a) total rental revenue and gross margin vs. plan; (b) fleet utilization heat map by store and category; (c) recommended fleet movements (additions, redistributions, retirements); (d) capital expenditure request for fleet additions per W1172; (e) pricing adjustment recommendations; (f) new tool category proposals (based on customer requests and market trends)
Responsible (R): Rental Fleet Manager
Accountable (A): VP Merchandising
Duration: Half day/quarter</bpmn:documentation>
        <bpmn:incoming>W1376_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1376_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1376_Task11" name="Store Manager receives monthly store-level rental scorecard: (a) store&#x27;s rental…">
        <bpmn:documentation>Step 6: Store Manager receives monthly store-level rental scorecard: (a) store&#x27;s rental revenue, utilization, and gross margin vs. chain average and regional peers; (b) overdue and breakdown rates vs. chain average; (c) consumable attach rate; (d) specific improvement recommendations (e.g., &quot;Increase weekend rental promotion for tile cutters — store is below regional average&quot;); (e) Store Manager includes rental performance in monthly store review per W67
Responsible (R): System / Rental Fleet Manager
Accountable (A): Store Manager
Duration: 15 min/store/month</bpmn:documentation>
        <bpmn:incoming>W1376_Flow20</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1376_End12" name="Complete">
        <bpmn:incoming>W1376_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1376_Annotation13">
        <bpmn:text>Controls: - CTL-276 (ensure controlled execution — Tool Rental &amp; Equipment (PA-12.2).) | - operational: Rental Fleet Manager review and approval gate
Owner: Rental Fleet Manager (HQ)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1376_Assoc14" sourceRef="W1376_Annotation13" targetRef="W1376_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1376_Flow15" sourceRef="W1376_Start5" targetRef="W1376_Task6" />
      <bpmn:sequenceFlow id="W1376_Flow16" sourceRef="W1376_Task6" targetRef="W1376_Task7" />
      <bpmn:sequenceFlow id="W1376_Flow17" sourceRef="W1376_Task7" targetRef="W1376_Task8" />
      <bpmn:sequenceFlow id="W1376_Flow18" sourceRef="W1376_Task8" targetRef="W1376_Task9" />
      <bpmn:sequenceFlow id="W1376_Flow19" sourceRef="W1376_Task9" targetRef="W1376_Task10" />
      <bpmn:sequenceFlow id="W1376_Flow20" sourceRef="W1376_Task10" targetRef="W1376_Task11" />
      <bpmn:sequenceFlow id="W1376_Flow21" sourceRef="W1376_Task11" targetRef="W1376_End12" />
    </bpmn:process>
