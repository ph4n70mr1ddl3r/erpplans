        <bpmndi:BPMNShape id="W1172_Task11_di" bpmnElement="W1172_Task11"><dc:Bounds x="1240" y="635" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1172_Task12_di" bpmnElement="W1172_Task12"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1172_Start6_di" bpmnElement="W1172_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1172_End13_di" bpmnElement="W1172_End13"><dc:Bounds x="1680" y="657" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1172_Annotation14_di" bpmnElement="W1172_Annotation14"><dc:Bounds x="160" y="800" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1172_Flow16_di" bpmnElement="W1172_Flow16"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow17_di" bpmnElement="W1172_Flow17"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow18_di" bpmnElement="W1172_Flow18"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow19_di" bpmnElement="W1172_Flow19"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow20_di" bpmnElement="W1172_Flow20"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow21_di" bpmnElement="W1172_Flow21"><di:waypoint x="1420" y="675" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Flow22_di" bpmnElement="W1172_Flow22"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1172_Assoc15_di" bpmnElement="W1172_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1374" name="W1374. Tool Rental Equipment Breakdown, Emergency Repair Dispatch &amp; Substitute Unit Provisioning" isExecutable="false">
      <bpmn:documentation>Trigger: Customer reports tool breakdown during rental period via phone, SMS, or in-store; or tool fails outbound inspection at W139.3 return processing
Frequency: ~50–80 breakdowns/month chain-wide (~5% of rentals); ~0.25–0.4 per store per month
Volume: ~600–960 breakdowns/year across 1,500 rental units
Owner: Store Manager
Participants: Customer, Stock Associate, CSR, Store Manager, Rental Fleet Manager (HQ), Maintenance Technician, Vendor Service Center
Source: workflow W1374 — Tool Rental Equipment Breakdown, Emergency Repair Dispatch &amp; Substitute Unit Provisioning</bpmn:documentation>
      <bpmn:laneSet id="W1374_LaneSet7">
        <bpmn:lane id="W1374_Lane1" name="Customer">
        <bpmn:flowNodeRef>W1374_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1374_Start8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1374_Lane2" name="CSR">
        <bpmn:flowNodeRef>W1374_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1374_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1374_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1374_Lane4" name="Stock Associate">
        <bpmn:flowNodeRef>W1374_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1374_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1374_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1374_Lane5" name="Buyer">
        <bpmn:flowNodeRef>W1374_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1374_Lane6" name="Rental Fleet Manager">
        <bpmn:flowNodeRef>W1374_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1374_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1374_Start8" name="Customer reports tool breakdown during rental period via phone, SMS, or in-store; or tool…">
        <bpmn:outgoing>W1374_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1374_Task9" name="Customer contacts store (phone or SMS) to report tool breakdown during rental…">
        <bpmn:documentation>Step 1: Customer contacts store (phone or SMS) to report tool breakdown during rental: describes tool, issue (won&#x27;t start, loss of power, unusual noise, smoke, fluid leak), and urgency of their project timeline
Responsible (R): Customer
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1374_Task10" name="CSR creates breakdown report in system: (a) linked to active rental transaction…">
        <bpmn:documentation>Step 2: CSR creates breakdown report in system: (a) linked to active rental transaction per W139; (b) records customer-reported symptoms; (c) checks warranty status of the unit; (d) checks substitute tool availability at this store and nearest stores
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1374_Task11" name="Substitute unit available at store">
        <bpmn:documentation>Step 3: Store Manager determines resolution path: (a) Substitute unit available at store: Stock Associate retrieves substitute unit; prepares for customer exchange; customer brings broken tool to store for swap (or store dispatches substitute via delivery partner for high-value trade accounts); (b) No substitute at store, available at nearby store: Store Manager arranges inter-store transfer per W22 with &quot;Rental Emergency&quot; priority flag; estimated transfer time 1–4 hours for same-city stores; (c) No substitute available within reasonable distance: Store Manager offers rental extension waiver (free rental days equal to downtime), project schedule accommodation, or referral to competitor rental shop with BuildRight covering the cost difference
Responsible (R): Store Manager
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1374_Task12" name="If substitute provided: (a) system closes original rental at breakdown time…">
        <bpmn:documentation>Step 4: If substitute provided: (a) system closes original rental at breakdown time; rental fee prorated to actual usage duration; (b) system opens new rental for substitute unit with same return date as original (customer does not lose rental days to breakdown); (c) system waives any substitute unit rental fee difference if substitute is a higher-tier model; (d) Stock Associate conducts abbreviated W1319 safety briefing if substitute is a different tool type
Responsible (R): Stock Associate / CSR / System
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1374_Task13" name="Broken unit disposition: (a) Stock Associate performs diagnostic inspection and…">
        <bpmn:documentation>Step 5: Broken unit disposition: (a) Stock Associate performs diagnostic inspection and categorizes failure: (i) minor (clogged filter, worn brush, blown fuse — repairable in-store by Stock Associate with standard parts kit), (ii) moderate (motor replacement, hydraulic seal leak — requires vendor service center), (iii) major (structural failure, frame crack — unit retirement review per W1172); (b) unit status set to &quot;In Repair&quot; in system; (c) if vendor repair required: Buyer arranges service center pickup per W139.8 warranty process
Responsible (R): Stock Associate / Buyer
Accountable (A): Rental Fleet Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1374_Task14" name="In-store minor repair execution: (a) Stock Associate performs repair using…">
        <bpmn:documentation>Step 6: In-store minor repair execution: (a) Stock Associate performs repair using standard maintenance parts kit (filters, brushes, fuses, belts, spark plugs); (b) tests repaired tool before returning to &quot;Available&quot; status; (c) system records repair event: parts used, labor time, root cause code; (d) parts consumed deducted from store maintenance inventory
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W1374_Flow25</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1374_Task15" name="Vendor service center repair: (a) Buyer issues repair PO to tool manufacturer&#x27;s…">
        <bpmn:documentation>Step 7: Vendor service center repair: (a) Buyer issues repair PO to tool manufacturer&#x27;s authorized service center; (b) system tracks repair status; (c) vendor returns repaired unit with service report; (d) Stock Associate tests and returns to &quot;Available&quot;; (e) repair cost charged to rental unit&#x27;s lifecycle cost per W1172
Responsible (R): Buyer / Vendor
Accountable (A): Rental Fleet Manager
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1374_Flow26</bpmn:incoming>
        <bpmn:outgoing>W1374_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1374_Task16" name="Rental Fleet Manager reviews monthly breakdown analytics: (a) breakdown rate by…">
        <bpmn:documentation>Step 8: Rental Fleet Manager reviews monthly breakdown analytics: (a) breakdown rate by tool category and unit age; (b) mean time to repair (MTTR); (c) substitute unit fulfillment rate; (d) customer satisfaction post-breakdown; (e) units exceeding W1172 maintenance cost threshold flagged for retirement review
Responsible (R): Rental Fleet Manager
Accountable (A): Category Manager
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1374_Flow27</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1374_End17" name="Complete">
        <bpmn:incoming>W1374_Flow28</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1374_Annotation18">
        <bpmn:text>Controls: - CTL-276 (ensure controlled execution — Tool Rental &amp; Equipment (PA-12.2).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1374_Assoc19" sourceRef="W1374_Annotation18" targetRef="W1374_Start8" associationDirection="None" />
      <bpmn:sequenceFlow id="W1374_Flow20" sourceRef="W1374_Start8" targetRef="W1374_Task9" />
      <bpmn:sequenceFlow id="W1374_Flow21" sourceRef="W1374_Task9" targetRef="W1374_Task10" />
      <bpmn:sequenceFlow id="W1374_Flow22" sourceRef="W1374_Task10" targetRef="W1374_Task11" />
      <bpmn:sequenceFlow id="W1374_Flow23" sourceRef="W1374_Task11" targetRef="W1374_Task12" />
      <bpmn:sequenceFlow id="W1374_Flow24" sourceRef="W1374_Task12" targetRef="W1374_Task13" />
      <bpmn:sequenceFlow id="W1374_Flow25" sourceRef="W1374_Task13" targetRef="W1374_Task14" />
      <bpmn:sequenceFlow id="W1374_Flow26" sourceRef="W1374_Task14" targetRef="W1374_Task15" />
      <bpmn:sequenceFlow id="W1374_Flow27" sourceRef="W1374_Task15" targetRef="W1374_Task16" />
      <bpmn:sequenceFlow id="W1374_Flow28" sourceRef="W1374_Task16" targetRef="W1374_End17" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1374_diag">
      <bpmndi:BPMNPlane id="W1374_plane" bpmnElement="W_W1374">
        <bpmndi:BPMNShape id="W1374_Lane1_di" bpmnElement="W1374_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
