<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-12.2-tool-rental-and-equipment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W139" name="W139. Tool &amp; Equipment Rental Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests rental of professional tools (jackhammers, tile cutters, generators)
Frequency: Daily; ~5–7 rentals per store per month (~1,000–1,500/month chain-wide per W1319/W1376)
Volume: ~1,500 active rental units chain-wide
Owner: Store Manager
Participants: CSR, Warehouse/Stock Associate, Finance, Customer
Source: workflow W139 — Tool &amp; Equipment Rental Operations</bpmn:documentation>
      <bpmn:laneSet id="W139_LaneSet4">
        <bpmn:lane id="W139_Lane1" name="CSR">
        <bpmn:flowNodeRef>W139_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W139_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W139_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W139_Lane3" name="System">
        <bpmn:flowNodeRef>W139_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W139_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W139_Start5" name="Customer requests rental of professional tools (jackhammers, tile cutters, generators)">
        <bpmn:outgoing>W139_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W139_Task6" name="Rental Request">
        <bpmn:documentation>Step 1: Rental Request: CSR checks real-time availability of tool in store; verifies customer ID and loyalty status
Responsible (R): CSR
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow17</bpmn:incoming>
        <bpmn:outgoing>W139_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W139_Task7" name="Contract &amp; Deposit">
        <bpmn:documentation>Step 2: Contract &amp; Deposit: System generates Rental Agreement; Customer pays Rental Fee + Refundable Security Deposit at POS
Responsible (R): CSR / Cashier
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow18</bpmn:incoming>
        <bpmn:outgoing>W139_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W139_Task8" name="Tool Release">
        <bpmn:documentation>Step 3: Tool Release: Stock Associate performs &quot;Outbound Inspection&quot; with customer: verify tool condition, fuel level, and safety features; Customer signs release form
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow19</bpmn:incoming>
        <bpmn:outgoing>W139_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W139_Task9" name="In-Use Tracking">
        <bpmn:documentation>Step 4: In-Use Tracking: System tracks rental duration; sends SMS reminder 2 hours before scheduled return
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W139_Flow20</bpmn:incoming>
        <bpmn:outgoing>W139_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W139_Task10" name="Return &amp; Inspection">
        <bpmn:documentation>Step 5: Return &amp; Inspection: Customer returns tool; Stock Associate performs &quot;Inbound Inspection&quot;: check for damage, cleanliness, and functionality
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow21</bpmn:incoming>
        <bpmn:outgoing>W139_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W139_Task11" name="Closing &amp; Refund">
        <bpmn:documentation>Step 6: Closing &amp; Refund: (a) If tool OK: System processes deposit refund; (b) If tool damaged/dirty: CSR applies cleaning/repair fee from deposit; (c) If late: System calculates late fee
Responsible (R): CSR / Cashier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow22</bpmn:incoming>
        <bpmn:outgoing>W139_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W139_Task12" name="Maintenance">
        <bpmn:documentation>Step 7: Maintenance: Tool moved to &quot;Maintenance&quot; status; Stock Associate performs standard cleaning/servicing before making &quot;Available&quot; again
Responsible (R): Stock Associate
Accountable (A): Maintenance
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W139_Flow23</bpmn:incoming>
        <bpmn:outgoing>W139_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W139_Task13" name="Asset Lifecycle">
        <bpmn:documentation>Step 8: Asset Lifecycle: System tracks total hours used/rentals per unit; triggers major preventive maintenance (PM) or retirement based on usage thresholds
Responsible (R): System
Accountable (A): Maintenance
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W139_Flow24</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W139_End14" name="Complete">
        <bpmn:incoming>W139_Flow25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W139_Annotation15">
        <bpmn:text>Controls: - CTL-276 (ensure controlled execution — Tool Rental &amp; Equipment (PA-12.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W139_Assoc16" sourceRef="W139_Annotation15" targetRef="W139_Start5" associationDirection="None" />
