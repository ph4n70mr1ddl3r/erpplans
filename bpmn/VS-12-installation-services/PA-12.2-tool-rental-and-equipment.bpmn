      <bpmn:sequenceFlow id="W1172_Flow22" sourceRef="W1172_Task12" targetRef="W1172_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1172_diag">
      <bpmndi:BPMNPlane id="W1172_plane" bpmnElement="W_W1172">
        <bpmndi:BPMNShape id="W1172_Lane1_di" bpmnElement="W1172_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
