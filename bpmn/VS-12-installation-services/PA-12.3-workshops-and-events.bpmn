      <bpmn:sequenceFlow id="W906_Flow17" sourceRef="W906_Task8" targetRef="W906_Task9" />
      <bpmn:sequenceFlow id="W906_Flow18" sourceRef="W906_Task9" targetRef="W906_Task10" />
      <bpmn:sequenceFlow id="W906_Flow19" sourceRef="W906_Task10" targetRef="W906_Task11" />
      <bpmn:sequenceFlow id="W906_Flow20" sourceRef="W906_Task11" targetRef="W906_End12" />
    </bpmn:process>
