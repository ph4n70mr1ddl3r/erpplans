      <bpmn:startEvent id="W1378_Start6" name="Customer registers for DIY workshop via BuildRight mobile app, website, or in-store…">
        <bpmn:outgoing>W1378_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1378_Task7" name="Marketing publishes workshop calendar: (a) monthly schedule per store (2–3…">
        <bpmn:documentation>Step 1: Marketing publishes workshop calendar: (a) monthly schedule per store (2–3 workshops/month); (b) workshop topic, date, time, duration, instructor name, capacity limit (15–25 attendees depending on store workshop space); (c) published on buildright.com.ph, mobile app &quot;Workshops&quot; section, and in-store posters; (d) registration opens 2 weeks before workshop date
Responsible (R): Marketing
Accountable (A): CMO
Duration: Automated from W147 schedule</bpmn:documentation>
        <bpmn:incoming>W1378_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1378_Task8" name="Customer registers via preferred channel: (a) mobile app: selects store, date…">
        <bpmn:documentation>Step 2: Customer registers via preferred channel: (a) mobile app: selects store, date, topic → registers with 2 taps (auto-fills from loyalty profile); (b) website: buildright.com.ph/workshops → selects store and date → enters name, email, mobile; (c) in-store: Sales Associate registers customer on tablet at workshop display area; (d) system checks capacity: if spots available → confirms registration; sends confirmation SMS/email with workshop details, materials to bring, and store map
Responsible (R): Customer / System / Sales Associate
Accountable (A): —
Duration: 2–3 min</bpmn:documentation>
        <bpmn:incoming>W1378_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1378_Task9" name="If workshop at capacity: system offers waitlist: (a) customer added to waitlist…">
        <bpmn:documentation>Step 3: If workshop at capacity: system offers waitlist: (a) customer added to waitlist in queue order; (b) if registered attendee cancels (via app/website/link in confirmation email): system auto-notifies next waitlisted customer; (c) waitlisted customer has 12 hours to confirm before spot offered to next in queue; (d) if workshop has consistently long waitlists (&gt; 10 waitlisted): Marketing evaluates adding repeat session at same store
Responsible (R): System / Customer
Accountable (A): Marketing
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1378_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1378_Task10" name="Pre-workshop communication (2 days before): (a) system sends reminder SMS/email…">
        <bpmn:documentation>Step 4: Pre-workshop communication (2 days before): (a) system sends reminder SMS/email with workshop topic, date, time, store location, and what to wear (closed-toe shoes for safety); (b) includes &quot;Add to Calendar&quot; link; (c) system requests RSVP confirmation: attendee confirms or cancels; (d) if confirmed attendee does not RSVP: system sends follow-up reminder 4 hours before workshop
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1378_Flow21</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1378_Task11" name="Workshop day — attendance tracking: (a) instructor or Department Supervisor…">
        <bpmn:documentation>Step 5: Workshop day — attendance tracking: (a) instructor or Department Supervisor checks in attendees via tablet: scans loyalty card, QR code from confirmation email, or manually looks up registration; (b) system marks attendee as &quot;Present&quot;; (c) no-show tracking: registered attendees who do not check in are marked &quot;No-Show&quot;; (d) walk-in attendees: if capacity allows, Sales Associate registers walk-in customer on tablet and checks in immediately
Responsible (R): Department Supervisor / Sales Associate
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W1378_Flow22</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1378_Task12" name="Loyalty points integration: (a) attendees who complete workshop earn 50 loyalty…">
        <bpmn:documentation>Step 6: Loyalty points integration: (a) attendees who complete workshop earn 50 loyalty bonus points (configurable per workshop); (b) system auto-credits points upon attendance check-in; (c) workshop attendance recorded in customer&#x27;s loyalty profile for future marketing segmentation (&quot;DIY Workshop Completer&quot; segment)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1378_Flow23</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1378_Task13" name="Post-workshop survey: (a) system sends satisfaction survey via SMS/email within…">
        <bpmn:documentation>Step 7: Post-workshop survey: (a) system sends satisfaction survey via SMS/email within 2 hours of workshop completion; (b) 5-question survey: overall rating (1–5), instructor rating, topic relevance, likelihood to recommend, open feedback; (c) survey results linked to instructor certification record per W1377; (d) responses feed into CX analytics per W608
Responsible (R): System / Marketing
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1378_Flow24</bpmn:incoming>
        <bpmn:outgoing>W1378_Flow24</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1378_Task14" name="No-show management: (a) customers with 2+ no-shows in 6 months flagged in…">
        <bpmn:documentation>Step 8: No-show management: (a) customers with 2+ no-shows in 6 months flagged in system; (b) future registrations require deposit pre-payment (PHP 200 via GCash/card, refundable upon attendance); (c) deposit policy communicated at registration; (d) Store Manager may grant exceptions for documented emergencies
Responsible (R): System / Department Supervisor
Accountable (A): Store Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1378_Flow25</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1378_End15" name="Complete">
        <bpmn:incoming>W1378_Flow26</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1378_Annotation16">
        <bpmn:text>Controls: - CTL-277 (ensure controlled execution — Workshops &amp; Events (PA-12.3).) | - operational: shows no-shows for customers who actually attended, triggering incorrect no-show flags
Owner: Department Supervisor (store-level); Marketing (registration platform)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1378_Assoc17" sourceRef="W1378_Annotation16" targetRef="W1378_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1378_Flow18" sourceRef="W1378_Start6" targetRef="W1378_Task7" />
