    <bpmn:process id="W_W211" name="W211. In-Store 3D Kitchen/Bathroom Design Rendering" isExecutable="false">
      <bpmn:documentation>Trigger: Customer request for customized kitchen, bathroom, or closet layout
Frequency: ~20–30 designs per store/month
Volume: High-value project leads
Owner: Design Consultant
Participants: Customer, Sales Rep, Category Manager (for custom SKU approval)
Source: workflow W211 — In-Store 3D Kitchen/Bathroom Design Rendering</bpmn:documentation>
      <bpmn:laneSet id="W211_LaneSet3">
        <bpmn:lane id="W211_Lane1" name="Consultant">
        <bpmn:flowNodeRef>W211_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W211_Lane2" name="System">
        <bpmn:flowNodeRef>W211_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W211_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W211_Start4" name="Customer request for customized kitchen, bathroom, or closet layout">
        <bpmn:outgoing>W211_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W211_Task5" name="Space Survey">
        <bpmn:documentation>Step 1: Space Survey: Consultant captures floor plan dimensions (manual or via laser scanner app)
Responsible (R): Consultant
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W211_Flow15</bpmn:incoming>
        <bpmn:outgoing>W211_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W211_Task6" name="Assortment Mapping">
        <bpmn:documentation>Step 2: Assortment Mapping: System filters 3D assets library for SKUs currently in stock or available for order (W1)
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W211_Flow16</bpmn:incoming>
        <bpmn:outgoing>W211_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W211_Task7" name="Interactive Design">
        <bpmn:documentation>Step 3: Interactive Design: Consultant builds 3D model with customer; applies finishes (tiles, paint), fixtures, and cabinets
Responsible (R): Consultant
Accountable (A): —
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W211_Flow17</bpmn:incoming>
        <bpmn:outgoing>W211_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W211_Task8" name="ERP BOM Linkage">
        <bpmn:documentation>Step 4: ERP BOM Linkage: System automatically generates a Bill of Materials (BOM) linked to ERP SKU IDs and real-time prices
Responsible (R): System
Accountable (A): —
Duration: Real-time</bpmn:documentation>
        <bpmn:incoming>W211_Flow18</bpmn:incoming>
        <bpmn:outgoing>W211_Flow18</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W211_Task9" name="Margin Validation">
        <bpmn:documentation>Step 5: Margin Validation: System checks total project margin; flags if bundled price falls below threshold (W102)
Responsible (R): System
Accountable (A): Category Mgr
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W211_Flow19</bpmn:incoming>
        <bpmn:outgoing>W211_Flow19</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W211_Task10" name="Rendering &amp; Export">
        <bpmn:documentation>Step 6: Rendering &amp; Export: Generate high-quality render; email to customer with link to &quot;Click-to-Purchase&quot; in Web Portal
Responsible (R): Consultant
Accountable (A): —
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W211_Flow20</bpmn:incoming>
        <bpmn:outgoing>W211_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W211_Task11" name="Quote Conversion">
        <bpmn:documentation>Step 7: Quote Conversion: Convert design BOM into a Formal Quotation in ERP (W58); reserve stock for 48 hours
Responsible (R): Consultant
Accountable (A): Sales Rep
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W211_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W211_End12" name="Complete">
        <bpmn:incoming>W211_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W211_Annotation13">
        <bpmn:text>Controls: - CTL-277 (ensure controlled execution — Workshops &amp; Events (PA-12.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Design Consultant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W211_Assoc14" sourceRef="W211_Annotation13" targetRef="W211_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W211_Flow15" sourceRef="W211_Start4" targetRef="W211_Task5" />
      <bpmn:sequenceFlow id="W211_Flow16" sourceRef="W211_Task5" targetRef="W211_Task6" />
      <bpmn:sequenceFlow id="W211_Flow17" sourceRef="W211_Task6" targetRef="W211_Task7" />
      <bpmn:sequenceFlow id="W211_Flow18" sourceRef="W211_Task7" targetRef="W211_Task8" />
      <bpmn:sequenceFlow id="W211_Flow19" sourceRef="W211_Task8" targetRef="W211_Task9" />
      <bpmn:sequenceFlow id="W211_Flow20" sourceRef="W211_Task9" targetRef="W211_Task10" />
