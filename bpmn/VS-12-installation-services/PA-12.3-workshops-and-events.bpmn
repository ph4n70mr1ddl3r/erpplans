    <bpmn:process id="W_W1379" name="W1379. Vendor-Sponsored In-Store Product Demo Day Planning, Execution &amp; ROI Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor proposes product demo day; or quarterly demo calendar planning cycle by Category Manager; or new product launch requiring in-store customer education
Frequency: ~2–4 vendor demo days per store per month; ~400–800 events/month chain-wide (per W1289)
Volume: ~15–20 active vendor demo programs at any time (major brands: Bosch, Makita, DeWalt, Dulux, Boysen, Stanley, 3M, etc.)
Owner: Category Manager (vendor relationship); Store Manager (in-store execution)
Participants: Category Manager, Vendor Brand Manager, Vendor Demo Representative, Store Manager, Department Supervisor, Marketing, Finance (vendor funding reconciliation)
Source: workflow W1379 — Vendor-Sponsored In-Store Product Demo Day Planning, Execution &amp; ROI Measurement</bpmn:documentation>
      <bpmn:laneSet id="W1379_LaneSet3">
        <bpmn:lane id="W1379_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1379_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1379_Lane2" name="Vendor Rep">
        <bpmn:flowNodeRef>W1379_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1379_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1379_Start4" name="Vendor proposes product demo day; or quarterly demo calendar planning cycle by Category…">
        <bpmn:outgoing>W1379_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1379_Task5" name="Quarterly planning: Category Manager meets with top 20 vendors to plan demo…">
        <bpmn:documentation>Step 1: Quarterly planning: Category Manager meets with top 20 vendors to plan demo calendar: (a) each vendor proposes 1–4 demo days/quarter (typically aligned with new product launches or seasonal peaks); (b) Category Manager approves demo schedule considering: store coverage (does vendor want all 200 stores or select stores?), date conflicts (max 2 vendor demos per store per week to avoid customer fatigue), and merchandise category alignment with promotional calendar per W13; (c) system creates quarterly demo calendar visible to all Store Managers
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1379_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task6" name="Per-event preparation (2 weeks before): (a) Vendor confirms demo details: date…">
        <bpmn:documentation>Step 2: Per-event preparation (2 weeks before): (a) Vendor confirms demo details: date, store(s), product focus, demo representative name and contact, promotional pricing (if any), free sample quantities, equipment needed (power outlets, display tables, product stock); (b) Category Manager confirms demo products are in stock at participating stores per system availability check; if stock insufficient: Supply Planner arranges emergency replenishment per W921; (c) Marketing creates in-store signage and social media promotion for demo event; (d) system sends demo event notification to loyalty members in store&#x27;s trade area via W1350 email or app push
Responsible (R): Category Manager / Vendor / Marketing
Accountable (A): Store Manager
Duration: 2–3 hours/event</bpmn:documentation>
        <bpmn:incoming>W1379_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task7" name="Day-of setup (1 hour before store opening): (a) Vendor demo representative…">
        <bpmn:documentation>Step 3: Day-of setup (1 hour before store opening): (a) Vendor demo representative arrives at store; checks in with Department Supervisor; (b) Department Supervisor assigns demo location (typically in the relevant department area — power tools section for Bosch demo, paint section for Dulux demo); (c) verifies power outlets, table setup, and product display; (d) Vendor rep stages demo products and promotional materials; (e) Department Supervisor ensures demo SKU stock is replenished on shelves near demo area for immediate purchase
Responsible (R): Vendor Rep / Department Supervisor
Accountable (A): Store Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1379_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task8" name="Demo execution (during store hours): (a) Vendor rep conducts live product…">
        <bpmn:documentation>Step 4: Demo execution (during store hours): (a) Vendor rep conducts live product demonstrations to walk-up customers; (b) BuildRight Sales Associates stationed nearby to assist with customer questions and direct interested customers to shelves; (c) if demo includes promotional pricing (vendor-funded discount per W738): POS system applies demo-day promotional price automatically; (d) Vendor rep distributes free samples (paint swatches, adhesive samples, tool accessories) — system tracks sample inventory deduction; (e) Vendor rep may offer &quot;Buy today, get free accessory&quot; bundles (vendor-funded) processed at POS as promotional bundle per W13
Responsible (R): Vendor Rep / Sales Associate
Accountable (A): Department Supervisor
Duration: Store operating hours</bpmn:documentation>
        <bpmn:incoming>W1379_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task9" name="End-of-day: (a) Vendor rep and Department Supervisor complete demo day summary…">
        <bpmn:documentation>Step 5: End-of-day: (a) Vendor rep and Department Supervisor complete demo day summary: customer interactions count, products demonstrated, free samples distributed, demo SKU sales (actual vs. baseline); (b) Vendor rep packs up equipment and unused materials; (c) Department Supervisor returns unsold demo stock to shelves; (d) system captures demo-day sales data for ROI analysis
Responsible (R): Vendor Rep / Department Supervisor
Accountable (A): Store Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1379_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task10" name="Category Manager reviews demo ROI within 3 business days: (a) demo SKU sales on…">
        <bpmn:documentation>Step 6: Category Manager reviews demo ROI within 3 business days: (a) demo SKU sales on demo day vs. average daily sales for same SKUs (baseline comparison for 4 weeks prior); (b) total demo-day revenue and gross margin; (c) halo effect: sales in complementary categories on demo day vs. baseline (e.g., power tool demo may boost drill bit and accessory sales); (d) customer attendance estimate; (e) vendor funding received (demo day fee, promotional markdown funding, sample cost); (f) net contribution (demo-day incremental margin + vendor funding − BuildRight cost for space and staffing)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 30 min/event</bpmn:documentation>
        <bpmn:incoming>W1379_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1379_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1379_Task11" name="Monthly: Category Manager compiles vendor demo ROI report: (a) total demo days…">
        <bpmn:documentation>Step 7: Monthly: Category Manager compiles vendor demo ROI report: (a) total demo days conducted; (b) total incremental revenue and margin; (c) average sales lift by vendor and category; (d) vendor funding received; (e) ROI by vendor (used in next quarterly planning negotiation — high-ROI vendors get more demo dates; low-ROI vendors may lose demo slots); (f) results shared with top vendors to strengthen partnership and negotiate better funding terms per W738
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1379_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1379_End12" name="Complete">
        <bpmn:incoming>W1379_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1379_Annotation13">
        <bpmn:text>Controls: - CTL-277 (ensure controlled execution — Workshops &amp; Events (PA-12.3).) | - operational: Category Manager (vendor relationship); Store Manager (in-store execution) review and approval gate
Owner: Category Manager (vendor relationship); Store Manager (in-store execution)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1379_Assoc14" sourceRef="W1379_Annotation13" targetRef="W1379_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1379_Flow15" sourceRef="W1379_Start4" targetRef="W1379_Task5" />
      <bpmn:sequenceFlow id="W1379_Flow16" sourceRef="W1379_Task5" targetRef="W1379_Task6" />
      <bpmn:sequenceFlow id="W1379_Flow17" sourceRef="W1379_Task6" targetRef="W1379_Task7" />
      <bpmn:sequenceFlow id="W1379_Flow18" sourceRef="W1379_Task7" targetRef="W1379_Task8" />
      <bpmn:sequenceFlow id="W1379_Flow19" sourceRef="W1379_Task8" targetRef="W1379_Task9" />
      <bpmn:sequenceFlow id="W1379_Flow20" sourceRef="W1379_Task9" targetRef="W1379_Task10" />
      <bpmn:sequenceFlow id="W1379_Flow21" sourceRef="W1379_Task10" targetRef="W1379_Task11" />
      <bpmn:sequenceFlow id="W1379_Flow22" sourceRef="W1379_Task11" targetRef="W1379_End12" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1379_diag">
      <bpmndi:BPMNPlane id="W1379_plane" bpmnElement="W_W1379">
        <bpmndi:BPMNShape id="W1379_Lane1_di" bpmnElement="W1379_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1379_Lane2_di" bpmnElement="W1379_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1379_Task5_di" bpmnElement="W1379_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1379_Task6_di" bpmnElement="W1379_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
