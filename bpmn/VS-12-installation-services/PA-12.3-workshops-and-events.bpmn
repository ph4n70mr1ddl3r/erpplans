<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-12.3-workshops-and-events" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W147" name="W147. DIY Workshop &amp; In-Store Event Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly marketing calendar; or new product launch requiring education
Frequency: Weekly (weekends) at selected flagship stores
Volume: ~20–40 participants per session
Owner: Store Marketing Coordinator
Participants: Store Manager, Category Manager, Vendor Rep (Trainer), Customers
Source: workflow W147 — DIY Workshop &amp; In-Store Event Management</bpmn:documentation>
      <bpmn:laneSet id="W147_LaneSet5">
        <bpmn:lane id="W147_Lane1" name="Category Mgr">
        <bpmn:flowNodeRef>W147_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W147_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W147_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W147_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W147_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W147_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W147_Lane3" name="Stock Assoc">
        <bpmn:flowNodeRef>W147_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W147_Lane4" name="Vendor">
        <bpmn:flowNodeRef>W147_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W147_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W147_Start6" name="Monthly marketing calendar; or new product launch requiring education">
        <bpmn:outgoing>W147_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W147_Task7" name="Theme Selection">
        <bpmn:documentation>Step 1: Theme Selection: Choose DIY topic (e.g., &quot;Basic Plumbing&quot;, &quot;Tile Laying&quot;) based on seasonal demand
Responsible (R): Category Mgr
Accountable (A): CMO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W147_Flow16</bpmn:incoming>
        <bpmn:outgoing>W147_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W147_Task8" name="Vendor Coordination">
        <bpmn:documentation>Step 2: Vendor Coordination: Invite vendor to provide expert trainer and free sample materials
Responsible (R): Category Mgr
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W147_Flow17</bpmn:incoming>
        <bpmn:outgoing>W147_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W147_Task9" name="Promotion &amp; Registration">
        <bpmn:documentation>Step 3: Promotion &amp; Registration: Advertise via social media (W142); manage registrations via Loyalty App
Responsible (R): Marketing
Accountable (A): Social Mgr
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W147_Flow18</bpmn:incoming>
        <bpmn:outgoing>W147_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W147_Task10" name="Set-up">
        <bpmn:documentation>Step 4: Set-up: Prepare demo area in-store; arrange tools, materials, and safety gear
Responsible (R): Stock Assoc
Accountable (A): Store Mgr
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W147_Flow19</bpmn:incoming>
        <bpmn:outgoing>W147_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W147_Task11" name="Execution">
        <bpmn:documentation>Step 5: Execution: Conduct workshop; capture attendee leads; offer &quot;Same Day&quot; discount on featured tools
Responsible (R): Vendor / Marketing
Accountable (A): Store Mgr
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W147_Flow20</bpmn:incoming>
        <bpmn:outgoing>W147_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W147_Task12" name="Feedback &amp; Leads">
        <bpmn:documentation>Step 6: Feedback &amp; Leads: Collect survey (W65); update CRM with attendee interests for targeted follow-up
Responsible (R): Marketing
Accountable (A): —
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W147_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W147_End13" name="Complete">
        <bpmn:incoming>W147_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W147_Annotation14">
        <bpmn:text>Controls: - CTL-277 (ensure controlled execution — Workshops &amp; Events (PA-12.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Marketing Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W147_Assoc15" sourceRef="W147_Annotation14" targetRef="W147_Start6" associationDirection="None" />
