      <bpmndi:BPMNPlane id="W147_plane" bpmnElement="W_W147">
        <bpmndi:BPMNShape id="W147_Lane1_di" bpmnElement="W147_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
