      <bpmn:sequenceFlow id="W1378_Flow20" sourceRef="W1378_Task8" targetRef="W1378_Task9" />
      <bpmn:sequenceFlow id="W1378_Flow21" sourceRef="W1378_Task9" targetRef="W1378_Task10" />
      <bpmn:sequenceFlow id="W1378_Flow22" sourceRef="W1378_Task10" targetRef="W1378_Task11" />
      <bpmn:sequenceFlow id="W1378_Flow23" sourceRef="W1378_Task11" targetRef="W1378_Task12" />
      <bpmn:sequenceFlow id="W1378_Flow24" sourceRef="W1378_Task12" targetRef="W1378_Task13" />
      <bpmn:sequenceFlow id="W1378_Flow25" sourceRef="W1378_Task13" targetRef="W1378_Task14" />
      <bpmn:sequenceFlow id="W1378_Flow26" sourceRef="W1378_Task14" targetRef="W1378_End15" />
    </bpmn:process>
