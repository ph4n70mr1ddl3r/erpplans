    <bpmn:process id="W_W3297" name="W3297. Weekly Merchandise P&amp;A Reporting &amp; Variance Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly close of sales/receipts
Frequency: Weekly
Volume: All departments/categories
Owner: Merchandise Planner
Participants: Merchandise Planner, Category Managers, BI (links to VS-28.1), Finance (links to VS-17.1)
Source: workflow W3297 — Weekly Merchandise P&amp;A Reporting &amp; Variance Analysis</bpmn:documentation>
      <bpmn:laneSet id="W3297_LaneSet3">
        <bpmn:lane id="W3297_Lane1" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3297_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3297_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3297_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3297_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W3297_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3297_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3297_Start4" name="Weekly close of sales/receipts">
        <bpmn:outgoing>W3297_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3297_Task5" name="Merchandise Planner/BI produce weekly merchandise P&amp;A pack: sales, GM%…">
        <bpmn:documentation>Step 1: Merchandise Planner/BI produce weekly merchandise P&amp;A pack: sales, GM%, receipts, markdowns, EOM stock, sell-through, turn, WOS by department/category vs plan and vs last year; variance flags vs threshold
Responsible (R): Merchandise Planner / BI
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3297_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3297_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3297_Task6" name="Category Managers analyze variance root cause (demand, price, mix, stockout…">
        <bpmn:documentation>Step 2: Category Managers analyze variance root cause (demand, price, mix, stockout, promo, weather per VS-69) and propose corrective action (chase/cancel/markdown/transfer) against OTB (W3283) and markdown budget (W3285)
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3297_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3297_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3297_Task7" name="Merchandise Planner consolidate actions and feed to weekly P&amp;A review (W3288)…">
        <bpmn:documentation>Step 3: Merchandise Planner consolidate actions and feed to weekly P&amp;A review (W3288); archive the pack for audit (links to VS-21.1) and trend analysis
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3297_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3297_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3297_End8" name="Complete">
        <bpmn:incoming>W3297_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3297_Annotation9">
        <bpmn:text>Controls: - CTL-534 (ensure controlled execution — Merchandise Performance Analytics &amp; Margin Optimization (PA-101.3).) | - operational: weekly cadence and automation; operational: disciplined root-cause analysis
Owner: Merchandise Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3297_Assoc10" sourceRef="W3297_Annotation9" targetRef="W3297_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3297_Flow11" sourceRef="W3297_Start4" targetRef="W3297_Task5" />
      <bpmn:sequenceFlow id="W3297_Flow12" sourceRef="W3297_Task5" targetRef="W3297_Task6" />
      <bpmn:sequenceFlow id="W3297_Flow13" sourceRef="W3297_Task6" targetRef="W3297_Task7" />
      <bpmn:sequenceFlow id="W3297_Flow14" sourceRef="W3297_Task7" targetRef="W3297_End8" />
    </bpmn:process>
