      <bpmn:sequenceFlow id="W3304_Flow12" sourceRef="W3304_Task5" targetRef="W3304_Task6" />
      <bpmn:sequenceFlow id="W3304_Flow13" sourceRef="W3304_Task6" targetRef="W3304_Task7" />
      <bpmn:sequenceFlow id="W3304_Flow14" sourceRef="W3304_Task7" targetRef="W3304_End8" />
    </bpmn:process>
