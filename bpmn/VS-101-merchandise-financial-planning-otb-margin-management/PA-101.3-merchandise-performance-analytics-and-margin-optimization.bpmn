    <bpmn:process id="W_W3298" name="W3298. Key-Item / Item-Class Performance Review &amp; Reorder/Cancel Decisioning" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly key-item review
Frequency: Weekly
Volume: A-items (~20% of SKUs = 80% revenue, per profile §6.6)
Owner: Category Manager
Participants: Category Manager, Merchandise Planner, Buyers (links to VS-03), Supply Planning (links to VS-02.1)
Source: workflow W3298 — Key-Item / Item-Class Performance Review &amp; Reorder/Cancel Decisioning</bpmn:documentation>
      <bpmn:laneSet id="W3298_LaneSet3">
        <bpmn:lane id="W3298_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W3298_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3298_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3298_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3298_Lane2" name="Merchandise Planner">
        <bpmn:flowNodeRef>W3298_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3298_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3298_Start4" name="Weekly key-item review">
        <bpmn:outgoing>W3298_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3298_Task5" name="Category Manager review key-item (A-item) performance: sell-through, stock…">
        <bpmn:documentation>Step 1: Category Manager review key-item (A-item) performance: sell-through, stock cover, rate-of-sale, in-stock %, on-order; flag items trending above/below plan
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3298_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3298_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3298_Task6" name="Category Manager/Buyers decide chase (expedite/reorder per VS-03.2)…">
        <bpmn:documentation>Step 2: Category Manager/Buyers decide chase (expedite/reorder per VS-03.2), cancel/defer open order, or reallocate (links to VS-55 allocation) within OTB (W3284); coordinate import chase feasibility (45–90d lead per VS-02.2) vs domestic chase
Responsible (R): Category Manager / Buyers
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3298_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3298_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3298_Task7" name="Merchandise Planner capture decisions, update OTB/commitments (W3283/W3284) and…">
        <bpmn:documentation>Step 3: Merchandise Planner capture decisions, update OTB/commitments (W3283/W3284) and reforecast (W3288), and confirm in-stock recovery
Responsible (R): Merchandise Planner
Accountable (A): VP Merchandising
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3298_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3298_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3298_End8" name="Complete">
        <bpmn:incoming>W3298_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3298_Annotation9">
        <bpmn:text>Controls: - CTL-534 (ensure controlled execution — Merchandise Performance Analytics &amp; Margin Optimization (PA-101.3).) | - operational: weekly key-item discipline and chase; operational: reforecast (W3288)
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3298_Assoc10" sourceRef="W3298_Annotation9" targetRef="W3298_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3298_Flow11" sourceRef="W3298_Start4" targetRef="W3298_Task5" />
      <bpmn:sequenceFlow id="W3298_Flow12" sourceRef="W3298_Task5" targetRef="W3298_Task6" />
      <bpmn:sequenceFlow id="W3298_Flow13" sourceRef="W3298_Task6" targetRef="W3298_Task7" />
      <bpmn:sequenceFlow id="W3298_Flow14" sourceRef="W3298_Task7" targetRef="W3298_End8" />
    </bpmn:process>
