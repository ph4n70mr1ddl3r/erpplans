    <bpmn:process id="W_W2004" name="W2004. Retail Media Vendor Self-Service Portal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor accesses self-service media portal
Frequency: Continuous
Volume: ~200–500 vendors with portal access
Owner: Digital Marketing Manager
Participants: Digital Marketing Manager, IT Analyst, Vendor
Source: workflow W2004 — Retail Media Vendor Self-Service Portal Management</bpmn:documentation>
      <bpmn:laneSet id="W2004_LaneSet3">
        <bpmn:lane id="W2004_Lane1" name="IT Analyst">
        <bpmn:flowNodeRef>W2004_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2004_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2004_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2004_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W2004_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2004_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2004_Start4" name="Vendor accesses self-service media portal">
        <bpmn:outgoing>W2004_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2004_Task5" name="Portal features: (a) media catalog: browse available placements with photos and…">
        <bpmn:documentation>Step 1: Portal features: (a) media catalog: browse available placements with photos and descriptions, (b) rate card: view pricing per media type and store tier, (c) availability calendar: check real-time availability, (d) booking: self-service booking with automated confirmation, (e) creative upload: submit ad creative for review, (f) campaign analytics: view performance metrics for active campaigns
Responsible (R): IT Analyst / Digital Marketing Manager
Accountable (A): CMO
Duration: Setup: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2004_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2004_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2004_Task6" name="Vendor onboarding: (a) grant portal access to vendor marketing contact, (b)…">
        <bpmn:documentation>Step 2: Vendor onboarding: (a) grant portal access to vendor marketing contact, (b) provide tutorial and documentation, (c) assign Account Manager as support contact
Responsible (R): Account Manager
Accountable (A): Marketing Manager
Duration: Per vendor</bpmn:documentation>
        <bpmn:incoming>W2004_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2004_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2004_Task7" name="Portal maintenance: (a) monthly: update availability and rate card, (b)…">
        <bpmn:documentation>Step 3: Portal maintenance: (a) monthly: update availability and rate card, (b) quarterly: feature enhancements based on vendor feedback, (c) annual: platform upgrade and security review
Responsible (R): IT Analyst
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2004_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2004_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2004_End8" name="Complete">
        <bpmn:incoming>W2004_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2004_Annotation9">
        <bpmn:text>Controls: - CTL-385 (ensure controlled execution — Retail Media Platform &amp; Inventory Management (PA-48.1).) | - operational: Digital Marketing Manager review and approval gate
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2004_Assoc10" sourceRef="W2004_Annotation9" targetRef="W2004_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2004_Flow11" sourceRef="W2004_Start4" targetRef="W2004_Task5" />
      <bpmn:sequenceFlow id="W2004_Flow12" sourceRef="W2004_Task5" targetRef="W2004_Task6" />
      <bpmn:sequenceFlow id="W2004_Flow13" sourceRef="W2004_Task6" targetRef="W2004_Task7" />
      <bpmn:sequenceFlow id="W2004_Flow14" sourceRef="W2004_Task7" targetRef="W2004_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2004_diag">
      <bpmndi:BPMNPlane id="W2004_plane" bpmnElement="W_W2004">
        <bpmndi:BPMNShape id="W2004_Lane1_di" bpmnElement="W2004_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2004_Lane2_di" bpmnElement="W2004_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2004_Task5_di" bpmnElement="W2004_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
