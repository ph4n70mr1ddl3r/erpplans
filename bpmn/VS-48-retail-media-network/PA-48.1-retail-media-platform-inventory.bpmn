    <bpmn:process id="W_W2005" name="W2005. Retail Media Conflict Resolution &amp; Competitive Separation" isExecutable="false">
      <bpmn:documentation>Trigger: Two competing vendors book adjacent or overlapping placements
Frequency: ~5–10 conflicts/month
Volume: Per conflict
Owner: Marketing Manager
Participants: Marketing Manager, Category Manager, VP Merchandising
Source: workflow W2005 — Retail Media Conflict Resolution &amp; Competitive Separation</bpmn:documentation>
      <bpmn:laneSet id="W2005_LaneSet3">
        <bpmn:lane id="W2005_Lane1" name="System">
        <bpmn:flowNodeRef>W2005_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2005_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2005_Lane2" name="Marketing Manager">
        <bpmn:flowNodeRef>W2005_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2005_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2005_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2005_Start4" name="Two competing vendors book adjacent or overlapping placements">
        <bpmn:outgoing>W2005_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2005_Task5" name="System detects competitive conflict: (a) two vendors in same product category…">
        <bpmn:documentation>Step 1: System detects competitive conflict: (a) two vendors in same product category (e.g., two paint brands) booked endcaps in same store during same period, (b) two competing appliance brands booked homepage banner in same week, (c) system flags conflict for Marketing Manager review
Responsible (R): System
Accountable (A): Marketing Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2005_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2005_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2005_Task6" name="Marketing Manager resolves conflict: (a) competitive separation policy…">
        <bpmn:documentation>Step 2: Marketing Manager resolves conflict: (a) competitive separation policy: competing brands should not be placed adjacent or in same visual zone during same period, (b) options: (i) offer different dates to one vendor, (ii) offer different stores (geographic separation), (iii) offer different placement types within same store (different departments), (c) if both vendors insist on same placement: first-booked priority, or highest-bid priority for contested placements
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 30–60 min/conflict</bpmn:documentation>
        <bpmn:incoming>W2005_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2005_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2005_Task7" name="Annual: review competitive separation policy with VP Merchandising: (a) is…">
        <bpmn:documentation>Step 3: Annual: review competitive separation policy with VP Merchandising: (a) is policy too restrictive (leaving revenue on table)?, (b) is policy too lenient (creating vendor dissatisfaction)?, (c) adjust based on vendor feedback and revenue impact
Responsible (R): Marketing Manager
Accountable (A): VP Merchandising
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W2005_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2005_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2005_End8" name="Complete">
        <bpmn:incoming>W2005_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2005_Annotation9">
        <bpmn:text>Controls: - CTL-385 (ensure controlled execution — Retail Media Platform &amp; Inventory Management (PA-48.1).) | - operational: Marketing Manager review and approval gate
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2005_Assoc10" sourceRef="W2005_Annotation9" targetRef="W2005_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2005_Flow11" sourceRef="W2005_Start4" targetRef="W2005_Task5" />
      <bpmn:sequenceFlow id="W2005_Flow12" sourceRef="W2005_Task5" targetRef="W2005_Task6" />
      <bpmn:sequenceFlow id="W2005_Flow13" sourceRef="W2005_Task6" targetRef="W2005_Task7" />
      <bpmn:sequenceFlow id="W2005_Flow14" sourceRef="W2005_Task7" targetRef="W2005_End8" />
    </bpmn:process>
