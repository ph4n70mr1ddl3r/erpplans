<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-48.1-retail-media-platform-inventory" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1998" name="W1998. Retail Media Inventory Audit &amp; Availability Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: Annual media inventory audit; quarterly refresh
Frequency: Annual full audit; quarterly availability update
Volume: 200 stores × media placements per store
Owner: Marketing Manager
Participants: Marketing Manager, Visual Merchandiser, Store Manager
Source: workflow W1998 — Retail Media Inventory Audit &amp; Availability Mapping</bpmn:documentation>
      <bpmn:laneSet id="W1998_LaneSet2">
        <bpmn:lane id="W1998_Lane1" name="Marketing Manager">
        <bpmn:flowNodeRef>W1998_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1998_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1998_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1998_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1998_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1998_Start3" name="Annual media inventory audit; quarterly refresh">
        <bpmn:outgoing>W1998_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1998_Task4" name="Marketing Manager catalogs all advertising inventory: (a) in-store: (i) endcap…">
        <bpmn:documentation>Step 1: Marketing Manager catalogs all advertising inventory: (a) in-store: (i) endcap displays (4–8 per store), (ii) power aisle promotional bays (2–4 per store), (iii) shelf talkers and wobblers (unlimited, per SKU), (iv) checkout area posters (3 per store, near POS), (v) digital screens (if installed, 1–2 per store), (vi) floor graphics (2–4 per store), (vii) shopping cart ads (if applicable), (b) ecommerce: (i) sponsored product slots (top 3 search results per category), (ii) homepage banner (1–3 slots), (iii) category page banner (1 per department × 13 departments), (iv) product page recommendation carousel, (c) print: (i) catalog back cover, inside covers, full pages, half pages, (ii) flyer inserts
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1998_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1998_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1998_Task5" name="Quantify total media inventory: (a) in-store: 200 stores × average 15…">
        <bpmn:documentation>Step 2: Quantify total media inventory: (a) in-store: 200 stores × average 15 placements = ~3,000 in-store placements, (b) ecommerce: ~50 digital ad positions, (c) print: ~20–30 catalog positions (6 catalogs/year)
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1998_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1998_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1998_Task6" name="Quarterly: update availability based on store remodels, new digital signage…">
        <bpmn:documentation>Step 3: Quarterly: update availability based on store remodels, new digital signage installations, and ecommerce platform changes
Responsible (R): Marketing Manager
Accountable (A): CMO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1998_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1998_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1998_End7" name="Complete">
        <bpmn:incoming>W1998_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1998_Annotation8">
        <bpmn:text>Controls: - CTL-193 (ensure retail-media billing &amp; placement delivery.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1998_Assoc9" sourceRef="W1998_Annotation8" targetRef="W1998_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1998_Flow10" sourceRef="W1998_Start3" targetRef="W1998_Task4" />
      <bpmn:sequenceFlow id="W1998_Flow11" sourceRef="W1998_Task4" targetRef="W1998_Task5" />
      <bpmn:sequenceFlow id="W1998_Flow12" sourceRef="W1998_Task5" targetRef="W1998_Task6" />
      <bpmn:sequenceFlow id="W1998_Flow13" sourceRef="W1998_Task6" targetRef="W1998_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1998_diag">
      <bpmndi:BPMNPlane id="W1998_plane" bpmnElement="W_W1998">
        <bpmndi:BPMNShape id="W1998_Lane1_di" bpmnElement="W1998_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_Task4_di" bpmnElement="W1998_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_Task5_di" bpmnElement="W1998_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_Task6_di" bpmnElement="W1998_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_Start3_di" bpmnElement="W1998_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_End7_di" bpmnElement="W1998_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1998_Annotation8_di" bpmnElement="W1998_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1998_Flow10_di" bpmnElement="W1998_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1998_Flow11_di" bpmnElement="W1998_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1998_Flow12_di" bpmnElement="W1998_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1998_Flow13_di" bpmnElement="W1998_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1998_Assoc9_di" bpmnElement="W1998_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1999" name="W1999. Retail Media Rate Card Development &amp; Pricing Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual rate card review; new media type launch
Frequency: Annual review; per new media type
Volume: ~30–50 rate card line items
Owner: CMO
Participants: CMO, Pricing Analyst, CFO, VP Merchandising
Source: workflow W1999 — Retail Media Rate Card Development &amp; Pricing Governance</bpmn:documentation>
      <bpmn:laneSet id="W1999_LaneSet4">
        <bpmn:lane id="W1999_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W1999_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1999_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1999_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1999_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1999_Lane3" name="CMO">
        <bpmn:flowNodeRef>W1999_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1999_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1999_Start5" name="Annual rate card review; new media type launch">
        <bpmn:outgoing>W1999_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1999_Task6" name="Pricing Analyst develops rate card: (a) in-store: (i) endcap: PHP…">
        <bpmn:documentation>Step 1: Pricing Analyst develops rate card: (a) in-store: (i) endcap: PHP 50K–200K/month per store (varies by location tier), (ii) shelf talker: PHP 5K–15K/month per SKU per store, (iii) checkout poster: PHP 30K–80K/month per store, (iv) digital screen: PHP 20K–50K/month per store, (b) ecommerce: (i) sponsored product: CPC (cost per click) PHP 5–20 per click, (ii) homepage banner: PHP 100K–300K/month, (iii) category banner: PHP 30K–80K/month, (c) print: (i) catalog back cover: PHP 500K–1M per edition, (ii) full page: PHP 150K–300K per edition
Responsible (R): Pricing Analyst
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1999_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1999_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1999_Task7" name="CFO reviews media pricing for margin impact: (a) media revenue is incremental…">
        <bpmn:documentation>Step 2: CFO reviews media pricing for margin impact: (a) media revenue is incremental (doesn&#x27;t reduce merchandise margin), (b) ensure media pricing is competitive vs. alternative advertising channels (Facebook, Google, radio), (c) target: media revenue at 30–50% gross margin after production and placement costs
Responsible (R): CFO
Accountable (A): CMO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1999_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1999_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1999_Task8" name="Annual: CMO benchmarks media rates against Philippine retail media market and…">
        <bpmn:documentation>Step 3: Annual: CMO benchmarks media rates against Philippine retail media market and digital advertising market; adjust rates upward as BuildRight&#x27;s traffic and sales data become more valuable to vendors
Responsible (R): CMO
Accountable (A): COO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1999_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1999_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1999_End9" name="Complete">
        <bpmn:incoming>W1999_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1999_Annotation10">
        <bpmn:text>Controls: - CTL-385 (ensure controlled execution — Retail Media Platform &amp; Inventory Management (PA-48.1).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1999_Assoc11" sourceRef="W1999_Annotation10" targetRef="W1999_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1999_Flow12" sourceRef="W1999_Start5" targetRef="W1999_Task6" />
      <bpmn:sequenceFlow id="W1999_Flow13" sourceRef="W1999_Task6" targetRef="W1999_Task7" />
      <bpmn:sequenceFlow id="W1999_Flow14" sourceRef="W1999_Task7" targetRef="W1999_Task8" />
      <bpmn:sequenceFlow id="W1999_Flow15" sourceRef="W1999_Task8" targetRef="W1999_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1999_diag">
      <bpmndi:BPMNPlane id="W1999_plane" bpmnElement="W_W1999">
        <bpmndi:BPMNShape id="W1999_Lane1_di" bpmnElement="W1999_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Lane2_di" bpmnElement="W1999_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Lane3_di" bpmnElement="W1999_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Task6_di" bpmnElement="W1999_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Task7_di" bpmnElement="W1999_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Task8_di" bpmnElement="W1999_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Start5_di" bpmnElement="W1999_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_End9_di" bpmnElement="W1999_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1999_Annotation10_di" bpmnElement="W1999_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1999_Flow12_di" bpmnElement="W1999_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1999_Flow13_di" bpmnElement="W1999_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1999_Flow14_di" bpmnElement="W1999_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1999_Flow15_di" bpmnElement="W1999_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1999_Assoc11_di" bpmnElement="W1999_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2000" name="W2000. In-Store Advertising Placement Setup &amp; Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor books in-store media placement
Frequency: ~100–200 in-store placements/month across chain
Volume: ~3,000 in-store placements capacity
Owner: Visual Merchandiser
Participants: Visual Merchandiser, Store Manager, Vendor
Source: workflow W2000 — In-Store Advertising Placement Setup &amp; Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2000_LaneSet2">
        <bpmn:lane id="W2000_Lane1" name="Visual Merchandiser">
        <bpmn:flowNodeRef>W2000_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2000_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2000_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2000_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2000_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2000_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2000_Start3" name="Vendor books in-store media placement">
        <bpmn:outgoing>W2000_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2000_Task4" name="Visual Merchandiser receives placement order: (a) vendor, product, placement…">
        <bpmn:documentation>Step 1: Visual Merchandiser receives placement order: (a) vendor, product, placement type, store list, duration, (b) creative assets: vendor provides artwork per BuildRight specifications (size, format, resolution, brand guidelines compliance), (c) if no creative: BuildRight in-house creative produces per vendor brief (additional fee)
Responsible (R): Visual Merchandiser
Accountable (A): Marketing Manager
Duration: Per placement</bpmn:documentation>
        <bpmn:incoming>W2000_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2000_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2000_Task5" name="Production: (a) shelf talkers/wobblers: print per store count, (b) posters…">
        <bpmn:documentation>Step 2: Production: (a) shelf talkers/wobblers: print per store count, (b) posters: print per format and store count, (c) endcap displays: coordinate with store for product placement and signage, (d) digital screen content: upload to content management system
Responsible (R): Visual Merchandiser
Accountable (A): Marketing Manager
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2000_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2000_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2000_Task6" name="Distribution and installation: (a) ship printed materials to stores via DC…">
        <bpmn:documentation>Step 3: Distribution and installation: (a) ship printed materials to stores via DC replenishment, (b) Store Manager assigns Stock Associate for installation, (c) installation timeline: within 3 business days of receiving materials, (d) photo verification: Store Manager sends installation photo to Visual Merchandiser for confirmation
Responsible (R): Visual Merchandiser / Store Manager
Accountable (A): Marketing Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2000_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2000_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2000_Task7" name="Maintenance: (a) weekly: Visual Merchandiser checks installation compliance via…">
        <bpmn:documentation>Step 4: Maintenance: (a) weekly: Visual Merchandiser checks installation compliance via store photos, (b) damaged or missing materials: reorder and re-ship, (c) campaign end: Store Manager removes materials within 3 business days of campaign end date
Responsible (R): Visual Merchandiser / Store Manager
Accountable (A): Marketing Manager
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2000_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2000_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2000_End8" name="Complete">
        <bpmn:incoming>W2000_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2000_Annotation9">
        <bpmn:text>Controls: - CTL-193 (ensure retail-media billing &amp; placement delivery.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Visual Merchandiser</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2000_Assoc10" sourceRef="W2000_Annotation9" targetRef="W2000_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2000_Flow11" sourceRef="W2000_Start3" targetRef="W2000_Task4" />
      <bpmn:sequenceFlow id="W2000_Flow12" sourceRef="W2000_Task4" targetRef="W2000_Task5" />
      <bpmn:sequenceFlow id="W2000_Flow13" sourceRef="W2000_Task5" targetRef="W2000_Task6" />
      <bpmn:sequenceFlow id="W2000_Flow14" sourceRef="W2000_Task6" targetRef="W2000_Task7" />
      <bpmn:sequenceFlow id="W2000_Flow15" sourceRef="W2000_Task7" targetRef="W2000_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2000_diag">
      <bpmndi:BPMNPlane id="W2000_plane" bpmnElement="W_W2000">
        <bpmndi:BPMNShape id="W2000_Lane1_di" bpmnElement="W2000_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Task4_di" bpmnElement="W2000_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Task5_di" bpmnElement="W2000_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Task6_di" bpmnElement="W2000_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Task7_di" bpmnElement="W2000_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Start3_di" bpmnElement="W2000_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_End8_di" bpmnElement="W2000_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2000_Annotation9_di" bpmnElement="W2000_Annotation9"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2000_Flow11_di" bpmnElement="W2000_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2000_Flow12_di" bpmnElement="W2000_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2000_Flow13_di" bpmnElement="W2000_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2000_Flow14_di" bpmnElement="W2000_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2000_Flow15_di" bpmnElement="W2000_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2000_Assoc10_di" bpmnElement="W2000_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2001" name="W2001. Ecommerce Sponsored Product &amp; Banner Ad Position Management" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor books ecommerce advertising
Frequency: ~50–100 ecommerce ad campaigns/month
Volume: ~50 digital ad positions
Owner: Digital Marketing Manager
Participants: Digital Marketing Manager, Ecommerce Manager, Vendor
Source: workflow W2001 — Ecommerce Sponsored Product &amp; Banner Ad Position Management</bpmn:documentation>
      <bpmn:laneSet id="W2001_LaneSet2">
        <bpmn:lane id="W2001_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W2001_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2001_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2001_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2001_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2001_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2001_Start3" name="Vendor books ecommerce advertising">
        <bpmn:outgoing>W2001_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2001_Task4" name="Digital Marketing Manager sets up sponsored product campaign: (a) vendor…">
        <bpmn:documentation>Step 1: Digital Marketing Manager sets up sponsored product campaign: (a) vendor selects SKUs to sponsor, (b) targeting: category, search keywords, customer segments, (c) bidding: CPC model — vendor sets maximum CPC bid, (d) budget: daily or monthly cap, (e) ad creative: product image + promotional copy + price display
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 1–2 days/campaign</bpmn:documentation>
        <bpmn:incoming>W2001_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2001_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2001_Task5" name="Banner ad setup: (a) vendor provides banner creative per specifications (size…">
        <bpmn:documentation>Step 2: Banner ad setup: (a) vendor provides banner creative per specifications (size, format), (b) placement: homepage, category page, or product page, (c) targeting: all visitors, segment-based, or retargeting, (d) duration: campaign start/end dates, (e) A/B testing: 2 banner variants tested simultaneously
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 1 day/campaign</bpmn:documentation>
        <bpmn:incoming>W2001_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2001_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2001_Task6" name="Campaign monitoring: (a) daily: impressions, clicks, CTR, CPC, spend, (b)…">
        <bpmn:documentation>Step 3: Campaign monitoring: (a) daily: impressions, clicks, CTR, CPC, spend, (b) weekly: ROAS (return on ad spend) — vendor&#x27;s sales lift attributed to advertising, (c) monthly: campaign performance report shared with vendor
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 15–30 min/day</bpmn:documentation>
        <bpmn:incoming>W2001_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2001_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2001_End7" name="Complete">
        <bpmn:incoming>W2001_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2001_Annotation8">
        <bpmn:text>Controls: - CTL-385 (ensure controlled execution — Retail Media Platform &amp; Inventory Management (PA-48.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2001_Assoc9" sourceRef="W2001_Annotation8" targetRef="W2001_Start3" associationDirection="None" />
