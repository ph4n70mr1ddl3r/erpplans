    <bpmn:process id="W_W2003" name="W2003. Digital Signage Content Management &amp; Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor books digital screen placement; scheduled content refresh
Frequency: ~20–50 digital content changes/month
Volume: ~200–400 digital screens across 200 stores (1–2 per store)
Owner: Digital Marketing Manager
Participants: Digital Marketing Manager, IT Support, Vendor
Source: workflow W2003 — Digital Signage Content Management &amp; Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W2003_LaneSet2">
        <bpmn:lane id="W2003_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W2003_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2003_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2003_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2003_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2003_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2003_Start3" name="Vendor books digital screen placement; scheduled content refresh">
        <bpmn:outgoing>W2003_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2003_Task4" name="Content upload: (a) vendor provides video or static creative per specifications…">
        <bpmn:documentation>Step 1: Content upload: (a) vendor provides video or static creative per specifications (format: MP4/JPG, resolution: 1920×1080, duration: 15–30 sec for video), (b) Digital Marketing Manager reviews content for brand compliance and appropriateness, (c) approved content uploaded to content management system (CMS)
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 30 min/content</bpmn:documentation>
        <bpmn:incoming>W2003_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2003_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2003_Task5" name="Scheduling: (a) assign content to specific screens (all stores, regional…">
        <bpmn:documentation>Step 2: Scheduling: (a) assign content to specific screens (all stores, regional, specific stores), (b) set playlist: rotate vendor content with BuildRight content, (c) schedule: start/end date/time, frequency per hour, (d) priority levels: paid vendor content gets minimum guaranteed impressions
Responsible (R): Digital Marketing Manager
Accountable (A): CMO
Duration: 15–30 min/schedule</bpmn:documentation>
        <bpmn:incoming>W2003_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2003_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2003_Task6" name="Monitoring: (a) daily: CMS reports screen uptime and content playback, (b)…">
        <bpmn:documentation>Step 3: Monitoring: (a) daily: CMS reports screen uptime and content playback, (b) offline screens: IT ticket for repair per W48, (c) content compliance: periodic spot-check that contracted content is playing as scheduled
Responsible (R): Digital Marketing Manager / IT Support
Accountable (A): CMO
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W2003_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2003_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2003_End7" name="Complete">
        <bpmn:incoming>W2003_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2003_Annotation8">
        <bpmn:text>Controls: - CTL-385 (ensure controlled execution — Retail Media Platform &amp; Inventory Management (PA-48.1).) | - operational: Digital Marketing Manager review and approval gate
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
