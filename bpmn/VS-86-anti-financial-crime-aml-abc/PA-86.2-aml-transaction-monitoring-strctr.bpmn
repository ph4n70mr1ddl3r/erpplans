Accountable (A): Compliance Officer
Duration: Per alert</bpmn:documentation>
        <bpmn:incoming>W2929_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2929_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2929_Task8" name="Compliance files Covered Transaction Report (CTR) with AMLC within 5 working…">
