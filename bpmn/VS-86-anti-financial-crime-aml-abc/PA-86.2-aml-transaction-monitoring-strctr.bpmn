    <bpmn:process id="W_W2929" name="W2929. Cash Transaction Monitoring &amp; Covered Transaction (PHP 500K Single-Day) Detection" isExecutable="false">
      <bpmn:documentation>Trigger: Cash transaction in single business day
Frequency: Continuous
Volume: ~2.8M POS transactions/month; cash-heavy retail
Owner: Compliance Analyst
Participants: Compliance, Treasury, AR
Source: workflow W2929 — Cash Transaction Monitoring &amp; Covered Transaction (PHP 500K Single-Day) Detection</bpmn:documentation>
