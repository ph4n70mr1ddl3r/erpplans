    <bpmn:process id="W_W2931" name="W2931. Suspicious Transaction Report (STR) Filing with AMLC" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed suspicious transaction
Frequency: Event-driven
Volume: ~10–30 STRs/year
Owner: Compliance Officer
Participants: Compliance Officer, MLRO, Legal
Source: workflow W2931 — Suspicious Transaction Report (STR) Filing with AMLC</bpmn:documentation>
      <bpmn:laneSet id="W2931_LaneSet4">
        <bpmn:lane id="W2931_Lane1" name="Compliance Officer">
        <bpmn:flowNodeRef>W2931_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2931_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2931_Lane2" name="MLRO">
        <bpmn:flowNodeRef>W2931_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2931_Lane3" name="Compliance">
        <bpmn:flowNodeRef>W2931_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2931_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2931_Start5" name="Confirmed suspicious transaction">
        <bpmn:outgoing>W2931_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2931_Task6" name="Compliance prepares STR with required details: subject identity, transaction…">
        <bpmn:documentation>Step 1: Compliance prepares STR with required details: subject identity, transaction details, grounds for suspicion, supporting evidence
Responsible (R): Compliance Officer
Accountable (A): MLRO
Duration: Per STR</bpmn:documentation>
        <bpmn:incoming>W2931_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2931_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2931_Task7" name="MLRO reviews and approves STR; files via AMLC portal within 5 days of…">
        <bpmn:documentation>Step 2: MLRO reviews and approves STR; files via AMLC portal within 5 days of determination; maintains confidentiality (no tipping-off)
Responsible (R): MLRO
Accountable (A): Compliance Officer
Duration: Per STR</bpmn:documentation>
        <bpmn:incoming>W2931_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2931_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2931_Task8" name="Compliance/Legal supports any AMLC follow-up investigation; preserves records…">
        <bpmn:documentation>Step 3: Compliance/Legal supports any AMLC follow-up investigation; preserves records per AMLA retention; manages customer relationship outcome
Responsible (R): Compliance / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2931_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2931_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2931_End9" name="Complete">
        <bpmn:incoming>W2931_Flow15</bpmn:incoming>
      </bpmn:endEvent>
