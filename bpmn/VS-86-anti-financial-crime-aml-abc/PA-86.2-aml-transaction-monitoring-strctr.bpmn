    <bpmn:process id="W_W2932" name="W2932. Covered Transaction Report (CTR) Filing &amp; AMLC Portal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Covered transaction batch
Frequency: Daily/weekly batch
Volume: ~10–50 CTRs/year
Owner: Compliance Analyst
Participants: Compliance, MLRO
Source: workflow W2932 — Covered Transaction Report (CTR) Filing &amp; AMLC Portal Management</bpmn:documentation>
      <bpmn:laneSet id="W2932_LaneSet4">
        <bpmn:lane id="W2932_Lane1" name="Compliance Analyst">
        <bpmn:flowNodeRef>W2932_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2932_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2932_Lane2" name="MLRO">
        <bpmn:flowNodeRef>W2932_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2932_Lane3" name="Compliance">
        <bpmn:flowNodeRef>W2932_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2932_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2932_Start5" name="Covered transaction batch">
        <bpmn:outgoing>W2932_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2932_Task6" name="Compliance compiles CTR data: subject identity, transaction type, amount, date…">
        <bpmn:documentation>Step 1: Compliance compiles CTR data: subject identity, transaction type, amount, date, account/reference
Responsible (R): Compliance Analyst
Accountable (A): MLRO
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W2932_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2932_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2932_Task7" name="MLRO reviews and files CTR via AMLC portal within prescribed period; maintains…">
        <bpmn:documentation>Step 2: MLRO reviews and files CTR via AMLC portal within prescribed period; maintains filing acknowledgment
Responsible (R): MLRO
Accountable (A): Compliance Officer
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W2932_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2932_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2932_Task8" name="Compliance archives CTR records; tracks filing timeliness for audit">
        <bpmn:documentation>Step 3: Compliance archives CTR records; tracks filing timeliness for audit
Responsible (R): Compliance
