    <bpmn:process id="W_W4969" name="W4969. Forklift &amp; Loading Equipment Operations in the Customer Vehicle Area" isExecutable="false">
      <bpmn:documentation>Trigger: Bulky pickup requiring mechanical loading (W4970)
Frequency: Continuous during trading hours × 200 stores
Volume: ~5–15 bulky mechanical-loading events per store per day × 200 stores
Owner: Loading-Zone Supervisor / Yard Lead (VS-07) / HSE (VS-24)
Participants: Forklift Operators, Spotters (W4971), Store Ops (VS-07), HSE (VS-24), Customer Safety (VS-147)
Source: workflow W4969 — Forklift &amp; Loading Equipment Operations in the Customer Vehicle Area</bpmn:documentation>
      <bpmn:laneSet id="W4969_LaneSet3">
        <bpmn:lane id="W4969_Lane1" name="Yard Lead">
        <bpmn:flowNodeRef>W4969_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4969_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4969_Lane2" name="Operator">
        <bpmn:flowNodeRef>W4969_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4969_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4969_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4969_Start4" name="Bulky pickup requiring mechanical loading (W4970)">
        <bpmn:outgoing>W4969_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4969_Task5" name="Authorize &amp; dispatch the forklift/loading equipment to the customer area: only…">
        <bpmn:documentation>Step 1: Authorize &amp; dispatch the forklift/loading equipment to the customer area: only qualified operators (W4973), only in the designated envelope (W4964), with a spotter (W4971), horn/lights/blue-light, and pedestrian-vehicle separation active (links VS-147)
Responsible (R): Yard Lead / Operator / Spotter
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4969_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4969_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4969_Task6" name="Operate the equipment safely in the customer area: controlled speed, clear…">
        <bpmn:documentation>Step 2: Operate the equipment safely in the customer area: controlled speed, clear travel path, load lowered except lifting, no passengers, horn at intersections, and immediate stop on pedestrian incursion; coordinate with the spotter (W4971)
Responsible (R): Operator
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4969_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4969_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4969_Task7" name="Return, inspect &amp; log: return equipment to designated parking/charging, log…">
        <bpmn:documentation>Step 3: Return, inspect &amp; log: return equipment to designated parking/charging, log usage/hours, note defects (W4973), and report any near-miss/incident to HSE (VS-24) and customer-safety (VS-147 CAPA)
Responsible (R): Operator / Yard Lead / HSE
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4969_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4969_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4969_End8" name="Complete">
        <bpmn:incoming>W4969_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4969_Annotation9">
        <bpmn:text>Controls: - CTL-744 (ensure controlled execution — Bulky-Goods Loading, Forklift-in-Customer-Area &amp; Vehicle Coordination (PA-171.2).) | - CTL-744: qualified operator only; spotter present; designated envelope; pre-use inspection; incident reported (VS-24/VS-147)
Owner: Loading-Zone Supervisor / Yard Lead (VS-07) / HSE (VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4969_Assoc10" sourceRef="W4969_Annotation9" targetRef="W4969_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4969_Flow11" sourceRef="W4969_Start4" targetRef="W4969_Task5" />
      <bpmn:sequenceFlow id="W4969_Flow12" sourceRef="W4969_Task5" targetRef="W4969_Task6" />
      <bpmn:sequenceFlow id="W4969_Flow13" sourceRef="W4969_Task6" targetRef="W4969_Task7" />
      <bpmn:sequenceFlow id="W4969_Flow14" sourceRef="W4969_Task7" targetRef="W4969_End8" />
    </bpmn:process>
