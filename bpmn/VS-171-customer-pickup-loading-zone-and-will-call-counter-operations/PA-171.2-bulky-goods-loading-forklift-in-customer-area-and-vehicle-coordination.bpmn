        <bpmndi:BPMNEdge id="W4970_Flow12_di" bpmnElement="W4970_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4970_Flow13_di" bpmnElement="W4970_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4970_Flow14_di" bpmnElement="W4970_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4970_Assoc10_di" bpmnElement="W4970_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4971" name="W4971. Spotter, Banksperson &amp; Pedestrian-Safety Protocol for Customer-Area Loading" isExecutable="false">
      <bpmn:documentation>Trigger: Any mechanical loading in the customer area (W4969/W4970)
Frequency: Per loading event × 200 stores
Volume: ~10–20 spotter-required events per store per day × 200 stores
Owner: Loading-Zone Supervisor / HSE (VS-24)
Participants: Spotters, Forklift Operators (W4969), Store Ops (VS-07), HSE (VS-24), Customer Safety (VS-147)
Source: workflow W4971 — Spotter, Banksperson &amp; Pedestrian-Safety Protocol for Customer-Area Loading</bpmn:documentation>
      <bpmn:laneSet id="W4971_LaneSet3">
        <bpmn:lane id="W4971_Lane1" name="Supervisor">
        <bpmn:flowNodeRef>W4971_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4971_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4971_Lane2" name="Spotter">
        <bpmn:flowNodeRef>W4971_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4971_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4971_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4971_Start4" name="Any mechanical loading in the customer area (W4969/W4970)">
        <bpmn:outgoing>W4971_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4971_Task5" name="Position &amp; brief the spotter: for every mechanical load in the customer area…">
        <bpmn:documentation>Step 1: Position &amp; brief the spotter: for every mechanical load in the customer area, assign a spotter/banksperson, brief on the path/load/blind-spots, and establish hand-signal/verbal/radio communication with the operator
Responsible (R): Supervisor / Spotter / Operator
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4971_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4971_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4971_Task6" name="Control pedestrians &amp; vehicles during loading: the spotter keeps…">
        <bpmn:documentation>Step 2: Control pedestrians &amp; vehicles during loading: the spotter keeps customers/vehicles/pedestrians clear of the swing/fall/travel envelope, stops the operator on any incursion, and manages the bay/queue (links VS-147 premises safety)
Responsible (R): Spotter / Operator
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4971_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4971_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4971_Task7" name="Confirm completion &amp; safety: signal all-clear on completion, confirm load…">
        <bpmn:documentation>Step 3: Confirm completion &amp; safety: signal all-clear on completion, confirm load securement (W4972), release the customer vehicle, and report any near-miss/incident (VS-24/VS-147)
Responsible (R): Spotter / Operator / Supervisor
Accountable (A): Loading-Zone Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4971_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4971_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4971_End8" name="Complete">
        <bpmn:incoming>W4971_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4971_Annotation9">
        <bpmn:text>Controls: - CTL-744 (ensure controlled execution — Bulky-Goods Loading, Forklift-in-Customer-Area &amp; Vehicle Coordination (PA-171.2).) | - CTL-744: spotter mandatory for mechanical loading; signals briefed; stop-on-incursion; incident reported
Owner: Loading-Zone Supervisor / HSE (VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4971_Assoc10" sourceRef="W4971_Annotation9" targetRef="W4971_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4971_Flow11" sourceRef="W4971_Start4" targetRef="W4971_Task5" />
      <bpmn:sequenceFlow id="W4971_Flow12" sourceRef="W4971_Task5" targetRef="W4971_Task6" />
      <bpmn:sequenceFlow id="W4971_Flow13" sourceRef="W4971_Task6" targetRef="W4971_Task7" />
      <bpmn:sequenceFlow id="W4971_Flow14" sourceRef="W4971_Task7" targetRef="W4971_End8" />
    </bpmn:process>
