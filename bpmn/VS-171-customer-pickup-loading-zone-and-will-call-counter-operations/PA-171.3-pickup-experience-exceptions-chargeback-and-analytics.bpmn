    <bpmn:process id="W_W4981" name="W4981. Pickup Program Performance Analytics &amp; Continuous Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly review; CX/SLA data (W4977); exception trends (W4979)
Frequency: Monthly + quarterly deep-dive
Volume: ~1 program analytics cycle across 200 stores
Owner: Customer Pickup Program Manager / Store Ops / Analytics
Participants: Store Ops (VS-07), CX (VS-13), Analytics (VS-28), Ecommerce (VS-10), HSE (VS-24)
Source: workflow W4981 — Pickup Program Performance Analytics &amp; Continuous Improvement</bpmn:documentation>
      <bpmn:laneSet id="W4981_LaneSet3">
        <bpmn:lane id="W4981_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4981_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4981_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4981_Lane2" name="Program Manager">
        <bpmn:flowNodeRef>W4981_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4981_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4981_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4981_Start4" name="Monthly/quarterly review; CX/SLA data (W4977); exception trends (W4979)">
        <bpmn:outgoing>W4981_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4981_Task5" name="Analyze program performance: SLA/CX (W4977), throughput/capacity (W4963)…">
        <bpmn:documentation>Step 1: Analyze program performance: SLA/CX (W4977), throughput/capacity (W4963), exceptions/fraud (W4979/W4980), safety (W4982), cost/revenue (W4983), by store/region; identify top/bottom performers and root causes
Responsible (R): Analytics / Program Manager / Store Ops
Accountable (A): VP Store Operations
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4981_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4981_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4981_Task6" name="Identify &amp; prioritize improvements: staffing/capacity, layout/wayfinding…">
        <bpmn:documentation>Step 2: Identify &amp; prioritize improvements: staffing/capacity, layout/wayfinding (W4964), appointment model (W4963), training (VS-19.4/VS-124), technology (VS-149 self-checkout/scan), and safety (VS-147); build the improvement pipeline
Responsible (R): Program Manager / Store Ops / CX / HSE
Accountable (A): VP Store Operations
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4981_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4981_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4981_Task7" name="Execute &amp; sustain: pilot/roll improvements via store-comms (VS-63), track…">
        <bpmn:documentation>Step 3: Execute &amp; sustain: pilot/roll improvements via store-comms (VS-63), track outcomes vs KPIs, feed the operating model (W4961) and OpEx program (VS-133), and report to leadership
Responsible (R): Program Manager / Store Ops / Analytics
Accountable (A): VP Store Operations / COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4981_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4981_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4981_End8" name="Complete">
        <bpmn:incoming>W4981_Flow14</bpmn:incoming>
      </bpmn:endEvent>
