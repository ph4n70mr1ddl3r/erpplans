<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-171.3-pickup-experience-exceptions-chargeback-and-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4977" name="W4977. Pickup SLA, Wait-Time &amp; Customer Experience Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous CX monitoring; periodic review
Frequency: Real-time + monthly review
Volume: ~140,000–220,000 pickup transactions/month across 200 stores, measured continuously
Owner: CX (VS-13) / Customer Pickup Program Manager / Store Ops
Participants: CX (VS-13), Store Ops (VS-07), Ecommerce (VS-10), Data (VS-28)
Source: workflow W4977 — Pickup SLA, Wait-Time &amp; Customer Experience Measurement</bpmn:documentation>
      <bpmn:laneSet id="W4977_LaneSet2">
        <bpmn:lane id="W4977_Lane1" name="CX">
        <bpmn:flowNodeRef>W4977_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4977_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4977_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4977_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4977_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4977_Start3" name="Continuous CX monitoring; periodic review">
        <bpmn:outgoing>W4977_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4977_Task4" name="Define &amp; measure the pickup SLA: order-ready time (from W4965), wait time at…">
        <bpmn:documentation>Step 1: Define &amp; measure the pickup SLA: order-ready time (from W4965), wait time at counter/bay (W4962/W4966), load time (W4970), and the end-to-end pickup duration; measure against the target and by store/region
Responsible (R): CX / Analytics / Store Ops
Accountable (A): Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4977_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4977_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4977_Task5" name="Capture customer experience: post-pickup feedback (CSAT/NPS links VS-13 W65)…">
        <bpmn:documentation>Step 2: Capture customer experience: post-pickup feedback (CSAT/NPS links VS-13 W65), friction signals (queue, not-ready, damage), and the pickup-journey VOC; integrate with VS-13 CX analytics
Responsible (R): CX / Analytics
Accountable (A): Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4977_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4977_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4977_Task6" name="Review &amp; act: monthly SLA/CX review by store/region, root-cause breaches…">
        <bpmn:documentation>Step 3: Review &amp; act: monthly SLA/CX review by store/region, root-cause breaches (staffing, capacity, process), and feed continuous improvement (W4981) and the store-comms/task system (VS-63)
Responsible (R): CX / Store Ops / Program Manager
Accountable (A): VP Store Operations
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4977_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4977_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4977_End7" name="Complete">
        <bpmn:incoming>W4977_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4977_Annotation8">
        <bpmn:text>Controls: - CTL-745 (ensure controlled execution — Pickup Experience, Exceptions, Chargeback &amp; Analytics (PA-171.3).) | - CTL-745: SLA defined &amp; measured; CX captured; breaches root-caused; store/region tracked
Owner: CX (VS-13) / Customer Pickup Program Manager / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4977_Assoc9" sourceRef="W4977_Annotation8" targetRef="W4977_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4977_Flow10" sourceRef="W4977_Start3" targetRef="W4977_Task4" />
      <bpmn:sequenceFlow id="W4977_Flow11" sourceRef="W4977_Task4" targetRef="W4977_Task5" />
      <bpmn:sequenceFlow id="W4977_Flow12" sourceRef="W4977_Task5" targetRef="W4977_Task6" />
      <bpmn:sequenceFlow id="W4977_Flow13" sourceRef="W4977_Task6" targetRef="W4977_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4977_diag">
      <bpmndi:BPMNPlane id="W4977_plane" bpmnElement="W_W4977">
