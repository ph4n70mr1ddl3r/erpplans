    <bpmn:process id="W_W4978" name="W4978. No-Show, Hold-Expiry, Restocking &amp; Cancellation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Customer no-show; hold period expiry; cancellation
Frequency: Continuous × 200 stores
Volume: ~5–10 no-show/expiry events per store per week × 200 stores
Owner: Will-Call/Loading-Zone Supervisor / Store Ops
Participants: Store Ops (VS-07), CX (VS-13), Inventory (VS-05), Ecommerce (VS-10), Finance (VS-17)
Source: workflow W4978 — No-Show, Hold-Expiry, Restocking &amp; Cancellation Management</bpmn:documentation>
      <bpmn:laneSet id="W4978_LaneSet4">
        <bpmn:lane id="W4978_Lane1" name="Supervisor">
        <bpmn:flowNodeRef>W4978_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4978_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4978_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W4978_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4978_Lane3" name="CX">
        <bpmn:flowNodeRef>W4978_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4978_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4978_Start5" name="Customer no-show; hold period expiry; cancellation">
        <bpmn:outgoing>W4978_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4978_Task6" name="Track holds &amp; expiries: monitor the hold period per policy (e.g., BOPIS 5-day…">
        <bpmn:documentation>Step 1: Track holds &amp; expiries: monitor the hold period per policy (e.g., BOPIS 5-day links VS-10), remind approaching-expiry customers (W4966), and identify no-shows
Responsible (R): Supervisor / CX / Store Ops
Accountable (A): Supervisor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4978_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4978_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4978_Task7" name="Manage expiry/cancellation: on expiry or cancellation, restock the staged goods…">
        <bpmn:documentation>Step 2: Manage expiry/cancellation: on expiry or cancellation, restock the staged goods (links VS-05, VS-32), reverse/release the reservation, process the refund/charge per policy (restocking fee where applicable), and update order status
Responsible (R): Store Ops / Inventory / Finance / CX
Accountable (A): Supervisor
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4978_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4978_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4978_Task8" name="Analyze &amp; reduce no-shows: root-cause no-shows (notification, friction…">
        <bpmn:documentation>Step 3: Analyze &amp; reduce no-shows: root-cause no-shows (notification, friction, customer), feed CX (VS-13), adjust reminder policy (W4966), and manage restocking-fee policy/fairness
Responsible (R): CX / Analytics / Store Ops
Accountable (A): Program Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4978_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4978_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4978_End9" name="Complete">
        <bpmn:incoming>W4978_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4978_Annotation10">
        <bpmn:text>Controls: - CTL-97 (ensure will-call release integrity &amp; loading safety.) | - CTL-745: hold period enforced; expiry processed; refund/charge per policy; restocking-fee documented
Owner: Will-Call/Loading-Zone Supervisor / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4978_Assoc11" sourceRef="W4978_Annotation10" targetRef="W4978_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4978_Flow12" sourceRef="W4978_Start5" targetRef="W4978_Task6" />
      <bpmn:sequenceFlow id="W4978_Flow13" sourceRef="W4978_Task6" targetRef="W4978_Task7" />
      <bpmn:sequenceFlow id="W4978_Flow14" sourceRef="W4978_Task7" targetRef="W4978_Task8" />
      <bpmn:sequenceFlow id="W4978_Flow15" sourceRef="W4978_Task8" targetRef="W4978_End9" />
    </bpmn:process>
