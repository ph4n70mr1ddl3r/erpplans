        <bpmndi:BPMNEdge id="W3210_Flow11_di" bpmnElement="W3210_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3210_Flow12_di" bpmnElement="W3210_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3210_Flow13_di" bpmnElement="W3210_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3210_Flow14_di" bpmnElement="W3210_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3210_Assoc10_di" bpmnElement="W3210_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3211" name="W3211. DOLE D.O. 174 Labor-Only Contracting Compliance &amp; Contract Structuring" isExecutable="false">
      <bpmn:documentation>Trigger: New/renegotiated service contract; classification review; DOLE inspection
Frequency: Per contract + periodic review
Volume: ~30–60 active service contracts
Owner: Labor Compliance Manager
Participants: Labor Compliance Mgr, Legal, HR (links to VS-84), Procurement (links to VS-34), Contingent Workforce Mgr, Agency
Source: workflow W3211 — DOLE D.O. 174 Labor-Only Contracting Compliance &amp; Contract Structuring</bpmn:documentation>
      <bpmn:laneSet id="W3211_LaneSet3">
        <bpmn:lane id="W3211_Lane1" name="Labor Compliance Mgr">
        <bpmn:flowNodeRef>W3211_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3211_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3211_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3211_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3211_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3211_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3211_Start4" name="New/renegotiated service contract; classification review; DOLE inspection">
        <bpmn:outgoing>W3211_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3211_Task5" name="Labor Compliance/Legal structure each contract to be legitimate job-contracting…">
        <bpmn:documentation>Step 1: Labor Compliance/Legal structure each contract to be legitimate job-contracting (not labor-only): confirm contractor has substantial capital/investment (tools, equipment, premises), exercises direct control over its workers (hiring, firing, assignment, payroll, discipline), performs work distinct from BuildRight&#x27;s core business where possible; avoid provisions implying employer-of-record (set hours, supervise day-to-day, integrate into BuildRight org)
Responsible (R): Labor Compliance Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3211_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3211_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3211_Task6" name="Legal draft contract with compliance safeguards: principal-contractor…">
        <bpmn:documentation>Step 2: Legal draft contract with compliance safeguards: principal-contractor relationship (not BuildRight–worker), contractor warrants DOLE/SSS/PhilHealth/Pag-IBIG/13th-month/wage compliance and indemnifies BuildRight, audit rights, recordkeeping, right-to-direct-reserved-to-contractor clause; align with VS-34 service-provider contract standards
Responsible (R): Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3211_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3211_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3211_Task7" name="Labor Compliance maintain contracting-risk register and train operations…">
        <bpmn:documentation>Step 3: Labor Compliance maintain contracting-risk register and train operations supervisors (Store Mgrs/DC Mgrs) on supervision boundaries — direct BuildRight supervisors must not assume employer functions (hire/fire/pay/direct-discipline) over contractor workers, which would convert them to BuildRight employees under the four-fold test; periodic audit (W3226)
Responsible (R): Labor Compliance Mgr / HR
Accountable (A): CHRO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3211_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3211_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3211_End8" name="Complete">
        <bpmn:incoming>W3211_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3211_Annotation9">
        <bpmn:text>Controls: - CTL-121 (ensure lawful contracting &amp; worker classification.) | - operational: structuring discipline, four-fold-test training, and audit; operational: remittance verification (W3210/W3226) and indemnity
Owner: Labor Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3211_Assoc10" sourceRef="W3211_Annotation9" targetRef="W3211_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3211_Flow11" sourceRef="W3211_Start4" targetRef="W3211_Task5" />
      <bpmn:sequenceFlow id="W3211_Flow12" sourceRef="W3211_Task5" targetRef="W3211_Task6" />
      <bpmn:sequenceFlow id="W3211_Flow13" sourceRef="W3211_Task6" targetRef="W3211_Task7" />
      <bpmn:sequenceFlow id="W3211_Flow14" sourceRef="W3211_Task7" targetRef="W3211_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3211_diag">
      <bpmndi:BPMNPlane id="W3211_plane" bpmnElement="W_W3211">
        <bpmndi:BPMNShape id="W3211_Lane1_di" bpmnElement="W3211_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Lane2_di" bpmnElement="W3211_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Task5_di" bpmnElement="W3211_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Task6_di" bpmnElement="W3211_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Task7_di" bpmnElement="W3211_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Start4_di" bpmnElement="W3211_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_End8_di" bpmnElement="W3211_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3211_Annotation9_di" bpmnElement="W3211_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3211_Flow11_di" bpmnElement="W3211_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3211_Flow12_di" bpmnElement="W3211_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3211_Flow13_di" bpmnElement="W3211_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3211_Flow14_di" bpmnElement="W3211_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3211_Assoc10_di" bpmnElement="W3211_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3212" name="W3212. Statement of Work &amp; Service Level Agreement Drafting" isExecutable="false">
      <bpmn:documentation>Trigger: New contract; service change; SLA review
Frequency: Per contract + annual review
Volume: ~30–60 service contracts
Owner: Contingent Workforce Manager
Participants: Contingent Workforce Mgr, User Dept, Procurement (links to VS-34), Legal, Agency
Source: workflow W3212 — Statement of Work &amp; Service Level Agreement Drafting</bpmn:documentation>
      <bpmn:laneSet id="W3212_LaneSet4">
        <bpmn:lane id="W3212_Lane1" name="User Dept">
        <bpmn:flowNodeRef>W3212_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3212_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3212_Lane2" name="Contingent Workforce Mgr">
        <bpmn:flowNodeRef>W3212_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
