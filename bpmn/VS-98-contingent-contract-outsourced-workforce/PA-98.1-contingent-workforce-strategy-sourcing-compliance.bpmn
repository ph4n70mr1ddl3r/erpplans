        <bpmn:flowNodeRef>W3213_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3213_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3213_Start4" name="New MSA; renewal; market review">
        <bpmn:outgoing>W3213_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3213_Task5" name="Procurement/Finance benchmark rates to market: per-role/per-region market rates…">
        <bpmn:documentation>Step 1: Procurement/Finance benchmark rates to market: per-role/per-region market rates (security guard, cleaner, promodizer), wage-order compliance (Regional Tripartite Wages and Productivity Board minimums per region — links to VS-76 multi-region), agency margin/loading norms; identify negotiation levers
Responsible (R): Procurement / Finance
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3213_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3213_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3213_Task6" name="Negotiate rate card, price-adjustment mechanism (wage-order pass-through, fuel…">
        <bpmn:documentation>Step 2: Negotiate rate card, price-adjustment mechanism (wage-order pass-through, fuel for transport-linked), volume discounts, payment terms (links to VS-15); structure for compliance — no direct per-worker piece rates to BuildRight (worker paid by agency, not BuildRight)
Responsible (R): Procurement / Contingent Workforce Mgr
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3213_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3213_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3213_Task7" name="Legal execute MSA: commercial terms, term/renewal, termination, compliance…">
        <bpmn:documentation>Step 3: Legal execute MSA: commercial terms, term/renewal, termination, compliance warranties, insurance/indemnity (W3214), audit rights, data privacy (links to VS-91 for worker personal data), dispute resolution; manage contract lifecycle (links to VS-34.2/W3274)
Responsible (R): Legal / Procurement
Accountable (A): VP Legal &amp; Compliance
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3213_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3213_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3213_End8" name="Complete">
        <bpmn:incoming>W3213_Flow14</bpmn:incoming>
      </bpmn:endEvent>
