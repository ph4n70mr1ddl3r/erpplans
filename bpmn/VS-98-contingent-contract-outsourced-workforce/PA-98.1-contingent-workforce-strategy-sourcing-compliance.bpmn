<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-98.1-contingent-workforce-strategy-sourcing-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3209" name="W3209. Contingent Labor Strategy &amp; Workforce Category Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual workforce planning (links to VS-19.3); new operating need; cost/strategic review
Frequency: Annual + event-driven
Volume: ~8–12 contingent categories (security, janitorial, promodizer, merchandising crew, construction labor, delivery helper, IT contractor, etc.)
Owner: Contingent Workforce Manager
Participants: Contingent Workforce Mgr, CHRO/HR (links to VS-19), Store Ops (links to VS-07), DC Ops (links to VS-04), Procurement (links to VS-34), Finance, Legal
Source: workflow W3209 — Contingent Labor Strategy &amp; Workforce Category Planning</bpmn:documentation>
      <bpmn:laneSet id="W3209_LaneSet4">
        <bpmn:lane id="W3209_Lane1" name="Contingent Workforce Mgr">
        <bpmn:flowNodeRef>W3209_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3209_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3209_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3209_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3209_Lane3" name="Exec Committee">
        <bpmn:flowNodeRef>W3209_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3209_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3209_Start5" name="Annual workforce planning (links to VS-19.3); new operating need; cost/strategic review">
        <bpmn:outgoing>W3209_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3209_Task6" name="Contingent Workforce Mgr/HR (links to VS-19.3) assess demand by category: which…">
        <bpmn:documentation>Step 1: Contingent Workforce Mgr/HR (links to VS-19.3) assess demand by category: which functions are core (employee) vs non-core (contingent/outsource), headcount equivalents by location/shift, seasonality (Christmas promodizers per W555 context), peak/event demand (store openings VS-37, inventory counts); define make-vs-buy (employee vs contractor vs outsourced function)
Responsible (R): Contingent Workforce Mgr / HR
Accountable (A): CHRO
Duration: 4–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3209_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3209_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3209_Task7" name="Finance/Procurement (links to VS-34) build category cost model: fully-loaded…">
        <bpmn:documentation>Step 2: Finance/Procurement (links to VS-34) build category cost model: fully-loaded employee cost vs contingent rate vs outsourced-function price; total-cost-of-ownership incl. management overhead, compliance, and risk premium; size addressable spend
Responsible (R): Finance Analyst / Procurement
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3209_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3209_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3209_Task8" name="Executive committee (CHRO/COO/CFO) approves strategy, sourcing model per…">
        <bpmn:documentation>Step 3: Executive committee (CHRO/COO/CFO) approves strategy, sourcing model per category, authority for insource/outsource transitions (W3231), and contingency-to-regular ratio guardrails (W3230); integrate to VS-33 workforce plan and VS-19 hiring plan
Responsible (R): Exec Committee
Accountable (A): CEO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3209_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3209_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3209_End9" name="Complete">
        <bpmn:incoming>W3209_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3209_Annotation10">
        <bpmn:text>Controls: - CTL-523 (ensure controlled execution — Contingent Workforce Strategy, Sourcing &amp; Compliance (PA-98.1).) | - operational: ratio guardrails (W3230); operational: make-vs-buy discipline
Owner: Contingent Workforce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3209_Assoc11" sourceRef="W3209_Annotation10" targetRef="W3209_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3209_Flow12" sourceRef="W3209_Start5" targetRef="W3209_Task6" />
      <bpmn:sequenceFlow id="W3209_Flow13" sourceRef="W3209_Task6" targetRef="W3209_Task7" />
      <bpmn:sequenceFlow id="W3209_Flow14" sourceRef="W3209_Task7" targetRef="W3209_Task8" />
      <bpmn:sequenceFlow id="W3209_Flow15" sourceRef="W3209_Task8" targetRef="W3209_End9" />
    </bpmn:process>
