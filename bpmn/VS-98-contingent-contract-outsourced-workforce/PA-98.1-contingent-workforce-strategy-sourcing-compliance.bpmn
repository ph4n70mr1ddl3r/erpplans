        <bpmn:flowNodeRef>W3212_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3212_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3212_Start5" name="New contract; service change; SLA review">
        <bpmn:outgoing>W3212_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3212_Task6" name="User Dept/Contingent Workforce Mgr define scope of work and deliverables…">
        <bpmn:documentation>Step 1: User Dept/Contingent Workforce Mgr define scope of work and deliverables: headcount equivalents, coverage hours/shifts, work standards (security posts, cleaning checklist, promodizer targets), outputs/deliverables, exclusions, escalation path; avoid directing individual worker assignments (W3211 four-fold test)
Responsible (R): User Dept / Contingent Workforce Mgr
Accountable (A): CHRO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3212_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3212_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3212_Task7" name="Define SLA and KPIs: response/coverage, quality standards (audit score, defect…">
        <bpmn:documentation>Step 2: Define SLA and KPIs: response/coverage, quality standards (audit score, defect rate), HSE performance (links to VS-24), attendance/reliability, customer/store satisfaction; measurement method, frequency, reporting; credit/penalty mechanism
Responsible (R): Contingent Workforce Mgr / User Dept
Accountable (A): CHRO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W3212_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3212_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3212_Task8" name="Legal incorporate SOW/SLA into MSA (W3213); align to VS-34 service-provider…">
        <bpmn:documentation>Step 3: Legal incorporate SOW/SLA into MSA (W3213); align to VS-34 service-provider standards; obtain sign-off; communicate SLA to operations for performance management (W3225)
Responsible (R): Legal / Contingent Workforce Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3212_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3212_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3212_End9" name="Complete">
        <bpmn:incoming>W3212_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3212_Annotation10">
        <bpmn:text>Controls: - CTL-523 (ensure controlled execution — Contingent Workforce Strategy, Sourcing &amp; Compliance (PA-98.1).) | - operational: detailed SOW and change control; operational: balanced KPIs and audit (W3225)
Owner: Contingent Workforce Manager</bpmn:text>
      </bpmn:textAnnotation>
