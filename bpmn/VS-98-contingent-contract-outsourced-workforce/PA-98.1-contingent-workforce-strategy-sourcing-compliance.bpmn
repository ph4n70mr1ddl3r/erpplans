    <bpmn:process id="W_W3210" name="W3210. Agency &amp; Service Contractor Sourcing &amp; Qualification" isExecutable="false">
      <bpmn:documentation>Trigger: New category need; contract expiry; market test
Frequency: Per category cycle (every 1–3 years)
Volume: ~30–60 agencies/contractors active; ~8–12 category RFPs/year
Owner: Contingent Workforce Manager
Participants: Contingent Workforce Mgr, Procurement (links to VS-34), Legal, Finance, Safety (links to VS-24), User Depts
Source: workflow W3210 — Agency &amp; Service Contractor Sourcing &amp; Qualification</bpmn:documentation>
      <bpmn:laneSet id="W3210_LaneSet3">
        <bpmn:lane id="W3210_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3210_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3210_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3210_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3210_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3210_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3210_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3210_Start4" name="New category need; contract expiry; market test">
        <bpmn:outgoing>W3210_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3210_Task5" name="Procurement/Contingent Workforce Mgr (links to VS-34) run sourcing: market…">
        <bpmn:documentation>Step 1: Procurement/Contingent Workforce Mgr (links to VS-34) run sourcing: market scan, RFx, shortlist agencies/contractors; evaluate on legal/DOLE compliance (valid DOLE license where required — security agency per RA 5487, etc.), financial stability, capacity, references, HSE record (links to VS-24), wage/benefits compliance of their workers
Responsible (R): Procurement / Contingent Workforce Mgr
Accountable (A): CHRO
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3210_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3210_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3210_Task6" name="Legal/Safety qualify: verify agency business permits (links to VS-22), DOLE…">
        <bpmn:documentation>Step 2: Legal/Safety qualify: verify agency business permits (links to VS-22), DOLE registration, SSS/PhilHealth/Pag-IBIG remittance proof for their workers, police/NBI clearance program, insurance (W3214), HSE program; perform site reference checks; confirm no labor-only-contracting red flags (W3211)
Responsible (R): Legal / Safety
Accountable (A): VP Legal &amp; Compliance
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3210_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3210_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3210_Task7" name="Award and onboard preferred supplier per category: master services agreement…">
        <bpmn:documentation>Step 3: Award and onboard preferred supplier per category: master services agreement (W3213), rate card, SLA (W3212), compliance attestations, system access for time/invoice (W3221); add to vendor master (links to VS-29) and contingent supplier register
Responsible (R): Procurement / Contingent Workforce Mgr
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3210_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3210_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3210_End8" name="Complete">
        <bpmn:incoming>W3210_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3210_Annotation9">
        <bpmn:text>Controls: - CTL-523 (ensure controlled execution — Contingent Workforce Strategy, Sourcing &amp; Compliance (PA-98.1).) | - operational: upfront qualification and periodic audit (W3226); operational: multi-supplier strategy
Owner: Contingent Workforce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3210_Assoc10" sourceRef="W3210_Annotation9" targetRef="W3210_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3210_Flow11" sourceRef="W3210_Start4" targetRef="W3210_Task5" />
      <bpmn:sequenceFlow id="W3210_Flow12" sourceRef="W3210_Task5" targetRef="W3210_Task6" />
      <bpmn:sequenceFlow id="W3210_Flow13" sourceRef="W3210_Task6" targetRef="W3210_Task7" />
      <bpmn:sequenceFlow id="W3210_Flow14" sourceRef="W3210_Task7" targetRef="W3210_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3210_diag">
      <bpmndi:BPMNPlane id="W3210_plane" bpmnElement="W_W3210">
        <bpmndi:BPMNShape id="W3210_Lane1_di" bpmnElement="W3210_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_Lane2_di" bpmnElement="W3210_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_Task5_di" bpmnElement="W3210_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_Task6_di" bpmnElement="W3210_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_Task7_di" bpmnElement="W3210_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_Start4_di" bpmnElement="W3210_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3210_End8_di" bpmnElement="W3210_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
