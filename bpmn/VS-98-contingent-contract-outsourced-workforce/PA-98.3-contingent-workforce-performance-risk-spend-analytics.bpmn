        <bpmndi:BPMNEdge id="W3226_Assoc9_di" bpmnElement="W3226_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3227" name="W3227. Contingent Workforce Spend Analytics &amp; Cost Control" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; quarterly cost review
Frequency: Monthly + quarterly
Volume: Portfolio-wide contingent spend
Owner: Contingent Workforce Manager
Participants: Contingent Workforce Mgr, Finance (links to VS-17.4/VS-34.3), Procurement, User Depts
Source: workflow W3227 — Contingent Workforce Spend Analytics &amp; Cost Control</bpmn:documentation>
      <bpmn:laneSet id="W3227_LaneSet3">
        <bpmn:lane id="W3227_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W3227_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3227_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3227_Lane2" name="Contingent Workforce Mgr">
        <bpmn:flowNodeRef>W3227_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3227_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3227_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3227_Start4" name="Monthly close; quarterly cost review">
        <bpmn:outgoing>W3227_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3227_Task5" name="Finance/Contingent Workforce Mgr compile spend analytics: by category…">
        <bpmn:documentation>Step 1: Finance/Contingent Workforce Mgr compile spend analytics: by category (security/janitorial/promodizer/etc.), by location, by agency, by GL/cost center (links to VS-34.3), vs budget (links to VS-33) and prior period; compute cost per unit (per store, per sqm, per shift)
Responsible (R): Finance Analyst / Contingent Workforce Mgr
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3227_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3227_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3227_Task6" name="Analyze drivers and opportunities: rate vs benchmark (W3213), overtime/premium…">
        <bpmn:documentation>Step 2: Analyze drivers and opportunities: rate vs benchmark (W3213), overtime/premium spend, idle/overstaffing, SLA-credit recovery, category consolidation, demand-management (reduce unnecessary contingent hours), insource/outsource (W3231)
Responsible (R): Contingent Workforce Mgr / Procurement
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3227_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3227_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3227_Task7" name="Execute cost actions: renegotiate rates (W3213), consolidate suppliers…">
        <bpmn:documentation>Step 3: Execute cost actions: renegotiate rates (W3213), consolidate suppliers, eliminate low-value spend, enforce PO compliance (W3217); track savings vs target and report to finance/exec
Responsible (R): Contingent Workforce Mgr / Finance
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3227_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3227_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3227_End8" name="Complete">
        <bpmn:incoming>W3227_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3227_Annotation9">
        <bpmn:text>Controls: - CTL-525 (ensure controlled execution — Contingent Workforce Performance, Risk &amp; Spend Analytics (PA-98.3).) | - operational: PO gating and analytics visibility; operational: demand planning (W3209) and monthly tracking
Owner: Contingent Workforce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3227_Assoc10" sourceRef="W3227_Annotation9" targetRef="W3227_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3227_Flow11" sourceRef="W3227_Start4" targetRef="W3227_Task5" />
      <bpmn:sequenceFlow id="W3227_Flow12" sourceRef="W3227_Task5" targetRef="W3227_Task6" />
      <bpmn:sequenceFlow id="W3227_Flow13" sourceRef="W3227_Task6" targetRef="W3227_Task7" />
      <bpmn:sequenceFlow id="W3227_Flow14" sourceRef="W3227_Task7" targetRef="W3227_End8" />
    </bpmn:process>
