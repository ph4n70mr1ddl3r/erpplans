        <bpmndi:BPMNShape id="W3227_Task7_di" bpmnElement="W3227_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3227_Start4_di" bpmnElement="W3227_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3227_End8_di" bpmnElement="W3227_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3227_Annotation9_di" bpmnElement="W3227_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3227_Flow11_di" bpmnElement="W3227_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3227_Flow12_di" bpmnElement="W3227_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3227_Flow13_di" bpmnElement="W3227_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3227_Flow14_di" bpmnElement="W3227_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3227_Assoc10_di" bpmnElement="W3227_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3228" name="W3228. Incident, Injury &amp; Contractor Claims Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor-worker or contractor-caused incident
Frequency: Event-driven
Volume: ~50–200 incidents/year (minor to serious)
Owner: Safety Manager
Participants: Safety Mgr (links to VS-24), Risk &amp; Insurance (links to VS-26), Legal, User Dept, Agency, Contractor
Source: workflow W3228 — Incident, Injury &amp; Contractor Claims Management</bpmn:documentation>
      <bpmn:laneSet id="W3228_LaneSet4">
        <bpmn:lane id="W3228_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W3228_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3228_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3228_Lane2" name="Safety Mgr">
        <bpmn:flowNodeRef>W3228_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3228_Lane3" name="Risk &amp; Insurance Mgr">
        <bpmn:flowNodeRef>W3228_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3228_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3228_Start5" name="Contractor-worker or contractor-caused incident">
        <bpmn:outgoing>W3228_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3228_Task6" name="Respond to incident: first aid/medical, secure scene, document (photos, witness…">
        <bpmn:documentation>Step 1: Respond to incident: first aid/medical, secure scene, document (photos, witness statements, time/location), notify Safety and agency; for serious injury/fatality, notify DOLE per VS-24.1 (occupational accident reporting) and preserve evidence; contractor-worker medical care is agency/ECC responsibility
Responsible (R): Safety Officer / User Dept
Accountable (A): Safety Mgr
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3228_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3228_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3228_Task7" name="Investigate root cause: Safety/Agency joint investigation, determine cause…">
        <bpmn:documentation>Step 2: Investigate root cause: Safety/Agency joint investigation, determine cause (worker error, equipment, process, environment), corrective and preventive actions (CAPA), assign responsibility (BuildRight vs contractor vs shared); document for HSE metrics (links to VS-24.1) and DOLE
Responsible (R): Safety Mgr / Agency
Accountable (A): Safety Mgr
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3228_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3228_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3228_Task8" name="Manage claims and recovery: contractor workers&#x27; compensation via agency/ECC…">
        <bpmn:documentation>Step 3: Manage claims and recovery: contractor workers&#x27; compensation via agency/ECC; third-party/property-damage claims via BuildRight/contractor insurance (W3214); subrogation where third party at fault; legal matter for disputes (links to VS-100); reserve for loss (W3277)
Responsible (R): Risk &amp; Insurance Mgr / Legal
Accountable (A): CFO
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3228_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3228_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3228_End9" name="Complete">
        <bpmn:incoming>W3228_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3228_Annotation10">
        <bpmn:text>Controls: - CTL-525 (ensure controlled execution — Contingent Workforce Performance, Risk &amp; Spend Analytics (PA-98.3).) | - operational: thorough investigation and contract terms (W3213/W3214); operational: reporting culture and analytics (W3225)
Owner: Safety Manager</bpmn:text>
      </bpmn:textAnnotation>
