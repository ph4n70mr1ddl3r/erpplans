      <bpmndi:BPMNPlane id="W3227_plane" bpmnElement="W_W3227">
        <bpmndi:BPMNShape id="W3227_Lane1_di" bpmnElement="W3227_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3227_Lane2_di" bpmnElement="W3227_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
