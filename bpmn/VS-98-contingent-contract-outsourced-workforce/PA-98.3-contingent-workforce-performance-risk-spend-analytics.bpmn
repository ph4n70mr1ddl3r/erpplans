      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3226" name="W3226. Misclassification Audit &amp; DOLE Inspection Defense" isExecutable="false">
      <bpmn:documentation>Trigger: Annual compliance audit; DOLE inspection/notice; worker regularization complaint
Frequency: Annual + event-driven
Volume: All engagements; ~1–5 DOLE/complaint events/year
Owner: Labor Compliance Manager
Participants: Labor Compliance Mgr, Legal, HR (links to VS-84), Internal Audit (links to VS-21), Contingent Workforce Mgr
Source: workflow W3226 — Misclassification Audit &amp; DOLE Inspection Defense</bpmn:documentation>
      <bpmn:laneSet id="W3226_LaneSet2">
        <bpmn:lane id="W3226_Lane1" name="Labor Compliance Mgr">
        <bpmn:flowNodeRef>W3226_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3226_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3226_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3226_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3226_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3226_Start3" name="Annual compliance audit; DOLE inspection/notice; worker regularization complaint">
        <bpmn:outgoing>W3226_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3226_Task4" name="Labor Compliance/Internal Audit (links to VS-21) conduct periodic…">
        <bpmn:documentation>Step 1: Labor Compliance/Internal Audit (links to VS-21) conduct periodic misclassification audit: sample engagements, apply four-fold test (W3215), review agency DOLE/SSS/PhilHealth/Pag-IBIG remittance evidence, wage-order compliance, contract terms vs actual practice; identify risk-rated findings
Responsible (R): Labor Compliance Mgr / Internal Audit
Accountable (A): CHRO
Duration: Annual + event</bpmn:documentation>
        <bpmn:incoming>W3226_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3226_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3226_Task5" name="Remediate findings: convert confirmed employees (W3230), restructure…">
        <bpmn:documentation>Step 2: Remediate findings: convert confirmed employees (W3230), restructure engagements (W3211), strengthen supervisor training, recover solidary exposure where possible; track to closure
Responsible (R): Labor Compliance Mgr / HR / Legal
Accountable (A): CHRO
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W3226_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3226_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3226_Task6" name="On DOLE inspection or NLRC complaint (links to VS-84.2/VS-100), defend: produce…">
        <bpmn:documentation>Step 3: On DOLE inspection or NLRC complaint (links to VS-84.2/VS-100), defend: produce contracts, agency licenses/remittance proof, classification rationale, four-fold-test documentation, supervisor-training evidence; manage conciliation/settlement per VS-84.2 DOLE process; reserve for loss (links to VS-100 W3277)
Responsible (R): Labor Compliance Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W3226_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3226_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3226_End7" name="Complete">
        <bpmn:incoming>W3226_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3226_Annotation8">
        <bpmn:text>Controls: - CTL-525 (ensure controlled execution — Contingent Workforce Performance, Risk &amp; Spend Analytics (PA-98.3).) | - operational: annual audit and structuring discipline (W3211); operational: remittance verification and indemnity recovery
Owner: Labor Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3226_Assoc9" sourceRef="W3226_Annotation8" targetRef="W3226_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3226_Flow10" sourceRef="W3226_Start3" targetRef="W3226_Task4" />
      <bpmn:sequenceFlow id="W3226_Flow11" sourceRef="W3226_Task4" targetRef="W3226_Task5" />
      <bpmn:sequenceFlow id="W3226_Flow12" sourceRef="W3226_Task5" targetRef="W3226_Task6" />
      <bpmn:sequenceFlow id="W3226_Flow13" sourceRef="W3226_Task6" targetRef="W3226_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3226_diag">
      <bpmndi:BPMNPlane id="W3226_plane" bpmnElement="W_W3226">
