      <bpmn:startEvent id="W3229_Start4" name="Loss event (links to VS-23); anomaly; tip/complaint">
        <bpmn:outgoing>W3229_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3229_Task5" name="Loss Prevention (links to VS-23.1) detect and triage: shrinkage anomaly…">
        <bpmn:documentation>Step 1: Loss Prevention (links to VS-23.1) detect and triage: shrinkage anomaly, cash-handling discrepancy (links to VS-08/VS-81), asset theft (links to VS-35/VS-99), timesheet/deliverable fraud (W3220), collusion with BuildRight employees; initiate investigation per VS-23 methodology
Responsible (R): Loss Prevention Officer
Accountable (A): Loss Prevention Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3229_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3229_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3229_Task6" name="Investigate: evidence collection (CCTV links to VS-23.2, access logs…">
        <bpmn:documentation>Step 2: Investigate: evidence collection (CCTV links to VS-23.2, access logs, transaction data), interview (with agency present — not direct BuildRight discipline), coordinate with agency for worker removal/cooperation; preserve chain of custody for potential criminal/civil action (links to VS-100)
Responsible (R): Loss Prevention / Legal / Agency
Accountable (A): Loss Prevention Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3229_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3229_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3229_Task7" name="Resolve: recovery (civil/criminal per PD 1612 (Anti-Fencing Law) for stolen…">
        <bpmn:documentation>Step 3: Resolve: recovery (civil/criminal per PD 1612 (Anti-Fencing Law) for stolen goods), agency chargeback/disqualification (W3216), tighten controls (access, supervision, screening W3223), feed lessons to risk register (links to VS-21.2) and scorecard (W3225)
Responsible (R): Loss Prevention / Legal
Accountable (A): Loss Prevention Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W3229_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3229_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3229_End8" name="Complete">
        <bpmn:incoming>W3229_Flow14</bpmn:incoming>
      </bpmn:endEvent>
