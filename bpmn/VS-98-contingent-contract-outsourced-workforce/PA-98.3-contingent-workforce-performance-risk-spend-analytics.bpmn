<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-98.3-contingent-workforce-performance-risk-spend-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3225" name="W3225. SLA Performance &amp; Vendor Scorecard Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly review cycle
Frequency: Monthly + quarterly business review
Volume: ~30–60 agencies/contractors
Owner: Contingent Workforce Manager
Participants: Contingent Workforce Mgr, User Dept, Procurement (links to VS-34/VS-67), Finance, Agency
Source: workflow W3225 — SLA Performance &amp; Vendor Scorecard Management</bpmn:documentation>
      <bpmn:laneSet id="W3225_LaneSet2">
        <bpmn:lane id="W3225_Lane1" name="Contingent Workforce Mgr">
        <bpmn:flowNodeRef>W3225_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3225_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3225_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3225_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3225_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3225_Start3" name="Monthly/quarterly review cycle">
        <bpmn:outgoing>W3225_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3225_Task4" name="Contingent Workforce Mgr/Procurement compile scorecard per contractor: SLA/KPI…">
        <bpmn:documentation>Step 1: Contingent Workforce Mgr/Procurement compile scorecard per contractor: SLA/KPI performance (W3212), quality audit scores, coverage/reliability (W3220), HSE (W3219/W3228), compliance attestations (W3210/W3226), invoice accuracy (W3221), customer/user satisfaction
Responsible (R): Contingent Workforce Mgr / User Dept
Accountable (A): CHRO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3225_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3225_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3225_Task5" name="Conduct quarterly business review (QBR) with each contractor: present…">
        <bpmn:documentation>Step 2: Conduct quarterly business review (QBR) with each contractor: present scorecard, discuss improvement actions, credit/penalty application (W3212), recognition for top performers, improvement plans for underperformers, forward demand (W3209); document and follow up
Responsible (R): Contingent Workforce Mgr / Procurement
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3225_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3225_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3225_Task6" name="Drive performance into contract decisions: feed scorecard into renewal/re-bid…">
        <bpmn:documentation>Step 3: Drive performance into contract decisions: feed scorecard into renewal/re-bid (W3216), preferred-supplier status, vendor master (links to VS-67/VS-03.3 vendor scorecard methodology), and category strategy (W3209)
Responsible (R): Contingent Workforce Mgr / Procurement
Accountable (A): CHRO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3225_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3225_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3225_End7" name="Complete">
        <bpmn:incoming>W3225_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3225_Annotation8">
        <bpmn:text>Controls: - CTL-525 (ensure controlled execution — Contingent Workforce Performance, Risk &amp; Spend Analytics (PA-98.3).) | - operational: balanced scorecard and audit; operational: constructive QBR approach
Owner: Contingent Workforce Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3225_Assoc9" sourceRef="W3225_Annotation8" targetRef="W3225_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3225_Flow10" sourceRef="W3225_Start3" targetRef="W3225_Task4" />
      <bpmn:sequenceFlow id="W3225_Flow11" sourceRef="W3225_Task4" targetRef="W3225_Task5" />
      <bpmn:sequenceFlow id="W3225_Flow12" sourceRef="W3225_Task5" targetRef="W3225_Task6" />
      <bpmn:sequenceFlow id="W3225_Flow13" sourceRef="W3225_Task6" targetRef="W3225_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3225_diag">
      <bpmndi:BPMNPlane id="W3225_plane" bpmnElement="W_W3225">
        <bpmndi:BPMNShape id="W3225_Lane1_di" bpmnElement="W3225_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
