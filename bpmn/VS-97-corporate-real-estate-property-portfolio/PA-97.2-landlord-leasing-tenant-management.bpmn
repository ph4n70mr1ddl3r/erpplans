    <bpmn:process id="W_W3199" name="W3199. Tenant Default, Eviction &amp; Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Rent delinquency; lease breach; abandonment; insolvency
Frequency: Event-driven
Volume: ~1–3% of third-party tenants/year
Owner: Property Manager
Participants: Property Mgr, Legal, Finance/AR (links to VS-16.2), Director, Facilities &amp; Real Estate, Sheriff/LGU, Recovery (links to VS-21/VS-23)
Source: workflow W3199 — Tenant Default, Eviction &amp; Recovery</bpmn:documentation>
      <bpmn:laneSet id="W3199_LaneSet3">
        <bpmn:lane id="W3199_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W3199_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3199_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3199_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3199_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W3199_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3199_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3199_Start4" name="Rent delinquency; lease breach; abandonment; insolvency">
        <bpmn:outgoing>W3199_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3199_Task5" name="AR/Property Mgr detect default: rent aging (links to VS-16.2), breach…">
        <bpmn:documentation>Step 1: AR/Property Mgr detect default: rent aging (links to VS-16.2), breach (use/insurance/maintenance), abandonment indicators; issue demand letter and cure-period notice per lease and Philippine civil law; document all steps for evidentiary use
Responsible (R): Property Mgr / Legal
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3199_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3199_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3199_Task6" name="Legal pursue remedies per lease and law: ejectment filing (Regional Trial Court…">
        <bpmn:documentation>Step 2: Legal pursue remedies per lease and law: ejectment filing (Regional Trial Court for forcible entry/unlawful detainer under Rules of Court), provisional remedies (preliminary attachment), apply security deposit to arrears, claim damages and unpaid rent through lease term or reletting; coordinate with LGU/sheriff for peaceful execution
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: 3–12 months</bpmn:documentation>
        <bpmn:incoming>W3199_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3199_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3199_Task7" name="Recovery and reletting: recover possession, secure and clean premises, assess…">
        <bpmn:documentation>Step 3: Recovery and reletting: recover possession, secure and clean premises, assess damages vs deposit, pursue deficiency claim (links to VS-16.3/VS-21), relet space (W3198), update tenant and receivable records; capture lessons for tenant screening (W3194)
Responsible (R): Property Mgr / Legal / AR
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–12 weeks</bpmn:documentation>
        <bpmn:incoming>W3199_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3199_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3199_End8" name="Complete">
        <bpmn:incoming>W3199_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3199_Annotation9">
        <bpmn:text>Controls: - CTL-521 (ensure controlled execution — Landlord Leasing Operations &amp; Tenant Management (PA-97.2).) | - operational: watertight lease, demand-letter discipline, and security deposits; operational: inventory-at-commencement, deposit, and restitution claims
Owner: Property Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3199_Assoc10" sourceRef="W3199_Annotation9" targetRef="W3199_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3199_Flow11" sourceRef="W3199_Start4" targetRef="W3199_Task5" />
      <bpmn:sequenceFlow id="W3199_Flow12" sourceRef="W3199_Task5" targetRef="W3199_Task6" />
