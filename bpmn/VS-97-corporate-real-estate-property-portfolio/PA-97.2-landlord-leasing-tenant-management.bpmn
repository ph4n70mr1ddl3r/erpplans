<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-97.2-landlord-leasing-tenant-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3193" name="W3193. Master Lease &amp; Intercompany Lease Framework" isExecutable="false">
      <bpmn:documentation>Trigger: New property added (W3187/W3188); intercompany framework refresh; PFRS 16 adoption/maintenance
Frequency: Per property + periodic framework review
Volume: ~205+ properties; intercompany lease to BuildRight Depot Inc. on every owned site
Owner: Lease Administration Manager
Participants: Lease Admin Mgr, Director, Facilities &amp; Real Estate, Finance/Transfer Pricing (links to VS-72), Legal, Tax (links to VS-79)
Source: workflow W3193 — Master Lease &amp; Intercompany Lease Framework</bpmn:documentation>
      <bpmn:laneSet id="W3193_LaneSet4">
        <bpmn:lane id="W3193_Lane1" name="Lease Admin Mgr">
        <bpmn:flowNodeRef>W3193_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3193_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3193_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3193_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3193_Lane3" name="Finance Analyst">
        <bpmn:flowNodeRef>W3193_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3193_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3193_Start5" name="New property added (W3187/W3188); intercompany framework refresh; PFRS 16…">
        <bpmn:outgoing>W3193_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3193_Task6" name="Lease Admin/Tax (links to VS-79/VS-72) establish the intercompany lease…">
        <bpmn:documentation>Step 1: Lease Admin/Tax (links to VS-79/VS-72) establish the intercompany lease framework: arm&#x27;s-length rent per transfer-pricing rules (links to VS-72), base-rent methodology (per-sqm market rent benchmarked to comparable third-party leases — W3207), CAM pass-through, escalation formula, party roles (Property Mgmt Inc. as lessor; Depot Inc. as lessee); document arm&#x27;s-length support per BIR transfer-pricing documentation (RR 02-2013)
Responsible (R): Lease Admin Mgr / Tax
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3193_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3193_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3193_Task7" name="Legal/Lease Admin create per-property intercompany lease (or master…">
        <bpmn:documentation>Step 2: Legal/Lease Admin create per-property intercompany lease (or master intercompany lease with schedules): premises description, term, rent, CAM, utilities, maintenance responsibilities, insurance (links to W3204), restoration/make-good, dispute resolution; classify lease under PFRS 16 for lessor accounting (operating vs finance lease)
Responsible (R): Legal / Lease Admin Mgr
Accountable (A): VP Legal &amp; Compliance
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W3193_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3193_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3193_Task8" name="Finance (links to VS-17.2/VS-72) book lessor lease and set up straight-line…">
        <bpmn:documentation>Step 3: Finance (links to VS-17.2/VS-72) book lessor lease and set up straight-line rent recognition (operating lease) or finance-lease receivable (finance lease); configure intercompany rent billing (W3195) and elimination on consolidation (links to VS-17.2)
Responsible (R): Finance Analyst
Accountable (A): Controller
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3193_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3193_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3193_End9" name="Complete">
        <bpmn:incoming>W3193_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3193_Annotation10">
        <bpmn:text>Controls: - CTL-521 (ensure controlled execution — Landlord Leasing Operations &amp; Tenant Management (PA-97.2).) | - operational: W3207 benchmarking and TP documentation; operational: lease-accounting policy and review
Owner: Lease Administration Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3193_Assoc11" sourceRef="W3193_Annotation10" targetRef="W3193_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3193_Flow12" sourceRef="W3193_Start5" targetRef="W3193_Task6" />
      <bpmn:sequenceFlow id="W3193_Flow13" sourceRef="W3193_Task6" targetRef="W3193_Task7" />
      <bpmn:sequenceFlow id="W3193_Flow14" sourceRef="W3193_Task7" targetRef="W3193_Task8" />
      <bpmn:sequenceFlow id="W3193_Flow15" sourceRef="W3193_Task8" targetRef="W3193_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3193_diag">
      <bpmndi:BPMNPlane id="W3193_plane" bpmnElement="W_W3193">
        <bpmndi:BPMNShape id="W3193_Lane1_di" bpmnElement="W3193_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3193_Lane2_di" bpmnElement="W3193_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3193_Lane3_di" bpmnElement="W3193_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3193_Task6_di" bpmnElement="W3193_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3193_Task7_di" bpmnElement="W3193_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3193_Task8_di" bpmnElement="W3193_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
