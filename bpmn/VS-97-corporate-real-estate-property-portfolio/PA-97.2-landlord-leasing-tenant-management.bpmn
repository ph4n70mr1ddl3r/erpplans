    <bpmn:process id="W_W3198" name="W3198. Vacancy Marketing &amp; Space Commercialization" isExecutable="false">
      <bpmn:documentation>Trigger: Tenant notice of departure (W3199/exit); newly developed leasable space (W3188); persistent vacancy
Frequency: Event-driven
Volume: ~1–5% vacancy at any time across portfolio
Owner: Leasing Manager
Participants: Leasing Mgr, Marketing (links to VS-14), Property Mgr, Director, Facilities &amp; Real Estate, Broker
Source: workflow W3198 — Vacancy Marketing &amp; Space Commercialization</bpmn:documentation>
      <bpmn:laneSet id="W3198_LaneSet2">
        <bpmn:lane id="W3198_Lane1" name="Leasing Mgr">
        <bpmn:flowNodeRef>W3198_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3198_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3198_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3198_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3198_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3198_Start3" name="Tenant notice of departure (W3199/exit); newly developed leasable space (W3188)…">
        <bpmn:outgoing>W3198_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3198_Task4" name="Leasing Mgr/Marketing (links to VS-14) prepare vacancy marketing: space spec…">
        <bpmn:documentation>Step 1: Leasing Mgr/Marketing (links to VS-14) prepare vacancy marketing: space spec sheet, photos/render, demographics/traffic, asking rent, tenant-mix strategy, target tenant list; list with brokers and on commercial platforms
Responsible (R): Leasing Mgr / Marketing
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W3198_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3198_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3198_Task5" name="Leasing Mgr manage inquiries and tours: prospect qualification (links to VS-86…">
        <bpmn:documentation>Step 2: Leasing Mgr manage inquiries and tours: prospect qualification (links to VS-86 KYB), site tours, term sheets, negotiation; coordinate fit-out/permits for new tenant (links to W3194)
Responsible (R): Leasing Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Per prospect</bpmn:documentation>
        <bpmn:incoming>W3198_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3198_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3198_Task6" name="Track vacancy KPIs: physical vs economic vacancy, downtime (days vacant)…">
        <bpmn:documentation>Step 3: Track vacancy KPIs: physical vs economic vacancy, downtime (days vacant), leasing cost (TI + commission) per deal, concession cost; feed portfolio analytics (W3208) and capital plan (W3185)
Responsible (R): Leasing Mgr / Finance
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3198_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3198_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3198_End7" name="Complete">
        <bpmn:incoming>W3198_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3198_Annotation8">
        <bpmn:text>Controls: - CTL-521 (ensure controlled execution — Landlord Leasing Operations &amp; Tenant Management (PA-97.2).) | - operational: pre-emptive marketing before tenant exit and flexible interim uses; operational: deal-economics discipline
Owner: Leasing Manager</bpmn:text>
      </bpmn:textAnnotation>
