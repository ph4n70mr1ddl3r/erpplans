        <bpmndi:BPMNEdge id="W3193_Assoc11_di" bpmnElement="W3193_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3194" name="W3194. Commercial Tenant Acquisition &amp; Lease Origination" isExecutable="false">
      <bpmn:documentation>Trigger: Available leasable space (anchor, in-line, outlot/pad); third-party tenant inquiry
Frequency: Per vacancy
Volume: ~1–3 third-party tenants per store/property; ~200–600 third-party agreements chain-wide (overlaps W177 concessionaire scope for in-store)
Owner: Leasing Manager
Participants: Leasing Mgr, Director, Facilities &amp; Real Estate, Legal, Finance, Store Ops (links to VS-07), Tenant
Source: workflow W3194 — Commercial Tenant Acquisition &amp; Lease Origination</bpmn:documentation>
      <bpmn:laneSet id="W3194_LaneSet2">
        <bpmn:lane id="W3194_Lane1" name="Leasing Mgr">
        <bpmn:flowNodeRef>W3194_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3194_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3194_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3194_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3194_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3194_Start3" name="Available leasable space (anchor, in-line, outlot/pad); third-party tenant inquiry">
        <bpmn:outgoing>W3194_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3194_Task4" name="Leasing Mgr source and qualify tenants for outlot/pad/anchor space: tenant mix…">
        <bpmn:documentation>Step 1: Leasing Mgr source and qualify tenants for outlot/pad/anchor space: tenant mix strategy (banks, ATMs, food/beverage, courier drop-points, pharmacies — complementary, non-competing with BuildRight); tenant creditworthiness (links to VS-86 KYB/financial review), trade-mix fit, fit-out capability; align with Store Ops (links to VS-07) for site compatibility
Responsible (R): Leasing Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 4–12 weeks</bpmn:documentation>
        <bpmn:incoming>W3194_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3194_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3194_Task5" name="Negotiate commercial terms: base rent (fixed + percentage rent), CAM/utilities…">
        <bpmn:documentation>Step 2: Negotiate commercial terms: base rent (fixed + percentage rent), CAM/utilities recovery, term and options, tenant improvement allowance, co-tenancy/exclusivity clauses, use clause, assignment/subletting, insurance/indemnity (links to W3204); Legal drafts lease (links to VS-22 contract review)
Responsible (R): Leasing Mgr / Legal
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 3–8 weeks</bpmn:documentation>
        <bpmn:incoming>W3194_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3194_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3194_Task6" name="Onboard tenant: lease execution, rent commencement, build-out coordination and…">
        <bpmn:documentation>Step 3: Onboard tenant: lease execution, rent commencement, build-out coordination and permits (links to VS-22/VS-76), certificate of occupancy, rent deposit/security, insurance certificates, set up billing (W3195); integrate to property master (links to VS-29) and rent roll
Responsible (R): Leasing Mgr / Legal / Finance
Accountable (A): Director, Facilities &amp; Real Estate
Duration: 2–6 weeks</bpmn:documentation>
        <bpmn:incoming>W3194_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3194_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3194_End7" name="Complete">
        <bpmn:incoming>W3194_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3194_Annotation8">
        <bpmn:text>Controls: - CTL-521 (ensure controlled execution — Landlord Leasing Operations &amp; Tenant Management (PA-97.2).) | - operational: credit screening and security deposits (links to VS-86); operational: clear use clause and audit (W3196)
Owner: Leasing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3194_Assoc9" sourceRef="W3194_Annotation8" targetRef="W3194_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3194_Flow10" sourceRef="W3194_Start3" targetRef="W3194_Task4" />
      <bpmn:sequenceFlow id="W3194_Flow11" sourceRef="W3194_Task4" targetRef="W3194_Task5" />
      <bpmn:sequenceFlow id="W3194_Flow12" sourceRef="W3194_Task5" targetRef="W3194_Task6" />
      <bpmn:sequenceFlow id="W3194_Flow13" sourceRef="W3194_Task6" targetRef="W3194_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3194_diag">
      <bpmndi:BPMNPlane id="W3194_plane" bpmnElement="W_W3194">
        <bpmndi:BPMNShape id="W3194_Lane1_di" bpmnElement="W3194_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_Task4_di" bpmnElement="W3194_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_Task5_di" bpmnElement="W3194_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_Task6_di" bpmnElement="W3194_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_Start3_di" bpmnElement="W3194_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_End7_di" bpmnElement="W3194_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3194_Annotation8_di" bpmnElement="W3194_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3194_Flow10_di" bpmnElement="W3194_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3194_Flow11_di" bpmnElement="W3194_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3194_Flow12_di" bpmnElement="W3194_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3194_Flow13_di" bpmnElement="W3194_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3194_Assoc9_di" bpmnElement="W3194_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3195" name="W3195. Rent Billing, CAM Recovery &amp; Tenant Receivables" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly billing cycle
Frequency: Monthly
Volume: ~205+ intercompany leases + ~200–600 third-party tenant leases
Owner: Property AR Manager
Participants: Property AR Mgr, Lease Admin, Finance (links to VS-16/VS-17), Facilities (links to VS-20.3/W3205)
Source: workflow W3195 — Rent Billing, CAM Recovery &amp; Tenant Receivables</bpmn:documentation>
      <bpmn:laneSet id="W3195_LaneSet3">
        <bpmn:lane id="W3195_Lane1" name="Lease Admin">
        <bpmn:flowNodeRef>W3195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3195_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3195_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3195_Lane2" name="Finance Analyst">
        <bpmn:flowNodeRef>W3195_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3195_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3195_Start4" name="Monthly billing cycle">
        <bpmn:outgoing>W3195_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3195_Task5" name="Lease Admin/AR generate monthly rent roll billing: base rent (per…">
        <bpmn:documentation>Step 1: Lease Admin/AR generate monthly rent roll billing: base rent (per lease/escalation schedule W3197), CAM recovery (actual vs estimated — reconcile annually), utility recharges (sub-metered electricity/water per W1563/W701 where applicable), percentage rent (sales-based where applicable, requires tenant sales reporting); issue invoices (e-invoicing/BIR compliance links to VS-79)
Responsible (R): Lease Admin / AR Clerk
Accountable (A): Property AR Manager
Duration: 2–3 days/cycle</bpmn:documentation>
        <bpmn:incoming>W3195_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3195_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3195_Task6" name="Finance post lessor revenue (operating-lease income straight-lined per PFRS 16…">
        <bpmn:documentation>Step 2: Finance post lessor revenue (operating-lease income straight-lined per PFRS 16; intercompany rent eliminated on consolidation per VS-17.2); manage tenant receivables aging, dunning, and allocation (links to VS-16.2 AR/collections methodology); segregate intercompany from third-party for consolidation
Responsible (R): Finance Analyst / AR Clerk
Accountable (A): Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3195_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3195_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3195_Task7" name="Annually reconcile estimated vs actual CAM/utilities: compute each tenant&#x27;s…">
        <bpmn:documentation>Step 3: Annually reconcile estimated vs actual CAM/utilities: compute each tenant&#x27;s pro-rata share of recoverable operating expenses (excluding landlord-responsibility items), issue CAM reconciliation statement, true-up via credit/charge (mirrors BuildRight-as-tenant CAM reconciliation in VS-20.1 W1183 but from the landlord side); document dispute resolution
Responsible (R): Lease Admin / Finance
Accountable (A): Property AR Manager
Duration: 6–10 weeks/annual cycle</bpmn:documentation>
        <bpmn:incoming>W3195_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3195_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3195_End8" name="Complete">
        <bpmn:incoming>W3195_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3195_Annotation9">
        <bpmn:text>Controls: - CTL-134 (ensure property income &amp; LGU tax compliance (as owner).) | - operational: transparent CAM ledger and lease-defined recoveries; operational: deposits, dunning (links to VS-16)
Owner: Property AR Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3195_Assoc10" sourceRef="W3195_Annotation9" targetRef="W3195_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3195_Flow11" sourceRef="W3195_Start4" targetRef="W3195_Task5" />
      <bpmn:sequenceFlow id="W3195_Flow12" sourceRef="W3195_Task5" targetRef="W3195_Task6" />
      <bpmn:sequenceFlow id="W3195_Flow13" sourceRef="W3195_Task6" targetRef="W3195_Task7" />
      <bpmn:sequenceFlow id="W3195_Flow14" sourceRef="W3195_Task7" targetRef="W3195_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3195_diag">
      <bpmndi:BPMNPlane id="W3195_plane" bpmnElement="W_W3195">
        <bpmndi:BPMNShape id="W3195_Lane1_di" bpmnElement="W3195_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Lane2_di" bpmnElement="W3195_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Task5_di" bpmnElement="W3195_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Task6_di" bpmnElement="W3195_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Task7_di" bpmnElement="W3195_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Start4_di" bpmnElement="W3195_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_End8_di" bpmnElement="W3195_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3195_Annotation9_di" bpmnElement="W3195_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3195_Flow11_di" bpmnElement="W3195_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3195_Flow12_di" bpmnElement="W3195_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3195_Flow13_di" bpmnElement="W3195_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3195_Flow14_di" bpmnElement="W3195_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3195_Assoc10_di" bpmnElement="W3195_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3196" name="W3196. Tenant Service, Maintenance &amp; Relationship Management" isExecutable="false">
      <bpmn:documentation>Trigger: Tenant request; scheduled service; relationship cycle
Frequency: Continuous + quarterly reviews
Volume: ~200–600 third-party tenant relationships
Owner: Property Manager
Participants: Property Mgr, Facilities (links to VS-20.3/W3205), Leasing Mgr, Store Ops (links to VS-07), Tenant
Source: workflow W3196 — Tenant Service, Maintenance &amp; Relationship Management</bpmn:documentation>
      <bpmn:laneSet id="W3196_LaneSet2">
        <bpmn:lane id="W3196_Lane1" name="Property Mgr">
        <bpmn:flowNodeRef>W3196_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3196_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3196_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3196_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3196_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3196_Start3" name="Tenant request; scheduled service; relationship cycle">
        <bpmn:outgoing>W3196_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3196_Task4" name="Property Mgr/Facilities manage tenant service requests: maintenance of…">
        <bpmn:documentation>Step 1: Property Mgr/Facilities manage tenant service requests: maintenance of landlord-provided systems (structural, roof, parking, shared utilities, common areas), triage by urgency and lease-responsibility split, dispatch vendor or facilities team (links to VS-20.3); track SLA and tenant satisfaction
Responsible (R): Property Mgr / Facilities
Accountable (A): Property Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W3196_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3196_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3196_Task5" name="Property Mgr conduct periodic tenant relationship reviews: occupancy…">
        <bpmn:documentation>Step 2: Property Mgr conduct periodic tenant relationship reviews: occupancy experience, fit-out/alteration requests, sales performance (for percentage-rent tenants), expansion/downsizing needs, renewal intent (links to W3197); document and route opportunities to Leasing
Responsible (R): Property Mgr / Leasing Mgr
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3196_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3196_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3196_Task6" name="Property Mgr enforce lease compliance: use clause, operating hours, signage…">
        <bpmn:documentation>Step 3: Property Mgr enforce lease compliance: use clause, operating hours, signage, house rules, insurance certificates current (links to W3204), Alteration/fit-out approval; coordinate joint inspections; manage disputes before escalation to W3199
Responsible (R): Property Mgr / Legal
Accountable (A): Director, Facilities &amp; Real Estate
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3196_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3196_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3196_End7" name="Complete">
        <bpmn:incoming>W3196_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3196_Annotation8">
        <bpmn:text>Controls: - CTL-521 (ensure controlled execution — Landlord Leasing Operations &amp; Tenant Management (PA-97.2).) | - operational: alteration-approval and inspection program; operational: SLA and relationship reviews
Owner: Property Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3196_Assoc9" sourceRef="W3196_Annotation8" targetRef="W3196_Start3" associationDirection="None" />
