        <bpmn:outgoing>W4709_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4709_Task5" name="Manage the director&#x27;s residency/tax status (resident vs. non-resident…">
        <bpmn:documentation>Step 2: Manage the director&#x27;s residency/tax status (resident vs. non-resident director), per-diem/compensation structuring (VS-102), and SEC-related foreign-ownership/sector restrictions where applicable
Responsible (R): Immigration Operations / Tax / Legal / Comp
Accountable (A): VP Legal / CFO
Duration: Per appointment</bpmn:documentation>
        <bpmn:incoming>W4709_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4709_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4709_Task6" name="Retain records (VS-88); manage renewals and exit; ensure board-meeting…">
        <bpmn:documentation>Step 3: Retain records (VS-88); manage renewals and exit; ensure board-meeting attendance (in-person or via the foreign director&#x27;s valid status) doesn&#x27;t breach immigration rules
Responsible (R): Immigration Operations / Corp Secretary
Accountable (A): Head of Global Mobility / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4709_Flow12</bpmn:incoming>
      </bpmn:userTask>
