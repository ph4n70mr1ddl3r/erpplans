<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-160.2-immigration-visa-and-foreign-worker-compliance-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4705" name="W4705. DOLE Alien Employment Permit (AEP) Application &amp; Renewal Operations" isExecutable="false">
      <bpmn:documentation>Trigger: New foreign hire; AEP expiry (annual/biennial); role change
Frequency: Per foreign worker + renewal cycle
Volume: ~15–25 active foreign workers needing AEP across the 5 entities (seconded experts per VS-122, executives)
Owner: Immigration Operations Lead
Participants: HR (VS-19), hiring manager, Legal (VS-100.3), DOLE Regional Office, immigration agent (W4700)
Source: workflow W4705 — DOLE Alien Employment Permit (AEP) Application &amp; Renewal Operations</bpmn:documentation>
      <bpmn:laneSet id="W4705_LaneSet2">
        <bpmn:lane id="W4705_Lane1" name="Immigration Operations">
        <bpmn:flowNodeRef>W4705_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4705_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4705_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4705_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4705_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4705_Start3" name="New foreign hire; AEP expiry (annual/biennial); role change">
        <bpmn:outgoing>W4705_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4705_Task4" name="Prepare and file the DOLE AEP application: proof of the foreign worker&#x27;s…">
        <bpmn:documentation>Step 1: Prepare and file the DOLE AEP application: proof of the foreign worker&#x27;s qualifications, the justification for hiring a foreign national (no available qualified Filipino — DOLE requirement), the position, and the employer&#x27;s documents; engage the DOLE Regional Office (via immigration agent W4700)
Responsible (R): Immigration Operations / HR / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4705_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4705_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4705_Task5" name="Track the AEP issuance and conditions (validity, role/entity scope); file…">
        <bpmn:documentation>Step 2: Track the AEP issuance and conditions (validity, role/entity scope); file renewals before expiry per the compliance calendar (W4703); manage AEP conditions (role/entity changes require amendment)
Responsible (R): Immigration Operations
Accountable (A): Head of Global Mobility
Duration: Per renewal</bpmn:documentation>
        <bpmn:incoming>W4705_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4705_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4705_Task6" name="Retain AEP records (VS-88); support DOLE inspection/audit (W4711) and ensure…">
        <bpmn:documentation>Step 3: Retain AEP records (VS-88); support DOLE inspection/audit (W4711) and ensure the foreign worker does not commence productive work before AEP issuance (compliance)
Responsible (R): Immigration Operations / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4705_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4705_End7" name="Complete">
        <bpmn:incoming>W4705_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4705_Annotation8">
        <bpmn:text>Controls: - CTL-130 (ensure immigration &amp; foreign-worker compliance.) | - CTL-711: AEP justification documented; no work before AEP; renewals before expiry (compliance calendar)
Owner: Immigration Operations Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4705_Assoc9" sourceRef="W4705_Annotation8" targetRef="W4705_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4705_Flow10" sourceRef="W4705_Start3" targetRef="W4705_Task4" />
      <bpmn:sequenceFlow id="W4705_Flow11" sourceRef="W4705_Task4" targetRef="W4705_Task5" />
      <bpmn:sequenceFlow id="W4705_Flow12" sourceRef="W4705_Task5" targetRef="W4705_Task6" />
      <bpmn:sequenceFlow id="W4705_Flow13" sourceRef="W4705_Task6" targetRef="W4705_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4705_diag">
      <bpmndi:BPMNPlane id="W4705_plane" bpmnElement="W_W4705">
        <bpmndi:BPMNShape id="W4705_Lane1_di" bpmnElement="W4705_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_Task4_di" bpmnElement="W4705_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_Task5_di" bpmnElement="W4705_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_Task6_di" bpmnElement="W4705_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_Start3_di" bpmnElement="W4705_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_End7_di" bpmnElement="W4705_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4705_Annotation8_di" bpmnElement="W4705_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4705_Flow10_di" bpmnElement="W4705_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4705_Flow11_di" bpmnElement="W4705_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4705_Flow12_di" bpmnElement="W4705_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4705_Flow13_di" bpmnElement="W4705_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4705_Assoc9_di" bpmnElement="W4705_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4706" name="W4706. Bureau of Immigration 9G Pre-Arranged Employee Visa &amp; ACR I-Card Processing" isExecutable="false">
      <bpmn:documentation>Trigger: AEP issuance (W4705); visa/I-Card expiry; entry/exit
Frequency: Per foreign worker + renewal
Volume: ~15–25 active 9G visa holders (the W4705 AEP population)
Owner: Immigration Operations Lead
Participants: HR (VS-19), Legal (VS-100.3), BI, immigration agent (W4700), foreign worker
Source: workflow W4706 — Bureau of Immigration 9G Pre-Arranged Employee Visa &amp; ACR I-Card Processing</bpmn:documentation>
      <bpmn:laneSet id="W4706_LaneSet2">
        <bpmn:lane id="W4706_Lane1" name="Immigration Operations">
        <bpmn:flowNodeRef>W4706_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4706_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4706_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4706_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4706_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4706_Start3" name="AEP issuance (W4705); visa/I-Card expiry; entry/exit">
        <bpmn:outgoing>W4706_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4706_Task4" name="On AEP issuance (W4705), file the BI 9G Pre-Arranged Employee Commercial Visa…">
        <bpmn:documentation>Step 1: On AEP issuance (W4705), file the BI 9G Pre-Arranged Employee Commercial Visa and ACR I-Card application (with the employment contract, AEP, and supporting documents); manage the foreign worker&#x27;s entry/visa status (downgrading/conversion from tourist/9a where applicable)
Responsible (R): Immigration Operations / Agent / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4706_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4706_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4706_Task5" name="Track visa/I-Card validity, conditions, and entry/exit; file renewals before…">
        <bpmn:documentation>Step 2: Track visa/I-Card validity, conditions, and entry/exit; file renewals before expiry (W4703); manage exit-clearing (Emigration Clearance Certificate / SSDC where applicable) on assignment end (W4718)
Responsible (R): Immigration Operations
Accountable (A): Head of Global Mobility
Duration: Per renewal + exit</bpmn:documentation>
        <bpmn:incoming>W4706_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4706_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4706_Task6" name="Retain visa/I-Card records (VS-88); support BI audit (W4711); ensure no…">
        <bpmn:documentation>Step 3: Retain visa/I-Card records (VS-88); support BI audit (W4711); ensure no overstay (BI penalty, deportation, officer liability)
Responsible (R): Immigration Operations / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4706_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4706_End7" name="Complete">
        <bpmn:incoming>W4706_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4706_Annotation8">
        <bpmn:text>Controls: - CTL-711 (ensure controlled execution — Immigration, Visa &amp; Foreign-Worker Compliance Operations (PA-160.2).) | - CTL-711: 9G/I-Card secured before productive work; renewals before expiry; no overstay (compliance calendar)
Owner: Immigration Operations Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4706_Assoc9" sourceRef="W4706_Annotation8" targetRef="W4706_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4706_Flow10" sourceRef="W4706_Start3" targetRef="W4706_Task4" />
      <bpmn:sequenceFlow id="W4706_Flow11" sourceRef="W4706_Task4" targetRef="W4706_Task5" />
      <bpmn:sequenceFlow id="W4706_Flow12" sourceRef="W4706_Task5" targetRef="W4706_Task6" />
      <bpmn:sequenceFlow id="W4706_Flow13" sourceRef="W4706_Task6" targetRef="W4706_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4706_diag">
      <bpmndi:BPMNPlane id="W4706_plane" bpmnElement="W_W4706">
        <bpmndi:BPMNShape id="W4706_Lane1_di" bpmnElement="W4706_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_Task4_di" bpmnElement="W4706_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_Task5_di" bpmnElement="W4706_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_Task6_di" bpmnElement="W4706_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_Start3_di" bpmnElement="W4706_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_End7_di" bpmnElement="W4706_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4706_Annotation8_di" bpmnElement="W4706_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4706_Flow10_di" bpmnElement="W4706_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4706_Flow11_di" bpmnElement="W4706_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4706_Flow12_di" bpmnElement="W4706_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4706_Flow13_di" bpmnElement="W4706_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4706_Assoc9_di" bpmnElement="W4706_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4707" name="W4707. Special Work Permit (SWP), Treaty-Trader (9D) &amp; Other Visa Category Selection" isExecutable="false">
      <bpmn:documentation>Trigger: Short-term/specialized foreign-worker need; treaty-based engagement
Frequency: Per case
Volume: ~5–10 cases/year (short-term experts, treaty-based assignees, CAI commercial-arrangement cases)
Owner: Immigration Operations Lead
Participants: HR (VS-19), Legal (VS-100.3), Tax (VS-79), hiring manager, BI
Source: workflow W4707 — Special Work Permit (SWP), Treaty-Trader (9D) &amp; Other Visa Category Selection</bpmn:documentation>
      <bpmn:laneSet id="W4707_LaneSet2">
        <bpmn:lane id="W4707_Lane1" name="Immigration Operations">
        <bpmn:flowNodeRef>W4707_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4707_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4707_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4707_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4707_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4707_Start3" name="Short-term/specialized foreign-worker need; treaty-based engagement">
        <bpmn:outgoing>W4707_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4707_Task4" name="Select the appropriate immigration category for each case: Special Work Permit…">
        <bpmn:documentation>Step 1: Select the appropriate immigration category for each case: Special Work Permit (SWP) for short-term specialized work (&lt;6 months); Treaty-Trader/Investor (9D) where a qualifying treaty/business exists; 9G for standard employment; Special Visa for Employment Generation (SVEG) where applicable
Responsible (R): Immigration Operations / Legal / Tax
Accountable (A): Head of Global Mobility / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4707_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4707_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4707_Task5" name="File and track the chosen category with its specific documents, conditions, and…">
        <bpmn:documentation>Step 2: File and track the chosen category with its specific documents, conditions, and tax implications (category affects residency/tax treatment W4714); manage transitions between categories
Responsible (R): Immigration Operations / Agent
Accountable (A): Head of Global Mobility
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4707_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4707_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4707_Task6" name="Document the category-selection rationale (avoid category-shopping that…">
        <bpmn:documentation>Step 3: Document the category-selection rationale (avoid category-shopping that misrepresents the engagement); retain records (VS-88); support audit (W4711)
Responsible (R): Immigration Operations / Legal
Accountable (A): Head of Global Mobility / VP Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4707_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4707_End7" name="Complete">
        <bpmn:incoming>W4707_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4707_Annotation8">
        <bpmn:text>Controls: - CTL-130 (ensure immigration &amp; foreign-worker compliance.) | - CTL-711: category-selection rationale documented; category fits actual engagement; tax-treatment aligned (W4714)
Owner: Immigration Operations Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4707_Assoc9" sourceRef="W4707_Annotation8" targetRef="W4707_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4707_Flow10" sourceRef="W4707_Start3" targetRef="W4707_Task4" />
      <bpmn:sequenceFlow id="W4707_Flow11" sourceRef="W4707_Task4" targetRef="W4707_Task5" />
      <bpmn:sequenceFlow id="W4707_Flow12" sourceRef="W4707_Task5" targetRef="W4707_Task6" />
      <bpmn:sequenceFlow id="W4707_Flow13" sourceRef="W4707_Task6" targetRef="W4707_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4707_diag">
      <bpmndi:BPMNPlane id="W4707_plane" bpmnElement="W_W4707">
        <bpmndi:BPMNShape id="W4707_Lane1_di" bpmnElement="W4707_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_Task4_di" bpmnElement="W4707_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_Task5_di" bpmnElement="W4707_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_Task6_di" bpmnElement="W4707_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_Start3_di" bpmnElement="W4707_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_End7_di" bpmnElement="W4707_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4707_Annotation8_di" bpmnElement="W4707_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4707_Flow10_di" bpmnElement="W4707_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4707_Flow11_di" bpmnElement="W4707_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4707_Flow12_di" bpmnElement="W4707_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4707_Flow13_di" bpmnElement="W4707_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4707_Assoc9_di" bpmnElement="W4707_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4708" name="W4708. Sourcing-Agent, Secondment &amp; Intra-Company Transferee Immigration" isExecutable="false">
      <bpmn:documentation>Trigger: Sourcing agent/seconded expert need (VS-122); intra-group transferee
Frequency: Per case
Volume: ~10–20 cases/year (sourcing secondees, intra-5-entity transferees)
Owner: Immigration Operations Lead
Participants: Global Sourcing (VS-122), Legal (VS-100.3), Tax (VS-79/VS-17.2), HR (VS-19), home-country employer
Source: workflow W4708 — Sourcing-Agent, Secondment &amp; Intra-Company Transferee Immigration</bpmn:documentation>
      <bpmn:laneSet id="W4708_LaneSet2">
        <bpmn:lane id="W4708_Lane1" name="Immigration Operations">
        <bpmn:flowNodeRef>W4708_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4708_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4708_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4708_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4708_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4708_Start3" name="Sourcing agent/seconded expert need (VS-122); intra-group transferee">
        <bpmn:outgoing>W4708_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4708_Task4" name="For sourcing agents/secondees (VS-122) and intra-company transferees, structure…">
        <bpmn:documentation>Step 1: For sourcing agents/secondees (VS-122) and intra-company transferees, structure the immigration (AEP W4705 + 9G/I-Card W4706 or SWP) and the secondment/transfer agreement (home employer, host entity VS-72, duration, cost allocation)
Responsible (R): Immigration Operations / Legal / Sourcing / Tax
Accountable (A): Head of Global Mobility / VP Legal / VP Supply Chain
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4708_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4708_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4708_Task5" name="Manage transfer-pricing/cost-allocation of the secondment (home-country cost +…">
        <bpmn:documentation>Step 2: Manage transfer-pricing/cost-allocation of the secondment (home-country cost + markup, per VS-17.2 TP) and the immigration status during secondment; coordinate with home-country employer
Responsible (R): Immigration Operations / Tax / Treasury
Accountable (A): Head of Global Mobility / CFO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4708_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4708_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4708_Task6" name="Retain secondment/transfer and immigration records (VS-88); manage secondment…">
        <bpmn:documentation>Step 3: Retain secondment/transfer and immigration records (VS-88); manage secondment extension, conversion to localization (W4718), or return
Responsible (R): Immigration Operations / Legal
Accountable (A): Head of Global Mobility
Duration: Per lifecycle</bpmn:documentation>
