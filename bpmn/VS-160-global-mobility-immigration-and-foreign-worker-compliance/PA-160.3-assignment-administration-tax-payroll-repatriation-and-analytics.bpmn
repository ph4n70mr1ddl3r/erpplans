    <bpmn:process id="W_W4714" name="W4714. Assignment Tax: Resident/Non-Resident, Tax-Treaty, 19-Series &amp; Equalization" isExecutable="false">
      <bpmn:documentation>Trigger: Assignment start/each tax year; tax filing; residency change
Frequency: Per tax year + per filing
Volume: ~15–25 active assignees&#x27; tax positions
Owner: Mobility Tax Manager / Tax (VS-79)
Participants: Tax (VS-79), Payroll (VS-19.2), Treasury (VS-18), assignment-tax vendor, foreign worker, BIR
Source: workflow W4714 — Assignment Tax: Resident/Non-Resident, Tax-Treaty, 19-Series &amp; Equalization</bpmn:documentation>
      <bpmn:laneSet id="W4714_LaneSet2">
        <bpmn:lane id="W4714_Lane1" name="Mobility Tax Manager">
        <bpmn:flowNodeRef>W4714_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4714_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4714_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4714_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4714_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4714_Start3" name="Assignment start/each tax year; tax filing; residency change">
        <bpmn:outgoing>W4714_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4714_Task4" name="Determine each assignee&#x27;s tax residency (Philippine resident vs. non-resident…">
        <bpmn:documentation>Step 1: Determine each assignee&#x27;s tax residency (Philippine resident vs. non-resident; home-country residency), apply tax-treaty relief where applicable, and the 19-series (final withholding on non-residents) vs. regular graduated tax treatment
Responsible (R): Mobility Tax Manager / Tax
Accountable (A): VP Tax / CFO
Duration: Per tax year</bpmn:documentation>
        <bpmn:incoming>W4714_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4714_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4714_Task5" name="Operate tax-equalization (the assignee bears home-country tax as if at home…">
        <bpmn:documentation>Step 2: Operate tax-equalization (the assignee bears home-country tax as if at home; BuildRight bears/recoveres the host-country up/downside) or tax-protection per policy (W4697); compute the equalization settlement annually
Responsible (R): Mobility Tax Manager / Payroll
Accountable (A): VP Tax / CFO
Duration: Annual + per cycle</bpmn:documentation>
        <bpmn:incoming>W4714_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4714_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4714_Task6" name="File the assignee&#x27;s Philippine tax (BIR — resident or 19-series non-resident…">
        <bpmn:documentation>Step 3: File the assignee&#x27;s Philippine tax (BIR — resident or 19-series non-resident W4715) and coordinate home-country filing/relief; retain tax records (VS-88) and support BIR audit (VS-79)
Responsible (R): Mobility Tax Manager / Tax
Accountable (A): VP Tax / CFO
Duration: Per filing + audit</bpmn:documentation>
        <bpmn:incoming>W4714_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4714_End7" name="Complete">
        <bpmn:incoming>W4714_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4714_Annotation8">
        <bpmn:text>Controls: - CTL-712 (ensure controlled execution — Assignment Administration, Tax/Payroll, Repatriation &amp; Analytics (PA-160.3).) | - CTL-712: residency/treaty determined (Tax-led); equalization per policy; filings and records retained (VS-88)
Owner: Mobility Tax Manager / Tax (VS-79)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4714_Assoc9" sourceRef="W4714_Annotation8" targetRef="W4714_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4714_Flow10" sourceRef="W4714_Start3" targetRef="W4714_Task4" />
      <bpmn:sequenceFlow id="W4714_Flow11" sourceRef="W4714_Task4" targetRef="W4714_Task5" />
      <bpmn:sequenceFlow id="W4714_Flow12" sourceRef="W4714_Task5" targetRef="W4714_Task6" />
      <bpmn:sequenceFlow id="W4714_Flow13" sourceRef="W4714_Task6" targetRef="W4714_End7" />
    </bpmn:process>
