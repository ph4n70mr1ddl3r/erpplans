      <bpmn:sequenceFlow id="W4297_Flow12" sourceRef="W4297_Task5" targetRef="W4297_Task6" />
      <bpmn:sequenceFlow id="W4297_Flow13" sourceRef="W4297_Task6" targetRef="W4297_Task7" />
      <bpmn:sequenceFlow id="W4297_Flow14" sourceRef="W4297_Task7" targetRef="W4297_End8" />
    </bpmn:process>
