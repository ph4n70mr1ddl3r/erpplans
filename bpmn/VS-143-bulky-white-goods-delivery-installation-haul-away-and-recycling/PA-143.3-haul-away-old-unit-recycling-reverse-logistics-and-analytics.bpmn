      <bpmndi:BPMNPlane id="W4307_plane" bpmnElement="W_W4307">
        <bpmndi:BPMNShape id="W4307_Lane1_di" bpmnElement="W4307_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
