      <bpmndi:BPMNPlane id="W4306_plane" bpmnElement="W_W4306">
        <bpmndi:BPMNShape id="W4306_Lane1_di" bpmnElement="W4306_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
