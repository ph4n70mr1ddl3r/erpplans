    <bpmn:process id="W_W4305" name="W4305. Old-Appliance Haul-Away Policy, Eligibility &amp; Customer Consent" isExecutable="false">
      <bpmn:documentation>Trigger: Bulky order with haul-away-eligible item (W4292); customer requests haul-away
Frequency: Per haul-away-eligible bulky order
Volume: Haul-away-eligible orders (appliances, large furniture) × opt-in rate
Owner: Bulky-Delivery Service Ops / Commercial / Sustainability (VS-25)
Participants: Ecommerce (VS-10), Trade (VS-11), Customer Service (VS-13), Compliance (VS-114), HSE (VS-24)
Source: workflow W4305 — Old-Appliance Haul-Away Policy, Eligibility &amp; Customer Consent</bpmn:documentation>
      <bpmn:laneSet id="W4305_LaneSet4">
        <bpmn:lane id="W4305_Lane1" name="Commercial">
        <bpmn:flowNodeRef>W4305_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4305_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4305_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W4305_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4305_Lane3" name="Crew">
        <bpmn:flowNodeRef>W4305_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4305_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4305_Start5" name="Bulky order with haul-away-eligible item (W4292); customer requests haul-away">
        <bpmn:outgoing>W4305_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4305_Task6" name="Commercial/Sustainability set the haul-away policy — eligibility (1-for-1 on…">
        <bpmn:documentation>Step 1: Commercial/Sustainability set the haul-away policy — eligibility (1-for-1 on like-category new purchase), accepted condition, exclusions (e.g. biohazard/heavily-infested, oversized non-appliance), fee/subsidy, and customer-consent/data-clearing requirement
Responsible (R): Commercial / Sustainability / Service Ops
Accountable (A): COO / Sustainability Lead
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4305_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4305_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4305_Task7" name="Order capture offers haul-away at purchase (VS-10/VS-11), captures customer…">
        <bpmn:documentation>Step 2: Order capture offers haul-away at purchase (VS-10/VS-11), captures customer consent + item description (type/age/condition, refrigerant flag), and books it onto the delivery manifest (W4297)
Responsible (R): Ecommerce / Trade / Service Ops
Accountable (A): Service Mgr
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4305_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4305_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4305_Task8" name="Crew execute haul-away at delivery (W4298) — verify the old unit matches…">
        <bpmn:documentation>Step 3: Crew execute haul-away at delivery (W4298) — verify the old unit matches consent, ensure data-bearing devices are data-cleared per consent, and load for reverse logistics (W4308)
Responsible (R): Crew
Accountable (A): Crew Lead
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W4305_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4305_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4305_End9" name="Complete">
        <bpmn:incoming>W4305_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4305_Annotation10">
        <bpmn:text>Controls: - CTL-661 (ensure controlled execution — Haul-Away, Old-Unit Recycling, Reverse Logistics &amp; Analytics (PA-143.3).) | - CTL-661: haul-away consent captured &amp; verified on-site; eligibility enforced; data-clearing on data-bearing devices (VS-91)
Owner: Bulky-Delivery Service Ops / Commercial / Sustainability (VS-25)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4305_Assoc11" sourceRef="W4305_Annotation10" targetRef="W4305_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4305_Flow12" sourceRef="W4305_Start5" targetRef="W4305_Task6" />
      <bpmn:sequenceFlow id="W4305_Flow13" sourceRef="W4305_Task6" targetRef="W4305_Task7" />
      <bpmn:sequenceFlow id="W4305_Flow14" sourceRef="W4305_Task7" targetRef="W4305_Task8" />
      <bpmn:sequenceFlow id="W4305_Flow15" sourceRef="W4305_Task8" targetRef="W4305_End9" />
    </bpmn:process>
