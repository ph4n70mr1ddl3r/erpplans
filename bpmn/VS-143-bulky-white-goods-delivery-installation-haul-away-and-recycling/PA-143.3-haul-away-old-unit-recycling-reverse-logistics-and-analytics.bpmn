    <bpmn:process id="W_W4307" name="W4307. E-Waste, Scrap Metal &amp; Appliance Recycling/Disposition" isExecutable="false">
      <bpmn:documentation>Trigger: Hauled-away old units consolidated for disposition
Frequency: Continuous consolidation + periodic disposition
Volume: Hauled-away appliance/e-waste/furniture units
Owner: Bulky-Delivery Reverse Logistics / Sustainability (VS-25) / Waste (VS-73)
Participants: Reverse Logistics (VS-32), DENR-accredited recycler/vendor, Compliance (VS-114), ESG (VS-25), Finance (VS-17.4)
Source: workflow W4307 — E-Waste, Scrap Metal &amp; Appliance Recycling/Disposition</bpmn:documentation>
      <bpmn:laneSet id="W4307_LaneSet3">
        <bpmn:lane id="W4307_Lane1" name="Reverse Logistics">
        <bpmn:flowNodeRef>W4307_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4307_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4307_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4307_Lane2" name="ESG">
        <bpmn:flowNodeRef>W4307_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4307_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4307_Start4" name="Hauled-away old units consolidated for disposition">
        <bpmn:outgoing>W4307_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4307_Task5" name="Reverse Logistics/Sustainability classify each hauled unit for disposition —…">
        <bpmn:documentation>Step 1: Reverse Logistics/Sustainability classify each hauled unit for disposition — refurb/resale (W4311), parts-harvest, scrap-metal recovery, e-waste (RA 6969/DENR), or responsible disposal — by type/condition
Responsible (R): Reverse Logistics / Sustainability
Accountable (A): Service Mgr / Sustainability Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4307_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4307_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4307_Task6" name="Reverse Logistics route to the right channel — accredited e-waste recycler…">
        <bpmn:documentation>Step 2: Reverse Logistics route to the right channel — accredited e-waste recycler (DENR), scrap-metal partner, refurb partner — and process via W4308 consolidation
Responsible (R): Reverse Logistics / Vendor Mgmt
Accountable (A): Service Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4307_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4307_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4307_Task7" name="ESG/Finance capture recovery value (scrap/refurb/parts), disposal cost, and the…">
        <bpmn:documentation>Step 3: ESG/Finance capture recovery value (scrap/refurb/parts), disposal cost, and the recycling/landfill-diversion outcome for ESG reporting (VS-25) and program economics (W4310)
Responsible (R): ESG / Finance
Accountable (A): Sustainability Lead / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4307_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4307_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4307_End8" name="Complete">
        <bpmn:incoming>W4307_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4307_Annotation9">
        <bpmn:text>Controls: - CTL-661 (ensure controlled execution — Haul-Away, Old-Unit Recycling, Reverse Logistics &amp; Analytics (PA-143.3).) | - CTL-661: e-waste to DENR-accredited recycler; disposition classified; recovery/diversion documented (VS-25)
Owner: Bulky-Delivery Reverse Logistics / Sustainability (VS-25) / Waste (VS-73)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4307_Assoc10" sourceRef="W4307_Annotation9" targetRef="W4307_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4307_Flow11" sourceRef="W4307_Start4" targetRef="W4307_Task5" />
      <bpmn:sequenceFlow id="W4307_Flow12" sourceRef="W4307_Task5" targetRef="W4307_Task6" />
      <bpmn:sequenceFlow id="W4307_Flow13" sourceRef="W4307_Task6" targetRef="W4307_Task7" />
      <bpmn:sequenceFlow id="W4307_Flow14" sourceRef="W4307_Task7" targetRef="W4307_End8" />
    </bpmn:process>
