    <bpmn:process id="W_W4306" name="W4306. Refrigerant Recovery, ODS/RA 8749 &amp; DENR-Compliant Appliance Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Haul-away of refrigerant-bearing appliance (refrigerator, freezer, AC, water cooler)
Frequency: Per refrigerant-bearing haul-away
Volume: Refrigerant-bearing haul-aways (subset of appliance haul-aways)
Owner: Bulky-Delivery Service Ops / HSE (VS-24) / Compliance (VS-114)
Participants: Licensed Installer (W4293), DENR-accredited recycler, Compliance (VS-114), ESG (VS-25), Risk (VS-21.2)
Source: workflow W4306 — Refrigerant Recovery, ODS/RA 8749 &amp; DENR-Compliant Appliance Handling</bpmn:documentation>
      <bpmn:laneSet id="W4306_LaneSet4">
        <bpmn:lane id="W4306_Lane1" name="HSE">
        <bpmn:flowNodeRef>W4306_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4306_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4306_Lane2" name="Recovery Tech">
        <bpmn:flowNodeRef>W4306_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4306_Lane3" name="Compliance">
        <bpmn:flowNodeRef>W4306_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4306_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4306_Start5" name="Haul-away of refrigerant-bearing appliance (refrigerator, freezer, AC, water cooler)">
        <bpmn:outgoing>W4306_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4306_Task6" name="HSE/Compliance set the ODS (ozone-depleting substance / RA 8749 Clean Air Act)…">
        <bpmn:documentation>Step 1: HSE/Compliance set the ODS (ozone-depleting substance / RA 8749 Clean Air Act) handling standard — recover (not vent) refrigerant at removal, use certified recovery equipment, route only to DENR-accredited recyclers
Responsible (R): HSE / Compliance
Accountable (A): HSE Mgr / Compliance Lead
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4306_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4306_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4306_Task7" name="Licensed crew/recovery-tech recover refrigerant on removal (split-AC…">
        <bpmn:documentation>Step 2: Licensed crew/recovery-tech recover refrigerant on removal (split-AC de-install, fridge compressor), label/tag the recovered charge, and document quantity/type
Responsible (R): Recovery Tech / Installer
Accountable (A): Crew Lead / HSE
Duration: Per unit</bpmn:documentation>
        <bpmn:incoming>W4306_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4306_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4306_Task8" name="Compliance/ESG verify the recovered unit + refrigerant is delivered to a…">
        <bpmn:documentation>Step 3: Compliance/ESG verify the recovered unit + refrigerant is delivered to a DENR-accredited recycler (W4307/W4308), retain the chain-of-custody record, and report ODS recovery for ESG (VS-25)
Responsible (R): Compliance / ESG
Accountable (A): Compliance Lead
Duration: Per unit</bpmn:documentation>
        <bpmn:incoming>W4306_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4306_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4306_End9" name="Complete">
        <bpmn:incoming>W4306_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4306_Annotation10">
        <bpmn:text>Controls: - CTL-81 (ensure bulky delivery compliance &amp; e-POD closure.) | - CTL-661: refrigerant recovered not vented (RA 8749); licensed handler (W4293); accredited-recycler routing; chain-of-custody retained
Owner: Bulky-Delivery Service Ops / HSE (VS-24) / Compliance (VS-114)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4306_Assoc11" sourceRef="W4306_Annotation10" targetRef="W4306_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4306_Flow12" sourceRef="W4306_Start5" targetRef="W4306_Task6" />
      <bpmn:sequenceFlow id="W4306_Flow13" sourceRef="W4306_Task6" targetRef="W4306_Task7" />
      <bpmn:sequenceFlow id="W4306_Flow14" sourceRef="W4306_Task7" targetRef="W4306_Task8" />
      <bpmn:sequenceFlow id="W4306_Flow15" sourceRef="W4306_Task8" targetRef="W4306_End9" />
    </bpmn:process>
