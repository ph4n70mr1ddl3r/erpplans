<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-143.1-bulky-delivery-network-scheduling-and-capacity" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4289" name="W4289. Bulky &amp; White-Goods Delivery Program Strategy, Channel Scope &amp; Operating Model" isExecutable="false">
      <bpmn:documentation>Trigger: Growth in appliance/furniture mix; ecommerce expansion (VS-10); channel strategy review
Frequency: Annual + on strategy change
Volume: Enterprise bulky-delivery program across appliances (1,750 SKUs), furniture (1,750), large-format tile, lumber packs, solar water heaters
Owner: Head of Bulky/Home Delivery / Logistics (VS-06) / Commercial
Participants: Merchandising (VS-01), Ecommerce (VS-10), Trade (VS-11), Store Ops (VS-07), Finance (VS-17.4), 3PL (VS-56)
Source: workflow W4289 — Bulky &amp; White-Goods Delivery Program Strategy, Channel Scope &amp; Operating Model</bpmn:documentation>
      <bpmn:laneSet id="W4289_LaneSet3">
        <bpmn:lane id="W4289_Lane1" name="Head of Bulky Delivery">
        <bpmn:flowNodeRef>W4289_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4289_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4289_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4289_Lane2" name="Logistics">
        <bpmn:flowNodeRef>W4289_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4289_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4289_Start4" name="Growth in appliance/furniture mix; ecommerce expansion (VS-10); channel strategy review">
        <bpmn:outgoing>W4289_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4289_Task5" name="Logistics/Commercial set the bulky-delivery strategy — which SKUs/categories…">
        <bpmn:documentation>Step 1: Logistics/Commercial set the bulky-delivery strategy — which SKUs/categories are &quot;bulky-deliverable,&quot; which channels offer in-home delivery+install, the own-crew vs 3PL mix, and the install/haul-away service scope per category
Responsible (R): Head of Bulky Delivery / Logistics
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4289_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4289_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4289_Task6" name="Logistics/Merchandising map the end-to-end flow (order → schedule → dispatch →…">
        <bpmn:documentation>Step 2: Logistics/Merchandising map the end-to-end flow (order → schedule → dispatch → deliver → install → haul-away → recycle) and the handoffs to VS-06.3 (last-mile), VS-12 (install), VS-32 (returns), VS-73 (waste/recycle)
Responsible (R): Logistics / Merchandising
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4289_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4289_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4289_Task7" name="Logistics document the strategy, obtain approval, and cascade to capacity…">
        <bpmn:documentation>Step 3: Logistics document the strategy, obtain approval, and cascade to capacity (W4290), scheduling (W4291), pricing (W4295), and 3PL terms (W4303)
Responsible (R): Head of Bulky Delivery
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4289_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4289_End8" name="Complete">
        <bpmn:incoming>W4289_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4289_Annotation9">
        <bpmn:text>Controls: - CTL-659 (ensure controlled execution — Bulky/White-Goods Delivery Network, Scheduling &amp; Capacity (PA-143.1).) | - CTL-659: strategy approved (COO); service-scope risk-tiered (W4292); licensed-installer gate (W4293)
Owner: Head of Bulky/Home Delivery / Logistics (VS-06) / Commercial</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4289_Assoc10" sourceRef="W4289_Annotation9" targetRef="W4289_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4289_Flow11" sourceRef="W4289_Start4" targetRef="W4289_Task5" />
      <bpmn:sequenceFlow id="W4289_Flow12" sourceRef="W4289_Task5" targetRef="W4289_Task6" />
      <bpmn:sequenceFlow id="W4289_Flow13" sourceRef="W4289_Task6" targetRef="W4289_Task7" />
      <bpmn:sequenceFlow id="W4289_Flow14" sourceRef="W4289_Task7" targetRef="W4289_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4289_diag">
      <bpmndi:BPMNPlane id="W4289_plane" bpmnElement="W_W4289">
        <bpmndi:BPMNShape id="W4289_Lane1_di" bpmnElement="W4289_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4289_Lane2_di" bpmnElement="W4289_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4289_Task5_di" bpmnElement="W4289_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4289_Task6_di" bpmnElement="W4289_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4289_Task7_di" bpmnElement="W4289_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
