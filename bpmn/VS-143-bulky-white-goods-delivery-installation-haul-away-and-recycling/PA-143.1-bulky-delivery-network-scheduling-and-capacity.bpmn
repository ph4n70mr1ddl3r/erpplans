        <bpmndi:BPMNEdge id="W4289_Flow12_di" bpmnElement="W4289_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4289_Flow13_di" bpmnElement="W4289_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4289_Flow14_di" bpmnElement="W4289_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4289_Assoc10_di" bpmnElement="W4289_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4290" name="W4290. Bulky Delivery Network, Capacity &amp; Crew Sizing" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4289); volume/peak forecast; network change
Frequency: Annual + quarterly tuning
Volume: Bulky-delivery network across 200 stores / 4 DCs / catchment zones
Owner: Bulky-Delivery Network Planning / Logistics Capacity (VS-06)
Participants: DC Ops (VS-04), Store Ops (VS-07), 3PL (VS-56), Finance (VS-17.4), Fleet (VS-06.1)
Source: workflow W4290 — Bulky Delivery Network, Capacity &amp; Crew Sizing</bpmn:documentation>
      <bpmn:laneSet id="W4290_LaneSet2">
        <bpmn:lane id="W4290_Lane1" name="Network Planning">
        <bpmn:flowNodeRef>W4290_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4290_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4290_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4290_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4290_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4290_Start3" name="Strategy (W4289); volume/peak forecast; network change">
        <bpmn:outgoing>W4290_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4290_Task4" name="Network Planning forecast bulky-delivery volume by zone/category/season…">
        <bpmn:documentation>Step 1: Network Planning forecast bulky-delivery volume by zone/category/season (appliance AC peaks in summer, furniture in ber-months) and size crew, vehicle, and lift-gate capacity against the forecast
Responsible (R): Network Planning
Accountable (A): Head of Bulky Delivery
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4290_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4290_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4290_Task5" name="Network Planning/DC Ops define the staging model — DC-bulked, store-pooled, or…">
        <bpmn:documentation>Step 2: Network Planning/DC Ops define the staging model — DC-bulked, store-pooled, or cross-dock — and the two-man crew shift pattern covering customer time-windows incl. weekends
Responsible (R): Network Planning / DC Ops / Store Ops
Accountable (A): Head of Bulky Delivery
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4290_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4290_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4290_Task6" name="Network Planning/Finance size own vs 3PL capacity split (build for base, flex…">
        <bpmn:documentation>Step 3: Network Planning/Finance size own vs 3PL capacity split (build for base, flex to 3PL for peak) and feed capex/lease decisions to VS-06.1/VS-35
Responsible (R): Network Planning / Finance
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4290_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4290_End7" name="Complete">
        <bpmn:incoming>W4290_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4290_Annotation8">
        <bpmn:text>Controls: - CTL-659 (ensure controlled execution — Bulky/White-Goods Delivery Network, Scheduling &amp; Capacity (PA-143.1).) | - CTL-659: capacity sized to forecast with peak flex (3PL); crew shift covers statutory rest (VS-19.3/VS-84)
Owner: Bulky-Delivery Network Planning / Logistics Capacity (VS-06)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4290_Assoc9" sourceRef="W4290_Annotation8" targetRef="W4290_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4290_Flow10" sourceRef="W4290_Start3" targetRef="W4290_Task4" />
      <bpmn:sequenceFlow id="W4290_Flow11" sourceRef="W4290_Task4" targetRef="W4290_Task5" />
      <bpmn:sequenceFlow id="W4290_Flow12" sourceRef="W4290_Task5" targetRef="W4290_Task6" />
      <bpmn:sequenceFlow id="W4290_Flow13" sourceRef="W4290_Task6" targetRef="W4290_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4290_diag">
      <bpmndi:BPMNPlane id="W4290_plane" bpmnElement="W_W4290">
        <bpmndi:BPMNShape id="W4290_Lane1_di" bpmnElement="W4290_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_Task4_di" bpmnElement="W4290_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_Task5_di" bpmnElement="W4290_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_Task6_di" bpmnElement="W4290_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_Start3_di" bpmnElement="W4290_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_End7_di" bpmnElement="W4290_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4290_Annotation8_di" bpmnElement="W4290_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4290_Flow10_di" bpmnElement="W4290_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4290_Flow11_di" bpmnElement="W4290_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4290_Flow12_di" bpmnElement="W4290_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4290_Flow13_di" bpmnElement="W4290_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4290_Assoc9_di" bpmnElement="W4290_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4291" name="W4291. Customer Delivery Scheduling, Time-Window &amp; Routing Management" isExecutable="false">
      <bpmn:documentation>Trigger: Bulky order placed (VS-10/VS-11/VS-16)
Frequency: Per order (~thousands/month)
Volume: ~per-order booking; enterprise = bulky-order volume × time-windows/day
Owner: Bulky-Delivery Scheduling / Customer Service (VS-13)
Participants: Ecommerce (VS-10), Trade (VS-11), Logistics (VS-06.3), Store Ops (VS-07), Customer
Source: workflow W4291 — Customer Delivery Scheduling, Time-Window &amp; Routing Management</bpmn:documentation>
      <bpmn:laneSet id="W4291_LaneSet3">
        <bpmn:lane id="W4291_Lane1" name="Scheduling">
        <bpmn:flowNodeRef>W4291_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4291_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4291_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4291_Lane2" name="Logistics Routing">
        <bpmn:flowNodeRef>W4291_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4291_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4291_Start4" name="Bulky order placed (VS-10/VS-11/VS-16)">
        <bpmn:outgoing>W4291_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4291_Task5" name="Scheduling system offers the customer available delivery date/time-windows by…">
        <bpmn:documentation>Step 1: Scheduling system offers the customer available delivery date/time-windows by zone (AM/PM/2-hour slots) constrained by crew/vehicle capacity (W4290) and item install-eligibility (W4292)
Responsible (R): Scheduling / Ecommerce
Accountable (A): Head of Bulky Delivery
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4291_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4291_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4291_Task6" name="Customer confirms slot; system reserves crew+vehicle capacity, sends…">
        <bpmn:documentation>Step 2: Customer confirms slot; system reserves crew+vehicle capacity, sends confirmation + pre-delivery instructions (measure/access/parking), and holds the slot
Responsible (R): Scheduling / Customer Service
Accountable (A): Head of Bulky Delivery
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4291_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4291_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4291_Task7" name="Logistics auto-routes the day&#x27;s bulky deliveries into two-man crew manifests…">
        <bpmn:documentation>Step 3: Logistics auto-routes the day&#x27;s bulky deliveries into two-man crew manifests (multi-stop, time-window-constrained) and pushes to dispatch (W4297)
Responsible (R): Logistics Routing
Accountable (A): Head of Bulky Delivery
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4291_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4291_End8" name="Complete">
        <bpmn:incoming>W4291_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4291_Annotation9">
        <bpmn:text>Controls: - CTL-659 (ensure controlled execution — Bulky/White-Goods Delivery Network, Scheduling &amp; Capacity (PA-143.1).) | - CTL-659: slots capacity-constrained; pre-delivery access instruction mandatory; confirmation audit-trail
Owner: Bulky-Delivery Scheduling / Customer Service (VS-13)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4291_Assoc10" sourceRef="W4291_Annotation9" targetRef="W4291_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4291_Flow11" sourceRef="W4291_Start4" targetRef="W4291_Task5" />
      <bpmn:sequenceFlow id="W4291_Flow12" sourceRef="W4291_Task5" targetRef="W4291_Task6" />
      <bpmn:sequenceFlow id="W4291_Flow13" sourceRef="W4291_Task6" targetRef="W4291_Task7" />
      <bpmn:sequenceFlow id="W4291_Flow14" sourceRef="W4291_Task7" targetRef="W4291_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4291_diag">
      <bpmndi:BPMNPlane id="W4291_plane" bpmnElement="W_W4291">
        <bpmndi:BPMNShape id="W4291_Lane1_di" bpmnElement="W4291_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Lane2_di" bpmnElement="W4291_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Task5_di" bpmnElement="W4291_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Task6_di" bpmnElement="W4291_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Task7_di" bpmnElement="W4291_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Start4_di" bpmnElement="W4291_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_End8_di" bpmnElement="W4291_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4291_Annotation9_di" bpmnElement="W4291_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4291_Flow11_di" bpmnElement="W4291_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4291_Flow12_di" bpmnElement="W4291_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4291_Flow13_di" bpmnElement="W4291_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4291_Flow14_di" bpmnElement="W4291_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4291_Assoc10_di" bpmnElement="W4291_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4292" name="W4292. Bulky Item Order Capture, Eligibility &amp; Pre-Delivery Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Customer adds bulky/install item to basket (VS-10/VS-11)
Frequency: Per bulky order
Volume: Bulky-order volume (appliances + furniture + large tile + lumber packs)
Owner: Merchandising (VS-01) / Bulky-Delivery Ops / Ecommerce (VS-10)
Participants: Trade (VS-11), Logistics (VS-06), Compliance (VS-114 for DG), Finance (VS-16)
Source: workflow W4292 — Bulky Item Order Capture, Eligibility &amp; Pre-Delivery Verification</bpmn:documentation>
      <bpmn:laneSet id="W4292_LaneSet4">
        <bpmn:lane id="W4292_Lane1" name="Merchandising">
        <bpmn:flowNodeRef>W4292_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4292_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4292_Lane2" name="Ecommerce">
        <bpmn:flowNodeRef>W4292_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4292_Lane3" name="Delivery Ops">
        <bpmn:flowNodeRef>W4292_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4292_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4292_Start5" name="Customer adds bulky/install item to basket (VS-10/VS-11)">
        <bpmn:outgoing>W4292_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4292_Task6" name="Merchandising/Delivery Ops tag each bulky SKU with delivery attributes…">
        <bpmn:documentation>Step 1: Merchandising/Delivery Ops tag each bulky SKU with delivery attributes (weight/dim, lift-gate req, two-man flag, install-required flag, install-license req e.g. split-AC refrigerant, haul-away-eligible flag, DG flag)
Responsible (R): Merchandising / Delivery Ops
Accountable (A): Head of Merch Ops
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4292_Flow12</bpmn:incoming>
