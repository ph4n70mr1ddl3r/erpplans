    <bpmn:process id="W_W2612" name="W2612. Hazardous Waste Compliance Audit &amp; Record Keeping" isExecutable="false">
      <bpmn:documentation>Trigger: Internal audit cycle or DENR inspection
Frequency: Annual internal; DENR inspection ad-hoc
Volume: 205 locations
Owner: Internal Auditor
Participants: Internal Auditor, Sustainability Coordinator, COO
Source: workflow W2612 — Hazardous Waste Compliance Audit &amp; Record Keeping</bpmn:documentation>
