    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2608" name="W2608. Battery &amp; Lead-Acid Waste Management" isExecutable="false">
      <bpmn:documentation>Trigger: Forklift battery replacement or customer battery return
Frequency: Ad-hoc; 3–5 forklift batteries/store/year
Volume: 4 DCs + 200 stores
Owner: DC Operations Manager / Store Manager
Participants: DC Ops / Store Manager, DENR-Certified Lead Recycler, Safety Officer
Source: workflow W2608 — Battery &amp; Lead-Acid Waste Management</bpmn:documentation>
      <bpmn:laneSet id="W2608_LaneSet4">
        <bpmn:lane id="W2608_Lane1" name="DC Ops">
        <bpmn:flowNodeRef>W2608_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2608_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2608_Lane2" name="Lead Recycler">
        <bpmn:flowNodeRef>W2608_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2608_Lane3" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2608_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2608_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2608_Start5" name="Forklift battery replacement or customer battery return">
        <bpmn:outgoing>W2608_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2608_Task6" name="DC Ops / Store Manager manages spent lead-acid batteries: stores upright in…">
        <bpmn:documentation>Step 1: DC Ops / Store Manager manages spent lead-acid batteries: stores upright in acid-resistant containment, labels as hazardous waste, contacts certified lead recycler
Responsible (R): DC Ops / Store Manager
Accountable (A): COO
Duration: Per replacement event</bpmn:documentation>
        <bpmn:incoming>W2608_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2608_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2608_Task7" name="Lead recycler collects batteries: weighs and issues receipt with DENR manifest…">
        <bpmn:documentation>Step 2: Lead recycler collects batteries: weighs and issues receipt with DENR manifest; pays lead recovery credit (PHP 500–1,500 per battery)
Responsible (R): Lead Recycler / Finance
Accountable (A): Finance Controller
Duration: Per collection</bpmn:documentation>
        <bpmn:incoming>W2608_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2608_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2608_Task8" name="Sustainability Coordinator tracks battery waste: ensures 100% go to certified…">
        <bpmn:documentation>Step 3: Sustainability Coordinator tracks battery waste: ensures 100% go to certified recyclers per RA 6969 (Toxic Substances and Hazardous and Nuclear Wastes Control Act)
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Quarterly review</bpmn:documentation>
        <bpmn:incoming>W2608_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2608_End9" name="Complete">
        <bpmn:incoming>W2608_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2608_Annotation10">
        <bpmn:text>Controls: - CTL-449 (ensure controlled execution — Hazardous Waste &amp; DENR Compliance (PA-73.2).) | - operational: certified recycler onboarding; CTL-26 (asset disposal); operational control: 100% manifest-traceability review quarterly
Owner: DC Operations Manager / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2608_Assoc11" sourceRef="W2608_Annotation10" targetRef="W2608_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2608_Flow12" sourceRef="W2608_Start5" targetRef="W2608_Task6" />
      <bpmn:sequenceFlow id="W2608_Flow13" sourceRef="W2608_Task6" targetRef="W2608_Task7" />
      <bpmn:sequenceFlow id="W2608_Flow14" sourceRef="W2608_Task7" targetRef="W2608_Task8" />
      <bpmn:sequenceFlow id="W2608_Flow15" sourceRef="W2608_Task8" targetRef="W2608_End9" />
    </bpmn:process>
