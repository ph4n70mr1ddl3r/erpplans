    <bpmn:process id="W_W2611" name="W2611. Spill Response &amp; Containment Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Chemical spill at store or DC
Frequency: Ad-hoc; 2–5 spills per year across network
Volume: 200 stores + 4 DCs
Owner: Safety Officer
Participants: Safety Officer, Store/DC Manager, Maintenance Staff, DENR (if significant)
Source: workflow W2611 — Spill Response &amp; Containment Protocol</bpmn:documentation>
      <bpmn:laneSet id="W2611_LaneSet3">
        <bpmn:lane id="W2611_Lane1" name="Nearest Staff">
        <bpmn:flowNodeRef>W2611_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2611_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2611_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W2611_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2611_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2611_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2611_Start4" name="Chemical spill at store or DC">
        <bpmn:outgoing>W2611_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2611_Task5" name="First responder activates spill response: dons PPE from spill kit, identifies…">
        <bpmn:documentation>Step 1: First responder activates spill response: dons PPE from spill kit, identifies spilled material, contains spill using absorbent materials, prevents entry into drains
Responsible (R): Nearest Staff / Safety Officer
Accountable (A): Store/DC Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W2611_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2611_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2611_Task6" name="Safety Officer assesses spill severity: minor (&lt;5 liters) — staff cleans; major…">
        <bpmn:documentation>Step 2: Safety Officer assesses spill severity: minor (&lt;5 liters) — staff cleans; major (&gt;5 liters or hazardous) — evacuates area, calls emergency contractor, reports to DENR if environmental contamination possible
Responsible (R): Safety Officer
Accountable (A): COO
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W2611_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2611_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2611_Task7" name="Safety Officer documents spill: incident report with photos, root cause…">
        <bpmn:documentation>Step 3: Safety Officer documents spill: incident report with photos, root cause analysis, corrective actions; updates spill kit inventory; submits to COO and Insurance if damage occurred
Responsible (R): Safety Officer
Accountable (A): COO
Duration: 1–2 days post-incident</bpmn:documentation>
        <bpmn:incoming>W2611_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2611_End8" name="Complete">
        <bpmn:incoming>W2611_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2611_Annotation9">
        <bpmn:text>Controls: - CTL-449 (ensure controlled execution — Hazardous Waste &amp; DENR Compliance (PA-73.2).) | - Operational control: spill-kit inventory check in monthly Safety inspection; incident-report dual-signoff (Safety Officer + Store Manager); insurance evidence within 48 hrs
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2611_Assoc10" sourceRef="W2611_Annotation9" targetRef="W2611_Start4" associationDirection="None" />
