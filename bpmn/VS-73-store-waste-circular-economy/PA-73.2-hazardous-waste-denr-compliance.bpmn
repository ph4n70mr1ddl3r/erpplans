    <bpmn:process id="W_W2607" name="W2607. Solvent &amp; Flammable Material Waste Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Solvent waste from paint station or equipment cleaning
Frequency: Daily accumulation; monthly disposal
Volume: ~200 stores
Owner: Department Supervisor
Participants: Dept Supervisor, Maintenance Staff, Safety Officer, DENR-Certified Vendor
Source: workflow W2607 — Solvent &amp; Flammable Material Waste Handling</bpmn:documentation>
      <bpmn:laneSet id="W2607_LaneSet4">
        <bpmn:lane id="W2607_Lane1" name="Dept Supervisor">
        <bpmn:flowNodeRef>W2607_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2607_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2607_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W2607_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2607_Lane3" name="Hazwaste Vendor">
        <bpmn:flowNodeRef>W2607_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2607_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2607_Start5" name="Solvent waste from paint station or equipment cleaning">
        <bpmn:outgoing>W2607_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2607_Task6" name="Department Supervisor segregates solvent waste: used thinner, mineral spirits…">
        <bpmn:documentation>Step 1: Department Supervisor segregates solvent waste: used thinner, mineral spirits, acetone; stores in approved flammable liquid containers in flammable storage cabinet
Responsible (R): Dept Supervisor
Accountable (A): Store Manager
Duration: 10–15 min/day</bpmn:documentation>
        <bpmn:incoming>W2607_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2607_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2607_Task7" name="Safety Officer inspects flammable storage monthly: verifies container…">
        <bpmn:documentation>Step 2: Safety Officer inspects flammable storage monthly: verifies container integrity, ventilation, fire suppression, signage, PPE availability
Responsible (R): Safety Officer
Accountable (A): Store Manager
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W2607_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2607_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2607_Task8" name="DENR-certified vendor collects flammable waste per schedule; issues transport…">
        <bpmn:documentation>Step 3: DENR-certified vendor collects flammable waste per schedule; issues transport manifest; waste tracked cradle to grave in ERP sustainability module
Responsible (R): Hazwaste Vendor / Safety Officer
Accountable (A): COO
Duration: Monthly/quarterly</bpmn:documentation>
        <bpmn:incoming>W2607_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2607_End9" name="Complete">
        <bpmn:incoming>W2607_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2607_Annotation10">
        <bpmn:text>Controls: - CTL-06 (vendor certification); operational control: monthly Safety Officer cabinet inspection with signed checklist; BFP FSIC linkage (W476)
Owner: Department Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2607_Assoc11" sourceRef="W2607_Annotation10" targetRef="W2607_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2607_Flow12" sourceRef="W2607_Start5" targetRef="W2607_Task6" />
      <bpmn:sequenceFlow id="W2607_Flow13" sourceRef="W2607_Task6" targetRef="W2607_Task7" />
      <bpmn:sequenceFlow id="W2607_Flow14" sourceRef="W2607_Task7" targetRef="W2607_Task8" />
      <bpmn:sequenceFlow id="W2607_Flow15" sourceRef="W2607_Task8" targetRef="W2607_End9" />
    </bpmn:process>
