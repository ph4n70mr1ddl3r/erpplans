<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-73.2-hazardous-waste-denr-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2606" name="W2606. Paint &amp; Chemical Waste Storage &amp; Disposal" isExecutable="false">
      <bpmn:documentation>Trigger: Paint mixing station waste accumulation or quarterly disposal cycle
Frequency: Daily accumulation; quarterly disposal
Volume: 200 stores with paint stations
Owner: Store Manager
Participants: Store Manager, Paint Section Lead, DENR-Certified Hazardous Waste Vendor
Source: workflow W2606 — Paint &amp; Chemical Waste Storage &amp; Disposal</bpmn:documentation>
      <bpmn:laneSet id="W2606_LaneSet4">
        <bpmn:lane id="W2606_Lane1" name="Paint Section Lead">
        <bpmn:flowNodeRef>W2606_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2606_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2606_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2606_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2606_Lane3" name="Hazwaste Vendor">
        <bpmn:flowNodeRef>W2606_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2606_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2606_Start5" name="Paint mixing station waste accumulation or quarterly disposal cycle">
        <bpmn:outgoing>W2606_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2606_Task6" name="Paint Section Lead manages daily paint waste: leftover tint, contaminated…">
        <bpmn:documentation>Step 1: Paint Section Lead manages daily paint waste: leftover tint, contaminated thinner, paint spills, empty cans with residue; collects in designated hazardous waste containers with proper labeling per DENR requirements
Responsible (R): Paint Section Lead
Accountable (A): Store Manager
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W2606_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2606_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2606_Task7" name="Store Manager monitors hazardous waste accumulation: tracks volume against DENR…">
        <bpmn:documentation>Step 2: Store Manager monitors hazardous waste accumulation: tracks volume against DENR storage limits (90-day on-site accumulation limit per DAO 2013-22 (the revised RA 6969 Procedural Manual)), ensures containers properly sealed and labeled
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 15 min/week</bpmn:documentation>
        <bpmn:incoming>W2606_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2606_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2606_Task8" name="DENR-certified hazardous waste vendor conducts quarterly pickup; issues…">
        <bpmn:documentation>Step 3: DENR-certified hazardous waste vendor conducts quarterly pickup; issues manifest document; Store Manager signs and archives for 5-year compliance record; Finance processes disposal cost (PHP 30–50K/quarter per store)
Responsible (R): Hazwaste Vendor / Store Manager / Finance
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2606_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2606_End9" name="Complete">
        <bpmn:incoming>W2606_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2606_Annotation10">
        <bpmn:text>Controls: - CTL-449 (ensure controlled execution — Hazardous Waste &amp; DENR Compliance (PA-73.2).) | - operational: DENR-certified vendor onboarding; CTL-44 (duplicate-invoice guard on disposal invoices); operational control: manifest-vs-invoice match before payment
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2606_Assoc11" sourceRef="W2606_Annotation10" targetRef="W2606_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2606_Flow12" sourceRef="W2606_Start5" targetRef="W2606_Task6" />
      <bpmn:sequenceFlow id="W2606_Flow13" sourceRef="W2606_Task6" targetRef="W2606_Task7" />
      <bpmn:sequenceFlow id="W2606_Flow14" sourceRef="W2606_Task7" targetRef="W2606_Task8" />
      <bpmn:sequenceFlow id="W2606_Flow15" sourceRef="W2606_Task8" targetRef="W2606_End9" />
    </bpmn:process>
