    <bpmn:process id="W_W2609" name="W2609. DENR Hazardous Waste Permit &amp; Registration Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual permit renewal cycle
Frequency: Annual
Volume: 205 locations
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Legal, COO, DENR-EMB
Source: workflow W2609 — DENR Hazardous Waste Permit &amp; Registration Management</bpmn:documentation>
      <bpmn:laneSet id="W2609_LaneSet3">
        <bpmn:lane id="W2609_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2609_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2609_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2609_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2609_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2609_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2609_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2609_Start4" name="Annual permit renewal cycle">
        <bpmn:outgoing>W2609_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2609_Task5" name="Sustainability Coordinator maintains DENR Environmental Compliance Certificate…">
        <bpmn:documentation>Step 1: Sustainability Coordinator maintains DENR Environmental Compliance Certificate and Hazardous Waste Generator Registration for all 205 locations; tracks renewal deadlines; compiles required documentation
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 1–2 months before renewal</bpmn:documentation>
        <bpmn:incoming>W2609_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2609_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2609_Task6" name="Legal reviews submissions for completeness; ensures compliance with DENR DAO…">
        <bpmn:documentation>Step 2: Legal reviews submissions for completeness; ensures compliance with DENR DAO 2013-22 and RA 6969; Coordinator submits to DENR-EMB regional office
Responsible (R): Legal / Sustainability Coordinator
Accountable (A): VP Legal
Duration: Per renewal cycle</bpmn:documentation>
