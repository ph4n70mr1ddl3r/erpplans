    <bpmn:process id="W_W2613" name="W2613. Asbestos &amp; Special Hazardous Material Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Renovation project involving asbestos-containing materials
Frequency: Rare; event-driven during renovations
Volume: 10–15 renovation projects/year
Owner: Facilities Manager
Participants: Facilities Mgr, Licensed Contractor, DENR, Safety Officer
Source: workflow W2613 — Asbestos &amp; Special Hazardous Material Handling</bpmn:documentation>
      <bpmn:laneSet id="W2613_LaneSet3">
        <bpmn:lane id="W2613_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W2613_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2613_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2613_Lane2" name="Licensed Contractor">
        <bpmn:flowNodeRef>W2613_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2613_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2613_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2613_Start4" name="Renovation project involving asbestos-containing materials">
        <bpmn:outgoing>W2613_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2613_Task5" name="Facilities Manager conducts asbestos survey before renovation; if found…">
        <bpmn:documentation>Step 1: Facilities Manager conducts asbestos survey before renovation; if found: engages DENR-licensed removal contractor; obtains DENR permit
Responsible (R): Facilities Manager / Licensed Contractor
Accountable (A): COO
Duration: 2–4 weeks pre-renovation</bpmn:documentation>
        <bpmn:incoming>W2613_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2613_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2613_Task6" name="Licensed contractor performs removal with full PPE and containment; Safety…">
        <bpmn:documentation>Step 2: Licensed contractor performs removal with full PPE and containment; Safety Officer monitors compliance
Responsible (R): Licensed Contractor / Safety Officer
Accountable (A): Facilities Manager
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W2613_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2613_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2613_Task7" name="Contractor transports to DENR-licensed asbestos landfill; issues disposal…">
        <bpmn:documentation>Step 3: Contractor transports to DENR-licensed asbestos landfill; issues disposal manifest; Facilities Manager archives documentation permanently
Responsible (R): Licensed Contractor / Facilities Manager
Accountable (A): COO / VP Legal
Duration: Post-project</bpmn:documentation>
        <bpmn:incoming>W2613_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2613_End8" name="Complete">
        <bpmn:incoming>W2613_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2613_Annotation9">
        <bpmn:text>Controls: - CTL-449 (ensure controlled execution — Hazardous Waste &amp; DENR Compliance (PA-73.2).) | - operational: DENR-licensed contractor onboarding; operational control: Safety Officer containment monitoring; permanent manifest archive
Owner: Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
