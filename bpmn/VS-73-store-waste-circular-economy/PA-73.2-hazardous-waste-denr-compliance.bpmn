      <bpmndi:BPMNPlane id="W2606_plane" bpmnElement="W_W2606">
        <bpmndi:BPMNShape id="W2606_Lane1_di" bpmnElement="W2606_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
