      </bpmn:startEvent>
      <bpmn:userTask id="W2612_Task5" name="Internal Auditor reviews hazardous waste compliance at sampled locations…">
        <bpmn:documentation>Step 1: Internal Auditor reviews hazardous waste compliance at sampled locations (20–30/year): verifies storage compliance, reviews disposal manifests, confirms vendor DENR certification, checks training records
Responsible (R): Internal Auditor
Accountable (A): Head of Internal Audit
Duration: 2–3 weeks/year</bpmn:documentation>
        <bpmn:incoming>W2612_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2612_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2612_Task6" name="Sustainability Coordinator addresses findings: corrects non-compliance within…">
        <bpmn:documentation>Step 2: Sustainability Coordinator addresses findings: corrects non-compliance within 30 days; critical findings corrected within 7 days
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 30 days</bpmn:documentation>
        <bpmn:incoming>W2612_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2612_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2612_Task7" name="Coordinator maintains 5-year hazardous waste records per location: generation…">
        <bpmn:documentation>Step 3: Coordinator maintains 5-year hazardous waste records per location: generation logs, disposal manifests, vendor certifications, inspection reports, training records; accessible for DENR inspection at any time
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2612_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2612_End8" name="Complete">
