    <bpmn:process id="W_W2614" name="W2614. Vendor Packaging Take-Back Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: New vendor onboarding or annual sustainability program review
Frequency: Annual program; per vendor onboarding
Volume: ~800–1,000 vendors
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Procurement, Vendor, Merchandising
Source: workflow W2614 — Vendor Packaging Take-Back Program Management</bpmn:documentation>
      <bpmn:laneSet id="W2614_LaneSet4">
        <bpmn:lane id="W2614_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2614_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2614_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2614_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2614_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2614_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W2614_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2614_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2614_Start5" name="New vendor onboarding or annual sustainability program review">
        <bpmn:outgoing>W2614_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2614_Task6" name="Sustainability Coordinator designs packaging take-back program: identifies…">
        <bpmn:documentation>Step 1: Sustainability Coordinator designs packaging take-back program: identifies high-volume packaging vendors; negotiates returnable packaging (reusable crates, pallets) instead of single-use
Responsible (R): Sustainability Coordinator / Procurement
Accountable (A): COO
Duration: 2–3 months</bpmn:documentation>
        <bpmn:incoming>W2614_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2614_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2614_Task7" name="Procurement incorporates packaging requirements into vendor contracts…">
        <bpmn:documentation>Step 2: Procurement incorporates packaging requirements into vendor contracts: returnable packaging for top 50 vendors, packaging reduction targets, penalties for excessive waste
Responsible (R): Procurement
Accountable (A): VP Merchandising
Duration: Per contract cycle</bpmn:documentation>
        <bpmn:incoming>W2614_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2614_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2614_Task8" name="DC Ops manages returnable packaging logistics: tracks crate/pallet inventory…">
        <bpmn:documentation>Step 3: DC Ops manages returnable packaging logistics: tracks crate/pallet inventory, schedules vendor pickups, reconciles packaging deposits; Coordinator reports packaging waste reduction metrics
Responsible (R): DC Ops / Sustainability Coordinator
Accountable (A): VP Supply Chain
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2614_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2614_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2614_End9" name="Complete">
        <bpmn:incoming>W2614_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2614_Annotation10">
        <bpmn:text>Controls: - CTL-06: vendor onboarding — packaging clause check; operational control: monthly RTI deposit reconciliation by DC Ops
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2614_Assoc11" sourceRef="W2614_Annotation10" targetRef="W2614_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2614_Flow12" sourceRef="W2614_Start5" targetRef="W2614_Task6" />
      <bpmn:sequenceFlow id="W2614_Flow13" sourceRef="W2614_Task6" targetRef="W2614_Task7" />
      <bpmn:sequenceFlow id="W2614_Flow14" sourceRef="W2614_Task7" targetRef="W2614_Task8" />
      <bpmn:sequenceFlow id="W2614_Flow15" sourceRef="W2614_Task8" targetRef="W2614_End9" />
    </bpmn:process>
