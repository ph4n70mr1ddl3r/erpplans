    <bpmn:process id="W_W2615" name="W2615. Recycling Revenue Optimization &amp; Vendor Management" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly recycling contract review
Frequency: Quarterly
Volume: ~10–15 recycling vendor contracts
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Procurement, Finance, Recycling Vendors
Source: workflow W2615 — Recycling Revenue Optimization &amp; Vendor Management</bpmn:documentation>
      <bpmn:laneSet id="W2615_LaneSet3">
        <bpmn:lane id="W2615_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2615_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2615_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2615_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2615_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2615_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2615_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2615_Start4" name="Quarterly recycling contract review">
        <bpmn:outgoing>W2615_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2615_Task5" name="Sustainability Coordinator reviews recycling vendor performance: collection…">
        <bpmn:documentation>Step 1: Sustainability Coordinator reviews recycling vendor performance: collection reliability, pricing competitiveness, manifest compliance; benchmarks against market rates
Responsible (R): Sustainability Coordinator / Procurement
Accountable (A): COO
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2615_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2615_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2615_Task6" name="Coordinator optimizes recycling revenue: consolidates volumes across nearby…">
        <bpmn:documentation>Step 2: Coordinator optimizes recycling revenue: consolidates volumes across nearby stores for better pricing, negotiates volume-based rate increases, explores higher-value recycling streams
Responsible (R): Sustainability Coordinator / Procurement
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2615_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2615_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2615_Task7" name="Finance tracks recycling revenue per store: PHP 2K–10K/month; includes in store…">
        <bpmn:documentation>Step 3: Finance tracks recycling revenue per store: PHP 2K–10K/month; includes in store P&amp;L; Coordinator reports network-wide recycling revenue trend quarterly
Responsible (R): Finance / Sustainability Coordinator
Accountable (A): Finance Controller
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2615_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2615_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2615_End8" name="Complete">
        <bpmn:incoming>W2615_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2615_Annotation9">
        <bpmn:text>Controls: - CTL-450 (ensure controlled execution — Circular Economy &amp; Recycling Analytics (PA-73.3).) | - operational: settlement accuracy — recycling revenue validated before reporting; quarterly Finance validation per store
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2615_Assoc10" sourceRef="W2615_Annotation9" targetRef="W2615_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2615_Flow11" sourceRef="W2615_Start4" targetRef="W2615_Task5" />
      <bpmn:sequenceFlow id="W2615_Flow12" sourceRef="W2615_Task5" targetRef="W2615_Task6" />
      <bpmn:sequenceFlow id="W2615_Flow13" sourceRef="W2615_Task6" targetRef="W2615_Task7" />
      <bpmn:sequenceFlow id="W2615_Flow14" sourceRef="W2615_Task7" targetRef="W2615_End8" />
    </bpmn:process>
