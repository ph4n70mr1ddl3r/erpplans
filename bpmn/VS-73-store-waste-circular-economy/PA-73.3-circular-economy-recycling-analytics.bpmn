    <bpmn:process id="W_W2617" name="W2617. Store-Level Composting &amp; Organic Waste Program" isExecutable="false">
      <bpmn:documentation>Trigger: Store with garden center generates organic waste
Frequency: Daily at stores with garden centers; ~80 stores
Volume: ~80 stores with garden centers
Owner: Garden Center Supervisor
Participants: Garden Center Supervisor, Store Manager, Sustainability Coordinator
Source: workflow W2617 — Store-Level Composting &amp; Organic Waste Program</bpmn:documentation>
      <bpmn:laneSet id="W2617_LaneSet3">
        <bpmn:lane id="W2617_Lane1" name="Garden Center Supervisor">
        <bpmn:flowNodeRef>W2617_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2617_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2617_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2617_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2617_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2617_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2617_Start4" name="Store with garden center generates organic waste">
        <bpmn:outgoing>W2617_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2617_Task5" name="Garden Center Supervisor collects organic waste: dead plants, soil, leaves…">
        <bpmn:documentation>Step 1: Garden Center Supervisor collects organic waste: dead plants, soil, leaves, trimmings; separates from general waste; stages in composting area or bags for community garden donation
Responsible (R): Garden Center Supervisor
Accountable (A): Store Manager
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W2617_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2617_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2617_Task6" name="Supervisor manages on-site composting: turns pile weekly, monitors temperature…">
        <bpmn:documentation>Step 2: Supervisor manages on-site composting: turns pile weekly, monitors temperature, processes into compost in 8–12 weeks; bags finished compost for sale at PHP 50–100 per bag
Responsible (R): Garden Center Supervisor
Accountable (A): Store Manager
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W2617_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2617_Flow13</bpmn:outgoing>
      </bpmn:userTask>
