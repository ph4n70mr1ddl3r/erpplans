    <bpmn:process id="W_W2616" name="W2616. Circular Economy Product Development" isExecutable="false">
      <bpmn:documentation>Trigger: Sustainability initiative or customer demand signal
Frequency: Quarterly; event-driven
Volume: 35,000 active SKUs
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Category Manager, Marketing, VP Merchandising
Source: workflow W2616 — Circular Economy Product Development</bpmn:documentation>
      <bpmn:laneSet id="W2616_LaneSet4">
        <bpmn:lane id="W2616_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2616_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2616_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2616_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2616_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2616_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W2616_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2616_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2616_Start5" name="Sustainability initiative or customer demand signal">
        <bpmn:outgoing>W2616_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2616_Task6" name="Sustainability Coordinator identifies circular economy product opportunities…">
        <bpmn:documentation>Step 1: Sustainability Coordinator identifies circular economy product opportunities: recycled-content products, refill stations, product-as-a-service models, upcycled product lines
Responsible (R): Sustainability Coordinator / Category Manager
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2616_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2616_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2616_Task7" name="Category Manager evaluates product viability: supplier sourcing, demand…">
        <bpmn:documentation>Step 2: Category Manager evaluates product viability: supplier sourcing, demand assessment, margin analysis, shelf space allocation; pilot at 10–20 stores
Responsible (R): Category Manager / Marketing
Accountable (A): VP Merchandising
Duration: 1–2 months per initiative</bpmn:documentation>
        <bpmn:incoming>W2616_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2616_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2616_Task8" name="Marketing promotes circular economy messaging: &#x27;BuildRight Green Choice&#x27;…">
        <bpmn:documentation>Step 3: Marketing promotes circular economy messaging: &#x27;BuildRight Green Choice&#x27; labeling, in-store educational displays, social media content, customer DIY workshops using reclaimed materials
Responsible (R): Marketing
Accountable (A): CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2616_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2616_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2616_End9" name="Complete">
        <bpmn:incoming>W2616_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2616_Annotation10">
        <bpmn:text>Controls: - CTL-450 (ensure controlled execution — Circular Economy &amp; Recycling Analytics (PA-73.3).) | - Operational control: substantiation file required before &#x27;Green Choice&#x27; label activation (links to VS-22 regulatory; DTI consumer protection)
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2616_Assoc11" sourceRef="W2616_Annotation10" targetRef="W2616_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2616_Flow12" sourceRef="W2616_Start5" targetRef="W2616_Task6" />
      <bpmn:sequenceFlow id="W2616_Flow13" sourceRef="W2616_Task6" targetRef="W2616_Task7" />
      <bpmn:sequenceFlow id="W2616_Flow14" sourceRef="W2616_Task7" targetRef="W2616_Task8" />
      <bpmn:sequenceFlow id="W2616_Flow15" sourceRef="W2616_Task8" targetRef="W2616_End9" />
    </bpmn:process>
