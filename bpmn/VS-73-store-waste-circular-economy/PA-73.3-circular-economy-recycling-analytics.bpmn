    <bpmn:process id="W_W2621" name="W2621. Waste-to-Energy Feasibility &amp; Biomass Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual sustainability strategy review
Frequency: Annual evaluation; ad-hoc for pilot
Volume: 4 DCs; 200 stores
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Facilities, COO, External Consultant
Source: workflow W2621 — Waste-to-Energy Feasibility &amp; Biomass Program</bpmn:documentation>
      <bpmn:laneSet id="W2621_LaneSet2">
        <bpmn:lane id="W2621_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2621_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2621_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2621_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2621_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2621_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2621_Start3" name="Annual sustainability strategy review">
        <bpmn:outgoing>W2621_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2621_Task4" name="Sustainability Coordinator evaluates waste-to-energy potential: anaerobic…">
        <bpmn:documentation>Step 1: Sustainability Coordinator evaluates waste-to-energy potential: anaerobic digestion for organic waste, biomass boiler for wood waste, solar panel waste recycling; engages consultant for feasibility study
Responsible (R): Sustainability Coordinator / External Consultant
Accountable (A): COO
Duration: 2–3 months</bpmn:documentation>
        <bpmn:incoming>W2621_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2621_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2621_Task5" name="For feasible projects: Coordinator develops business case with ROI; presents to…">
        <bpmn:documentation>Step 2: For feasible projects: Coordinator develops business case with ROI; presents to CFO and COO for approval
Responsible (R): Sustainability Coordinator / Finance
Accountable (A): CFO
Duration: 1 month</bpmn:documentation>
        <bpmn:incoming>W2621_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2621_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2621_Task6" name="For approved pilots: manages implementation, tracks results, reports to COO…">
        <bpmn:documentation>Step 3: For approved pilots: manages implementation, tracks results, reports to COO; scales successful pilots; documents for ESG reporting
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 6–12 months</bpmn:documentation>
        <bpmn:incoming>W2621_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2621_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2621_End7" name="Complete">
        <bpmn:incoming>W2621_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2621_Annotation8">
        <bpmn:text>Controls: - CTL-450 (ensure controlled execution — Circular Economy &amp; Recycling Analytics (PA-73.3).) | - operational: capex approval tiers on scale-up decisions; pilot ROI validation gate
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
