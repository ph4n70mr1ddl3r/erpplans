    <bpmn:process id="W_W2602" name="W2602. Lumber Yard Waste &amp; Offcut Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily lumber yard operations
Frequency: Daily at stores with lumber yards
Volume: ~150 stores with lumber yards (one register with W1015)
Owner: Lumber Yard Supervisor
Participants: Lumber Yard Supervisor, Stock Associate, Store Manager
Source: workflow W2602 — Lumber Yard Waste &amp; Offcut Management</bpmn:documentation>
      <bpmn:laneSet id="W2602_LaneSet3">
        <bpmn:lane id="W2602_Lane1" name="Lumber Yard Supervisor">
        <bpmn:flowNodeRef>W2602_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2602_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2602_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2602_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W2602_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2602_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2602_Start4" name="Daily lumber yard operations">
        <bpmn:outgoing>W2602_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2602_Task5" name="Lumber Yard Supervisor manages wood waste from cutting operations: collects…">
        <bpmn:documentation>Step 1: Lumber Yard Supervisor manages wood waste from cutting operations: collects offcuts, sawdust, and damaged lumber; sorts by size — usable offcuts for customer sale, sawdust for composting, waste wood for biomass recycler
Responsible (R): Lumber Yard Supervisor
Accountable (A): Store Manager
Duration: 20–30 min/day</bpmn:documentation>
        <bpmn:incoming>W2602_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2602_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2602_Task6" name="Stock Associate packages usable offcuts into bundles for clearance sale: priced…">
        <bpmn:documentation>Step 2: Stock Associate packages usable offcuts into bundles for clearance sale: priced at PHP 50–100 per bundle; popular with DIY customers; generates ~PHP 5K–10K/month per store
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W2602_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2602_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2602_Task7" name="Supervisor tracks lumber waste rate: calculates % becoming waste (target: &lt;5%)…">
        <bpmn:documentation>Step 3: Supervisor tracks lumber waste rate: calculates % becoming waste (target: &lt;5%); implements waste reduction measures
Responsible (R): Lumber Yard Supervisor
Accountable (A): Store Manager
Duration: Monthly review</bpmn:documentation>
        <bpmn:incoming>W2602_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2602_End8" name="Complete">
        <bpmn:incoming>W2602_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2602_Annotation9">
        <bpmn:text>Controls: - CTL-448 (ensure controlled execution — Store Waste Segregation &amp; Collection (PA-73.1).) | - Operational control: monthly waste-rate review with vendor-grade correlation (feeds VS-67 vendor scorecard)
Owner: Lumber Yard Supervisor</bpmn:text>
      </bpmn:textAnnotation>
