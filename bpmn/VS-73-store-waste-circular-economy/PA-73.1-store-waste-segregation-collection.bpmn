    <bpmn:process id="W_W2603" name="W2603. E-Waste &amp; Battery Collection &amp; Disposal" isExecutable="false">
      <bpmn:documentation>Trigger: Electronic equipment end-of-life or battery collection event
Frequency: Quarterly e-waste collection; ad-hoc for equipment
Volume: 200 stores
Owner: IT Support / Store Manager
Participants: IT Support, Store Manager, DENR-Certified E-Waste Vendor, Sustainability Coordinator
Source: workflow W2603 — E-Waste &amp; Battery Collection &amp; Disposal</bpmn:documentation>
      <bpmn:laneSet id="W2603_LaneSet4">
        <bpmn:lane id="W2603_Lane1" name="IT Support">
        <bpmn:flowNodeRef>W2603_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2603_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2603_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2603_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2603_Lane3" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2603_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2603_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2603_Start5" name="Electronic equipment end-of-life or battery collection event">
        <bpmn:outgoing>W2603_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2603_Task6" name="IT Support collects end-of-life electronic equipment: POS terminals, barcode…">
        <bpmn:documentation>Step 1: IT Support collects end-of-life electronic equipment: POS terminals, barcode scanners, RF guns, computers, printers; stores in designated e-waste staging area; coordinates with DENR-certified e-waste recycler
Responsible (R): IT Support / Store Manager
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2603_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2603_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2603_Task7" name="Store Manager hosts quarterly customer e-waste collection event: accepts…">
        <bpmn:documentation>Step 2: Store Manager hosts quarterly customer e-waste collection event: accepts batteries, CFL bulbs, small electronics; partners with LGU environmental office; offers loyalty points incentive
Responsible (R): Store Manager / Sustainability Coordinator
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2603_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2603_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2603_Task8" name="Sustainability Coordinator tracks e-waste diversion: ensures compliance with…">
        <bpmn:documentation>Step 3: Sustainability Coordinator tracks e-waste diversion: ensures compliance with DENR DAO 2013-22 (Revised Procedures and Standards for the Management of Hazardous Wastes under RA 6969)
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2603_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2603_End9" name="Complete">
        <bpmn:incoming>W2603_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2603_Annotation10">
        <bpmn:text>Controls: - CTL-26 (fixed-asset disposal + IT data wipe per RA 10173); CTL-06 (vendor DENR-certification onboarding); manifest 5-year archive (operational)
Owner: IT Support / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
