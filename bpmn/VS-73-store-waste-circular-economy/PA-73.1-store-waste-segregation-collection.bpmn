<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-73.1-store-waste-segregation-collection" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2598" name="W2598. Store-Level Waste Segregation &amp; Daily Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Daily store operations
Frequency: Daily per store
Volume: 200 stores
Owner: Store Manager
Participants: Store Manager, Maintenance Staff, Stock Associates
Source: workflow W2598 — Store-Level Waste Segregation &amp; Daily Collection</bpmn:documentation>
      <bpmn:laneSet id="W2598_LaneSet3">
        <bpmn:lane id="W2598_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W2598_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2598_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2598_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2598_Lane2" name="Stock Associate">
        <bpmn:flowNodeRef>W2598_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2598_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2598_Start4" name="Daily store operations">
        <bpmn:outgoing>W2598_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2598_Task5" name="Maintenance Staff segregates daily store waste into categories…">
        <bpmn:documentation>Step 1: Maintenance Staff segregates daily store waste into categories: cardboard/paper, plastic, wood/pallets, metal, organic, general waste; uses color-coded bins per waste category
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 30–45 min/day</bpmn:documentation>
        <bpmn:incoming>W2598_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2598_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2598_Task6" name="Stock Associates manage sellable waste: damaged but repairable items marked for…">
        <bpmn:documentation>Step 2: Stock Associates manage sellable waste: damaged but repairable items marked for RTV, slightly damaged items for clearance sale, demo/display units for periodic sale event; routes items to appropriate disposition channel
Responsible (R): Stock Associate
Accountable (A): Department Supervisor
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W2598_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2598_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2598_Task7" name="Maintenance Staff compacts cardboard using on-site baler; stores compacted…">
        <bpmn:documentation>Step 3: Maintenance Staff compacts cardboard using on-site baler; stores compacted bales for scheduled recycler pickup; weighs and logs waste volumes per category in ERP sustainability module; Store Manager reviews daily waste volumes
Responsible (R): Maintenance Staff / Store Manager
Accountable (A): Store Manager
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W2598_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2598_End8" name="Complete">
        <bpmn:incoming>W2598_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2598_Annotation9">
        <bpmn:text>Controls: - CTL-26: control fixed-asset disposals — applies to any asset-grade item in the waste stream; operational control: dual-signoff on weekly waste-volume log by Maintenance Staff + Store Manager
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2598_Assoc10" sourceRef="W2598_Annotation9" targetRef="W2598_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2598_Flow11" sourceRef="W2598_Start4" targetRef="W2598_Task5" />
      <bpmn:sequenceFlow id="W2598_Flow12" sourceRef="W2598_Task5" targetRef="W2598_Task6" />
      <bpmn:sequenceFlow id="W2598_Flow13" sourceRef="W2598_Task6" targetRef="W2598_Task7" />
      <bpmn:sequenceFlow id="W2598_Flow14" sourceRef="W2598_Task7" targetRef="W2598_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2598_diag">
      <bpmndi:BPMNPlane id="W2598_plane" bpmnElement="W_W2598">
        <bpmndi:BPMNShape id="W2598_Lane1_di" bpmnElement="W2598_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Lane2_di" bpmnElement="W2598_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Task5_di" bpmnElement="W2598_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Task6_di" bpmnElement="W2598_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Task7_di" bpmnElement="W2598_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Start4_di" bpmnElement="W2598_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_End8_di" bpmnElement="W2598_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2598_Annotation9_di" bpmnElement="W2598_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2598_Flow11_di" bpmnElement="W2598_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2598_Flow12_di" bpmnElement="W2598_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2598_Flow13_di" bpmnElement="W2598_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2598_Flow14_di" bpmnElement="W2598_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2598_Assoc10_di" bpmnElement="W2598_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2599" name="W2599. Cardboard &amp; Paper Waste Baling &amp; Recycling Revenue" isExecutable="false">
      <bpmn:documentation>Trigger: Cardboard baler full or weekly recycling pickup
Frequency: Weekly per store
Volume: 200 stores × ~0.4–0.9 tons cardboard/month (per the W502 stream)
Owner: Maintenance Staff
Participants: Maintenance Staff, Store Manager, Recycling Vendor, Finance
Source: workflow W2599 — Cardboard &amp; Paper Waste Baling &amp; Recycling Revenue</bpmn:documentation>
      <bpmn:laneSet id="W2599_LaneSet4">
        <bpmn:lane id="W2599_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W2599_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2599_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2599_Lane2" name="Recycling Vendor">
        <bpmn:flowNodeRef>W2599_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2599_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2599_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2599_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2599_Start5" name="Cardboard baler full or weekly recycling pickup">
        <bpmn:outgoing>W2599_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2599_Task6" name="Maintenance Staff operates cardboard baler: breaks down all shipping cartons…">
        <bpmn:documentation>Step 1: Maintenance Staff operates cardboard baler: breaks down all shipping cartons from receiving, removes tape and staples, feeds into baler, secures bales with wire ties; stores bales in designated recycling area
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W2599_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2599_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2599_Task7" name="Recycling vendor collects bales per weekly schedule; weighs on certified scale…">
        <bpmn:documentation>Step 2: Recycling vendor collects bales per weekly schedule; weighs on certified scale; issues weight ticket; Maintenance Staff logs collection in ERP: weight, date, vendor, collection receipt number
Responsible (R): Recycling Vendor / Maintenance Staff
Accountable (A): Store Manager
Duration: 15 min/collection</bpmn:documentation>
        <bpmn:incoming>W2599_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2599_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2599_Task8" name="Finance processes recycling revenue: rates at PHP 2–4/kg for cardboard…">
        <bpmn:documentation>Step 3: Finance processes recycling revenue: rates at PHP 2–4/kg for cardboard; generates monthly recycling income report per store; annual recycling revenue ~PHP 10–43K per store (0.4–0.9 t/month × PHP 2–4/kg, per W502)
Responsible (R): Finance / Store Manager
Accountable (A): Finance Controller
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2599_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2599_End9" name="Complete">
        <bpmn:incoming>W2599_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2599_Annotation10">
        <bpmn:text>Controls: - CTL-44: detect/prevent duplicate payments — applies if recycler invoices rather than weight-ticket-settles; operational control: monthly Finance reconciliation of recycler payment vs. sum of logged weights
Owner: Maintenance Staff</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2599_Assoc11" sourceRef="W2599_Annotation10" targetRef="W2599_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2599_Flow12" sourceRef="W2599_Start5" targetRef="W2599_Task6" />
      <bpmn:sequenceFlow id="W2599_Flow13" sourceRef="W2599_Task6" targetRef="W2599_Task7" />
      <bpmn:sequenceFlow id="W2599_Flow14" sourceRef="W2599_Task7" targetRef="W2599_Task8" />
      <bpmn:sequenceFlow id="W2599_Flow15" sourceRef="W2599_Task8" targetRef="W2599_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2599_diag">
      <bpmndi:BPMNPlane id="W2599_plane" bpmnElement="W_W2599">
        <bpmndi:BPMNShape id="W2599_Lane1_di" bpmnElement="W2599_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Lane2_di" bpmnElement="W2599_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Lane3_di" bpmnElement="W2599_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Task6_di" bpmnElement="W2599_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Task7_di" bpmnElement="W2599_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Task8_di" bpmnElement="W2599_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Start5_di" bpmnElement="W2599_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_End9_di" bpmnElement="W2599_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2599_Annotation10_di" bpmnElement="W2599_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2599_Flow12_di" bpmnElement="W2599_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2599_Flow13_di" bpmnElement="W2599_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2599_Flow14_di" bpmnElement="W2599_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2599_Flow15_di" bpmnElement="W2599_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2599_Assoc11_di" bpmnElement="W2599_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2600" name="W2600. Plastic &amp; Shrink Wrap Waste Management" isExecutable="false">
      <bpmn:documentation>Trigger: Daily waste segregation cycle
Frequency: Daily per store
Volume: 200 stores × ~200 kg plastic/month
Owner: Maintenance Staff
Participants: Maintenance Staff, Sustainability Coordinator, Waste Vendor
Source: workflow W2600 — Plastic &amp; Shrink Wrap Waste Management</bpmn:documentation>
      <bpmn:laneSet id="W2600_LaneSet3">
        <bpmn:lane id="W2600_Lane1" name="Maintenance Staff">
        <bpmn:flowNodeRef>W2600_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2600_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2600_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2600_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2600_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2600_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2600_Start4" name="Daily waste segregation cycle">
        <bpmn:outgoing>W2600_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2600_Task5" name="Maintenance Staff collects and segregates plastic waste: shrink wrap, product…">
        <bpmn:documentation>Step 1: Maintenance Staff collects and segregates plastic waste: shrink wrap, product packaging plastic, plastic bags, stretch film; separates by recyclability (clean film vs. contaminated)
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 15–20 min/day</bpmn:documentation>
        <bpmn:incoming>W2600_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2600_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2600_Task6" name="Sustainability Coordinator evaluates plastic recycling options: identifies…">
        <bpmn:documentation>Step 2: Sustainability Coordinator evaluates plastic recycling options: identifies vendors accepting mixed plastics, negotiates collection rates, explores closed-loop programs with major vendors
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2600_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2600_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2600_Task7" name="Maintenance Staff tracks plastic waste volume in ERP sustainability module…">
        <bpmn:documentation>Step 3: Maintenance Staff tracks plastic waste volume in ERP sustainability module; Coordinator reports plastic diversion rate (target: &gt;60% recycled)
Responsible (R): Maintenance Staff / Sustainability Coordinator
Accountable (A): COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2600_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2600_End8" name="Complete">
        <bpmn:incoming>W2600_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2600_Annotation9">
        <bpmn:text>Controls: - CTL-448 (ensure controlled execution — Store Waste Segregation &amp; Collection (PA-73.1).) | - Operational control: quarterly Sustainability Coordinator audit of plastic segregation quality at sampled stores (feeds W2612 compliance audit)
Owner: Maintenance Staff</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2600_Assoc10" sourceRef="W2600_Annotation9" targetRef="W2600_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2600_Flow11" sourceRef="W2600_Start4" targetRef="W2600_Task5" />
      <bpmn:sequenceFlow id="W2600_Flow12" sourceRef="W2600_Task5" targetRef="W2600_Task6" />
      <bpmn:sequenceFlow id="W2600_Flow13" sourceRef="W2600_Task6" targetRef="W2600_Task7" />
      <bpmn:sequenceFlow id="W2600_Flow14" sourceRef="W2600_Task7" targetRef="W2600_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2600_diag">
      <bpmndi:BPMNPlane id="W2600_plane" bpmnElement="W_W2600">
        <bpmndi:BPMNShape id="W2600_Lane1_di" bpmnElement="W2600_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2600_Lane2_di" bpmnElement="W2600_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2600_Task5_di" bpmnElement="W2600_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
