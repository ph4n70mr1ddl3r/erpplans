    <bpmn:process id="W_W2605" name="W2605. Store Waste Analytics &amp; Reduction Target Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly sustainability reporting cycle
Frequency: Monthly
Volume: 200 stores
Owner: Sustainability Coordinator
Participants: Sustainability Coordinator, Store Managers, COO
Source: workflow W2605 — Store Waste Analytics &amp; Reduction Target Management</bpmn:documentation>
      <bpmn:laneSet id="W2605_LaneSet3">
        <bpmn:lane id="W2605_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2605_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2605_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2605_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2605_Lane2" name="COO">
        <bpmn:flowNodeRef>W2605_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2605_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2605_Start4" name="Monthly sustainability reporting cycle">
        <bpmn:outgoing>W2605_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2605_Task5" name="Sustainability Coordinator compiles store waste analytics: waste generated per…">
        <bpmn:documentation>Step 1: Sustainability Coordinator compiles store waste analytics: waste generated per store by category, waste diversion rate, recycling revenue, disposal cost, waste per sqm; benchmarks stores against each other
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2605_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2605_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2605_Task6" name="Coordinator identifies top and bottom performing stores; investigates…">
        <bpmn:documentation>Step 2: Coordinator identifies top and bottom performing stores; investigates high-waste stores; implements targeted reduction programs
Responsible (R): Sustainability Coordinator / Store Manager
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2605_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2605_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2605_Task7" name="COO reviews waste reduction progress vs. annual targets (diversion rate: 60%…">
        <bpmn:documentation>Step 3: COO reviews waste reduction progress vs. annual targets (diversion rate: 60%, recycling revenue growth: 10%, waste-to-landfill reduction: 15%)
Responsible (R): COO
Accountable (A): COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2605_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2605_End8" name="Complete">
        <bpmn:incoming>W2605_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2605_Annotation9">
        <bpmn:text>Controls: - CTL-34 analog (statutory/ESG reporting accuracy — reconciliation discipline); operational control: COO sign-off on monthly metric pack before ESG rollup
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
