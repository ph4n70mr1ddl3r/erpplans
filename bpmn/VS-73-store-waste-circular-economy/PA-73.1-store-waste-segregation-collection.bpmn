        <bpmndi:BPMNShape id="W2600_End8_di" bpmnElement="W2600_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2600_Annotation9_di" bpmnElement="W2600_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2600_Flow11_di" bpmnElement="W2600_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2600_Flow12_di" bpmnElement="W2600_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2600_Flow13_di" bpmnElement="W2600_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2600_Flow14_di" bpmnElement="W2600_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2600_Assoc10_di" bpmnElement="W2600_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2601" name="W2601. Pallet &amp; Wood Waste Recovery &amp; Reuse" isExecutable="false">
      <bpmn:documentation>Trigger: Pallet accumulation at receiving dock
Frequency: Weekly per store
Volume: 200 stores × ~50 pallets/month
Owner: Receiving Clerk
Participants: Receiving Clerk, Maintenance Staff, Logistics, Store Manager
Source: workflow W2601 — Pallet &amp; Wood Waste Recovery &amp; Reuse</bpmn:documentation>
      <bpmn:laneSet id="W2601_LaneSet4">
        <bpmn:lane id="W2601_Lane1" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2601_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2601_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2601_Lane2" name="Maintenance Staff">
        <bpmn:flowNodeRef>W2601_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2601_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W2601_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2601_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2601_Start5" name="Pallet accumulation at receiving dock">
        <bpmn:outgoing>W2601_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2601_Task6" name="Receiving Clerk manages pallet accumulation: sorts by condition — reusable…">
        <bpmn:documentation>Step 1: Receiving Clerk manages pallet accumulation: sorts by condition — reusable, repairable, waste; reusable pallets staged for vendor pickup or DC return
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 15 min/shipment</bpmn:documentation>
        <bpmn:incoming>W2601_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2601_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2601_Task7" name="Maintenance Staff repairs damaged pallets; repurposes irreparable pallet wood…">
        <bpmn:documentation>Step 2: Maintenance Staff repairs damaged pallets; repurposes irreparable pallet wood for store displays, garden center planters, or customer DIY project bins
Responsible (R): Maintenance Staff
Accountable (A): Store Manager
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W2601_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2601_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2601_Task8" name="Logistics tracks pallet return rate to DC: target &gt;80% returned or reused…">
        <bpmn:documentation>Step 3: Logistics tracks pallet return rate to DC: target &gt;80% returned or reused; Store Manager logs pallet inventory and disposition in ERP
Responsible (R): Logistics / Store Manager
Accountable (A): VP Supply Chain
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2601_Flow14</bpmn:incoming>
      </bpmn:userTask>
