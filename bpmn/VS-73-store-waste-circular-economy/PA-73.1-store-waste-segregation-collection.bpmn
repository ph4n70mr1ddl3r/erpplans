    <bpmn:process id="W_W2604" name="W2604. Construction &amp; Renovation Waste Management" isExecutable="false">
      <bpmn:documentation>Trigger: Store renovation or construction project
Frequency: Event-driven; 10–15 renovations/year
Volume: 10–15 events/year
Owner: Facilities Manager
Participants: Facilities Mgr, Contractor, Sustainability Coordinator, Store Manager
Source: workflow W2604 — Construction &amp; Renovation Waste Management</bpmn:documentation>
      <bpmn:laneSet id="W2604_LaneSet3">
        <bpmn:lane id="W2604_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W2604_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2604_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2604_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2604_Lane2" name="Contractor">
        <bpmn:flowNodeRef>W2604_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2604_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2604_Start4" name="Store renovation or construction project">
        <bpmn:outgoing>W2604_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2604_Task5" name="Facilities Manager includes waste management plan in renovation project spec…">
        <bpmn:documentation>Step 1: Facilities Manager includes waste management plan in renovation project spec: requires contractor to segregate waste, use certified waste haulers, comply with DENR construction waste regulations
Responsible (R): Facilities Manager / Contractor
Accountable (A): COO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W2604_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2604_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2604_Task6" name="Contractor executes waste segregation during renovation; Sustainability…">
        <bpmn:documentation>Step 2: Contractor executes waste segregation during renovation; Sustainability Coordinator spot-checks compliance
Responsible (R): Contractor / Sustainability Coordinator
Accountable (A): Facilities Manager
Duration: Throughout project</bpmn:documentation>
        <bpmn:incoming>W2604_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2604_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2604_Task7" name="Facilities Manager compiles waste diversion report: total waste generated, %…">
        <bpmn:documentation>Step 3: Facilities Manager compiles waste diversion report: total waste generated, % diverted from landfill (target: &gt;50%), recycling revenue, disposal costs
Responsible (R): Facilities Manager
Accountable (A): COO
Duration: Post-project</bpmn:documentation>
        <bpmn:incoming>W2604_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2604_End8" name="Complete">
        <bpmn:incoming>W2604_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2604_Annotation9">
        <bpmn:text>Controls: - CTL-06: certified-hauler vendor onboarding; operational control: post-project diversion report reconciled to hauler manifests
Owner: Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
