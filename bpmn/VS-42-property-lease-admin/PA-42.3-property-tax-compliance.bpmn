    <bpmn:process id="W_W1876" name="W1876. Fire Safety Inspection &amp; Bureau of Fire Protection (BFP) Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual BFP fire safety inspection; new store fire safety permit application
Frequency: Annual inspection per location; new store permit per W702
Volume: ~205 locations
Owner: Store Manager
Participants: Store Manager, COO, Safety Officer, BFP Inspector
Source: workflow W1876 — Fire Safety Inspection &amp; Bureau of Fire Protection (BFP) Compliance</bpmn:documentation>
      <bpmn:laneSet id="W1876_LaneSet3">
        <bpmn:lane id="W1876_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1876_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1876_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1876_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1876_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1876_Lane2" name="BFP Inspector">
        <bpmn:flowNodeRef>W1876_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1876_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1876_Start4" name="Annual BFP fire safety inspection; new store fire safety permit application">
        <bpmn:outgoing>W1876_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1876_Task5" name="Store Manager prepares for annual BFP inspection: (a) verify fire extinguishers…">
        <bpmn:documentation>Step 1: Store Manager prepares for annual BFP inspection: (a) verify fire extinguishers are serviced and tagged (per W1051 monthly inspection + annual recharge), (b) verify fire exits are unobstructed and properly marked, (c) verify fire alarm system is functional (test monthly, document), (d) verify sprinkler system (if installed) is serviced and pressure-tested, (e) verify emergency lighting is functional, (f) verify fire safety signage is visible and current, (g) verify storage practices comply with fire code (no combustible materials near electrical panels, proper storage of paint and chemicals per W24.3 hazmat management)
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1 day/year per store</bpmn:documentation>
        <bpmn:incoming>W1876_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1876_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1876_Task6" name="BFP conducts fire safety inspection: (a) Store Manager provides access and…">
        <bpmn:documentation>Step 2: BFP conducts fire safety inspection: (a) Store Manager provides access and accompanies inspector, (b) inspector checks: fire exits, fire extinguishers, fire alarm, emergency lighting, electrical safety, storage practices, occupancy load compliance, (c) inspector issues Fire Safety Inspection Certificate (FSIC) if compliant, or notice of violation with required corrective actions and deadline
Responsible (R): BFP Inspector / Store Manager
Accountable (A): VP Store Operations
Duration: 2–4 hours per store</bpmn:documentation>
        <bpmn:incoming>W1876_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1876_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1876_Task7" name="If violations found: (a) Store Manager implements corrective actions within BFP…">
        <bpmn:documentation>Step 3: If violations found: (a) Store Manager implements corrective actions within BFP deadline (typically 15–30 days), (b) if corrective action requires physical modification: coordinate with COO for facility maintenance per W47, (c) request BFP re-inspection after corrections completed, (d) obtain FSIC
Responsible (R): Store Manager / COO
Accountable (A): VP Store Operations
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1876_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1876_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1876_Task8" name="FSIC is prerequisite for business permit renewal per W1871; Store Manager…">
        <bpmn:documentation>Step 4: FSIC is prerequisite for business permit renewal per W1871; Store Manager provides FSIC to Regulatory Officer for renewal application
Responsible (R): Store Manager
Accountable (A): Regulatory Officer
Duration: Per W1871</bpmn:documentation>
        <bpmn:incoming>W1876_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1876_End9" name="Complete">
        <bpmn:incoming>W1876_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1876_Annotation10">
        <bpmn:text>Controls: - CTL-369 (ensure controlled execution — Property Tax, LGU Compliance &amp; Lease Accounting (PA-42.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1876_Assoc11" sourceRef="W1876_Annotation10" targetRef="W1876_Start4" associationDirection="None" />
