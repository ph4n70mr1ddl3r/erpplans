      <bpmndi:BPMNPlane id="W1875_plane" bpmnElement="W_W1875">
        <bpmndi:BPMNShape id="W1875_Lane1_di" bpmnElement="W1875_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
