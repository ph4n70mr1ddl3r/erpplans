      <bpmn:sequenceFlow id="W1876_Flow14" sourceRef="W1876_Task6" targetRef="W1876_Task7" />
      <bpmn:sequenceFlow id="W1876_Flow15" sourceRef="W1876_Task7" targetRef="W1876_Task8" />
      <bpmn:sequenceFlow id="W1876_Flow16" sourceRef="W1876_Task8" targetRef="W1876_End9" />
    </bpmn:process>
