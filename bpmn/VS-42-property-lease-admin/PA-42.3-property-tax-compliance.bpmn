      <bpmn:sequenceFlow id="W1875_Flow12" sourceRef="W1875_Task5" targetRef="W1875_Task6" />
      <bpmn:sequenceFlow id="W1875_Flow13" sourceRef="W1875_Task6" targetRef="W1875_End7" />
    </bpmn:process>
