<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-42.3-property-tax-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1870" name="W1870. Real Property Tax (RPT) Assessment Review &amp; Payment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual RPT assessment notice from LGU; quarterly RPT payment due dates
Frequency: Annual assessment review; quarterly payments (Jan 31, Apr 30, Jul 31, Oct 31)
Volume: ~205 properties across ~50+ LGUs (municipalities/cities)
Owner: Tax Accountant
Participants: Tax Accountant, Lease Administrator, COO, Finance
Source: workflow W1870 — Real Property Tax (RPT) Assessment Review &amp; Payment</bpmn:documentation>
      <bpmn:laneSet id="W1870_LaneSet3">
        <bpmn:lane id="W1870_Lane1" name="LGU">
        <bpmn:flowNodeRef>W1870_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1870_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1870_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W1870_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1870_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1870_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1870_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1870_Start4" name="Annual RPT assessment notice from LGU; quarterly RPT payment due dates">
        <bpmn:outgoing>W1870_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1870_Task5" name="LGU issues RPT assessment notice: (a) assessed value of land and improvement…">
        <bpmn:documentation>Step 1: LGU issues RPT assessment notice: (a) assessed value of land and improvement, (b) tax rate applied (typically 1–2% of assessed value for commercial properties per LGU schedule), (c) annual RPT amount due, (d) payment schedule (quarterly installments; 10% discount for advance annual payment in some LGUs)
Responsible (R): LGU
Accountable (A): —
Duration: External</bpmn:documentation>
        <bpmn:incoming>W1870_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1870_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1870_Task6" name="Tax Accountant reviews assessment: (a) compare assessed value to previous year…">
        <bpmn:documentation>Step 2: Tax Accountant reviews assessment: (a) compare assessed value to previous year — flag significant increases (&gt; 10%) for protest evaluation, (b) verify property classification (commercial vs. industrial) — incorrect classification results in higher tax rate, (c) verify property area measurements match lease agreement, (d) if assessment appears excessive: (i) file protest with LGU Assessor&#x27;s Office within 60 days per Local Government Code, (ii) engage appraiser for independent valuation if contested amount is material (&gt; PHP 100K annual difference), (e) determine if RPT is BuildRight or landlord responsibility per lease terms (most leases: landlord responsible for land RPT; BuildRight responsible for improvement RPT if tenant-built improvements)
Responsible (R): Tax Accountant
Accountable (A): Finance Manager
Duration: 1–2 hours/property</bpmn:documentation>
        <bpmn:incoming>W1870_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1870_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1870_Task7" name="Tax Accountant processes quarterly RPT payments: (a) generate payment schedule…">
        <bpmn:documentation>Step 3: Tax Accountant processes quarterly RPT payments: (a) generate payment schedule for all properties with LGU, tax declaration number, amount, and due date, (b) process payment per LGU acceptance method: over-the-counter at LGU treasury, online payment (if available), or authorized agent bank, (c) obtain official receipt and update tax payment records, (d) file proof of payment with LGU to maintain good standing
Responsible (R): Tax Accountant
Accountable (A): Finance Manager
Duration: 2–4 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1870_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1870_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1870_Task8" name="Annual: Tax Accountant reconciles total RPT payments vs. budget and flags…">
        <bpmn:documentation>Step 4: Annual: Tax Accountant reconciles total RPT payments vs. budget and flags significant variances to COO and CFO
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1870_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1870_End9" name="Complete">
        <bpmn:incoming>W1870_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1870_Annotation10">
        <bpmn:text>Controls: - CTL-369 (ensure controlled execution — Property Tax, LGU Compliance &amp; Lease Accounting (PA-42.3).) | - operational: Tax Accountant review and approval gate; operational: periodic reconciliation against source documents
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1870_Assoc11" sourceRef="W1870_Annotation10" targetRef="W1870_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1870_Flow12" sourceRef="W1870_Start4" targetRef="W1870_Task5" />
      <bpmn:sequenceFlow id="W1870_Flow13" sourceRef="W1870_Task5" targetRef="W1870_Task6" />
      <bpmn:sequenceFlow id="W1870_Flow14" sourceRef="W1870_Task6" targetRef="W1870_Task7" />
      <bpmn:sequenceFlow id="W1870_Flow15" sourceRef="W1870_Task7" targetRef="W1870_Task8" />
      <bpmn:sequenceFlow id="W1870_Flow16" sourceRef="W1870_Task8" targetRef="W1870_End9" />
    </bpmn:process>
