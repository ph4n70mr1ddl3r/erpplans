    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1872" name="W1872. PFRS 16 Lease Accounting — Month-End Processing &amp; Disclosure" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close cycle (W9A)
Frequency: Monthly
Volume: ~205 active leases across 5 legal entities
Owner: Finance (Lease Accounting Specialist)
Participants: Lease Accounting Specialist, Finance Manager, Controller, External Auditor
Source: workflow W1872 — PFRS 16 Lease Accounting — Month-End Processing &amp; Disclosure</bpmn:documentation>
      <bpmn:laneSet id="W1872_LaneSet2">
        <bpmn:lane id="W1872_Lane1" name="Lease Accounting Specialist">
        <bpmn:flowNodeRef>W1872_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1872_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1872_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1872_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1872_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1872_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1872_Start3" name="Month-end close cycle (W9A)">
        <bpmn:outgoing>W1872_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1872_Task4" name="Month-end: Lease Accounting Specialist processes PFRS 16 journal entries: (a)…">
        <bpmn:documentation>Step 1: Month-end: Lease Accounting Specialist processes PFRS 16 journal entries: (a) lease depreciation: Dr. Depreciation Expense / Cr. Accumulated Depreciation — ROU Assets (straight-line over lease term), (b) lease interest expense: Dr. Interest Expense / Cr. Lease Liability (effective interest method on lease liability balance), (c) variable lease payments (CAM, percentage rent): expensed as incurred — Dr. Rent Expense / Cr. Cash, (d) short-term and low-value leases (≤ 12 months with no purchase option, or low-value &lt; USD 5,000 ≈ PHP 280K, per the VS-148 policy): exempted from PFRS 16 recognition; expensed straight-line — Dr. Rent Expense / Cr. Cash
Responsible (R): Lease Accounting Specialist
Accountable (A): Controller
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W1872_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1872_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1872_Task5" name="Month-end: process lease modifications, terminations, and new leases: (a) new…">
        <bpmn:documentation>Step 2: Month-end: process lease modifications, terminations, and new leases: (a) new leases (W1854): recognize ROU asset and lease liability at present value of future lease payments, (b) lease modifications (W1859): remeasure liability using revised discount rate; adjust ROU asset, (c) lease terminations (W1857): derecognize ROU asset and liability; recognize termination gain/loss, (d) rent escalations (W1863): remeasure liability using revised cash flows
Responsible (R): Lease Accounting Specialist
Accountable (A): Controller
Duration: 1–2 days/month</bpmn:documentation>
        <bpmn:incoming>W1872_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1872_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1872_Task6" name="Quarter-end: prepare PFRS 16 disclosure schedules: (a) reconciliation of…">
        <bpmn:documentation>Step 3: Quarter-end: prepare PFRS 16 disclosure schedules: (a) reconciliation of opening and closing lease liabilities, (b) ROU asset movements: additions, depreciation, disposals, impairments, (c) maturity analysis of undiscounted lease payments: ≤ 1 year, 1–5 years, &gt; 5 years, (d) total lease expense: depreciation, interest, variable payments, short-term lease expense, (e) weighted-average lease term and discount rate, (f) extension and termination options exercise data, (g) provide to Controller for financial statement note preparation per W9A
Responsible (R): Lease Accounting Specialist
Accountable (A): Controller
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1872_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1872_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1872_Task7" name="Year-end: coordinate with External Auditor on PFRS 16 testing: (a) provide…">
        <bpmn:documentation>Step 4: Year-end: coordinate with External Auditor on PFRS 16 testing: (a) provide lease population and sampling support, (b) support auditor testing of discount rate assumptions, lease term assessments, and modification accounting, (c) resolve auditor queries on complex leases (e.g., options to extend/terminate, variable payment structures)
Responsible (R): Lease Accounting Specialist / Controller
Accountable (A): CFO
Duration: 1–2 weeks/year</bpmn:documentation>
        <bpmn:incoming>W1872_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1872_End8" name="Complete">
        <bpmn:incoming>W1872_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1872_Annotation9">
        <bpmn:text>Controls: - CTL-220 (ensure lease-administration &amp; PFRS 16 integrity.) | - operational: periodic reconciliation against source documents
Owner: Finance (Lease Accounting Specialist)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1872_Assoc10" sourceRef="W1872_Annotation9" targetRef="W1872_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1872_Flow11" sourceRef="W1872_Start3" targetRef="W1872_Task4" />
      <bpmn:sequenceFlow id="W1872_Flow12" sourceRef="W1872_Task4" targetRef="W1872_Task5" />
      <bpmn:sequenceFlow id="W1872_Flow13" sourceRef="W1872_Task5" targetRef="W1872_Task6" />
      <bpmn:sequenceFlow id="W1872_Flow14" sourceRef="W1872_Task6" targetRef="W1872_Task7" />
      <bpmn:sequenceFlow id="W1872_Flow15" sourceRef="W1872_Task7" targetRef="W1872_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1872_diag">
      <bpmndi:BPMNPlane id="W1872_plane" bpmnElement="W_W1872">
        <bpmndi:BPMNShape id="W1872_Lane1_di" bpmnElement="W1872_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Task4_di" bpmnElement="W1872_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Task5_di" bpmnElement="W1872_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Task6_di" bpmnElement="W1872_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Task7_di" bpmnElement="W1872_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Start3_di" bpmnElement="W1872_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_End8_di" bpmnElement="W1872_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1872_Annotation9_di" bpmnElement="W1872_Annotation9"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1872_Flow11_di" bpmnElement="W1872_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
