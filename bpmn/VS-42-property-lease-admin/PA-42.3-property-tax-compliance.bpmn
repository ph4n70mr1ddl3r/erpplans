    <bpmn:process id="W_W1871" name="W1871. Local Business Tax (LBT) &amp; LGU Permit Renewal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual business permit renewal deadline (typically January 20 per LGU)
Frequency: Annual renewal per LGU; quarterly LBT payments
Volume: ~205 locations across ~50+ LGUs
Owner: Regulatory Officer / Tax Accountant
Participants: Regulatory Officer, Tax Accountant, Legal Counsel, Store Managers
Source: workflow W1871 — Local Business Tax (LBT) &amp; LGU Permit Renewal Management</bpmn:documentation>
      <bpmn:laneSet id="W1871_LaneSet2">
        <bpmn:lane id="W1871_Lane1" name="Regulatory Officer">
        <bpmn:flowNodeRef>W1871_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1871_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1871_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1871_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1871_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1871_Start3" name="Annual business permit renewal deadline (typically January 20 per LGU)">
        <bpmn:outgoing>W1871_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1871_Task4" name="October: Regulatory Officer initiates annual renewal preparation: (a) compile…">
        <bpmn:documentation>Step 1: October: Regulatory Officer initiates annual renewal preparation: (a) compile list of all business permits expiring December 31, (b) verify required documents per LGU: (i) DTI/SEC registration, (ii) BIR registration certificate, (iii) SSS/PhilHealth/Pag-IBIG employer registration, (iv) barangay clearance, (v) fire safety inspection certificate (BFP), (vi) sanitation permit (city health office), (vii) building occupancy permit, (viii) previous year&#x27;s LBT payment receipts, (ix) lease contract or proof of business address, (c) coordinate with Store Managers to obtain barangay clearances and local inspections
Responsible (R): Regulatory Officer
Accountable (A): VP Legal
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1871_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1871_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1871_Task5" name="January: Regulatory Officer submits renewal applications to LGUs: (a) file…">
        <bpmn:documentation>Step 2: January: Regulatory Officer submits renewal applications to LGUs: (a) file business permit renewal per LGU schedule (most require submission by January 5–20), (b) pay LBT for the year (based on gross receipts from previous year per LGU tax ordinance), (c) obtain renewed business permit and mayor&#x27;s permit, (d) distribute renewed permits to stores for display per Consumer Act RA 7394 requirement
Responsible (R): Regulatory Officer
Accountable (A): VP Legal
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1871_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1871_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1871_Task6" name="Ongoing: Regulatory Officer monitors LGU compliance throughout the year: (a)…">
        <bpmn:documentation>Step 3: Ongoing: Regulatory Officer monitors LGU compliance throughout the year: (a) new store opening: obtain business permit before store opening per W702, (b) store closure: notify LGU and cancel business permit per W703, (c) LGU inspection responses: coordinate with Store Manager for any LGU inspections (sanitary, fire safety, building, trade and industry) per W22.2, (d) track new LGU ordinances affecting business operations
Responsible (R): Regulatory Officer
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1871_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1871_End7" name="Complete">
        <bpmn:incoming>W1871_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1871_Annotation8">
        <bpmn:text>Controls: - CTL-369 (ensure controlled execution — Property Tax, LGU Compliance &amp; Lease Accounting (PA-42.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Regulatory Officer / Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1871_Assoc9" sourceRef="W1871_Annotation8" targetRef="W1871_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1871_Flow10" sourceRef="W1871_Start3" targetRef="W1871_Task4" />
      <bpmn:sequenceFlow id="W1871_Flow11" sourceRef="W1871_Task4" targetRef="W1871_Task5" />
