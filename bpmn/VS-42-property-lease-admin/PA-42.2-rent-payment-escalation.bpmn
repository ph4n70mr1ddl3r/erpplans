    <bpmn:process id="W_W1865" name="W1865. Percentage Rent Calculation &amp; Payment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual sales threshold exceeded per percentage rent clause in lease agreement
Frequency: Annual calculation per lease with percentage rent clause
Volume: ~50–80 leases include percentage rent clauses (common in mall-based and mixed-use developments)
Owner: FP&amp;A
Participants: FP&amp;A, Lease Administrator, Finance, COO
Source: workflow W1865 — Percentage Rent Calculation &amp; Payment</bpmn:documentation>
      <bpmn:laneSet id="W1865_LaneSet4">
        <bpmn:lane id="W1865_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1865_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1865_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1865_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1865_Lane2" name="Lease Administrator">
        <bpmn:flowNodeRef>W1865_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1865_Lane3" name="Finance">
        <bpmn:flowNodeRef>W1865_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1865_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1865_Start5" name="Annual sales threshold exceeded per percentage rent clause in lease agreement">
        <bpmn:outgoing>W1865_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1865_Task6" name="FP&amp;A calculates annual store sales per location: (a) total gross sales from POS…">
        <bpmn:documentation>Step 1: FP&amp;A calculates annual store sales per location: (a) total gross sales from POS and ecommerce data for the store location, (b) apply exclusions per lease: (i) sales tax (VAT) excluded, (ii) returns and refunds excluded, (iii) employee discount sales may be excluded (per lease terms), (iv) gift card sales excluded until redemption, (c) calculate adjusted gross sales for percentage rent purposes
Responsible (R): FP&amp;A
Accountable (A): Finance Manager
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W1865_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1865_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1865_Task7" name="FP&amp;A calculates percentage rent liability per lease: (a) compare adjusted gross…">
        <bpmn:documentation>Step 2: FP&amp;A calculates percentage rent liability per lease: (a) compare adjusted gross sales to breakpoint (sales threshold above which percentage rent applies): natural breakpoint (where % rent = base rent) or artificial breakpoint (specified dollar amount), (b) if sales exceed breakpoint: percentage rent = (adjusted gross sales − breakpoint) × percentage rate (typically 2–6% for retail leases), (c) if sales below breakpoint: no additional percentage rent owed, (d) FP&amp;A prepares percentage rent calculation with supporting sales data for each applicable lease
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1865_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1865_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1865_Task8" name="Lease Administrator submits sales certification to landlord: (a) some leases…">
        <bpmn:documentation>Step 3: Lease Administrator submits sales certification to landlord: (a) some leases require BuildRight to certify annual sales to landlord, (b) if percentage rent owed: Lease Administrator coordinates payment with Finance, (c) if landlord disputes sales figure: provide detailed POS transaction data as supporting documentation
Responsible (R): Lease Administrator
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1865_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1865_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1865_Task9" name="Finance processes percentage rent payment: (a) accrue percentage rent liability…">
        <bpmn:documentation>Step 4: Finance processes percentage rent payment: (a) accrue percentage rent liability monthly based on sales-to-date trend (avoid large year-end surprise), (b) actual payment made after annual calculation completed, (c) Dr. Rent Expense / Cr. Cash
Responsible (R): Finance
Accountable (A): CFO
Duration: Per AP process</bpmn:documentation>
        <bpmn:incoming>W1865_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1865_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1865_End10" name="Complete">
        <bpmn:incoming>W1865_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1865_Annotation11">
        <bpmn:text>Controls: - CTL-220 (ensure lease-administration &amp; PFRS 16 integrity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1865_Assoc12" sourceRef="W1865_Annotation11" targetRef="W1865_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1865_Flow13" sourceRef="W1865_Start5" targetRef="W1865_Task6" />
      <bpmn:sequenceFlow id="W1865_Flow14" sourceRef="W1865_Task6" targetRef="W1865_Task7" />
      <bpmn:sequenceFlow id="W1865_Flow15" sourceRef="W1865_Task7" targetRef="W1865_Task8" />
      <bpmn:sequenceFlow id="W1865_Flow16" sourceRef="W1865_Task8" targetRef="W1865_Task9" />
      <bpmn:sequenceFlow id="W1865_Flow17" sourceRef="W1865_Task9" targetRef="W1865_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1865_diag">
      <bpmndi:BPMNPlane id="W1865_plane" bpmnElement="W_W1865">
        <bpmndi:BPMNShape id="W1865_Lane1_di" bpmnElement="W1865_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1865_Lane2_di" bpmnElement="W1865_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1865_Lane3_di" bpmnElement="W1865_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1865_Task6_di" bpmnElement="W1865_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1865_Task7_di" bpmnElement="W1865_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
