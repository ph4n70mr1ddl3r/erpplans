      <bpmndi:BPMNPlane id="W1864_plane" bpmnElement="W_W1864">
        <bpmndi:BPMNShape id="W1864_Lane1_di" bpmnElement="W1864_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
