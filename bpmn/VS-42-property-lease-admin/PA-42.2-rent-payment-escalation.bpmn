        <bpmndi:BPMNEdge id="W1865_Flow14_di" bpmnElement="W1865_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1865_Flow15_di" bpmnElement="W1865_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1865_Flow16_di" bpmnElement="W1865_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1865_Flow17_di" bpmnElement="W1865_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1865_Assoc12_di" bpmnElement="W1865_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1866" name="W1866. Rent Abatement &amp; Concession Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Lease clause providing rent abatement (e.g., first 3 months rent-free during fit-out); force majeure event (typhoon damage); negotiated concession
Frequency: Occasional — ~5–10 abatement events/year
Volume: Per lease
Owner: Lease Administrator
Participants: Lease Administrator, COO, Finance, Legal Counsel
Source: workflow W1866 — Rent Abatement &amp; Concession Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1866_LaneSet3">
        <bpmn:lane id="W1866_Lane1" name="Lease Administrator">
        <bpmn:flowNodeRef>W1866_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1866_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1866_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1866_Lane2" name="Finance">
        <bpmn:flowNodeRef>W1866_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1866_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1866_Start4" name="Lease clause providing rent abatement (e.g., first 3 months rent-free during fit-out)…">
        <bpmn:outgoing>W1866_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1866_Task5" name="Lease Administrator identifies abatement eligibility: (a) rent-free period…">
        <bpmn:documentation>Step 1: Lease Administrator identifies abatement eligibility: (a) rent-free period during tenant fit-out (typically 3–6 months for new leases), (b) rent reduction during building damage or landlord-caused disruption (e.g., roof repair blocking sales floor), (c) force majeure abatement per lease clause (typhoon, earthquake rendering premises unusable), (d) negotiated concession (e.g., rent reduction agreed during COVID-19 or economic downturn)
Responsible (R): Lease Administrator
Accountable (A): COO
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W1866_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1866_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1866_Task6" name="Lease Administrator confirms abatement with landlord in writing: (a) specify…">
        <bpmn:documentation>Step 2: Lease Administrator confirms abatement with landlord in writing: (a) specify abatement period, amount, and conditions, (b) obtain landlord written acknowledgment, (c) if force majeure: document event impact with photographs, insurance claims, and store closure records
Responsible (R): Lease Administrator
Accountable (A): Legal Counsel
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1866_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1866_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1866_Task7" name="Finance processes abatement: (a) skip or reduce rent payment for abatement…">
        <bpmn:documentation>Step 3: Finance processes abatement: (a) skip or reduce rent payment for abatement period, (b) if already paid: process rent credit from landlord against future rent, (c) PFRS 16 impact: remeasure lease liability if abatement changes lease cash flows, (d) track abatement value for lease negotiation leverage at renewal
Responsible (R): Finance
Accountable (A): CFO
Duration: Per accounting process</bpmn:documentation>
        <bpmn:incoming>W1866_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1866_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1866_End8" name="Complete">
        <bpmn:incoming>W1866_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1866_Annotation9">
        <bpmn:text>Controls: - CTL-368 (ensure controlled execution — Rent Payment, Escalation &amp; CAM Reconciliation (PA-42.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Lease Administrator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1866_Assoc10" sourceRef="W1866_Annotation9" targetRef="W1866_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1866_Flow11" sourceRef="W1866_Start4" targetRef="W1866_Task5" />
      <bpmn:sequenceFlow id="W1866_Flow12" sourceRef="W1866_Task5" targetRef="W1866_Task6" />
      <bpmn:sequenceFlow id="W1866_Flow13" sourceRef="W1866_Task6" targetRef="W1866_Task7" />
      <bpmn:sequenceFlow id="W1866_Flow14" sourceRef="W1866_Task7" targetRef="W1866_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1866_diag">
      <bpmndi:BPMNPlane id="W1866_plane" bpmnElement="W_W1866">
        <bpmndi:BPMNShape id="W1866_Lane1_di" bpmnElement="W1866_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Lane2_di" bpmnElement="W1866_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Task5_di" bpmnElement="W1866_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Task6_di" bpmnElement="W1866_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Task7_di" bpmnElement="W1866_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Start4_di" bpmnElement="W1866_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_End8_di" bpmnElement="W1866_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1866_Annotation9_di" bpmnElement="W1866_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1866_Flow11_di" bpmnElement="W1866_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1866_Flow12_di" bpmnElement="W1866_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1866_Flow13_di" bpmnElement="W1866_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1866_Flow14_di" bpmnElement="W1866_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1866_Assoc10_di" bpmnElement="W1866_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1867" name="W1867. Security Deposit Management &amp; Return Processing" isExecutable="false">
      <bpmn:documentation>Trigger: New lease execution (deposit collection); lease termination (deposit return)
Frequency: ~10–15 new deposits/year; ~2–5 deposit returns/year
Volume: ~205 active security deposits on file
Owner: Lease Administrator
Participants: Lease Administrator, Finance, Legal Counsel, Landlord
Source: workflow W1867 — Security Deposit Management &amp; Return Processing</bpmn:documentation>
      <bpmn:laneSet id="W1867_LaneSet4">
        <bpmn:lane id="W1867_Lane1" name="Finance">
        <bpmn:flowNodeRef>W1867_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1867_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1867_Lane2" name="Lease Administrator">
        <bpmn:flowNodeRef>W1867_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1867_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1867_Lane3" name="Legal Counsel">
        <bpmn:flowNodeRef>W1867_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1867_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1867_Start5" name="New lease execution (deposit collection); lease termination (deposit return)">
        <bpmn:outgoing>W1867_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1867_Task6" name="At lease execution: Finance processes security deposit payment to landlord: (a)…">
        <bpmn:documentation>Step 1: At lease execution: Finance processes security deposit payment to landlord: (a) amount per lease terms (typically 2–3 months&#x27; rent), (b) payment method: cash, check, or bank guarantee, (c) record deposit in security deposit tracking module: lease number, amount, payment date, expected return conditions
Responsible (R): Finance
Accountable (A): CFO
Duration: Per payment process</bpmn:documentation>
        <bpmn:incoming>W1867_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1867_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1867_Task7" name="Ongoing: Lease Administrator monitors security deposit adequacy: (a) some…">
        <bpmn:documentation>Step 2: Ongoing: Lease Administrator monitors security deposit adequacy: (a) some leases require deposit top-up if rent escalates and deposit is expressed as months&#x27; rent (deposit = 3 months&#x27; rent; after escalation, deposit should increase to reflect new rent level), (b) if top-up required: Lease Administrator coordinates with Finance
Responsible (R): Lease Administrator
Accountable (A): Finance
Duration: Annual review</bpmn:documentation>
        <bpmn:incoming>W1867_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1867_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1867_Task8" name="At lease termination: (a) COO coordinates property handover with landlord per…">
        <bpmn:documentation>Step 3: At lease termination: (a) COO coordinates property handover with landlord per W1857; document property condition with photographs, (b) Lease Administrator formally requests security deposit return from landlord within 30 days of lease termination per lease terms, (c) landlord may deduct: (i) unpaid rent or CAM charges, (ii) property restoration costs beyond fair wear and tear, (iii) other lease violations, (d) Lease Administrator reviews landlord&#x27;s deduction claim: (i) verify each deduction against lease terms, (ii) if deductions are excessive or unjustified: dispute per W1858 landlord communication, (e) Finance processes returned deposit: Dr. Cash / Cr. Security Deposit Receivable
Responsible (R): Lease Administrator / Finance
Accountable (A): COO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1867_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1867_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1867_Task9" name="If landlord fails to return deposit within agreed period (typically 30–60 days…">
        <bpmn:documentation>Step 4: If landlord fails to return deposit within agreed period (typically 30–60 days post-termination): (a) Lease Administrator sends formal demand letter, (b) if no response: Legal Counsel issues legal demand, (c) legal action as last resort for significant deposit amounts
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: Variable</bpmn:documentation>
        <bpmn:incoming>W1867_Flow16</bpmn:incoming>
