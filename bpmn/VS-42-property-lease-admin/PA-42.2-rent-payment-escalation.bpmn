<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-42.2-rent-payment-escalation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1862" name="W1862. Monthly Rent Payment Processing &amp; Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly rent due date per lease agreement (typically 1st or 5th of month)
Frequency: ~205 rent payments/month
Volume: ~205 active leases × 12 months = ~2,460 payments/year
Owner: AP Clerk
Participants: AP Clerk, Lease Administrator, Finance
Source: workflow W1862 — Monthly Rent Payment Processing &amp; Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W1862_LaneSet4">
        <bpmn:lane id="W1862_Lane1" name="System">
        <bpmn:flowNodeRef>W1862_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1862_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1862_Lane2" name="AP Clerk">
        <bpmn:flowNodeRef>W1862_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1862_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1862_Lane3" name="Finance">
        <bpmn:flowNodeRef>W1862_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1862_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1862_Start5" name="Monthly rent due date per lease agreement (typically 1st or 5th of month)">
        <bpmn:outgoing>W1862_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1862_Task6" name="System generates monthly rent payment schedule: (a) list of all active leases…">
        <bpmn:documentation>Step 1: System generates monthly rent payment schedule: (a) list of all active leases with rent amount due, payment due date, landlord payment details, (b) system compares rent amount to lease schedule (verifies no missed escalations), (c) AP Clerk reviews payment schedule for accuracy
Responsible (R): System / AP Clerk
Accountable (A): Finance Manager
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1862_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1862_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1862_Task7" name="Landlord issues billing/invoice: (a) some landlords send monthly invoices…">
        <bpmn:documentation>Step 2: Landlord issues billing/invoice: (a) some landlords send monthly invoices; others rely on auto-payment per lease terms, (b) AP Clerk matches landlord invoice to lease schedule: (i) base rent matches scheduled amount (including current escalation), (ii) CAM charges match agreed rates or reconciliation, (iii) no unauthorized charges, (c) if discrepancy: AP Clerk flags to Lease Administrator for investigation
Responsible (R): AP Clerk
Accountable (A): Lease Administrator
Duration: 5–10 min/lease</bpmn:documentation>
        <bpmn:incoming>W1862_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1862_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1862_Task8" name="AP Clerk processes rent payment: (a) payment method per lease: post-dated check…">
        <bpmn:documentation>Step 3: AP Clerk processes rent payment: (a) payment method per lease: post-dated check (PDC), bank transfer, or auto-debit, (b) for PDC: AP Clerk issues check per W424 (PDC management); PDCs may be issued in batches quarterly or annually, (c) for bank transfer: AP Clerk creates payment in payment run per W7.9, (d) Finance approves payment batch, (e) system posts payment: Dr. Rent Expense (BuildRight Property Management, Inc.) / Cr. Cash
Responsible (R): AP Clerk / Finance
Accountable (A): Finance Manager
Duration: Per W7 payment run</bpmn:documentation>
        <bpmn:incoming>W1862_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1862_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1862_Task9" name="Monthly: Finance reconciles rent payments against lease schedule: (a) total…">
        <bpmn:documentation>Step 4: Monthly: Finance reconciles rent payments against lease schedule: (a) total rent paid vs. total rent scheduled, (b) identify any missed payments (risk of late fees or lease default), (c) verify PDC clearing per W1380 (AR PDC) / W424 (AP PDC)
Responsible (R): Finance
Accountable (A): CFO
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1862_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1862_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1862_End10" name="Complete">
        <bpmn:incoming>W1862_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1862_Annotation11">
        <bpmn:text>Controls: - CTL-220 (ensure lease-administration &amp; PFRS 16 integrity.) | - operational: AP Clerk review and approval gate; operational: periodic reconciliation against source documents
Owner: AP Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1862_Assoc12" sourceRef="W1862_Annotation11" targetRef="W1862_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1862_Flow13" sourceRef="W1862_Start5" targetRef="W1862_Task6" />
      <bpmn:sequenceFlow id="W1862_Flow14" sourceRef="W1862_Task6" targetRef="W1862_Task7" />
      <bpmn:sequenceFlow id="W1862_Flow15" sourceRef="W1862_Task7" targetRef="W1862_Task8" />
      <bpmn:sequenceFlow id="W1862_Flow16" sourceRef="W1862_Task8" targetRef="W1862_Task9" />
      <bpmn:sequenceFlow id="W1862_Flow17" sourceRef="W1862_Task9" targetRef="W1862_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1862_diag">
      <bpmndi:BPMNPlane id="W1862_plane" bpmnElement="W_W1862">
        <bpmndi:BPMNShape id="W1862_Lane1_di" bpmnElement="W1862_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Lane2_di" bpmnElement="W1862_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Lane3_di" bpmnElement="W1862_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Task6_di" bpmnElement="W1862_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Task7_di" bpmnElement="W1862_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Task8_di" bpmnElement="W1862_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Task9_di" bpmnElement="W1862_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Start5_di" bpmnElement="W1862_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_End10_di" bpmnElement="W1862_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1862_Annotation11_di" bpmnElement="W1862_Annotation11"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1862_Flow13_di" bpmnElement="W1862_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1862_Flow14_di" bpmnElement="W1862_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1862_Flow15_di" bpmnElement="W1862_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1862_Flow16_di" bpmnElement="W1862_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1862_Flow17_di" bpmnElement="W1862_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1862_Assoc12_di" bpmnElement="W1862_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1863" name="W1863. Annual Rent Escalation Execution &amp; Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Rent escalation effective date per lease (typically anniversary of lease commencement)
Frequency: ~150–180 escalations/year (most leases have annual escalation; some biennial)
Volume: 1 escalation per lease per occurrence
Owner: Lease Administrator
Participants: Lease Administrator, AP Clerk, Finance
Source: workflow W1863 — Annual Rent Escalation Execution &amp; Verification</bpmn:documentation>
      <bpmn:laneSet id="W1863_LaneSet4">
        <bpmn:lane id="W1863_Lane1" name="Lease Administrator">
        <bpmn:flowNodeRef>W1863_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1863_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1863_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1863_Lane2" name="Finance">
        <bpmn:flowNodeRef>W1863_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1863_Lane3" name="AP Clerk">
        <bpmn:flowNodeRef>W1863_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1863_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1863_Start5" name="Rent escalation effective date per lease (typically anniversary of lease commencement)">
        <bpmn:outgoing>W1863_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1863_Task6" name="System alerts Lease Administrator 90 days before escalation effective date: (a)…">
        <bpmn:documentation>Step 1: System alerts Lease Administrator 90 days before escalation effective date: (a) lease number, current rent, escalation method (fixed %, CPI-linked, or fixed amount), new rent amount (system-calculated per escalation formula in lease), (b) Lease Administrator verifies system calculation against lease agreement: (i) fixed % escalation: verify percentage matches lease, (ii) CPI-linked: verify CPI index used (Philippine Statistics Authority PSA CPI), base period, and calculation, (iii) fixed amount: verify step-up schedule, (c) if system calculation matches lease: approve escalation in system
Responsible (R): Lease Administrator
Accountable (A): Finance Manager
Duration: 15–30 min/escalation</bpmn:documentation>
        <bpmn:incoming>W1863_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1863_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1863_Task7" name="If landlord disputes escalation amount: (a) Lease Administrator reviews lease…">
        <bpmn:documentation>Step 2: If landlord disputes escalation amount: (a) Lease Administrator reviews lease escalation clause with Legal Counsel, (b) if CPI-linked escalation: provide landlord with PSA CPI documentation supporting BuildRight&#x27;s calculation, (c) if fixed % escalation: reference lease agreement, (d) if discrepancy from landlord error: formally dispute in writing per W1858, (e) escalate to Legal Counsel if unresolved within 30 days
Responsible (R): Lease Administrator / Legal
Accountable (A): COO
Duration: 1–2 hours/dispute</bpmn:documentation>
        <bpmn:incoming>W1863_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1863_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1863_Task8" name="Finance updates PFRS 16 lease liability for revised rent schedule: (a)…">
        <bpmn:documentation>Step 3: Finance updates PFRS 16 lease liability for revised rent schedule: (a) remeasure lease liability using revised cash flows and current discount rate, (b) adjust ROU asset for difference, (c) post journal entry for PFRS 16 remeasurement
Responsible (R): Finance
Accountable (A): CFO
Duration: Per lease remeasurement</bpmn:documentation>
        <bpmn:incoming>W1863_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1863_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1863_Task9" name="AP Clerk updates monthly rent payment schedule with new escalated amount…">
        <bpmn:documentation>Step 4: AP Clerk updates monthly rent payment schedule with new escalated amount effective from escalation date
Responsible (R): AP Clerk
Accountable (A): Finance Manager
Duration: 5 min/escalation</bpmn:documentation>
        <bpmn:incoming>W1863_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1863_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1863_End10" name="Complete">
        <bpmn:incoming>W1863_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1863_Annotation11">
        <bpmn:text>Controls: - CTL-368 (ensure controlled execution — Rent Payment, Escalation &amp; CAM Reconciliation (PA-42.2).) | - operational: Lease Administrator review and approval gate
Owner: Lease Administrator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1863_Assoc12" sourceRef="W1863_Annotation11" targetRef="W1863_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1863_Flow13" sourceRef="W1863_Start5" targetRef="W1863_Task6" />
      <bpmn:sequenceFlow id="W1863_Flow14" sourceRef="W1863_Task6" targetRef="W1863_Task7" />
      <bpmn:sequenceFlow id="W1863_Flow15" sourceRef="W1863_Task7" targetRef="W1863_Task8" />
      <bpmn:sequenceFlow id="W1863_Flow16" sourceRef="W1863_Task8" targetRef="W1863_Task9" />
      <bpmn:sequenceFlow id="W1863_Flow17" sourceRef="W1863_Task9" targetRef="W1863_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1863_diag">
      <bpmndi:BPMNPlane id="W1863_plane" bpmnElement="W_W1863">
        <bpmndi:BPMNShape id="W1863_Lane1_di" bpmnElement="W1863_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Lane2_di" bpmnElement="W1863_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Lane3_di" bpmnElement="W1863_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Task6_di" bpmnElement="W1863_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Task7_di" bpmnElement="W1863_Task7"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Task8_di" bpmnElement="W1863_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Task9_di" bpmnElement="W1863_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Start5_di" bpmnElement="W1863_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_End10_di" bpmnElement="W1863_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1863_Annotation11_di" bpmnElement="W1863_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1863_Flow13_di" bpmnElement="W1863_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1863_Flow14_di" bpmnElement="W1863_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1863_Flow15_di" bpmnElement="W1863_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1863_Flow16_di" bpmnElement="W1863_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1863_Flow17_di" bpmnElement="W1863_Flow17"><di:waypoint x="1210" y="505" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1863_Assoc12_di" bpmnElement="W1863_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1864" name="W1864. Common Area Maintenance (CAM) Charge Reconciliation &amp; Dispute Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Annual CAM reconciliation statement received from landlord; monthly CAM charges in rent invoice
Frequency: Annual reconciliation per lease; monthly CAM charges in ~100–150 leases (properties in multi-tenant developments)
Volume: ~100–150 annual CAM reconciliation reviews
Owner: Lease Administrator
Participants: Lease Administrator, Finance, COO, Legal Counsel
Source: workflow W1864 — Common Area Maintenance (CAM) Charge Reconciliation &amp; Dispute Resolution</bpmn:documentation>
      <bpmn:laneSet id="W1864_LaneSet4">
        <bpmn:lane id="W1864_Lane1" name="AP Clerk">
        <bpmn:flowNodeRef>W1864_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1864_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1864_Lane2" name="Landlord">
        <bpmn:flowNodeRef>W1864_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1864_Lane3" name="Lease Administrator">
        <bpmn:flowNodeRef>W1864_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1864_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1864_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1864_Start5" name="Annual CAM reconciliation statement received from landlord; monthly CAM charges in rent…">
        <bpmn:outgoing>W1864_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1864_Task6" name="Monthly: AP Clerk pays CAM charges as billed by landlord: (a) monthly CAM…">
        <bpmn:documentation>Step 1: Monthly: AP Clerk pays CAM charges as billed by landlord: (a) monthly CAM charges are typically estimated amounts based on pro-rata share of common area costs, (b) AP Clerk verifies monthly charge matches lease terms: (i) pro-rata share percentage, (ii) agreed cap on annual CAM increase (if negotiated), (iii) excluded charges (capital improvements, landlord&#x27;s own administrative overhead)
Responsible (R): AP Clerk
Accountable (A): Lease Administrator
Duration: 5 min/lease</bpmn:documentation>
        <bpmn:incoming>W1864_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1864_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1864_Task7" name="Annual: Landlord provides CAM reconciliation statement: (a) actual CAM expenses…">
        <bpmn:documentation>Step 2: Annual: Landlord provides CAM reconciliation statement: (a) actual CAM expenses for the year vs. estimated charges billed monthly, (b) pro-rata allocation to each tenant based on leased area, (c) supporting documentation: invoices for common area expenses (electricity, water, cleaning, security, elevator maintenance, parking maintenance, property management fee), (d) reconciliation result: (i) if actual &lt; estimated: landlord refunds overpayment or credits against future rent, (ii) if actual &gt; estimated: tenant pays shortfall
Responsible (R): Landlord / Lease Administrator
Accountable (A): COO
Duration: 1–2 hours/lease</bpmn:documentation>
        <bpmn:incoming>W1864_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1864_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1864_Task8" name="Lease Administrator reviews CAM reconciliation: (a) verify pro-rata share…">
        <bpmn:documentation>Step 3: Lease Administrator reviews CAM reconciliation: (a) verify pro-rata share calculation against lease terms and actual leased area, (b) review expense categories: are all charges covered under the lease definition of &quot;common area maintenance&quot;? Flag any capital improvement charges that should be excluded (landlord&#x27;s responsibility, not tenants&#x27;), (c) compare CAM cost per sqm to market benchmarks: is the landlord overcharging relative to comparable properties? (d) verify landlord&#x27;s property management fee is within lease-specified cap (typically 5–10% of CAM costs), (e) if reconciliation appears reasonable: approve for payment/credit, (f) if discrepancies found: document and dispute per step 4
Responsible (R): Lease Administrator
Accountable (A): COO
Duration: 1–2 hours/lease</bpmn:documentation>
        <bpmn:incoming>W1864_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1864_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1864_Task9" name="CAM dispute resolution: (a) Lease Administrator submits written dispute to…">
        <bpmn:documentation>Step 4: CAM dispute resolution: (a) Lease Administrator submits written dispute to landlord with specific line-item objections and supporting documentation, (b) negotiate resolution: landlord may agree to adjust, provide additional documentation, or maintain original charges, (c) if dispute unresolved within 30 days: escalate to Legal Counsel for formal demand letter, (d) if landlord refuses reasonable adjustment: COO considers at lease renewal (W1856) — unresolved CAM disputes are leverage for rent negotiation
Responsible (R): Lease Administrator / Legal
Accountable (A): COO
Duration: 2–8 hours/dispute</bpmn:documentation>
        <bpmn:incoming>W1864_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1864_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1864_End10" name="Complete">
        <bpmn:incoming>W1864_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1864_Annotation11">
        <bpmn:text>Controls: - CTL-220 (ensure lease-administration &amp; PFRS 16 integrity.) | - operational: Lease Administrator review and approval gate; operational: periodic reconciliation against source documents
Owner: Lease Administrator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1864_Assoc12" sourceRef="W1864_Annotation11" targetRef="W1864_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1864_Flow13" sourceRef="W1864_Start5" targetRef="W1864_Task6" />
      <bpmn:sequenceFlow id="W1864_Flow14" sourceRef="W1864_Task6" targetRef="W1864_Task7" />
      <bpmn:sequenceFlow id="W1864_Flow15" sourceRef="W1864_Task7" targetRef="W1864_Task8" />
      <bpmn:sequenceFlow id="W1864_Flow16" sourceRef="W1864_Task8" targetRef="W1864_Task9" />
      <bpmn:sequenceFlow id="W1864_Flow17" sourceRef="W1864_Task9" targetRef="W1864_End10" />
    </bpmn:process>
