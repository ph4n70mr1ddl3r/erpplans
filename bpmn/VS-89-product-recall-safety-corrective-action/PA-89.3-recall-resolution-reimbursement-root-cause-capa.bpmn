<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-89.3-recall-resolution-reimbursement-root-cause-capa" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3009" name="W3009. Vendor Reimbursement, Credit &amp; Cost Recovery for Recalls" isExecutable="false">
      <bpmn:documentation>Trigger: Recall recovery and disposition complete
Frequency: Per recall event
Volume: ~3–8 recoveries/year
Owner: Finance Manager (AP)
Participants: Finance/AP, Vendor Mgmt, Legal, Supply Chain
Source: workflow W3009 — Vendor Reimbursement, Credit &amp; Cost Recovery for Recalls</bpmn:documentation>
      <bpmn:laneSet id="W3009_LaneSet3">
        <bpmn:lane id="W3009_Lane1" name="Finance">
        <bpmn:flowNodeRef>W3009_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3009_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3009_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3009_Lane2" name="Vendor Mgmt">
        <bpmn:flowNodeRef>W3009_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3009_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3009_Start4" name="Recall recovery and disposition complete">
        <bpmn:outgoing>W3009_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3009_Task5" name="Finance/AP compiles recall cost ledger: refunds/credits issued, retrieval…">
        <bpmn:documentation>Step 1: Finance/AP compiles recall cost ledger: refunds/credits issued, retrieval logistics, destruction, communications, regulatory, and internal labor — by vendor/SKU
Responsible (R): Finance / AP
Accountable (A): Finance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3009_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3009_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3009_Task6" name="Vendor Mgmt/Legal presents cost ledger to vendor under the corrective action…">
        <bpmn:documentation>Step 2: Vendor Mgmt/Legal presents cost ledger to vendor under the corrective action agreement (W2998); negotiates credit memo, debit, or cash reimbursement
Responsible (R): Vendor Mgmt / Legal
Accountable (A): Vendor Management Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3009_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3009_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3009_Task7" name="Finance/AP posts vendor credit/debit memo; reconciles to recall case; tracks…">
        <bpmn:documentation>Step 3: Finance/AP posts vendor credit/debit memo; reconciles to recall case; tracks recovery aging; escalates disputes to Legal
Responsible (R): Finance / AP
Accountable (A): Finance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3009_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3009_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3009_End8" name="Complete">
        <bpmn:incoming>W3009_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3009_Annotation9">
        <bpmn:text>Controls: - CTL-152 (ensure recall regulatory reporting &amp; closure.) | - operational: contract indemnification clauses and documented cost ledger
Owner: Finance Manager (AP)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3009_Assoc10" sourceRef="W3009_Annotation9" targetRef="W3009_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3009_Flow11" sourceRef="W3009_Start4" targetRef="W3009_Task5" />
      <bpmn:sequenceFlow id="W3009_Flow12" sourceRef="W3009_Task5" targetRef="W3009_Task6" />
      <bpmn:sequenceFlow id="W3009_Flow13" sourceRef="W3009_Task6" targetRef="W3009_Task7" />
      <bpmn:sequenceFlow id="W3009_Flow14" sourceRef="W3009_Task7" targetRef="W3009_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3009_diag">
      <bpmndi:BPMNPlane id="W3009_plane" bpmnElement="W_W3009">
        <bpmndi:BPMNShape id="W3009_Lane1_di" bpmnElement="W3009_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3009_Lane2_di" bpmnElement="W3009_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
