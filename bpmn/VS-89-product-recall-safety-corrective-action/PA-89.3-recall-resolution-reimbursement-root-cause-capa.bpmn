        <bpmndi:BPMNShape id="W3010_Task6_di" bpmnElement="W3010_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3010_Task7_di" bpmnElement="W3010_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3010_Start4_di" bpmnElement="W3010_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3010_End8_di" bpmnElement="W3010_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3010_Annotation9_di" bpmnElement="W3010_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3010_Flow11_di" bpmnElement="W3010_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3010_Flow12_di" bpmnElement="W3010_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3010_Flow13_di" bpmnElement="W3010_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3010_Flow14_di" bpmnElement="W3010_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3010_Assoc10_di" bpmnElement="W3010_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3011" name="W3011. Recall Root Cause Analysis &amp; CAPA (Corrective &amp; Preventive Action)" isExecutable="false">
      <bpmn:documentation>Trigger: Recall recovery substantially complete
Frequency: Per recall event
Volume: ~3–8 RCAs/year
Owner: Quality Manager
Participants: Quality, Vendor Mgmt, Merchandising, Engineering/Technical, Product Safety
Source: workflow W3011 — Recall Root Cause Analysis &amp; CAPA (Corrective &amp; Preventive Action)</bpmn:documentation>
      <bpmn:laneSet id="W3011_LaneSet2">
        <bpmn:lane id="W3011_Lane1" name="Quality">
        <bpmn:flowNodeRef>W3011_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3011_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3011_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3011_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3011_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3011_Start3" name="Recall recovery substantially complete">
        <bpmn:outgoing>W3011_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3011_Task4" name="Quality leads root cause analysis (5-Why / fishbone) with vendor/manufacturer…">
        <bpmn:documentation>Step 1: Quality leads root cause analysis (5-Why / fishbone) with vendor/manufacturer and internal stakeholders; identifies design, process, supplier, or specification cause
Responsible (R): Quality
Accountable (A): Quality Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3011_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3011_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3011_Task5" name="Quality/Vendor Mgmt define CAPA: corrective (fix cause) and preventive (avoid…">
        <bpmn:documentation>Step 2: Quality/Vendor Mgmt define CAPA: corrective (fix cause) and preventive (avoid recurrence) actions, owners, and deadlines; verify against DTI-BPS re-certification (W447)
Responsible (R): Quality / Vendor Mgmt
Accountable (A): Quality Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3011_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3011_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3011_Task6" name="Quality tracks CAPA to closure; verifies effectiveness; updates vendor…">
        <bpmn:documentation>Step 3: Quality tracks CAPA to closure; verifies effectiveness; updates vendor scorecard (links to VS-67) and QA process controls
Responsible (R): Quality
Accountable (A): Quality Manager
Duration: Through closure</bpmn:documentation>
        <bpmn:incoming>W3011_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3011_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3011_End7" name="Complete">
        <bpmn:incoming>W3011_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3011_Annotation8">
        <bpmn:text>Controls: - CTL-498 (ensure controlled execution — Recall Resolution, Reimbursement &amp; Root Cause / CAPA (PA-89.3).) | - operational: formal CAPA tracking and effectiveness verification
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3011_Assoc9" sourceRef="W3011_Annotation8" targetRef="W3011_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3011_Flow10" sourceRef="W3011_Start3" targetRef="W3011_Task4" />
      <bpmn:sequenceFlow id="W3011_Flow11" sourceRef="W3011_Task4" targetRef="W3011_Task5" />
      <bpmn:sequenceFlow id="W3011_Flow12" sourceRef="W3011_Task5" targetRef="W3011_Task6" />
      <bpmn:sequenceFlow id="W3011_Flow13" sourceRef="W3011_Task6" targetRef="W3011_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3011_diag">
      <bpmndi:BPMNPlane id="W3011_plane" bpmnElement="W_W3011">
        <bpmndi:BPMNShape id="W3011_Lane1_di" bpmnElement="W3011_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_Task4_di" bpmnElement="W3011_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_Task5_di" bpmnElement="W3011_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_Task6_di" bpmnElement="W3011_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_Start3_di" bpmnElement="W3011_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_End7_di" bpmnElement="W3011_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3011_Annotation8_di" bpmnElement="W3011_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3011_Flow10_di" bpmnElement="W3011_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3011_Flow11_di" bpmnElement="W3011_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3011_Flow12_di" bpmnElement="W3011_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3011_Flow13_di" bpmnElement="W3011_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3011_Assoc9_di" bpmnElement="W3011_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3012" name="W3012. Post-Recall Surveillance &amp; Re-Occurrence Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Recall closed / CAPA implemented
Frequency: Defined surveillance window (3–12 months)
Volume: Per closed recall
Owner: Product Safety &amp; Compliance Manager
Participants: Product Safety, Quality, Customer Service, Data Analytics
Source: workflow W3012 — Post-Recall Surveillance &amp; Re-Occurrence Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W3012_LaneSet3">
        <bpmn:lane id="W3012_Lane1" name="Product Safety">
        <bpmn:flowNodeRef>W3012_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3012_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3012_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3012_Lane2" name="Quality">
        <bpmn:flowNodeRef>W3012_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3012_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3012_Start4" name="Recall closed / CAPA implemented">
        <bpmn:outgoing>W3012_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3012_Task5" name="Product Safety/Customer Service monitor incoming complaints/returns for the…">
        <bpmn:documentation>Step 1: Product Safety/Customer Service monitor incoming complaints/returns for the recalled SKU/lot and similar SKUs; watch for re-occurrence signals
Responsible (R): Product Safety / Customer Service
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Through window</bpmn:documentation>
        <bpmn:incoming>W3012_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3012_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3012_Task6" name="Quality/Product Safety verify CAPA effectiveness via targeted audits and field…">
        <bpmn:documentation>Step 2: Quality/Product Safety verify CAPA effectiveness via targeted audits and field data; confirms corrected product requalified (W447)
Responsible (R): Quality / Product Safety
Accountable (A): Quality Manager
Duration: Through window</bpmn:documentation>
        <bpmn:incoming>W3012_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3012_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3012_Task7" name="Product Safety reports surveillance outcome to Recall Committee and regulator…">
        <bpmn:documentation>Step 3: Product Safety reports surveillance outcome to Recall Committee and regulator where required; closes or re-opens recall
Responsible (R): Product Safety
Accountable (A): VP Legal &amp; Compliance
Duration: At window end</bpmn:documentation>
        <bpmn:incoming>W3012_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3012_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3012_End8" name="Complete">
        <bpmn:incoming>W3012_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3012_Annotation9">
        <bpmn:text>Controls: - CTL-498 (ensure controlled execution — Recall Resolution, Reimbursement &amp; Root Cause / CAPA (PA-89.3).) | - operational: automated SKU/lot complaint-rate alerts
Owner: Product Safety &amp; Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3012_Assoc10" sourceRef="W3012_Annotation9" targetRef="W3012_Start4" associationDirection="None" />
