    <bpmn:process id="W_W3013" name="W3013. Regulatory Close-Out Reporting (DTI-BPS / FDA) &amp; Recall Termination" isExecutable="false">
      <bpmn:documentation>Trigger: Effectiveness targets met and CAPA closed
Frequency: Per recall event
Volume: ~3–8 close-outs/year
Owner: Regulatory Compliance Officer
Participants: Regulatory Officer, Product Safety, Legal, Quality
Source: workflow W3013 — Regulatory Close-Out Reporting (DTI-BPS / FDA) &amp; Recall Termination</bpmn:documentation>
      <bpmn:laneSet id="W3013_LaneSet4">
        <bpmn:lane id="W3013_Lane1" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W3013_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3013_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3013_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3013_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3013_Lane3" name="Product Safety">
        <bpmn:flowNodeRef>W3013_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3013_End9</bpmn:flowNodeRef>
        </bpmn:lane>
