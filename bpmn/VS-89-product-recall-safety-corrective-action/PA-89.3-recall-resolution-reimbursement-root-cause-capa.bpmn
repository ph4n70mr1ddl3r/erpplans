    <bpmn:process id="W_W3016" name="W3016. Recall Lessons Learned, Process &amp; Quality System Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Recall closed and surveillance complete
Frequency: Per recall event + quarterly portfolio review
Volume: ~3–8 lessons-learned/year
Owner: Product Safety &amp; Compliance Manager
Participants: Product Safety, Quality, Merchandising, Supply Chain, IT, Internal Audit
Source: workflow W3016 — Recall Lessons Learned, Process &amp; Quality System Improvement</bpmn:documentation>
      <bpmn:laneSet id="W3016_LaneSet4">
        <bpmn:lane id="W3016_Lane1" name="Product Safety">
        <bpmn:flowNodeRef>W3016_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3016_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3016_Lane2" name="Stakeholders">
        <bpmn:flowNodeRef>W3016_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3016_Lane3" name="Internal Audit">
        <bpmn:flowNodeRef>W3016_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3016_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3016_Start5" name="Recall closed and surveillance complete">
        <bpmn:outgoing>W3016_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3016_Task6" name="Product Safety facilitates lessons-learned review: what worked, gaps (detection…">
        <bpmn:documentation>Step 1: Product Safety facilitates lessons-learned review: what worked, gaps (detection speed, traceability, reach), and systemic improvements
Responsible (R): Product Safety
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3016_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3016_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3016_Task7" name="Stakeholders translate findings into process/system improvements: vendor…">
        <bpmn:documentation>Step 2: Stakeholders translate findings into process/system improvements: vendor onboarding QA gates, lot-traceability enhancements, notification automation, shelf-removal task rigor
Responsible (R): Stakeholders
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3016_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3016_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3016_Task8" name="Internal Audit/Product Safety track improvement actions to closure; update…">
        <bpmn:documentation>Step 3: Internal Audit/Product Safety track improvement actions to closure; update recall playbook and training; feed trends into enterprise risk register (links to VS-21)
Responsible (R): Internal Audit / Product Safety
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Through closure</bpmn:documentation>
        <bpmn:incoming>W3016_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3016_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3016_End9" name="Complete">
        <bpmn:incoming>W3016_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3016_Annotation10">
        <bpmn:text>Controls: - CTL-498 (ensure controlled execution — Recall Resolution, Reimbursement &amp; Root Cause / CAPA (PA-89.3).) | - operational: tracked action items and playbook updates
Owner: Product Safety &amp; Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
