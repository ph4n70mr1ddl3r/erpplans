    <bpmn:process id="W_W3015" name="W3015. Recall Insurance Claim &amp; Recovery Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Recall costs incurred and policy applicable
Frequency: Per recall event (where covered)
Volume: Subset of recalls with product-recall/liability coverage
Owner: Risk &amp; Insurance Manager
Participants: Risk/Insurance, Finance, Legal, Broker
Source: workflow W3015 — Recall Insurance Claim &amp; Recovery Processing</bpmn:documentation>
      <bpmn:laneSet id="W3015_LaneSet3">
        <bpmn:lane id="W3015_Lane1" name="Risk">
        <bpmn:flowNodeRef>W3015_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3015_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3015_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3015_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3015_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3015_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3015_Start4" name="Recall costs incurred and policy applicable">
        <bpmn:outgoing>W3015_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3015_Task5" name="Risk/Insurance reviews product-recall / general-liability policy for coverage…">
        <bpmn:documentation>Step 1: Risk/Insurance reviews product-recall / general-liability policy for coverage, deductibles, and notice conditions; notifies insurer/broker within policy window
Responsible (R): Risk / Insurance
Accountable (A): Risk &amp; Insurance Manager
Duration: Per recall (&lt;notice window)</bpmn:documentation>
        <bpmn:incoming>W3015_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3015_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3015_Task6" name="Finance/Risk compile claim evidence: cost ledger (W3009), incident…">
        <bpmn:documentation>Step 2: Finance/Risk compile claim evidence: cost ledger (W3009), incident documentation, regulator filings, destruction certificates
Responsible (R): Finance / Risk
Accountable (A): Risk &amp; Insurance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3015_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3015_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3015_Task7" name="Risk/Insurance negotiates settlement with insurer; Finance posts recovery…">
        <bpmn:documentation>Step 3: Risk/Insurance negotiates settlement with insurer; Finance posts recovery; reconciles to recall case; coordinates with vendor recovery (W3009) to avoid double-recovery
Responsible (R): Risk / Insurance / Finance
Accountable (A): Risk &amp; Insurance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3015_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3015_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3015_End8" name="Complete">
        <bpmn:incoming>W3015_Flow14</bpmn:incoming>
      </bpmn:endEvent>
