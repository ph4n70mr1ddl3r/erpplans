      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3010" name="W3010. Recalled Product Destruction, Recycling &amp; Disposal Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Recalled stock dispositioned for destruction (not returnable/salvageable)
Frequency: Per recall event
Volume: Proportional to recall
Owner: Quality Manager
Participants: Quality, Logistics, EHS, Records, Licensed Disposal Vendor
Source: workflow W3010 — Recalled Product Destruction, Recycling &amp; Disposal Compliance</bpmn:documentation>
      <bpmn:laneSet id="W3010_LaneSet3">
        <bpmn:lane id="W3010_Lane1" name="Quality">
        <bpmn:flowNodeRef>W3010_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3010_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3010_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3010_Lane2" name="Disposal Vendor">
        <bpmn:flowNodeRef>W3010_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3010_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3010_Start4" name="Recalled stock dispositioned for destruction (not returnable/salvageable)">
        <bpmn:outgoing>W3010_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3010_Task5" name="Quality/Logistics selects licensed destruction/disposal vendor; confirms method…">
        <bpmn:documentation>Step 1: Quality/Logistics selects licensed destruction/disposal vendor; confirms method (incineration, crushing, certified recycling) appropriate to product and DENR/EHS rules (links to VS-24)
Responsible (R): Quality / Logistics
Accountable (A): Quality Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3010_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3010_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3010_Task6" name="Disposal Vendor destroys/recycles stock; issues certificate of destruction with…">
        <bpmn:documentation>Step 2: Disposal Vendor destroys/recycles stock; issues certificate of destruction with quantities and serial/lot evidence; EHS verifies hazardous-goods handling
Responsible (R): Disposal Vendor / EHS
Accountable (A): Quality Manager
Duration: Per batch</bpmn:documentation>
        <bpmn:incoming>W3010_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3010_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3010_Task7" name="Quality/Records retains destruction certificates and evidence in recall audit…">
        <bpmn:documentation>Step 3: Quality/Records retains destruction certificates and evidence in recall audit file; updates inventory write-off (W3022-equivalent) and removes quarantined stock
Responsible (R): Quality / Records
Accountable (A): Quality Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3010_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3010_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3010_End8" name="Complete">
        <bpmn:incoming>W3010_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3010_Annotation9">
        <bpmn:text>Controls: - CTL-152 (ensure recall regulatory reporting &amp; closure.) | - operational: licensed vendor, certificate of destruction, and serialization
Owner: Quality Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3010_Assoc10" sourceRef="W3010_Annotation9" targetRef="W3010_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3010_Flow11" sourceRef="W3010_Start4" targetRef="W3010_Task5" />
      <bpmn:sequenceFlow id="W3010_Flow12" sourceRef="W3010_Task5" targetRef="W3010_Task6" />
      <bpmn:sequenceFlow id="W3010_Flow13" sourceRef="W3010_Task6" targetRef="W3010_Task7" />
      <bpmn:sequenceFlow id="W3010_Flow14" sourceRef="W3010_Task7" targetRef="W3010_End8" />
    </bpmn:process>
