        <bpmn:outgoing>W3013_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3013_Task6" name="Regulatory Officer compiles close-out report: scope, units recovered…">
        <bpmn:documentation>Step 1: Regulatory Officer compiles close-out report: scope, units recovered, effectiveness %, disposition, CAPA status; submits to DTI-BPS/FDA per their termination process
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3013_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3013_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3013_Task7" name="Legal/Regulatory obtains regulator acknowledgment/termination; lifts any PS/ICC…">
        <bpmn:documentation>Step 2: Legal/Regulatory obtains regulator acknowledgment/termination; lifts any PS/ICC mark suspension on corrected product; confirms relisting eligibility
Responsible (R): Legal / Regulatory
Accountable (A): Regulatory Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3013_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3013_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3013_Task8" name="Product Safety formally terminates recall in case system; releases residual…">
        <bpmn:documentation>Step 3: Product Safety formally terminates recall in case system; releases residual quarantine; restores SKU/listing per corrected-product status
Responsible (R): Product Safety
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3013_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3013_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3013_End9" name="Complete">
        <bpmn:incoming>W3013_Flow15</bpmn:incoming>
      </bpmn:endEvent>
