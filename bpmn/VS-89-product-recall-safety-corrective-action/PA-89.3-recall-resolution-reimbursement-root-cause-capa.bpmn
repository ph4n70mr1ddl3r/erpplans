        <bpmn:outgoing>W3014_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3014_Task6" name="Legal/Compliance validate completeness and privileged-content handling; mark…">
        <bpmn:documentation>Step 2: Legal/Compliance validate completeness and privileged-content handling; mark retention class (Consumer Act + BIR/SEC 10-year, product-liability statutes)
Responsible (R): Legal / Compliance
Accountable (A): VP Legal &amp; Compliance
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3014_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3014_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3014_Task7" name="Records Mgr files to tamper-evident repository (links to VS-88); applies legal…">
        <bpmn:documentation>Step 3: Records Mgr files to tamper-evident repository (links to VS-88); applies legal hold if litigation pending; supports future audit/litigation retrieval
Responsible (R): Records Manager
Accountable (A): Records Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3014_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3014_Flow14</bpmn:outgoing>
      </bpmn:userTask>
