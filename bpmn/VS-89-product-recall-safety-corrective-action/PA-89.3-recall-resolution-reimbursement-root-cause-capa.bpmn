      <bpmndi:BPMNPlane id="W3010_plane" bpmnElement="W_W3010">
        <bpmndi:BPMNShape id="W3010_Lane1_di" bpmnElement="W3010_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3010_Lane2_di" bpmnElement="W3010_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
