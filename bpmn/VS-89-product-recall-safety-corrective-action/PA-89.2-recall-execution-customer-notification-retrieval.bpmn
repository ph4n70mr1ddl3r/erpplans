<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-89.2-recall-execution-customer-notification-retrieval" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3001" name="W3001. Multi-Channel Customer Recall Notice &amp; Public Communication" isExecutable="false">
      <bpmn:documentation>Trigger: Recall execution start
Frequency: Per recall event
Volume: Reaches up to 600,000 loyalty members + ecommerce buyers (segmented to affected)
Owner: Marketing Communications Manager
Participants: Comms, Product Safety, Legal, Customer Service, Loyalty/CRM, DPO
Source: workflow W3001 — Multi-Channel Customer Recall Notice &amp; Public Communication</bpmn:documentation>
      <bpmn:laneSet id="W3001_LaneSet4">
        <bpmn:lane id="W3001_Lane1" name="Comms">
        <bpmn:flowNodeRef>W3001_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3001_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3001_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W3001_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3001_Lane3" name="Customer Service">
        <bpmn:flowNodeRef>W3001_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3001_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3001_Start5" name="Recall execution start">
        <bpmn:outgoing>W3001_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3001_Task6" name="Comms/Product Safety draft customer recall notice (plain-language hazard…">
        <bpmn:documentation>Step 1: Comms/Product Safety draft customer recall notice (plain-language hazard, affected SKU/lot, remedy, contact channel); Legal reviews; DPO approves use of customer contact data and lawful basis
Responsible (R): Comms / Product Safety
Accountable (A): Marketing Communications Manager
Duration: &lt;48 hr</bpmn:documentation>
        <bpmn:incoming>W3001_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3001_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3001_Task7" name="Marketing/CRM distributes notice via targeted channels: email/SMS to affected…">
        <bpmn:documentation>Step 2: Marketing/CRM distributes notice via targeted channels: email/SMS to affected loyalty members and ecommerce buyers, in-app push (VS-75), website banner, social media, and press release for high-severity
Responsible (R): Marketing / CRM / Loyalty
Accountable (A): Marketing Communications Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3001_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3001_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3001_Task8" name="Customer Service staffs dedicated recall hotline/chat; logs inquiries; routes…">
        <bpmn:documentation>Step 3: Customer Service staffs dedicated recall hotline/chat; logs inquiries; routes remedy requests; escalates safety incidents; closes loop with Product Safety
Responsible (R): Customer Service
Accountable (A): Customer Service Manager
Duration: Through recall</bpmn:documentation>
        <bpmn:incoming>W3001_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3001_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3001_End9" name="Complete">
        <bpmn:incoming>W3001_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3001_Annotation10">
        <bpmn:text>Controls: - CTL-497 (ensure controlled execution — Recall Execution, Customer Notification &amp; Product Retrieval (PA-89.2).) | - operational: multi-channel approach and public notice for high-severity
Owner: Marketing Communications Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3001_Assoc11" sourceRef="W3001_Annotation10" targetRef="W3001_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3001_Flow12" sourceRef="W3001_Start5" targetRef="W3001_Task6" />
      <bpmn:sequenceFlow id="W3001_Flow13" sourceRef="W3001_Task6" targetRef="W3001_Task7" />
      <bpmn:sequenceFlow id="W3001_Flow14" sourceRef="W3001_Task7" targetRef="W3001_Task8" />
      <bpmn:sequenceFlow id="W3001_Flow15" sourceRef="W3001_Task8" targetRef="W3001_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3001_diag">
      <bpmndi:BPMNPlane id="W3001_plane" bpmnElement="W_W3001">
        <bpmndi:BPMNShape id="W3001_Lane1_di" bpmnElement="W3001_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Lane2_di" bpmnElement="W3001_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Lane3_di" bpmnElement="W3001_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Task6_di" bpmnElement="W3001_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Task7_di" bpmnElement="W3001_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Task8_di" bpmnElement="W3001_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3001_Start5_di" bpmnElement="W3001_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
