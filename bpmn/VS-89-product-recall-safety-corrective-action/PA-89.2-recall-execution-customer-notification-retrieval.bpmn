        <bpmndi:BPMNEdge id="W3001_Flow13_di" bpmnElement="W3001_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3001_Flow14_di" bpmnElement="W3001_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3001_Flow15_di" bpmnElement="W3001_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3001_Assoc11_di" bpmnElement="W3001_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3002" name="W3002. Store-Level Recall Execution, POS Block &amp; Shelf Removal" isExecutable="false">
      <bpmn:documentation>Trigger: Recall stop-sale (W3000) and customer notice
Frequency: Per recall event, across 200 stores
Volume: 200 stores execute concurrently
Owner: Store Operations Manager
Participants: Store Ops, Store Mgr/Staff, LP, Inventory Control
Source: workflow W3002 — Store-Level Recall Execution, POS Block &amp; Shelf Removal</bpmn:documentation>
      <bpmn:laneSet id="W3002_LaneSet4">
        <bpmn:lane id="W3002_Lane1" name="Store Ops">
        <bpmn:flowNodeRef>W3002_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3002_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3002_Lane2" name="Store Staff">
        <bpmn:flowNodeRef>W3002_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3002_Lane3" name="LP">
        <bpmn:flowNodeRef>W3002_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3002_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3002_Start5" name="Recall stop-sale (W3000) and customer notice">
        <bpmn:outgoing>W3002_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3002_Task6" name="Store Ops pushes recall task to all affected stores via store…">
        <bpmn:documentation>Step 1: Store Ops pushes recall task to all affected stores via store communication/task system (links to VS-63) with SKU/lot, photos, shelf location, and action deadline
Responsible (R): Store Ops
Accountable (A): Store Operations Manager
Duration: &lt;4 hr</bpmn:documentation>
        <bpmn:incoming>W3002_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3002_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3002_Task7" name="Store staff locate and remove affected stock from shelf/yard/backroom…">
        <bpmn:documentation>Step 2: Store staff locate and remove affected stock from shelf/yard/backroom; quarantine with recall label; confirm POS block active; complete task with photo proof
Responsible (R): Store Staff
Accountable (A): Store Manager
Duration: &lt;24 hr</bpmn:documentation>
        <bpmn:incoming>W3002_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3002_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3002_Task8" name="LP/Store Ops audits a sample of stores for execution completeness; re-trains…">
        <bpmn:documentation>Step 3: LP/Store Ops audits a sample of stores for execution completeness; re-trains non-compliant stores; reports exceptions to Recall Committee
Responsible (R): LP / Store Ops
Accountable (A): Store Operations Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3002_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3002_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3002_End9" name="Complete">
        <bpmn:incoming>W3002_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3002_Annotation10">
        <bpmn:text>Controls: - CTL-497 (ensure controlled execution — Recall Execution, Customer Notification &amp; Product Retrieval (PA-89.2).) | - operational: photo-proof task completion and LP audit sampling
Owner: Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3002_Assoc11" sourceRef="W3002_Annotation10" targetRef="W3002_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3002_Flow12" sourceRef="W3002_Start5" targetRef="W3002_Task6" />
      <bpmn:sequenceFlow id="W3002_Flow13" sourceRef="W3002_Task6" targetRef="W3002_Task7" />
      <bpmn:sequenceFlow id="W3002_Flow14" sourceRef="W3002_Task7" targetRef="W3002_Task8" />
      <bpmn:sequenceFlow id="W3002_Flow15" sourceRef="W3002_Task8" targetRef="W3002_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3002_diag">
      <bpmndi:BPMNPlane id="W3002_plane" bpmnElement="W_W3002">
        <bpmndi:BPMNShape id="W3002_Lane1_di" bpmnElement="W3002_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3002_Lane2_di" bpmnElement="W3002_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3002_Lane3_di" bpmnElement="W3002_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
