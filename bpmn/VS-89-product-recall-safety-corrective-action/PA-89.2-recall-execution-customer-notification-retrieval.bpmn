        <bpmndi:BPMNEdge id="W3002_Flow13_di" bpmnElement="W3002_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3002_Flow14_di" bpmnElement="W3002_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3002_Flow15_di" bpmnElement="W3002_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3002_Assoc11_di" bpmnElement="W3002_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3003" name="W3003. Ecommerce &amp; Marketplace Recall Handling (Listing Block, Buyer Notify)" isExecutable="false">
      <bpmn:documentation>Trigger: Recall stop-sale (W3000)
Frequency: Per recall event
Volume: Ecommerce + marketplace channels (VS-10, VS-65)
Owner: Ecommerce Operations Manager
Participants: Ecommerce Ops, Marketplace Mgr, IT, Customer Service
Source: workflow W3003 — Ecommerce &amp; Marketplace Recall Handling (Listing Block, Buyer Notify)</bpmn:documentation>
      <bpmn:laneSet id="W3003_LaneSet3">
        <bpmn:lane id="W3003_Lane1" name="Ecommerce Ops">
        <bpmn:flowNodeRef>W3003_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3003_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3003_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3003_Lane2" name="Marketplace Manager">
        <bpmn:flowNodeRef>W3003_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3003_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3003_Start4" name="Recall stop-sale (W3000)">
        <bpmn:outgoing>W3003_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3003_Task5" name="Ecommerce Ops/IT suspends product listing on web/app and all marketplace…">
        <bpmn:documentation>Step 1: Ecommerce Ops/IT suspends product listing on web/app and all marketplace channels (Shopee/Lazada/etc.); cancels pending unshipped orders; prevents new orders
Responsible (R): Ecommerce Ops / IT
Accountable (A): Ecommerce Operations Manager
Duration: &lt;4 hr</bpmn:documentation>
        <bpmn:incoming>W3003_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3003_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3003_Task6" name="Ecommerce Ops notifies all buyers of affected SKU/lot within the recall window…">
        <bpmn:documentation>Step 2: Ecommerce Ops notifies all buyers of affected SKU/lot within the recall window (even if order delivered); provides remedy and return instructions; updates order records
Responsible (R): Ecommerce Ops / Customer Service
Accountable (A): Ecommerce Operations Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3003_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3003_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3003_Task7" name="Marketplace Mgr files marketplace-platform recall notices and complies with…">
        <bpmn:documentation>Step 3: Marketplace Mgr files marketplace-platform recall notices and complies with channel-specific recall takedown procedures; reconciles platform settlement
Responsible (R): Marketplace Manager
Accountable (A): Ecommerce Operations Manager
Duration: Per recall</bpmn:documentation>
        <bpmn:incoming>W3003_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3003_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3003_End8" name="Complete">
        <bpmn:incoming>W3003_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3003_Annotation9">
        <bpmn:text>Controls: - CTL-497 (ensure controlled execution — Recall Execution, Customer Notification &amp; Product Retrieval (PA-89.2).) | - operational: automated multi-channel listing block and platform-level notices
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3003_Assoc10" sourceRef="W3003_Annotation9" targetRef="W3003_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3003_Flow11" sourceRef="W3003_Start4" targetRef="W3003_Task5" />
      <bpmn:sequenceFlow id="W3003_Flow12" sourceRef="W3003_Task5" targetRef="W3003_Task6" />
      <bpmn:sequenceFlow id="W3003_Flow13" sourceRef="W3003_Task6" targetRef="W3003_Task7" />
      <bpmn:sequenceFlow id="W3003_Flow14" sourceRef="W3003_Task7" targetRef="W3003_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3003_diag">
      <bpmndi:BPMNPlane id="W3003_plane" bpmnElement="W_W3003">
        <bpmndi:BPMNShape id="W3003_Lane1_di" bpmnElement="W3003_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Lane2_di" bpmnElement="W3003_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Task5_di" bpmnElement="W3003_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Task6_di" bpmnElement="W3003_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Task7_di" bpmnElement="W3003_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Start4_di" bpmnElement="W3003_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_End8_di" bpmnElement="W3003_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3003_Annotation9_di" bpmnElement="W3003_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3003_Flow11_di" bpmnElement="W3003_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3003_Flow12_di" bpmnElement="W3003_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3003_Flow13_di" bpmnElement="W3003_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3003_Flow14_di" bpmnElement="W3003_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3003_Assoc10_di" bpmnElement="W3003_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3004" name="W3004. Customer Return, Refund, Repair &amp; Replacement Processing (Recall)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer presents recalled product
Frequency: Continuous through recall
Volume: Proportional to units in-field and recovery %
Owner: Customer Service Manager
Participants: Customer Service, Store Ops, Finance, AR
Source: workflow W3004 — Customer Return, Refund, Repair &amp; Replacement Processing (Recall)</bpmn:documentation>
      <bpmn:laneSet id="W3004_LaneSet4">
        <bpmn:lane id="W3004_Lane1" name="Customer Service">
        <bpmn:flowNodeRef>W3004_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3004_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3004_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3004_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3004_Lane3" name="Store">
        <bpmn:flowNodeRef>W3004_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3004_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3004_Start5" name="Customer presents recalled product">
        <bpmn:outgoing>W3004_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3004_Task6" name="Customer Service/Store receives returned/recalled product; verifies SKU/lot…">
        <bpmn:documentation>Step 1: Customer Service/Store receives returned/recalled product; verifies SKU/lot against recall scope; logs to recall case with customer identity (privacy-minimized)
Responsible (R): Customer Service / Store
Accountable (A): Customer Service Manager
Duration: Per return</bpmn:documentation>
        <bpmn:incoming>W3004_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3004_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3004_Task7" name="Finance processes remedy per recall matrix: cash refund (BIR-compliant), store…">
        <bpmn:documentation>Step 2: Finance processes remedy per recall matrix: cash refund (BIR-compliant), store credit, replacement, or repair booking; processes refund via original tender or store credit per W101
Responsible (R): Finance / AR
Accountable (A): Finance Manager
