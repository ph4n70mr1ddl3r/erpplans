    <bpmn:process id="W_W3008" name="W3008. Recall Progress Tracking, Daily Status Reporting &amp; Effectiveness Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Recall execution ongoing
Frequency: Daily during active recall
Volume: One dashboard per active recall
Owner: Product Safety &amp; Compliance Manager
Participants: Product Safety Mgr, Data Analytics, Recall Committee
Source: workflow W3008 — Recall Progress Tracking, Daily Status Reporting &amp; Effectiveness Measurement</bpmn:documentation>
      <bpmn:laneSet id="W3008_LaneSet3">
        <bpmn:lane id="W3008_Lane1" name="Data Analytics">
        <bpmn:flowNodeRef>W3008_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3008_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3008_Lane2" name="Product Safety">
        <bpmn:flowNodeRef>W3008_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3008_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3008_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3008_Start4" name="Recall execution ongoing">
        <bpmn:outgoing>W3008_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3008_Task5" name="Data Analytics/Product Safety maintain recall dashboard: units in-field, units…">
        <bpmn:documentation>Step 1: Data Analytics/Product Safety maintain recall dashboard: units in-field, units recovered (by channel/store), notification reach %, remedy mix, cost-to-date
Responsible (R): Data Analytics / Product Safety
Accountable (A): Product Safety &amp; Compliance Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3008_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3008_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3008_Task6" name="Product Safety reports daily status to Recall Committee; flags under-performing…">
        <bpmn:documentation>Step 2: Product Safety reports daily status to Recall Committee; flags under-performing stores/channels; triggers corrective follow-up
Responsible (R): Product Safety
Accountable (A): VP Legal &amp; Compliance
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W3008_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3008_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3008_Task7" name="Product Safety measures effectiveness vs. targets (W2999); documents evidence…">
        <bpmn:documentation>Step 3: Product Safety measures effectiveness vs. targets (W2999); documents evidence package for regulator close-out and insurance
Responsible (R): Product Safety
Accountable (A): Regulatory Compliance Manager
Duration: Through recall</bpmn:documentation>
        <bpmn:incoming>W3008_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3008_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3008_End8" name="Complete">
        <bpmn:incoming>W3008_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3008_Annotation9">
        <bpmn:text>Controls: - CTL-152 (ensure recall regulatory reporting &amp; closure.) | - operational: daily dashboard and effectiveness targets
Owner: Product Safety &amp; Compliance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3008_Assoc10" sourceRef="W3008_Annotation9" targetRef="W3008_Start4" associationDirection="None" />
