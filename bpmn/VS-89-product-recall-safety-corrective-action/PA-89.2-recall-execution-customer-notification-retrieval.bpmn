        <bpmndi:BPMNShape id="W3002_End9_di" bpmnElement="W3002_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3002_Annotation10_di" bpmnElement="W3002_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
