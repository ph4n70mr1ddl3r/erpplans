    <bpmn:process id="W_W5403" name="W5403. Customer Invoice Reissuance/Re-assignment &amp; Remit-To Instruction Update" isExecutable="false">
      <bpmn:documentation>Trigger: Notification factoring (W5396); customer remit-to change
Frequency: Per notified customer/segment; per remit change
Volume: ~5,200 customer remit records; ~changes
Owner: AR Lead
Participants: Customer, Trade Account Manager (VS-107), Factor
Source: workflow W5403 — Customer Invoice Reissuance/Re-assignment &amp; Remit-To Instruction Update</bpmn:documentation>
      <bpmn:laneSet id="W5403_LaneSet3">
        <bpmn:lane id="W5403_Lane1" name="AR Lead">
        <bpmn:flowNodeRef>W5403_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5403_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5403_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5403_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5403_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5403_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W5403_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5403_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5403_Start4" name="Notification factoring (W5396); customer remit-to change">
        <bpmn:outgoing>W5403_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5403_Task5" name="For notification factoring: update the customer master remit-to to the…">
        <bpmn:documentation>Step 1: For notification factoring: update the customer master remit-to to the factor/lockbox (W5396).
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per customer</bpmn:documentation>
        <bpmn:incoming>W5403_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5403_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5403_Task6" name="Reissue/re-assign invoices (where required) with the new remit-to and…">
        <bpmn:documentation>Step 2: Reissue/re-assign invoices (where required) with the new remit-to and assignment notice.
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per invoice</bpmn:documentation>
        <bpmn:incoming>W5403_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5403_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5403_Task7" name="Communicate the change to the customer (Trade Account Mgmt) to avoid…">
        <bpmn:documentation>Step 3: Communicate the change to the customer (Trade Account Mgmt) to avoid mis-directed payment (W5404).
Responsible (R): Trade Account Manager
Accountable (A): Credit Manager
Duration: per customer</bpmn:documentation>
        <bpmn:incoming>W5403_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5403_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5403_Task8" name="Update AR (VS-16) and customer master (VS-29) with the assignment/remit status.">
        <bpmn:documentation>Step 4: Update AR (VS-16) and customer master (VS-29) with the assignment/remit status.
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per customer</bpmn:documentation>
        <bpmn:incoming>W5403_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5403_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5403_Task9" name="Verify the customer&#x27;s next payment routes correctly to the factor/lockbox.">
        <bpmn:documentation>Step 5: Verify the customer&#x27;s next payment routes correctly to the factor/lockbox.
Responsible (R): AR Lead
Accountable (A): Credit Manager
Duration: per cycle</bpmn:documentation>
        <bpmn:incoming>W5403_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5403_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5403_End10" name="Complete">
        <bpmn:incoming>W5403_Flow18</bpmn:incoming>
      </bpmn:endEvent>
