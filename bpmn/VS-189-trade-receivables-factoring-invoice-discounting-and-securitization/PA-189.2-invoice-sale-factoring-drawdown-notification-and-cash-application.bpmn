        <bpmn:text>Controls: - CTL-798 (ensure controlled execution — Invoice Sale, Factoring Drawdown, Notification &amp; Cash Application (PA-189.2).) | - operational: payment-routing verification.
Owner: AR Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5403_Assoc12" sourceRef="W5403_Annotation11" targetRef="W5403_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5403_Flow13" sourceRef="W5403_Start4" targetRef="W5403_Task5" />
      <bpmn:sequenceFlow id="W5403_Flow14" sourceRef="W5403_Task5" targetRef="W5403_Task6" />
