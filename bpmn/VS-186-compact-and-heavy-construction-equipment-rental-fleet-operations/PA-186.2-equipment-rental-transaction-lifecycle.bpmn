<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-186.2-equipment-rental-transaction-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5329" name="W5329. Heavy Equipment Reservation, Quoting &amp; Rental Agreement Generation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer booking (online W5328 or in-store)
Frequency: ~3,000–6,000 rentals/yr
Volume: 1 reservation per rental
Owner: Rental Counter Supervisor
Participants: Credit Analyst, Customer, Store Manager (override approvals)
Source: workflow W5329 — Heavy Equipment Reservation, Quoting &amp; Rental Agreement Generation</bpmn:documentation>
      <bpmn:laneSet id="W5329_LaneSet3">
        <bpmn:lane id="W5329_Lane1" name="Rental Counter Staff">
        <bpmn:flowNodeRef>W5329_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5329_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5329_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5329_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5329_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5329_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W5329_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5329_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5329_Start4" name="Customer booking (online W5328 or in-store)">
        <bpmn:outgoing>W5329_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5329_Task5" name="Confirm unit availability for the requested window at the chosen hub (single…">
        <bpmn:documentation>Step 1: Confirm unit availability for the requested window at the chosen hub (single rental-asset ledger).
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5329_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5329_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5329_Task6" name="Generate quote: base rate (day/week), delivery (W5331), CDW (W5327), deposit…">
        <bpmn:documentation>Step 2: Generate quote: base rate (day/week), delivery (W5331), CDW (W5327), deposit hold, and estimated fuel/wear.
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5329_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5329_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5329_Task7" name="Confirm pre-qualification standing (W5326); place deposit pre-auth on…">
        <bpmn:documentation>Step 3: Confirm pre-qualification standing (W5326); place deposit pre-auth on card/trade account.
Responsible (R): Credit Analyst
Accountable (A): Rental Counter Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5329_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5329_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5329_Task8" name="Generate the rental agreement: serial, hour-meter-out, rate, period, CDW…">
        <bpmn:documentation>Step 4: Generate the rental agreement: serial, hour-meter-out, rate, period, CDW election, and operator acknowledgment.
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5329_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5329_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5329_Task9" name="Reserve the unit (status: Reserved) and freeze availability for the window.">
        <bpmn:documentation>Step 5: Reserve the unit (status: Reserved) and freeze availability for the window.
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5329_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5329_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5329_End10" name="Complete">
        <bpmn:incoming>W5329_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5329_Annotation11">
        <bpmn:text>Controls: - CTL-05: prevent unauthorized credit-limit overrides on the deposit hold; CTL-12 (credit approval separated from the counter).
Owner: Rental Counter Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5329_Assoc12" sourceRef="W5329_Annotation11" targetRef="W5329_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5329_Flow13" sourceRef="W5329_Start4" targetRef="W5329_Task5" />
      <bpmn:sequenceFlow id="W5329_Flow14" sourceRef="W5329_Task5" targetRef="W5329_Task6" />
      <bpmn:sequenceFlow id="W5329_Flow15" sourceRef="W5329_Task6" targetRef="W5329_Task7" />
      <bpmn:sequenceFlow id="W5329_Flow16" sourceRef="W5329_Task7" targetRef="W5329_Task8" />
      <bpmn:sequenceFlow id="W5329_Flow17" sourceRef="W5329_Task8" targetRef="W5329_Task9" />
      <bpmn:sequenceFlow id="W5329_Flow18" sourceRef="W5329_Task9" targetRef="W5329_End10" />
    </bpmn:process>
