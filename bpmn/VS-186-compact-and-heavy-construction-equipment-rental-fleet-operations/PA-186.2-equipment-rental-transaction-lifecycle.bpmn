    <bpmn:process id="W_W5334" name="W5334. Heavy Equipment Return Inspection, Damage Assessment &amp; Repair Cost Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Unit returns to yard (post W5331 pickup or self-return)
Frequency: Every rental return
Volume: ~3,000–6,000 returns/yr
Owner: Rental Yard Lead
Participants: Mechanic, Customer, Credit/Billing, Insurance (W5327)
Source: workflow W5334 — Heavy Equipment Return Inspection, Damage Assessment &amp; Repair Cost Recovery</bpmn:documentation>
      <bpmn:laneSet id="W5334_LaneSet4">
        <bpmn:lane id="W5334_Lane1" name="Rental Yard Lead">
        <bpmn:flowNodeRef>W5334_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5334_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5334_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5334_Lane2" name="Mechanic">
        <bpmn:flowNodeRef>W5334_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5334_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5334_Lane3" name="Credit">
        <bpmn:flowNodeRef>W5334_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5334_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5334_Start5" name="Unit returns to yard (post W5331 pickup or self-return)">
        <bpmn:outgoing>W5334_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5334_Task6" name="Inspect against the pre-rental baseline (W5330): compare condition photos…">
        <bpmn:documentation>Step 1: Inspect against the pre-rental baseline (W5330): compare condition photos, hour-meter-in, fluids, tracks/tires, glass, and structure.
Responsible (R): Rental Yard Lead
Accountable (A): Rental Yard Lead
Duration: 25 min</bpmn:documentation>
        <bpmn:incoming>W5334_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5334_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5334_Task7" name="Log any new damage with photos and a damage code; classify fair-wear vs…">
        <bpmn:documentation>Step 2: Log any new damage with photos and a damage code; classify fair-wear vs. chargeable.
Responsible (R): Mechanic
Accountable (A): Rental Yard Lead
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5334_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5334_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5334_Task8" name="Quote repair cost (parts + labour + downtime) for chargeable damage; confirm…">
        <bpmn:documentation>Step 3: Quote repair cost (parts + labour + downtime) for chargeable damage; confirm with customer.
Responsible (R): Mechanic
Accountable (A): Rental Yard Lead
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W5334_Flow16</bpmn:incoming>
