        <bpmndi:BPMNShape id="W5329_Annotation11_di" bpmnElement="W5329_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5329_Flow13_di" bpmnElement="W5329_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Flow14_di" bpmnElement="W5329_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Flow15_di" bpmnElement="W5329_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Flow16_di" bpmnElement="W5329_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Flow17_di" bpmnElement="W5329_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Flow18_di" bpmnElement="W5329_Flow18"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5329_Assoc12_di" bpmnElement="W5329_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5330" name="W5330. Equipment Pre-Rental Inspection, Safety Briefing &amp; Operator Handover" isExecutable="false">
      <bpmn:documentation>Trigger: Customer collects at counter, or unit about to be delivered to jobsite (W5331)
Frequency: Every rental out
Volume: ~3,000–6,000 handovers/yr
Owner: Rental Yard Lead
Participants: Mechanic, HSE Officer, Customer/Operator
Source: workflow W5330 — Equipment Pre-Rental Inspection, Safety Briefing &amp; Operator Handover</bpmn:documentation>
      <bpmn:laneSet id="W5330_LaneSet4">
        <bpmn:lane id="W5330_Lane1" name="Rental Yard Lead">
        <bpmn:flowNodeRef>W5330_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5330_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5330_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5330_Lane2" name="HSE Officer">
        <bpmn:flowNodeRef>W5330_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5330_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5330_Lane3" name="Mechanic">
        <bpmn:flowNodeRef>W5330_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5330_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5330_Start5" name="Customer collects at counter, or unit about to be delivered to jobsite (W5331)">
        <bpmn:outgoing>W5330_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5330_Task6" name="Conduct pre-rental inspection with the customer: condition photos…">
        <bpmn:documentation>Step 1: Conduct pre-rental inspection with the customer: condition photos, hour-meter-out, fluids, tires/tracks, safety devices, and damage log.
Responsible (R): Rental Yard Lead
Accountable (A): Rental Yard Lead
Duration: 20 min</bpmn:documentation>
        <bpmn:incoming>W5330_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5330_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5330_Task7" name="Deliver class-specific safety briefing: controls, emergency stop, PPE required…">
        <bpmn:documentation>Step 2: Deliver class-specific safety briefing: controls, emergency stop, PPE required, load/capacity limits, refueling/charging, and emergency contact.
Responsible (R): HSE Officer
Accountable (A): Rental Yard Lead
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W5330_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5330_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5330_Task8" name="Verify operator competency acknowledgment (W5326) is signed; re-confirm for…">
        <bpmn:documentation>Step 3: Verify operator competency acknowledgment (W5326) is signed; re-confirm for high-risk classes (aerial lifts, earthmoving).
Responsible (R): HSE Officer
Accountable (A): Rental Yard Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5330_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5330_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5330_Task9" name="Confirm telematics (W5324) is live and geofence set; hand over keys/controls.">
        <bpmn:documentation>Step 4: Confirm telematics (W5324) is live and geofence set; hand over keys/controls.
Responsible (R): Mechanic
Accountable (A): Rental Yard Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5330_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5330_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5330_Task10" name="Capture customer signature on condition + briefing acknowledgment; post to the…">
        <bpmn:documentation>Step 5: Capture customer signature on condition + briefing acknowledgment; post to the agreement (VS-88).
Responsible (R): Rental Yard Lead
Accountable (A): Rental Yard Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5330_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5330_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5330_End11" name="Complete">
        <bpmn:incoming>W5330_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5330_Annotation12">
        <bpmn:text>Controls: - CTL-104: rental-equipment condition &amp; safety baselining; operational: no-handover-without-signed-acknowledgment gate.
Owner: Rental Yard Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5330_Assoc13" sourceRef="W5330_Annotation12" targetRef="W5330_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5330_Flow14" sourceRef="W5330_Start5" targetRef="W5330_Task6" />
      <bpmn:sequenceFlow id="W5330_Flow15" sourceRef="W5330_Task6" targetRef="W5330_Task7" />
      <bpmn:sequenceFlow id="W5330_Flow16" sourceRef="W5330_Task7" targetRef="W5330_Task8" />
      <bpmn:sequenceFlow id="W5330_Flow17" sourceRef="W5330_Task8" targetRef="W5330_Task9" />
      <bpmn:sequenceFlow id="W5330_Flow18" sourceRef="W5330_Task9" targetRef="W5330_Task10" />
      <bpmn:sequenceFlow id="W5330_Flow19" sourceRef="W5330_Task10" targetRef="W5330_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5330_diag">
      <bpmndi:BPMNPlane id="W5330_plane" bpmnElement="W_W5330">
        <bpmndi:BPMNShape id="W5330_Lane1_di" bpmnElement="W5330_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Lane2_di" bpmnElement="W5330_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Lane3_di" bpmnElement="W5330_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Task6_di" bpmnElement="W5330_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Task7_di" bpmnElement="W5330_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Task8_di" bpmnElement="W5330_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Task9_di" bpmnElement="W5330_Task9"><dc:Bounds x="1030" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Task10_di" bpmnElement="W5330_Task10"><dc:Bounds x="1240" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Start5_di" bpmnElement="W5330_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_End11_di" bpmnElement="W5330_End11"><dc:Bounds x="1470" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5330_Annotation12_di" bpmnElement="W5330_Annotation12"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5330_Flow14_di" bpmnElement="W5330_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Flow15_di" bpmnElement="W5330_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Flow16_di" bpmnElement="W5330_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Flow17_di" bpmnElement="W5330_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Flow18_di" bpmnElement="W5330_Flow18"><di:waypoint x="1210" y="505" /><di:waypoint x="1240" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Flow19_di" bpmnElement="W5330_Flow19"><di:waypoint x="1420" y="165" /><di:waypoint x="1470" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5330_Assoc13_di" bpmnElement="W5330_Assoc13"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5331" name="W5331. Customer Equipment Transport, Delivery-to-Jobsite &amp; Pickup Logistics" isExecutable="false">
      <bpmn:documentation>Trigger: Rental with delivery option (vs. customer self-haul)
Frequency: ~40–60% of rentals include delivery (~1,500–3,000 deliveries/yr)
Volume: 1 delivery leg per delivered rental (out + return)
Owner: Logistics Dispatcher
Participants: 3PL/Hauler, Store Receiving (at jobsite return), Insurance (W5327)
Source: workflow W5331 — Customer Equipment Transport, Delivery-to-Jobsite &amp; Pickup Logistics</bpmn:documentation>
      <bpmn:laneSet id="W5331_LaneSet3">
        <bpmn:lane id="W5331_Lane1" name="Logistics Dispatcher">
        <bpmn:flowNodeRef>W5331_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5331_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5331_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5331_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5331_Lane2" name="3PL Driver">
        <bpmn:flowNodeRef>W5331_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5331_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5331_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5331_Start4" name="Rental with delivery option (vs. customer self-haul)">
        <bpmn:outgoing>W5331_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5331_Task5" name="Plan transport: equipment weight/dimensions, tilt-bed/lowboy/trailer…">
        <bpmn:documentation>Step 1: Plan transport: equipment weight/dimensions, tilt-bed/lowboy/trailer requirement, and route permits for oversized loads (links VS-74).
Responsible (R): Logistics Dispatcher
Accountable (A): Logistics Dispatcher
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5331_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5331_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5331_Task6" name="Book qualified hauler (3PL or BuildRight tow vehicle) with cargo/CTR insurance…">
        <bpmn:documentation>Step 2: Book qualified hauler (3PL or BuildRight tow vehicle) with cargo/CTR insurance (VS-25/VS-26).
Responsible (R): Logistics Dispatcher
Accountable (A): Logistics Dispatcher
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5331_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5331_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5331_Task7" name="Load, secure, and chain per equipment class; document load-down photos.">
        <bpmn:documentation>Step 3: Load, secure, and chain per equipment class; document load-down photos.
Responsible (R): 3PL Driver
Accountable (A): Logistics Dispatcher
Duration: 45 min</bpmn:documentation>
        <bpmn:incoming>W5331_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5331_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5331_Task8" name="Deliver to jobsite; obtain site sign-off and handover to the customer&#x27;s…">
        <bpmn:documentation>Step 4: Deliver to jobsite; obtain site sign-off and handover to the customer&#x27;s operator (W5330).
Responsible (R): 3PL Driver
Accountable (A): Logistics Dispatcher
Duration: varies</bpmn:documentation>
        <bpmn:incoming>W5331_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5331_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5331_Task9" name="Schedule and execute return pickup; confirm telematics (W5324) re-enters the…">
        <bpmn:documentation>Step 5: Schedule and execute return pickup; confirm telematics (W5324) re-enters the yard geofence.
Responsible (R): Logistics Dispatcher
Accountable (A): Logistics Dispatcher
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5331_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5331_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5331_End10" name="Complete">
        <bpmn:incoming>W5331_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5331_Annotation11">
        <bpmn:text>Controls: - CTL-25: safeguard inventory in transit; operational: permit-checklist gate before dispatch.
Owner: Logistics Dispatcher</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5331_Assoc12" sourceRef="W5331_Annotation11" targetRef="W5331_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5331_Flow13" sourceRef="W5331_Start4" targetRef="W5331_Task5" />
      <bpmn:sequenceFlow id="W5331_Flow14" sourceRef="W5331_Task5" targetRef="W5331_Task6" />
