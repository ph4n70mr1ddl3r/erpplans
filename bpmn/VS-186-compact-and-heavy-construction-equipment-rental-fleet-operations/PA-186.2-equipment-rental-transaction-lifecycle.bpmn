    <bpmn:process id="W_W5333" name="W5333. Equipment Extension, Rollover, Early Return &amp; Re-rental Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Renter requests extension; telematics shows overage (W5332); or early return
Frequency: ~20–30% of rentals have a change
Volume: ~1,000–1,800 changes/yr
Owner: Rental Counter Supervisor
Participants: Credit Analyst, Customer, Next-in-queue renter
Source: workflow W5333 — Equipment Extension, Rollover, Early Return &amp; Re-rental Processing</bpmn:documentation>
      <bpmn:laneSet id="W5333_LaneSet2">
        <bpmn:lane id="W5333_Lane1" name="Rental Counter Staff">
        <bpmn:flowNodeRef>W5333_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5333_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5333_Start3" name="Renter requests extension; telematics shows overage (W5332); or early return">
        <bpmn:outgoing>W5333_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5333_Task4" name="Validate the change request against the unit&#x27;s next reservation (no conflict)…">
        <bpmn:documentation>Step 1: Validate the change request against the unit&#x27;s next reservation (no conflict) and renter&#x27;s credit standing.
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5333_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5333_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5333_Task5" name="For extension: re-rate to the appropriate daily/weekly tier and re-confirm…">
        <bpmn:documentation>Step 2: For extension: re-rate to the appropriate daily/weekly tier and re-confirm deposit/CDW coverage (W5327).
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5333_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5333_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5333_Task6" name="For early return: stop billing at actual return, release the remaining window…">
        <bpmn:documentation>Step 3: For early return: stop billing at actual return, release the remaining window to availability, and notify any waitlist (links VS-149/W139 booking).
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5333_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5333_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5333_Task7" name="Amend the agreement and capture customer acknowledgment; re-freeze availability.">
        <bpmn:documentation>Step 4: Amend the agreement and capture customer acknowledgment; re-freeze availability.
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5333_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5333_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5333_Task8" name="Re-invoice/reverse per the change; post to billing (W5335).">
        <bpmn:documentation>Step 5: Re-invoice/reverse per the change; post to billing (W5335).
Responsible (R): Rental Counter Staff
Accountable (A): Rental Counter Supervisor
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W5333_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5333_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5333_End9" name="Complete">
        <bpmn:incoming>W5333_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5333_Annotation10">
        <bpmn:text>Controls: - CTL-05: deposit/credit re-check on extension; operational: reservation-conflict block.
Owner: Rental Counter Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5333_Assoc11" sourceRef="W5333_Annotation10" targetRef="W5333_Start3" associationDirection="None" />
