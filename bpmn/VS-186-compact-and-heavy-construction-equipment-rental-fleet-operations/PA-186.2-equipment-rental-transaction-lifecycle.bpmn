      <bpmndi:BPMNPlane id="W5329_plane" bpmnElement="W_W5329">
        <bpmndi:BPMNShape id="W5329_Lane1_di" bpmnElement="W5329_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
