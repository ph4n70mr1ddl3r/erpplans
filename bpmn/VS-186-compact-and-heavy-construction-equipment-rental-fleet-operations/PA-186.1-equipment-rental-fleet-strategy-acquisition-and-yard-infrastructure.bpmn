    <bpmn:process id="W_W5322" name="W5322. Construction Equipment Vendor Selection, Procurement &amp; Fleet Acquisition" isExecutable="false">
      <bpmn:documentation>Trigger: Approved category-mix and capex envelope (W5321)
Frequency: Per fleet-acquisition wave (~2–4 waves/year)
Volume: ~15–40 units per wave; ~60–120 units added/yr in steady state
Owner: Procurement Manager (Equipment)
Participants: Rental Fleet Manager, TESDA-qualified mechanic, Finance, Vendor (Komatsu/Kubota/Bobcat/JCB/Wacker Neuson/etc.)
Source: workflow W5322 — Construction Equipment Vendor Selection, Procurement &amp; Fleet Acquisition</bpmn:documentation>
      <bpmn:laneSet id="W5322_LaneSet5">
        <bpmn:lane id="W5322_Lane1" name="Procurement Manager">
        <bpmn:flowNodeRef>W5322_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5322_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5322_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5322_Lane2" name="Rental Fleet Manager">
        <bpmn:flowNodeRef>W5322_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5322_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W5322_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5322_Lane4" name="Finance Business Partner">
        <bpmn:flowNodeRef>W5322_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5322_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5322_Start6" name="Approved category-mix and capex envelope (W5321)">
        <bpmn:outgoing>W5322_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5322_Task7" name="Issue RFP to equipment OEMs/dealers for rental-grade units with parts…">
        <bpmn:documentation>Step 1: Issue RFP to equipment OEMs/dealers for rental-grade units with parts availability and after-sales support in the Philippines.
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5322_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5322_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5322_Task8" name="Evaluate on durability, hour-rating, local parts depots, dealer service…">
        <bpmn:documentation>Step 2: Evaluate on durability, hour-rating, local parts depots, dealer service network, and rental-program support (per W224 vendor selection).
Responsible (R): Rental Fleet Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5322_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5322_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5322_Task9" name="Negotiate price, warranty, and fleet service agreement; confirm PHP landed cost…">
        <bpmn:documentation>Step 3: Negotiate price, warranty, and fleet service agreement; confirm PHP landed cost including freight to DC (per VS-02.2).
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5322_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5322_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5322_Task10" name="Raise PO; receive units at the assigned hub DC; inspect against spec and…">
        <bpmn:documentation>Step 4: Raise PO; receive units at the assigned hub DC; inspect against spec and register assets (W5324).
Responsible (R): Receiving Clerk
Accountable (A): Rental Fleet Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5322_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5322_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5322_Task11" name="Acceptance sign-off and asset capitalization to the Rental Fleet GL class.">
        <bpmn:documentation>Step 5: Acceptance sign-off and asset capitalization to the Rental Fleet GL class.
Responsible (R): Finance Business Partner
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W5322_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5322_End12" name="Complete">
        <bpmn:incoming>W5322_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5322_Annotation13">
        <bpmn:text>Controls: - CTL-06: vendor onboarding; CTL-14 (3-way match); CTL-26 (fixed asset capitalization control).
Owner: Procurement Manager (Equipment)</bpmn:text>
      </bpmn:textAnnotation>
