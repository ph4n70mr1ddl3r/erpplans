    <bpmn:process id="W_W5324" name="W5324. Heavy Equipment Rental Fleet Asset Registration, Tracking &amp; Telematics Provisioning" isExecutable="false">
      <bpmn:documentation>Trigger: Unit received at hub DC (W5322)
