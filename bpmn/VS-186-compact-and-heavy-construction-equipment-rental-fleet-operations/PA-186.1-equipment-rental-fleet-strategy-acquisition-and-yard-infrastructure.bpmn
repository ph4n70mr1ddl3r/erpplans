    <bpmn:process id="W_W5323" name="W5323. Rental Equipment Yard, Wash Bay &amp; Heavy-Equipment Storage Infrastructure Setup" isExecutable="false">
      <bpmn:documentation>Trigger: New hub store selected for an equipment-rental footprint (W5321)
Frequency: Per hub/satellite setup (~10–20 sites/yr as the network rolls out)
Volume: 1 yard-build per site
Owner: Facilities &amp; Real Estate Manager
Participants: Store Manager, HSE Officer, BFP-accredited Fire Safety Inspector, Corporate Security (VS-159)
Source: workflow W5323 — Rental Equipment Yard, Wash Bay &amp; Heavy-Equipment Storage Infrastructure Setup</bpmn:documentation>
      <bpmn:laneSet id="W5323_LaneSet3">
        <bpmn:lane id="W5323_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W5323_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5323_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5323_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5323_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5323_Lane2" name="HSE Officer">
        <bpmn:flowNodeRef>W5323_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5323_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5323_Start4" name="New hub store selected for an equipment-rental footprint (W5321)">
        <bpmn:outgoing>W5323_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5323_Task5" name="Design the rental yard: compacted/graded laydown, security lighting, CCTV…">
        <bpmn:documentation>Step 1: Design the rental yard: compacted/graded laydown, security lighting, CCTV coverage, fenced perimeter, and equipment-tier separation.
Responsible (R): Facilities Manager
Accountable (A): Store Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W5323_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5323_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5323_Task6" name="Build wash-down bay with oil-water interceptor and sump (DENR-ECC compliant for…">
        <bpmn:documentation>Step 2: Build wash-down bay with oil-water interceptor and sump (DENR-ECC compliant for wash runoff, per VS-24/VS-187).
Responsible (R): Facilities Manager
Accountable (A): HSE Officer
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5323_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5323_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5323_Task7" name="Install fueling/battery-charge station, spill kit, and fire suppression rated…">
        <bpmn:documentation>Step 3: Install fueling/battery-charge station, spill kit, and fire suppression rated for diesel/equipment (BFP Fire Code FSIC).
Responsible (R): Facilities Manager
Accountable (A): BFP Inspector
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W5323_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5323_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5323_Task8" name="Commission the yard; sign off HSE and BFP FSIC before first unit intake.">
        <bpmn:documentation>Step 4: Commission the yard; sign off HSE and BFP FSIC before first unit intake.
Responsible (R): HSE Officer
Accountable (A): Store Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5323_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5323_End9" name="Complete">
        <bpmn:incoming>W5323_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5323_Annotation10">
        <bpmn:text>Controls: - CTL-104: rental-fleet asset safeguarding at the yard; operational: BFP FSIC sign-off before commissioning.
Owner: Facilities &amp; Real Estate Manager</bpmn:text>
      </bpmn:textAnnotation>
