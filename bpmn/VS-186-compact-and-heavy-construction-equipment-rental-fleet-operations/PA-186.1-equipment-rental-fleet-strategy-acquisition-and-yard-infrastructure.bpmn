    <bpmn:process id="W_W5325" name="W5325. Equipment Rental Rate Card, Pricing Structure &amp; Competitor Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Fleet intake (W5322) and quarterly margin review
Frequency: Quarterly rate review; ad-hoc per competitor move
Volume: 1 rate card per quarter covering ~25–40 equipment classes
Owner: Rental Pricing Analyst
Participants: COO, Finance Business Partner, Competitive Intelligence (VS-57)
Source: workflow W5325 — Equipment Rental Rate Card, Pricing Structure &amp; Competitor Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W5325_LaneSet2">
        <bpmn:lane id="W5325_Lane1" name="Rental Pricing Analyst">
        <bpmn:flowNodeRef>W5325_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5325_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5325_Start3" name="Fleet intake (W5322) and quarterly margin review">
        <bpmn:outgoing>W5325_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5325_Task4" name="Gather competitor rental rates (specialty rental houses, peer big-box) by class…">
        <bpmn:documentation>Step 1: Gather competitor rental rates (specialty rental houses, peer big-box) by class and region.
Responsible (R): Rental Pricing Analyst
Accountable (A): COO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5325_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5325_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5325_Task5" name="Build hourly/daily/weekly/monthly rate per class covering capex amortization…">
        <bpmn:documentation>Step 2: Build hourly/daily/weekly/monthly rate per class covering capex amortization, utilization, fuel/wear, and target margin.
Responsible (R): Rental Pricing Analyst
Accountable (A): Finance Business Partner
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W5325_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5325_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5325_Task6" name="Define CDW (collision damage waiver) fee, delivery fee, and late/overtime rate.">
        <bpmn:documentation>Step 3: Define CDW (collision damage waiver) fee, delivery fee, and late/overtime rate.
Responsible (R): Rental Pricing Analyst
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5325_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5325_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5325_Task7" name="Load rate card to POS/rental module; publish to the digital booking channel…">
        <bpmn:documentation>Step 4: Load rate card to POS/rental module; publish to the digital booking channel (W5328).
Responsible (R): Rental Pricing Analyst
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W5325_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5325_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5325_Task8" name="Monitor realized rate vs. rate card weekly and flag erosion.">
        <bpmn:documentation>Step 5: Monitor realized rate vs. rate card weekly and flag erosion.
Responsible (R): Rental Pricing Analyst
Accountable (A): COO
Duration: ongoing</bpmn:documentation>
        <bpmn:incoming>W5325_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5325_End9" name="Complete">
        <bpmn:incoming>W5325_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5325_Annotation10">
        <bpmn:text>Controls: - CTL-07: prevent unauthorized pricing changes — rate-card change approval; CTL-35 (margin adherence).
Owner: Rental Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
