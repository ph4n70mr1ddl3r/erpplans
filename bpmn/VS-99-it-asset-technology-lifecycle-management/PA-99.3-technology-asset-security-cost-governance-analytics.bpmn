    <bpmn:process id="W_W3255" name="W3255. IT Vendor &amp; Hardware Warranty Management" isExecutable="false">
      <bpmn:documentation>Trigger: Warranty expiry; vendor performance issue; contract renewal
Frequency: Per contract + ongoing
Volume: ~20–50 IT hardware/software/cloud vendors
Owner: IT Asset Manager
Participants: IT Asset Mgr, Procurement (links to VS-34/VS-67), IT Ops (links to VS-27), Finance, Legal
Source: workflow W3255 — IT Vendor &amp; Hardware Warranty Management</bpmn:documentation>
      <bpmn:laneSet id="W3255_LaneSet2">
        <bpmn:lane id="W3255_Lane1" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3255_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3255_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3255_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3255_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3255_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3255_Start3" name="Warranty expiry; vendor performance issue; contract renewal">
        <bpmn:outgoing>W3255_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3255_Task4" name="IT Asset Mgr/Procurement manage IT vendor relationships: maintain vendor master…">
        <bpmn:documentation>Step 1: IT Asset Mgr/Procurement manage IT vendor relationships: maintain vendor master (links to VS-29), framework agreements (W3234), warranty/SLA terms, RMA process (W3237), support tiers, escalation contacts; track vendor performance (delivery, quality, support responsiveness)
Responsible (R): IT Asset Mgr / Procurement
Accountable (A): IT Asset Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3255_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3255_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3255_Task5" name="Manage warranties per asset: track warranty start/end and coverage per serial…">
        <bpmn:documentation>Step 2: Manage warranties per asset: track warranty start/end and coverage per serial (W3233), decide on extended-warranty purchase (cost vs expected break/fix), ensure RMA eligibility before out-of-warranty (W3237); manage vendor support contracts (vendor-specific support plans)
Responsible (R): IT Asset Mgr
Accountable (A): IT Asset Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3255_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3255_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3255_Task6" name="Vendor scorecard and review (links to VS-67 methodology): periodic business…">
        <bpmn:documentation>Step 3: Vendor scorecard and review (links to VS-67 methodology): periodic business review, performance scorecard, issue resolution, renewal/renegotiation (W3245), rationalize to preferred vendors; feed catalog decisions (W3234)
Responsible (R): IT Asset Mgr / Procurement
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3255_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3255_End7" name="Complete">
        <bpmn:incoming>W3255_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3255_Annotation8">
        <bpmn:text>Controls: - CTL-528 (ensure controlled execution — Technology Asset Security, Cost &amp; Governance Analytics (PA-99.3).) | - operational: warranty tracking; operational: multi-vendor strategy where feasible
Owner: IT Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
