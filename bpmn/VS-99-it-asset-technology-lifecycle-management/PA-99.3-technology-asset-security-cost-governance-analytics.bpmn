    <bpmn:process id="W_W3253" name="W3253. ITAM Governance, Policy &amp; Stewardship Program" isExecutable="false">
      <bpmn:documentation>Trigger: Annual governance cycle; policy refresh; audit finding
Frequency: Annual + event-driven
Volume: Enterprise-wide ITAM program
Owner: IT Asset Manager
Participants: IT Asset Mgr, IT Governance, Security (links to VS-27.3), Finance, Audit (links to VS-21), Data Governance (links to VS-28)
Source: workflow W3253 — ITAM Governance, Policy &amp; Stewardship Program</bpmn:documentation>
      <bpmn:laneSet id="W3253_LaneSet2">
        <bpmn:lane id="W3253_Lane1" name="IT Asset Mgr">
