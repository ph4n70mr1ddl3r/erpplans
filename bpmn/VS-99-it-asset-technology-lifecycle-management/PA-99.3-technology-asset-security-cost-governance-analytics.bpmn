<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-99.3-technology-asset-security-cost-governance-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3249" name="W3249. IT Asset Security Hardening &amp; Configuration Baseline" isExecutable="false">
      <bpmn:documentation>Trigger: New device deployment (W3235); policy update; security findings
Frequency: Continuous + policy cycle
Volume: All endpoints, POS, servers, network
Owner: Security Manager
Participants: Security Mgr (links to VS-27.3), IT Ops (links to VS-27), IT Asset Mgr, Development (links to VS-27.1)
Source: workflow W3249 — IT Asset Security Hardening &amp; Configuration Baseline</bpmn:documentation>
      <bpmn:laneSet id="W3249_LaneSet3">
        <bpmn:lane id="W3249_Lane1" name="Security">
        <bpmn:flowNodeRef>W3249_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3249_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3249_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3249_Lane2" name="IT Ops">
        <bpmn:flowNodeRef>W3249_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3249_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3249_Start4" name="New device deployment (W3235); policy update; security findings">
        <bpmn:outgoing>W3249_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3249_Task5" name="Security/IT Ops define and maintain hardening baselines per asset class (POS…">
        <bpmn:documentation>Step 1: Security/IT Ops define and maintain hardening baselines per asset class (POS, endpoint, server, network, mobile): CIS/industry benchmarks, BuildRight-specific standards (encryption, AV/EDR, patch level, MDM, least-privilege, disabled services/ports), approved software allow-list; version and publish baselines
Responsible (R): Security / IT Ops
Accountable (A): Security Manager
Duration: Per policy cycle</bpmn:documentation>
        <bpmn:incoming>W3249_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3249_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3249_Task6" name="Deploy and enforce baselines: build into imaging (W3235), enforce via…">
        <bpmn:documentation>Step 2: Deploy and enforce baselines: build into imaging (W3235), enforce via configuration management and MDM (W3236), monitor drift via scanning (links to VS-27.3), auto-remediate or ticket; gate new assets on baseline compliance before deployment
Responsible (R): IT Ops / Security
Accountable (A): Security Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3249_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3249_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3249_Task7" name="Audit and report baseline compliance: measure % compliant by class/location…">
        <bpmn:documentation>Step 3: Audit and report baseline compliance: measure % compliant by class/location, remediate exceptions, report to IT governance (W3253) and security risk register (links to VS-21.2/VS-27.3); align to data-privacy safeguards (links to VS-91) on devices handling personal data
Responsible (R): Security / IT Asset Mgr
Accountable (A): Security Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3249_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3249_End8" name="Complete">
        <bpmn:incoming>W3249_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3249_Annotation9">
        <bpmn:text>Controls: - CTL-528 (ensure controlled execution — Technology Asset Security, Cost &amp; Governance Analytics (PA-99.3).) | - operational: continuous scanning and auto-remediation; operational: class-specific baselines
Owner: Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3249_Assoc10" sourceRef="W3249_Annotation9" targetRef="W3249_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3249_Flow11" sourceRef="W3249_Start4" targetRef="W3249_Task5" />
      <bpmn:sequenceFlow id="W3249_Flow12" sourceRef="W3249_Task5" targetRef="W3249_Task6" />
      <bpmn:sequenceFlow id="W3249_Flow13" sourceRef="W3249_Task6" targetRef="W3249_Task7" />
      <bpmn:sequenceFlow id="W3249_Flow14" sourceRef="W3249_Task7" targetRef="W3249_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3249_diag">
      <bpmndi:BPMNPlane id="W3249_plane" bpmnElement="W_W3249">
        <bpmndi:BPMNShape id="W3249_Lane1_di" bpmnElement="W3249_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3249_Lane2_di" bpmnElement="W3249_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
