    <bpmn:process id="W_W3252" name="W3252. Asset Utilization, Right-Sizing &amp; Chargeback" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly utilization review; chargeback cycle
Frequency: Quarterly
Volume: Full estate
Owner: IT Asset Manager
Participants: IT Asset Mgr, Finance (links to VS-72/VS-17), IT Ops (links to VS-27), Entity/Dept Owners
Source: workflow W3252 — Asset Utilization, Right-Sizing &amp; Chargeback</bpmn:documentation>
      <bpmn:laneSet id="W3252_LaneSet2">
        <bpmn:lane id="W3252_Lane1" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3252_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3252_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3252_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3252_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3252_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3252_Start3" name="Quarterly utilization review; chargeback cycle">
        <bpmn:outgoing>W3252_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3252_Task4" name="IT Asset Mgr measure utilization: device uptime/usage, software-feature usage…">
        <bpmn:documentation>Step 1: IT Asset Mgr measure utilization: device uptime/usage, software-feature usage (W3242), cloud resource utilization (W3244), capacity vs demand; identify under-utilized assets and over-provisioning
Responsible (R): IT Asset Mgr / IT Ops
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3252_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3252_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3252_Task5" name="Right-size: consolidate under-utilized assets, down-size configurations, retire…">
        <bpmn:documentation>Step 2: Right-size: consolidate under-utilized assets, down-size configurations, retire redundant capacity, reassign to higher-value use; balance utilization with resilience/redundancy requirements
Responsible (R): IT Asset Mgr / IT Ops
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3252_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3252_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3252_Task6" name="Chargeback/showback to consuming entities (5 entities per VS-72) and…">
        <bpmn:documentation>Step 3: Chargeback/showback to consuming entities (5 entities per VS-72) and departments: allocate IT asset cost by usage (links to VS-72 shared-services chargeback), drive accountability, report unit economics to entity finance
Responsible (R): IT Asset Mgr / Finance
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3252_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3252_End7" name="Complete">
        <bpmn:incoming>W3252_Flow13</bpmn:incoming>
      </bpmn:endEvent>
