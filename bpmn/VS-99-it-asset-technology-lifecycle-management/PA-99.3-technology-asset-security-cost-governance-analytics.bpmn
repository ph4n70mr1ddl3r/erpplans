        <bpmndi:BPMNEdge id="W3249_Flow12_di" bpmnElement="W3249_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3249_Flow13_di" bpmnElement="W3249_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3249_Flow14_di" bpmnElement="W3249_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3249_Assoc10_di" bpmnElement="W3249_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3250" name="W3250. End-of-Life / Vulnerable Asset Remediation" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor end-of-support; CVE/vulnerability advisory; audit finding
Frequency: Continuous + event-driven
Volume: Subset of estate approaching EOL or with unpatched vulnerabilities
Owner: Security Manager
Participants: Security Mgr (links to VS-27.3), IT Ops (links to VS-27), IT Asset Mgr, Finance, Business Owners
Source: workflow W3250 — End-of-Life / Vulnerable Asset Remediation</bpmn:documentation>
      <bpmn:laneSet id="W3250_LaneSet3">
        <bpmn:lane id="W3250_Lane1" name="Security">
        <bpmn:flowNodeRef>W3250_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3250_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3250_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3250_Lane2" name="IT Ops">
        <bpmn:flowNodeRef>W3250_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3250_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3250_Start4" name="Vendor end-of-support; CVE/vulnerability advisory; audit finding">
        <bpmn:outgoing>W3250_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3250_Task5" name="Security/IT Asset Mgr identify EOL/vulnerable assets: track vendor…">
        <bpmn:documentation>Step 1: Security/IT Asset Mgr identify EOL/vulnerable assets: track vendor end-of-support dates per asset (W3233), scan for known vulnerabilities (CVEs per W3247), assess exploitability and exposure; prioritize by risk (critical/high first)
Responsible (R): Security / IT Asset Mgr
Accountable (A): Security Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3250_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3250_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3250_Task6" name="Remediate: patch/upgrade where supported, isolate/compensating-controls where…">
        <bpmn:documentation>Step 2: Remediate: patch/upgrade where supported, isolate/compensating-controls where patch unavailable, accelerate refresh (W3238) for EOL assets, decommission where uneconomic; manage business disruption and change control (links to VS-27.1 W132/W495)
Responsible (R): IT Ops / Security / IT Asset Mgr
Accountable (A): Security Manager
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W3250_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3250_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3250_Task7" name="Track remediation SLA and report: open vulnerabilities/EOL inventory…">
        <bpmn:documentation>Step 3: Track remediation SLA and report: open vulnerabilities/EOL inventory, mean-time-to-remediate, exceptions with risk acceptance and expiry; feed risk register (links to VS-21.2) and audit support (W3256)
Responsible (R): Security / IT Asset Mgr
Accountable (A): Security Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3250_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3250_End8" name="Complete">
        <bpmn:incoming>W3250_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3250_Annotation9">
        <bpmn:text>Controls: - CTL-528 (ensure controlled execution — Technology Asset Security, Cost &amp; Governance Analytics (PA-99.3).) | - operational: SLA and prioritization; operational: refresh acceleration and isolation
Owner: Security Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3250_Assoc10" sourceRef="W3250_Annotation9" targetRef="W3250_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3250_Flow11" sourceRef="W3250_Start4" targetRef="W3250_Task5" />
      <bpmn:sequenceFlow id="W3250_Flow12" sourceRef="W3250_Task5" targetRef="W3250_Task6" />
      <bpmn:sequenceFlow id="W3250_Flow13" sourceRef="W3250_Task6" targetRef="W3250_Task7" />
      <bpmn:sequenceFlow id="W3250_Flow14" sourceRef="W3250_Task7" targetRef="W3250_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3250_diag">
      <bpmndi:BPMNPlane id="W3250_plane" bpmnElement="W_W3250">
        <bpmndi:BPMNShape id="W3250_Lane1_di" bpmnElement="W3250_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3250_Lane2_di" bpmnElement="W3250_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3250_Task5_di" bpmnElement="W3250_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
