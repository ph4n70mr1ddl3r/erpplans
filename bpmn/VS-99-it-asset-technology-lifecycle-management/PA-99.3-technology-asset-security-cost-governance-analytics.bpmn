        <bpmndi:BPMNShape id="W3250_Task7_di" bpmnElement="W3250_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3250_Start4_di" bpmnElement="W3250_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3250_End8_di" bpmnElement="W3250_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3250_Annotation9_di" bpmnElement="W3250_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3250_Flow11_di" bpmnElement="W3250_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3250_Flow12_di" bpmnElement="W3250_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3250_Flow13_di" bpmnElement="W3250_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3250_Flow14_di" bpmnElement="W3250_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3250_Assoc10_di" bpmnElement="W3250_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3251" name="W3251. IT Asset Total Cost of Ownership Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly cost review; catalog/refresh decisions
Frequency: Quarterly + per decision
Volume: Full hardware/software estate
Owner: IT Asset Manager
Participants: IT Asset Mgr, Finance (links to VS-17.4), IT Ops (links to VS-27), Procurement
Source: workflow W3251 — IT Asset Total Cost of Ownership Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3251_LaneSet2">
        <bpmn:lane id="W3251_Lane1" name="IT Asset Mgr">
        <bpmn:flowNodeRef>W3251_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3251_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3251_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3251_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3251_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3251_Start3" name="Quarterly cost review; catalog/refresh decisions">
        <bpmn:outgoing>W3251_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3251_Task4" name="IT Asset Mgr/Finance build TCO model per asset class/model: acquisition…">
        <bpmn:documentation>Step 1: IT Asset Mgr/Finance build TCO model per asset class/model: acquisition (capex), software/licenses (W3241), deployment/config (W3235), support/maintenance/break-fix (W3237), operations (power, network, management), refresh/disposal (W3238/W3239); annualize over lifecycle
Responsible (R): IT Asset Mgr / Finance
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3251_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3251_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3251_Task5" name="Analyze TCO drivers and comparisons: cost per device, per store, per user…">
        <bpmn:documentation>Step 2: Analyze TCO drivers and comparisons: cost per device, per store, per user; compare models/vendors/strategies (own vs lease per VS-96 parallel, standard vs premium); identify cost outliers and optimization opportunities (W3242/W3244)
Responsible (R): IT Asset Mgr / Finance
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3251_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3251_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3251_Task6" name="Feed TCO into decisions: catalog selection (W3234), refresh policy (W3238)…">
        <bpmn:documentation>Step 3: Feed TCO into decisions: catalog selection (W3234), refresh policy (W3238), make/buy/lease, vendor selection (W3255); report TCO trends and optimization savings to IT governance and finance
Responsible (R): IT Asset Mgr / Procurement
Accountable (A): IT Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3251_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3251_End7" name="Complete">
        <bpmn:incoming>W3251_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3251_Annotation8">
        <bpmn:text>Controls: - CTL-528 (ensure controlled execution — Technology Asset Security, Cost &amp; Governance Analytics (PA-99.3).) | - operational: comprehensive TCO model; operational: granular modeling
Owner: IT Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3251_Assoc9" sourceRef="W3251_Annotation8" targetRef="W3251_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3251_Flow10" sourceRef="W3251_Start3" targetRef="W3251_Task4" />
      <bpmn:sequenceFlow id="W3251_Flow11" sourceRef="W3251_Task4" targetRef="W3251_Task5" />
      <bpmn:sequenceFlow id="W3251_Flow12" sourceRef="W3251_Task5" targetRef="W3251_Task6" />
      <bpmn:sequenceFlow id="W3251_Flow13" sourceRef="W3251_Task6" targetRef="W3251_End7" />
    </bpmn:process>
