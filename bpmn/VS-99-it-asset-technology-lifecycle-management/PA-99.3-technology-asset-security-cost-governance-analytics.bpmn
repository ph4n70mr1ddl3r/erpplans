        <bpmn:flowNodeRef>W3253_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3253_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3253_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3253_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3253_Start3" name="Annual governance cycle; policy refresh; audit finding">
        <bpmn:outgoing>W3253_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3253_Task4" name="IT Asset Mgr/IT Governance maintain ITAM policy framework: hardware lifecycle…">
        <bpmn:documentation>Step 1: IT Asset Mgr/IT Governance maintain ITAM policy framework: hardware lifecycle, software licensing, SaaS/cloud, security baseline (W3249), disposal (W3239/W3254), acceptable use (links to VS-27.3), roles/responsibilities, authority matrix; align with VS-28 data governance and VS-29 master-data governance
Responsible (R): IT Asset Mgr / IT Governance
Accountable (A): IT Asset Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3253_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3253_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3253_Task5" name="Operate ITAM stewardship: assign asset owners/stewards per class, define…">
        <bpmn:documentation>Step 2: Operate ITAM stewardship: assign asset owners/stewards per class, define data-quality standards for the CMDB (W3233) and SAM (W3241), conduct training and awareness, manage exceptions/variances; integrate with enterprise data governance council (links to VS-28 W1177)
Responsible (R): IT Asset Mgr / Stewards
Accountable (A): IT Asset Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3253_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3253_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3253_Task6" name="Measure and report ITAM maturity: KPIs (CMDB accuracy, license compliance %…">
        <bpmn:documentation>Step 3: Measure and report ITAM maturity: KPIs (CMDB accuracy, license compliance %, refresh-cycle adherence, disposal-compliance %), maturity model (people/process/technology), continuous improvement; report to IT steering and audit (links to VS-21)
Responsible (R): IT Asset Mgr / Audit
Accountable (A): IT Asset Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3253_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3253_End7" name="Complete">
        <bpmn:incoming>W3253_Flow13</bpmn:incoming>
      </bpmn:endEvent>
