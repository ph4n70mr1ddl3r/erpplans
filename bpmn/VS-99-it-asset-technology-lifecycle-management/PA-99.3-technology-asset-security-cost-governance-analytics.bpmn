      <bpmn:sequenceFlow id="W3256_Flow12" sourceRef="W3256_Task5" targetRef="W3256_Task6" />
      <bpmn:sequenceFlow id="W3256_Flow13" sourceRef="W3256_Task6" targetRef="W3256_End7" />
    </bpmn:process>
