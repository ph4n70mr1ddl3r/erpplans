      <bpmndi:BPMNPlane id="W3251_plane" bpmnElement="W_W3251">
        <bpmndi:BPMNShape id="W3251_Lane1_di" bpmnElement="W3251_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
