<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-99.2-software-asset-management-license-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3241" name="W3241. Software &amp; License Entitlement Inventory" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous discovery; reconciliation; audit (W3246)
Frequency: Continuous + quarterly reconciliation
Volume: Full software estate: OS, applications, SaaS, cloud
Owner: Software Asset Manager
Participants: Software Asset Mgr, IT Ops (links to VS-27), Procurement (links to VS-34), Legal, Finance
Source: workflow W3241 — Software &amp; License Entitlement Inventory</bpmn:documentation>
      <bpmn:laneSet id="W3241_LaneSet2">
        <bpmn:lane id="W3241_Lane1" name="Software Asset Mgr">
        <bpmn:flowNodeRef>W3241_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3241_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3241_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3241_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3241_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3241_Start3" name="Continuous discovery; reconciliation; audit (W3246)">
        <bpmn:outgoing>W3241_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3241_Task4" name="Software Asset Mgr maintain software inventory: discovery of installed software…">
        <bpmn:documentation>Step 1: Software Asset Mgr maintain software inventory: discovery of installed software (agent scan per W3233), usage telemetry; entitlement inventory (purchased licenses, subscriptions, cloud commitments) from contracts/POs (links to VS-34); reconcile installations vs entitlements to detect over/under-licensing
Responsible (R): Software Asset Mgr / IT Ops
Accountable (A): Software Asset Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3241_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3241_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3241_Task5" name="Classify and normalize the software catalog: publisher, product…">
        <bpmn:documentation>Step 2: Classify and normalize the software catalog: publisher, product, version/edition, metric (per-device, per-user, per-core, concurrent, consumption), license model (perpetual, subscription, SaaS, open-source), contract reference, renewal date, owner; build product-use hierarchy
Responsible (R): Software Asset Mgr
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3241_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3241_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3241_Task6" name="Reconcile to finance (links to VS-17/VS-34.3) and procurement (links to VS-34)…">
        <bpmn:documentation>Step 3: Reconcile to finance (links to VS-17/VS-34.3) and procurement (links to VS-34): match entitlements to POs and invoices, ensure software spend correctly capitalized (perpetual) vs expensed (subscription/SaaS); flag orphan entitlements (paid but unused)
Responsible (R): Software Asset Mgr / Finance
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3241_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3241_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3241_End7" name="Complete">
        <bpmn:incoming>W3241_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3241_Annotation8">
        <bpmn:text>Controls: - CTL-143 (ensure IT asset &amp; license entitlement integrity.) | - operational: discovery and normalization; operational: entitlement mastery
Owner: Software Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3241_Assoc9" sourceRef="W3241_Annotation8" targetRef="W3241_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3241_Flow10" sourceRef="W3241_Start3" targetRef="W3241_Task4" />
      <bpmn:sequenceFlow id="W3241_Flow11" sourceRef="W3241_Task4" targetRef="W3241_Task5" />
      <bpmn:sequenceFlow id="W3241_Flow12" sourceRef="W3241_Task5" targetRef="W3241_Task6" />
      <bpmn:sequenceFlow id="W3241_Flow13" sourceRef="W3241_Task6" targetRef="W3241_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3241_diag">
      <bpmndi:BPMNPlane id="W3241_plane" bpmnElement="W_W3241">
        <bpmndi:BPMNShape id="W3241_Lane1_di" bpmnElement="W3241_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3241_Task4_di" bpmnElement="W3241_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3241_Task5_di" bpmnElement="W3241_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3241_Task6_di" bpmnElement="W3241_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
