      <bpmn:startEvent id="W3245_Start5" name="Contract renewal; vendor true-up cycle; usage change">
        <bpmn:outgoing>W3245_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3245_Task6" name="Software Asset Mgr prepare for true-up/renewal: compile current…">
        <bpmn:documentation>Step 1: Software Asset Mgr prepare for true-up/renewal: compile current installations/usage (W3241/W3242), forecast growth (W3248), benchmark price, identify negotiation levers (consolidation, multi-year, competitive bid); build target position
Responsible (R): Software Asset Mgr / Procurement
Accountable (A): Software Asset Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3245_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3245_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3245_Task7" name="Negotiate true-up/renewal: reconcile actual vs contracted, negotiate true-up…">
        <bpmn:documentation>Step 2: Negotiate true-up/renewal: reconcile actual vs contracted, negotiate true-up charges (minimize via prior optimization W3242), renegotiate price/terms, evaluate alternatives (competitive bid, migration); Legal reviews contract (links to VS-34.2)
Responsible (R): Procurement / Legal / Software Asset Mgr
Accountable (A): Software Asset Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3245_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3245_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3245_Task8" name="Execute and manage contract: sign, record entitlements (W3241), set renewal…">
        <bpmn:documentation>Step 3: Execute and manage contract: sign, record entitlements (W3241), set renewal calendar, manage compliance going forward; track contract KPIs (unit cost trend, compliance status); feed budget (W3248)
Responsible (R): Legal / Software Asset Mgr / Finance
Accountable (A): Software Asset Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3245_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3245_Flow15</bpmn:outgoing>
      </bpmn:userTask>
