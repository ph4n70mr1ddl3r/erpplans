        <bpmndi:BPMNShape id="W3242_Task5_di" bpmnElement="W3242_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3242_Task6_di" bpmnElement="W3242_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3242_Start3_di" bpmnElement="W3242_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3242_End7_di" bpmnElement="W3242_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3242_Annotation8_di" bpmnElement="W3242_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3242_Flow10_di" bpmnElement="W3242_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3242_Flow11_di" bpmnElement="W3242_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3242_Flow12_di" bpmnElement="W3242_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3242_Flow13_di" bpmnElement="W3242_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3242_Assoc9_di" bpmnElement="W3242_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3243" name="W3243. SaaS Subscription &amp; Cloud Application Portfolio Management" isExecutable="false">
      <bpmn:documentation>Trigger: New SaaS request; renewal; portfolio review
Frequency: Continuous + annual review
Volume: ~50–150 SaaS applications (typical mid-large enterprise)
Owner: Software Asset Manager
Participants: Software Asset Mgr, IT (links to VS-27/VS-30), Security (links to VS-27.3/VS-91), Procurement, Legal, User Depts
Source: workflow W3243 — SaaS Subscription &amp; Cloud Application Portfolio Management</bpmn:documentation>
      <bpmn:laneSet id="W3243_LaneSet4">
        <bpmn:lane id="W3243_Lane1" name="Software Asset Mgr">
        <bpmn:flowNodeRef>W3243_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3243_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3243_Lane2" name="Security">
        <bpmn:flowNodeRef>W3243_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3243_Lane3" name="Procurement">
        <bpmn:flowNodeRef>W3243_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3243_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3243_Start5" name="New SaaS request; renewal; portfolio review">
        <bpmn:outgoing>W3243_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3243_Task6" name="Software Asset Mgr maintain SaaS portfolio register: application, owner…">
        <bpmn:documentation>Step 1: Software Asset Mgr maintain SaaS portfolio register: application, owner, business purpose, users, subscription cost and term, data classification (links to VS-91), integration with ERP/core (links to VS-27), criticality; detect shadow SaaS (credit-card SaaS bought by departments) via expense analytics (links to VS-34.3) and network/DNS
Responsible (R): Software Asset Mgr / IT
Accountable (A): Software Asset Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3243_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3243_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3243_Task7" name="Security/Privacy (links to VS-27.3/VS-91) assess each SaaS: data-protection…">
        <bpmn:documentation>Step 2: Security/Privacy (links to VS-27.3/VS-91) assess each SaaS: data-protection (DPA with vendor per RA 10173), access controls, integration risk, vendor due diligence (links to VS-91.2), exit/portability; approve or remediate; consolidate redundant SaaS
Responsible (R): Security / Legal / Software Asset Mgr
Accountable (A): Software Asset Manager
Duration: Per SaaS + annual</bpmn:documentation>
        <bpmn:incoming>W3243_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3243_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3243_Task8" name="Procurement/Legal manage SaaS contracts: negotiate terms, consolidate buying…">
        <bpmn:documentation>Step 3: Procurement/Legal manage SaaS contracts: negotiate terms, consolidate buying, manage renewals (W3245), enforce off-boarding (deprovision users, data export/deletion at exit per VS-91); report SaaS spend and rationalization to finance
Responsible (R): Procurement / Legal / Finance
Accountable (A): Software Asset Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3243_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3243_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3243_End9" name="Complete">
        <bpmn:incoming>W3243_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3243_Annotation10">
        <bpmn:text>Controls: - CTL-527 (ensure controlled execution — Software Asset Management &amp; License Compliance (PA-99.2).) | - operational: discovery and approval gate; operational: portfolio rationalization
Owner: Software Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3243_Assoc11" sourceRef="W3243_Annotation10" targetRef="W3243_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3243_Flow12" sourceRef="W3243_Start5" targetRef="W3243_Task6" />
      <bpmn:sequenceFlow id="W3243_Flow13" sourceRef="W3243_Task6" targetRef="W3243_Task7" />
      <bpmn:sequenceFlow id="W3243_Flow14" sourceRef="W3243_Task7" targetRef="W3243_Task8" />
      <bpmn:sequenceFlow id="W3243_Flow15" sourceRef="W3243_Task8" targetRef="W3243_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3243_diag">
      <bpmndi:BPMNPlane id="W3243_plane" bpmnElement="W_W3243">
        <bpmndi:BPMNShape id="W3243_Lane1_di" bpmnElement="W3243_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_Lane2_di" bpmnElement="W3243_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_Lane3_di" bpmnElement="W3243_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_Task6_di" bpmnElement="W3243_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
