    <bpmn:process id="W_W3246" name="W3246. Software Compliance Audit Response &amp; Defense" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor audit notice (e.g., publisher compliance review); self-identified non-compliance
Frequency: Event-driven
Volume: ~1–3 audits/year (publisher-initiated or self-driven)
Owner: Software Asset Manager
Participants: Software Asset Mgr, Legal, IT Ops (links to VS-27), Procurement, Finance, External Counsel
Source: workflow W3246 — Software Compliance Audit Response &amp; Defense</bpmn:documentation>
      <bpmn:laneSet id="W3246_LaneSet3">
        <bpmn:lane id="W3246_Lane1" name="Software Asset Mgr">
        <bpmn:flowNodeRef>W3246_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3246_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3246_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3246_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3246_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3246_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3246_Start4" name="Vendor audit notice (e.g., publisher compliance review); self-identified non-compliance">
        <bpmn:outgoing>W3246_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3246_Task5" name="Software Asset Mgr/Legal scope the audit: review audit notice and contract…">
        <bpmn:documentation>Step 1: Software Asset Mgr/Legal scope the audit: review audit notice and contract audit clause, define scope/period/method, engage legal/external counsel (privilege), prepare data room (installations, entitlements, contracts) per W3241; assess exposure (under-licensing, back-maintenance, penalties)
Responsible (R): Software Asset Mgr / Legal
Accountable (A): VP Legal &amp; Compliance
Duration: 1–3 weeks</bpmn:documentation>
        <bpmn:incoming>W3246_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3246_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3246_Task6" name="Conduct internal assessment and remediate: reconcile installations vs…">
        <bpmn:documentation>Step 2: Conduct internal assessment and remediate: reconcile installations vs entitlements, purchase missing licenses (true-up at negotiated rate rather than audit penalty), uninstall unauthorized software (W3242), document compliance position; negotiate with publisher
Responsible (R): Software Asset Mgr / Procurement / Legal
Accountable (A): Software Asset Manager
Duration: 4–12 weeks</bpmn:documentation>
        <bpmn:incoming>W3246_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3246_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3246_Task7" name="Resolve: settle/true-up, sign release/compliance agreement, implement controls…">
        <bpmn:documentation>Step 3: Resolve: settle/true-up, sign release/compliance agreement, implement controls to prevent recurrence (W3241/W3242), recover/reserve cost (links to VS-100 W3277 if disputed), capture lessons to risk register (links to VS-21.2)
Responsible (R): Legal / Software Asset Mgr / Finance
Accountable (A): VP Legal &amp; Compliance
Duration: At close</bpmn:documentation>
        <bpmn:incoming>W3246_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3246_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3246_End8" name="Complete">
        <bpmn:incoming>W3246_Flow14</bpmn:incoming>
      </bpmn:endEvent>
