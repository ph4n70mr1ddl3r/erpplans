        <bpmndi:BPMNEdge id="W3241_Flow11_di" bpmnElement="W3241_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3241_Flow12_di" bpmnElement="W3241_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3241_Flow13_di" bpmnElement="W3241_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3241_Assoc9_di" bpmnElement="W3241_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3242" name="W3242. License Optimization, Reharvesting &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly optimization; renewal (W3245); cost-reduction initiative
Frequency: Quarterly + event-driven
Volume: Full estate
Owner: Software Asset Manager
Participants: Software Asset Mgr, IT Ops (links to VS-27), User Depts, Procurement, Finance
Source: workflow W3242 — License Optimization, Reharvesting &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W3242_LaneSet2">
        <bpmn:lane id="W3242_Lane1" name="Software Asset Mgr">
        <bpmn:flowNodeRef>W3242_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3242_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3242_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3242_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3242_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3242_Start3" name="Quarterly optimization; renewal (W3245); cost-reduction initiative">
        <bpmn:outgoing>W3242_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3242_Task4" name="Software Asset Mgr analyze usage vs entitlement: identify unused/under-used…">
        <bpmn:documentation>Step 1: Software Asset Mgr analyze usage vs entitlement: identify unused/under-used licenses (installed-not-used, inactive users), over-deployed products (installation &gt; entitlement — compliance risk W3246), and right-sizing opportunities (edition down-grade, metric change)
Responsible (R): Software Asset Mgr / IT Ops
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3242_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3242_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3242_Task5" name="Reharvest and reallocate: reclaim licenses from inactive/departed users…">
        <bpmn:documentation>Step 2: Reharvest and reallocate: reclaim licenses from inactive/departed users (coordinate HR per VS-19.5), reassign to new users instead of new purchase, uninstall unauthorized/redundant software, consolidate overlapping tools; reduce true-up liability
Responsible (R): Software Asset Mgr / IT Ops / User Depts
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3242_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3242_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3242_Task6" name="Optimize licensing model: convert perpetual-to-subscription (or vice-versa)…">
        <bpmn:documentation>Step 3: Optimize licensing model: convert perpetual-to-subscription (or vice-versa) where economic, negotiate enterprise agreements (W3245), adopt concurrent/use-based metrics, standardize on fewer products; track savings vs target
Responsible (R): Software Asset Mgr / Procurement / Finance
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3242_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3242_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3242_End7" name="Complete">
        <bpmn:incoming>W3242_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3242_Annotation8">
        <bpmn:text>Controls: - CTL-143 (ensure IT asset &amp; license entitlement integrity.) | - operational: usage analytics and reharvesting; operational: reconciliation and remediation
Owner: Software Asset Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3242_Assoc9" sourceRef="W3242_Annotation8" targetRef="W3242_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3242_Flow10" sourceRef="W3242_Start3" targetRef="W3242_Task4" />
      <bpmn:sequenceFlow id="W3242_Flow11" sourceRef="W3242_Task4" targetRef="W3242_Task5" />
      <bpmn:sequenceFlow id="W3242_Flow12" sourceRef="W3242_Task5" targetRef="W3242_Task6" />
      <bpmn:sequenceFlow id="W3242_Flow13" sourceRef="W3242_Task6" targetRef="W3242_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3242_diag">
      <bpmndi:BPMNPlane id="W3242_plane" bpmnElement="W_W3242">
        <bpmndi:BPMNShape id="W3242_Lane1_di" bpmnElement="W3242_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
