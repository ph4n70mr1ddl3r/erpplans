        <bpmndi:BPMNShape id="W3243_Task8_di" bpmnElement="W3243_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_Start5_di" bpmnElement="W3243_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_End9_di" bpmnElement="W3243_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3243_Annotation10_di" bpmnElement="W3243_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3243_Flow12_di" bpmnElement="W3243_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3243_Flow13_di" bpmnElement="W3243_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3243_Flow14_di" bpmnElement="W3243_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3243_Flow15_di" bpmnElement="W3243_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3243_Assoc11_di" bpmnElement="W3243_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3244" name="W3244. Cloud Spend (FinOps) &amp; Usage Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cloud billing; budget variance; optimization cycle
Frequency: Monthly + quarterly
Volume: Cloud (IaaS/PaaS) consumption across ERP/digital workloads
Owner: Cloud Cost Manager
Participants: Cloud Cost Mgr, IT Ops (links to VS-27/VS-30), Finance (links to VS-18/VS-17), Architecture
Source: workflow W3244 — Cloud Spend (FinOps) &amp; Usage Optimization</bpmn:documentation>
      <bpmn:laneSet id="W3244_LaneSet2">
        <bpmn:lane id="W3244_Lane1" name="Cloud Cost Mgr">
        <bpmn:flowNodeRef>W3244_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3244_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3244_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3244_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3244_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3244_Start3" name="Monthly cloud billing; budget variance; optimization cycle">
        <bpmn:outgoing>W3244_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3244_Task4" name="Cloud Cost Mgr/Finance allocate and tag cloud spend: implement cost-allocation…">
        <bpmn:documentation>Step 1: Cloud Cost Mgr/Finance allocate and tag cloud spend: implement cost-allocation tagging (by workload/entity/env), map to cost centers and entities (5 entities per VS-72), monitor monthly billing vs budget (links to VS-18.1/VS-17.4); detect anomalies (spikes, idle resources)
Responsible (R): Cloud Cost Mgr / Finance
Accountable (A): Software Asset Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3244_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3244_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3244_Task5" name="Optimize usage: right-size compute/storage, reserve instances/savings…">
        <bpmn:documentation>Step 2: Optimize usage: right-size compute/storage, reserve instances/savings plans/committed-use discounts, auto-scale and schedule non-prod, terminate orphan resources (unattached volumes, idle LBs), optimize data-egress (cross-AZ/region), archival tiering
Responsible (R): Cloud Cost Mgr / IT Ops / Architecture
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3244_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3244_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3244_Task6" name="Forecast and budget cloud spend (W3248); establish FinOps practice (visibility…">
        <bpmn:documentation>Step 3: Forecast and budget cloud spend (W3248); establish FinOps practice (visibility, optimization, governance), showback/chargeback to consuming entities (links to VS-72), report savings and unit-cost metrics (cost per transaction, per store)
Responsible (R): Cloud Cost Mgr / Finance
Accountable (A): Software Asset Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3244_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3244_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3244_End7" name="Complete">
        <bpmn:incoming>W3244_Flow13</bpmn:incoming>
      </bpmn:endEvent>
