        <bpmndi:BPMNShape id="W3642_Start3_di" bpmnElement="W3642_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3642_End7_di" bpmnElement="W3642_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3642_Annotation8_di" bpmnElement="W3642_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3642_Flow10_di" bpmnElement="W3642_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3642_Flow11_di" bpmnElement="W3642_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3642_Flow12_di" bpmnElement="W3642_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3642_Flow13_di" bpmnElement="W3642_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3642_Assoc9_di" bpmnElement="W3642_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3643" name="W3643. Surety Provider &amp; Bank Guarantee Relationship Management" isExecutable="false">
      <bpmn:documentation>Trigger: Provider sourcing (W3642); performance review; renewal
Frequency: Per provider + ongoing
Volume: Surety companies and guarantee-issuing banks
Owner: Surety Program Manager / Treasury
Participants: Surety Program Manager, Treasury (links to VS-18), Procurement (links to VS-34), Legal (links to VS-100.3), Finance (links to VS-17), Vendor Mgmt (links to VS-03), Risk (links to VS-21.2)
Source: workflow W3643 — Surety Provider &amp; Bank Guarantee Relationship Management</bpmn:documentation>
      <bpmn:laneSet id="W3643_LaneSet2">
        <bpmn:lane id="W3643_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3643_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3643_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3643_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3643_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3643_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3643_Start3" name="Provider sourcing (W3642); performance review; renewal">
        <bpmn:outgoing>W3643_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3643_Task4" name="Surety Program Manager/Treasury/Procurement qualify and select surety providers…">
        <bpmn:documentation>Step 1: Surety Program Manager/Treasury/Procurement qualify and select surety providers and guarantee banks: IC-licensed surety companies with the relevant bond classes and capacity, and BuildRight&#x27;s relationship banks (BDO/BPI/Metrobank/Chinabank per profile §10.4) for guarantees; due diligence on financial strength, claim handling, turnaround, and coverage
Responsible (R): Surety Program Manager / Treasury / Procurement
Accountable (A): CFO
Duration: Per provider</bpmn:documentation>
        <bpmn:incoming>W3643_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3643_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3643_Task5" name="Surety Program Manager/Treasury manage the provider relationship and contracts…">
        <bpmn:documentation>Step 2: Surety Program Manager/Treasury manage the provider relationship and contracts: master agreements, pricing (W3645), turnaround SLAs, claim protocol (W3658), and the approved-provider list; diversify providers to avoid concentration and ensure competition
Responsible (R): Surety Program Manager / Treasury / Legal
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3643_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3643_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3643_Task6" name="Surety Program Manager monitor provider performance: turnaround, pricing, claim…">
        <bpmn:documentation>Step 3: Surety Program Manager monitor provider performance: turnaround, pricing, claim handling, capacity utilization, and financial health; re-qualify periodically, manage the approved list, and feed to the scorecard (links to VS-67) and governance (W3662); manage provider exit/replacement
Responsible (R): Surety Program Manager / Treasury
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W3643_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3643_End7" name="Complete">
        <bpmn:incoming>W3643_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3643_Annotation8">
        <bpmn:text>Controls: - CTL-577 (ensure controlled execution — Surety Facility Strategy, Provider Management &amp; Program Governance (PA-116.1).) | - operational: diversification; operational: financial-strength due diligence
Owner: Surety Program Manager / Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3643_Assoc9" sourceRef="W3643_Annotation8" targetRef="W3643_Start3" associationDirection="None" />
