      <bpmn:sequenceFlow id="W3643_Flow11" sourceRef="W3643_Task4" targetRef="W3643_Task5" />
      <bpmn:sequenceFlow id="W3643_Flow12" sourceRef="W3643_Task5" targetRef="W3643_Task6" />
      <bpmn:sequenceFlow id="W3643_Flow13" sourceRef="W3643_Task6" targetRef="W3643_End7" />
    </bpmn:process>
