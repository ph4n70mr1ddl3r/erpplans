      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3642" name="W3642. Surety Facility, Line &amp; Counter-Indemnity Management" isExecutable="false">
      <bpmn:documentation>Trigger: Facility strategy (W3641); capacity need; renewal
Frequency: Annual + on need
Volume: Surety facility / line across providers
Owner: Treasury / Surety Program Manager
Participants: Treasury (links to VS-18), Surety Program Manager, Finance (links to VS-17), Legal (links to VS-100.3), Surety Companies/Banks, Risk (links to VS-21.2), IC/BSP regulators
Source: workflow W3642 — Surety Facility, Line &amp; Counter-Indemnity Management</bpmn:documentation>
      <bpmn:laneSet id="W3642_LaneSet2">
        <bpmn:lane id="W3642_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W3642_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3642_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3642_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3642_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3642_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3642_Start3" name="Facility strategy (W3641); capacity need; renewal">
        <bpmn:outgoing>W3642_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3642_Task4" name="Treasury/Surety Program Manager arrange the surety facility/line: aggregate…">
        <bpmn:documentation>Step 1: Treasury/Surety Program Manager arrange the surety facility/line: aggregate surety capacity across surety companies (IC-regulated) and bank-guarantee lines (BSP-regulated, links to VS-18.2), sized to BuildRight&#x27;s projected B2G/B2B pipeline, multi-year, and renewable; negotiate terms, limit, sub-limits by bond type/contract size, and the counter-indemnity/collateral requirements
Responsible (R): Treasury / Surety Program Manager
Accountable (A): CFO
Duration: Annual + on need</bpmn:documentation>
        <bpmn:incoming>W3642_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3642_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3642_Task5" name="Treasury/Legal negotiate the General Agreement of Indemnity (GAI) /…">
        <bpmn:documentation>Step 2: Treasury/Legal negotiate the General Agreement of Indemnity (GAI) / counter-indemnity with surety providers (BuildRight indemnifies the surety for any bond paid), and the bank-guarantee facility agreement (including cash-margin/collateral terms); manage the corporate authorization, board resolution (links to VS-36), and entity-level signatories for the 5 entities
Responsible (R): Treasury / Legal / Surety/Bank
Accountable (A): CFO / CEO
Duration: Per facility</bpmn:documentation>
        <bpmn:incoming>W3642_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3642_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3642_Task6" name="Treasury/Surety Program Manager manage the facility lifecycle: utilization…">
        <bpmn:documentation>Step 3: Treasury/Surety Program Manager manage the facility lifecycle: utilization tracking (W3654), renewal/extension, limit optimization (W3645), and provider diversification; report facility health, utilization, and capacity to governance (W3661) and treasury/cash planning (links to VS-18.1)
Responsible (R): Treasury / Surety Program Manager
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3642_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3642_End7" name="Complete">
        <bpmn:incoming>W3642_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3642_Annotation8">
        <bpmn:text>Controls: - CTL-577 (ensure controlled execution — Surety Facility Strategy, Provider Management &amp; Program Governance (PA-116.1).) | - operational: pipeline-based sizing; operational: risk assessment and collateral strategy (W3644)
Owner: Treasury / Surety Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3642_Assoc9" sourceRef="W3642_Annotation8" targetRef="W3642_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3642_Flow10" sourceRef="W3642_Start3" targetRef="W3642_Task4" />
      <bpmn:sequenceFlow id="W3642_Flow11" sourceRef="W3642_Task4" targetRef="W3642_Task5" />
      <bpmn:sequenceFlow id="W3642_Flow12" sourceRef="W3642_Task5" targetRef="W3642_Task6" />
      <bpmn:sequenceFlow id="W3642_Flow13" sourceRef="W3642_Task6" targetRef="W3642_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3642_diag">
      <bpmndi:BPMNPlane id="W3642_plane" bpmnElement="W_W3642">
        <bpmndi:BPMNShape id="W3642_Lane1_di" bpmnElement="W3642_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
