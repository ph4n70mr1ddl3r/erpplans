        <bpmndi:BPMNShape id="W3643_Task5_di" bpmnElement="W3643_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3643_Task6_di" bpmnElement="W3643_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3643_Start3_di" bpmnElement="W3643_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3643_End7_di" bpmnElement="W3643_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3643_Annotation8_di" bpmnElement="W3643_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3643_Flow10_di" bpmnElement="W3643_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3643_Flow11_di" bpmnElement="W3643_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3643_Flow12_di" bpmnElement="W3643_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3643_Flow13_di" bpmnElement="W3643_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3643_Assoc9_di" bpmnElement="W3643_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3644" name="W3644. Indemnity Agreement, Collateral &amp; Security Management" isExecutable="false">
      <bpmn:documentation>Trigger: Facility/bond issuance (W3642/W3650); collateral requirement; release
Frequency: Per instrument + ongoing
Volume: Counter-indemnity, collateral, and security positions
Owner: Treasury / Legal
Participants: Treasury (links to VS-18), Legal (links to VS-100.3), Surety Program Manager, Finance (links to VS-17), Risk (links to VS-21.2), Corporate Secretary (links to VS-36)
Source: workflow W3644 — Indemnity Agreement, Collateral &amp; Security Management</bpmn:documentation>
      <bpmn:laneSet id="W3644_LaneSet2">
        <bpmn:lane id="W3644_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W3644_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3644_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3644_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3644_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3644_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3644_Start3" name="Facility/bond issuance (W3642/W3650); collateral requirement; release">
        <bpmn:outgoing>W3644_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3644_Task4" name="Treasury/Legal maintain the counter-indemnity framework: the GAI / corporate…">
        <bpmn:documentation>Step 1: Treasury/Legal maintain the counter-indemnity framework: the GAI / corporate indemnity to sureties, the entity-level indemnity for the 5 entities, the collateral/security pledged (cash margin, time deposits, letters of credit, assets), and the corporate authorizations/board resolutions (links to VS-36); manage the legal documentation
Responsible (R): Treasury / Legal / Corporate Secretary
Accountable (A): CFO / CEO
Duration: Per facility/instrument</bpmn:documentation>
        <bpmn:incoming>W3644_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3644_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3644_Task5" name="Treasury/Finance manage collateral and security: cash margin/collateral held by…">
        <bpmn:documentation>Step 2: Treasury/Finance manage collateral and security: cash margin/collateral held by the bank/surety (encumbering cash links to VS-18.1), time-deposit/asset pledges, and the accounting treatment (restricted cash, contingent liability disclosure links to VS-17); track collateral per bond/facility
Responsible (R): Treasury / Finance
Accountable (A): CFO
Duration: Per instrument + ongoing</bpmn:documentation>
        <bpmn:incoming>W3644_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3644_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3644_Task6" name="Treasury/Legal manage collateral release on bond release (links to W3657)…">
        <bpmn:documentation>Step 3: Treasury/Legal manage collateral release on bond release (links to W3657), substitution of collateral, and dispute over collateral (links to VS-100); report indemnity/collateral exposure to governance (W3661) and risk (links to VS-21.2)
Responsible (R): Treasury / Legal
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3644_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3644_End7" name="Complete">
        <bpmn:incoming>W3644_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3644_Annotation8">
        <bpmn:text>Controls: - CTL-577 (ensure controlled execution — Surety Facility Strategy, Provider Management &amp; Program Governance (PA-116.1).) | - operational: collateral optimization (W3645); operational: contract-risk assessment and project delivery
Owner: Treasury / Legal</bpmn:text>
      </bpmn:textAnnotation>
