    <bpmn:process id="W_W3658" name="W3658. Bond Claim, Demand &amp; Default Response Management" isExecutable="false">
      <bpmn:documentation>Trigger: Bond call/demand by beneficiary; alleged default; performance dispute
Frequency: Rare but high-impact
Volume: Bond claims/demands
Owner: Surety Program Manager / Legal / CFO
Participants: Surety Program Manager, Legal (links to VS-100), CFO/CEO, Treasury (links to VS-18), PMO (links to VS-112), B2G/B2B Sales (links to VS-46/VS-11), Surety/Bank, Risk (links to VS-21.2), Insurance (links to VS-26), Communications (links to VS-14.3)
Source: workflow W3658 — Bond Claim, Demand &amp; Default Response Management</bpmn:documentation>
      <bpmn:laneSet id="W3658_LaneSet3">
        <bpmn:lane id="W3658_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3658_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3658_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3658_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3658_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3658_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3658_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3658_Start4" name="Bond call/demand by beneficiary; alleged default; performance dispute">
        <bpmn:outgoing>W3658_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3658_Task5" name="Surety Program Manager/Legal receive and triage the bond call/demand: the…">
        <bpmn:documentation>Step 1: Surety Program Manager/Legal receive and triage the bond call/demand: the beneficiary&#x27;s demand, the alleged default/breach, the bond/contract basis, the demand validity (compliance with bond terms), and the amount; immediate notification to CFO/CEO and the surety/bank; assess exposure
Responsible (R): Surety Program Manager / Legal / CFO
Accountable (A): CEO
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W3658_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3658_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3658_Task6" name="Legal/Surety Program Manager respond to the demand: where the demand is…">
        <bpmn:documentation>Step 2: Legal/Surety Program Manager respond to the demand: where the demand is wrongful/invalid, contest it (injunction, legal notice); where valid, manage the resolution (cure the default, negotiate settlement, or accept the bond payment); engage the surety/bank on their obligations and coordinate the counter-indemnity (W3659)
Responsible (R): Legal / Surety Program Manager / Surety/Bank
Accountable (A): CEO / Board
Duration: Claim life</bpmn:documentation>
        <bpmn:incoming>W3658_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3658_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3658_Task7" name="Surety Program Manager/Legal manage the aftermath: bond payment and…">
        <bpmn:documentation>Step 3: Surety Program Manager/Legal manage the aftermath: bond payment and recovery/subrogation (W3659), dispute/litigation (W3660), insurance/recovery (links to VS-26), regulatory notification (government-beneficiary cases links to VS-22), communications (links to VS-14.3), and capture the claim record/lessons (W3648/W3661); report to the board (links to VS-36)
Responsible (R): Surety Program Manager / Legal / CFO
Accountable (A): CEO
Duration: Post-claim</bpmn:documentation>
        <bpmn:incoming>W3658_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3658_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3658_End8" name="Complete">
        <bpmn:incoming>W3658_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3658_Annotation9">
        <bpmn:text>Controls: - CTL-579 (ensure controlled execution — Bond Release, Claims, Recovery &amp; Surety Analytics (PA-116.3).) | - operational: contest/legal response; operational: delivery and early dispute resolution
Owner: Surety Program Manager / Legal / CFO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3658_Assoc10" sourceRef="W3658_Annotation9" targetRef="W3658_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3658_Flow11" sourceRef="W3658_Start4" targetRef="W3658_Task5" />
      <bpmn:sequenceFlow id="W3658_Flow12" sourceRef="W3658_Task5" targetRef="W3658_Task6" />
      <bpmn:sequenceFlow id="W3658_Flow13" sourceRef="W3658_Task6" targetRef="W3658_Task7" />
      <bpmn:sequenceFlow id="W3658_Flow14" sourceRef="W3658_Task7" targetRef="W3658_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3658_diag">
      <bpmndi:BPMNPlane id="W3658_plane" bpmnElement="W_W3658">
        <bpmndi:BPMNShape id="W3658_Lane1_di" bpmnElement="W3658_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3658_Lane2_di" bpmnElement="W3658_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
