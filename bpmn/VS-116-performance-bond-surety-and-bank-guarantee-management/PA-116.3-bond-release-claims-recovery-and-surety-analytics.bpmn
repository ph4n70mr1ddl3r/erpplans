      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3660" name="W3660. Bond Dispute, Litigation &amp; Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Bond dispute (wrongful call, default allegation, release obstruction); unresolved claim
Frequency: Per dispute
Volume: Bond-related disputes
Owner: Legal / Surety Program Manager
Participants: Legal (links to VS-100), Surety Program Manager, CFO/CEO, Treasury (links to VS-18), PMO (links to VS-112), Outside Counsel, Risk (links to VS-21.2), Insurance (links to VS-26)
Source: workflow W3660 — Bond Dispute, Litigation &amp; Resolution</bpmn:documentation>
      <bpmn:laneSet id="W3660_LaneSet2">
        <bpmn:lane id="W3660_Lane1" name="Legal">
        <bpmn:flowNodeRef>W3660_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3660_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3660_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3660_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3660_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3660_Start3" name="Bond dispute (wrongful call, default allegation, release obstruction); unresolved claim">
        <bpmn:outgoing>W3660_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3660_Task4" name="Legal/Surety Program Manager assess the dispute: the bond/contract/legal basis…">
        <bpmn:documentation>Step 1: Legal/Surety Program Manager assess the dispute: the bond/contract/legal basis, BuildRight&#x27;s position, evidence (delivery/performance/compliance), the counter-party&#x27;s position, and the remedies (negotiation, mediation, arbitration, litigation); assess loss contingency (links to VS-17/VS-100)
Responsible (R): Legal / Surety Program Manager / Outside Counsel
Accountable (A): CFO / CEO
Duration: Per dispute</bpmn:documentation>
        <bpmn:incoming>W3660_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3660_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3660_Task5" name="Legal manage the dispute resolution: negotiation/mediation first, arbitration…">
        <bpmn:documentation>Step 2: Legal manage the dispute resolution: negotiation/mediation first, arbitration (common in B2B/construction) or litigation (Regional Trial Court / Court of Appeals / Supreme Court, or government-administrative bodies for B2G), injunction against wrongful bond call, and outside-counsel engagement (links to VS-100.3)
Responsible (R): Legal / Outside Counsel
Accountable (A): CEO / Board
Duration: Dispute life</bpmn:documentation>
        <bpmn:incoming>W3660_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3660_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3660_Task6" name="Legal/Surety Program Manager manage the outcome and settlement, account for the…">
        <bpmn:documentation>Step 3: Legal/Surety Program Manager manage the outcome and settlement, account for the loss/recovery (links to VS-17), capture lessons (W3648/W3661), and feed prevention to contract-risk/underwriting (W3646) and contract terms (links to VS-46/VS-11); report material disputes to the board (links to VS-36)
Responsible (R): Legal / Surety Program Manager / Finance
Accountable (A): CEO
Duration: Post-dispute</bpmn:documentation>
        <bpmn:incoming>W3660_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3660_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3660_End7" name="Complete">
        <bpmn:incoming>W3660_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3660_Annotation8">
        <bpmn:text>Controls: - CTL-579 (ensure controlled execution — Bond Release, Claims, Recovery &amp; Surety Analytics (PA-116.3).) | - operational: ADR and early resolution; operational: loss-contingency accounting and risk transfer
Owner: Legal / Surety Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3660_Assoc9" sourceRef="W3660_Annotation8" targetRef="W3660_Start3" associationDirection="None" />
