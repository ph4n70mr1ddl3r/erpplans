      <bpmn:sequenceFlow id="W3659_Flow14" sourceRef="W3659_Task7" targetRef="W3659_Task8" />
      <bpmn:sequenceFlow id="W3659_Flow15" sourceRef="W3659_Task8" targetRef="W3659_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3659_diag">
      <bpmndi:BPMNPlane id="W3659_plane" bpmnElement="W_W3659">
        <bpmndi:BPMNShape id="W3659_Lane1_di" bpmnElement="W3659_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3659_Lane2_di" bpmnElement="W3659_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
