        <bpmndi:BPMNEdge id="W3658_Flow12_di" bpmnElement="W3658_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3658_Flow13_di" bpmnElement="W3658_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3658_Flow14_di" bpmnElement="W3658_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3658_Assoc10_di" bpmnElement="W3658_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3659" name="W3659. Counter-Indemnity Call, Recovery &amp; Subrogation" isExecutable="false">
      <bpmn:documentation>Trigger: Surety/bank pays a bond claim and calls BuildRight&#x27;s counter-indemnity (W3658)
Frequency: Rare
Volume: Counter-indemnity calls and recovery actions
Owner: Surety Program Manager / Legal / Treasury
Participants: Surety Program Manager, Legal (links to VS-100), Treasury (links to VS-18), Finance (links to VS-17), Surety/Bank, PMO (links to VS-112), Insurance (links to VS-26), Risk (links to VS-21.2)
Source: workflow W3659 — Counter-Indemnity Call, Recovery &amp; Subrogation</bpmn:documentation>
      <bpmn:laneSet id="W3659_LaneSet4">
        <bpmn:lane id="W3659_Lane1" name="Surety Program Manager">
        <bpmn:flowNodeRef>W3659_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3659_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3659_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W3659_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3659_Lane3" name="Legal">
        <bpmn:flowNodeRef>W3659_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3659_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3659_Start5" name="Surety/bank pays a bond claim and calls BuildRight&#x27;s counter-indemnity (W3658)">
        <bpmn:outgoing>W3659_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3659_Task6" name="Surety Program Manager/Treasury/Legal manage the counter-indemnity call: the…">
        <bpmn:documentation>Step 1: Surety Program Manager/Treasury/Legal manage the counter-indemnity call: the surety/bank&#x27;s demand for indemnity after paying the bond, the indemnity amount (bond paid + surety costs/fees), and BuildRight&#x27;s obligation under the GAI (W3644); assess the validity and amount
Responsible (R): Surety Program Manager / Legal / Treasury
Accountable (A): CFO / CEO
Duration: Per call</bpmn:documentation>
        <bpmn:incoming>W3659_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3659_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3659_Task7" name="Treasury/Finance settle the indemnity obligation (cash/collateral call W3644…">
        <bpmn:documentation>Step 2: Treasury/Finance settle the indemnity obligation (cash/collateral call W3644, credit draw), account for the loss/recoverable (links to VS-17), and pursue recovery/subrogation: recover from the responsible party (subcontractor/defaulting JV partner), insurer (professional indemnity/contractor insurance links to VS-26), or via contract remedies
Responsible (R): Treasury / Finance / Legal
Accountable (A): CFO
Duration: Per call</bpmn:documentation>
        <bpmn:incoming>W3659_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3659_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3659_Task8" name="Legal/Surety Program Manager manage subrogation and recovery actions (links to…">
        <bpmn:documentation>Step 3: Legal/Surety Program Manager manage subrogation and recovery actions (links to VS-100 litigation), track recovery vs. loss, and feed lessons to underwriting/contract-risk (W3646) and provider management (W3643); report indemnity-call exposure to governance (W3661) and the board (links to VS-36)
Responsible (R): Legal / Surety Program Manager
Accountable (A): CFO / CEO
Duration: Post-call</bpmn:documentation>
        <bpmn:incoming>W3659_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3659_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3659_End9" name="Complete">
        <bpmn:incoming>W3659_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3659_Annotation10">
        <bpmn:text>Controls: - CTL-579 (ensure controlled execution — Bond Release, Claims, Recovery &amp; Surety Analytics (PA-116.3).) | - operational: recovery/subrogation and upstream risk transfer; operational: upstream security/insurance
Owner: Surety Program Manager / Legal / Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3659_Assoc11" sourceRef="W3659_Annotation10" targetRef="W3659_Start5" associationDirection="None" />
