    <bpmn:process id="W_W2737" name="W2737. Green Product Lifecycle Assessment Data Management" isExecutable="false">
      <bpmn:documentation>Trigger: Product introduction or annual review
Frequency: Per product; annual batch
Volume: ~2,000–3,000 green products
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Category Manager, Vendors
Source: workflow W2737 — Green Product Lifecycle Assessment Data Management</bpmn:documentation>
      <bpmn:laneSet id="W2737_LaneSet2">
        <bpmn:lane id="W2737_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2737_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2737_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2737_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2737_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2737_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2737_Start3" name="Product introduction or annual review">
        <bpmn:outgoing>W2737_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2737_Task4" name="Sustainability Coordinator collects LCA data: raw material sourcing…">
        <bpmn:documentation>Step 1: Sustainability Coordinator collects LCA data: raw material sourcing, manufacturing energy, transportation carbon, durability, end-of-life recyclability; stores in sustainability database
Responsible (R): Sustainability Coordinator / Vendors
Accountable (A): COO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2737_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2737_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2737_Task5" name="Coordinator validates: cross-checks claims, identifies gaps, works with vendors…">
        <bpmn:documentation>Step 2: Coordinator validates: cross-checks claims, identifies gaps, works with vendors to improve; for key categories engages third-party LCA firm for independent verification
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2737_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2737_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2737_Task6" name="Coordinator uses for product selection: identifies best lifecycle performance…">
        <bpmn:documentation>Step 3: Coordinator uses for product selection: identifies best lifecycle performance, replaces lower-performing, provides LCA to customers; contributes to Scope 3 emissions accounting
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2737_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2737_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2737_End7" name="Complete">
        <bpmn:incoming>W2737_Flow13</bpmn:incoming>
      </bpmn:endEvent>
