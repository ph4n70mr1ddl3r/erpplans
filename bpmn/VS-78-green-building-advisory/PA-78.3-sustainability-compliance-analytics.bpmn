    <bpmn:process id="W_W2741" name="W2741. Annual Green Building Strategy Review &amp; Program Update" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy cycle
Frequency: Annual
Volume: BuildRight green building program
Owner: VP Merchandising
Participants: VP Merchandising, Sustainability Coordinator, Category Managers, CFO, CMO
Source: workflow W2741 — Annual Green Building Strategy Review &amp; Program Update</bpmn:documentation>
      <bpmn:laneSet id="W2741_LaneSet3">
        <bpmn:lane id="W2741_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W2741_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2741_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2741_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2741_Lane2" name="All VPs">
        <bpmn:flowNodeRef>W2741_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2741_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2741_Start4" name="Annual strategy cycle">
        <bpmn:outgoing>W2741_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2741_Task5" name="VP Merchandising prepares review: green sales trend (3-year), market growth…">
        <bpmn:documentation>Step 1: VP Merchandising prepares review: green sales trend (3-year), market growth, competitive position, demand evolution, regulatory landscape, vendor progress, program ROI, emerging opportunities
Responsible (R): VP Merchandising / Sustainability Coordinator
Accountable (A): CEO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2741_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2741_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2741_Task6" name="Cross-functional session: set targets (green revenue %, product count, project…">
        <bpmn:documentation>Step 2: Cross-functional session: set targets (green revenue %, product count, project pipeline), approve investments (new products, training, in-store, digital), define market focus
Responsible (R): All VPs
Accountable (A): CEO
Duration: Half day</bpmn:documentation>
        <bpmn:incoming>W2741_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2741_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2741_Task7" name="VP Merchandising develops roadmap: quarterly milestones, category launch…">
        <bpmn:documentation>Step 3: VP Merchandising develops roadmap: quarterly milestones, category launch calendar, store rollout, digital upgrade, marketing calendar; presents to CEO; incorporates into annual plan
Responsible (R): VP Merchandising
Accountable (A): CEO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W2741_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2741_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2741_End8" name="Complete">
        <bpmn:incoming>W2741_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2741_Annotation9">
        <bpmn:text>Controls: - CTL-465 (ensure controlled execution — Sustainability Compliance &amp; Analytics (PA-78.3).) | - operational: VP Merchandising sign-off on the workflow output
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
