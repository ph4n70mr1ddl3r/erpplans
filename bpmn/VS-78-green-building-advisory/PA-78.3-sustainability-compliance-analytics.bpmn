    <bpmn:process id="W_W2735" name="W2735. Environmental Impact Quantification of Green Product Sales" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly ESG reporting
Frequency: Quarterly
Volume: All green product sales
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Category Manager, FP&amp;A
Source: workflow W2735 — Environmental Impact Quantification of Green Product Sales</bpmn:documentation>
      <bpmn:laneSet id="W2735_LaneSet2">
        <bpmn:lane id="W2735_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2735_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2735_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2735_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2735_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2735_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2735_Start3" name="Quarterly ESG reporting">
        <bpmn:outgoing>W2735_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2735_Task4" name="Sustainability Coordinator calculates impact: energy savings (MWh, tons CO2)…">
        <bpmn:documentation>Step 1: Sustainability Coordinator calculates impact: energy savings (MWh, tons CO2), water savings (liters), trees preserved (FSC wood), VOC reduction, solar capacity installed (kW)
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2735_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2735_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2735_Task5" name="Coordinator validates: uses DOE baselines, water utility data, FSC records…">
        <bpmn:documentation>Step 2: Coordinator validates: uses DOE baselines, water utility data, FSC records, product specs; ensures defensible methodology; documents calculations
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W2735_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2735_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2735_Task6" name="Coordinator prepares summary for ESG report: total CO2 avoided, energy/water…">
        <bpmn:documentation>Step 3: Coordinator prepares summary for ESG report: total CO2 avoided, energy/water saved, trees preserved, renewable installed; compares prior year; includes in sustainability report
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2735_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2735_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2735_End7" name="Complete">
        <bpmn:incoming>W2735_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2735_Annotation8">
        <bpmn:text>Controls: - CTL-465 (ensure controlled execution — Sustainability Compliance &amp; Analytics (PA-78.3).) | - operational: Sustainability Coordinator sign-off on the workflow output
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2735_Assoc9" sourceRef="W2735_Annotation8" targetRef="W2735_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2735_Flow10" sourceRef="W2735_Start3" targetRef="W2735_Task4" />
      <bpmn:sequenceFlow id="W2735_Flow11" sourceRef="W2735_Task4" targetRef="W2735_Task5" />
      <bpmn:sequenceFlow id="W2735_Flow12" sourceRef="W2735_Task5" targetRef="W2735_Task6" />
      <bpmn:sequenceFlow id="W2735_Flow13" sourceRef="W2735_Task6" targetRef="W2735_End7" />
    </bpmn:process>
