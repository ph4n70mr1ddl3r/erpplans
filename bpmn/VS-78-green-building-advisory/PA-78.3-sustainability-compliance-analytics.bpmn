      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2736" name="W2736. Green Building Regulatory Compliance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Regulatory update or compliance review
Frequency: Continuous; quarterly review
Volume: Philippine Green Building Code, LGU ordinances
Owner: Legal Compliance Officer
Participants: Legal Compliance Officer, Sustainability Coordinator, VP Legal
Source: workflow W2736 — Green Building Regulatory Compliance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2736_LaneSet3">
        <bpmn:lane id="W2736_Lane1" name="Legal Compliance Officer">
        <bpmn:flowNodeRef>W2736_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2736_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2736_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2736_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2736_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2736_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2736_Start4" name="Regulatory update or compliance review">
        <bpmn:outgoing>W2736_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2736_Task5" name="Legal Compliance Officer monitors: Green Building Code updates, LGU green…">
        <bpmn:documentation>Step 1: Legal Compliance Officer monitors: Green Building Code updates, LGU green building ordinances (Metro Manila requiring BERDE for new buildings), DOE energy labels, DENR EIA requirements
Responsible (R): Legal Compliance Officer
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2736_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2736_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2736_Task6" name="Officer assesses impact: new requirements creating demand (mandatory energy…">
        <bpmn:documentation>Step 2: Officer assesses impact: new requirements creating demand (mandatory energy labels, water standards), compliance for own construction, customer advisory opportunities
Responsible (R): Legal Compliance Officer / Sustainability Coordinator
Accountable (A): VP Legal
Duration: Per regulatory change</bpmn:documentation>
        <bpmn:incoming>W2736_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2736_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2736_Task7" name="Sustainability Coordinator incorporates: accelerates green assortment for…">
        <bpmn:documentation>Step 3: Sustainability Coordinator incorporates: accelerates green assortment for compliance-driven demand, ensures certifications, trains staff; reports to VP Merchandising
Responsible (R): Sustainability Coordinator / Category Manager
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2736_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2736_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2736_End8" name="Complete">
        <bpmn:incoming>W2736_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2736_Annotation9">
        <bpmn:text>Controls: - CTL-205 (ensure green-product claim substantiation.) | - CTL-465 (compliance-monitoring — links to VS-22); Operational: Legal Compliance Officer sign-off on the workflow output
Owner: Legal Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2736_Assoc10" sourceRef="W2736_Annotation9" targetRef="W2736_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2736_Flow11" sourceRef="W2736_Start4" targetRef="W2736_Task5" />
      <bpmn:sequenceFlow id="W2736_Flow12" sourceRef="W2736_Task5" targetRef="W2736_Task6" />
      <bpmn:sequenceFlow id="W2736_Flow13" sourceRef="W2736_Task6" targetRef="W2736_Task7" />
      <bpmn:sequenceFlow id="W2736_Flow14" sourceRef="W2736_Task7" targetRef="W2736_End8" />
    </bpmn:process>
