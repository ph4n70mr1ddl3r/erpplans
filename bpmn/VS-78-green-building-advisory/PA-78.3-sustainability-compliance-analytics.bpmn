    <bpmn:process id="W_W2734" name="W2734. Green Product Sales Analytics &amp; Market Intelligence" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle — Green Product Sales
Frequency: Monthly
Volume: ~2,000–3,000 green products
Owner: BI Analyst
Participants: BI Analyst, Category Manager, FP&amp;A, Sustainability Coordinator
Source: workflow W2734 — Green Product Sales Analytics &amp; Market Intelligence</bpmn:documentation>
      <bpmn:laneSet id="W2734_LaneSet4">
        <bpmn:lane id="W2734_Lane1" name="BI Analyst">
        <bpmn:flowNodeRef>W2734_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2734_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2734_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2734_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2734_Lane3" name="FP&amp;A">
        <bpmn:flowNodeRef>W2734_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2734_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2734_Start5" name="Monthly reporting cycle — Green Product Sales">
        <bpmn:outgoing>W2734_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2734_Task6" name="BI Analyst produces analytics: revenue by green category (energy, water…">
        <bpmn:documentation>Step 1: BI Analyst produces analytics: revenue by green category (energy, water, materials, solar), growth vs. conventional, penetration by store, AOV, segment analysis
Responsible (R): BI Analyst
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2734_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2734_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2734_Task7" name="Category Manager analyzes trends: Philippine green building growth (15–20%…">
        <bpmn:documentation>Step 2: Category Manager analyzes trends: Philippine green building growth (15–20% CAGR), competitor offerings, regulatory drivers, consumer awareness
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2734_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2734_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2734_Task8" name="FP&amp;A forecasts: 3-year projection, market share targets, investment required…">
        <bpmn:documentation>Step 3: FP&amp;A forecasts: 3-year projection, market share targets, investment required, ROI; presents to CFO and CEO for strategic planning
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2734_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2734_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2734_End9" name="Complete">
        <bpmn:incoming>W2734_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2734_Annotation10">
        <bpmn:text>Controls: - CTL-465 (ensure controlled execution — Sustainability Compliance &amp; Analytics (PA-78.3).) | - operational: BI Analyst sign-off on the workflow output
Owner: BI Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2734_Assoc11" sourceRef="W2734_Annotation10" targetRef="W2734_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2734_Flow12" sourceRef="W2734_Start5" targetRef="W2734_Task6" />
      <bpmn:sequenceFlow id="W2734_Flow13" sourceRef="W2734_Task6" targetRef="W2734_Task7" />
      <bpmn:sequenceFlow id="W2734_Flow14" sourceRef="W2734_Task7" targetRef="W2734_Task8" />
      <bpmn:sequenceFlow id="W2734_Flow15" sourceRef="W2734_Task8" targetRef="W2734_End9" />
    </bpmn:process>
