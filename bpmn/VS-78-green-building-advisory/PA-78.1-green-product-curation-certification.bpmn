        <bpmn:outgoing>W2724_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2724_Task5" name="Trade Sales Rep receives request: product certifications, MSDS, environmental…">
        <bpmn:documentation>Step 1: Trade Sales Rep receives request: product certifications, MSDS, environmental product declarations, recycled content certs, chain-of-custody for wood, energy performance data
Responsible (R): Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2724_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2724_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2724_Task6" name="Sustainability Coordinator compiles package: contacts vendors, verifies…">
        <bpmn:documentation>Step 2: Sustainability Coordinator compiles package: contacts vendors, verifies currency, matches to BERDE/LEED credit requirements, formats per submission standards
Responsible (R): Sustainability Coordinator / Quality
Accountable (A): COO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2724_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2724_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2724_Task7" name="Trade Sales Rep delivers package with product-credit mapping summary…">
        <bpmn:documentation>Step 3: Trade Sales Rep delivers package with product-credit mapping summary; facilitates project team Q&amp;A; positions BuildRight as preferred green supplier; follows up on order
Responsible (R): Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2724_Flow13</bpmn:incoming>
      </bpmn:userTask>
