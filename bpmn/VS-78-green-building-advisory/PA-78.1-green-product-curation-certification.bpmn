      <bpmn:startEvent id="W2722_Start5" name="Quarterly planogram refresh or green campaign">
        <bpmn:outgoing>W2722_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2722_Task6" name="Merchandising Manager designs experience: dedicated &#x27;BuildRight Green Choice&#x27;…">
        <bpmn:documentation>Step 1: Merchandising Manager designs experience: dedicated &#x27;BuildRight Green Choice&#x27; section (min 16 sqm), green shelf markers, QR codes to benefit info, live demos (LED vs. incandescent)
Responsible (R): Merchandising Manager
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2722_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2722_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2722_Task7" name="Store Ops implements: sets up green section per planogram, trains associates…">
        <bpmn:documentation>Step 2: Store Ops implements: sets up green section per planogram, trains associates, ensures labels current, rotates displays quarterly; Tier 1 stores get expanded sections
Responsible (R): Store Ops
Accountable (A): VP Store Operations
Duration: 1 week per refresh</bpmn:documentation>
        <bpmn:incoming>W2722_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2722_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2722_Task8" name="Marketing measures effectiveness: sales lift for green section products…">
        <bpmn:documentation>Step 3: Marketing measures effectiveness: sales lift for green section products, engagement with displays, QR scan rates, conversion; reports for optimization
Responsible (R): Marketing
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2722_Flow14</bpmn:incoming>
      </bpmn:userTask>
