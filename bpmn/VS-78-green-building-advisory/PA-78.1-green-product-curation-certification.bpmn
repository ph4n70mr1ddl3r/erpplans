        <bpmndi:BPMNShape id="W2719_Annotation9_di" bpmnElement="W2719_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2719_Flow11_di" bpmnElement="W2719_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2719_Flow12_di" bpmnElement="W2719_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2719_Flow13_di" bpmnElement="W2719_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2719_Flow14_di" bpmnElement="W2719_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2719_Assoc10_di" bpmnElement="W2719_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2720" name="W2720. Green Building Standards Knowledge Management" isExecutable="false">
      <bpmn:documentation>Trigger: Building code update or new certification
Frequency: Quarterly update; event-driven
Volume: BERDE, LEED, Philippine Green Building Code
Owner: Sustainability Coordinator
Participants: Sustainability Coord, Category Managers, Training Manager
Source: workflow W2720 — Green Building Standards Knowledge Management</bpmn:documentation>
      <bpmn:laneSet id="W2720_LaneSet3">
        <bpmn:lane id="W2720_Lane1" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2720_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2720_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2720_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2720_Lane2" name="Training Manager">
        <bpmn:flowNodeRef>W2720_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2720_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2720_Start4" name="Building code update or new certification">
        <bpmn:outgoing>W2720_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2720_Task5" name="Sustainability Coordinator maintains knowledge base: BERDE, LEED, Philippine…">
        <bpmn:documentation>Step 1: Sustainability Coordinator maintains knowledge base: BERDE, LEED, Philippine Green Building Code, LGU green building ordinances
Responsible (R): Sustainability Coordinator
Accountable (A): COO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2720_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2720_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2720_Task6" name="Coordinator maps products to green building contributions: which products earn…">
        <bpmn:documentation>Step 2: Coordinator maps products to green building contributions: which products earn BERDE/LEED points, documentation requirements for submissions
Responsible (R): Sustainability Coordinator / Category Manager
Accountable (A): COO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2720_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2720_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2720_Task7" name="Training Manager incorporates into staff training: Green Choice identification…">
        <bpmn:documentation>Step 3: Training Manager incorporates into staff training: Green Choice identification, BERDE/LEED basics, green consultation; sustainability-certified associates advise customers
Responsible (R): Training Manager / Sustainability Coordinator
Accountable (A): CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2720_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2720_End8" name="Complete">
        <bpmn:incoming>W2720_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2720_Annotation9">
        <bpmn:text>Controls: - CTL-463 (ensure controlled execution — Green Product Curation &amp; Certification (PA-78.1).) | - operational: Sustainability Coordinator sign-off on the workflow output
Owner: Sustainability Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2720_Assoc10" sourceRef="W2720_Annotation9" targetRef="W2720_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2720_Flow11" sourceRef="W2720_Start4" targetRef="W2720_Task5" />
      <bpmn:sequenceFlow id="W2720_Flow12" sourceRef="W2720_Task5" targetRef="W2720_Task6" />
      <bpmn:sequenceFlow id="W2720_Flow13" sourceRef="W2720_Task6" targetRef="W2720_Task7" />
      <bpmn:sequenceFlow id="W2720_Flow14" sourceRef="W2720_Task7" targetRef="W2720_End8" />
    </bpmn:process>
