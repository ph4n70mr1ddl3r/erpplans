<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-78.1-green-product-curation-certification" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2718" name="W2718. Green Product Identification &amp; Certification Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual assortment review or new green product launch
Frequency: Quarterly; 50–100 new products/year
Volume: ~2,000–3,000 green products
Owner: Category Manager
Participants: Category Mgr, Procurement, Quality, Sustainability Coordinator
Source: workflow W2718 — Green Product Identification &amp; Certification Verification</bpmn:documentation>
      <bpmn:laneSet id="W2718_LaneSet3">
        <bpmn:lane id="W2718_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2718_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2718_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2718_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2718_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2718_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2718_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2718_Start4" name="Annual assortment review or new green product launch">
        <bpmn:outgoing>W2718_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2718_Task5" name="Category Manager identifies candidates: energy-efficient appliances (DOE…">
        <bpmn:documentation>Step 1: Category Manager identifies candidates: energy-efficient appliances (DOE label), water-saving fixtures, low-VOC paints, FSC lumber, recycled materials, LED, solar; develops criteria per category
Responsible (R): Category Manager / Sustainability Coordinator
Accountable (A): VP Merchandising
Duration: 1–2 weeks/quarter</bpmn:documentation>
        <bpmn:incoming>W2718_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2718_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2718_Task6" name="Procurement verifies certifications: DOE Energy Label, FSC/PEFC, Green…">
        <bpmn:documentation>Step 2: Procurement verifies certifications: DOE Energy Label, FSC/PEFC, Green Seal/EcoLogo, LEED-contributing, BERDE-compliant; confirms validity with issuing body
Responsible (R): Procurement / Quality
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2718_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2718_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2718_Task7" name="Category Manager creates &#x27;BuildRight Green Choice&#x27; designation in ERP…">
        <bpmn:documentation>Step 3: Category Manager creates &#x27;BuildRight Green Choice&#x27; designation in ERP: certification type, environmental benefit, savings data, BERDE/LEED contribution; enables filtering on ecommerce; targets 8–10% of assortment
Responsible (R): Category Manager / IT
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2718_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2718_End8" name="Complete">
        <bpmn:incoming>W2718_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2718_Annotation9">
        <bpmn:text>Controls: - CTL-463 (ensure controlled execution — Green Product Curation &amp; Certification (PA-78.1).) | - operational: Category Manager sign-off on the workflow output
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2718_Assoc10" sourceRef="W2718_Annotation9" targetRef="W2718_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2718_Flow11" sourceRef="W2718_Start4" targetRef="W2718_Task5" />
      <bpmn:sequenceFlow id="W2718_Flow12" sourceRef="W2718_Task5" targetRef="W2718_Task6" />
      <bpmn:sequenceFlow id="W2718_Flow13" sourceRef="W2718_Task6" targetRef="W2718_Task7" />
      <bpmn:sequenceFlow id="W2718_Flow14" sourceRef="W2718_Task7" targetRef="W2718_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2718_diag">
      <bpmndi:BPMNPlane id="W2718_plane" bpmnElement="W_W2718">
        <bpmndi:BPMNShape id="W2718_Lane1_di" bpmnElement="W2718_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2718_Lane2_di" bpmnElement="W2718_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
