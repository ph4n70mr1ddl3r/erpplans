        <bpmn:flowNodeRef>W2724_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2724_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2724_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
