        <bpmndi:BPMNEdge id="W2718_Flow14_di" bpmnElement="W2718_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2718_Assoc10_di" bpmnElement="W2718_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2719" name="W2719. Green Product Supplier Evaluation &amp; Development" isExecutable="false">
      <bpmn:documentation>Trigger: New supplier or annual review
Frequency: Annual per supplier; event-driven
Volume: ~200–300 green product suppliers
Owner: Procurement Manager
Participants: Procurement Mgr, Sustainability Coordinator, Quality
Source: workflow W2719 — Green Product Supplier Evaluation &amp; Development</bpmn:documentation>
      <bpmn:laneSet id="W2719_LaneSet3">
        <bpmn:lane id="W2719_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W2719_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2719_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2719_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2719_Lane2" name="Sustainability Coordinator">
        <bpmn:flowNodeRef>W2719_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2719_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2719_Start4" name="New supplier or annual review">
        <bpmn:outgoing>W2719_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2719_Task5" name="Procurement evaluates suppliers: ISO 14001, sustainable sourcing, carbon…">
        <bpmn:documentation>Step 1: Procurement evaluates suppliers: ISO 14001, sustainable sourcing, carbon disclosure, waste reduction, ethical labor; assigns sustainability score alongside quality/price/delivery
Responsible (R): Procurement / Sustainability Coordinator
Accountable (A): VP Merchandising
Duration: 1–2 days per supplier</bpmn:documentation>
        <bpmn:incoming>W2719_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2719_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2719_Task6" name="Sustainability Coordinator works with suppliers to improve: encourages…">
        <bpmn:documentation>Step 2: Sustainability Coordinator works with suppliers to improve: encourages certification, supports carbon measurement, provides green building guidance
Responsible (R): Sustainability Coordinator / Procurement
Accountable (A): COO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2719_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2719_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2719_Task7" name="Procurement incorporates sustainability in selection: minimum threshold for…">
        <bpmn:documentation>Step 3: Procurement incorporates sustainability in selection: minimum threshold for Green Choice products, preference for higher scores in reviews; reports supplier distribution
Responsible (R): Procurement
Accountable (A): VP Merchandising
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2719_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2719_End8" name="Complete">
        <bpmn:incoming>W2719_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2719_Annotation9">
        <bpmn:text>Controls: - CTL-06: vendor/partner-master onboarding; Operational: Procurement Manager sign-off on the workflow output
Owner: Procurement Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2719_Assoc10" sourceRef="W2719_Annotation9" targetRef="W2719_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2719_Flow11" sourceRef="W2719_Start4" targetRef="W2719_Task5" />
      <bpmn:sequenceFlow id="W2719_Flow12" sourceRef="W2719_Task5" targetRef="W2719_Task6" />
      <bpmn:sequenceFlow id="W2719_Flow13" sourceRef="W2719_Task6" targetRef="W2719_Task7" />
      <bpmn:sequenceFlow id="W2719_Flow14" sourceRef="W2719_Task7" targetRef="W2719_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2719_diag">
      <bpmndi:BPMNPlane id="W2719_plane" bpmnElement="W_W2719">
        <bpmndi:BPMNShape id="W2719_Lane1_di" bpmnElement="W2719_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2719_Lane2_di" bpmnElement="W2719_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
