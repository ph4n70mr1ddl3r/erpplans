        <bpmndi:BPMNShape id="W2720_Annotation9_di" bpmnElement="W2720_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2720_Flow11_di" bpmnElement="W2720_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2720_Flow12_di" bpmnElement="W2720_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2720_Flow13_di" bpmnElement="W2720_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2720_Flow14_di" bpmnElement="W2720_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2720_Assoc10_di" bpmnElement="W2720_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2721" name="W2721. Green Product Pricing &amp; Margin Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly pricing review
Frequency: Monthly
Volume: ~2,000–3,000 green products
Owner: Pricing Analyst
Participants: Pricing Analyst, Category Manager, Finance
Source: workflow W2721 — Green Product Pricing &amp; Margin Management</bpmn:documentation>
      <bpmn:laneSet id="W2721_LaneSet4">
        <bpmn:lane id="W2721_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2721_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2721_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2721_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2721_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2721_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2721_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2721_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2721_Start5" name="Monthly pricing review">
        <bpmn:outgoing>W2721_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2721_Task6" name="Pricing Analyst reviews pricing: green products carry 5–15% premium; validates…">
        <bpmn:documentation>Step 1: Pricing Analyst reviews pricing: green products carry 5–15% premium; validates premium vs. certification cost and customer value (energy savings); checks competitiveness
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2721_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2721_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2721_Task7" name="Category Manager monitors sell-through: conversion (green vs. conventional)…">
        <bpmn:documentation>Step 2: Category Manager monitors sell-through: conversion (green vs. conventional), price sensitivity, margin vs. category average; adjusts to drive adoption while maintaining margin (30–35%)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2721_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2721_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2721_Task8" name="Finance tracks green revenue: sales as % of total (target: 5–8% within 3…">
        <bpmn:documentation>Step 3: Finance tracks green revenue: sales as % of total (target: 5–8% within 3 years), margin contribution, customer segment analysis; reports quarterly to CFO
Responsible (R): Finance
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2721_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2721_End9" name="Complete">
        <bpmn:incoming>W2721_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2721_Annotation10">
        <bpmn:text>Controls: - CTL-463 (ensure controlled execution — Green Product Curation &amp; Certification (PA-78.1).) | - CTL-463 (price-change authorization — links to VS-08 / W40); Operational: Pricing Analyst sign-off on the workflow output
