    <bpmn:process id="W_W2725" name="W2725. Green Product Ecommerce &amp; Digital Catalog Management" isExecutable="false">
      <bpmn:documentation>Trigger: Product update cycle or green campaign
Frequency: Monthly updates; campaign-driven
Volume: ~2,000–3,000 green products
Owner: Ecommerce Manager
Participants: Ecommerce Mgr, PIM Team, Sustainability Coordinator
Source: workflow W2725 — Green Product Ecommerce &amp; Digital Catalog Management</bpmn:documentation>
      <bpmn:laneSet id="W2725_LaneSet3">
        <bpmn:lane id="W2725_Lane1" name="PIM Team">
        <bpmn:flowNodeRef>W2725_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2725_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2725_Lane2" name="Ecommerce Manager">
        <bpmn:flowNodeRef>W2725_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2725_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2725_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2725_Start4" name="Product update cycle or green campaign">
        <bpmn:outgoing>W2725_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2725_Task5" name="PIM Team enriches digital content: sustainability badges, certification logos…">
        <bpmn:documentation>Step 1: PIM Team enriches digital content: sustainability badges, certification logos, benefit icons (energy/water/recycled/low VOC), carbon data, BERDE/LEED indicators, savings calculator
Responsible (R): PIM Team / Sustainability Coordinator
Accountable (A): Ecommerce Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2725_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2725_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2725_Task6" name="Ecommerce Manager implements: dedicated &#x27;Green Building&#x27; page, sustainability…">
        <bpmn:documentation>Step 2: Ecommerce Manager implements: dedicated &#x27;Green Building&#x27; page, sustainability filter across categories, comparison tool, savings calculator, BERDE/LEED material list builder
Responsible (R): Ecommerce Manager / IT
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W2725_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2725_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2725_Task7" name="Manager tracks performance: green search volume, filter usage, conversion vs…">
        <bpmn:documentation>Step 3: Manager tracks performance: green search volume, filter usage, conversion vs. conventional, AOV, repeat rate; reports monthly to CMO
Responsible (R): Ecommerce Manager
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2725_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2725_End8" name="Complete">
        <bpmn:incoming>W2725_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2725_Annotation9">
        <bpmn:text>Controls: - CTL-463 (ensure controlled execution — Green Product Curation &amp; Certification (PA-78.1).) | - operational: Ecommerce Manager sign-off on the workflow output
Owner: Ecommerce Manager</bpmn:text>
      </bpmn:textAnnotation>
