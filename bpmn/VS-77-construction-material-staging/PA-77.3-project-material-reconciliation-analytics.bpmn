        <bpmn:lane id="W2716_Lane1" name="Supply Planning Manager">
        <bpmn:flowNodeRef>W2716_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2716_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2716_Start4</bpmn:flowNodeRef>
