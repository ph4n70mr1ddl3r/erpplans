    <bpmn:process id="W_W2710" name="W2710. Project Material Consumption vs. Estimate Variance Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Project completion or quarterly review
Frequency: Per project; quarterly portfolio review
Volume: ~20–30 projects
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Category Manager, FP&amp;A
Source: workflow W2710 — Project Material Consumption vs. Estimate Variance Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2710_LaneSet4">
        <bpmn:lane id="W2710_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2710_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2710_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2710_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2710_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2710_Lane3" name="FP&amp;A">
        <bpmn:flowNodeRef>W2710_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2710_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2710_Start5" name="Project completion or quarterly review">
        <bpmn:outgoing>W2710_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2710_Task6" name="Trade Sales Manager compares estimated vs. actual: per-item variance, variance…">
        <bpmn:documentation>Step 1: Trade Sales Manager compares estimated vs. actual: per-item variance, variance % per category, total project variance in PHP; identifies consistent over/under-estimation
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2710_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2710_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2710_Task7" name="Category Manager investigates significant variances: over-estimation…">
        <bpmn:documentation>Step 2: Category Manager investigates significant variances: over-estimation (surplus/returns) vs. under-estimation (rush orders); develops improved estimation templates
Responsible (R): Category Manager / Trade Sales Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2710_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2710_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2710_Task8" name="FP&amp;A incorporates into pricing model: adjusts estimation factors, improves…">
        <bpmn:documentation>Step 3: FP&amp;A incorporates into pricing model: adjusts estimation factors, improves margin prediction, develops project-type benchmarks; presents quarterly to CFO
Responsible (R): FP&amp;A / Trade Sales Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2710_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2710_End9" name="Complete">
        <bpmn:incoming>W2710_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2710_Annotation10">
        <bpmn:text>Controls: - CTL-462 (ensure controlled execution — Project Material Reconciliation &amp; Analytics (PA-77.3).) | - operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2710_Assoc11" sourceRef="W2710_Annotation10" targetRef="W2710_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2710_Flow12" sourceRef="W2710_Start5" targetRef="W2710_Task6" />
