    <bpmn:process id="W_W2713" name="W2713. Project Inventory Carrying Cost Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly analysis cycle — Project Inventory Carrying Cost
Frequency: Quarterly
Volume: ~20–30 projects with reserved inventory
Owner: Finance Analyst
Participants: Finance Analyst, Supply Planning Manager, CFO
Source: workflow W2713 — Project Inventory Carrying Cost Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2713_LaneSet3">
        <bpmn:lane id="W2713_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2713_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2713_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2713_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2713_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2713_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2713_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2713_Start4" name="Quarterly analysis cycle — Project Inventory Carrying Cost">
        <bpmn:outgoing>W2713_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2713_Task5" name="Finance Analyst calculates carrying cost: average reserved inventory value (PHP…">
        <bpmn:documentation>Step 1: Finance Analyst calculates carrying cost: average reserved inventory value (PHP 200M–500M), carrying rate (~15–20% annually), cost per project per month
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2713_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2713_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2713_Task6" name="Analyst identifies high cost projects: long duration, early reservation, slow…">
        <bpmn:documentation>Step 2: Analyst identifies high cost projects: long duration, early reservation, slow phase delivery; recommends optimization (reduce lead time, consignment, just-in-phase)
Responsible (R): Finance Analyst / Supply Planning Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2713_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2713_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2713_Task7" name="Finance Controller incorporates into pricing: adjusts quotes for carrying cost…">
        <bpmn:documentation>Step 3: Finance Controller incorporates into pricing: adjusts quotes for carrying cost; Trade Sales Manager uses to negotiate better payment terms
Responsible (R): Finance Controller / Trade Sales Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2713_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2713_End8" name="Complete">
        <bpmn:incoming>W2713_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2713_Annotation9">
