      <bpmn:startEvent id="W2716_Start4" name="Quarterly risk review">
        <bpmn:outgoing>W2716_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2716_Task5" name="Supply Planning Manager assesses risks: vendor concentration, import…">
        <bpmn:documentation>Step 1: Supply Planning Manager assesses risks: vendor concentration, import dependency, DC capacity, weather, geopolitical; per project
Responsible (R): Supply Planning Manager
Accountable (A): VP Supply Chain
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2716_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2716_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2716_Task6" name="Manager develops mitigation: alternative vendors, safety stock, flexible…">
        <bpmn:documentation>Step 2: Manager develops mitigation: alternative vendors, safety stock, flexible scheduling, strategic pre-positioning; quantifies risk exposure in PHP per project
Responsible (R): Supply Planning Manager / Procurement
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2716_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2716_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2716_Task7" name="VP Supply Chain reviews risk portfolio: total exposure, concentration…">
        <bpmn:documentation>Step 3: VP Supply Chain reviews risk portfolio: total exposure, concentration, insurance adequacy, contingency budget; approves mitigation investments
Responsible (R): VP Supply Chain
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2716_Flow13</bpmn:incoming>
      </bpmn:userTask>
