    <bpmn:process id="W_W2717" name="W2717. Annual Project Business Review &amp; Strategy Update" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy cycle
Frequency: Annual
Volume: BuildRight project/wholesale business
Owner: VP Merchandising
Participants: VP Merchandising, Trade Sales Mgr, FP&amp;A, VP Supply Chain, CFO
Source: workflow W2717 — Annual Project Business Review &amp; Strategy Update</bpmn:documentation>
      <bpmn:laneSet id="W2717_LaneSet3">
        <bpmn:lane id="W2717_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W2717_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2717_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2717_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2717_Lane2" name="All VPs">
        <bpmn:flowNodeRef>W2717_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2717_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2717_Start4" name="Annual strategy cycle">
        <bpmn:outgoing>W2717_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2717_Task5" name="VP Merchandising prepares review: revenue trend (3-year), market share…">
        <bpmn:documentation>Step 1: VP Merchandising prepares review: revenue trend (3-year), market share, competitive positioning, customer portfolio, margin performance, growth opportunities
Responsible (R): VP Merchandising / FP&amp;A
Accountable (A): CEO
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W2717_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2717_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2717_Task6" name="Cross-functional session: set targets (revenue growth, margin, customer…">
        <bpmn:documentation>Step 2: Cross-functional session: set targets (revenue growth, margin, customer acquisition), approve investments (team, DC staging, technology), define market focus
Responsible (R): All VPs
Accountable (A): CEO
Duration: Half day</bpmn:documentation>
        <bpmn:incoming>W2717_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2717_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2717_Task7" name="VP Merchandising develops roadmap: quarterly targets, staffing, technology…">
        <bpmn:documentation>Step 3: VP Merchandising develops roadmap: quarterly targets, staffing, technology, marketing; presents to CEO; incorporates into annual operating plan and budget
Responsible (R): VP Merchandising
Accountable (A): CEO
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W2717_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2717_End8" name="Complete">
        <bpmn:incoming>W2717_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2717_Annotation9">
        <bpmn:text>Controls: - CTL-462 (ensure controlled execution — Project Material Reconciliation &amp; Analytics (PA-77.3).) | - operational: VP Merchandising sign-off on the workflow output
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
