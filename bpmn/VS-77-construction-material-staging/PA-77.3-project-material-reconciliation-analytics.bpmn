    <bpmn:process id="W_W2711" name="W2711. Project Delivery Performance Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle — Project Delivery
Frequency: Monthly
Volume: ~20–30 active projects
Owner: Logistics Analyst
Participants: Logistics Analyst, Logistics Manager, Trade Sales Manager
Source: workflow W2711 — Project Delivery Performance Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2711_LaneSet3">
        <bpmn:lane id="W2711_Lane1" name="Logistics Analyst">
        <bpmn:flowNodeRef>W2711_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2711_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2711_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2711_Lane2" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2711_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2711_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2711_Start4" name="Monthly reporting cycle — Project Delivery">
        <bpmn:outgoing>W2711_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2711_Task5" name="Logistics Analyst tracks project delivery KPIs: on-time rate (≥95%), phase lead…">
        <bpmn:documentation>Step 1: Logistics Analyst tracks project delivery KPIs: on-time rate (≥95%), phase lead time, accuracy, damage rate, emergency frequency; compares vs. standard retail metrics
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2711_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2711_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2711_Task6" name="Analyst identifies patterns: consistently late projects, damage-prone…">
        <bpmn:documentation>Step 2: Analyst identifies patterns: consistently late projects, damage-prone categories, challenging regions; produces recommendations
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2711_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2711_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2711_Task7" name="Trade Sales Manager incorporates into contractor relationship: shares metrics…">
        <bpmn:documentation>Step 3: Trade Sales Manager incorporates into contractor relationship: shares metrics in quarterly reviews, sets delivery expectations for new projects
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2711_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2711_End8" name="Complete">
        <bpmn:incoming>W2711_Flow14</bpmn:incoming>
      </bpmn:endEvent>
