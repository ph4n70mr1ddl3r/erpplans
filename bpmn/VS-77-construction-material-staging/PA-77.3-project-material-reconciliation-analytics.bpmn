    <bpmn:process id="W_W2712" name="W2712. Project Portfolio Revenue &amp; Profitability Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial review
Frequency: Monthly
Volume: ~20–30 active + completed projects
Owner: FP&amp;A Manager
Participants: FP&amp;A Mgr, Trade Sales Manager, Finance Controller, CFO
Source: workflow W2712 — Project Portfolio Revenue &amp; Profitability Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2712_LaneSet3">
        <bpmn:lane id="W2712_Lane1" name="FP&amp;A Manager">
        <bpmn:flowNodeRef>W2712_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2712_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2712_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2712_Lane2" name="CFO">
        <bpmn:flowNodeRef>W2712_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2712_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2712_Start4" name="Monthly financial review">
        <bpmn:outgoing>W2712_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2712_Task5" name="FP&amp;A Manager compiles portfolio performance: total revenue (target: ~PHP…">
        <bpmn:documentation>Step 1: FP&amp;A Manager compiles portfolio performance: total revenue (target: ~PHP 5B/year, ~8% of total), average margin (25–30%), project mix, revenue pipeline
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2712_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2712_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2712_Task6" name="Manager analyzes margin drivers: project size, category mix, delivery cost…">
        <bpmn:documentation>Step 2: Manager analyzes margin drivers: project size, category mix, delivery cost, price lock effect, change order impact; identifies improvement opportunities
Responsible (R): FP&amp;A Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2712_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2712_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2712_Task7" name="CFO reviews with VP Merchandising: adjusts pricing strategy, sets margin…">
        <bpmn:documentation>Step 3: CFO reviews with VP Merchandising: adjusts pricing strategy, sets margin targets, approves concessions; presents quarterly to CEO
Responsible (R): CFO / VP Merchandising
Accountable (A): CEO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2712_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2712_End8" name="Complete">
        <bpmn:incoming>W2712_Flow14</bpmn:incoming>
      </bpmn:endEvent>
