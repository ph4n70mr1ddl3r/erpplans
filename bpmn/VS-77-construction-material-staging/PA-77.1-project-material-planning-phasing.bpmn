    <bpmn:process id="W_W2694" name="W2694. Construction Project Material Requirements Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor engages BuildRight for project supply
Frequency: Per project; ~80–120 active B2B projects (of which ~20–30 are large staged/phased material projects)
Volume: ~20–30 projects; PHP 2M–100M each
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Category Managers, Supply Planning, Procurement
Source: workflow W2694 — Construction Project Material Requirements Planning</bpmn:documentation>
      <bpmn:laneSet id="W2694_LaneSet3">
        <bpmn:lane id="W2694_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2694_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2694_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2694_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2694_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W2694_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2694_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2694_Start4" name="Contractor engages BuildRight for project supply">
        <bpmn:outgoing>W2694_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2694_Task5" name="Trade Sales Manager works with contractor: reviews blueprint and bill of…">
        <bpmn:documentation>Step 1: Trade Sales Manager works with contractor: reviews blueprint and bill of quantities, identifies BuildRight-supplied categories, estimates quantities per phase
Responsible (R): Trade Sales Manager / Contractor
Accountable (A): VP Merchandising
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W2694_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2694_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2694_Task6" name="Supply Planning validates availability: checks inventory vs. requirements…">
        <bpmn:documentation>Step 2: Supply Planning validates availability: checks inventory vs. requirements, identifies long-lead items (imported tiles: 60–90 days), raises advance POs
Responsible (R): Supply Planning
Accountable (A): VP Supply Chain
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2694_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2694_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2694_Task7" name="Trade Sales Manager produces phased delivery schedule: divides project into…">
        <bpmn:documentation>Step 3: Trade Sales Manager produces phased delivery schedule: divides project into phases, allocates quantities, aligns delivery dates with timeline; obtains contractor sign-off
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2694_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2694_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2694_End8" name="Complete">
        <bpmn:incoming>W2694_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2694_Annotation9">
        <bpmn:text>Controls: - CTL-460 (ensure controlled execution — Project Material Planning &amp; Phasing (PA-77.1).) | - operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2694_Assoc10" sourceRef="W2694_Annotation9" targetRef="W2694_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2694_Flow11" sourceRef="W2694_Start4" targetRef="W2694_Task5" />
      <bpmn:sequenceFlow id="W2694_Flow12" sourceRef="W2694_Task5" targetRef="W2694_Task6" />
      <bpmn:sequenceFlow id="W2694_Flow13" sourceRef="W2694_Task6" targetRef="W2694_Task7" />
      <bpmn:sequenceFlow id="W2694_Flow14" sourceRef="W2694_Task7" targetRef="W2694_End8" />
    </bpmn:process>
