      <bpmn:sequenceFlow id="W2701_Flow13" sourceRef="W2701_Task6" targetRef="W2701_Task7" />
      <bpmn:sequenceFlow id="W2701_Flow14" sourceRef="W2701_Task7" targetRef="W2701_End8" />
    </bpmn:process>
