    <bpmn:process id="W_W2697" name="W2697. Project Material Price Lock &amp; Escalation Management" isExecutable="false">
      <bpmn:documentation>Trigger: Project contract negotiation or price change
Frequency: Per project; monthly monitoring
Volume: ~80–120 active B2B projects (of which ~20–30 are large staged/phased material projects)
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Category Manager, Pricing Analyst, Finance
Source: workflow W2697 — Project Material Price Lock &amp; Escalation Management</bpmn:documentation>
      <bpmn:laneSet id="W2697_LaneSet4">
        <bpmn:lane id="W2697_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2697_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2697_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2697_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2697_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2697_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2697_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2697_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2697_Start5" name="Project contract negotiation or price change">
        <bpmn:outgoing>W2697_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2697_Task6" name="Trade Sales Manager negotiates price lock: fixed price for project duration…">
        <bpmn:documentation>Step 1: Trade Sales Manager negotiates price lock: fixed price for project duration (3–12 months) or escalation formula tied to published index, with maximum cap
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: Per project negotiation</bpmn:documentation>
        <bpmn:incoming>W2697_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2697_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2697_Task7" name="Pricing Analyst monitors market movements vs. locked prices: identifies margin…">
        <bpmn:documentation>Step 2: Pricing Analyst monitors market movements vs. locked prices: identifies margin erosion risk; quantifies impact; escalates if margin falls below 15%
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2697_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2697_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2697_Task8" name="Finance tracks project margin: revenue vs. actual cost including price lock…">
