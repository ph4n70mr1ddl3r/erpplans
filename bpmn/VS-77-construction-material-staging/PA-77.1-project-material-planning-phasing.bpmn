    <bpmn:process id="W_W2701" name="W2701. Project Account Credit &amp; Payment Terms Management" isExecutable="false">
      <bpmn:documentation>Trigger: Project PO creation or contract negotiation
Frequency: Per project
Volume: ~80–120 active B2B projects (of which ~20–30 are large staged/phased material projects)
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Credit Manager, Finance, Contractor
Source: workflow W2701 — Project Account Credit &amp; Payment Terms Management</bpmn:documentation>
      <bpmn:laneSet id="W2701_LaneSet3">
        <bpmn:lane id="W2701_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2701_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2701_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2701_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2701_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2701_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2701_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2701_Start4" name="Project PO creation or contract negotiation">
        <bpmn:outgoing>W2701_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2701_Task5" name="Trade Sales Manager negotiates payment terms: milestone-based, progress…">
        <bpmn:documentation>Step 1: Trade Sales Manager negotiates payment terms: milestone-based, progress billing, retention (5–10%), credit terms (Net 30/60); Credit Manager approval per authorization matrix
Responsible (R): Trade Sales Manager / Credit Manager
Accountable (A): VP Merchandising / CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W2701_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2701_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2701_Task6" name="Finance sets up project billing: creates project account, links phase delivery…">
        <bpmn:documentation>Step 2: Finance sets up project billing: creates project account, links phase delivery to billing milestones, configures retention tracking, establishes credit limit
Responsible (R): Finance / Credit Manager
Accountable (A): CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W2701_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2701_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2701_Task7" name="Trade Sales Manager monitors payment health: tracks billed vs. collected…">
        <bpmn:documentation>Step 3: Trade Sales Manager monitors payment health: tracks billed vs. collected, escalates overdue payments, ensures retention release upon completion
Responsible (R): Trade Sales Manager / Finance
Accountable (A): VP Merchandising
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2701_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2701_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2701_End8" name="Complete">
        <bpmn:incoming>W2701_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2701_Annotation9">
        <bpmn:text>Controls: - CTL-212: trade-credit authorization &amp; exposure guard — links to VS-16 / W24; Operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2701_Assoc10" sourceRef="W2701_Annotation9" targetRef="W2701_Start4" associationDirection="None" />
