    <bpmn:process id="W_W2696" name="W2696. Project Material Substitution &amp; Alternative Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Specified material unavailable or change request
Frequency: Ad-hoc; 5–10 per project
Volume: ~5–10 per project
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Category Manager, Contractor, Supply Planning
Source: workflow W2696 — Project Material Substitution &amp; Alternative Approval</bpmn:documentation>
      <bpmn:laneSet id="W2696_LaneSet4">
        <bpmn:lane id="W2696_Lane1" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2696_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2696_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2696_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2696_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2696_Lane3" name="Contractor">
        <bpmn:flowNodeRef>W2696_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2696_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2696_Start5" name="Specified material unavailable or change request">
        <bpmn:outgoing>W2696_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2696_Task6" name="Trade Sales Rep identifies substitution need: out of stock, discontinued…">
        <bpmn:documentation>Step 1: Trade Sales Rep identifies substitution need: out of stock, discontinued, import delay; proposes alternative from available inventory
Responsible (R): Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2696_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2696_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2696_Task7" name="Category Manager evaluates: technical equivalence, visual equivalence…">
        <bpmn:documentation>Step 2: Category Manager evaluates: technical equivalence, visual equivalence (tiles/fixtures), price difference, contractor approval; documents rationale
Responsible (R): Category Manager / Trade Sales Rep
Accountable (A): VP Merchandising
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2696_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2696_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2696_Task8" name="Contractor approves/rejects: if approved — updates reservation and PO; if…">
        <bpmn:documentation>Step 3: Contractor approves/rejects: if approved — updates reservation and PO; if rejected — Procurement expedites original; all documented in project file
Responsible (R): Contractor / Trade Sales Rep / Supply Planning
Accountable (A): Trade Sales Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2696_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2696_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2696_End9" name="Complete">
        <bpmn:incoming>W2696_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2696_Annotation10">
        <bpmn:text>Controls: - CTL-460 (ensure controlled execution — Project Material Planning &amp; Phasing (PA-77.1).) | - operational: Trade Sales Representative sign-off on the workflow output
Owner: Trade Sales Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2696_Assoc11" sourceRef="W2696_Annotation10" targetRef="W2696_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2696_Flow12" sourceRef="W2696_Start5" targetRef="W2696_Task6" />
      <bpmn:sequenceFlow id="W2696_Flow13" sourceRef="W2696_Task6" targetRef="W2696_Task7" />
