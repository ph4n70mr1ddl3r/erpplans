        <bpmndi:BPMNEdge id="W2695_Flow15_di" bpmnElement="W2695_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2695_Assoc11_di" bpmnElement="W2695_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
