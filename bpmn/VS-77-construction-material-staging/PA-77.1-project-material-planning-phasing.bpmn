    <bpmn:process id="W_W2695" name="W2695. Project Material Reservation &amp; Inventory Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Project material plan approved
Frequency: Per project; ongoing monitoring
Volume: ~80–120 active B2B projects (of which ~20–30 are large staged/phased material projects)
Owner: Supply Planner
Participants: Supply Planner, Category Manager, DC Ops, Trade Sales Manager
Source: workflow W2695 — Project Material Reservation &amp; Inventory Allocation</bpmn:documentation>
      <bpmn:laneSet id="W2695_LaneSet4">
        <bpmn:lane id="W2695_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W2695_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2695_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2695_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W2695_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2695_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W2695_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2695_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2695_Start5" name="Project material plan approved">
        <bpmn:outgoing>W2695_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2695_Task6" name="Supply Planner creates inventory reservations: allocates stock against project…">
        <bpmn:documentation>Step 1: Supply Planner creates inventory reservations: allocates stock against project PO, prevents ROP from consuming project stock; configures ATP for uncommitted availability
Responsible (R): Supply Planner
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2695_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2695_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2695_Task7" name="Category Manager monitors reservations: ensures no stockouts for regular…">
        <bpmn:documentation>Step 2: Category Manager monitors reservations: ensures no stockouts for regular customers, adjusts allocation, authorizes substitutions when unavailable
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2695_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2695_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2695_Task8" name="DC Ops segregates project inventory: dedicated staging area per project, labels…">
        <bpmn:documentation>Step 3: DC Ops segregates project inventory: dedicated staging area per project, labels with project reference, coordinates delivery scheduling per phase
Responsible (R): DC Ops
Accountable (A): DC Ops Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2695_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2695_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2695_End9" name="Complete">
        <bpmn:incoming>W2695_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2695_Annotation10">
        <bpmn:text>Controls: - CTL-460 (ensure controlled execution — Project Material Planning &amp; Phasing (PA-77.1).) | - operational: inventory-count integrity; Operational: Supply Planner sign-off on the workflow output
Owner: Supply Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2695_Assoc11" sourceRef="W2695_Annotation10" targetRef="W2695_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2695_Flow12" sourceRef="W2695_Start5" targetRef="W2695_Task6" />
      <bpmn:sequenceFlow id="W2695_Flow13" sourceRef="W2695_Task6" targetRef="W2695_Task7" />
