      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2704" name="W2704. Site Material Storage &amp; Protection Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Materials delivered to active site
Frequency: Per delivery; ongoing monitoring
Volume: ~20–30 active project sites
Owner: Contractor Site Manager
Participants: Contractor Site Mgr, Trade Sales Rep, Logistics
Source: workflow W2704 — Site Material Storage &amp; Protection Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2704_LaneSet2">
        <bpmn:lane id="W2704_Lane1" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2704_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2704_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2704_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2704_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2704_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2704_Start3" name="Materials delivered to active site">
        <bpmn:outgoing>W2704_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2704_Task4" name="Trade Sales Rep advises on storage: cement off-ground under cover, tiles flat…">
        <bpmn:documentation>Step 1: Trade Sales Rep advises on storage: cement off-ground under cover, tiles flat on pallets, lumber with spacers for air circulation, paint in cool dry area
Responsible (R): Trade Sales Rep / Contractor
Accountable (A): Trade Sales Manager
Duration: Per phase delivery</bpmn:documentation>
        <bpmn:incoming>W2704_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2704_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2704_Task5" name="Rep conducts periodic site storage assessment: verifies proper storage…">
        <bpmn:documentation>Step 2: Rep conducts periodic site storage assessment: verifies proper storage, identifies issues, advises corrective action; documents for project file
Responsible (R): Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: Per site visit</bpmn:documentation>
        <bpmn:incoming>W2704_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2704_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2704_Task6" name="If material damaged from improper storage: coordinates replacement at…">
        <bpmn:documentation>Step 3: If material damaged from improper storage: coordinates replacement at contractor&#x27;s expense (not BuildRight liability post-delivery); documents for insurance
Responsible (R): Trade Sales Rep / Contractor
Accountable (A): Trade Sales Manager
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W2704_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2704_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2704_End7" name="Complete">
        <bpmn:incoming>W2704_Flow13</bpmn:incoming>
      </bpmn:endEvent>
