    <bpmn:process id="W_W2708" name="W2708. Project Delivery SLA Compliance &amp; Penalty Management" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery milestone missed
Frequency: Per delayed delivery; ~10–15/year
Volume: ~10–15 per year
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Logistics Manager, Finance, Contractor
Source: workflow W2708 — Project Delivery SLA Compliance &amp; Penalty Management</bpmn:documentation>
      <bpmn:laneSet id="W2708_LaneSet3">
        <bpmn:lane id="W2708_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2708_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2708_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2708_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2708_Lane2" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2708_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2708_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2708_Start4" name="Delivery milestone missed">
        <bpmn:outgoing>W2708_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2708_Task5" name="Logistics Manager reports delay: root cause (DC error, vendor late, truck…">
        <bpmn:documentation>Step 1: Logistics Manager reports delay: root cause (DC error, vendor late, truck breakdown, weather, access), revised ETA; Rep communicates to contractor
Responsible (R): Logistics Manager / Trade Sales Rep
Accountable (A): VP Supply Chain
Duration: Within 4 hours</bpmn:documentation>
        <bpmn:incoming>W2708_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2708_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2708_Task6" name="Trade Sales Rep manages SLA penalty: if contract includes penalty (1%/day…">
        <bpmn:documentation>Step 2: Trade Sales Rep manages SLA penalty: if contract includes penalty (1%/day late), Finance calculates; Rep negotiates resolution (waiver, expedited replacement)
Responsible (R): Trade Sales Rep / Finance
Accountable (A): Trade Sales Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2708_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2708_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2708_Task7" name="Logistics Manager conducts root cause analysis: implements prevention (earlier…">
        <bpmn:documentation>Step 3: Logistics Manager conducts root cause analysis: implements prevention (earlier staging, backup trucks, weather planning); tracks on-time rate (target: ≥95%)
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W2708_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2708_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2708_End8" name="Complete">
        <bpmn:incoming>W2708_Flow14</bpmn:incoming>
      </bpmn:endEvent>
