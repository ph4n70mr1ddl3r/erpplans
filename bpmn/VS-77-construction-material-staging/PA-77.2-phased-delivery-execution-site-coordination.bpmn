    <bpmn:process id="W_W2705" name="W2705. Cross-Phase Material Transfer &amp; Reallocation" isExecutable="false">
      <bpmn:documentation>Trigger: Schedule change requiring reallocation
Frequency: Ad-hoc; 5–10 per project
Volume: ~5–10 per project
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Supply Planning, Contractor
Source: workflow W2705 — Cross-Phase Material Transfer &amp; Reallocation</bpmn:documentation>
      <bpmn:laneSet id="W2705_LaneSet4">
        <bpmn:lane id="W2705_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W2705_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2705_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2705_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W2705_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2705_Lane3" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2705_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2705_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2705_Start5" name="Schedule change requiring reallocation">
        <bpmn:outgoing>W2705_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2705_Task6" name="Contractor requests reallocation: construction ahead/behind schedule; wants to…">
        <bpmn:documentation>Step 1: Contractor requests reallocation: construction ahead/behind schedule; wants to move materials between phases; Rep documents request
Responsible (R): Contractor / Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2705_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2705_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2705_Task7" name="Supply Planning evaluates impact: checks if reallocating causes future…">
        <bpmn:documentation>Step 2: Supply Planning evaluates impact: checks if reallocating causes future stockout, identifies if additional procurement needed, adjusts reservation
Responsible (R): Supply Planning
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2705_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2705_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2705_Task8" name="Trade Sales Rep confirms reallocation: adjusted quantities, cost implications…">
        <bpmn:documentation>Step 3: Trade Sales Rep confirms reallocation: adjusted quantities, cost implications, updated schedule; updates ERP; monitors for cascading impacts
Responsible (R): Trade Sales Rep / Contractor
Accountable (A): Trade Sales Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2705_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2705_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2705_End9" name="Complete">
