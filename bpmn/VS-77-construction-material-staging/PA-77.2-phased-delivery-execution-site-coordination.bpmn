    <bpmn:process id="W_W2709" name="W2709. Project Completion Material Reconciliation &amp; Close-Out" isExecutable="false">
      <bpmn:documentation>Trigger: Project construction completed
Frequency: Per project; ~20–30/year
Volume: ~20–30 per year
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Finance, Supply Planning, Contractor
Source: workflow W2709 — Project Completion Material Reconciliation &amp; Close-Out</bpmn:documentation>
      <bpmn:laneSet id="W2709_LaneSet4">
        <bpmn:lane id="W2709_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2709_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2709_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2709_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2709_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2709_Lane3" name="Supply Planning">
        <bpmn:flowNodeRef>W2709_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2709_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2709_Start5" name="Project construction completed">
        <bpmn:outgoing>W2709_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2709_Task6" name="Trade Sales Manager initiates reconciliation: compares ordered vs. delivered…">
        <bpmn:documentation>Step 1: Trade Sales Manager initiates reconciliation: compares ordered vs. delivered vs. returned, reconciles all phases, verifies no outstanding requests
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2709_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2709_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2709_Task7" name="Finance completes billing: all payments received, retention released, credits…">
        <bpmn:documentation>Step 2: Finance completes billing: all payments received, retention released, credits settled, project account closed; produces final P&amp;L
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2709_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2709_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2709_Task8" name="Supply Planning releases unused reservations: returns inventory to general…">
        <bpmn:documentation>Step 3: Supply Planning releases unused reservations: returns inventory to general stock, closes staging areas, cancels remaining POs; Trade Sales Manager conducts lessons-learned review
Responsible (R): Supply Planning / Trade Sales Manager
Accountable (A): VP Supply Chain
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2709_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2709_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2709_End9" name="Complete">
        <bpmn:incoming>W2709_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2709_Annotation10">
        <bpmn:text>Controls: - CTL-461 (ensure controlled execution — Phased Delivery Execution &amp; Site Coordination (PA-77.2).) | - operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
