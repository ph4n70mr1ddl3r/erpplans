    <bpmn:process id="W_W2703" name="W2703. On-Site Material Verification &amp; Receipt" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery arrives at construction site
Frequency: Per delivery; ~80–120/month
Volume: ~80–120/month
Owner: Contractor Site Representative
Participants: Contractor Rep, Driver, Trade Sales Rep
Source: workflow W2703 — On-Site Material Verification &amp; Receipt</bpmn:documentation>
      <bpmn:laneSet id="W2703_LaneSet4">
        <bpmn:lane id="W2703_Lane1" name="Driver">
        <bpmn:flowNodeRef>W2703_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2703_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2703_Lane2" name="Contractor Representative">
        <bpmn:flowNodeRef>W2703_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2703_Lane3" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2703_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2703_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2703_Start5" name="Delivery arrives at construction site">
        <bpmn:outgoing>W2703_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2703_Task6" name="Driver arrives: contacts site rep, directs to unloading area; rep verifies…">
        <bpmn:documentation>Step 1: Driver arrives: contacts site rep, directs to unloading area; rep verifies manifest against phase list item by item; checks for transit damage
Responsible (R): Driver / Contractor Representative
Accountable (A): Logistics Coordinator
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2703_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2703_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2703_Task7" name="Site rep accepts: signs receipt noting exceptions; photographs materials…">
        <bpmn:documentation>Step 2: Site rep accepts: signs receipt noting exceptions; photographs materials; Driver photographs signed receipt and uploads via app
Responsible (R): Contractor Representative / Driver
Accountable (A): Logistics Coordinator
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2703_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2703_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2703_Task8" name="Trade Sales Rep reviews: processes accepted delivery, triggers billing…">
        <bpmn:documentation>Step 3: Trade Sales Rep reviews: processes accepted delivery, triggers billing milestone, addresses exceptions (replacement, shortage investigation, reservation adjustment)
Responsible (R): Trade Sales Rep
Accountable (A): Trade Sales Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2703_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2703_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2703_End9" name="Complete">
        <bpmn:incoming>W2703_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2703_Annotation10">
        <bpmn:text>Controls: - CTL-461 (ensure controlled execution — Phased Delivery Execution &amp; Site Coordination (PA-77.2).) | - operational: Contractor Site Representative sign-off on the workflow output
Owner: Contractor Site Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2703_Assoc11" sourceRef="W2703_Annotation10" targetRef="W2703_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2703_Flow12" sourceRef="W2703_Start5" targetRef="W2703_Task6" />
