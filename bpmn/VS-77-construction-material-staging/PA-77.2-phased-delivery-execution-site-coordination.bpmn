      <bpmn:startEvent id="W2707_Start5" name="Multiple vendors with different lead times">
        <bpmn:outgoing>W2707_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2707_Task6" name="Procurement Manager coordinates: identifies all vendors, maps lead times…">
        <bpmn:documentation>Step 1: Procurement Manager coordinates: identifies all vendors, maps lead times (local: 7–21 days, import: 45–90 days), sequences POs for on-time phase delivery
Responsible (R): Procurement Manager
Accountable (A): VP Supply Chain
Duration: Per project phase</bpmn:documentation>
        <bpmn:incoming>W2707_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2707_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2707_Task7" name="Procurement monitors vendor performance against project timeline: tracks…">
        <bpmn:documentation>Step 2: Procurement monitors vendor performance against project timeline: tracks shipments, escalates late deliveries, arranges substitute sourcing
Responsible (R): Procurement / Trade Sales Rep
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2707_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2707_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2707_Task8" name="Supply Planning coordinates DC staging: ensures multi-vendor materials…">
        <bpmn:documentation>Step 3: Supply Planning coordinates DC staging: ensures multi-vendor materials consolidated before delivery date; manages receiving schedule and quality inspection
Responsible (R): Supply Planning / DC Ops
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2707_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2707_Flow15</bpmn:outgoing>
      </bpmn:userTask>
