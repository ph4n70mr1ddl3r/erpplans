    <bpmn:process id="W_W2706" name="W2706. Project Material Surplus &amp; Return Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Project near completion
Frequency: Per project; ~20–30/year
Volume: ~20–30 projects
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Receiving Clerk, Finance, Contractor
Source: workflow W2706 — Project Material Surplus &amp; Return Processing</bpmn:documentation>
