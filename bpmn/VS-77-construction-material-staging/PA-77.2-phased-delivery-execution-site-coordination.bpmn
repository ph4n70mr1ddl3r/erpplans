    <bpmn:process id="W_W2702" name="W2702. Phase Delivery Trigger &amp; Material Staging at DC" isExecutable="false">
      <bpmn:documentation>Trigger: Construction phase ready for material
Frequency: Per phase; ~80–120 phase deliveries/month
Volume: ~80–120/month
Owner: Logistics Coordinator
Participants: Logistics Coord, DC Ops, Trade Sales Rep, Contractor
Source: workflow W2702 — Phase Delivery Trigger &amp; Material Staging at DC</bpmn:documentation>
      <bpmn:laneSet id="W2702_LaneSet4">
        <bpmn:lane id="W2702_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W2702_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2702_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2702_Lane2" name="DC Ops">
        <bpmn:flowNodeRef>W2702_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2702_Lane3" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2702_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2702_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2702_Start5" name="Construction phase ready for material">
        <bpmn:outgoing>W2702_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2702_Task6" name="Contractor notifies phase readiness (3–5 days advance); Rep triggers phase…">
        <bpmn:documentation>Step 1: Contractor notifies phase readiness (3–5 days advance); Rep triggers phase delivery order; Logistics verifies availability in project staging area at DC
Responsible (R): Contractor / Trade Sales Rep / Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2702_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2702_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2702_Task7" name="DC Ops picks and stages: verifies quantities against phase list, stages at…">
        <bpmn:documentation>Step 2: DC Ops picks and stages: verifies quantities against phase list, stages at loading dock, creates manifest; Quality inspects outbound materials
Responsible (R): DC Ops / Quality
Accountable (A): DC Ops Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2702_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2702_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2702_Task8" name="Logistics Coordinator schedules delivery: assigns truck, coordinates time with…">
        <bpmn:documentation>Step 3: Logistics Coordinator schedules delivery: assigns truck, coordinates time with contractor, arranges special equipment; sends confirmation with ETA
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2702_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2702_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2702_End9" name="Complete">
        <bpmn:incoming>W2702_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2702_Annotation10">
        <bpmn:text>Controls: - CTL-461 (ensure controlled execution — Phased Delivery Execution &amp; Site Coordination (PA-77.2).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2702_Assoc11" sourceRef="W2702_Annotation10" targetRef="W2702_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2702_Flow12" sourceRef="W2702_Start5" targetRef="W2702_Task6" />
      <bpmn:sequenceFlow id="W2702_Flow13" sourceRef="W2702_Task6" targetRef="W2702_Task7" />
      <bpmn:sequenceFlow id="W2702_Flow14" sourceRef="W2702_Task7" targetRef="W2702_Task8" />
      <bpmn:sequenceFlow id="W2702_Flow15" sourceRef="W2702_Task8" targetRef="W2702_End9" />
    </bpmn:process>
