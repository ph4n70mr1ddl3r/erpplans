    <bpmn:process id="W_W3983" name="W3983. M&amp;A Governance, Approval Authority &amp; Stage-Gate Process" isExecutable="false">
      <bpmn:documentation>Trigger: Stage-gate review; approval request
Frequency: Per stage-gate
Volume: Per transaction
Owner: CEO / Board
Participants: CEO, Board/Audit Committee (links to VS-36), CFO, Head of Corp Dev, VP Legal, affected business unit
Source: workflow W3983 — M&amp;A Governance, Approval Authority &amp; Stage-Gate Process</bpmn:documentation>
      <bpmn:laneSet id="W3983_LaneSet3">
        <bpmn:lane id="W3983_Lane1" name="Corp Dev">
