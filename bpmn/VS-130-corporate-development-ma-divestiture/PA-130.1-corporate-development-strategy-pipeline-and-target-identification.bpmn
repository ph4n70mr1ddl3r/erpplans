Responsible (R): Corp Dev / Legal / CEO
Accountable (A): CEO
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3982_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3982_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3982_Task6" name="Corp Dev set up confirmatory due diligence (links to PA-130.2) and SPA…">
