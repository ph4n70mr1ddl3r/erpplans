        <bpmndi:BPMNEdge id="W3979_Flow13_di" bpmnElement="W3979_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3979_Assoc9_di" bpmnElement="W3979_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3980" name="W3980. Target Screening, Strategic Fit &amp; Preliminary Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Prioritized target
Frequency: Per target
Volume: Per prioritized target
Owner: Head of Corporate Development
Participants: Corp Dev, Strategy, Insights (links to VS-44), Finance (links to VS-17.4), affected business unit, Legal (links to VS-100), HR (links to VS-19/VS-84), Tax (links to VS-79)
Source: workflow W3980 — Target Screening, Strategic Fit &amp; Preliminary Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3980_LaneSet2">
        <bpmn:lane id="W3980_Lane1" name="Corp Dev">
        <bpmn:flowNodeRef>W3980_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3980_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3980_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3980_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3980_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3980_Start3" name="Prioritized target">
        <bpmn:outgoing>W3980_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3980_Task4" name="Corp Dev conduct the preliminary strategic-fit and business assessment using…">
        <bpmn:documentation>Step 1: Corp Dev conduct the preliminary strategic-fit and business assessment using public/authorized information: market position, store/portfolio overlap, assortment and channel fit, customer base, brand, operations, and high-level synergies
Responsible (R): Corp Dev / Strategy / affected BU
Accountable (A): Head of Corp Dev
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3980_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3980_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3980_Task5" name="Corp Dev/Finance conduct a preliminary financial screen: revenue…">
        <bpmn:documentation>Step 2: Corp Dev/Finance conduct a preliminary financial screen: revenue, EBITDA/margin, growth, capital structure, and a preliminary value range; Corp Dev/Legal/HR screen red flags (legal, labor/union, tax, ABC, ESG)
Responsible (R): Corp Dev / Finance / Legal / HR / Tax
Accountable (A): Head of Corp Dev
Duration: Per target</bpmn:documentation>
        <bpmn:incoming>W3980_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3980_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3980_Task6" name="Corp Dev recommend go/no-go to the stage-gate (links to W3983), and if go…">
