<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-185.2-member-transaction-routing-and-verification" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5305" name="W5305. Cooperative Member Digital POS Account Association &amp; Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Cooperative member wishes to purchase goods using co-op credit line
Frequency: Daily per member transaction
Volume: ~12,000-15,000 purchases annually
Owner: Front-End Store Manager / POS Cashier
Participants: Cooperative Member, Co-op Verification Hotline Agent
Source: workflow W5305 — Cooperative Member Digital POS Account Association &amp; Verification</bpmn:documentation>
      <bpmn:laneSet id="W5305_LaneSet4">
        <bpmn:lane id="W5305_Lane1" name="Cooperative Member">
        <bpmn:flowNodeRef>W5305_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5305_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5305_Lane2" name="POS Cashier">
        <bpmn:flowNodeRef>W5305_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5305_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5305_Lane3" name="Front-End Store Manager">
        <bpmn:flowNodeRef>W5305_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5305_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5305_Start5" name="Cooperative member wishes to purchase goods using co-op credit line">
        <bpmn:outgoing>W5305_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5305_Task6" name="Present member credentials at checkout counter.">
        <bpmn:documentation>Step 1: Present member credentials at checkout counter.
Responsible (R): Cooperative Member
Accountable (A): Front-End Store Manager / POS Cashier
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5305_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5305_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5305_Task7" name="Scan member digital barcode on POS terminal.">
        <bpmn:documentation>Step 2: Scan member digital barcode on POS terminal.
Responsible (R): POS Cashier
Accountable (A): Front-End Store Manager / POS Cashier
Duration: 1 min</bpmn:documentation>
        <bpmn:incoming>W5305_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5305_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5305_Task8" name="Query central co-op registry database to verify member eligibility.">
        <bpmn:documentation>Step 3: Query central co-op registry database to verify member eligibility.
Responsible (R): Front-End Store Manager / POS Cashier
Accountable (A): Front-End Store Manager / POS Cashier
Duration: 30 sec</bpmn:documentation>
        <bpmn:incoming>W5305_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5305_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5305_Task9" name="If digital lookup fails, check membership status manually.">
        <bpmn:documentation>Step 4: If digital lookup fails, check membership status manually.
Responsible (R): POS Cashier
Accountable (A): Front-End Store Manager / POS Cashier
Duration: 3 minutes</bpmn:documentation>
        <bpmn:incoming>W5305_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5305_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5305_End10" name="Complete">
        <bpmn:incoming>W5305_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5305_Annotation11">
        <bpmn:text>Controls: - CTL-20: Ensure POS cash/credit accountability; Cashier ID matching protocols.
Owner: Front-End Store Manager / POS Cashier</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5305_Assoc12" sourceRef="W5305_Annotation11" targetRef="W5305_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5305_Flow13" sourceRef="W5305_Start5" targetRef="W5305_Task6" />
      <bpmn:sequenceFlow id="W5305_Flow14" sourceRef="W5305_Task6" targetRef="W5305_Task7" />
      <bpmn:sequenceFlow id="W5305_Flow15" sourceRef="W5305_Task7" targetRef="W5305_Task8" />
      <bpmn:sequenceFlow id="W5305_Flow16" sourceRef="W5305_Task8" targetRef="W5305_Task9" />
      <bpmn:sequenceFlow id="W5305_Flow17" sourceRef="W5305_Task9" targetRef="W5305_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5305_diag">
      <bpmndi:BPMNPlane id="W5305_plane" bpmnElement="W_W5305">
        <bpmndi:BPMNShape id="W5305_Lane1_di" bpmnElement="W5305_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Lane2_di" bpmnElement="W5305_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Lane3_di" bpmnElement="W5305_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Task6_di" bpmnElement="W5305_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Task7_di" bpmnElement="W5305_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Task8_di" bpmnElement="W5305_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Task9_di" bpmnElement="W5305_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Start5_di" bpmnElement="W5305_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_End10_di" bpmnElement="W5305_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5305_Annotation11_di" bpmnElement="W5305_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5305_Flow13_di" bpmnElement="W5305_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5305_Flow14_di" bpmnElement="W5305_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5305_Flow15_di" bpmnElement="W5305_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
