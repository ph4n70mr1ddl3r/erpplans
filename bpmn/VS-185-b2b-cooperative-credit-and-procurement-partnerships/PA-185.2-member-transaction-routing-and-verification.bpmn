        <bpmndi:BPMNShape id="W5306_Task6_di" bpmnElement="W5306_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5306_Task7_di" bpmnElement="W5306_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5306_Start3_di" bpmnElement="W5306_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5306_End8_di" bpmnElement="W5306_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5306_Annotation9_di" bpmnElement="W5306_Annotation9"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5306_Flow11_di" bpmnElement="W5306_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5306_Flow12_di" bpmnElement="W5306_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5306_Flow13_di" bpmnElement="W5306_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5306_Flow14_di" bpmnElement="W5306_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5306_Flow15_di" bpmnElement="W5306_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5306_Assoc10_di" bpmnElement="W5306_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5307" name="W5307. Real-time Credit Line Availability Check at Checkout" isExecutable="false">
      <bpmn:documentation>Trigger: POS cashier initiates credit payment method on co-op account (W5305)
Frequency: Per co-op account checkout
Volume: ~12,000-15,000 checks annually
Owner: POS System Controller
Participants: POS Cashier, Credit Analyst
Source: workflow W5307 — Real-time Credit Line Availability Check at Checkout</bpmn:documentation>
      <bpmn:laneSet id="W5307_LaneSet2">
        <bpmn:lane id="W5307_Lane1" name="POS System Controller">
        <bpmn:flowNodeRef>W5307_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5307_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5307_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5307_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5307_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5307_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5307_Start3" name="POS cashier initiates credit payment method on co-op account (W5305)">
        <bpmn:outgoing>W5307_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W5307_Task4" name="POS system calculates basket total (net of co-op B2B discounts and VAT…">
        <bpmn:documentation>Step 1: POS system calculates basket total (net of co-op B2B discounts and VAT exemptions).
Responsible (R): POS System Controller
Accountable (A): POS System Controller
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5307_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5307_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5307_Task5" name="System queries parent co-op credit ledger balance in central ERP database.">
        <bpmn:documentation>Step 2: System queries parent co-op credit ledger balance in central ERP database.
Responsible (R): POS System Controller
Accountable (A): POS System Controller
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5307_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5307_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5307_Task6" name="If requested transaction exceeds remaining available credit, block checkout and…">
        <bpmn:documentation>Step 3: If requested transaction exceeds remaining available credit, block checkout and issue credit limit alert.
Responsible (R): POS System Controller
Accountable (A): POS System Controller
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5307_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5307_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5307_Task7" name="If limit is sufficient, hold transaction amount and proceed to invoice lock.">
        <bpmn:documentation>Step 4: If limit is sufficient, hold transaction amount and proceed to invoice lock.
Responsible (R): POS System Controller
Accountable (A): POS System Controller
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5307_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5307_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W5307_End8" name="Complete">
        <bpmn:incoming>W5307_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5307_Annotation9">
        <bpmn:text>Controls: - CTL-786 (ensure controlled execution — Member Transaction Routing &amp; Verification (PA-185.2).) | - operational: finance risk controls; Credit limits enforced at system database levels.
Owner: POS System Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5307_Assoc10" sourceRef="W5307_Annotation9" targetRef="W5307_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5307_Flow11" sourceRef="W5307_Start3" targetRef="W5307_Task4" />
      <bpmn:sequenceFlow id="W5307_Flow12" sourceRef="W5307_Task4" targetRef="W5307_Task5" />
      <bpmn:sequenceFlow id="W5307_Flow13" sourceRef="W5307_Task5" targetRef="W5307_Task6" />
      <bpmn:sequenceFlow id="W5307_Flow14" sourceRef="W5307_Task6" targetRef="W5307_Task7" />
      <bpmn:sequenceFlow id="W5307_Flow15" sourceRef="W5307_Task7" targetRef="W5307_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5307_diag">
      <bpmndi:BPMNPlane id="W5307_plane" bpmnElement="W_W5307">
        <bpmndi:BPMNShape id="W5307_Lane1_di" bpmnElement="W5307_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Task4_di" bpmnElement="W5307_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Task5_di" bpmnElement="W5307_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Task6_di" bpmnElement="W5307_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Task7_di" bpmnElement="W5307_Task7"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Start3_di" bpmnElement="W5307_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_End8_di" bpmnElement="W5307_End8"><dc:Bounds x="1260" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5307_Annotation9_di" bpmnElement="W5307_Annotation9"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5307_Flow11_di" bpmnElement="W5307_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5307_Flow12_di" bpmnElement="W5307_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5307_Flow13_di" bpmnElement="W5307_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5307_Flow14_di" bpmnElement="W5307_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5307_Flow15_di" bpmnElement="W5307_Flow15"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5307_Assoc10_di" bpmnElement="W5307_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
