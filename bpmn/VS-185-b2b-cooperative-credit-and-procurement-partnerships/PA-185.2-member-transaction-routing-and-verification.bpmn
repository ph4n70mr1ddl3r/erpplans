    <bpmn:process id="W_W5308" name="W5308. Multi-Member Group Purchase Discount Routing" isExecutable="false">
      <bpmn:documentation>Trigger: Group order placement from multiple co-op members at B2B desk
Frequency: Weekly per regional store
Volume: ~800-1,000 group orders annually
Owner: B2B Sourcing Manager
Participants: Cooperative Members, Store Manager
Source: workflow W5308 — Multi-Member Group Purchase Discount Routing</bpmn:documentation>
      <bpmn:laneSet id="W5308_LaneSet2">
        <bpmn:lane id="W5308_Lane1" name="B2B Sourcing Manager">
        <bpmn:flowNodeRef>W5308_Task4</bpmn:flowNodeRef>
