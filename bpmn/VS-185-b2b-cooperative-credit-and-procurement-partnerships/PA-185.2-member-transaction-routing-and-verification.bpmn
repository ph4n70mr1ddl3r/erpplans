      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5306" name="W5306. Cooperative Member Authorization and Purchase Order Match" isExecutable="false">
      <bpmn:documentation>Trigger: Validated member request for high-value materials (&gt; PHP 50,000) using co-op line
Frequency: Daily per high-value member transaction
Volume: ~3,000-4,000 transactions annually
Owner: Customer Service Lead
Participants: Co-op Secretary, Cooperative Member
Source: workflow W5306 — Cooperative Member Authorization and Purchase Order Match</bpmn:documentation>
      <bpmn:laneSet id="W5306_LaneSet2">
        <bpmn:lane id="W5306_Lane1" name="Customer Service Lead">
        <bpmn:flowNodeRef>W5306_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5306_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5306_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5306_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5306_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5306_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5306_Start3" name="Validated member request for high-value materials (&gt; PHP 50,000) using co-op line">
        <bpmn:outgoing>W5306_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5306_Task4" name="Collect cooperative-issued Purchase Order (PO) or Authorization Letter from…">
        <bpmn:documentation>Step 1: Collect cooperative-issued Purchase Order (PO) or Authorization Letter from member.
Responsible (R): Customer Service Lead
Accountable (A): Customer Service Lead
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5306_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5306_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5306_Task5" name="Match PO specifications (material list, budget limit, jobsite address) with POS…">
        <bpmn:documentation>Step 2: Match PO specifications (material list, budget limit, jobsite address) with POS basket items.
Responsible (R): Customer Service Lead
Accountable (A): Customer Service Lead
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W5306_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5306_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5306_Task6" name="Check PO authorization codes and signatories against co-op profile on system.">
        <bpmn:documentation>Step 3: Check PO authorization codes and signatories against co-op profile on system.
Responsible (R): Customer Service Lead
Accountable (A): Customer Service Lead
Duration: 3 min</bpmn:documentation>
        <bpmn:incoming>W5306_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5306_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5306_Task7" name="Scan and attach the PO document to the POS invoice transaction in ERP.">
        <bpmn:documentation>Step 4: Scan and attach the PO document to the POS invoice transaction in ERP.
Responsible (R): Customer Service Lead
Accountable (A): Customer Service Lead
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W5306_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5306_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5306_End8" name="Complete">
        <bpmn:incoming>W5306_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5306_Annotation9">
        <bpmn:text>Controls: - CTL-786: ensure controlled execution — Member Transaction Routing &amp; Verification (PA-185.2). — legal authorization controls; Customer Service Lead PO validation.
Owner: Customer Service Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5306_Assoc10" sourceRef="W5306_Annotation9" targetRef="W5306_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5306_Flow11" sourceRef="W5306_Start3" targetRef="W5306_Task4" />
      <bpmn:sequenceFlow id="W5306_Flow12" sourceRef="W5306_Task4" targetRef="W5306_Task5" />
      <bpmn:sequenceFlow id="W5306_Flow13" sourceRef="W5306_Task5" targetRef="W5306_Task6" />
      <bpmn:sequenceFlow id="W5306_Flow14" sourceRef="W5306_Task6" targetRef="W5306_Task7" />
      <bpmn:sequenceFlow id="W5306_Flow15" sourceRef="W5306_Task7" targetRef="W5306_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5306_diag">
      <bpmndi:BPMNPlane id="W5306_plane" bpmnElement="W_W5306">
        <bpmndi:BPMNShape id="W5306_Lane1_di" bpmnElement="W5306_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
