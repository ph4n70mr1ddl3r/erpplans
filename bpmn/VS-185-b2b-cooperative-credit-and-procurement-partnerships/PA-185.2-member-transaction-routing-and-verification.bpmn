        <bpmn:outgoing>W5311_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5311_Task7" name="Activate credit hold flag in parent ERP account profile.">
        <bpmn:documentation>Step 2: Activate credit hold flag in parent ERP account profile.
Responsible (R): Accounts Receivable Supervisor
Accountable (A): B2B Credit Director
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5311_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5311_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W5311_Task8" name="Trigger automated system lockout of co-op codes across all store POS registers.">
        <bpmn:documentation>Step 3: Trigger automated system lockout of co-op codes across all store POS registers.
Responsible (R): POS System Controller
Accountable (A): B2B Credit Director
Duration: 10 sec</bpmn:documentation>
        <bpmn:incoming>W5311_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5311_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W5311_Task9" name="Send formal delinquency notice detailing unpaid balances to co-op directors.">
        <bpmn:documentation>Step 4: Send formal delinquency notice detailing unpaid balances to co-op directors.
Responsible (R): B2B Credit Director
Accountable (A): B2B Credit Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5311_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5311_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5311_End10" name="Complete">
        <bpmn:incoming>W5311_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5311_Annotation11">
        <bpmn:text>Controls: - CTL-786 (ensure controlled execution — Member Transaction Routing &amp; Verification (PA-185.2).) | - operational: finance risk controls; B2B Credit Director hold release approval.
Owner: B2B Credit Director</bpmn:text>
      </bpmn:textAnnotation>
