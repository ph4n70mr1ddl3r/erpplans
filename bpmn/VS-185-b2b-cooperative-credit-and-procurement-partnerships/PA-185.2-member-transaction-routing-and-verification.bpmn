    <bpmn:process id="W_W5312" name="W5312. Dispute Resolution for Member Unauthorized Purchases" isExecutable="false">
      <bpmn:documentation>Trigger: Cooperative flags transaction as unauthorized or disputes billing
Frequency: Ad-hoc per billing dispute
Volume: ~30-40 disputes annually
Owner: Customer Relations Officer
Participants: Cooperative Member, Accounts Receivable Clerk, Store Manager
Source: workflow W5312 — Dispute Resolution for Member Unauthorized Purchases</bpmn:documentation>
      <bpmn:laneSet id="W5312_LaneSet4">
        <bpmn:lane id="W5312_Lane1" name="Customer Relations Officer">
        <bpmn:flowNodeRef>W5312_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5312_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5312_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5312_Lane2" name="Accounts Receivable Clerk">
        <bpmn:flowNodeRef>W5312_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5312_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W5312_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5312_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5312_Start5" name="Cooperative flags transaction as unauthorized or disputes billing">
        <bpmn:outgoing>W5312_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5312_Task6" name="Receive dispute details: invoice number, disputed items, transaction date…">
        <bpmn:documentation>Step 1: Receive dispute details: invoice number, disputed items, transaction date, co-op member name.
Responsible (R): Customer Relations Officer
Accountable (A): Customer Relations Officer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5312_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5312_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5312_Task7" name="Retrieve transaction records: POS video logs, signature cards, scanned…">
        <bpmn:documentation>Step 2: Retrieve transaction records: POS video logs, signature cards, scanned government IDs, PO attachments.
Responsible (R): Accounts Receivable Clerk
Accountable (A): Customer Relations Officer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5312_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5312_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5312_Task8" name="Conduct review meeting with store manager and co-op officers to present…">
        <bpmn:documentation>Step 3: Conduct review meeting with store manager and co-op officers to present evidence.
Responsible (R): Customer Relations Officer
Accountable (A): Customer Relations Officer
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5312_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5312_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5312_Task9" name="If unauthorized purchase is confirmed due to cashier error, issue credit memo…">
        <bpmn:documentation>Step 4: If unauthorized purchase is confirmed due to cashier error, issue credit memo and update internal controls.
Responsible (R): Store Manager
Accountable (A): Customer Relations Officer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5312_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5312_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5312_End10" name="Complete">
        <bpmn:incoming>W5312_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5312_Annotation11">
        <bpmn:text>Controls: - CTL-20: POS cash/credit accountability; credit memo approval matrix.
Owner: Customer Relations Officer</bpmn:text>
      </bpmn:textAnnotation>
