    <bpmn:process id="W_W5299" name="W5299. Cooperative Development Authority (CDA) Status Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Completed KYC package (W5298)
Frequency: Per cooperative onboarding
Volume: ~20-30 verifications annually
Owner: Compliance Specialist
Participants: CDA Registration Officer, B2B Head of Trade / Account Management
Source: workflow W5299 — Cooperative Development Authority (CDA) Status Verification</bpmn:documentation>
      <bpmn:laneSet id="W5299_LaneSet2">
        <bpmn:lane id="W5299_Lane1" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5299_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5299_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5299_Task6</bpmn:flowNodeRef>
