    <bpmn:process id="W_W5300" name="W5300. Cooperative Financial Performance Review &amp; Balance Sheet Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Validated CDA compliance status (W5299)
Frequency: Per cooperative onboarding
Volume: ~20-30 financial reviews annually
Owner: Credit Analyst
Participants: Cooperative Treasurer, Credit Manager
Source: workflow W5300 — Cooperative Financial Performance Review &amp; Balance Sheet Analysis</bpmn:documentation>
      <bpmn:laneSet id="W5300_LaneSet2">
        <bpmn:lane id="W5300_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W5300_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5300_Task5</bpmn:flowNodeRef>
