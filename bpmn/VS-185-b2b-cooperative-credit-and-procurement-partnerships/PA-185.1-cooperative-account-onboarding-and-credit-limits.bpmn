        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5304_Start4" name="Cooperative account active for 12 months or nearing renewal date">
        <bpmn:outgoing>W5304_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5304_Task5" name="Extract past-year purchase and payment performance: transaction volumes, delay…">
        <bpmn:documentation>Step 1: Extract past-year purchase and payment performance: transaction volumes, delay days, collection issues.
Responsible (R): Credit Analyst
Accountable (A): B2B Credit Director
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5304_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5304_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5304_Task6" name="Request updated audited financial statement and current CDA certificate.">
        <bpmn:documentation>Step 2: Request updated audited financial statement and current CDA certificate.
Responsible (R): Credit Analyst
Accountable (A): B2B Credit Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5304_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5304_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5304_Task7" name="Re-evaluate credit risks; calculate updated credit rating score.">
        <bpmn:documentation>Step 3: Re-evaluate credit risks; calculate updated credit rating score.
Responsible (R): Credit Analyst
Accountable (A): B2B Credit Director
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5304_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5304_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5304_Task8" name="Adjust credit limit in ERP system and sign off on annual renewal agreement.">
        <bpmn:documentation>Step 4: Adjust credit limit in ERP system and sign off on annual renewal agreement.
Responsible (R): B2B Credit Director
Accountable (A): B2B Credit Director
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5304_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5304_Flow16</bpmn:outgoing>
      </bpmn:userTask>
