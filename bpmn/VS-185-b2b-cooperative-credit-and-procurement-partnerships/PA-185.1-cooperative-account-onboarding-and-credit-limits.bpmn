    <bpmn:process id="W_W5298" name="W5298. Cooperative Board Resolution Collection &amp; KYC Vetting" isExecutable="false">
      <bpmn:documentation>Trigger: Cooperative prospect profile created (W5297)
Frequency: Per cooperative onboarding
Volume: ~20-30 onboardings annually
Owner: Compliance Specialist
Participants: Co-op Chairman, Corporate Secretary (VS-100)
Source: workflow W5298 — Cooperative Board Resolution Collection &amp; KYC Vetting</bpmn:documentation>
      <bpmn:laneSet id="W5298_LaneSet3">
        <bpmn:lane id="W5298_Lane1" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5298_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5298_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5298_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5298_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5298_Lane2" name="Corporate Secretary">
        <bpmn:flowNodeRef>W5298_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5298_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5298_Start4" name="Cooperative prospect profile created (W5297)">
        <bpmn:outgoing>W5298_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5298_Task5" name="Collect certified true copy of Cooperative Board Resolution authorizing credit…">
        <bpmn:documentation>Step 1: Collect certified true copy of Cooperative Board Resolution authorizing credit facilities and naming signatories.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5298_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5298_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5298_Task6" name="Obtain KYC documents (valid IDs, photos, signature cards) of authorized co-op…">
        <bpmn:documentation>Step 2: Obtain KYC documents (valid IDs, photos, signature cards) of authorized co-op officers.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5298_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5298_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5298_Task7" name="Review bylaws and article of cooperation to verify borrowing power limits.">
        <bpmn:documentation>Step 3: Review bylaws and article of cooperation to verify borrowing power limits.
Responsible (R): Corporate Secretary
Accountable (A): Compliance Specialist
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5298_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5298_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5298_Task8" name="Log verified KYC documents in legal document vault.">
        <bpmn:documentation>Step 4: Log verified KYC documents in legal document vault.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5298_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5298_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5298_End9" name="Complete">
        <bpmn:incoming>W5298_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5298_Annotation10">
        <bpmn:text>Controls: - CTL-785: regulatory compliance checks; VP Legal &amp; Compliance signature approval.
Owner: Compliance Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5298_Assoc11" sourceRef="W5298_Annotation10" targetRef="W5298_Start4" associationDirection="None" />
