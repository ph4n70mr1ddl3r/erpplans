      <bpmn:startEvent id="W5299_Start3" name="Completed KYC package (W5298)">
        <bpmn:outgoing>W5299_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5299_Task4" name="Access CDA online registry to check status of cooperative registration.">
        <bpmn:documentation>Step 1: Access CDA online registry to check status of cooperative registration.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5299_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5299_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5299_Task5" name="Request current Certificate of Compliance (COC) from cooperative officers.">
        <bpmn:documentation>Step 2: Request current Certificate of Compliance (COC) from cooperative officers.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5299_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5299_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5299_Task6" name="Verify that the cooperative has no pending litigation, cease-and-desist, or…">
        <bpmn:documentation>Step 3: Verify that the cooperative has no pending litigation, cease-and-desist, or dissolution orders.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5299_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5299_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5299_Task7" name="Upload CDA registration records and COC to ERP customer compliance record.">
        <bpmn:documentation>Step 4: Upload CDA registration records and COC to ERP customer compliance record.
Responsible (R): Compliance Specialist
Accountable (A): Compliance Specialist
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5299_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5299_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5299_End8" name="Complete">
        <bpmn:incoming>W5299_Flow15</bpmn:incoming>
      </bpmn:endEvent>
