    <bpmn:process id="W_W5297" name="W5297. Cooperative Partner Account Creation &amp; Initial Contact" isExecutable="false">
      <bpmn:documentation>Trigger: Regional sales team identifies candidate cooperative or cooperative contact request
Frequency: Ad-hoc per candidate co-op
Volume: ~30-40 inquiries annually
Owner: Cooperative Account Manager
Participants: Co-op Board Secretary, Regional Sales Manager
Source: workflow W5297 — Cooperative Partner Account Creation &amp; Initial Contact</bpmn:documentation>
      <bpmn:laneSet id="W5297_LaneSet3">
        <bpmn:lane id="W5297_Lane1" name="Cooperative Account Manager">
        <bpmn:flowNodeRef>W5297_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5297_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5297_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5297_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5297_Lane2" name="Regional Sales Manager">
        <bpmn:flowNodeRef>W5297_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5297_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5297_Start4" name="Regional sales team identifies candidate cooperative or cooperative contact request">
        <bpmn:outgoing>W5297_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5297_Task5" name="Meet with cooperative board representatives to present B2B wholesale pricing…">
        <bpmn:documentation>Step 1: Meet with cooperative board representatives to present B2B wholesale pricing structures.
Responsible (R): Cooperative Account Manager
Accountable (A): Cooperative Account Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5297_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5297_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5297_Task6" name="Collect co-op profiling sheet: membership size, asset size, sector focus.">
        <bpmn:documentation>Step 2: Collect co-op profiling sheet: membership size, asset size, sector focus.
Responsible (R): Cooperative Account Manager
Accountable (A): Cooperative Account Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5297_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5297_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5297_Task7" name="Create cooperative prospect profile in B2B ERP system.">
        <bpmn:documentation>Step 3: Create cooperative prospect profile in B2B ERP system.
Responsible (R): Cooperative Account Manager
Accountable (A): Cooperative Account Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5297_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5297_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5297_Task8" name="Initiate onboarding compliance checklist workflow.">
        <bpmn:documentation>Step 4: Initiate onboarding compliance checklist workflow.
Responsible (R): Regional Sales Manager
Accountable (A): Cooperative Account Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5297_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5297_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5297_End9" name="Complete">
        <bpmn:incoming>W5297_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5297_Annotation10">
        <bpmn:text>Controls: - CTL-785: cooperative compliance check; Sourcing/Head of Trade / Account Management contact validation.
Owner: Cooperative Account Manager</bpmn:text>
      </bpmn:textAnnotation>
