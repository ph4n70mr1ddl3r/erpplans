    <bpmn:process id="W_W5314" name="W5314. Patronage Rebate Calculation &amp; Tier Matching" isExecutable="false">
      <bpmn:documentation>Trigger: Approved Quarterly Consolidated Sales Report (W5313)
Frequency: Quarterly per active cooperative account
Volume: ~80–120 rebate calculations annually
Owner: B2B Head of Trade / Account Management
Participants: Category Manager, Credit Manager
Source: workflow W5314 — Patronage Rebate Calculation &amp; Tier Matching</bpmn:documentation>
      <bpmn:laneSet id="W5314_LaneSet2">
        <bpmn:lane id="W5314_Lane1" name="Credit Manager">
        <bpmn:flowNodeRef>W5314_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5314_Task5</bpmn:flowNodeRef>
