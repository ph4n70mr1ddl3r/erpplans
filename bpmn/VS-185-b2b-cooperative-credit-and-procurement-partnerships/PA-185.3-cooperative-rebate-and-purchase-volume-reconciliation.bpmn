        <bpmn:outgoing>W5314_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5314_Task4" name="Match cooperative net purchase volume against tiered rebate percentage matrix…">
        <bpmn:documentation>Step 1: Match cooperative net purchase volume against tiered rebate percentage matrix in contract.
Responsible (R): Credit Manager
Accountable (A): B2B Head of Trade / Account Management
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5314_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5314_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5314_Task5" name="Compute quarterly rebate values.">
        <bpmn:documentation>Step 2: Compute quarterly rebate values.
Responsible (R): Credit Manager
Accountable (A): B2B Head of Trade / Account Management
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5314_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5314_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5314_Task6" name="Verify that the cooperative has met its contract credit terms.">
        <bpmn:documentation>Step 3: Verify that the cooperative has met its contract credit terms.
Responsible (R): Credit Manager
Accountable (A): B2B Head of Trade / Account Management
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5314_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5314_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5314_Task7" name="Draft Rebate Approval Memo for Head of Trade / Account Management approval.">
        <bpmn:documentation>Step 4: Draft Rebate Approval Memo for Head of Trade / Account Management approval.
Responsible (R): Credit Manager
Accountable (A): B2B Head of Trade / Account Management
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5314_Flow14</bpmn:incoming>
      </bpmn:userTask>
