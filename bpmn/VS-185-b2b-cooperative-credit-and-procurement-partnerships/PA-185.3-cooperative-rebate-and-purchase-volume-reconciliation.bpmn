      <bpmn:startEvent id="W5313_Start4" name="Quarter-end closing cycle">
        <bpmn:outgoing>W5313_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5313_Task5" name="Extract all closed invoice data associated with cooperative parent and child…">
        <bpmn:documentation>Step 1: Extract all closed invoice data associated with cooperative parent and child accounts.
Responsible (R): Financial Analyst
Accountable (A): Chief Accountant
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5313_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5313_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5313_Task6" name="Deduct returned items, cancelled orders, and disputed transactions.">
        <bpmn:documentation>Step 2: Deduct returned items, cancelled orders, and disputed transactions.
Responsible (R): Financial Analyst
Accountable (A): Chief Accountant
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5313_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5313_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5313_Task7" name="Reconcile transaction values against bank receipts and cash collections.">
        <bpmn:documentation>Step 3: Reconcile transaction values against bank receipts and cash collections.
Responsible (R): Financial Analyst
Accountable (A): Chief Accountant
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W5313_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5313_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5313_Task8" name="Compile Quarterly Consolidated Sales Report.">
        <bpmn:documentation>Step 4: Compile Quarterly Consolidated Sales Report.
Responsible (R): Chief Accountant
Accountable (A): Chief Accountant
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5313_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5313_End9" name="Complete">
        <bpmn:incoming>W5313_Flow16</bpmn:incoming>
      </bpmn:endEvent>
