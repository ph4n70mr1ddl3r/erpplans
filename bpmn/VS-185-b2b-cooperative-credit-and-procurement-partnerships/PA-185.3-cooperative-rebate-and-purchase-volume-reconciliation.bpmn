    <bpmn:process id="W_W5313" name="W5313. Quarterly Cooperative Purchase Volume Accumulation Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Quarter-end closing cycle
Frequency: Quarterly per active cooperative account
Volume: ~80–120 account audits annually
Owner: Chief Accountant
Participants: Financial Analyst, Cooperative Finance Officer
Source: workflow W5313 — Quarterly Cooperative Purchase Volume Accumulation Audit</bpmn:documentation>
      <bpmn:laneSet id="W5313_LaneSet3">
        <bpmn:lane id="W5313_Lane1" name="Financial Analyst">
        <bpmn:flowNodeRef>W5313_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5313_Task6</bpmn:flowNodeRef>
