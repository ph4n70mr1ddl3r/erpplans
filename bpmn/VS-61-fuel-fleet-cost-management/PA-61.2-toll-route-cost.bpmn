    <bpmn:process id="W_W2324" name="W2324. Vehicle Maintenance Cost Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly
Frequency: Monthly; ~40 owned vehicles (the 40-truck owned fleet)
Volume: ~25–35 records/month (PM + repairs across the ~40-truck owned fleet)
Owner: Fleet Supervisor
Participants: Finance, VP Supply Chain
Source: workflow W2324 — Vehicle Maintenance Cost Tracking</bpmn:documentation>
      <bpmn:laneSet id="W2324_LaneSet2">
        <bpmn:lane id="W2324_Lane1" name="Fleet Supervisor">
        <bpmn:flowNodeRef>W2324_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2324_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2324_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2324_Start3" name="Monthly">
        <bpmn:outgoing>W2324_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2324_Task4" name="Tracks per-vehicle: scheduled maintenance, unscheduled repairs, accident…">
        <bpmn:documentation>Step 1: Tracks per-vehicle: scheduled maintenance, unscheduled repairs, accident repairs; per-km maintenance cost; Finance includes in TCO; recommends replacement when cost exceeds depreciation savings
Responsible (R): Fleet Supervisor / Finance
Accountable (A): VP Supply Chain
Duration: 4–6 hours/month + 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2324_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2324_End5" name="Complete">
        <bpmn:incoming>W2324_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2324_Annotation6">
        <bpmn:text>Controls: - CTL-178: fleet asset-grade maintenance tracking; operational: VP Supply Chain replacement-decision sign-off
Owner: Fleet Supervisor</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2324_Assoc7" sourceRef="W2324_Annotation6" targetRef="W2324_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2324_Flow8" sourceRef="W2324_Start3" targetRef="W2324_Task4" />
      <bpmn:sequenceFlow id="W2324_Flow9" sourceRef="W2324_Task4" targetRef="W2324_End5" />
    </bpmn:process>
