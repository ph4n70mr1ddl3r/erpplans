    <bpmn:process id="W_W2325" name="W2325. Total Fleet Cost of Ownership Dashboard" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly dashboard
Frequency: Monthly
Volume: 20 owned + 10–15 3PL partners
Owner: VP Supply Chain
Participants: COO
Source: workflow W2325 — Total Fleet Cost of Ownership Dashboard</bpmn:documentation>
      <bpmn:laneSet id="W2325_LaneSet2">
        <bpmn:lane id="W2325_Lane1" name="System">
        <bpmn:flowNodeRef>W2325_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2325_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2325_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2325_Start3" name="Monthly dashboard">
        <bpmn:outgoing>W2325_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2325_Task4" name="Dashboard: total cost (owned + 3PL), per delivery, per km, per peso delivered…">
        <bpmn:documentation>Step 1: Dashboard: total cost (owned + 3PL), per delivery, per km, per peso delivered, fuel %, toll %, maintenance %, insurance %; targets logistics cost at 8–10% of COGS
Responsible (R): System / VP Supply Chain
Accountable (A): COO
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2325_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2325_End5" name="Complete">
        <bpmn:incoming>W2325_Flow9</bpmn:incoming>
      </bpmn:endEvent>
