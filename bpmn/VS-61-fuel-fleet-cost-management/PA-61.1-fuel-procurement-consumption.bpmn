      <bpmn:startEvent id="W2310_Start3" name="Fuel procurement for owned fleet">
        <bpmn:outgoing>W2310_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2310_Task4" name="Manages fuel card program: issues per vehicle, limits per transaction, monitors…">
        <bpmn:documentation>Step 1: Manages fuel card program: issues per vehicle, limits per transaction, monitors patterns, blocks unauthorized; Finance reviews statements, matches mileage, investigates anomalies
Responsible (R): Logistics Manager / Finance
Accountable (A): VP Supply Chain
Duration: 2–3 hours/month + 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2310_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2310_End5" name="Complete">
        <bpmn:incoming>W2310_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2310_Annotation6">
        <bpmn:text>Controls: - CTL-412 (ensure controlled execution — Fuel Procurement &amp; Consumption Management (PA-61.1).) | - operational: fuel-card-change guard — pattern from VS-42; duplicate-transaction guard; operational: Finance monthly reconciliation sign-off
Owner: Logistics Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2310_Assoc7" sourceRef="W2310_Annotation6" targetRef="W2310_Start3" associationDirection="None" />
