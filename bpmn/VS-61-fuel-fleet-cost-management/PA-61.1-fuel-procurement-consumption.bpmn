    <bpmn:process id="W_W2312" name="W2312. Vehicle Fuel Efficiency Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly vehicle review
Frequency: Monthly; ~40 owned vehicles (the 40-truck owned fleet)
Volume: ~40 reports/month (one per owned vehicle)
Owner: Fleet Supervisor
Participants: Logistics Manager
Source: workflow W2312 — Vehicle Fuel Efficiency Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2312_LaneSet2">
        <bpmn:lane id="W2312_Lane1" name="Fleet Supervisor">
        <bpmn:flowNodeRef>W2312_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2312_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2312_End5</bpmn:flowNodeRef>
        </bpmn:lane>
