      </bpmn:startEvent>
      <bpmn:userTask id="W2317_Task4" name="Tops off tanks at warning; activates backup suppliers; prioritizes essential…">
        <bpmn:documentation>Step 1: Tops off tanks at warning; activates backup suppliers; prioritizes essential deliveries; post-event: adjusts schedule to clear backlog; reviews emergency plan
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 4–8 hours + 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2317_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2317_End5" name="Complete">
