    <bpmn:process id="W_W2317" name="W2317. Emergency Fuel Supply Management" isExecutable="false">
      <bpmn:documentation>Trigger: Fuel disruption (typhoon)
Frequency: Ad-hoc; ~1–2/year
Volume: 1–2 events/year
Owner: Logistics Manager
Participants: VP Supply Chain
Source: workflow W2317 — Emergency Fuel Supply Management</bpmn:documentation>
      <bpmn:laneSet id="W2317_LaneSet2">
        <bpmn:lane id="W2317_Lane1" name="Logistics Manager">
