      <bpmn:startEvent id="W2312_Start3" name="Monthly vehicle review">
        <bpmn:outgoing>W2312_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2312_Task4" name="Calculates: liters ÷ km; benchmarks vs. spec; flags &gt;15% deviation…">
        <bpmn:documentation>Step 1: Calculates: liters ÷ km; benchmarks vs. spec; flags &gt;15% deviation; investigates: engine, tires, congestion, driver behavior; schedules maintenance or coaching
Responsible (R): Fleet Supervisor
Accountable (A): Logistics Manager
Duration: 4–6 hours/month + 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2312_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2312_End5" name="Complete">
        <bpmn:incoming>W2312_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2312_Annotation6">
        <bpmn:text>Controls: - CTL-181 (ensure fleet fuel-cost accuracy &amp; fraud prevention.) | - Operational: Fleet Supervisor monthly sign-off; Logistics Manager escalation on chronic deviation
Owner: Fleet Supervisor</bpmn:text>
      </bpmn:textAnnotation>
