      <bpmn:documentation>Trigger: Annual fleet review
Frequency: Annual; evaluate 2–3 replacements
Volume: 20 vehicles
Owner: VP Supply Chain
Participants: Finance, COO
Source: workflow W2315 — Alternative Fuel Vehicle Evaluation</bpmn:documentation>
      <bpmn:laneSet id="W2315_LaneSet2">
        <bpmn:lane id="W2315_Lane1" name="VP Supply Chain">
