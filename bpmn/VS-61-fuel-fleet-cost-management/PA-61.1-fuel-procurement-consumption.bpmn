    <bpmn:process id="W_W2311" name="W2311. Fuel Price Monitoring &amp; Procurement Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly review cycle — Fuel Price Monitoring
Frequency: Weekly; Philippine diesel/gas prices
Volume: ~PHP 2–3M monthly
Owner: Logistics Finance Analyst
Participants: Procurement, Finance Manager
Source: workflow W2311 — Fuel Price Monitoring &amp; Procurement Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2311_LaneSet2">
        <bpmn:lane id="W2311_Lane1" name="Logistics Finance Analyst">
        <bpmn:flowNodeRef>W2311_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2311_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2311_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2311_Start3" name="Weekly review cycle — Fuel Price Monitoring">
        <bpmn:outgoing>W2311_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2311_Task4" name="Monitors DOE weekly prices; identifies optimal stations per route; calculates…">
        <bpmn:documentation>Step 1: Monitors DOE weekly prices; identifies optimal stations per route; calculates delivery cost impact; Procurement negotiates fleet discounts with Petron, Shell, Caltex for volume
Responsible (R): Logistics Finance Analyst / Procurement
Accountable (A): Finance Manager
Duration: 2–3 hours/week + 1–2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2311_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2311_End5" name="Complete">
        <bpmn:incoming>W2311_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2311_Annotation6">
        <bpmn:text>Controls: - CTL-181 (ensure fleet fuel-cost accuracy &amp; fraud prevention.) | - CTL-412 (discount-realization accuracy); operational: Finance Manager quarterly sign-off
Owner: Logistics Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2311_Assoc7" sourceRef="W2311_Annotation6" targetRef="W2311_Start3" associationDirection="None" />
