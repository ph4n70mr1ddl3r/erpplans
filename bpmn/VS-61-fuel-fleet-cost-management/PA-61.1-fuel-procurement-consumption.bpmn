    <bpmn:process id="W_W2310" name="W2310. Fleet Fuel Card Program Management" isExecutable="false">
      <bpmn:documentation>Trigger: Fuel procurement for owned fleet
Frequency: Continuous; ~20 trucks
Volume: ~20 cards; ~PHP 2–3M/month
Owner: Logistics Manager
Participants: Finance, VP Supply Chain
Source: workflow W2310 — Fleet Fuel Card Program Management</bpmn:documentation>
      <bpmn:laneSet id="W2310_LaneSet2">
        <bpmn:lane id="W2310_Lane1" name="Logistics Manager">
        <bpmn:flowNodeRef>W2310_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2310_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2310_End5</bpmn:flowNodeRef>
