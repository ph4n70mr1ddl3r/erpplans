    <bpmn:process id="W_W2316" name="W2316. Fuel Cost Pass-Through to 3PL" isExecutable="false">
      <bpmn:documentation>Trigger: Significant fuel change (&gt;5%)
Frequency: Ad-hoc; ~2–4/year
Volume: ~10–15 partners
Owner: Logistics Manager
Participants: Finance, CFO
Source: workflow W2316 — Fuel Cost Pass-Through to 3PL</bpmn:documentation>
      <bpmn:laneSet id="W2316_LaneSet2">
        <bpmn:lane id="W2316_Lane1" name="Logistics Manager">
