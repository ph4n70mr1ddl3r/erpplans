        <bpmn:outgoing>W2315_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2315_Task4" name="Evaluates: EV for short-range, hybrid for medium, LPG/CNG for high-volume…">
        <bpmn:documentation>Step 1: Evaluates: EV for short-range, hybrid for medium, LPG/CNG for high-volume; Finance calculates TCO: acquisition, fuel savings, maintenance, charging, incentives; recommends pilot if positive ROI
Responsible (R): VP Supply Chain / Finance
Accountable (A): COO
Duration: 3–5 days + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2315_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2315_End5" name="Complete">
