      <bpmn:userTask id="W4446_Task5" name="Frontend/Store log the fault (terminal/scale/recycler/camera/software) via…">
        <bpmn:documentation>Step 1: Frontend/Store log the fault (terminal/scale/recycler/camera/software) via service desk (VS-27.1), take the unit out of service, and re-route customers
Responsible (R): Frontend / Store Ops
Accountable (A): Store Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W4446_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4446_Flow11</bpmn:outgoing>
      </bpmn:userTask>
