    <bpmn:process id="W_W4441" name="W4441. SCO &amp; Scan-&amp;-Go Lane Daily Open/Close &amp; Staffing" isExecutable="false">
      <bpmn:documentation>Trigger: Store open/close; shift
Frequency: Daily per store
Volume: 200 stores × 2 (open/close)/day
Owner: Frontend Supervisor (VS-08) / Store Ops (VS-07)
Participants: Store Ops (VS-07), Frontend (VS-08), Cashiers/Attendants, IFM (VS-138), IT (VS-27)
Source: workflow W4441 — SCO &amp; Scan-&amp;-Go Lane Daily Open/Close &amp; Staffing</bpmn:documentation>
      <bpmn:laneSet id="W4441_LaneSet2">
        <bpmn:lane id="W4441_Lane1" name="Frontend Supervisor">
        <bpmn:flowNodeRef>W4441_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4441_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4441_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4441_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4441_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4441_Start3" name="Store open/close; shift">
        <bpmn:outgoing>W4441_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4441_Task4" name="Frontend open the SCO pod — terminal boot/health check, scale/calibration check…">
        <bpmn:documentation>Step 1: Frontend open the SCO pod — terminal boot/health check, scale/calibration check (VS-115), cash-recycler load/float (W4445), signage, and attendant station setup
Responsible (R): Frontend Supervisor / Attendant
Accountable (A): Store Manager
Duration: ~20–30 min/open</bpmn:documentation>
        <bpmn:incoming>W4441_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4441_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4441_Task5" name="Frontend staff the pod — attendant ratio (1:4–6 SCO), intervention-ready…">
        <bpmn:documentation>Step 2: Frontend staff the pod — attendant ratio (1:4–6 SCO), intervention-ready, monitoring; open/close scan-&amp;-go &amp; unattended formats per W4439
Responsible (R): Frontend Supervisor
Accountable (A): Store Manager
Duration: Per shift</bpmn:documentation>
        <bpmn:incoming>W4441_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4441_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4441_Task6" name="Frontend close the pod — cash-recycler pull/reconcile (W4445), transaction…">
        <bpmn:documentation>Step 3: Frontend close the pod — cash-recycler pull/reconcile (W4445), transaction settlement, terminal close, and exception handoff (W4450)
Responsible (R): Frontend Supervisor / Attendant
Accountable (A): Store Manager
Duration: ~20–30 min/close</bpmn:documentation>
        <bpmn:incoming>W4441_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4441_End7" name="Complete">
        <bpmn:incoming>W4441_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4441_Annotation8">
        <bpmn:text>Controls: - CTL-678 (ensure controlled execution — SCO &amp; Scan-&amp;-Go Daily Operations &amp; Customer Experience (PA-149.2).) | - CTL-678: terminal health &amp; calibration checked at open; cash-recycler loaded/reconciled; attendant ratio met; exceptions handed off
Owner: Frontend Supervisor (VS-08) / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4441_Assoc9" sourceRef="W4441_Annotation8" targetRef="W4441_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4441_Flow10" sourceRef="W4441_Start3" targetRef="W4441_Task4" />
      <bpmn:sequenceFlow id="W4441_Flow11" sourceRef="W4441_Task4" targetRef="W4441_Task5" />
      <bpmn:sequenceFlow id="W4441_Flow12" sourceRef="W4441_Task5" targetRef="W4441_Task6" />
      <bpmn:sequenceFlow id="W4441_Flow13" sourceRef="W4441_Task6" targetRef="W4441_End7" />
    </bpmn:process>
