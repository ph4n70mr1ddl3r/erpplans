    <bpmn:process id="W_W4444" name="W4444. Scan-&amp;-Go Mobile App Session &amp; Checkout Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer scan-&amp;-go session (W4436)
Frequency: Continuous (per scan-&amp;-go session)
Volume: Scan-&amp;-go sessions (share of ecommerce/app traffic VS-75)
Owner: App/Ecommerce (VS-75/VS-10) / Frontend (VS-08)
Participants: App (VS-75), Frontend (VS-08), IT (VS-27), LP (VS-23), Loyalty (VS-13), Payment (VS-80)
Source: workflow W4444 — Scan-&amp;-Go Mobile App Session &amp; Checkout Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W4444_LaneSet3">
        <bpmn:lane id="W4444_Lane1" name="App">
        <bpmn:flowNodeRef>W4444_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4444_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4444_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4444_Lane2" name="Frontend">
        <bpmn:flowNodeRef>W4444_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4444_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4444_Start4" name="Customer scan-&amp;-go session (W4436)">
        <bpmn:outgoing>W4444_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4444_Task5" name="Customer scans items via app/handheld (W4436), sees running total…">
        <bpmn:documentation>Step 1: Customer scans items via app/handheld (W4436), sees running total (price/promo/tax real-time), and pays in-app (VS-80) or at exit-kiosk
Responsible (R): App / Customer
Accountable (A): App Lead
Duration: Per session</bpmn:documentation>
        <bpmn:incoming>W4444_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4444_Flow11</bpmn:outgoing>
      </bpmn:userTask>
