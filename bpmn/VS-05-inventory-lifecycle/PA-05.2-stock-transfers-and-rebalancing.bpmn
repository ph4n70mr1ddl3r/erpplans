    <bpmn:process id="W_W214" name="W214. Store-to-Store Expedited Transfers (Customer-Initiated)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests an out-of-stock item at Store A that is in stock at Store B
Frequency: Daily
Volume: ~20–30 customer-initiated transfers per day
Owner: Store Manager (Store A)
Participants: Sales Associate, Store Manager B, 3PL Courier, Customer
Source: workflow W214 — Store-to-Store Expedited Transfers (Customer-Initiated)</bpmn:documentation>
      <bpmn:laneSet id="W214_LaneSet6">
        <bpmn:lane id="W214_Lane1" name="Sales Associate">
        <bpmn:flowNodeRef>W214_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W214_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W214_Task14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W214_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W214_Lane2" name="System">
        <bpmn:flowNodeRef>W214_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W214_Lane3" name="Stock Associate B">
        <bpmn:flowNodeRef>W214_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W214_Lane4" name="Store Manager B">
        <bpmn:flowNodeRef>W214_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W214_Lane5" name="Courier">
        <bpmn:flowNodeRef>W214_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W214_End15</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W214_Start7" name="Customer requests an out-of-stock item at Store A that is in stock at Store B">
        <bpmn:outgoing>W214_Flow18</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W214_Task8" name="Inquiry">
        <bpmn:documentation>Step 1: Inquiry: Customer requests an out-of-stock item at Store A. Sales Associate checks real-time inventory in ERP and finds stock available at nearby Store B.
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W214_Flow18</bpmn:incoming>
        <bpmn:outgoing>W214_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W214_Task9" name="Order &amp; Payment">
        <bpmn:documentation>Step 2: Order &amp; Payment: Sales Associate offers to have the item transferred from Store B via expedited courier. Customer agrees and pays for the item (plus optional transfer fee) at Store A; system generates a &quot;Customer-Initiated Transfer Order&quot; with status &quot;Awaiting Pickup&quot;.
Responsible (R): Sales Associate
Accountable (A): Store Manager A
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W214_Flow19</bpmn:incoming>
        <bpmn:outgoing>W214_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W214_Task10" name="Notification">
        <bpmn:documentation>Step 3: Notification: System automatically routes a high-priority pick task to Store B&#x27;s terminal/handheld.
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W214_Flow20</bpmn:incoming>
        <bpmn:outgoing>W214_Flow21</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W214_Task11" name="Pick &amp; Pack">
        <bpmn:documentation>Step 4: Pick &amp; Pack: Store B Stock Associate picks the item, places it in secure packaging, and prints an transfer label with Store A&#x27;s order number and Customer details.
Responsible (R): Stock Associate B
Accountable (A): Store Manager B
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W214_Flow21</bpmn:incoming>
        <bpmn:outgoing>W214_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W214_Task12" name="Dispatch">
        <bpmn:documentation>Step 5: Dispatch: Store B books a local 3PL courier (Lalamove/Grab/Transportify) via ERP integration to transport the item to Store A.
Responsible (R): Store Manager B
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W214_Flow22</bpmn:incoming>
        <bpmn:outgoing>W214_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W214_Task13" name="Transit &amp; Arrival">
        <bpmn:documentation>Step 6: Transit &amp; Arrival: 3PL Courier transports item to Store A. Store A Receiving Clerk receives it in the system; ERP automatically triggers an SMS/email to the Customer (&quot;Your order is ready for pickup!&quot;).
Responsible (R): Courier / Store A Clerk
Accountable (A): Store Manager A
Duration: 1–3 hours</bpmn:documentation>
        <bpmn:incoming>W214_Flow23</bpmn:incoming>
        <bpmn:outgoing>W214_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W214_Task14" name="Customer Collection">
        <bpmn:documentation>Step 7: Customer Collection: Customer arrives at Store A Pro Desk; Sales Associate scan-confirms collection and closes the transfer order.
Responsible (R): Sales Associate
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W214_Flow24</bpmn:incoming>
        <bpmn:outgoing>W214_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W214_End15" name="Complete">
        <bpmn:incoming>W214_Flow25</bpmn:incoming>
      </bpmn:endEvent>
