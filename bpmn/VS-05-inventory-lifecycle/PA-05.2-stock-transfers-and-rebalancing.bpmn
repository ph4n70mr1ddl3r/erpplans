      <bpmn:sequenceFlow id="W22_Flow26" sourceRef="W22_Task13" targetRef="W22_Task14" />
      <bpmn:sequenceFlow id="W22_Flow27" sourceRef="W22_Task14" targetRef="W22_Task15" />
      <bpmn:sequenceFlow id="W22_Flow28" sourceRef="W22_Task15" targetRef="W22_Task16" />
      <bpmn:sequenceFlow id="W22_Flow29" sourceRef="W22_Task16" targetRef="W22_Task17" />
