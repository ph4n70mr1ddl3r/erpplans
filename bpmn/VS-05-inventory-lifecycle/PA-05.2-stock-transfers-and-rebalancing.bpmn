    <bpmn:process id="W_W218" name="W218. Inter-DC Stock Rebalancing (Stock Push)" isExecutable="false">
      <bpmn:documentation>Trigger: Supply planning identifies &quot;Overstock&quot; in one DC and &quot;Stock-out Risk&quot; in another
Frequency: Monthly; or as needed for peak seasons
Volume: Bulk pallet transfers
Owner: Supply Planning Manager
Participants: Supply Planner, DC Managers, Logistics (3PL Carrier)
Source: workflow W218 — Inter-DC Stock Rebalancing (Stock Push)</bpmn:documentation>
      <bpmn:laneSet id="W218_LaneSet8">
        <bpmn:lane id="W218_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W218_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W218_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane2" name="System">
        <bpmn:flowNodeRef>W218_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W218_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane4" name="DC Picker">
        <bpmn:flowNodeRef>W218_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane5" name="Driver">
        <bpmn:flowNodeRef>W218_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane6" name="Receiving Clerk">
        <bpmn:flowNodeRef>W218_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W218_Lane7" name="Supply Planning Mgr">
        <bpmn:flowNodeRef>W218_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W218_End17</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W218_Start9" name="Supply planning identifies &quot;Overstock&quot; in one DC and &quot;Stock-out Risk&quot; in another">
        <bpmn:outgoing>W218_Flow20</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W218_Task10" name="Imbalance Detection">
        <bpmn:documentation>Step 1: Imbalance Detection: Supply Planner reviews &quot;DC-to-DC Inventory Health&quot; report; identifies SKUs where current DC stock &gt; 6 months cover vs. &lt; 2 weeks at another DC
Responsible (R): Supply Planner
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W218_Flow20</bpmn:incoming>
        <bpmn:outgoing>W218_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W218_Task11" name="Transfer Proposal">
        <bpmn:documentation>Step 2: Transfer Proposal: System suggests &quot;Rebalancing Transfer&quot; (Push) to move bulk stock to the understocked DC
Responsible (R): System / Planner
Accountable (A): Supply Planning Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W218_Flow21</bpmn:incoming>
        <bpmn:outgoing>W218_Flow22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W218_Task12" name="Fulfillment Booking">
        <bpmn:documentation>Step 3: Fulfillment Booking: Logistics books heavy-duty transport (tractor head / 10-wheeler) for the bulk move
Responsible (R): Logistics
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W218_Flow22</bpmn:incoming>
        <bpmn:outgoing>W218_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W218_Task13" name="Loading">
        <bpmn:documentation>Step 4: Loading: Source DC picks from bulk storage; system verifies quantities via WMS (W3)
Responsible (R): DC Picker
Accountable (A): DC Supervisor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W218_Flow23</bpmn:incoming>
        <bpmn:outgoing>W218_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W218_Task14" name="Transit">
        <bpmn:documentation>Step 5: Transit: Bulk shipment moves between DCs; system tracks &quot;In-Transit&quot; at WAC
Responsible (R): Driver
Accountable (A): —
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W218_Flow24</bpmn:incoming>
        <bpmn:outgoing>W218_Flow25</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W218_Task15" name="Receipt">
        <bpmn:documentation>Step 6: Receipt: Destination DC processes bulk GR; inventory available for sale immediately
Responsible (R): Receiving Clerk
Accountable (A): DC Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W218_Flow25</bpmn:incoming>
        <bpmn:outgoing>W218_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W218_Task16" name="Efficiency Audit">
        <bpmn:documentation>Step 7: Efficiency Audit: Review total freight cost vs. margin preserved by avoiding stock-outs
Responsible (R): Supply Planning Mgr
Accountable (A): —
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W218_Flow26</bpmn:incoming>
        <bpmn:outgoing>W218_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W218_End17" name="Complete">
        <bpmn:incoming>W218_Flow27</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W218_Annotation18">
        <bpmn:text>Controls: - CTL-254 (ensure controlled execution — Stock Transfers &amp; Rebalancing (PA-05.2).) | - operational: Supply Planning Manager review and approval gate
Owner: Supply Planning Manager</bpmn:text>
      </bpmn:textAnnotation>
