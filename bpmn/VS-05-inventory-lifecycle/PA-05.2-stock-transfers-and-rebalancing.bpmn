<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-05.2-stock-transfers-and-rebalancing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W22" name="W22. Stock Transfers (Store-to-Store &amp; Inter-DC)" isExecutable="false">
      <bpmn:documentation>Trigger: Stock imbalance between locations; emergency need; inter-DC rebalancing
Frequency: ~30–40 inter-DC transfers/month; ~700–1,300 store-to-store transfers/month (W204 customer-transfers ~50–100/week + W214 inter-store ~20–30/day)
Volume: Variable (typically 5–20 lines per transfer)
Owner: Supply Planner (inter-DC); Store Manager (store-to-store)
Participants: Supply Planner, Store Manager, Receiving Clerk, Stock Associate, DC Picker
Source: workflow W22 — Stock Transfers (Store-to-Store &amp; Inter-DC)</bpmn:documentation>
      <bpmn:laneSet id="W22_LaneSet8">
        <bpmn:lane id="W22_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W22_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22_Start9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane2" name="Requestor">
        <bpmn:flowNodeRef>W22_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane3" name="System">
        <bpmn:flowNodeRef>W22_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22_Task17</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane4" name="Approver">
        <bpmn:flowNodeRef>W22_Task13</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane5" name="Picker">
        <bpmn:flowNodeRef>W22_Task14</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane6" name="Shipper">
        <bpmn:flowNodeRef>W22_Task15</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22_Lane7" name="Receiving Clerk">
        <bpmn:flowNodeRef>W22_Task16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22_Task18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22_End19</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W22_Start9" name="Stock imbalance between locations; emergency need; inter-DC rebalancing">
        <bpmn:outgoing>W22_Flow22</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W22_Task10" name="Requestor identifies transfer need (stock-out risk, excess inventory…">
        <bpmn:documentation>Step 1: Requestor identifies transfer need (stock-out risk, excess inventory, rebalancing)
Responsible (R): Supply Planner / Store Manager
Accountable (A): Supply Planning Mgr / Regional Mgr
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow22</bpmn:incoming>
        <bpmn:outgoing>W22_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22_Task11" name="Requestor creates Transfer Order in system: source location, destination…">
        <bpmn:documentation>Step 2: Requestor creates Transfer Order in system: source location, destination, items, quantities
Responsible (R): Requestor
Accountable (A): —
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow23</bpmn:incoming>
        <bpmn:outgoing>W22_Flow24</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W22_Task12" name="System checks availability at source location; confirms or flags shortage">
        <bpmn:documentation>Step 3: System checks availability at source location; confirms or flags shortage
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W22_Flow24</bpmn:incoming>
        <bpmn:outgoing>W22_Flow25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W22_Task13" name="Approval: inter-DC → Supply Planning Manager; store-to-store → Regional Manager">
        <bpmn:documentation>Step 4: Approval: inter-DC → Supply Planning Manager; store-to-store → Regional Manager
Responsible (R): Approver
Accountable (A): Approver
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow25</bpmn:incoming>
        <bpmn:outgoing>W22_Flow26</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22_Task14" name="Source location picks items (DC: WMS pick; Store: Stock Associate picks from…">
        <bpmn:documentation>Step 5: Source location picks items (DC: WMS pick; Store: Stock Associate picks from shelf)
Responsible (R): Picker / Stock Associate
Accountable (A): DC Supervisor / Store Manager
Duration: 15–60 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow26</bpmn:incoming>
        <bpmn:outgoing>W22_Flow27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22_Task15" name="Items packed and shipped; system creates in-transit inventory">
        <bpmn:documentation>Step 6: Items packed and shipped; system creates in-transit inventory
Responsible (R): Shipper / Driver
Accountable (A): DC Supervisor / Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow27</bpmn:incoming>
        <bpmn:outgoing>W22_Flow28</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22_Task16" name="Destination location receives items; scans against Transfer Order">
        <bpmn:documentation>Step 7: Destination location receives items; scans against Transfer Order
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor / Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W22_Flow28</bpmn:incoming>
        <bpmn:outgoing>W22_Flow29</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W22_Task17" name="System updates: source inventory decreases, in-transit clears, destination…">
        <bpmn:documentation>Step 8: System updates: source inventory decreases, in-transit clears, destination inventory increases
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W22_Flow29</bpmn:incoming>
        <bpmn:outgoing>W22_Flow30</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W22_Task18" name="If discrepancy at destination: flag in system; source location notified for…">
        <bpmn:documentation>Step 9: If discrepancy at destination: flag in system; source location notified for investigation
Responsible (R): Receiving Clerk
Accountable (A): DC Supervisor / Store Manager
Duration: 5 min if any</bpmn:documentation>
        <bpmn:incoming>W22_Flow30</bpmn:incoming>
        <bpmn:outgoing>W22_Flow31</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W22_End19" name="Complete">
        <bpmn:incoming>W22_Flow31</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W22_Annotation20">
        <bpmn:text>Controls: (none recorded)
Owner: Supply Planner (inter-DC); Store Manager (store-to-store)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W22_Assoc21" sourceRef="W22_Annotation20" targetRef="W22_Start9" associationDirection="None" />
      <bpmn:sequenceFlow id="W22_Flow22" sourceRef="W22_Start9" targetRef="W22_Task10" />
