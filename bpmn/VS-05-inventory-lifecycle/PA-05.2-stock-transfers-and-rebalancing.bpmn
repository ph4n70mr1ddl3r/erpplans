    <bpmn:process id="W_W154" name="W154. Proactive Store Inventory Rebalancing (Stock Push)" isExecutable="false">
      <bpmn:documentation>Trigger: High inventory variance between stores; slow-mover identification (W1); or localized demand spike
Frequency: Monthly
Volume: ~500–1,000 SKUs rebalanced per cycle
Owner: Supply Planning Manager
Participants: Supply Planner, Store Managers, Logistics
Source: workflow W154 — Proactive Store Inventory Rebalancing (Stock Push)</bpmn:documentation>
      <bpmn:laneSet id="W154_LaneSet4">
        <bpmn:lane id="W154_Lane1" name="Supply Planner">
        <bpmn:flowNodeRef>W154_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W154_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W154_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W154_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W154_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W154_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W154_Lane3" name="Logistics">
        <bpmn:flowNodeRef>W154_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W154_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W154_Start5" name="High inventory variance between stores; slow-mover identification (W1); or localized…">
        <bpmn:outgoing>W154_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W154_Task6" name="Analysis">
        <bpmn:documentation>Step 1: Analysis: Identify SKUs with &quot;Overstock&quot; at Store A and &quot;Understock/High Velocity&quot; at Store B
Responsible (R): Supply Planner
Accountable (A): Supply Planning Mgr
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W154_Flow14</bpmn:incoming>
        <bpmn:outgoing>W154_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W154_Task7" name="Validation">
        <bpmn:documentation>Step 2: Validation: Store Managers confirm physical stock availability and condition for transfer
Responsible (R): Store Manager
Accountable (A): —
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W154_Flow15</bpmn:incoming>
        <bpmn:outgoing>W154_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W154_Task8" name="Push Order">
        <bpmn:documentation>Step 3: Push Order: System generates &quot;Push&quot; Stock Transfers (W22); overrides standard ROP to clear excess
Responsible (R): Supply Planner
Accountable (A): Supply Planning Mgr
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W154_Flow16</bpmn:incoming>
        <bpmn:outgoing>W154_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W154_Task9" name="Logistics">
        <bpmn:documentation>Step 4: Logistics: Consolidate transfers into weekly DC-to-Store backhaul or store-to-store courier
Responsible (R): Logistics
Accountable (A): —
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W154_Flow17</bpmn:incoming>
        <bpmn:outgoing>W154_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W154_Task10" name="Impact Review">
        <bpmn:documentation>Step 5: Impact Review: Measure sales lift at receiving store and holding cost reduction at sending store
Responsible (R): Supply Planner
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W154_Flow18</bpmn:incoming>
        <bpmn:outgoing>W154_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W154_End11" name="Complete">
        <bpmn:incoming>W154_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W154_Annotation12">
        <bpmn:text>Controls: - CTL-254 (ensure controlled execution — Stock Transfers &amp; Rebalancing (PA-05.2).) | - operational: Supply Planning Manager review and approval gate
Owner: Supply Planning Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W154_Assoc13" sourceRef="W154_Annotation12" targetRef="W154_Start5" associationDirection="None" />
