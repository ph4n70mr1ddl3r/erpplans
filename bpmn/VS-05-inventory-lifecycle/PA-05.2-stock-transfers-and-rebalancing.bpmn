    <bpmn:process id="W_W22A" name="W22A. Store-Level Outbound Transfer Fulfillment" isExecutable="false">
      <bpmn:documentation>Source: workflow W22A — Store-Level Outbound Transfer Fulfillment</bpmn:documentation>
      <bpmn:laneSet id="W22A_LaneSet4">
        <bpmn:lane id="W22A_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W22A_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22A_Lane2" name="Driver">
        <bpmn:flowNodeRef>W22A_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W22A_Lane3" name="System">
        <bpmn:flowNodeRef>W22A_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W22A_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W22A_Start5" name="Trigger">
        <bpmn:outgoing>W22A_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W22A_Task6" name="Store Manager or Dept. Supervisor receives transfer pick list on…">
        <bpmn:documentation>Step 1: Store Manager or Dept. Supervisor receives transfer pick list on handheld/terminal from approved Transfer Order
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W22A_Flow16</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22A_Task7" name="Stock Associate picks items from sales floor or backroom per pick list…">
        <bpmn:documentation>Step 2: Stock Associate picks items from sales floor or backroom per pick list; scan-confirms each item using handheld barcode scanner; system validates scanned SKU and quantity against Transfer Order
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 15–45 min</bpmn:documentation>
        <bpmn:incoming>W22A_Flow17</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22A_Task8" name="If item not found or short: Stock Associate enters actual quantity picked…">
        <bpmn:documentation>Step 3: If item not found or short: Stock Associate enters actual quantity picked; system updates Transfer Order with partial quantity and notifies destination store
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W22A_Flow18</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22A_Task9" name="Stock Associate packs items in available shipping cartons or bags; labels each…">
        <bpmn:documentation>Step 4: Stock Associate packs items in available shipping cartons or bags; labels each package with destination store name, Transfer Order number, and item count
Responsible (R): Stock Associate
Accountable (A): Dept. Supervisor
Duration: 10–20 min</bpmn:documentation>
        <bpmn:incoming>W22A_Flow19</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22A_Task10" name="Dispatch options">
        <bpmn:documentation>Step 5: Dispatch options: (a) DC truck backhaul (preferred): items ride on the next DC delivery truck returning from this store — Stock Associate stages packed items at receiving dock for driver pickup; (b) Own fleet or 3PL: if urgent or no DC truck scheduled within 2 days, Fleet Manager or DC Dispatch arranges separate pickup; (c) Inter-store courier: for same-city transfers, Store Manager may arrange direct courier delivery
Responsible (R): Stock Associate / Driver
Accountable (A): Store Manager
Duration: 5–10 min staging</bpmn:documentation>
        <bpmn:incoming>W22A_Flow20</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W22A_Task11" name="Driver or carrier confirms pickup by scanning transfer shipment barcode on…">
        <bpmn:documentation>Step 6: Driver or carrier confirms pickup by scanning transfer shipment barcode on handheld; system updates Transfer Order status to &quot;Shipped&quot; and creates in-transit inventory
Responsible (R): Driver / Carrier
Accountable (A): Store Manager
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W22A_Flow21</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W22A_Task12" name="System deducts picked items from source store inventory at shipment confirmation">
        <bpmn:documentation>Step 7: System deducts picked items from source store inventory at shipment confirmation
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W22A_Flow22</bpmn:incoming>
        <bpmn:outgoing>W22A_Flow23</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W22A_End13" name="Complete">
        <bpmn:incoming>W22A_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W22A_Annotation14">
        <bpmn:text>Controls: - CTL-25 (safeguard inventory in transit.) | - operational: threshold</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W22A_Assoc15" sourceRef="W22A_Annotation14" targetRef="W22A_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W22A_Flow16" sourceRef="W22A_Start5" targetRef="W22A_Task6" />
      <bpmn:sequenceFlow id="W22A_Flow17" sourceRef="W22A_Task6" targetRef="W22A_Task7" />
      <bpmn:sequenceFlow id="W22A_Flow18" sourceRef="W22A_Task7" targetRef="W22A_Task8" />
      <bpmn:sequenceFlow id="W22A_Flow19" sourceRef="W22A_Task8" targetRef="W22A_Task9" />
      <bpmn:sequenceFlow id="W22A_Flow20" sourceRef="W22A_Task9" targetRef="W22A_Task10" />
      <bpmn:sequenceFlow id="W22A_Flow21" sourceRef="W22A_Task10" targetRef="W22A_Task11" />
      <bpmn:sequenceFlow id="W22A_Flow22" sourceRef="W22A_Task11" targetRef="W22A_Task12" />
      <bpmn:sequenceFlow id="W22A_Flow23" sourceRef="W22A_Task12" targetRef="W22A_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W22A_diag">
      <bpmndi:BPMNPlane id="W22A_plane" bpmnElement="W_W22A">
        <bpmndi:BPMNShape id="W22A_Lane1_di" bpmnElement="W22A_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W22A_Lane2_di" bpmnElement="W22A_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W22A_Lane3_di" bpmnElement="W22A_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1790" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W22A_Task6_di" bpmnElement="W22A_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
