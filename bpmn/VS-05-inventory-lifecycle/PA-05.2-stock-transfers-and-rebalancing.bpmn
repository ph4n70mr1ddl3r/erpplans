    <bpmn:process id="W_W204" name="W204. Regional Stock Rebalancing &amp; Inter-Store Expedited Transfers" isExecutable="false">
      <bpmn:documentation>Trigger: Critical stock-out at Store A; excess stock of same SKU at Store B (within same region/cluster)
Frequency: Weekly
Volume: ~50–100 transfers per week
Owner: Regional Store Operations Manager
Participants: Store Managers, Supply Planner, Local Courier (3PL)
Source: workflow W204 — Regional Stock Rebalancing &amp; Inter-Store Expedited Transfers</bpmn:documentation>
      <bpmn:laneSet id="W204_LaneSet6">
        <bpmn:lane id="W204_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W204_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W204_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W204_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W204_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W204_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W204_Lane3" name="Stock Associate">
        <bpmn:flowNodeRef>W204_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W204_Lane4" name="Logistics">
        <bpmn:flowNodeRef>W204_Task12</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W204_Lane5" name="Receiving Clerk">
        <bpmn:flowNodeRef>W204_Task13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W204_End14</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W204_Start7" name="Critical stock-out at Store A; excess stock of same SKU at Store B (within same…">
        <bpmn:outgoing>W204_Flow17</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W204_Task8" name="Opportunity Identification">
        <bpmn:documentation>Step 1: Opportunity Identification: Store A Manager identifies &quot;Sold Out&quot; status for high-demand SKU; checks &quot;Regional Inventory&quot; in real-time system (W5)
Responsible (R): Store Manager
Accountable (A): —
Duration: 5 min</bpmn:documentation>
        <bpmn:incoming>W204_Flow17</bpmn:incoming>
        <bpmn:outgoing>W204_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W204_Task9" name="Transfer Request">
        <bpmn:documentation>Step 2: Transfer Request: Store A Manager initiates an &quot;Expedited Transfer Request&quot; from Store B (nearest location with &gt; 2 weeks cover)
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 min</bpmn:documentation>
        <bpmn:incoming>W204_Flow18</bpmn:incoming>
        <bpmn:outgoing>W204_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W204_Task10" name="Approval">
        <bpmn:documentation>Step 3: Approval: Regional Manager or Supply Planner approves based on regional inventory health and cost of transfer vs. margin
Responsible (R): Regional Manager
Accountable (A): —
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W204_Flow19</bpmn:incoming>
        <bpmn:outgoing>W204_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W204_Task11" name="Pick &amp; Stage">
        <bpmn:documentation>Step 4: Pick &amp; Stage: Store B Staff picks and stages items in backroom; system records &quot;In-Transit&quot; status (W22)
Responsible (R): Stock Associate
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W204_Flow20</bpmn:incoming>
        <bpmn:outgoing>W204_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W204_Task12" name="Expedited Dispatch">
        <bpmn:documentation>Step 5: Expedited Dispatch: Local 3PL (Lalamove/Transportify) picks up from Store B; delivers to Store A within 4-8 hours
Responsible (R): Logistics
Accountable (A): —
Duration: 4-8 hours</bpmn:documentation>
        <bpmn:incoming>W204_Flow21</bpmn:incoming>
        <bpmn:outgoing>W204_Flow22</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W204_Task13" name="Receipt">
        <bpmn:documentation>Step 6: Receipt: Store A Receiving Clerk processes Goods Receipt; inventory available for sale immediately
Responsible (R): Receiving Clerk
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W204_Flow22</bpmn:incoming>
        <bpmn:outgoing>W204_Flow23</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W204_End14" name="Complete">
        <bpmn:incoming>W204_Flow23</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W204_Annotation15">
        <bpmn:text>Controls: - CTL-254 (ensure controlled execution — Stock Transfers &amp; Rebalancing (PA-05.2).) | - operational: Regional Store Operations Manager review and approval gate
Owner: Regional Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W204_Assoc16" sourceRef="W204_Annotation15" targetRef="W204_Start7" associationDirection="None" />
      <bpmn:sequenceFlow id="W204_Flow17" sourceRef="W204_Start7" targetRef="W204_Task8" />
