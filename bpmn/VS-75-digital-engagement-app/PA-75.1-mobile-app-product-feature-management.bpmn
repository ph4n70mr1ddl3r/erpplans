    <bpmn:process id="W_W2648" name="W2648. Mobile App Push Notification Strategy &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Marketing campaign or event trigger
Frequency: Daily; ~5–10 campaigns/week
Volume: ~300K app users
Owner: Marketing Digital Manager
Participants: Marketing Digital Mgr, Digital Product Manager, CRM
Source: workflow W2648 — Mobile App Push Notification Strategy &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W2648_LaneSet2">
        <bpmn:lane id="W2648_Lane1" name="Marketing Digital Manager">
        <bpmn:flowNodeRef>W2648_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2648_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2648_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2648_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2648_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2648_Start3" name="Marketing campaign or event trigger">
        <bpmn:outgoing>W2648_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2648_Task4" name="Marketing Digital Manager designs push strategy: promotional (sales)…">
        <bpmn:documentation>Step 1: Marketing Digital Manager designs push strategy: promotional (sales), transactional (BOPIS, delivery), engagement (loyalty, cart), informational (store hours, typhoon)
Responsible (R): Marketing Digital Manager
Accountable (A): CMO
Duration: Weekly planning</bpmn:documentation>
        <bpmn:incoming>W2648_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2648_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2648_Task5" name="Manager configures: audience segmentation, personalization, timing optimization…">
        <bpmn:documentation>Step 2: Manager configures: audience segmentation, personalization, timing optimization (10AM, 7PM), frequency capping (max 2/day)
Responsible (R): Marketing Digital Manager
Accountable (A): CMO
Duration: Per campaign</bpmn:documentation>
        <bpmn:incoming>W2648_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2648_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2648_Task6" name="Manager analyzes performance: open rate (&gt;15%), CTR (&gt;5%), conversion (&gt;2%)…">
        <bpmn:documentation>Step 3: Manager analyzes performance: open rate (&gt;15%), CTR (&gt;5%), conversion (&gt;2%), opt-out (&lt;1%/month); A/B tests messaging and timing
Responsible (R): Marketing Digital Manager
Accountable (A): CMO
Duration: Weekly review</bpmn:documentation>
        <bpmn:incoming>W2648_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2648_End7" name="Complete">
        <bpmn:incoming>W2648_Flow13</bpmn:incoming>
      </bpmn:endEvent>
