    <bpmn:process id="W_W2649" name="W2649. Mobile App Loyalty Integration &amp; Points Display" isExecutable="false">
      <bpmn:documentation>Trigger: App feature update or loyalty program change
Frequency: Continuous
Volume: ~600K loyalty members; ~300K app users
Owner: Digital Product Manager
Participants: Digital Product Mgr, Loyalty Program Manager, IT
Source: workflow W2649 — Mobile App Loyalty Integration &amp; Points Display</bpmn:documentation>
      <bpmn:laneSet id="W2649_LaneSet3">
        <bpmn:lane id="W2649_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2649_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2649_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2649_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2649_Lane2" name="Loyalty Program Manager">
        <bpmn:flowNodeRef>W2649_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2649_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2649_Start4" name="App feature update or loyalty program change">
        <bpmn:outgoing>W2649_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2649_Task5" name="Product Manager ensures loyalty integration: real-time points balance…">
        <bpmn:documentation>Step 1: Product Manager ensures loyalty integration: real-time points balance, transaction history, tier status, points redemption, digital loyalty barcode for POS
Responsible (R): Digital Product Manager
Accountable (A): CIO / CMO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2649_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2649_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2649_Task6" name="Loyalty Program Manager configures: personalized offers, birthday bonus, tier…">
        <bpmn:documentation>Step 2: Loyalty Program Manager configures: personalized offers, birthday bonus, tier upgrade celebration, points expiry reminders, member pricing indicator
Responsible (R): Loyalty Program Manager / Digital Product Manager
Accountable (A): CMO
Duration: Per program update</bpmn:documentation>
        <bpmn:incoming>W2649_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2649_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2649_Task7" name="Product Manager tracks app loyalty engagement: points check frequency, digital…">
        <bpmn:documentation>Step 3: Product Manager tracks app loyalty engagement: points check frequency, digital card scan rate, redemption via app; identifies gamification opportunities
Responsible (R): Digital Product Manager
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2649_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2649_End8" name="Complete">
        <bpmn:incoming>W2649_Flow14</bpmn:incoming>
      </bpmn:endEvent>
