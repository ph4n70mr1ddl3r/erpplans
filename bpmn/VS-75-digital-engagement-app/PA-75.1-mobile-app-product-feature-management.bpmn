    <bpmn:process id="W_W2646" name="W2646. Mobile App Feature Roadmap &amp; Prioritization" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly planning cycle
Frequency: Quarterly
Volume: 1 app (iOS + Android); ~300K active users
Owner: Digital Product Manager
Participants: Digital Product Mgr, CIO, CMO, IT Development
Source: workflow W2646 — Mobile App Feature Roadmap &amp; Prioritization</bpmn:documentation>
      <bpmn:laneSet id="W2646_LaneSet3">
        <bpmn:lane id="W2646_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2646_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2646_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2646_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2646_Lane2" name="IT Development">
        <bpmn:flowNodeRef>W2646_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2646_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2646_Start4" name="Quarterly planning cycle">
        <bpmn:outgoing>W2646_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2646_Task5" name="Digital Product Manager collects feature requests: customer feedback, business…">
        <bpmn:documentation>Step 1: Digital Product Manager collects feature requests: customer feedback, business stakeholders, competitive analysis, analytics insights; maintains prioritized backlog
Responsible (R): Digital Product Manager
Accountable (A): CIO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2646_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2646_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2646_Task6" name="Product Manager prioritizes using RICE framework; presents quarterly roadmap to…">
        <bpmn:documentation>Step 2: Product Manager prioritizes using RICE framework; presents quarterly roadmap to CIO and CMO for approval
Responsible (R): Digital Product Manager
Accountable (A): CIO / CMO
Duration: 1–2 weeks/quarter</bpmn:documentation>
        <bpmn:incoming>W2646_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2646_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2646_Task7" name="IT Development implements per agile: 2-week sprints, UAT, staged rollout (10% →…">
        <bpmn:documentation>Step 3: IT Development implements per agile: 2-week sprints, UAT, staged rollout (10% → 50% → 100%); Product Manager monitors adoption post-launch
Responsible (R): IT Development / Digital Product Manager
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2646_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2646_End8" name="Complete">
        <bpmn:incoming>W2646_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2646_Annotation9">
        <bpmn:text>Controls: - CTL-454 (ensure controlled execution — Mobile App Product &amp; Feature Management (PA-75.1).) | - operational: Digital Product Manager sign-off on the workflow output
Owner: Digital Product Manager</bpmn:text>
      </bpmn:textAnnotation>
