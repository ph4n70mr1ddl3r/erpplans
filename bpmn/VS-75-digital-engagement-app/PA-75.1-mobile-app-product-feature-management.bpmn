Responsible (R): IT Security Manager
Accountable (A): CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2652_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2652_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2652_Task6" name="Data Privacy Officer ensures RA 10173 compliance: privacy notice, consent…">
