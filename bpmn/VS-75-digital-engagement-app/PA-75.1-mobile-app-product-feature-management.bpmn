    <bpmn:process id="W_W2647" name="W2647. Mobile App Store Listing &amp; Review Management" isExecutable="false">
      <bpmn:documentation>Trigger: App release cycle or weekly review monitoring
Frequency: Weekly; per release
Volume: iOS App Store + Google Play Store
Owner: Digital Product Manager
Participants: Digital Product Mgr, Marketing, IT
Source: workflow W2647 — Mobile App Store Listing &amp; Review Management</bpmn:documentation>
      <bpmn:laneSet id="W2647_LaneSet3">
        <bpmn:lane id="W2647_Lane1" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2647_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2647_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2647_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2647_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2647_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2647_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2647_Start4" name="App release cycle or weekly review monitoring">
        <bpmn:outgoing>W2647_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2647_Task5" name="Product Manager monitors reviews daily: responds to negatives within 24 hours…">
        <bpmn:documentation>Step 1: Product Manager monitors reviews daily: responds to negatives within 24 hours, categorizes feedback, escalates critical bugs; maintains 4.5+ star target
Responsible (R): Digital Product Manager
Accountable (A): CIO
Duration: 30 min/day</bpmn:documentation>
        <bpmn:incoming>W2647_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2647_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2647_Task6" name="Marketing updates app store listing: screenshots, description, feature…">
        <bpmn:documentation>Step 2: Marketing updates app store listing: screenshots, description, feature highlights per release; A/B tests for conversion optimization
Responsible (R): Marketing / Digital Product Manager
Accountable (A): CMO
Duration: Per release</bpmn:documentation>
        <bpmn:incoming>W2647_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2647_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2647_Task7" name="Product Manager analyzes review trends: top complaints, sentiment tracking…">
        <bpmn:documentation>Step 3: Product Manager analyzes review trends: top complaints, sentiment tracking; reports monthly to CIO and CMO
Responsible (R): Digital Product Manager
Accountable (A): CIO
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W2647_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2647_End8" name="Complete">
        <bpmn:incoming>W2647_Flow14</bpmn:incoming>
      </bpmn:endEvent>
