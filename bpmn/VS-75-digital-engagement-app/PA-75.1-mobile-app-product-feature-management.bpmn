      <bpmn:startEvent id="W2653_Start4" name="Feature optimization cycle">
        <bpmn:outgoing>W2653_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2653_Task5" name="Product Manager designs A/B tests: hypothesis, variant (UI, CTA, checkout…">
        <bpmn:documentation>Step 1: Product Manager designs A/B tests: hypothesis, variant (UI, CTA, checkout, search), sample size, success metric, duration (2–4 weeks); statistical significance required
Responsible (R): Digital Product Manager
Accountable (A): CIO
Duration: Per test</bpmn:documentation>
        <bpmn:incoming>W2653_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2653_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2653_Task6" name="IT implements via feature flags: random assignment, metric tracking, guardrail…">
        <bpmn:documentation>Step 2: IT implements via feature flags: random assignment, metric tracking, guardrail metrics; Product Manager monitors interim results
Responsible (R): IT Development / Digital Product Manager
Accountable (A): CIO
Duration: Per test</bpmn:documentation>
        <bpmn:incoming>W2653_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2653_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2653_Task7" name="Product Manager analyzes results: significance, effect size, segment results…">
        <bpmn:documentation>Step 3: Product Manager analyzes results: significance, effect size, segment results; if winner — implements for all; documents learnings in experimentation repository
Responsible (R): Digital Product Manager
Accountable (A): CIO / CMO
Duration: Per test conclusion</bpmn:documentation>
        <bpmn:incoming>W2653_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2653_End8" name="Complete">
        <bpmn:incoming>W2653_Flow14</bpmn:incoming>
      </bpmn:endEvent>
