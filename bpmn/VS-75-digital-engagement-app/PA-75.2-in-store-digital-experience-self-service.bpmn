<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-75.2-in-store-digital-experience-self-service" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2654" name="W2654. In-Store Kiosk Management &amp; Content Updates" isExecutable="false">
      <bpmn:documentation>Trigger: Kiosk content refresh or system update
Frequency: Monthly updates; daily monitoring
Volume: 200 stores × 1–2 kiosks = ~300 kiosks
Owner: Store Operations IT
Participants: Store Ops IT, Marketing, Merchandising, Digital Product Manager
Source: workflow W2654 — In-Store Kiosk Management &amp; Content Updates</bpmn:documentation>
      <bpmn:laneSet id="W2654_LaneSet4">
        <bpmn:lane id="W2654_Lane1" name="Store Ops IT">
        <bpmn:flowNodeRef>W2654_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2654_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2654_Lane2" name="Marketing">
        <bpmn:flowNodeRef>W2654_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2654_Lane3" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2654_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2654_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2654_Start5" name="Kiosk content refresh or system update">
        <bpmn:outgoing>W2654_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2654_Task6" name="Store Ops IT manages kiosk fleet: monitors uptime (99%), remote content…">
        <bpmn:documentation>Step 1: Store Ops IT manages kiosk fleet: monitors uptime (99%), remote content management, OS updates, hardware maintenance; replaces faulty units within 48 hours
Responsible (R): Store Ops IT
Accountable (A): CIO
Duration: Daily monitoring</bpmn:documentation>
        <bpmn:incoming>W2654_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2654_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2654_Task7" name="Marketing updates content: promotional videos, product spotlights, store map…">
        <bpmn:documentation>Step 2: Marketing updates content: promotional videos, product spotlights, store map, loyalty info, DIY videos, seasonal campaigns; refreshes monthly with weekly promo updates
Responsible (R): Marketing / Merchandising
Accountable (A): CMO
Duration: Monthly/weekly</bpmn:documentation>
        <bpmn:incoming>W2654_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2654_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2654_Task8" name="Digital Product Manager analyzes usage: interaction count, most-viewed content…">
        <bpmn:documentation>Step 3: Digital Product Manager analyzes usage: interaction count, most-viewed content, session duration, conversion to sale; optimizes content placement
Responsible (R): Digital Product Manager
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2654_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2654_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2654_End9" name="Complete">
        <bpmn:incoming>W2654_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2654_Annotation10">
        <bpmn:text>Controls: - CTL-455 (ensure controlled execution — In-Store Digital Experience &amp; Self-Service (PA-75.2).) | - operational: Store Operations IT sign-off on the workflow output
Owner: Store Operations IT</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2654_Assoc11" sourceRef="W2654_Annotation10" targetRef="W2654_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2654_Flow12" sourceRef="W2654_Start5" targetRef="W2654_Task6" />
      <bpmn:sequenceFlow id="W2654_Flow13" sourceRef="W2654_Task6" targetRef="W2654_Task7" />
      <bpmn:sequenceFlow id="W2654_Flow14" sourceRef="W2654_Task7" targetRef="W2654_Task8" />
      <bpmn:sequenceFlow id="W2654_Flow15" sourceRef="W2654_Task8" targetRef="W2654_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2654_diag">
      <bpmndi:BPMNPlane id="W2654_plane" bpmnElement="W_W2654">
        <bpmndi:BPMNShape id="W2654_Lane1_di" bpmnElement="W2654_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2654_Lane2_di" bpmnElement="W2654_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2654_Lane3_di" bpmnElement="W2654_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
