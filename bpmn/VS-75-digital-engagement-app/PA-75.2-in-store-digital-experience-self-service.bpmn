        <bpmndi:BPMNEdge id="W2655_Flow13_di" bpmnElement="W2655_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2655_Flow14_di" bpmnElement="W2655_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2655_Flow15_di" bpmnElement="W2655_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2655_Assoc11_di" bpmnElement="W2655_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2656" name="W2656. Self-Checkout Pilot &amp; Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Self-checkout station available
Frequency: Continuous at pilot stores
Volume: ~20–30 pilot stores × 2 terminals
Owner: Store Manager
Participants: Store Manager, LP Officer, IT, VP Store Operations
Source: workflow W2656 — Self-Checkout Pilot &amp; Operations</bpmn:documentation>
      <bpmn:laneSet id="W2656_LaneSet4">
        <bpmn:lane id="W2656_Lane1" name="Customer">
        <bpmn:flowNodeRef>W2656_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2656_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2656_Lane2" name="LP Officer">
        <bpmn:flowNodeRef>W2656_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2656_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W2656_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2656_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2656_Start5" name="Self-checkout station available">
        <bpmn:outgoing>W2656_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2656_Task6" name="Customer uses self-checkout: scans items, places on weighted verification…">
        <bpmn:documentation>Step 1: Customer uses self-checkout: scans items, places on weighted verification platform, pays via card/GCash/Maya (no cash); system verifies weight matches expected
Responsible (R): Customer / System
Accountable (A): Store Manager
Duration: 5–10 min per transaction</bpmn:documentation>
        <bpmn:incoming>W2656_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2656_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2656_Task7" name="LP Officer monitors: reviews exception alerts (weight mismatch, barcode…">
        <bpmn:documentation>Step 2: LP Officer monitors: reviews exception alerts (weight mismatch, barcode override), assists customers, responds to intervention alerts; staff available for age-restricted authorization
Responsible (R): LP Officer / Staff
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2656_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2656_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2656_Task8" name="VP Store Operations evaluates: throughput vs. staffed checkout, satisfaction…">
        <bpmn:documentation>Step 3: VP Store Operations evaluates: throughput vs. staffed checkout, satisfaction, shrinkage rate, maintenance cost; determines expansion, modification, or discontinuation
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: Quarterly review</bpmn:documentation>
        <bpmn:incoming>W2656_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2656_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2656_End9" name="Complete">
        <bpmn:incoming>W2656_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2656_Annotation10">
        <bpmn:text>Controls: - CTL-455 (ensure controlled execution — In-Store Digital Experience &amp; Self-Service (PA-75.2).) | - operational: Store Manager sign-off on the workflow output
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2656_Assoc11" sourceRef="W2656_Annotation10" targetRef="W2656_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2656_Flow12" sourceRef="W2656_Start5" targetRef="W2656_Task6" />
      <bpmn:sequenceFlow id="W2656_Flow13" sourceRef="W2656_Task6" targetRef="W2656_Task7" />
      <bpmn:sequenceFlow id="W2656_Flow14" sourceRef="W2656_Task7" targetRef="W2656_Task8" />
      <bpmn:sequenceFlow id="W2656_Flow15" sourceRef="W2656_Task8" targetRef="W2656_End9" />
    </bpmn:process>
