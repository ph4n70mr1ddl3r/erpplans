    <bpmn:process id="W_W2661" name="W2661. Digital Price Tag &amp; Electronic Shelf Label Management" isExecutable="false">
      <bpmn:documentation>Trigger: Price change cycle
Frequency: Continuous; per change
Volume: 200 stores × ~15,000 ESLs = ~3M ESLs
Owner: Merchandising Operations
Participants: Merch Ops, IT, Store Ops, Pricing Manager
Source: workflow W2661 — Digital Price Tag &amp; Electronic Shelf Label Management</bpmn:documentation>
      <bpmn:laneSet id="W2661_LaneSet4">
        <bpmn:lane id="W2661_Lane1" name="Pricing Manager">
        <bpmn:flowNodeRef>W2661_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2661_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2661_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W2661_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2661_Lane3" name="Merch Ops">
        <bpmn:flowNodeRef>W2661_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2661_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2661_Start5" name="Price change cycle">
        <bpmn:outgoing>W2661_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2661_Task6" name="Pricing Manager triggers change in ERP: pushes to ESL system via store network…">
        <bpmn:documentation>Step 1: Pricing Manager triggers change in ERP: pushes to ESL system via store network; ESLs update within 5 minutes; supports dynamic and time-based promotional pricing
Responsible (R): Pricing Manager / System
Accountable (A): VP Merchandising
Duration: Per price change</bpmn:documentation>
        <bpmn:incoming>W2661_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2661_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2661_Task7" name="Store Ops verifies daily: spot-checks 20–30 ESLs vs. POS price; reports sync…">
        <bpmn:documentation>Step 2: Store Ops verifies daily: spot-checks 20–30 ESLs vs. POS price; reports sync failures; ESL system alerts for low-battery labels
Responsible (R): Store Ops / Merch Ops
Accountable (A): VP Store Operations
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2661_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2661_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2661_Task8" name="Merch Ops tracks performance: price sync accuracy (99.9%), battery life…">
        <bpmn:documentation>Step 3: Merch Ops tracks performance: price sync accuracy (99.9%), battery life management, hardware failure rate; ROI: eliminates ~18M paper labels/year
Responsible (R): Merch Ops / Finance
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2661_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2661_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2661_End9" name="Complete">
        <bpmn:incoming>W2661_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2661_Annotation10">
        <bpmn:text>Controls: - CTL-455 (ensure controlled execution — In-Store Digital Experience &amp; Self-Service (PA-75.2).) | - CTL-455 (price-change authorization — links to VS-08 / W40); Operational: Merchandising Operations sign-off on the workflow output
Owner: Merchandising Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2661_Assoc11" sourceRef="W2661_Annotation10" targetRef="W2661_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2661_Flow12" sourceRef="W2661_Start5" targetRef="W2661_Task6" />
      <bpmn:sequenceFlow id="W2661_Flow13" sourceRef="W2661_Task6" targetRef="W2661_Task7" />
      <bpmn:sequenceFlow id="W2661_Flow14" sourceRef="W2661_Task7" targetRef="W2661_Task8" />
      <bpmn:sequenceFlow id="W2661_Flow15" sourceRef="W2661_Task8" targetRef="W2661_End9" />
    </bpmn:process>
