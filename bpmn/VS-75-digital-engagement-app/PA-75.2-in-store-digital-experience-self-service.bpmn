      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2655" name="W2655. QR Code Product Information &amp; Review Display" isExecutable="false">
      <bpmn:documentation>Trigger: Customer scans shelf QR code
Frequency: Continuous; per scan
Volume: 35K SKUs with QR codes; ~10K–20K scans/month
Owner: Merchandising Team
Participants: Merchandising, IT, Digital Product Manager, Customers
Source: workflow W2655 — QR Code Product Information &amp; Review Display</bpmn:documentation>
      <bpmn:laneSet id="W2655_LaneSet4">
        <bpmn:lane id="W2655_Lane1" name="Merchandising">
        <bpmn:flowNodeRef>W2655_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2655_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2655_Lane2" name="System">
        <bpmn:flowNodeRef>W2655_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2655_Lane3" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2655_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2655_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2655_Start5" name="Customer scans shelf QR code">
        <bpmn:outgoing>W2655_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2655_Task6" name="Merchandising generates shelf-edge QR codes: links to product page with specs…">
        <bpmn:documentation>Step 1: Merchandising generates shelf-edge QR codes: links to product page with specs, reviews, how-to videos, related products, stock availability
Responsible (R): Merchandising
Accountable (A): VP Merchandising
Duration: Per SKU setup</bpmn:documentation>
        <bpmn:incoming>W2655_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2655_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2655_Task7" name="Customer scans QR with phone camera: opens mobile-responsive page with details…">
        <bpmn:documentation>Step 2: Customer scans QR with phone camera: opens mobile-responsive page with details, price, availability, ratings, installation guides, accessories
Responsible (R): System / Customer
Accountable (A): Digital Product Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2655_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2655_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2655_Task8" name="Product Manager tracks analytics: scan volume by category, conversion (scan →…">
        <bpmn:documentation>Step 3: Product Manager tracks analytics: scan volume by category, conversion (scan → purchase), popular products; identifies enhanced content opportunities
Responsible (R): Digital Product Manager
Accountable (A): CMO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2655_Flow14</bpmn:incoming>
        <bpmn:outgoing>W2655_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2655_End9" name="Complete">
        <bpmn:incoming>W2655_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2655_Annotation10">
        <bpmn:text>Controls: - CTL-455 (ensure controlled execution — In-Store Digital Experience &amp; Self-Service (PA-75.2).) | - operational: Merchandising Team sign-off on the workflow output
Owner: Merchandising Team</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2655_Assoc11" sourceRef="W2655_Annotation10" targetRef="W2655_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2655_Flow12" sourceRef="W2655_Start5" targetRef="W2655_Task6" />
      <bpmn:sequenceFlow id="W2655_Flow13" sourceRef="W2655_Task6" targetRef="W2655_Task7" />
      <bpmn:sequenceFlow id="W2655_Flow14" sourceRef="W2655_Task7" targetRef="W2655_Task8" />
      <bpmn:sequenceFlow id="W2655_Flow15" sourceRef="W2655_Task8" targetRef="W2655_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2655_diag">
      <bpmndi:BPMNPlane id="W2655_plane" bpmnElement="W_W2655">
        <bpmndi:BPMNShape id="W2655_Lane1_di" bpmnElement="W2655_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2655_Lane2_di" bpmnElement="W2655_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2655_Lane3_di" bpmnElement="W2655_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
