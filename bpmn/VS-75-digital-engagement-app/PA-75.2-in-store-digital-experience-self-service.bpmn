      <bpmndi:BPMNPlane id="W2656_plane" bpmnElement="W_W2656">
        <bpmndi:BPMNShape id="W2656_Lane1_di" bpmnElement="W2656_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2656_Lane2_di" bpmnElement="W2656_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
