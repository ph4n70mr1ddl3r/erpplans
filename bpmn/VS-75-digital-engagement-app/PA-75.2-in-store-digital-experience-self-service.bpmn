        <bpmndi:BPMNShape id="W2656_End9_di" bpmnElement="W2656_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2656_Annotation10_di" bpmnElement="W2656_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
