    <bpmn:process id="W_W2657" name="W2657. Mobile App In-Store Mode Activation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer enters store with app
Frequency: Per customer visit
Volume: ~50K–100K activations/month
Owner: Digital Product Manager
Participants: Digital Product Mgr, Store Ops, Marketing, IT
Source: workflow W2657 — Mobile App In-Store Mode Activation</bpmn:documentation>
      <bpmn:laneSet id="W2657_LaneSet4">
        <bpmn:lane id="W2657_Lane1" name="System">
        <bpmn:flowNodeRef>W2657_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2657_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2657_Lane2" name="Customer">
        <bpmn:flowNodeRef>W2657_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2657_Lane3" name="Digital Product Manager">
        <bpmn:flowNodeRef>W2657_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2657_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2657_Start5" name="Customer enters store with app">
        <bpmn:outgoing>W2657_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2657_Task6" name="System detects entry (GPS geofence + Bluetooth beacon): activates in-store mode…">
        <bpmn:documentation>Step 1: System detects entry (GPS geofence + Bluetooth beacon): activates in-store mode showing map, promotions, aisle locations, stock check, scan-to-shop, associate assistance
Responsible (R): System / Digital Product Manager
Accountable (A): CIO
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2657_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2657_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2657_Task7" name="Customer uses in-store features: scans products for details, creates shopping…">
        <bpmn:documentation>Step 2: Customer uses in-store features: scans products for details, creates shopping list with aisle locations, requests price check; Store Manager receives traffic heat map
Responsible (R): Customer / System
Accountable (A): Digital Product Manager
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W2657_Flow13</bpmn:incoming>
