    <bpmn:process id="W_W5452" name="W5452. DENR-Compliant C&amp;D Transporter Permitting &amp; Hauling Manifest" isExecutable="false">
      <bpmn:documentation>Trigger: Load departs site; manifest system
Frequency: Per load
Volume: ~thousands of manifests/yr
Owner: Compliance Specialist (VS-22)
Participants: Hauler (W5447), Disposer, DENR/LGU, Finance (VS-15), Records (VS-88)
Source: workflow W5452 — DENR-Compliant C&amp;D Transporter Permitting &amp; Hauling Manifest</bpmn:documentation>
      <bpmn:laneSet id="W5452_LaneSet4">
        <bpmn:lane id="W5452_Lane1" name="Compliance Specialist">
        <bpmn:flowNodeRef>W5452_Task6</bpmn:flowNodeRef>
