    <bpmn:process id="W_W5453" name="W5453. Multi-Stream Routing to Recycler / Reprocessor / MDRF / Landfill" isExecutable="false">
      <bpmn:documentation>Trigger: Load segregation complete (W5449); hauler departs
Frequency: Per load; periodic routing optimization
Volume: ~thousands of loads/yr to ~multiple destinations
Owner: Services Asset Manager
Participants: Hauler (W5447), Recyclers/TSD/landfill, ESG (VS-25), Compliance (VS-22)
Source: workflow W5453 — Multi-Stream Routing to Recycler / Reprocessor / MDRF / Landfill</bpmn:documentation>
      <bpmn:laneSet id="W5453_LaneSet3">
        <bpmn:lane id="W5453_Lane1" name="Services Asset Manager">
        <bpmn:flowNodeRef>W5453_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5453_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5453_Task8</bpmn:flowNodeRef>
