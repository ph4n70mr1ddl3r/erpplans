      <bpmn:startEvent id="W5453_Start4" name="Load segregation complete (W5449); hauler departs">
        <bpmn:outgoing>W5453_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5453_Task5" name="Route each segregated stream to its highest-value/accredited destination: clean…">
        <bpmn:documentation>Step 1: Route each segregated stream to its highest-value/accredited destination: clean wood → biomass/repurposer; metals → scrap recycler (recovery value); concrete/masonry → crusher/reprocessor; drywall/cardboard → recycler; residuals → accredited sanitary landfill/MDRF.
Responsible (R): Services Asset Manager
Accountable (A): COO
Duration: per load</bpmn:documentation>
        <bpmn:incoming>W5453_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5453_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5453_Task6" name="Match destination to the customer&#x27;s/project&#x27;s diversion target (W5446) and…">
        <bpmn:documentation>Step 2: Match destination to the customer&#x27;s/project&#x27;s diversion target (W5446) and BuildRight&#x27;s ESG goal (VS-25).
Responsible (R): Services Asset Manager
Accountable (A): Sustainability/ESG Manager
Duration: per load</bpmn:documentation>
        <bpmn:incoming>W5453_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5453_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5453_Task7" name="Capture destination acceptance/rejection and any rebates (scrap-metal recovery…">
        <bpmn:documentation>Step 3: Capture destination acceptance/rejection and any rebates (scrap-metal recovery, reprocessor credits) for settlement (W5457).
Responsible (R): Site Cleanup Coordinator
Accountable (A): Services Manager
Duration: per load</bpmn:documentation>
        <bpmn:incoming>W5453_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5453_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5453_Task8" name="Optimize routing over time for cost/diversion/distance (route clean wood to the…">
        <bpmn:documentation>Step 4: Optimize routing over time for cost/diversion/distance (route clean wood to the nearest biomass plant, etc.).
Responsible (R): Services Asset Manager
Accountable (A): COO
Duration: periodic</bpmn:documentation>
        <bpmn:incoming>W5453_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5453_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5453_Task9" name="Report diversion by stream and destination into ESG (VS-25) and the analytics…">
        <bpmn:documentation>Step 5: Report diversion by stream and destination into ESG (VS-25) and the analytics (W5459).
Responsible (R): Services Asset Manager
Accountable (A): Sustainability/ESG Manager
Duration: periodic</bpmn:documentation>
        <bpmn:incoming>W5453_Flow17</bpmn:incoming>
      </bpmn:userTask>
