    <bpmn:process id="W_W5458" name="W5458. Customer Invoicing, Dispute Resolution &amp; Collections" isExecutable="false">
      <bpmn:documentation>Trigger: Settlement (W5457); billing cycle; customer dispute; aging
Frequency: Per job invoice; weekly aging review
Volume: ~thousands of invoices/yr (B2C + B2B)
Owner: AR Analyst (VS-16)
Participants: Finance (VS-15/VS-16), Customer Service (VS-13), Site Cleanup Coordinator, customer
Source: workflow W5458 — Customer Invoicing, Dispute Resolution &amp; Collections</bpmn:documentation>
      <bpmn:laneSet id="W5458_LaneSet3">
