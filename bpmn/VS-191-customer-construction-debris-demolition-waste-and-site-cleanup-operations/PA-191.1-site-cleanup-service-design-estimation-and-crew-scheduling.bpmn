      <bpmndi:BPMNPlane id="W5442_plane" bpmnElement="W_W5442">
        <bpmndi:BPMNShape id="W5442_Lane1_di" bpmnElement="W5442_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
