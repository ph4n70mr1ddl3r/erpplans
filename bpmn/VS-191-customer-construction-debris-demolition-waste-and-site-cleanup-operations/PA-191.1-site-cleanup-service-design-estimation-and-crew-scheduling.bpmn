      <bpmn:sequenceFlow id="W5442_Flow14" sourceRef="W5442_Task5" targetRef="W5442_Task6" />
      <bpmn:sequenceFlow id="W5442_Flow15" sourceRef="W5442_Task6" targetRef="W5442_Task7" />
      <bpmn:sequenceFlow id="W5442_Flow16" sourceRef="W5442_Task7" targetRef="W5442_Task8" />
      <bpmn:sequenceFlow id="W5442_Flow17" sourceRef="W5442_Task8" targetRef="W5442_Task9" />
      <bpmn:sequenceFlow id="W5442_Flow18" sourceRef="W5442_Task9" targetRef="W5442_End10" />
    </bpmn:process>
