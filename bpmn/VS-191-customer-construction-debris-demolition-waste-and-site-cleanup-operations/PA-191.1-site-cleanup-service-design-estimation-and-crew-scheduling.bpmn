    <bpmn:process id="W_W5443" name="W5443. Job Site Cleanup Pre-Job Hazard &amp; Regulated-Material Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Booking confirmed (W5448); any demolition/suspect-older-building job; post-disaster (VS-184)
Frequency: Per engagement; mandatory for demolition/older-stock/post-disaster
Volume: Per cleanup job; ~100% of demolition/large jobs screened
Owner: Site Cleanup Supervisor
Participants: HSE (VS-24), customer, Estimator (VS-09.2), VS-187 hazmat, VS-73 asbestos (W2613)
Source: workflow W5443 — Job Site Cleanup Pre-Job Hazard &amp; Regulated-Material Assessment</bpmn:documentation>
      <bpmn:laneSet id="W5443_LaneSet4">
        <bpmn:lane id="W5443_Lane1" name="Site Cleanup Supervisor">
        <bpmn:flowNodeRef>W5443_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5443_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5443_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5443_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5443_Lane2" name="HSE">
        <bpmn:flowNodeRef>W5443_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5443_Lane3" name="Site Cleanup Coordinator">
        <bpmn:flowNodeRef>W5443_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5443_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5443_Start5" name="Booking confirmed (W5448); any demolition/suspect-older-building job; post-disaster…">
        <bpmn:outgoing>W5443_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5443_Task6" name="Screen the job for regulated/hazardous materials: asbestos/lead suspect…">
        <bpmn:documentation>Step 1: Screen the job for regulated/hazardous materials: asbestos/lead suspect (pre-1990s buildings), paint/solvent residues, refrigerants, treated wood, chemical containers, e-waste.
Responsible (R): Site Cleanup Supervisor / HSE
Accountable (A): HSE Lead
Duration: per job</bpmn:documentation>
        <bpmn:incoming>W5443_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5443_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5443_Task7" name="For suspect asbestos/lead, route to the accredited abatement path (VS-73 W2613)…">
        <bpmn:documentation>Step 2: For suspect asbestos/lead, route to the accredited abatement path (VS-73 W2613) — do NOT include in standard C&amp;D hauling; pause the cleanup until resolved.
Responsible (R): HSE
Accountable (A): HSE Lead
Duration: per suspect</bpmn:documentation>
        <bpmn:incoming>W5443_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5443_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5443_Task8" name="For household hazardous residues, route to VS-187 take-back or accredited TSD…">
        <bpmn:documentation>Step 3: For household hazardous residues, route to VS-187 take-back or accredited TSD; exclude from the mixed C&amp;D load.
Responsible (R): Site Cleanup Supervisor
Accountable (A): HSE Lead
Duration: per job</bpmn:documentation>
        <bpmn:incoming>W5443_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5443_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5443_Task9" name="Capture site hazards (live utilities, structural instability, confined space…">
