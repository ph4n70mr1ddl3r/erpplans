<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-191.1-site-cleanup-service-design-estimation-and-crew-scheduling" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5441" name="W5441. Site Cleanup Service Product Design, Pricing &amp; Catalog" isExecutable="false">
      <bpmn:documentation>Trigger: Service launch; annual pricing review; new install/build channel introduction
Frequency: Annual review; new product/SKU as needed
Volume: ~8–15 service products (post-install cleanup, post-demolition cleanup, bulk-debris haul, skip rental, final handover clean)
Owner: Services Category Manager (VS-12/VS-09)
Participants: Pricing (VS-01.2/VS-101), Legal/Compliance (VS-100/VS-22), ESG (VS-25), Hauling vendors
Source: workflow W5441 — Site Cleanup Service Product Design, Pricing &amp; Catalog</bpmn:documentation>
      <bpmn:laneSet id="W5441_LaneSet6">
        <bpmn:lane id="W5441_Lane1" name="Services Category Manager">
        <bpmn:flowNodeRef>W5441_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5441_Start7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5441_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W5441_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5441_Lane3" name="Merch Ops">
        <bpmn:flowNodeRef>W5441_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5441_Lane4" name="Legal Counsel">
        <bpmn:flowNodeRef>W5441_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5441_Lane5" name="Marketing">
        <bpmn:flowNodeRef>W5441_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5441_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5441_Start7" name="Service launch; annual pricing review; new install/build channel introduction">
        <bpmn:outgoing>W5441_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5441_Task8" name="Define the site-cleanup service catalog tied to BuildRight&#x27;s install/build…">
        <bpmn:documentation>Step 1: Define the site-cleanup service catalog tied to BuildRight&#x27;s install/build channels (post-appliance-install, post-tile/flooring, post-projects/VS-66, post-solar/VS-70, post-disaster-repair/VS-184, final handover clean).
Responsible (R): Services Category Manager
Accountable (A): COO
Duration: per review</bpmn:documentation>
        <bpmn:incoming>W5441_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5441_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5441_Task9" name="Price each service on container-cube + crew-hours + hauling/disposal cost +…">
        <bpmn:documentation>Step 2: Price each service on container-cube + crew-hours + hauling/disposal cost + margin, accounting for scrap-metal recovery and diversion-rebate offsets.
Responsible (R): Pricing Analyst
Accountable (A): COO
Duration: per product</bpmn:documentation>
        <bpmn:incoming>W5441_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5441_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5441_Task10" name="Configure service items/SKUs and attach-to logic at POS/order entry so cleanup…">
        <bpmn:documentation>Step 3: Configure service items/SKUs and attach-to logic at POS/order entry so cleanup is offered with every qualifying install/build sale (links VS-08/VS-10/VS-11).
Responsible (R): Merch Ops / IT
Accountable (A): COO
Duration: per product</bpmn:documentation>
        <bpmn:incoming>W5441_Flow18</bpmn:incoming>
        <bpmn:outgoing>W5441_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5441_Task11" name="Legal review of service terms (LGU/DENR liability boundary, hazardous…">
        <bpmn:documentation>Step 4: Legal review of service terms (LGU/DENR liability boundary, hazardous exclusion, indemnity) and Consumer Act (RA 7394) disclosure.
Responsible (R): Legal Counsel
Accountable (A): VP Legal &amp; Compliance
Duration: per product</bpmn:documentation>
        <bpmn:incoming>W5441_Flow19</bpmn:incoming>
        <bpmn:outgoing>W5441_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5441_Task12" name="Publish to the website/app/Pro-Desk catalog and train sales associates (VS-124)…">
        <bpmn:documentation>Step 5: Publish to the website/app/Pro-Desk catalog and train sales associates (VS-124) on attach.
Responsible (R): Marketing / L&amp;D
Accountable (A): COO
Duration: per launch</bpmn:documentation>
        <bpmn:incoming>W5441_Flow20</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5441_End13" name="Complete">
        <bpmn:incoming>W5441_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5441_Annotation14">
        <bpmn:text>Controls: - CTL-803 (ensure controlled execution — Site Cleanup Service Design, Estimation &amp; Crew Scheduling (PA-191.1).) | - operational: service/pricing approval; Consumer Act disclosure in service terms; hazardous/regulated materials explicitly excluded in service terms.
Owner: Services Category Manager (VS-12/VS-09)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5441_Assoc15" sourceRef="W5441_Annotation14" targetRef="W5441_Start7" associationDirection="None" />
