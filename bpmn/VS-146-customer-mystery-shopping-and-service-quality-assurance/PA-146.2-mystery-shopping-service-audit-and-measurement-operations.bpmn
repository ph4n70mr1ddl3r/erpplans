        <bpmn:outgoing>W4370_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4370_Task4" name="Shopper execute the in-store scenario (greeting, inquiry, product-knowledge…">
        <bpmn:documentation>Step 1: Shopper execute the in-store scenario (greeting, inquiry, product-knowledge probe, consultative-selling test, checkout, return/complaint W4373), observing the rubric (W4362)
Responsible (R): Shopper
Accountable (A): Service Quality Lead
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4370_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4370_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4370_Task5" name="Shopper capture evidence within lawful limits (W4367) — observed behaviors…">
        <bpmn:documentation>Step 2: Shopper capture evidence within lawful limits (W4367) — observed behaviors, timings (queue/wait), and permitted photo/audio per consent
Responsible (R): Shopper
Accountable (A): Service Quality Lead
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4370_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4370_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4370_Task6" name="Shopper submit the completed shop report + evidence to the system (W4368)…">
        <bpmn:documentation>Step 3: Shopper submit the completed shop report + evidence to the system (W4368) within timeline, for validation/scoring (W4375)
Responsible (R): Shopper / Vendor
Accountable (A): Service Quality Lead
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4370_Flow12</bpmn:incoming>
      </bpmn:userTask>
