    <bpmn:process id="W_W4370" name="W4370. In-Store Mystery Shopping Execution &amp; Evidence Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled in-store visit
Frequency: Per visit
Volume: In-store mystery-shop visits
Owner: Mystery Shopper (Vendor) / Service Quality
Participants: Shopper, Service Quality, Store Ops (VS-07) [unaware], CX (VS-13)
Source: workflow W4370 — In-Store Mystery Shopping Execution &amp; Evidence Capture</bpmn:documentation>
      <bpmn:laneSet id="W4370_LaneSet2">
        <bpmn:lane id="W4370_Lane1" name="Shopper">
        <bpmn:flowNodeRef>W4370_Task4</bpmn:flowNodeRef>
