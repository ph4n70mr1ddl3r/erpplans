    <bpmn:process id="W_W4362" name="W4362. Service Standards, Customer-Journey Touchpoint Definition &amp; Scoring Rubric" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4361); standards refresh; journey change
Frequency: Annual + on change
Volume: One service-standards &amp; scoring-rubric framework
Owner: Service Quality / CX (VS-13) / Store Ops (VS-07) / Sales Enablement (VS-124)
Participants: CX (VS-13), Store Ops (VS-07), Sales Enablement (VS-124), Ecommerce (VS-10), HR (VS-103)
Source: workflow W4362 — Service Standards, Customer-Journey Touchpoint Definition &amp; Scoring Rubric</bpmn:documentation>
      <bpmn:laneSet id="W4362_LaneSet3">
        <bpmn:lane id="W4362_Lane1" name="Service Quality">
        <bpmn:flowNodeRef>W4362_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4362_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4362_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4362_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W4362_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4362_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4362_Start4" name="Strategy (W4361); standards refresh; journey change">
        <bpmn:outgoing>W4362_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4362_Task5" name="Service Quality/CX define the service standards per journey touchpoint…">
        <bpmn:documentation>Step 1: Service Quality/CX define the service standards per journey touchpoint (greeting, needs-discovery, product knowledge, consultative selling, queue/wait, cleanliness, checkout, recovery, omnichannel consistency)
Responsible (R): Service Quality / CX / Sales Enablement
Accountable (A): Head of Service Quality / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4362_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4362_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4362_Task6" name="Service Quality build the scoring rubric — measurable observable behaviors…">
        <bpmn:documentation>Step 2: Service Quality build the scoring rubric — measurable observable behaviors, pass/fail or scaled scoring, weighting by impact, and evidence requirements (photo/recording where lawful)
Responsible (R): Service Quality
Accountable (A): Head of Service Quality
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4362_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4362_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4362_Task7" name="Store Ops/HR communicate standards to associates (VS-124/VS-19.4), embed in…">
        <bpmn:documentation>Step 3: Store Ops/HR communicate standards to associates (VS-124/VS-19.4), embed in training, and review on change
Responsible (R): Store Ops / HR / Sales Enablement
Accountable (A): COO / CHRO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4362_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4362_End8" name="Complete">
        <bpmn:incoming>W4362_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4362_Annotation9">
        <bpmn:text>Controls: - CTL-668 (ensure controlled execution — Service-Quality Assurance Strategy, Standards &amp; Program Design (PA-146.1).) | - CTL-668: standards observable &amp; rubric evidence-based; standards communicated &amp; trained; reviewed on change
Owner: Service Quality / CX (VS-13) / Store Ops (VS-07) / Sales Enablement (VS-124)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4362_Assoc10" sourceRef="W4362_Annotation9" targetRef="W4362_Start4" associationDirection="None" />
