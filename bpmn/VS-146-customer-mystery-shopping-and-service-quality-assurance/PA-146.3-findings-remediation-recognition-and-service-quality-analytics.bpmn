      <bpmn:sequenceFlow id="W4377_Flow13" sourceRef="W4377_Task6" targetRef="W4377_Task7" />
      <bpmn:sequenceFlow id="W4377_Flow14" sourceRef="W4377_Task7" targetRef="W4377_End8" />
    </bpmn:process>
