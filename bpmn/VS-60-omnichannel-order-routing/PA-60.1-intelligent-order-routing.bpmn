    <bpmn:process id="W_W2288" name="W2288. Ship-from-Store Order Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Order routed to store
Frequency: ~1,500–2,800/month (the VS-60 SFS register canon)
Volume: ~1,500–2,800/month (the VS-60 SFS register canon)
Owner: Store Stock Associate
Participants: Stock Associate, 3PL, Store Manager
Source: workflow W2288 — Ship-from-Store Order Processing</bpmn:documentation>
      <bpmn:laneSet id="W2288_LaneSet2">
        <bpmn:lane id="W2288_Lane1" name="Stock Associate">
        <bpmn:flowNodeRef>W2288_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2288_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2288_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2288_Start3" name="Order routed to store">
        <bpmn:outgoing>W2288_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2288_Task4" name="System generates pick list; Associate picks, packs, generates label; 3PL pickup…">
        <bpmn:documentation>Step 1: System generates pick list; Associate picks, packs, generates label; 3PL pickup scheduled per VS-56; system updates tracking; customer notified; delivery in 2–3 days
Responsible (R): Stock Associate / System / 3PL
Accountable (A): Store Manager
Duration: 15–30 min + 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2288_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2288_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2288_End5" name="Complete">
        <bpmn:incoming>W2288_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2288_Annotation6">
        <bpmn:text>Controls: - CTL-409: pick/ATP integrity; CTL-409 (pick-fraud detection evidence); operational: Store Manager ship-from-store-volume oversight
Owner: Store Stock Associate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2288_Assoc7" sourceRef="W2288_Annotation6" targetRef="W2288_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2288_Flow8" sourceRef="W2288_Start3" targetRef="W2288_Task4" />
      <bpmn:sequenceFlow id="W2288_Flow9" sourceRef="W2288_Task4" targetRef="W2288_End5" />
    </bpmn:process>
