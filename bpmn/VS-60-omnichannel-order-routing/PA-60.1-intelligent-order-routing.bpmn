    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2287" name="W2287. Mixed-Basket Order Splitting" isExecutable="false">
      <bpmn:documentation>Trigger: Order items from multiple sources
Frequency: ~7–12% of ecommerce orders (the multi-origin share, per W534)
Volume: ~12K–17K split orders/month
Owner: Order Management System
Participants: Ecom Ops Manager
Source: workflow W2287 — Mixed-Basket Order Splitting</bpmn:documentation>
      <bpmn:laneSet id="W2287_LaneSet2">
        <bpmn:lane id="W2287_Lane1" name="System">
        <bpmn:flowNodeRef>W2287_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2287_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2287_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2287_Start3" name="Order items from multiple sources">
        <bpmn:outgoing>W2287_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2287_Task4" name="System splits by source: store → BOPIS/ship-from-store, DC → DC fulfillment…">
        <bpmn:documentation>Step 1: System splits by source: store → BOPIS/ship-from-store, DC → DC fulfillment, vendor → drop-ship, dark store → micro-fulfillment; creates linked sub-orders; communicates split to customer
Responsible (R): System
Accountable (A): Ecom Ops Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2287_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2287_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2287_End5" name="Complete">
        <bpmn:incoming>W2287_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2287_Annotation6">
        <bpmn:text>Controls: - CTL-409: sub-order integrity; operational: Ecom Ops Manager split-rate monitoring
Owner: Order Management System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2287_Assoc7" sourceRef="W2287_Annotation6" targetRef="W2287_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2287_Flow8" sourceRef="W2287_Start3" targetRef="W2287_Task4" />
      <bpmn:sequenceFlow id="W2287_Flow9" sourceRef="W2287_Task4" targetRef="W2287_End5" />
    </bpmn:process>
