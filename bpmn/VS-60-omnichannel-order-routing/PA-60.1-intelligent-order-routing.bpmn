    <bpmn:process id="W_W2290" name="W2290. Inventory Reservation &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Order placed
Frequency: ~42,900 orders/month
Volume: ~42,900 reservations/month
Owner: Order Management System
Participants: Inventory Manager
Source: workflow W2290 — Inventory Reservation &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W2290_LaneSet2">
        <bpmn:lane id="W2290_Lane1" name="System">
        <bpmn:flowNodeRef>W2290_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2290_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2290_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2290_Start3" name="Order placed">
        <bpmn:outgoing>W2290_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2290_Task4" name="System reserves ATP at source; prevents double-selling; holds for window…">
        <bpmn:documentation>Step 1: System reserves ATP at source; prevents double-selling; holds for window (BOPIS: 5 days, delivery: 24 hours); expired reservations cancelled, inventory restored, refund processed
Responsible (R): System
Accountable (A): Inventory Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2290_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2290_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2290_End5" name="Complete">
        <bpmn:incoming>W2290_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2290_Annotation6">
        <bpmn:text>Controls: - CTL-409: reservation integrity; CTL-197 (atomic-ATP — no double-sell); operational: Inventory Manager reservation-expiry review
Owner: Order Management System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2290_Assoc7" sourceRef="W2290_Annotation6" targetRef="W2290_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2290_Flow8" sourceRef="W2290_Start3" targetRef="W2290_Task4" />
      <bpmn:sequenceFlow id="W2290_Flow9" sourceRef="W2290_Task4" targetRef="W2290_End5" />
    </bpmn:process>
