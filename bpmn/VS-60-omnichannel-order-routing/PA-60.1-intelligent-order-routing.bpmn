      <bpmn:serviceTask id="W2292_Task4" name="SLA: BOPIS 4 hours, Metro delivery 2 days, Provincial 5 days, Drop-ship 7 days…">
        <bpmn:documentation>Step 1: SLA: BOPIS 4 hours, Metro delivery 2 days, Provincial 5 days, Drop-ship 7 days; daily monitoring for at-risk orders; escalation to alternate source or expedited shipping
Responsible (R): System / Ecom Ops Manager
Accountable (A): VP Marketing
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2292_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2292_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
