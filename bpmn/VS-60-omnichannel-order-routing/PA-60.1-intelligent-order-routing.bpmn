    <bpmn:process id="W_W2289" name="W2289. Vendor Drop-Ship Order Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Order routed to vendor
Frequency: ~2K–4K/month; bulky/appliances
Volume: ~2K–4K/month
Owner: Vendor Management Coordinator
Participants: Vendor, Vendor Coordinator
Source: workflow W2289 — Vendor Drop-Ship Order Processing</bpmn:documentation>
      <bpmn:laneSet id="W2289_LaneSet2">
        <bpmn:lane id="W2289_Lane1" name="System">
        <bpmn:flowNodeRef>W2289_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2289_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2289_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2289_Start3" name="Order routed to vendor">
        <bpmn:outgoing>W2289_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2289_Task4" name="System creates drop-ship PO with customer address; vendor confirms in 24 hours…">
        <bpmn:documentation>Step 1: System creates drop-ship PO with customer address; vendor confirms in 24 hours; ships with BuildRight packaging; system tracks; vendor confirms delivery; revenue recognized
Responsible (R): System / Vendor
Accountable (A): Vendor Coord
Duration: 1–2 days + 3–7 days</bpmn:documentation>
        <bpmn:incoming>W2289_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2289_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2289_End5" name="Complete">
        <bpmn:incoming>W2289_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2289_Annotation6">
        <bpmn:text>Controls: - CTL-409: drop-ship PO &amp; reservation integrity; CTL-114 (revenue-recognition-at-delivery — links to VS-157); operational: Vendor Coordinator monitoring
Owner: Vendor Management Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2289_Assoc7" sourceRef="W2289_Annotation6" targetRef="W2289_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2289_Flow8" sourceRef="W2289_Start3" targetRef="W2289_Task4" />
      <bpmn:sequenceFlow id="W2289_Flow9" sourceRef="W2289_Task4" targetRef="W2289_End5" />
    </bpmn:process>
