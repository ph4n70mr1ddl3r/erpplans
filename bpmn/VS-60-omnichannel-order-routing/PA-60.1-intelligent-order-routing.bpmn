    <bpmn:process id="W_W2291" name="W2291. Order Routing Exception Management" isExecutable="false">
      <bpmn:documentation>Trigger: Routing failure
Frequency: ~2K–3K exceptions/month (~5%)
Volume: ~2K–3K/month
Owner: Ecommerce Operations Manager
Participants: Ecom Ops Manager, VP Marketing
Source: workflow W2291 — Order Routing Exception Management</bpmn:documentation>
      <bpmn:laneSet id="W2291_LaneSet2">
        <bpmn:lane id="W2291_Lane1" name="System">
        <bpmn:flowNodeRef>W2291_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2291_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2291_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2291_Start3" name="Routing failure">
        <bpmn:outgoing>W2291_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2291_Task4" name="System detects: stock-out after reservation, store unable to fulfill, vendor…">
        <bpmn:documentation>Step 1: System detects: stock-out after reservation, store unable to fulfill, vendor rejection; Manager re-routes to alternative source; communicates revised timeline; systemic issues to IT
Responsible (R): System / Ecom Ops Manager
Accountable (A): VP Marketing
Duration: 15–30 min/exception</bpmn:documentation>
        <bpmn:incoming>W2291_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2291_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2291_End5" name="Complete">
        <bpmn:incoming>W2291_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2291_Annotation6">
        <bpmn:text>Controls: - CTL-409: re-route integrity; operational: Ecom Ops Manager exception-rate review; VP Marketing escalation on &gt;5% rate
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2291_Assoc7" sourceRef="W2291_Annotation6" targetRef="W2291_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2291_Flow8" sourceRef="W2291_Start3" targetRef="W2291_Task4" />
      <bpmn:sequenceFlow id="W2291_Flow9" sourceRef="W2291_Task4" targetRef="W2291_End5" />
    </bpmn:process>
