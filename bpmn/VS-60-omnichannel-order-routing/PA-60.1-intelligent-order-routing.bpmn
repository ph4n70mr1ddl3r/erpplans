    <bpmn:process id="W_W2286" name="W2286. Order Source Selection Engine" isExecutable="false">
      <bpmn:documentation>Trigger: Customer places order
Frequency: ~42,900 orders/month (per profile §8.5)
Volume: ~42,900 routing decisions/month
Owner: Ecommerce Operations Manager
Participants: Ecom Ops Manager
Source: workflow W2286 — Order Source Selection Engine</bpmn:documentation>
      <bpmn:laneSet id="W2286_LaneSet2">
        <bpmn:lane id="W2286_Lane1" name="System">
        <bpmn:flowNodeRef>W2286_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2286_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2286_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2286_Start3" name="Customer places order">
        <bpmn:outgoing>W2286_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2286_Task4" name="System evaluates per line item: nearest store, DC, vendor drop-ship, dark…">
        <bpmn:documentation>Step 1: System evaluates per line item: nearest store, DC, vendor drop-ship, dark store; selects by speed, cost, availability, item type; BOPIS → customer-selected store; delivery → fastest+cheapest
Responsible (R): System
Accountable (A): Ecom Ops Manager
Duration: &lt;5 sec automated</bpmn:documentation>
        <bpmn:incoming>W2286_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2286_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2286_End5" name="Complete">
        <bpmn:incoming>W2286_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2286_Annotation6">
        <bpmn:text>Controls: - CTL-409: reservation integrity; CTL-197 (ATP accuracy — links to VS-05); operational: Ecom Ops Manager routing-rule sign-off
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2286_Assoc7" sourceRef="W2286_Annotation6" targetRef="W2286_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2286_Flow8" sourceRef="W2286_Start3" targetRef="W2286_Task4" />
      <bpmn:sequenceFlow id="W2286_Flow9" sourceRef="W2286_Task4" targetRef="W2286_End5" />
    </bpmn:process>
