      </bpmn:startEvent>
      <bpmn:userTask id="W2300_Task4" name="Random 100 orders/week: correct items, quantities, packaging, label, timely…">
        <bpmn:documentation>Step 1: Random 100 orders/week: correct items, quantities, packaging, label, timely dispatch; quality score by source; &gt;2% error rate triggers corrective action
Responsible (R): Ecom Quality Coord
Accountable (A): Ecom Ops Manager
Duration: 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2300_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2300_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2300_End5" name="Complete">
        <bpmn:incoming>W2300_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2300_Annotation6">
        <bpmn:text>Controls: - CTL-197: order-routing/fulfillment accuracy — pick-fraud detection; operational: Ecom Ops Manager corrective-action sign-off
Owner: Ecommerce Quality Coordinator</bpmn:text>
