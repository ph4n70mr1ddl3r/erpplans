    <bpmn:process id="W_W2299" name="W2299. Cross-Entity Fulfillment Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Order across BuildRight entities
Frequency: ~1,500–2,800/month (the SFS register canon)
Volume: ~1,500–2,800/month (the SFS register canon)
