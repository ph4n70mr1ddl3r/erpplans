    <bpmn:process id="W_W2300" name="W2300. Fulfillment Quality Control" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly random check
Frequency: Weekly; ~100 checks/week
Volume: ~100/week
Owner: Ecommerce Quality Coordinator
Participants: Ecom Quality Coordinator, Ecom Ops Manager
Source: workflow W2300 — Fulfillment Quality Control</bpmn:documentation>
