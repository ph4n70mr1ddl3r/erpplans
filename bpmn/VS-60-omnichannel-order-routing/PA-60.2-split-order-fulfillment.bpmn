      <bpmn:documentation>Trigger: Customer selects express
Frequency: ~3K–5K/month
Volume: ~3K–5K/month
Owner: Ecommerce Operations Manager
Participants: Store Staff, 3PL, Ecom Ops Manager
Source: workflow W2301 — Same-Day &amp; Express Fulfillment</bpmn:documentation>
      <bpmn:laneSet id="W2301_LaneSet2">
        <bpmn:lane id="W2301_Lane1" name="System">
        <bpmn:flowNodeRef>W2301_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2301_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2301_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2301_Start3" name="Customer selects express">
        <bpmn:outgoing>W2301_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2301_Task4" name="Routes only to stores with stock in radius; cutoff 12 PM; premium 3PL…">
        <bpmn:documentation>Step 1: Routes only to stores with stock in radius; cutoff 12 PM; premium 3PL (GrabExpress, Lalamove Priority); store picks/packs in 2 hours; 3PL pickup in 1 hour; delivery in 4 hours; premium SLA tracking
Responsible (R): System / Store Staff / 3PL
Accountable (A): Ecom Ops Manager
Duration: Same day</bpmn:documentation>
        <bpmn:incoming>W2301_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2301_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2301_End5" name="Complete">
        <bpmn:incoming>W2301_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2301_Annotation6">
        <bpmn:text>Controls: - CTL-410 (ensure controlled execution — Split-Order &amp; Mixed-Basket Fulfillment (PA-60.2).) | - CTL-410 (express-SLA integrity); operational: Ecom Ops Manager express-SLA-miss review
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
