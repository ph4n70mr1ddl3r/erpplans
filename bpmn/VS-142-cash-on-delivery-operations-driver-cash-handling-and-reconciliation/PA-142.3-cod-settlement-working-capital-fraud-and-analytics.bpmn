    <bpmn:process id="W_W4284" name="W4284. COD Driver/3PL Performance, Scorecard &amp; Deduction Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cycle; reconciliation (W4277); discrepancy (W4278)
Frequency: Monthly + continuous
Volume: Driver/3PL COD performance across the network
Owner: Payment Ops / Last-Mile (VS-06.3) / Procurement (VS-34)
Participants: Last-Mile (VS-06.3/VS-56), Finance (VS-17.4), Fraud (VS-125), Vendor Mgmt (VS-67)
Source: workflow W4284 — COD Driver/3PL Performance, Scorecard &amp; Deduction Management</bpmn:documentation>
      <bpmn:laneSet id="W4284_LaneSet2">
        <bpmn:lane id="W4284_Lane1" name="Payment Ops">
        <bpmn:flowNodeRef>W4284_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4284_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4284_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4284_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4284_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4284_Start3" name="Monthly cycle; reconciliation (W4277); discrepancy (W4278)">
        <bpmn:outgoing>W4284_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4284_Task4" name="Payment Ops/Last-Mile build the COD driver/3PL scorecard (cash-remittance…">
        <bpmn:documentation>Step 1: Payment Ops/Last-Mile build the COD driver/3PL scorecard (cash-remittance timeliness, reconciliation accuracy, discrepancy rate, refusal rate, fraud/loss, POD compliance) from reconciliation (W4277/W4278)
Responsible (R): Payment Ops / Analytics
Accountable (A): Head of Payment Ops
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4284_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4284_Flow11</bpmn:outgoing>
