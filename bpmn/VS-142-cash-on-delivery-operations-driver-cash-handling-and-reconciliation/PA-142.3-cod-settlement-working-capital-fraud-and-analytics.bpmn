<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-142.3-cod-settlement-working-capital-fraud-and-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4281" name="W4281. COD Settlement Cycle, Clearing &amp; Inter-Entity Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Settlement cycle; monthly close (VS-17.1); intercompany (VS-72)
Frequency: Daily clearing + monthly settlement
Volume: COD settlement across 5 entities (Digital Commerce Inc. collects, Depot Inc. recognizes revenue)
Owner: Finance / GL (VS-17.1) / Intercompany (VS-72)
Participants: Treasury (VS-18), GL (VS-17.1), Intercompany (VS-72), Digital Commerce (VS-10), Payment Ops
Source: workflow W4281 — COD Settlement Cycle, Clearing &amp; Inter-Entity Settlement</bpmn:documentation>
      <bpmn:laneSet id="W4281_LaneSet3">
        <bpmn:lane id="W4281_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4281_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4281_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4281_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4281_Lane2" name="Intercompany">
        <bpmn:flowNodeRef>W4281_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4281_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4281_Start4" name="Settlement cycle; monthly close (VS-17.1); intercompany (VS-72)">
        <bpmn:outgoing>W4281_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4281_Task5" name="Finance/GL run the COD settlement cycle: clear the COD cash-collected against…">
        <bpmn:documentation>Step 1: Finance/GL run the COD settlement cycle: clear the COD cash-collected against the order receivable/float, recognize revenue at the right entity (Depot Inc. per profile §2), and post the Digital Commerce fulfillment fee (per profile §2)
Responsible (R): Finance / GL
Accountable (A): Finance Controller
Duration: Daily/Monthly</bpmn:documentation>
        <bpmn:incoming>W4281_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4281_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4281_Task6" name="Intercompany/Finance settle inter-entity (Digital Commerce Inc. collected cash…">
        <bpmn:documentation>Step 2: Intercompany/Finance settle inter-entity (Digital Commerce Inc. collected cash → remit to Depot Inc. per the per-order fee model), at arm&#x27;s-length transfer pricing (VS-72)
Responsible (R): Intercompany / Finance
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4281_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4281_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4281_Task7" name="Finance reconcile settlement to bank (VS-18) and GL (VS-17.1), eliminate…">
        <bpmn:documentation>Step 3: Finance reconcile settlement to bank (VS-18) and GL (VS-17.1), eliminate intercompany on consolidation (VS-17), and report (W4287)
Responsible (R): Finance / GL
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4281_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4281_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4281_End8" name="Complete">
        <bpmn:incoming>W4281_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4281_Annotation9">
        <bpmn:text>Controls: - CTL-658 (ensure controlled execution — COD Settlement, Working-Capital, Fraud &amp; Analytics (PA-142.3).) | - CTL-658: revenue recognized at correct entity (profile §2); intercompany arm&#x27;s-length (VS-72); settlement reconciled to bank/GL
Owner: Finance / GL (VS-17.1) / Intercompany (VS-72)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4281_Assoc10" sourceRef="W4281_Annotation9" targetRef="W4281_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4281_Flow11" sourceRef="W4281_Start4" targetRef="W4281_Task5" />
      <bpmn:sequenceFlow id="W4281_Flow12" sourceRef="W4281_Task5" targetRef="W4281_Task6" />
      <bpmn:sequenceFlow id="W4281_Flow13" sourceRef="W4281_Task6" targetRef="W4281_Task7" />
      <bpmn:sequenceFlow id="W4281_Flow14" sourceRef="W4281_Task7" targetRef="W4281_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4281_diag">
      <bpmndi:BPMNPlane id="W4281_plane" bpmnElement="W_W4281">
        <bpmndi:BPMNShape id="W4281_Lane1_di" bpmnElement="W4281_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
