      <bpmndi:BPMNPlane id="W4282_plane" bpmnElement="W_W4282">
        <bpmndi:BPMNShape id="W4282_Lane1_di" bpmnElement="W4282_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
