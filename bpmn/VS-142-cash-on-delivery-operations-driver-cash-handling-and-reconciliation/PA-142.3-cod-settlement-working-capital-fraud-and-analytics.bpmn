        <bpmndi:BPMNEdge id="W4282_Flow12_di" bpmnElement="W4282_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4282_Flow13_di" bpmnElement="W4282_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4282_Flow14_di" bpmnElement="W4282_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4282_Assoc10_di" bpmnElement="W4282_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4283" name="W4283. COD Fraud Detection, Investigation &amp; Loss Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Fraud signal; pattern alert; loss spike
Frequency: Continuous monitoring + per investigation
Volume: COD fraud cases (phantom orders, driver theft, refund/short-pay abuse, account misuse)
Owner: Fraud (VS-125) / Payment Ops / Security (VS-23)
Participants: Fraud (VS-125), Security (VS-23), Customer Support (VS-13), Legal (VS-100), 3PL (VS-56)
Source: workflow W4283 — COD Fraud Detection, Investigation &amp; Loss Recovery</bpmn:documentation>
      <bpmn:laneSet id="W4283_LaneSet2">
        <bpmn:lane id="W4283_Lane1" name="Fraud">
        <bpmn:flowNodeRef>W4283_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4283_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4283_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4283_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4283_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4283_Start3" name="Fraud signal; pattern alert; loss spike">
        <bpmn:outgoing>W4283_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4283_Task4" name="Fraud/Payment Ops run detection rules/ML on COD data (refusal patterns…">
        <bpmn:documentation>Step 1: Fraud/Payment Ops run detection rules/ML on COD data (refusal patterns, short-pay clusters, address/account anomalies, driver-cash discrepancies, velocity) integrated with VS-125
Responsible (R): Fraud / Payment Ops
Accountable (A): Head of Payment Ops / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4283_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4283_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4283_Task5" name="Fraud investigate flagged cases (driver theft, customer scam, collusion)…">
        <bpmn:documentation>Step 2: Fraud investigate flagged cases (driver theft, customer scam, collusion), gather evidence (POD W4274, cash records, analytics), and case-manage per VS-125
Responsible (R): Fraud / Security
Accountable (A): Head of Internal Audit &amp; Risk
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4283_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4283_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4283_Task6" name="Fraud/Legal/Security pursue recovery (3PL bond W4268, fidelity insurance VS-26…">
        <bpmn:documentation>Step 3: Fraud/Legal/Security pursue recovery (3PL bond W4268, fidelity insurance VS-26, charge the offender, blacklist W4266, police/legal VS-100), and feed findings to detection tuning
Responsible (R): Fraud / Legal / Insurance
Accountable (A): Head of Internal Audit &amp; Risk / CFO
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4283_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4283_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4283_End7" name="Complete">
        <bpmn:incoming>W4283_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4283_Annotation8">
        <bpmn:text>Controls: - CTL-658 (ensure controlled execution — COD Settlement, Working-Capital, Fraud &amp; Analytics (PA-142.3).) | - CTL-658: COD fraud detected &amp; case-managed (VS-125); recovery pursued (bond/insurance VS-26); blacklist maintained (W4266)
Owner: Fraud (VS-125) / Payment Ops / Security (VS-23)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4283_Assoc9" sourceRef="W4283_Annotation8" targetRef="W4283_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4283_Flow10" sourceRef="W4283_Start3" targetRef="W4283_Task4" />
      <bpmn:sequenceFlow id="W4283_Flow11" sourceRef="W4283_Task4" targetRef="W4283_Task5" />
      <bpmn:sequenceFlow id="W4283_Flow12" sourceRef="W4283_Task5" targetRef="W4283_Task6" />
      <bpmn:sequenceFlow id="W4283_Flow13" sourceRef="W4283_Task6" targetRef="W4283_End7" />
    </bpmn:process>
