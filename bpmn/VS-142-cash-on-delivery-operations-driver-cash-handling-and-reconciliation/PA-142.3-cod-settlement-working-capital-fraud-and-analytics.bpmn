        <bpmn:outgoing>W4288_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4288_Task4" name="Payment Ops/Innovation scan future-state options to reduce COD cost/fraud while…">
        <bpmn:documentation>Step 1: Payment Ops/Innovation scan future-state options to reduce COD cost/fraud while preserving access: BNPL/e-wallet credit (links VS-38), digital cash-collection (e-money at doorstep), cash-voucher/7-Eleven/Palawan pay-at-counter, and pre-pay incentives
Responsible (R): Payment Ops / Innovation / Ecommerce
Accountable (A): CFO / CIO / CMO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4288_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4288_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4288_Task5" name="Payment Ops/Finance pilot and business-case alternatives (cost-to-serve, fraud…">
        <bpmn:documentation>Step 2: Payment Ops/Finance pilot and business-case alternatives (cost-to-serve, fraud, conversion, capital), assess risk/privacy (VS-91/VS-125), and sequence rollout (VS-30 POC → scale)
Responsible (R): Payment Ops / Finance / Innovation
Accountable (A): CFO / CIO
Duration: Per initiative</bpmn:documentation>
        <bpmn:incoming>W4288_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4288_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4288_Task6" name="Payment Ops/OpEx run CI on the COD program (process mining VS-133, automation…">
        <bpmn:documentation>Step 3: Payment Ops/OpEx run CI on the COD program (process mining VS-133, automation, control tightening), track benefit realization, and re-baseline the COD strategy (W4265)
Responsible (R): Payment Ops / OpEx
Accountable (A): Head of Payment Ops
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4288_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4288_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4288_End7" name="Complete">
        <bpmn:incoming>W4288_Flow13</bpmn:incoming>
      </bpmn:endEvent>
