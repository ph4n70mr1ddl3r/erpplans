    <bpmn:process id="W_W4271" name="W4271. COD Governance, Compliance &amp; BIR/Cash-Reporting Framework" isExecutable="false">
      <bpmn:documentation>Trigger: Risk framework (W4269); regulatory change; annual review
Frequency: Annual + on regulatory change
Volume: One COD governance/compliance framework
Owner: Payment Ops / Compliance (VS-22) / Tax (VS-79) / Legal (VS-100.3)
Participants: Compliance (VS-22), Tax (VS-79), Legal (VS-100.3), Treasury (VS-18), AML (VS-86)
Source: workflow W4271 — COD Governance, Compliance &amp; BIR/Cash-Reporting Framework</bpmn:documentation>
      <bpmn:laneSet id="W4271_LaneSet4">
        <bpmn:lane id="W4271_Lane1" name="Tax">
