<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-142.1-cod-program-design-policy-and-risk-framework" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4265" name="W4265. COD Program Strategy, Channel Scope &amp; Operating Model" isExecutable="false">
      <bpmn:documentation>Trigger: Ecommerce growth (VS-10); payment-mix review; market/competitive pressure
Frequency: Annual + on strategy change
Volume: Enterprise COD program across ecommerce, MSME (VS-82), trade delivery (VS-74)
Owner: Head of Payment Operations / Ecommerce Finance / Commercial
Participants: Ecommerce (VS-10), Last-Mile (VS-06.3/VS-56), Finance (VS-17.4), Treasury (VS-18), Fraud (VS-125)
Source: workflow W4265 — COD Program Strategy, Channel Scope &amp; Operating Model</bpmn:documentation>
      <bpmn:laneSet id="W4265_LaneSet3">
        <bpmn:lane id="W4265_Lane1" name="Head of Payment Ops">
        <bpmn:flowNodeRef>W4265_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4265_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4265_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4265_Lane2" name="Payment Ops">
        <bpmn:flowNodeRef>W4265_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4265_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4265_Start4" name="Ecommerce growth (VS-10); payment-mix review; market/competitive pressure">
        <bpmn:outgoing>W4265_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4265_Task5" name="Payment Ops/Commercial set the COD strategy and channel scope (which…">
        <bpmn:documentation>Step 1: Payment Ops/Commercial set the COD strategy and channel scope (which channels/segments/geographies offer COD vs pre-pay only), the COD share target, and the operating model (own-crew collect vs 3PL-driver collect vs cash-handling partner)
Responsible (R): Head of Payment Ops / Ecommerce
Accountable (A): CFO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4265_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4265_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4265_Task6" name="Payment Ops/Last-Mile map the cash-chain design (driver → 3PL branch/depot →…">
        <bpmn:documentation>Step 2: Payment Ops/Last-Mile map the cash-chain design (driver → 3PL branch/depot → BuildRight → bank), the custody handoff points, and the reconciliation architecture (W4272), aligned to VS-06.3/VS-56
Responsible (R): Payment Ops / Last-Mile / Treasury
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4265_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4265_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4265_Task7" name="Payment Ops document the strategy, obtain approval, and cascade to policy…">
        <bpmn:documentation>Step 3: Payment Ops document the strategy, obtain approval, and cascade to policy (W4266), pricing (W4267), and 3PL terms (W4268)
Responsible (R): Head of Payment Ops
Accountable (A): CFO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4265_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4265_End8" name="Complete">
        <bpmn:incoming>W4265_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4265_Annotation9">
        <bpmn:text>Controls: - CTL-656 (ensure controlled execution — COD Program Design, Policy &amp; Risk Framework (PA-142.1).) | - CTL-656: strategy approved (CFO/COO); scope risk-tiered (W4266); cash-chain/handoffs documented
Owner: Head of Payment Operations / Ecommerce Finance / Commercial</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4265_Assoc10" sourceRef="W4265_Annotation9" targetRef="W4265_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4265_Flow11" sourceRef="W4265_Start4" targetRef="W4265_Task5" />
      <bpmn:sequenceFlow id="W4265_Flow12" sourceRef="W4265_Task5" targetRef="W4265_Task6" />
      <bpmn:sequenceFlow id="W4265_Flow13" sourceRef="W4265_Task6" targetRef="W4265_Task7" />
      <bpmn:sequenceFlow id="W4265_Flow14" sourceRef="W4265_Task7" targetRef="W4265_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4265_diag">
      <bpmndi:BPMNPlane id="W4265_plane" bpmnElement="W_W4265">
        <bpmndi:BPMNShape id="W4265_Lane1_di" bpmnElement="W4265_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
