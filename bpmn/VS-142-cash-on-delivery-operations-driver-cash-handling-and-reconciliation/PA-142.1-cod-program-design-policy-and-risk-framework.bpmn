        <bpmndi:BPMNEdge id="W4266_Flow13_di" bpmnElement="W4266_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4266_Flow14_di" bpmnElement="W4266_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4266_Assoc10_di" bpmnElement="W4266_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4267" name="W4267. COD Pricing, Fee &amp; Incentive Structure" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4265); cost review; competitive change
Frequency: Annual + on cost change
Volume: COD fee/price structure across the catalog/segments
Owner: Pricing (VS-01.2) / Payment Ops / Finance (VS-17.4)
Participants: Merchandising (VS-01), Ecommerce (VS-10), Revenue Assurance (VS-118), Marketing (VS-14)
Source: workflow W4267 — COD Pricing, Fee &amp; Incentive Structure</bpmn:documentation>
      <bpmn:laneSet id="W4267_LaneSet3">
        <bpmn:lane id="W4267_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W4267_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4267_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4267_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4267_Lane2" name="Revenue Assurance">
        <bpmn:flowNodeRef>W4267_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4267_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4267_Start4" name="Strategy (W4265); cost review; competitive change">
        <bpmn:outgoing>W4267_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4267_Task5" name="Pricing/Finance determine the COD cost-to-serve (handling, reconciliation…">
        <bpmn:documentation>Step 1: Pricing/Finance determine the COD cost-to-serve (handling, reconciliation, float/cost-of-capital, refusal/RTV cost, fraud loss) and set the COD fee (or pre-pay discount) to recover it, aligned to VS-118 pricing integrity
Responsible (R): Pricing / Finance
Accountable (A): CFO / CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4267_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4267_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4267_Task6" name="Pricing/Marketing set incentives (pre-pay nudge, e-wallet discount) to shift…">
        <bpmn:documentation>Step 2: Pricing/Marketing set incentives (pre-pay nudge, e-wallet discount) to shift mix toward lower-cost payment (VS-80) without suppressing conversion, aligned to VS-14/VS-58
Responsible (R): Pricing / Marketing
Accountable (A): CFO / CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4267_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4267_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4267_Task7" name="Revenue Assurance/Pricing monitor COD fee recovery vs actual COD cost (W4287)…">
        <bpmn:documentation>Step 3: Revenue Assurance/Pricing monitor COD fee recovery vs actual COD cost (W4287), detect leakage (under-charge, override), and adjust
Responsible (R): Revenue Assurance / Pricing
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4267_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4267_End8" name="Complete">
        <bpmn:incoming>W4267_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4267_Annotation9">
        <bpmn:text>Controls: - CTL-656 (ensure controlled execution — COD Program Design, Policy &amp; Risk Framework (PA-142.1).) | - CTL-656: COD fee cost-recovery-justified; RA-monitored (VS-118); incentives conversion-tested
Owner: Pricing (VS-01.2) / Payment Ops / Finance (VS-17.4)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4267_Assoc10" sourceRef="W4267_Annotation9" targetRef="W4267_Start4" associationDirection="None" />
