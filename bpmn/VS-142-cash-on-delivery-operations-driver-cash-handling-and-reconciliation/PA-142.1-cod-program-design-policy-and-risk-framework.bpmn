      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4266" name="W4266. COD Order Eligibility, Limit &amp; Risk-Tier Policy" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4265); fraud/loss data; customer/segment change
Frequency: Annual + periodic tuning
Volume: Eligibility/limit rules across the order base
Owner: Payment Operations / Fraud (VS-125) / Ecommerce (VS-10)
Participants: Fraud (VS-125), CRM/CDP (VS-126), Risk (VS-21.2), Finance (VS-17.4)
Source: workflow W4266 — COD Order Eligibility, Limit &amp; Risk-Tier Policy</bpmn:documentation>
      <bpmn:laneSet id="W4266_LaneSet3">
        <bpmn:lane id="W4266_Lane1" name="Payment Ops">
        <bpmn:flowNodeRef>W4266_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4266_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4266_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4266_Lane2" name="Fraud">
        <bpmn:flowNodeRef>W4266_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4266_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4266_Start4" name="Strategy (W4265); fraud/loss data; customer/segment change">
        <bpmn:outgoing>W4266_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4266_Task5" name="Payment Ops/Fraud set COD eligibility (new vs returning, verified address…">
        <bpmn:documentation>Step 1: Payment Ops/Fraud set COD eligibility (new vs returning, verified address, account age, blacklist) and per-order/per-customer COD value limits and item-type rules (no COD on ultra-high-value/DG) using fraud history (VS-125) and CDP signals (VS-126)
Responsible (R): Payment Ops / Fraud
Accountable (A): Head of Payment Ops
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4266_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4266_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4266_Task6" name="Payment Ops/Fraud define the risk-tier (low/med/high) with differentiated…">
        <bpmn:documentation>Step 2: Payment Ops/Fraud define the risk-tier (low/med/high) with differentiated limits, authentication (OTP/address verification), and pre-pay nudge for high-risk; integrate to order capture (VS-10)
Responsible (R): Payment Ops / Fraud / Ecommerce
Accountable (A): Head of Payment Ops
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4266_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4266_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4266_Task7" name="Fraud/Payment Ops tune limits on loss/refusal data (W4287), manage…">
        <bpmn:documentation>Step 3: Fraud/Payment Ops tune limits on loss/refusal data (W4287), manage blacklists/whitelists, and monitor eligibility-policy performance
Responsible (R): Fraud / Payment Ops
Accountable (A): Head of Payment Ops
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4266_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4266_End8" name="Complete">
        <bpmn:incoming>W4266_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4266_Annotation9">
        <bpmn:text>Controls: - CTL-110 (ensure COD cash-chain integrity.) | - CTL-656: eligibility/limits risk-based (VS-125); high-risk pre-pay/auth; blacklist maintained
Owner: Payment Operations / Fraud (VS-125) / Ecommerce (VS-10)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4266_Assoc10" sourceRef="W4266_Annotation9" targetRef="W4266_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4266_Flow11" sourceRef="W4266_Start4" targetRef="W4266_Task5" />
      <bpmn:sequenceFlow id="W4266_Flow12" sourceRef="W4266_Task5" targetRef="W4266_Task6" />
      <bpmn:sequenceFlow id="W4266_Flow13" sourceRef="W4266_Task6" targetRef="W4266_Task7" />
      <bpmn:sequenceFlow id="W4266_Flow14" sourceRef="W4266_Task7" targetRef="W4266_End8" />
    </bpmn:process>
