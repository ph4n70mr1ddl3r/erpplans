        <bpmndi:BPMNEdge id="W4273_Flow12_di" bpmnElement="W4273_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4273_Flow13_di" bpmnElement="W4273_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4273_Flow14_di" bpmnElement="W4273_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4273_Assoc10_di" bpmnElement="W4273_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4274" name="W4274. Doorstep Cash Collection, Receipting &amp; POD Capture" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery to COD customer
Frequency: Per COD delivery (~4,000–8,000/month)
Volume: Each COD cash collection at the doorstep
Owner: Delivery Driver / 3PL (VS-56) / Last-Mile Ops (VS-06.3)
Participants: Customer, Driver/3PL, Payment Ops, Fraud (VS-125)
Source: workflow W4274 — Doorstep Cash Collection, Receipting &amp; POD Capture</bpmn:documentation>
      <bpmn:laneSet id="W4274_LaneSet3">
        <bpmn:lane id="W4274_Lane1" name="Driver">
        <bpmn:flowNodeRef>W4274_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4274_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4274_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4274_Lane2" name="Payment Ops">
        <bpmn:flowNodeRef>W4274_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4274_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4274_Start4" name="Delivery to COD customer">
        <bpmn:outgoing>W4274_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4274_Task5" name="Driver deliver the order, state the exact amount-due (per W4273), collect cash…">
        <bpmn:documentation>Step 1: Driver deliver the order, state the exact amount-due (per W4273), collect cash, verify denomination/authenticity (counterfeit check), and confirm exact amount or process short-pay (W4276)
Responsible (R): Driver / 3PL
Accountable (A): Last-Mile Ops
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W4274_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4274_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4274_Task6" name="Driver capture proof of delivery + cash collected (digital POD with amount…">
        <bpmn:documentation>Step 2: Driver capture proof of delivery + cash collected (digital POD with amount, customer signature/photo receipt per W4270 standard), issue customer receipt (BIR-compliant per W4271), and update order cash-status in the app
Responsible (R): Driver / 3PL
Accountable (A): Last-Mile Ops
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W4274_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4274_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4274_Task7" name="Payment Ops/Fraud monitor collection exceptions (no-cash, short-pay…">
        <bpmn:documentation>Step 3: Payment Ops/Fraud monitor collection exceptions (no-cash, short-pay, counterfeit flag), trigger refusal/return handling (W4276), and feed data to reconciliation (W4277)
Responsible (R): Payment Ops / Fraud
Accountable (A): Head of Payment Ops
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4274_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4274_End8" name="Complete">
        <bpmn:incoming>W4274_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4274_Annotation9">
        <bpmn:text>Controls: - CTL-657 (ensure controlled execution — COD Cash Collection, Custody &amp; Driver/3PL Reconciliation (PA-142.2).) | - CTL-657: amount verified vs locked amount-due (W4273); POD/receipt captured (W4270/W4271); exceptions handled (W4276)
Owner: Delivery Driver / 3PL (VS-56) / Last-Mile Ops (VS-06.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4274_Assoc10" sourceRef="W4274_Annotation9" targetRef="W4274_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4274_Flow11" sourceRef="W4274_Start4" targetRef="W4274_Task5" />
      <bpmn:sequenceFlow id="W4274_Flow12" sourceRef="W4274_Task5" targetRef="W4274_Task6" />
      <bpmn:sequenceFlow id="W4274_Flow13" sourceRef="W4274_Task6" targetRef="W4274_Task7" />
      <bpmn:sequenceFlow id="W4274_Flow14" sourceRef="W4274_Task7" targetRef="W4274_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4274_diag">
      <bpmndi:BPMNPlane id="W4274_plane" bpmnElement="W_W4274">
        <bpmndi:BPMNShape id="W4274_Lane1_di" bpmnElement="W4274_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Lane2_di" bpmnElement="W4274_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Task5_di" bpmnElement="W4274_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Task6_di" bpmnElement="W4274_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Task7_di" bpmnElement="W4274_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Start4_di" bpmnElement="W4274_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_End8_di" bpmnElement="W4274_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4274_Annotation9_di" bpmnElement="W4274_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4274_Flow11_di" bpmnElement="W4274_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4274_Flow12_di" bpmnElement="W4274_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4274_Flow13_di" bpmnElement="W4274_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4274_Flow14_di" bpmnElement="W4274_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4274_Assoc10_di" bpmnElement="W4274_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4275" name="W4275. Driver/3PL Daily Cash Custody, Remittance &amp; Deposit" isExecutable="false">
      <bpmn:documentation>Trigger: End of driver/3PL shift, daily
Frequency: Daily per driver/depot
Volume: Daily cash custody &amp; remittance across the driver/3PL network
Owner: Last-Mile Ops (VS-06.3) / 3PL (VS-56) / Payment Ops
Participants: Drivers, 3PL depot/branch, Treasury (VS-18), Bank, Finance (VS-17.4)
Source: workflow W4275 — Driver/3PL Daily Cash Custody, Remittance &amp; Deposit</bpmn:documentation>
      <bpmn:laneSet id="W4275_LaneSet4">
        <bpmn:lane id="W4275_Lane1" name="Driver">
        <bpmn:flowNodeRef>W4275_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4275_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4275_Lane2" name="3PL">
        <bpmn:flowNodeRef>W4275_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4275_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W4275_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4275_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4275_Start5" name="End of driver/3PL shift, daily">
        <bpmn:outgoing>W4275_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4275_Task6" name="Driver/3PL secure the day&#x27;s collected cash (tamper-evident bag per W4270…">
        <bpmn:documentation>Step 1: Driver/3PL secure the day&#x27;s collected cash (tamper-evident bag per W4270, no-cash-overnight rule), reconcile to POD records, and remit to the 3PL depot/branch or BuildRight cash office within the SLA
Responsible (R): Driver / 3PL / Cash Office
Accountable (A): Last-Mile Ops / Payment Ops
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4275_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4275_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4275_Task7" name="3PL depot/cash office verify &amp; accept the remittance (count, match to POD list…">
        <bpmn:documentation>Step 2: 3PL depot/cash office verify &amp; accept the remittance (count, match to POD list, sign handoff), deposit to bank (VS-18) or arrange CIT pickup (VS-81), and transmit the cash file to BuildRight (W4278)
Responsible (R): 3PL / Cash Office / Treasury
Accountable (A): Head of Payment Ops
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4275_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4275_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4275_Task8" name="Treasury/Payment Ops confirm bank deposit (deposit slip/bank feed VS-18), track…">
        <bpmn:documentation>Step 3: Treasury/Payment Ops confirm bank deposit (deposit slip/bank feed VS-18), track unremitted-cash aging (W4269 float), and escalate overdue remittance per SLA
Responsible (R): Treasury / Payment Ops
Accountable (A): CFO
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4275_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4275_End9" name="Complete">
        <bpmn:incoming>W4275_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4275_Annotation10">
        <bpmn:text>Controls: - CTL-657 (ensure controlled execution — COD Cash Collection, Custody &amp; Driver/3PL Reconciliation (PA-142.2).) | - CTL-657: tamper-evident custody; no-cash-overnight; remittance SLA; deposit verified (VS-18); aging tracked
Owner: Last-Mile Ops (VS-06.3) / 3PL (VS-56) / Payment Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4275_Assoc11" sourceRef="W4275_Annotation10" targetRef="W4275_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4275_Flow12" sourceRef="W4275_Start5" targetRef="W4275_Task6" />
      <bpmn:sequenceFlow id="W4275_Flow13" sourceRef="W4275_Task6" targetRef="W4275_Task7" />
      <bpmn:sequenceFlow id="W4275_Flow14" sourceRef="W4275_Task7" targetRef="W4275_Task8" />
      <bpmn:sequenceFlow id="W4275_Flow15" sourceRef="W4275_Task8" targetRef="W4275_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4275_diag">
      <bpmndi:BPMNPlane id="W4275_plane" bpmnElement="W_W4275">
        <bpmndi:BPMNShape id="W4275_Lane1_di" bpmnElement="W4275_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Lane2_di" bpmnElement="W4275_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Lane3_di" bpmnElement="W4275_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Task6_di" bpmnElement="W4275_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Task7_di" bpmnElement="W4275_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Task8_di" bpmnElement="W4275_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Start5_di" bpmnElement="W4275_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_End9_di" bpmnElement="W4275_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4275_Annotation10_di" bpmnElement="W4275_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4275_Flow12_di" bpmnElement="W4275_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4275_Flow13_di" bpmnElement="W4275_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4275_Flow14_di" bpmnElement="W4275_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4275_Flow15_di" bpmnElement="W4275_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4275_Assoc11_di" bpmnElement="W4275_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4276" name="W4276. COD Refusal, Short-Pay &amp; Failed-Delivery Cash Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Customer refuses delivery, short-pays, or is unreachable
Frequency: Daily (~COD refusal rate 5–15% in PH ecommerce)
Volume: Refused/short-pay/failed COD orders
Owner: Last-Mile Ops (VS-06.3) / Payment Ops / Returns (VS-32)
Participants: Driver/3PL, Customer Support (VS-13), Returns (VS-32), Fraud (VS-125), Inventory (VS-05)
Source: workflow W4276 — COD Refusal, Short-Pay &amp; Failed-Delivery Cash Handling</bpmn:documentation>
      <bpmn:laneSet id="W4276_LaneSet4">
        <bpmn:lane id="W4276_Lane1" name="Driver">
        <bpmn:flowNodeRef>W4276_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4276_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4276_Lane2" name="Payment Ops">
        <bpmn:flowNodeRef>W4276_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4276_Lane3" name="Customer Support">
        <bpmn:flowNodeRef>W4276_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4276_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4276_Start5" name="Customer refuses delivery, short-pays, or is unreachable">
        <bpmn:outgoing>W4276_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4276_Task6" name="Driver/3PL record refusal/short-pay/failed-delivery with reason &amp; evidence…">
        <bpmn:documentation>Step 1: Driver/3PL record refusal/short-pay/failed-delivery with reason &amp; evidence (photo/attempt log), collect any partial cash due (with POD per W4274), and return the goods per the RTV process (VS-32)
Responsible (R): Driver / 3PL / Returns
Accountable (A): Last-Mile Ops
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4276_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4276_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4276_Task7" name="Payment Ops/Returns process the order outcome (cancel/return to stock…">
        <bpmn:documentation>Step 2: Payment Ops/Returns process the order outcome (cancel/return to stock VS-32/VS-05, partial-payment posting, restocking fee per policy), and flag repeat-refusal customers to fraud (VS-125)
Responsible (R): Payment Ops / Returns / Fraud
Accountable (A): Head of Payment Ops
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4276_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4276_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4276_Task8" name="Customer Support (VS-13) follow up on failed deliveries (reschedule, address…">
        <bpmn:documentation>Step 3: Customer Support (VS-13) follow up on failed deliveries (reschedule, address correction), and Fraud/Payment Ops analyze refusal patterns (W4287) to tune eligibility (W4266)
Responsible (R): Customer Support / Fraud / Payment Ops
Accountable (A): Head of Payment Ops
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4276_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4276_End9" name="Complete">
        <bpmn:incoming>W4276_Flow15</bpmn:incoming>
      </bpmn:endEvent>
