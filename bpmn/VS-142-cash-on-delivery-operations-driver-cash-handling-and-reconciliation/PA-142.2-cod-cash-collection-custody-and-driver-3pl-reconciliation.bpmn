<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-142.2-cod-cash-collection-custody-and-driver-3pl-reconciliation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4273" name="W4273. COD Order Handoff, Delivery Note &amp; Amount-Due Computation" isExecutable="false">
      <bpmn:documentation>Trigger: COD order released for fulfillment (VS-10.2)
Frequency: Per COD order (~4,000–8,000/month, a ~23–47% COD share of the ~17,200 delivery orders)
Volume: Each COD order with an amount-due for collection
Owner: Ecommerce/Order Mgmt (VS-10) / Last-Mile Dispatch (VS-06.3)
Participants: Payment Ops, Pricing (VS-01.2), Delivery Driver/3PL (VS-56)
Source: workflow W4273 — COD Order Handoff, Delivery Note &amp; Amount-Due Computation</bpmn:documentation>
      <bpmn:laneSet id="W4273_LaneSet3">
        <bpmn:lane id="W4273_Lane1" name="Order Mgmt">
        <bpmn:flowNodeRef>W4273_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4273_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4273_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4273_Lane2" name="Payment Ops">
        <bpmn:flowNodeRef>W4273_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4273_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4273_Start4" name="COD order released for fulfillment (VS-10.2)">
        <bpmn:outgoing>W4273_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4273_Task5" name="Order Mgmt/Payment Ops compute the exact COD amount-due (item total + COD fee…">
        <bpmn:documentation>Step 1: Order Mgmt/Payment Ops compute the exact COD amount-due (item total + COD fee W4267 − pre-paid deposit − loyalty redemption + delivery fee), apply risk-tier auth (W4266), and freeze the amount on the delivery note
Responsible (R): Order Mgmt / Payment Ops
Accountable (A): Head of Payment Ops
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4273_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4273_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4273_Task6" name="Order Mgmt/Last-Mile generate the COD delivery note (amount-due, item list…">
        <bpmn:documentation>Step 2: Order Mgmt/Last-Mile generate the COD delivery note (amount-due, item list, customer ID, payment-instruction) and hand off to the driver/3PL via the delivery app (VS-06.3), flagging COD vs pre-paid
Responsible (R): Order Mgmt / Dispatch
Accountable (A): Head of Payment Ops
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4273_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4273_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4273_Task7" name="Payment Ops monitor COD handoff completeness (every COD order has a locked…">
        <bpmn:documentation>Step 3: Payment Ops monitor COD handoff completeness (every COD order has a locked amount-due + assigned driver), and flag undelivered/COD-released exceptions
Responsible (R): Payment Ops
Accountable (A): Head of Payment Ops
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4273_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4273_End8" name="Complete">
        <bpmn:incoming>W4273_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4273_Annotation9">
        <bpmn:text>Controls: - CTL-657 (ensure controlled execution — COD Cash Collection, Custody &amp; Driver/3PL Reconciliation (PA-142.2).) | - CTL-657: amount-due system-computed &amp; locked; risk-tier auth applied (W4266); handoff completeness monitored
Owner: Ecommerce/Order Mgmt (VS-10) / Last-Mile Dispatch (VS-06.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4273_Assoc10" sourceRef="W4273_Annotation9" targetRef="W4273_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4273_Flow11" sourceRef="W4273_Start4" targetRef="W4273_Task5" />
      <bpmn:sequenceFlow id="W4273_Flow12" sourceRef="W4273_Task5" targetRef="W4273_Task6" />
      <bpmn:sequenceFlow id="W4273_Flow13" sourceRef="W4273_Task6" targetRef="W4273_Task7" />
      <bpmn:sequenceFlow id="W4273_Flow14" sourceRef="W4273_Task7" targetRef="W4273_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4273_diag">
      <bpmndi:BPMNPlane id="W4273_plane" bpmnElement="W_W4273">
        <bpmndi:BPMNShape id="W4273_Lane1_di" bpmnElement="W4273_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Lane2_di" bpmnElement="W4273_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Task5_di" bpmnElement="W4273_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Task6_di" bpmnElement="W4273_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Task7_di" bpmnElement="W4273_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Start4_di" bpmnElement="W4273_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_End8_di" bpmnElement="W4273_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4273_Annotation9_di" bpmnElement="W4273_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
