    <bpmn:process id="W_W3472" name="W3472. Renewable Energy Program Strategy, Policy &amp; Executive/Board Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual strategy/policy review; board cycle (links to VS-36)
Frequency: Annual + quarterly
Volume: Program-wide
Owner: Sustainability/ESG Manager
Participants: Sustainability/ESG Manager, Energy Manager, CFO, COO, Risk (links to VS-21.2), Board/Sustainability Committee (links to VS-36)
Source: workflow W3472 — Renewable Energy Program Strategy, Policy &amp; Executive/Board Governance</bpmn:documentation>
      <bpmn:laneSet id="W3472_LaneSet4">
        <bpmn:lane id="W3472_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W3472_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3472_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3472_Lane2" name="Energy Manager">
        <bpmn:flowNodeRef>W3472_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3472_Lane3" name="CFO">
        <bpmn:flowNodeRef>W3472_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3472_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3472_Start5" name="Annual strategy/policy review; board cycle (links to VS-36)">
        <bpmn:outgoing>W3472_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3472_Task6" name="Sustainability/ESG Manager/Energy Manager maintain the renewable-energy program…">
        <bpmn:documentation>Step 1: Sustainability/ESG Manager/Energy Manager maintain the renewable-energy program strategy and policy: generation targets, ownership-model preference (W3455), investment limits (links to VS-40), O&amp;M/asset-management standards, ESG-attribute policy (W3465), and authority matrix; align to corporate strategy (links to VS-33) and ESG plan (links to VS-25)
Responsible (R): Sustainability/ESG Manager / Energy Manager
Accountable (A): CSO / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3472_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3472_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3472_Task7" name="Energy Manager/Sustainability/ESG Manager conduct the quarterly program review…">
        <bpmn:documentation>Step 2: Energy Manager/Sustainability/ESG Manager conduct the quarterly program review: portfolio performance (W3467), benefits realization (W3468), roadmap progress (W3449), risk/insurance (W3471), and disclosure readiness (W3470); decide program adjustments and resource allocation
Responsible (R): Energy Manager / Sustainability/ESG Manager
Accountable (A): CSO / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3472_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3472_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3472_Task8" name="CFO/CSO report the renewable-energy program (performance, investment, risk, ESG…">
        <bpmn:documentation>Step 3: CFO/CSO report the renewable-energy program (performance, investment, risk, ESG contribution) to the executive committee (links to VS-33.2) and Board/Sustainability Committee (links to VS-36); ensure alignment with the capital, ESG, and resilience strategy and approve policy updates
Responsible (R): CFO / CSO
Accountable (A): Board
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3472_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3472_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3472_End9" name="Complete">
        <bpmn:incoming>W3472_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3472_Annotation10">
        <bpmn:text>Controls: - CTL-555 (ensure controlled execution — Renewable Asset Performance, REC &amp; Decarbonization Analytics (PA-108.3).) | - operational: annual review and board oversight; operational: roadmap governance and target tracking
Owner: Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3472_Assoc11" sourceRef="W3472_Annotation10" targetRef="W3472_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3472_Flow12" sourceRef="W3472_Start5" targetRef="W3472_Task6" />
      <bpmn:sequenceFlow id="W3472_Flow13" sourceRef="W3472_Task6" targetRef="W3472_Task7" />
      <bpmn:sequenceFlow id="W3472_Flow14" sourceRef="W3472_Task7" targetRef="W3472_Task8" />
      <bpmn:sequenceFlow id="W3472_Flow15" sourceRef="W3472_Task8" targetRef="W3472_End9" />
    </bpmn:process>
