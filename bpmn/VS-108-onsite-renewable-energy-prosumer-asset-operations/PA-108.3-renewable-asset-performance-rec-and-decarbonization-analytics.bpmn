    <bpmn:process id="W_W3470" name="W3470. ESG/Sustainability Disclosure &amp; Climate Reporting Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Annual ESG/SEC/IFRS S2 reporting (links to VS-25.3); assurance cycle
Frequency: Annual + interim
Volume: Group renewable portfolio
Owner: Sustainability/ESG Manager
Participants: Sustainability/ESG Manager (links to VS-25), Energy Manager, Finance (links to VS-17), Legal (links to VS-100), Assurance (links to VS-21/W341)
Source: workflow W3470 — ESG/Sustainability Disclosure &amp; Climate Reporting Integration</bpmn:documentation>
      <bpmn:laneSet id="W3470_LaneSet3">
        <bpmn:lane id="W3470_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W3470_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3470_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3470_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
