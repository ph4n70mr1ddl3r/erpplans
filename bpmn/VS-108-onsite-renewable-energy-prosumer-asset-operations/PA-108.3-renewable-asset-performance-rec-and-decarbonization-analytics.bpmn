        <bpmn:flowNodeRef>W3471_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3471_Start4" name="Annual risk review (links to VS-21.2); insurance cycle (links to VS-26)">
        <bpmn:outgoing>W3471_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3471_Task5" name="Energy Manager/Risk maintain the renewable-portfolio risk view…">
        <bpmn:documentation>Step 1: Energy Manager/Risk maintain the renewable-portfolio risk view: technology/manufacturer risk, weather/climate risk (typhoon links to VS-69), regulatory risk (net-metering/export links to W3462), fire/safety risk (W3464), cyber risk (SCADA/monitoring links to VS-27.3), and counterparty risk (PPA/lease/EPC/O&amp;M); integrate to ERM (links to VS-21.2)
Responsible (R): Energy Manager / Risk
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3471_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3471_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3471_Task6" name="Insurance/Risk ensure adequate coverage for the renewable assets (property…">
        <bpmn:documentation>Step 2: Insurance/Risk ensure adequate coverage for the renewable assets (property, business interruption, third-party liability, cyber) within the group insurance program (links to VS-26.3/W59), set deductibles/limits, and manage claims (links to W3464); review annually
Responsible (R): Insurance / Risk / Finance
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3471_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3471_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3471_Task7" name="Energy Manager/Risk report portfolio risk, resilience, and insurance status to…">
        <bpmn:documentation>Step 3: Energy Manager/Risk report portfolio risk, resilience, and insurance status to executives (links to VS-33.2) and the risk/audit committee (links to VS-36/VS-21); ensure controls, BCP (links to VS-26), and incident readiness (W3464) are maintained
Responsible (R): Energy Manager / Risk
Accountable (A): Board / Audit Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3471_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3471_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3471_End8" name="Complete">
        <bpmn:incoming>W3471_Flow14</bpmn:incoming>
      </bpmn:endEvent>
