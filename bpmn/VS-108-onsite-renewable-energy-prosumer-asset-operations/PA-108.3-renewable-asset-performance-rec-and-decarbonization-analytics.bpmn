        <bpmndi:BPMNEdge id="W3465_Flow11_di" bpmnElement="W3465_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3465_Flow12_di" bpmnElement="W3465_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3465_Flow13_di" bpmnElement="W3465_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3465_Assoc9_di" bpmnElement="W3465_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3466" name="W3466. GHG Emissions Reduction Accounting &amp; Scope 2 Attribution" isExecutable="false">
      <bpmn:documentation>Trigger: Annual GHG inventory (links to VS-25.1/W192); ESG reporting cycle
Frequency: Annual + quarterly tracking
Volume: Portfolio generation vs consumption
Owner: Sustainability/ESG Manager
Participants: Sustainability/ESG Manager (links to VS-25), Energy Manager, Finance (links to VS-17.4), External Assurance (links to VS-21/W341)
Source: workflow W3466 — GHG Emissions Reduction Accounting &amp; Scope 2 Attribution</bpmn:documentation>
      <bpmn:laneSet id="W3466_LaneSet2">
        <bpmn:lane id="W3466_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W3466_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3466_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3466_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3466_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3466_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3466_Start3" name="Annual GHG inventory (links to VS-25.1/W192); ESG reporting cycle">
        <bpmn:outgoing>W3466_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3466_Task4" name="Sustainability/Energy Manager compute renewable contribution to Scope 2…">
        <bpmn:documentation>Step 1: Sustainability/Energy Manager compute renewable contribution to Scope 2 (location-based and market-based): self-generated MWh (W3457) reducing grid import, and retired RECs (W3465) reducing market-based Scope 2; reconcile to the GHG inventory (links to VS-25.1/W192)
Responsible (R): Sustainability / Energy Manager
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3466_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3466_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3466_Task5" name="Sustainability/Finance compute the emissions avoided (tCO2e) vs the grid…">
        <bpmn:documentation>Step 2: Sustainability/Finance compute the emissions avoided (tCO2e) vs the grid emission factor, validate methodology against GHG Protocol/SEC/IFRS S2 and external assurance (links to VS-21/W341 ESG assurance audit), and document for disclosure
Responsible (R): Sustainability / Finance / Assurance
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3466_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3466_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3466_Task6" name="Sustainability report Scope 2 reduction and progress vs the decarbonization…">
        <bpmn:documentation>Step 3: Sustainability report Scope 2 reduction and progress vs the decarbonization target (links to VS-25.1/VS-25.3) to the ESG review and integrate to climate disclosure (W3470); feed outcomes to the renewable roadmap (W3449) and governance (W3472)
Responsible (R): Sustainability
Accountable (A): Sustainability/ESG Manager / CSO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3466_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3466_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3466_End7" name="Complete">
        <bpmn:incoming>W3466_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3466_Annotation8">
        <bpmn:text>Controls: - CTL-555 (ensure controlled execution — Renewable Asset Performance, REC &amp; Decarbonization Analytics (PA-108.3).) | - operational: GHG Protocol adherence and assurance; operational: attribution discipline (W3465)
Owner: Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3466_Assoc9" sourceRef="W3466_Annotation8" targetRef="W3466_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3466_Flow10" sourceRef="W3466_Start3" targetRef="W3466_Task4" />
      <bpmn:sequenceFlow id="W3466_Flow11" sourceRef="W3466_Task4" targetRef="W3466_Task5" />
      <bpmn:sequenceFlow id="W3466_Flow12" sourceRef="W3466_Task5" targetRef="W3466_Task6" />
      <bpmn:sequenceFlow id="W3466_Flow13" sourceRef="W3466_Task6" targetRef="W3466_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3466_diag">
      <bpmndi:BPMNPlane id="W3466_plane" bpmnElement="W_W3466">
        <bpmndi:BPMNShape id="W3466_Lane1_di" bpmnElement="W3466_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_Task4_di" bpmnElement="W3466_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_Task5_di" bpmnElement="W3466_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_Task6_di" bpmnElement="W3466_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_Start3_di" bpmnElement="W3466_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_End7_di" bpmnElement="W3466_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3466_Annotation8_di" bpmnElement="W3466_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3466_Flow10_di" bpmnElement="W3466_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3466_Flow11_di" bpmnElement="W3466_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3466_Flow12_di" bpmnElement="W3466_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3466_Flow13_di" bpmnElement="W3466_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3466_Assoc9_di" bpmnElement="W3466_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3467" name="W3467. Renewable Asset Performance Benchmarking &amp; Portfolio Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly review; site comparison
Frequency: Monthly + quarterly
Volume: All commissioned sites
Owner: Energy Manager
Participants: Energy Manager, BI (links to VS-28.1), Sustainability/ESG Manager, Facilities (links to VS-20.3)
Source: workflow W3467 — Renewable Asset Performance Benchmarking &amp; Portfolio Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3467_LaneSet2">
        <bpmn:lane id="W3467_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3467_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3467_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3467_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3467_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3467_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3467_Start3" name="Monthly/quarterly review; site comparison">
        <bpmn:outgoing>W3467_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3467_Task4" name="Energy Manager/BI compute per-site and portfolio KPIs: specific yield…">
        <bpmn:documentation>Step 1: Energy Manager/BI compute per-site and portfolio KPIs: specific yield (kWh/kWp), performance ratio, availability, capacity factor, self-consumption ratio, and savings (W3463); benchmark sites against each other, against Pvsyst expectation (W3450), and against industry
Responsible (R): Energy Manager / BI
Accountable (A): Energy Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3467_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3467_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3467_Task5" name="Energy Manager/Sustainability identify top/bottom performers, root-cause…">
        <bpmn:documentation>Step 2: Energy Manager/Sustainability identify top/bottom performers, root-cause variance (orientation, soiling, O&amp;M quality, degradation, shading, DU issues), and best-practice transfer across sites; prioritize under-performers for action (W3459/W3460)
Responsible (R): Energy Manager / Sustainability / Facilities
Accountable (A): Energy Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3467_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3467_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3467_Task6" name="Energy Manager publish the portfolio performance dashboard, feed insights to…">
        <bpmn:documentation>Step 3: Energy Manager publish the portfolio performance dashboard, feed insights to the roadmap (W3449), O&amp;M vendor scorecard (links to VS-67), and asset-renewal planning (W3469); report to governance (W3472)
Responsible (R): Energy Manager / BI
Accountable (A): Sustainability/ESG Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3467_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3467_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3467_End7" name="Complete">
        <bpmn:incoming>W3467_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3467_Annotation8">
        <bpmn:text>Controls: - CTL-555 (ensure controlled execution — Renewable Asset Performance, REC &amp; Decarbonization Analytics (PA-108.3).) | - operational: normalization; operational: root-cause and action tracking
Owner: Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3467_Assoc9" sourceRef="W3467_Annotation8" targetRef="W3467_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3467_Flow10" sourceRef="W3467_Start3" targetRef="W3467_Task4" />
      <bpmn:sequenceFlow id="W3467_Flow11" sourceRef="W3467_Task4" targetRef="W3467_Task5" />
      <bpmn:sequenceFlow id="W3467_Flow12" sourceRef="W3467_Task5" targetRef="W3467_Task6" />
      <bpmn:sequenceFlow id="W3467_Flow13" sourceRef="W3467_Task6" targetRef="W3467_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3467_diag">
      <bpmndi:BPMNPlane id="W3467_plane" bpmnElement="W_W3467">
        <bpmndi:BPMNShape id="W3467_Lane1_di" bpmnElement="W3467_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_Task4_di" bpmnElement="W3467_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_Task5_di" bpmnElement="W3467_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_Task6_di" bpmnElement="W3467_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_Start3_di" bpmnElement="W3467_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_End7_di" bpmnElement="W3467_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3467_Annotation8_di" bpmnElement="W3467_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3467_Flow10_di" bpmnElement="W3467_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3467_Flow11_di" bpmnElement="W3467_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3467_Flow12_di" bpmnElement="W3467_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3467_Flow13_di" bpmnElement="W3467_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3467_Assoc9_di" bpmnElement="W3467_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3468" name="W3468. Renewable Investment ROI, Savings Realization &amp; Benefits Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly cycle; annual review
Frequency: Monthly + quarterly + annual (per the Trigger and step 2 cadence)
Volume: Portfolio + per-site
Owner: Energy Manager
Participants: Energy Manager, Finance (links to VS-17.4/VS-40), Treasury (links to VS-18), Sustainability/ESG Manager
Source: workflow W3468 — Renewable Investment ROI, Savings Realization &amp; Benefits Tracking</bpmn:documentation>
      <bpmn:laneSet id="W3468_LaneSet3">
        <bpmn:lane id="W3468_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3468_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3468_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3468_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3468_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3468_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3468_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3468_Start4" name="Monthly/quarterly cycle; annual review">
        <bpmn:outgoing>W3468_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3468_Task5" name="Energy Manager/Finance track benefits realization per site: actual savings…">
        <bpmn:documentation>Step 1: Energy Manager/Finance track benefits realization per site: actual savings (W3463), REC revenue (W3465), avoided emissions value, resilience value, and incentive captured, vs the business case (W3451); compute actual payback/IRR vs plan
Responsible (R): Energy Manager / Finance
Accountable (A): Energy Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3468_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3468_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3468_Task6" name="Finance/Energy Manager reconcile benefits to the capex investment (links to…">
        <bpmn:documentation>Step 2: Finance/Energy Manager reconcile benefits to the capex investment (links to VS-40) and operating cost (O&amp;M, insurance, financing), compute portfolio ROI, and identify benefit shortfalls and drivers (yield, tariff, O&amp;M overrun)
Responsible (R): Finance / Energy Manager
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3468_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3468_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3468_Task7" name="Energy Manager/CFO report ROI and benefits realization to the performance…">
        <bpmn:documentation>Step 3: Energy Manager/CFO report ROI and benefits realization to the performance review (W3472) and executives (links to VS-33.2); re-baseline laggard sites and feed learning to future projects (W3449/W3451)
Responsible (R): Energy Manager / CFO
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3468_Flow13</bpmn:incoming>
