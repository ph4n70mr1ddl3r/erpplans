<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-108.3-renewable-asset-performance-rec-and-decarbonization-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3465" name="W3465. Renewable Energy Certificate (REC) / Carbon Offset Generation, Registry &amp; Trading" isExecutable="false">
      <bpmn:documentation>Trigger: Generation (W3457); REC market opportunity; ESG disclosure cycle
Frequency: Monthly/quarterly
Volume: Portfolio generation (MWh/yr)
Owner: Sustainability/ESG Manager
Participants: Sustainability/ESG Manager (links to VS-25), Energy Manager, Finance (links to VS-17), Legal (links to VS-100.3), REC Registry/Broker
Source: workflow W3465 — Renewable Energy Certificate (REC) / Carbon Offset Generation, Registry &amp; Trading</bpmn:documentation>
      <bpmn:laneSet id="W3465_LaneSet2">
        <bpmn:lane id="W3465_Lane1" name="Sustainability">
        <bpmn:flowNodeRef>W3465_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3465_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3465_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3465_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3465_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3465_Start3" name="Generation (W3457); REC market opportunity; ESG disclosure cycle">
        <bpmn:outgoing>W3465_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3465_Task4" name="Sustainability/Energy Manager determine REC/offset eligibility and ownership…">
        <bpmn:documentation>Step 1: Sustainability/Energy Manager determine REC/offset eligibility and ownership per ownership model (W3455): own-and-operate → BuildRight owns RECs; PPA/lease → attribute ownership per contract; register eligible generation with the recognized REC registry (e.g., I-REC)
Responsible (R): Sustainability / Energy Manager / Legal
Accountable (A): Sustainability/ESG Manager
Duration: Per site/period</bpmn:documentation>
        <bpmn:incoming>W3465_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3465_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3465_Task5" name="Sustainability/Finance create/retire/trade RECs per strategy: retire to support…">
        <bpmn:documentation>Step 2: Sustainability/Finance create/retire/trade RECs per strategy: retire to support BuildRight&#x27;s own Scope 2/RE100 claim (W3466), or sell/trade for revenue where the claim is not needed; manage registry account, serialization, and transactions
Responsible (R): Sustainability / Finance / Broker
Accountable (A): CFO
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3465_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3465_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3465_Task6" name="Sustainability/Legal document REC creation/retire/trade for audit (links to…">
        <bpmn:documentation>Step 3: Sustainability/Legal document REC creation/retire/trade for audit (links to VS-21) and ESG disclosure (links to VS-25.3/W3470), ensure no double-counting (own-use vs sold), and report REC outcome to the performance review (W3468) and governance (W3472)
Responsible (R): Sustainability / Legal / Finance
Accountable (A): Sustainability/ESG Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3465_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3465_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3465_End7" name="Complete">
        <bpmn:incoming>W3465_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3465_Annotation8">
        <bpmn:text>Controls: - CTL-555 (ensure controlled execution — Renewable Asset Performance, REC &amp; Decarbonization Analytics (PA-108.3).) | - operational: clear attribution and registry discipline; operational: contract clause (W3455)
Owner: Sustainability/ESG Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3465_Assoc9" sourceRef="W3465_Annotation8" targetRef="W3465_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3465_Flow10" sourceRef="W3465_Start3" targetRef="W3465_Task4" />
      <bpmn:sequenceFlow id="W3465_Flow11" sourceRef="W3465_Task4" targetRef="W3465_Task5" />
      <bpmn:sequenceFlow id="W3465_Flow12" sourceRef="W3465_Task5" targetRef="W3465_Task6" />
      <bpmn:sequenceFlow id="W3465_Flow13" sourceRef="W3465_Task6" targetRef="W3465_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3465_diag">
      <bpmndi:BPMNPlane id="W3465_plane" bpmnElement="W_W3465">
        <bpmndi:BPMNShape id="W3465_Lane1_di" bpmnElement="W3465_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_Task4_di" bpmnElement="W3465_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_Task5_di" bpmnElement="W3465_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_Task6_di" bpmnElement="W3465_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_Start3_di" bpmnElement="W3465_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_End7_di" bpmnElement="W3465_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3465_Annotation8_di" bpmnElement="W3465_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
