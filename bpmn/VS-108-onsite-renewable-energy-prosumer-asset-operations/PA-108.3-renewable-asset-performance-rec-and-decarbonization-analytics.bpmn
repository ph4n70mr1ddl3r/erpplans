    <bpmn:process id="W_W3471" name="W3471. Renewable Portfolio Risk, Resilience &amp; Insurance Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual risk review (links to VS-21.2); insurance cycle (links to VS-26)
Frequency: Annual + event-driven
Volume: Portfolio
Owner: Energy Manager
Participants: Energy Manager, Risk (links to VS-21.2), Insurance (links to VS-26), HSE (links to VS-24), Finance (links to VS-17)
Source: workflow W3471 — Renewable Portfolio Risk, Resilience &amp; Insurance Governance</bpmn:documentation>
      <bpmn:laneSet id="W3471_LaneSet3">
        <bpmn:lane id="W3471_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3471_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3471_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3471_Start4</bpmn:flowNodeRef>
