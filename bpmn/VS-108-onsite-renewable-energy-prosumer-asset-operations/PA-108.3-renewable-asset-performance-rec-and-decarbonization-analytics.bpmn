        <bpmn:flowNodeRef>W3470_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3470_Start4" name="Annual ESG/SEC/IFRS S2 reporting (links to VS-25.3); assurance cycle">
        <bpmn:outgoing>W3470_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3470_Task5" name="Sustainability/Energy Manager compile renewable-energy data for ESG/climate…">
        <bpmn:documentation>Step 1: Sustainability/Energy Manager compile renewable-energy data for ESG/climate disclosure: generation, self-consumption, export, Scope 2 reduction (W3466), REC retirement (W3465), capacity, and investment; align to reporting frameworks (GRI, SASB, TCFD/IFRS S2, SEC) per the ESG reporting standard (links to VS-25.3)
Responsible (R): Sustainability / Energy Manager
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3470_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3470_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3470_Task6" name="Finance/Legal validate the disclosure for accuracy and consistency with…">
        <bpmn:documentation>Step 2: Finance/Legal validate the disclosure for accuracy and consistency with financial statements (links to VS-17), green-finance use-of-proceeds reporting (if green-loan links to W3451), and regulatory requirements; obtain external assurance (links to VS-21/W341)
Responsible (R): Finance / Legal / Assurance
Accountable (A): CFO / CSO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3470_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3470_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3470_Task7" name="Sustainability publish the disclosure (sustainability report, climate report…">
        <bpmn:documentation>Step 3: Sustainability publish the disclosure (sustainability report, climate report, investor/lender reporting), integrate to the ESG narrative (links to VS-25), and report to the board/sustainability committee (links to VS-36); ensure forward targets are credible and tracked (W3472)
Responsible (R): Sustainability / Legal
Accountable (A): Board / Sustainability Committee
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3470_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3470_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3470_End8" name="Complete">
        <bpmn:incoming>W3470_Flow14</bpmn:incoming>
      </bpmn:endEvent>
