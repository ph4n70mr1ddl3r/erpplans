      <bpmndi:BPMNPlane id="W3459_plane" bpmnElement="W_W3459">
        <bpmndi:BPMNShape id="W3459_Lane1_di" bpmnElement="W3459_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3459_Lane2_di" bpmnElement="W3459_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
