      <bpmn:sequenceFlow id="W3459_Flow13" sourceRef="W3459_Task6" targetRef="W3459_Task7" />
      <bpmn:sequenceFlow id="W3459_Flow14" sourceRef="W3459_Task7" targetRef="W3459_End8" />
    </bpmn:process>
