      <bpmn:sequenceFlow id="W3464_Flow13" sourceRef="W3464_Task6" targetRef="W3464_Task7" />
      <bpmn:sequenceFlow id="W3464_Flow14" sourceRef="W3464_Task7" targetRef="W3464_End8" />
    </bpmn:process>
