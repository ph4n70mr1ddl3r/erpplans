        <bpmndi:BPMNShape id="W3458_Annotation8_di" bpmnElement="W3458_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3458_Flow10_di" bpmnElement="W3458_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3458_Flow11_di" bpmnElement="W3458_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3458_Flow12_di" bpmnElement="W3458_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3458_Flow13_di" bpmnElement="W3458_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3458_Assoc9_di" bpmnElement="W3458_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3459" name="W3459. Asset Operations &amp; Maintenance (O&amp;M), Cleaning &amp; Troubleshooting" isExecutable="false">
      <bpmn:documentation>Trigger: Performance alert (W3457); scheduled PM; soiling/degradation
Frequency: Scheduled PM + reactive
Volume: All sites; PM quarterly/semi-annual
Owner: Energy Manager
Participants: Energy Manager, Facilities (links to VS-20.3), O&amp;M Vendor, HSE (links to VS-24)
Source: workflow W3459 — Asset Operations &amp; Maintenance (O&amp;M), Cleaning &amp; Troubleshooting</bpmn:documentation>
      <bpmn:laneSet id="W3459_LaneSet3">
        <bpmn:lane id="W3459_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3459_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3459_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3459_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3459_Lane2" name="O&amp;M">
        <bpmn:flowNodeRef>W3459_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3459_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3459_Start4" name="Performance alert (W3457); scheduled PM; soiling/degradation">
        <bpmn:outgoing>W3459_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3459_Task5" name="Energy Manager/Facilities maintain the O&amp;M plan: scheduled preventive…">
        <bpmn:documentation>Step 1: Energy Manager/Facilities maintain the O&amp;M plan: scheduled preventive maintenance (module cleaning, torque checks, thermography, inverter service, BESS maintenance), spare-parts inventory, and the O&amp;M vendor SLA (links to VS-34.2 service-provider management); align to facility PM (links to VS-20.3/W240)
Responsible (R): Energy Manager / Facilities
Accountable (A): Energy Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3459_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3459_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3459_Task6" name="O&amp;M Vendor/Facilities execute scheduled PM and reactive troubleshooting…">
        <bpmn:documentation>Step 2: O&amp;M Vendor/Facilities execute scheduled PM and reactive troubleshooting (dispatched from W3457 alerts): cleaning, component repair/replacement, electrical/mechanical checks, and HSE compliance (links to VS-24 working-at-height, electrical safety); document work
Responsible (R): O&amp;M / Facilities / HSE
Accountable (A): Energy Manager
Duration: Per PM/event</bpmn:documentation>
        <bpmn:incoming>W3459_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3459_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3459_Task7" name="Energy Manager verify O&amp;M completion and performance recovery, capture…">
        <bpmn:documentation>Step 3: Energy Manager verify O&amp;M completion and performance recovery, capture maintenance history in the asset register (links to VS-35/W400), track O&amp;M cost vs budget, and feed reliability data to the performance review (W3471) and asset-renewal planning (links to VS-35)
Responsible (R): Energy Manager / Facilities
Accountable (A): Energy Manager
Duration: Per PM/event</bpmn:documentation>
        <bpmn:incoming>W3459_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3459_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3459_End8" name="Complete">
        <bpmn:incoming>W3459_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3459_Annotation9">
        <bpmn:text>Controls: - CTL-554 (ensure controlled execution — Generation Operations, Grid Interaction &amp; Net-Metering (PA-108.2).) | - operational: cleaning PM and soiling analytics; operational: SLA and scorecard (links to VS-67)
Owner: Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3459_Assoc10" sourceRef="W3459_Annotation9" targetRef="W3459_Start4" associationDirection="None" />
