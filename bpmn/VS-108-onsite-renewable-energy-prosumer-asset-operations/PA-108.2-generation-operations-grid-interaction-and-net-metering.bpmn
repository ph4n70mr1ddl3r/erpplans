        <bpmn:flowNodeRef>W3462_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3462_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3462_Lane2" name="Compliance">
        <bpmn:flowNodeRef>W3462_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3462_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3462_Start4" name="Pre-energization (W3454); regulatory change">
        <bpmn:outgoing>W3462_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3462_Task5" name="Energy Manager/Compliance register the renewable system with the DU and ERC for…">
        <bpmn:documentation>Step 1: Energy Manager/Compliance register the renewable system with the DU and ERC for net-metering (RE Act / net-metering rules): submit application, specs, single-line diagram, structural/electrical certification, and fees; secure the Certificate of Completion and net-metering agreement
Responsible (R): Energy Manager / Compliance / DU
Accountable (A): Energy Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3462_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3462_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3462_Task6" name="Energy Manager/Legal execute the net-metering/interconnection agreement with…">
        <bpmn:documentation>Step 2: Energy Manager/Legal execute the net-metering/interconnection agreement with the DU: import/export meter installation (bi-directional), export pricing/terms, compliance with DU/ERC technical standards, and anti-islanding; ensure multi-site consistency across DUs/regions (links to VS-76)
Responsible (R): Energy Manager / Legal / DU
Accountable (A): Energy Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3462_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3462_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3462_Task7" name="Compliance/Energy Manager monitor ongoing regulatory compliance: DU…">
        <bpmn:documentation>Step 3: Compliance/Energy Manager monitor ongoing regulatory compliance: DU inspections, meter calibration, rule changes (net-metering caps, export pricing, RE Act amendments links to VS-22.3), and reporting; manage renewals and disputes (links to VS-100)
Responsible (R): Compliance / Energy Manager
Accountable (A): Sustainability/ESG Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3462_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3462_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3462_End8" name="Complete">
        <bpmn:incoming>W3462_Flow14</bpmn:incoming>
      </bpmn:endEvent>
