<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-108.1-renewable-generation-investment-capex-and-project-development" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3449" name="W3449. Renewable Generation Portfolio Strategy &amp; Site Prioritization" isExecutable="false">
      <bpmn:documentation>Trigger: Annual ESG/energy strategy (links to VS-25); portfolio capacity planning
Frequency: Annual + multi-year roadmap
Volume: ~205 candidate sites (200 stores + 4 DCs + HQ)
Owner: Sustainability/ESG Manager / Energy Manager
Participants: Energy Manager, Sustainability/ESG Manager (links to VS-25), Real Estate (links to VS-20/VS-97), Finance (links to VS-17/VS-40), Facilities (links to VS-20.3)
Source: workflow W3449 — Renewable Generation Portfolio Strategy &amp; Site Prioritization</bpmn:documentation>
      <bpmn:laneSet id="W3449_LaneSet3">
        <bpmn:lane id="W3449_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3449_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3449_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3449_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3449_Lane2" name="CFO">
        <bpmn:flowNodeRef>W3449_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3449_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3449_Start4" name="Annual ESG/energy strategy (links to VS-25); portfolio capacity planning">
        <bpmn:outgoing>W3449_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3449_Task5" name="Energy Manager/Sustainability develop the renewable-portfolio strategy: target…">
        <bpmn:documentation>Step 1: Energy Manager/Sustainability develop the renewable-portfolio strategy: target self-generation %, capex envelope and phasing, ownership-model preference (own/lease/PPA per W3455), alignment to the ESG/decarbonization target (links to VS-25.1/W192 GHG) and grid-resilience need (links to VS-07/W470), and store/DC/HQ prioritization criteria
Responsible (R): Energy Manager / Sustainability
Accountable (A): COO / CSO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3449_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3449_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3449_Task6" name="Energy Manager/Real Estate score and prioritize candidate sites: roof…">
        <bpmn:documentation>Step 2: Energy Manager/Real Estate score and prioritize candidate sites: roof area/condition/orientation/shading, structural capacity, site consumption profile (links to W111), DU/tariff and net-metering feasibility (links to W3462), and business-case attractiveness (W3451); produce the multi-year build roadmap
Responsible (R): Energy Manager / Real Estate
Accountable (A): Sustainability/ESG Manager
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3449_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3449_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3449_Task7" name="CFO/COO approve the portfolio strategy and roadmap, sequence capex against the…">
        <bpmn:documentation>Step 3: CFO/COO approve the portfolio strategy and roadmap, sequence capex against the corporate capex plan (links to VS-40/VS-33.1) and working capital (links to VS-105), and set the program governance (links to W3472); integrate to the ESG/sustainability plan (links to VS-25.3)
Responsible (R): CFO / COO
Accountable (A): CEO / Board
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3449_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3449_End8" name="Complete">
        <bpmn:incoming>W3449_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3449_Annotation9">
        <bpmn:text>Controls: - CTL-553 (ensure controlled execution — Renewable Generation Investment, Capex &amp; Project Development (PA-108.1).) | - operational: rigorous scoring (W3450); operational: portfolio governance and phasing
Owner: Sustainability/ESG Manager / Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3449_Assoc10" sourceRef="W3449_Annotation9" targetRef="W3449_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3449_Flow11" sourceRef="W3449_Start4" targetRef="W3449_Task5" />
      <bpmn:sequenceFlow id="W3449_Flow12" sourceRef="W3449_Task5" targetRef="W3449_Task6" />
      <bpmn:sequenceFlow id="W3449_Flow13" sourceRef="W3449_Task6" targetRef="W3449_Task7" />
      <bpmn:sequenceFlow id="W3449_Flow14" sourceRef="W3449_Task7" targetRef="W3449_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3449_diag">
      <bpmndi:BPMNPlane id="W3449_plane" bpmnElement="W_W3449">
        <bpmndi:BPMNShape id="W3449_Lane1_di" bpmnElement="W3449_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Lane2_di" bpmnElement="W3449_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Task5_di" bpmnElement="W3449_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Task6_di" bpmnElement="W3449_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Task7_di" bpmnElement="W3449_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Start4_di" bpmnElement="W3449_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_End8_di" bpmnElement="W3449_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3449_Annotation9_di" bpmnElement="W3449_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3449_Flow11_di" bpmnElement="W3449_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3449_Flow12_di" bpmnElement="W3449_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3449_Flow13_di" bpmnElement="W3449_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3449_Flow14_di" bpmnElement="W3449_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3449_Assoc10_di" bpmnElement="W3449_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3450" name="W3450. Site Feasibility, Solar Resource Assessment &amp; Structural/Capacity Evaluation" isExecutable="false">
      <bpmn:documentation>Trigger: Site shortlisted (W3449)
Frequency: Per site
Volume: ~10–30 sites/year per roadmap
Owner: Energy Manager
Participants: Energy Manager, EPC/Engineering consultant, Real Estate (links to VS-20), Facilities (links to VS-20.3), Structural Engineer
Source: workflow W3450 — Site Feasibility, Solar Resource Assessment &amp; Structural/Capacity Evaluation</bpmn:documentation>
      <bpmn:laneSet id="W3450_LaneSet3">
        <bpmn:lane id="W3450_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3450_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3450_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3450_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3450_Lane2" name="EPC">
        <bpmn:flowNodeRef>W3450_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3450_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3450_Start4" name="Site shortlisted (W3449)">
        <bpmn:outgoing>W3450_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3450_Task5" name="Energy Manager/EPC conduct site feasibility: solar resource assessment…">
        <bpmn:documentation>Step 1: Energy Manager/EPC conduct site feasibility: solar resource assessment (irradiance/yield via PVsyst/satellite data), roof survey (area, orientation, tilt, shading, penetration), structural evaluation (roof load capacity for PV + access), electrical/interconnection point, and site consumption matching
Responsible (R): Energy Manager / EPC
Accountable (A): Sustainability/ESG Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3450_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3450_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3450_Task6" name="EPC/Engineering size the system: kWp capacity, inverter type, optional battery…">
        <bpmn:documentation>Step 2: EPC/Engineering size the system: kWp capacity, inverter type, optional battery storage (BESS), mounting (roof/carport/ground), generation estimate (kWh/yr), self-consumption ratio, and export potential; identify constraints (heritage, CAAP height clearance links to VS-22/W480, structural reinforcement)
Responsible (R): EPC / Engineering
Accountable (A): Energy Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3450_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3450_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3450_Task7" name="Energy Manager compile the feasibility report with go/no-go recommendation…">
        <bpmn:documentation>Step 3: Energy Manager compile the feasibility report with go/no-go recommendation, expected generation, capex/payback (W3451), risks, and interconnection/net-metering feasibility (W3462); obtain Real Estate/Facilities sign-off and proceed to business case
Responsible (R): Energy Manager / Real Estate / Facilities
Accountable (A): Sustainability/ESG Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W3450_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3450_End8" name="Complete">
        <bpmn:incoming>W3450_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3450_Annotation9">
        <bpmn:text>Controls: - CTL-553 (ensure controlled execution — Renewable Generation Investment, Capex &amp; Project Development (PA-108.1).) | - operational: PVsyst and conservative assumptions; operational: structural evaluation upfront
Owner: Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3450_Assoc10" sourceRef="W3450_Annotation9" targetRef="W3450_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3450_Flow11" sourceRef="W3450_Start4" targetRef="W3450_Task5" />
      <bpmn:sequenceFlow id="W3450_Flow12" sourceRef="W3450_Task5" targetRef="W3450_Task6" />
      <bpmn:sequenceFlow id="W3450_Flow13" sourceRef="W3450_Task6" targetRef="W3450_Task7" />
      <bpmn:sequenceFlow id="W3450_Flow14" sourceRef="W3450_Task7" targetRef="W3450_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3450_diag">
      <bpmndi:BPMNPlane id="W3450_plane" bpmnElement="W_W3450">
        <bpmndi:BPMNShape id="W3450_Lane1_di" bpmnElement="W3450_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Lane2_di" bpmnElement="W3450_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Task5_di" bpmnElement="W3450_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Task6_di" bpmnElement="W3450_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Task7_di" bpmnElement="W3450_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Start4_di" bpmnElement="W3450_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_End8_di" bpmnElement="W3450_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3450_Annotation9_di" bpmnElement="W3450_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3450_Flow11_di" bpmnElement="W3450_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3450_Flow12_di" bpmnElement="W3450_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3450_Flow13_di" bpmnElement="W3450_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3450_Flow14_di" bpmnElement="W3450_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3450_Assoc10_di" bpmnElement="W3450_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3451" name="W3451. Business Case, Capex Funding &amp; Financing/Incentive Structuring" isExecutable="false">
      <bpmn:documentation>Trigger: Feasibility approved (W3450); capex cycle (links to VS-40)
Frequency: Per project + portfolio
Volume: Per site + portfolio
Owner: Energy Manager
Participants: Energy Manager, Finance/Treasury (links to VS-17/VS-18/VS-40), Sustainability (links to VS-25), Tax (links to VS-79)
Source: workflow W3451 — Business Case, Capex Funding &amp; Financing/Incentive Structuring</bpmn:documentation>
      <bpmn:laneSet id="W3451_LaneSet3">
        <bpmn:lane id="W3451_Lane1" name="Energy Manager">
        <bpmn:flowNodeRef>W3451_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3451_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3451_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3451_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W3451_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3451_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3451_Start4" name="Feasibility approved (W3450); capex cycle (links to VS-40)">
        <bpmn:outgoing>W3451_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3451_Task5" name="Energy Manager/Finance build the business case: capex, OpEx (O&amp;M, insurance…">
        <bpmn:documentation>Step 1: Energy Manager/Finance build the business case: capex, OpEx (O&amp;M, insurance links to VS-26), generation/savings (kWh × tariff), net-metering/export revenue (links to W3463), incentives (BOI/PEZA, RE Act, duty-free import links to VS-79/VS-87), depreciation, asset-retirement, and payback/IRR/NPV; compare ownership models (W3455)
Responsible (R): Energy Manager / Finance / Tax
Accountable (A): CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3451_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3451_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3451_Task6" name="Treasury/Finance structure the funding: own-capex (links to VS-40 capex…">
        <bpmn:documentation>Step 2: Treasury/Finance structure the funding: own-capex (links to VS-40 capex request/approval), debt/green-loan (links to VS-18 W319), lease/PPA (W3455), or third-party ownership; optimize for incentives, tax, and PFRS treatment (W3455); secure board approval per authority (links to VS-36)
Responsible (R): Treasury / Finance
Accountable (A): CFO / Board
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3451_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3451_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3451_Task7" name="Energy Manager/Finance lock the business case and capex authorization…">
        <bpmn:documentation>Step 3: Energy Manager/Finance lock the business case and capex authorization, integrate to the capex pipeline (links to VS-40) and cash forecast (links to VS-18.1/VS-105), and track assumption validity through delivery; report portfolio economics to governance (W3472)
Responsible (R): Energy Manager / Finance
Accountable (A): CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3451_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3451_End8" name="Complete">
        <bpmn:incoming>W3451_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3451_Annotation9">
        <bpmn:text>Controls: - CTL-553 (ensure controlled execution — Renewable Generation Investment, Capex &amp; Project Development (PA-108.1).) | - operational: conservative incentive assumption and sensitivity; operational: green-finance sourcing and ownership-model optimization (W3455)
Owner: Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3451_Assoc10" sourceRef="W3451_Annotation9" targetRef="W3451_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3451_Flow11" sourceRef="W3451_Start4" targetRef="W3451_Task5" />
      <bpmn:sequenceFlow id="W3451_Flow12" sourceRef="W3451_Task5" targetRef="W3451_Task6" />
      <bpmn:sequenceFlow id="W3451_Flow13" sourceRef="W3451_Task6" targetRef="W3451_Task7" />
      <bpmn:sequenceFlow id="W3451_Flow14" sourceRef="W3451_Task7" targetRef="W3451_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3451_diag">
      <bpmndi:BPMNPlane id="W3451_plane" bpmnElement="W_W3451">
        <bpmndi:BPMNShape id="W3451_Lane1_di" bpmnElement="W3451_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Lane2_di" bpmnElement="W3451_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Task5_di" bpmnElement="W3451_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Task6_di" bpmnElement="W3451_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Task7_di" bpmnElement="W3451_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Start4_di" bpmnElement="W3451_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_End8_di" bpmnElement="W3451_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3451_Annotation9_di" bpmnElement="W3451_Annotation9"><dc:Bounds x="160" y="460" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3451_Flow11_di" bpmnElement="W3451_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3451_Flow12_di" bpmnElement="W3451_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3451_Flow13_di" bpmnElement="W3451_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3451_Flow14_di" bpmnElement="W3451_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3451_Assoc10_di" bpmnElement="W3451_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3452" name="W3452. EPC Vendor Selection, Contracting &amp; Project Management" isExecutable="false">
      <bpmn:documentation>Trigger: Business case/capex approved (W3451)
Frequency: Per project
Volume: ~10–30 EPC projects/year
Owner: Energy Manager
Participants: Energy Manager, Procurement (links to VS-03/VS-34), Legal (links to VS-100.3), Project Mgmt, EPC Vendor
Source: workflow W3452 — EPC Vendor Selection, Contracting &amp; Project Management</bpmn:documentation>
      <bpmn:laneSet id="W3452_LaneSet4">
        <bpmn:lane id="W3452_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W3452_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3452_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3452_Lane2" name="Legal">
        <bpmn:flowNodeRef>W3452_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3452_Lane3" name="Project Manager">
        <bpmn:flowNodeRef>W3452_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3452_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3452_Start5" name="Business case/capex approved (W3451)">
        <bpmn:outgoing>W3452_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3452_Task6" name="Procurement/Energy Manager run the EPC vendor selection (links to VS-03/VS-34)…">
        <bpmn:documentation>Step 1: Procurement/Energy Manager run the EPC vendor selection (links to VS-03/VS-34): RFP, pre-qualification, technical/commercial evaluation, reference checks, and ranking; select per authority and framework-agreement where volume warrants
Responsible (R): Procurement / Energy Manager
Accountable (A): COO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3452_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3452_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3452_Task7" name="Legal/Energy Manager negotiate and execute the EPC contract: scope, spec…">
        <bpmn:documentation>Step 2: Legal/Energy Manager negotiate and execute the EPC contract: scope, spec, price, milestone payments, liquidated damages, performance guarantee (yield availability), warranty, HSE (links to VS-24), insurance (links to VS-26), and termination; ensure risk allocation (links to VS-100.3/W230)
Responsible (R): Legal / Energy Manager
Accountable (A): COO / CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3452_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3452_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3452_Task8" name="Project Manager/Energy Manager manage the EPC delivery: schedule, site…">
        <bpmn:documentation>Step 3: Project Manager/Energy Manager manage the EPC delivery: schedule, site coordination with store/DC ops (links to VS-07/VS-04), HSE, quality, change control, milestone acceptance, and commissioning handoff (W3454); report status and resolve issues
Responsible (R): Project Manager / Energy Manager
Accountable (A): COO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3452_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3452_End9" name="Complete">
        <bpmn:incoming>W3452_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3452_Annotation10">
        <bpmn:text>Controls: - CTL-553 (ensure controlled execution — Renewable Generation Investment, Capex &amp; Project Development (PA-108.1).) | - operational: performance LD and warranty; operational: milestone management and site coordination
Owner: Energy Manager</bpmn:text>
      </bpmn:textAnnotation>
