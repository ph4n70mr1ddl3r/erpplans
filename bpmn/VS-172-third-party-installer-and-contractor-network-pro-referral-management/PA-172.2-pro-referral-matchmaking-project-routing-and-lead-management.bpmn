    <bpmn:process id="W_W4993" name="W4993. Customer &quot;Find-a-Pro&quot; Request Intake, Qualification &amp; Consent" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests an installer (online/app/store/after-purchase)
Frequency: Continuous (200 stores + online)
Volume: ~3,000–6,000 Find-a-Pro requests/month (national)
Owner: CX (VS-13) / Pro-Referral Network Manager / Store Ops
Participants: CX (VS-13), Store Ops (VS-07), Digital (VS-10/VS-75), Privacy/DPO (VS-91), Marketplace (VS-95)
Source: workflow W4993 — Customer &quot;Find-a-Pro&quot; Request Intake, Qualification &amp; Consent</bpmn:documentation>
      <bpmn:laneSet id="W4993_LaneSet2">
        <bpmn:lane id="W4993_Lane1" name="CX">
        <bpmn:flowNodeRef>W4993_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4993_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4993_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4993_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4993_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4993_Start3" name="Customer requests an installer (online/app/store/after-purchase)">
        <bpmn:outgoing>W4993_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4993_Task4" name="Intake the request: capture the customer&#x27;s project need (trade/specialty…">
        <bpmn:documentation>Step 1: Intake the request: capture the customer&#x27;s project need (trade/specialty, scope, location, timing, budget), the linked materials/order (links VS-10/VS-11) where applicable, and contact details; qualify the request (real intent, scope clarity)
Responsible (R): CX / Counter Staff / Digital
Accountable (A): Network Manager / CX Lead
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W4993_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4993_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4993_Task5" name="Capture consent &amp; set expectations: capture consent to share contact/project…">
        <bpmn:documentation>Step 2: Capture consent &amp; set expectations: capture consent to share contact/project details with installers (RA 10173 — links VS-91), set expectations (response time, referral-not-guarantee disclaimer, that the installer is an independent contractor not BuildRight&#x27;s employee), and confirm the referral terms
Responsible (R): CX / DPO / Digital
Accountable (A): Network Manager / DPO
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W4993_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4993_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4993_Task6" name="Route to matchmaking: qualify-and-route the request to matchmaking (W4994)…">
        <bpmn:documentation>Step 3: Route to matchmaking: qualify-and-route the request to matchmaking (W4994), manage incomplete/invalid requests, and feed demand analytics (W4991)
Responsible (R): CX / Marketplace / Analytics
Accountable (A): Network Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W4993_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4993_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4993_End7" name="Complete">
        <bpmn:incoming>W4993_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4993_Annotation8">
        <bpmn:text>Controls: - CTL-747 (ensure controlled execution — Pro-Referral Matchmaking, Project Routing &amp; Lead Management (PA-172.2).) | - CTL-747: consent captured (VS-91); disclaimer set; request qualified; routed to matchmaking
Owner: CX (VS-13) / Pro-Referral Network Manager / Store Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4993_Assoc9" sourceRef="W4993_Annotation8" targetRef="W4993_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4993_Flow10" sourceRef="W4993_Start3" targetRef="W4993_Task4" />
      <bpmn:sequenceFlow id="W4993_Flow11" sourceRef="W4993_Task4" targetRef="W4993_Task5" />
      <bpmn:sequenceFlow id="W4993_Flow12" sourceRef="W4993_Task5" targetRef="W4993_Task6" />
      <bpmn:sequenceFlow id="W4993_Flow13" sourceRef="W4993_Task6" targetRef="W4993_End7" />
    </bpmn:process>
