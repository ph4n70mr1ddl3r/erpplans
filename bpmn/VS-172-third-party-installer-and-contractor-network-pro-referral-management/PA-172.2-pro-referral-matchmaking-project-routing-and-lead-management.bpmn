    <bpmn:process id="W_W4996" name="W4996. Project Booking, Scope Confirmation &amp; Materials-Link Sales Attach" isExecutable="false">
      <bpmn:documentation>Trigger: Quote accepted (W4995)
Frequency: Continuous
Volume: ~50–70% booking rate per accepted quote
Owner: Installer / Pro-Referral Network Manager / Sales
Participants: Installer, CX (VS-13), Sales/Store Ops (VS-07/VS-11), Ecommerce (VS-10), Finance (VS-154)
Source: workflow W4996 — Project Booking, Scope Confirmation &amp; Materials-Link Sales Attach</bpmn:documentation>
      <bpmn:laneSet id="W4996_LaneSet4">
        <bpmn:lane id="W4996_Lane1" name="Installer">
        <bpmn:flowNodeRef>W4996_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4996_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4996_Lane2" name="Sales">
        <bpmn:flowNodeRef>W4996_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4996_Lane3" name="Marketplace">
        <bpmn:flowNodeRef>W4996_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4996_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4996_Start5" name="Quote accepted (W4995)">
        <bpmn:outgoing>W4996_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4996_Task6" name="Book the project: confirm the scope/price/timeline/materials, schedule the work…">
