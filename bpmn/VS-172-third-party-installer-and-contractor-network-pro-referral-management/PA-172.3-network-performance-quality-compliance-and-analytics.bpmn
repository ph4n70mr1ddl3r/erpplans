    <bpmn:process id="W_W5008" name="W5008. Installer Network Risk, TPRM &amp; Data Privacy Assurance" isExecutable="false">
      <bpmn:documentation>Trigger: Risk review (VS-21/VS-161); privacy review (VS-91); audit
Frequency: Annual + event-driven
Volume: ~1 risk/privacy assurance cycle across the network
Owner: Pro-Referral Network Manager / TPRM (VS-161) / DPO (VS-91) / Internal Audit (VS-21)
Participants: TPRM (VS-161), DPO/Privacy (VS-91), Internal Audit (VS-21), Legal (VS-100), Security (VS-27.3/VS-159)
Source: workflow W5008 — Installer Network Risk, TPRM &amp; Data Privacy Assurance</bpmn:documentation>
      <bpmn:laneSet id="W5008_LaneSet4">
        <bpmn:lane id="W5008_Lane1" name="TPRM">
        <bpmn:flowNodeRef>W5008_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5008_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5008_Lane2" name="DPO">
        <bpmn:flowNodeRef>W5008_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5008_Lane3" name="Internal Audit">
        <bpmn:flowNodeRef>W5008_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5008_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5008_Start5" name="Risk review (VS-21/VS-161); privacy review (VS-91); audit">
        <bpmn:outgoing>W5008_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5008_Task6" name="Manage network risk via TPRM: tier installers by risk (W4989), monitor…">
        <bpmn:documentation>Step 1: Manage network risk via TPRM: tier installers by risk (W4989), monitor fourth-party/subcontractor risk, concentration risk (single installer/area), continuity/exit (alternate W5000), and feed the enterprise TPRM program (VS-161)
Responsible (R): TPRM / Network Manager / Analytics
Accountable (A): TPRM Lead / COO
Duration: Annual + continuous</bpmn:documentation>
        <bpmn:incoming>W5008_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5008_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5008_Task7" name="Assure data privacy: govern customer-data shared with installers (consent…">
        <bpmn:documentation>Step 2: Assure data privacy: govern customer-data shared with installers (consent W4993, DPA in agreement W4989, installer data-handling, breach response links VS-91), installer access/credentials (VS-27), and DSAR handling (VS-91 W271)
Responsible (R): DPO / Legal / IT Security / Network Manager
Accountable (A): DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5008_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5008_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5008_Task8" name="Audit &amp; assure: periodic audit of the network program (vetting, routing…">
        <bpmn:documentation>Step 3: Audit &amp; assure: periodic audit of the network program (vetting, routing fairness VS-129, settlement VS-118, conduct/ethics VS-119, privacy VS-91), issue remediation (VS-21 CAPA), and report to the audit/risk committee
Responsible (R): Internal Audit / TPRM / DPO / Network Manager
Accountable (A): Audit Committee / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5008_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5008_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5008_End9" name="Complete">
        <bpmn:incoming>W5008_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5008_Annotation10">
        <bpmn:text>Controls: - CTL-748 (ensure controlled execution — Network Performance, Quality, Compliance &amp; Analytics (PA-172.3).) | - CTL-748: TPRM tiering/monitoring; DPA &amp; consent enforced; privacy audited; program audited &amp; CAPA&#x27;d
Owner: Pro-Referral Network Manager / TPRM (VS-161) / DPO (VS-91) / Internal Audit (VS-21)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5008_Assoc11" sourceRef="W5008_Annotation10" targetRef="W5008_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5008_Flow12" sourceRef="W5008_Start5" targetRef="W5008_Task6" />
      <bpmn:sequenceFlow id="W5008_Flow13" sourceRef="W5008_Task6" targetRef="W5008_Task7" />
      <bpmn:sequenceFlow id="W5008_Flow14" sourceRef="W5008_Task7" targetRef="W5008_Task8" />
      <bpmn:sequenceFlow id="W5008_Flow15" sourceRef="W5008_Task8" targetRef="W5008_End9" />
    </bpmn:process>
