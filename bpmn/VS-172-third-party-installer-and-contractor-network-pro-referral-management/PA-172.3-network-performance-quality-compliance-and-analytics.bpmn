      <bpmn:startEvent id="W5005_Start4" name="Customer complaint (VS-13); quality defect (W5004); conduct breach (W4992)">
        <bpmn:outgoing>W5005_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5005_Task5" name="Triage &amp; investigate the dispute: receive the complaint (links VS-13), triage…">
        <bpmn:documentation>Step 1: Triage &amp; investigate the dispute: receive the complaint (links VS-13), triage (workmanship/pricing/conduct/timeliness), investigate (evidence, both parties), and determine cause/responsibility
Responsible (R): CX / Network Manager / Quality / Legal
Accountable (A): Network Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5005_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5005_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5005_Task6" name="Resolve: mediate customer↔installer resolution, remediation (W5004)…">
        <bpmn:documentation>Step 2: Resolve: mediate customer↔installer resolution, remediation (W5004), refund/compensation where warranted, alternate installer (W5000), and customer recovery (VS-13)
Responsible (R): CX / Network Manager / Installer / Finance
Accountable (A): Network Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5005_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5005_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5005_Task7" name="Discipline/remove: for installer fault/conduct breach (W4992), apply discipline…">
        <bpmn:documentation>Step 3: Discipline/remove: for installer fault/conduct breach (W4992), apply discipline (warning/suspension/fee), remove from the network for serious/recurrent breach (with due process/Legal VS-100), and document
Responsible (R): Network Manager / Legal / Ethics
Accountable (A): COO / Legal
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5005_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5005_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5005_End8" name="Complete">
        <bpmn:incoming>W5005_Flow14</bpmn:incoming>
      </bpmn:endEvent>
