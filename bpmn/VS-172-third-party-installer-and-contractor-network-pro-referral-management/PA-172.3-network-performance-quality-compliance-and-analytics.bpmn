      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5002" name="W5002. Installer Performance Scorecard &amp; KPI Management" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic review; ratings (W5001); quality findings (W5003)
Frequency: Monthly + quarterly deep-dive
Volume: ~1 scorecard per installer × network
Owner: Pro-Referral Network Manager / Analytics
Participants: Analytics (VS-28), CX (VS-13), Quality (VS-31), Network Manager, Installer
Source: workflow W5002 — Installer Performance Scorecard &amp; KPI Management</bpmn:documentation>
      <bpmn:laneSet id="W5002_LaneSet3">
        <bpmn:lane id="W5002_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W5002_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5002_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5002_Lane2" name="Network Manager">
        <bpmn:flowNodeRef>W5002_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5002_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5002_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5002_Start4" name="Periodic review; ratings (W5001); quality findings (W5003)">
        <bpmn:outgoing>W5002_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5002_Task5" name="Build the scorecard: per-installer KPIs — rating (W5001)…">
        <bpmn:documentation>Step 1: Build the scorecard: per-installer KPIs — rating (W5001), response/quote/completion time, acceptance rate, completion verification (W4998), quality/defect (W5003/W5004), complaints (W5005), compliance (W5006), and referral-fee/revenue contribution
Responsible (R): Analytics / Network Manager / CX / Quality
Accountable (A): Network Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5002_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5002_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5002_Task6" name="Review &amp; rank: review the scorecard per installer, rank within trade/area…">
        <bpmn:documentation>Step 2: Review &amp; rank: review the scorecard per installer, rank within trade/area, identify top/bottom performers, and manage tiers (W4989) and preferred status
Responsible (R): Network Manager / Analytics / Trade Program
Accountable (A): COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5002_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5002_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5002_Task7" name="Act on performance: recognition for top performers, improvement plans for…">
        <bpmn:documentation>Step 3: Act on performance: recognition for top performers, improvement plans for under-performers (links VS-67/VS-133 improvement), tier changes, and removal (W5005) for persistent poor performance
Responsible (R): Network Manager / Quality / Legal
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5002_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5002_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5002_End8" name="Complete">
        <bpmn:incoming>W5002_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5002_Annotation9">
        <bpmn:text>Controls: - CTL-748 (ensure controlled execution — Network Performance, Quality, Compliance &amp; Analytics (PA-172.3).) | - CTL-748: multi-dimensional scorecard; reviewed monthly; top/bottom acted on; tiers managed
Owner: Pro-Referral Network Manager / Analytics</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5002_Assoc10" sourceRef="W5002_Annotation9" targetRef="W5002_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5002_Flow11" sourceRef="W5002_Start4" targetRef="W5002_Task5" />
      <bpmn:sequenceFlow id="W5002_Flow12" sourceRef="W5002_Task5" targetRef="W5002_Task6" />
      <bpmn:sequenceFlow id="W5002_Flow13" sourceRef="W5002_Task6" targetRef="W5002_Task7" />
      <bpmn:sequenceFlow id="W5002_Flow14" sourceRef="W5002_Task7" targetRef="W5002_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5002_diag">
      <bpmndi:BPMNPlane id="W5002_plane" bpmnElement="W_W5002">
        <bpmndi:BPMNShape id="W5002_Lane1_di" bpmnElement="W5002_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5002_Lane2_di" bpmnElement="W5002_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
