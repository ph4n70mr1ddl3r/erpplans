        <bpmndi:BPMNEdge id="W5002_Flow12_di" bpmnElement="W5002_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5002_Flow13_di" bpmnElement="W5002_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5002_Flow14_di" bpmnElement="W5002_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5002_Assoc10_di" bpmnElement="W5002_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5003" name="W5003. Quality Assurance, Workmanship Inspection &amp; Site Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Periodic QA; high-risk/large project; complaint/quality concern (W5005)
Frequency: Periodic + event-driven
Volume: ~200–400 QA inspections/samples per year across the network
Owner: Quality (VS-31) / Pro-Referral Network Manager
Participants: Quality (VS-31), Installer, CX (VS-13), HSE (VS-24), Customer
Source: workflow W5003 — Quality Assurance, Workmanship Inspection &amp; Site Audit</bpmn:documentation>
      <bpmn:laneSet id="W5003_LaneSet2">
        <bpmn:lane id="W5003_Lane1" name="Quality">
        <bpmn:flowNodeRef>W5003_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5003_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5003_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5003_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5003_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5003_Start3" name="Periodic QA; high-risk/large project; complaint/quality concern (W5005)">
        <bpmn:outgoing>W5003_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5003_Task4" name="Define QA standards: the workmanship standard per trade (aligned to…">
        <bpmn:documentation>Step 1: Define QA standards: the workmanship standard per trade (aligned to trade/building code — links VS-117 DTI-BPS, VS-31 quality), the inspection criteria/checklist, and the sampling/risk-based audit plan
Responsible (R): Quality / Network Manager / Compliance
Accountable (A): Quality Lead / Network Manager
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W5003_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5003_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5003_Task5" name="Conduct inspections/audits: site inspection of completed/in-progress work…">
        <bpmn:documentation>Step 2: Conduct inspections/audits: site inspection of completed/in-progress work (sample + risk-based), documentation (photo/checklist), verify compliance to standard/code, and identify defects (W5004)
Responsible (R): Quality / HSE / Inspector
Accountable (A): Quality Lead
Duration: Per inspection</bpmn:documentation>
        <bpmn:incoming>W5003_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5003_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5003_Task6" name="Act on findings: defect remediation (W5004), scorecard impact (W5002)…">
        <bpmn:documentation>Step 3: Act on findings: defect remediation (W5004), scorecard impact (W5002), improvement/removal (W5005), and feed quality analytics/standards improvement
Responsible (R): Quality / Network Manager / Installer
Accountable (A): Quality Lead / Network Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5003_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5003_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5003_End7" name="Complete">
        <bpmn:incoming>W5003_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5003_Annotation8">
        <bpmn:text>Controls: - CTL-98 (ensure installer-network vetting &amp; referral integrity.) | - CTL-748: QA standards defined; inspections conducted; defects remediated; scorecard updated
Owner: Quality (VS-31) / Pro-Referral Network Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5003_Assoc9" sourceRef="W5003_Annotation8" targetRef="W5003_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5003_Flow10" sourceRef="W5003_Start3" targetRef="W5003_Task4" />
      <bpmn:sequenceFlow id="W5003_Flow11" sourceRef="W5003_Task4" targetRef="W5003_Task5" />
      <bpmn:sequenceFlow id="W5003_Flow12" sourceRef="W5003_Task5" targetRef="W5003_Task6" />
      <bpmn:sequenceFlow id="W5003_Flow13" sourceRef="W5003_Task6" targetRef="W5003_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5003_diag">
      <bpmndi:BPMNPlane id="W5003_plane" bpmnElement="W_W5003">
        <bpmndi:BPMNShape id="W5003_Lane1_di" bpmnElement="W5003_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_Task4_di" bpmnElement="W5003_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_Task5_di" bpmnElement="W5003_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_Task6_di" bpmnElement="W5003_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_Start3_di" bpmnElement="W5003_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_End7_di" bpmnElement="W5003_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5003_Annotation8_di" bpmnElement="W5003_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W5003_Flow10_di" bpmnElement="W5003_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5003_Flow11_di" bpmnElement="W5003_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5003_Flow12_di" bpmnElement="W5003_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5003_Flow13_di" bpmnElement="W5003_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5003_Assoc9_di" bpmnElement="W5003_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5004" name="W5004. Warranty, Defect Liability &amp; Post-Installation Service Obligation" isExecutable="false">
      <bpmn:documentation>Trigger: Defect found (W5003); customer warranty claim; defect-liability period
Frequency: Event-driven
Volume: ~30–60 warranty/defect claims per year across the network
Owner: Warranty (VS-53) / Pro-Referral Network Manager / Installer
Participants: Warranty (VS-53), Installer, CX (VS-13), Quality (VS-31), Finance (VS-17), Legal (VS-100)
Source: workflow W5004 — Warranty, Defect Liability &amp; Post-Installation Service Obligation</bpmn:documentation>
      <bpmn:laneSet id="W5004_LaneSet2">
        <bpmn:lane id="W5004_Lane1" name="Warranty">
        <bpmn:flowNodeRef>W5004_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5004_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5004_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5004_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5004_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5004_Start3" name="Defect found (W5003); customer warranty claim; defect-liability period">
        <bpmn:outgoing>W5004_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5004_Task4" name="Define warranty/defect-liability terms: the workmanship warranty period/scope…">
        <bpmn:documentation>Step 1: Define warranty/defect-liability terms: the workmanship warranty period/scope per trade (in the installer agreement W4989), the materials warranty (links VS-53 product warranty), and the defect-liability/retention mechanism
Responsible (R): Warranty / Legal / Network Manager
Accountable (A): COO / Legal
Duration: Per program</bpmn:documentation>
        <bpmn:incoming>W5004_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5004_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5004_Task5" name="Manage claims: receive the customer defect/warranty claim, diagnose…">
        <bpmn:documentation>Step 2: Manage claims: receive the customer defect/warranty claim, diagnose (workmanship vs materials vs customer), assign remediation to the installer (or alternate W5000), and track to resolution (links VS-53)
Responsible (R): Warranty / CX / Installer
Accountable (A): Network Manager
Duration: Per claim</bpmn:documentation>
        <bpmn:incoming>W5004_Flow11</bpmn:incoming>
