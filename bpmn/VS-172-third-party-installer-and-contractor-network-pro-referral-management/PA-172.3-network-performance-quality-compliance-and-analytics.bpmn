<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-172.3-network-performance-quality-compliance-and-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5001" name="W5001. Customer Rating, Review &amp; Feedback Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Project completion (W4998)
Frequency: Per completed project
Volume: ~300–600 ratings per month (upper-bounded by completed projects per W4997 at realistic response rates)
Owner: CX (VS-13) / Pro-Referral Network Manager
Participants: CX (VS-13), Customer, Marketplace (VS-95), Privacy (VS-91), Installer
Source: workflow W5001 — Customer Rating, Review &amp; Feedback Collection</bpmn:documentation>
      <bpmn:laneSet id="W5001_LaneSet3">
        <bpmn:lane id="W5001_Lane1" name="CX">
        <bpmn:flowNodeRef>W5001_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5001_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5001_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5001_Lane2" name="Marketplace">
        <bpmn:flowNodeRef>W5001_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5001_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5001_Start4" name="Project completion (W4998)">
        <bpmn:outgoing>W5001_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5001_Task5" name="Solicit the rating/feedback: post-completion (W4998), request the customer rate…">
        <bpmn:documentation>Step 1: Solicit the rating/feedback: post-completion (W4998), request the customer rate the installer/work (CSAT/NPS, workmanship, timeliness, professionalism, value) via the platform/app/SMS (links VS-13 W65)
Responsible (R): CX / Marketplace
Accountable (A): Network Manager / CX Lead
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W5001_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5001_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5001_Task6" name="Manage reviews &amp; authenticity: publish reviews on the installer profile (W4990)…">
        <bpmn:documentation>Step 2: Manage reviews &amp; authenticity: publish reviews on the installer profile (W4990) per consent, verify authenticity (prevent fake/retaliatory reviews — links VS-125), and manage the installer&#x27;s right-of-reply
Responsible (R): Marketplace / CX / Legal / DPO
Accountable (A): Network Manager
Duration: Per review</bpmn:documentation>
        <bpmn:incoming>W5001_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5001_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5001_Task7" name="Analyze &amp; act: aggregate ratings into the scorecard (W5002), identify low-rated…">
        <bpmn:documentation>Step 3: Analyze &amp; act: aggregate ratings into the scorecard (W5002), identify low-rated installers for review/improvement (W5005), and feed CX analytics and the Find-a-Pro ranking (W4994)
Responsible (R): CX / Analytics / Network Manager
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5001_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5001_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5001_End8" name="Complete">
        <bpmn:incoming>W5001_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5001_Annotation9">
        <bpmn:text>Controls: - CTL-748 (ensure controlled execution — Network Performance, Quality, Compliance &amp; Analytics (PA-172.3).) | - CTL-748: ratings solicited post-completion; reviews authentic; consent respected; scorecard updated
Owner: CX (VS-13) / Pro-Referral Network Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5001_Assoc10" sourceRef="W5001_Annotation9" targetRef="W5001_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5001_Flow11" sourceRef="W5001_Start4" targetRef="W5001_Task5" />
      <bpmn:sequenceFlow id="W5001_Flow12" sourceRef="W5001_Task5" targetRef="W5001_Task6" />
      <bpmn:sequenceFlow id="W5001_Flow13" sourceRef="W5001_Task6" targetRef="W5001_Task7" />
      <bpmn:sequenceFlow id="W5001_Flow14" sourceRef="W5001_Task7" targetRef="W5001_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5001_diag">
      <bpmndi:BPMNPlane id="W5001_plane" bpmnElement="W_W5001">
        <bpmndi:BPMNShape id="W5001_Lane1_di" bpmnElement="W5001_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
