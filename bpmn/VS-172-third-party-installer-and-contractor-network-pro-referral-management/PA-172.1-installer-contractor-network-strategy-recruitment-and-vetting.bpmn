        <bpmndi:BPMNEdge id="W4986_Flow11_di" bpmnElement="W4986_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4986_Flow12_di" bpmnElement="W4986_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4986_Flow13_di" bpmnElement="W4986_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4986_Assoc9_di" bpmnElement="W4986_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4987" name="W4987. Contractor Vetting, PCAB License (RA 4566) &amp; Insurance Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate progression (W4986); periodic re-verification (W5006)
Frequency: Per candidate + periodic re-verification
Volume: ~100–200 new vettings per year (per candidate joining the ~300–500-installer network) + periodic re-checks
Owner: Pro-Referral Network Manager / Compliance (VS-165/VS-22) / Legal (VS-100)
Participants: Compliance (VS-165/VS-22), Legal (VS-100), TPRM (VS-161), Quality (VS-31), Insurance (VS-26)
Source: workflow W4987 — Contractor Vetting, PCAB License (RA 4566) &amp; Insurance Verification</bpmn:documentation>
      <bpmn:laneSet id="W4987_LaneSet3">
        <bpmn:lane id="W4987_Lane1" name="Compliance">
        <bpmn:flowNodeRef>W4987_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4987_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4987_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4987_Lane2" name="Insurance">
        <bpmn:flowNodeRef>W4987_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4987_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4987_Start4" name="Candidate progression (W4986); periodic re-verification (W5006)">
        <bpmn:outgoing>W4987_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4987_Task5" name="Verify licenses &amp; legal eligibility: PCAB contractor license (RA 4566 — links…">
        <bpmn:documentation>Step 1: Verify licenses &amp; legal eligibility: PCAB contractor license (RA 4566 — links VS-165, verify it&#x27;s the *contractor&#x27;s* license, current, correct category), DTI/SEC registration, BIR registration, mayor&#x27;s/LGU permit, and trade-specific licenses (electrical license, plumbing, FPA for pesticides, etc.); verify against official registers
Responsible (R): Compliance / Legal / Network Manager
Accountable (A): Compliance Lead
Duration: Per candidate</bpmn:documentation>
        <bpmn:incoming>W4987_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4987_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4987_Task6" name="Verify insurance &amp; bonding: public-liability/professional indemnity insurance…">
        <bpmn:documentation>Step 2: Verify insurance &amp; bonding: public-liability/professional indemnity insurance (current, adequate limits, BuildRight named/added insured where required), performance bond/surety for larger projects (links VS-116), workers&#x27; compensation/SSS for the installer&#x27;s crew, and coverage adequacy
Responsible (R): Insurance / Legal / Network Manager
Accountable (A): Compliance Lead
Duration: Per candidate</bpmn:documentation>
        <bpmn:incoming>W4987_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4987_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4987_Task7" name="Document &amp; gate onboarding: capture verification evidence, gate onboarding…">
        <bpmn:documentation>Step 3: Document &amp; gate onboarding: capture verification evidence, gate onboarding (W4989) on verified license+insurance, set re-verification (W5006), and manage exceptions/remediation; feed TPRM (VS-161)
Responsible (R): Compliance / Legal / TPRM
Accountable (A): Compliance Lead
Duration: Per candidate</bpmn:documentation>
        <bpmn:incoming>W4987_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4987_End8" name="Complete">
        <bpmn:incoming>W4987_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4987_Annotation9">
        <bpmn:text>Controls: - CTL-98 (ensure installer-network vetting &amp; referral integrity.) | - CTL-746: PCAB/insurance verified before onboarding; evidence captured; onboarding gated; re-verification scheduled (W5006)
Owner: Pro-Referral Network Manager / Compliance (VS-165/VS-22) / Legal (VS-100)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4987_Assoc10" sourceRef="W4987_Annotation9" targetRef="W4987_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4987_Flow11" sourceRef="W4987_Start4" targetRef="W4987_Task5" />
      <bpmn:sequenceFlow id="W4987_Flow12" sourceRef="W4987_Task5" targetRef="W4987_Task6" />
      <bpmn:sequenceFlow id="W4987_Flow13" sourceRef="W4987_Task6" targetRef="W4987_Task7" />
      <bpmn:sequenceFlow id="W4987_Flow14" sourceRef="W4987_Task7" targetRef="W4987_End8" />
    </bpmn:process>
