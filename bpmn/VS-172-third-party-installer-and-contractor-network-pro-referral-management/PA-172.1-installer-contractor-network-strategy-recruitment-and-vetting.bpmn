<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-172.1-installer-contractor-network-strategy-recruitment-and-vetting" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4985" name="W4985. Installer &amp; Contractor Network Strategy, Trade-Coverage &amp; Capacity Design" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual strategy; coverage gap; format/region expansion (VS-37)
Frequency: Annual + on launch
Volume: 1 network program across 200 trade-areas × trade specialties
Owner: COO / Pro-Referral Network Manager / Strategy (VS-33)
Participants: Services (VS-12), Store Ops (VS-07), B2B/Key Accounts (VS-11/VS-107), Trade Program (VS-43), Strategy (VS-33), Finance (VS-17.4)
Source: workflow W4985 — Installer &amp; Contractor Network Strategy, Trade-Coverage &amp; Capacity Design</bpmn:documentation>
      <bpmn:laneSet id="W4985_LaneSet2">
        <bpmn:lane id="W4985_Lane1" name="Network Manager">
        <bpmn:flowNodeRef>W4985_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4985_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4985_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4985_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4985_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4985_Start3" name="Program launch; annual strategy; coverage gap; format/region expansion (VS-37)">
        <bpmn:outgoing>W4985_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4985_Task4" name="Set the installer-network strategy &amp; operating model: the…">
        <bpmn:documentation>Step 1: Set the installer-network strategy &amp; operating model: the referral-vs-managed-marketplace model, the trade specialties covered (electrical, plumbing, carpentry, tiling, paint, HVAC/solar, appliance, roofing, masonry), the own-crew (VS-12) vs network split, the geographic/trade-coverage targets, the referral economics (W4997), and the positioning (&quot;Your Home Building Partner&quot;)
Responsible (R): Network Manager / Strategy / Services / B2B
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4985_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4985_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4985_Task5" name="Design trade-coverage &amp; capacity: per trade-area (region/province) the required…">
        <bpmn:documentation>Step 2: Design trade-coverage &amp; capacity: per trade-area (region/province) the required installer count/capacity by specialty, the tier model (preferred/standard), the service-level targets (response, quote, completion), and the build-vs-partner decision per trade
Responsible (R): Network Manager / Strategy / Store Ops
Accountable (A): COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4985_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4985_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4985_Task6" name="Build the business case &amp; govern: referral-fee/commission economics, attach/CLV…">
        <bpmn:documentation>Step 3: Build the business case &amp; govern: referral-fee/commission economics, attach/CLV impact, the platform/ops cost, KPIs (coverage %, fill-rate, rating, conversion), board/leadership approval, and integration with services (VS-12), trade (VS-43), and store opening (VS-37)
Responsible (R): Network Manager / Finance / Strategy
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4985_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4985_End7" name="Complete">
        <bpmn:incoming>W4985_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4985_Annotation8">
        <bpmn:text>Controls: - CTL-746 (ensure controlled execution — Installer/Contractor Network Strategy, Recruitment &amp; Vetting (PA-172.1).) | - CTL-746: strategy board-approved; coverage targets set; build-vs-partner split defined; KPIs tracked
Owner: COO / Pro-Referral Network Manager / Strategy (VS-33)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4985_Assoc9" sourceRef="W4985_Annotation8" targetRef="W4985_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4985_Flow10" sourceRef="W4985_Start3" targetRef="W4985_Task4" />
      <bpmn:sequenceFlow id="W4985_Flow11" sourceRef="W4985_Task4" targetRef="W4985_Task5" />
      <bpmn:sequenceFlow id="W4985_Flow12" sourceRef="W4985_Task5" targetRef="W4985_Task6" />
      <bpmn:sequenceFlow id="W4985_Flow13" sourceRef="W4985_Task6" targetRef="W4985_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4985_diag">
