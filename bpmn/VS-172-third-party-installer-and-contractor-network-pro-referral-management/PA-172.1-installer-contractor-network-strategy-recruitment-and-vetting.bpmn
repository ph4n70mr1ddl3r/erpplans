      <bpmn:sequenceFlow id="W4986_Flow11" sourceRef="W4986_Task4" targetRef="W4986_Task5" />
      <bpmn:sequenceFlow id="W4986_Flow12" sourceRef="W4986_Task5" targetRef="W4986_Task6" />
      <bpmn:sequenceFlow id="W4986_Flow13" sourceRef="W4986_Task6" targetRef="W4986_End7" />
    </bpmn:process>
