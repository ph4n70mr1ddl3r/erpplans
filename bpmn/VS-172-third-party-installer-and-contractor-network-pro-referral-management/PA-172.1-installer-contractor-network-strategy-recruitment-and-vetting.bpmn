    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4986" name="W4986. Contractor Recruitment, Pipeline &amp; Trade-Segment Sourcing" isExecutable="false">
      <bpmn:documentation>Trigger: Coverage gap (W4991); network expansion; installer churn
Frequency: Continuous
Volume: ~500–1,000 candidate pipeline entries per year across trade specialties × 200 trade areas
Owner: Pro-Referral Network Manager / Trade Program (VS-43) / Field Sales (VS-140)
Participants: Trade Program (VS-43), Field Sales (VS-140), Store Ops (VS-07), B2B (VS-11), Marketing (VS-14)
Source: workflow W4986 — Contractor Recruitment, Pipeline &amp; Trade-Segment Sourcing</bpmn:documentation>
      <bpmn:laneSet id="W4986_LaneSet2">
        <bpmn:lane id="W4986_Lane1" name="Network Manager">
        <bpmn:flowNodeRef>W4986_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4986_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4986_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4986_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4986_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4986_Start3" name="Coverage gap (W4991); network expansion; installer churn">
        <bpmn:outgoing>W4986_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4986_Task4" name="Source contractor candidates: leverage the trade-account base (VS-43/VS-11)…">
        <bpmn:documentation>Step 1: Source contractor candidates: leverage the trade-account base (VS-43/VS-11), trade-pro program, field sales (VS-140), trade shows (VS-139), industry/TESDA (VS-123), referrals from existing network installers, and inbound applications; build the recruitment pipeline by trade/area
Responsible (R): Network Manager / Trade Program / Field Sales
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4986_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4986_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4986_Task5" name="Qualify &amp; progress candidates: pre-screen (trade, location, capacity…">
        <bpmn:documentation>Step 2: Qualify &amp; progress candidates: pre-screen (trade, location, capacity, interest), route to vetting (W4987/W4988), and manage the pipeline through offer/onboarding (W4989); prioritize coverage gaps (W4991)
Responsible (R): Network Manager / Trade Program
Accountable (A): Network Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4986_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4986_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4986_Task6" name="Manage churn &amp; replenishment: monitor installer churn (deactivation…">
        <bpmn:documentation>Step 3: Manage churn &amp; replenishment: monitor installer churn (deactivation, performance-removal W5005), maintain the replenishment pipeline, and keep coverage above target
Responsible (R): Network Manager / Analytics
Accountable (A): Network Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4986_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4986_End7" name="Complete">
        <bpmn:incoming>W4986_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4986_Annotation8">
        <bpmn:text>Controls: - CTL-746 (ensure controlled execution — Installer/Contractor Network Strategy, Recruitment &amp; Vetting (PA-172.1).) | - CTL-746: multi-channel sourcing; candidates vetted before onboarding; coverage maintained above target
Owner: Pro-Referral Network Manager / Trade Program (VS-43) / Field Sales (VS-140)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4986_Assoc9" sourceRef="W4986_Annotation8" targetRef="W4986_Start3" associationDirection="None" />
