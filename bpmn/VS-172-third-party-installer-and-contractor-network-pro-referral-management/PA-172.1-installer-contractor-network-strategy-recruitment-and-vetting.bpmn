    <bpmn:process id="W_W4989" name="W4989. Installer Network Onboarding, Agreement &amp; Tier Classification" isExecutable="false">
      <bpmn:documentation>Trigger: Vetting approved (W4987/W4988); tier change
Frequency: Per installer + tier changes
Volume: ~100–200 onboardings per year (per installer joining the network)
Owner: Pro-Referral Network Manager / Legal (VS-100)
Participants: Legal (VS-100), Services (VS-12), Trade Program (VS-43), IT (VS-27), Finance (VS-17)
Source: workflow W4989 — Installer Network Onboarding, Agreement &amp; Tier Classification</bpmn:documentation>
      <bpmn:laneSet id="W4989_LaneSet4">
        <bpmn:lane id="W4989_Lane1" name="Legal">
        <bpmn:flowNodeRef>W4989_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4989_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
