        <bpmn:outgoing>W4989_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4989_Task6" name="Execute the installer agreement: the referral/marketplace agreement (distinct…">
        <bpmn:documentation>Step 1: Execute the installer agreement: the referral/marketplace agreement (distinct from employment — clarifies BuildRight is not the installer&#x27;s employer, mitigating co-employment/DOLE D.O. 174 risk links VS-98), the referral-fee/commission terms (W4997), the service-level/quality/warranty commitments, the code-of-conduct (W4992), insurance/indemnity, data-privacy (DPA, customer-data handling VS-91), and termination
Responsible (R): Legal / Network Manager / Installer
Accountable (A): COO / Legal
Duration: Per installer</bpmn:documentation>
        <bpmn:incoming>W4989_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4989_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4989_Task7" name="Classify tier &amp; set profile: tier assignment (preferred/standard/ probation…">
        <bpmn:documentation>Step 2: Classify tier &amp; set profile: tier assignment (preferred/standard/ probation based on W4987/W4988), trade specialties, service area, capacity, pricing/rate card, and the marketplace profile/catalog (W4990)
Responsible (R): Network Manager / Trade Program / Installer
Accountable (A): Network Manager
Duration: Per installer</bpmn:documentation>
        <bpmn:incoming>W4989_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4989_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4989_Task8" name="Onboard to systems &amp; launch: provision the marketplace/platform account…">
        <bpmn:documentation>Step 3: Onboard to systems &amp; launch: provision the marketplace/platform account (VS-95/VS-27), the lead-routing/CRM (W4994), the settlement/billing (W4997), train on the referral process/code-of-conduct (W4992), and launch with probationary monitoring (W5003)
Responsible (R): IT / Network Manager / Training / Finance
Accountable (A): Network Manager
Duration: Per installer</bpmn:documentation>
        <bpmn:incoming>W4989_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4989_End9" name="Complete">
        <bpmn:incoming>W4989_Flow15</bpmn:incoming>
      </bpmn:endEvent>
