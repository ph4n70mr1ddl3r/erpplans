      <bpmn:sequenceFlow id="W3610_Flow12" sourceRef="W3610_Task5" targetRef="W3610_Task6" />
      <bpmn:sequenceFlow id="W3610_Flow13" sourceRef="W3610_Task6" targetRef="W3610_End7" />
    </bpmn:process>
