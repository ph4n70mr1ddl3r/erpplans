      <bpmndi:BPMNPlane id="W3611_plane" bpmnElement="W_W3611">
        <bpmndi:BPMNShape id="W3611_Lane1_di" bpmnElement="W3611_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
