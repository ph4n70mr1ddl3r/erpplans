      <bpmn:sequenceFlow id="W3611_Flow12" sourceRef="W3611_Task5" targetRef="W3611_Task6" />
      <bpmn:sequenceFlow id="W3611_Flow13" sourceRef="W3611_Task6" targetRef="W3611_Task7" />
      <bpmn:sequenceFlow id="W3611_Flow14" sourceRef="W3611_Task7" targetRef="W3611_End8" />
    </bpmn:process>
