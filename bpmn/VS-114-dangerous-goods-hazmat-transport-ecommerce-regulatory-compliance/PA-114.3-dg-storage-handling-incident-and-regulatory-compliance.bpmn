      <bpmn:startEvent id="W3613_Start3" name="DG incident (transport W3606, spill W3611, exposure W3610, fire)">
        <bpmn:outgoing>W3613_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3613_Task4" name="DG/Hazmat Compliance Officer/HSE conduct incident investigation: secure the…">
        <bpmn:documentation>Step 1: DG/Hazmat Compliance Officer/HSE conduct incident investigation: secure the scene/evidence, interview, root-cause analysis (5-why/fishbone), contributing factors (classification W3594, packaging W3598, handling W3610, carrier W3601, storage W3609), and the investigation report with corrective/preventive action (CAPA)
Responsible (R): DG/Hazmat Compliance Officer / HSE / Audit
Accountable (A): VP Legal
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3613_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3613_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3613_Task5" name="DG/Hazmat Compliance Officer/Compliance manage regulatory notification and…">
        <bpmn:documentation>Step 2: DG/Hazmat Compliance Officer/Compliance manage regulatory notification and reporting: DENR-EMB (environmental release), DOLE (worker injury/exposure, links to VS-24), BFP (fire), MARINA/Coast Guard/CAB/LTFRB (transport), LGU, and the BSP/insurance (links to VS-26); within statutory timelines; manage regulator follow-up
Responsible (R): DG/Hazmat Compliance Officer / Compliance / Legal
Accountable (A): VP Legal
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W3613_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3613_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3613_Task6" name="DG/Hazmat Compliance Officer/HSE track CAPA to closure, capture the incident in…">
        <bpmn:documentation>Step 3: DG/Hazmat Compliance Officer/HSE track CAPA to closure, capture the incident in the DG incident register and loss-event database, feed learnings to classification/packaging/training/carrier/storage, and report incident trends and loss events to governance (W3616), risk (links to VS-21.2), and audit (links to VS-21)
Responsible (R): DG/Hazmat Compliance Officer / HSE / Audit
Accountable (A): VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3613_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3613_End7" name="Complete">
        <bpmn:incoming>W3613_Flow13</bpmn:incoming>
      </bpmn:endEvent>
