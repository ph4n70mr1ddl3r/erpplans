      <bpmn:sequenceFlow id="W2367_Flow11" sourceRef="W2367_Task5" targetRef="W2367_Task6" />
      <bpmn:sequenceFlow id="W2367_Flow12" sourceRef="W2367_Task6" targetRef="W2367_End7" />
    </bpmn:process>
