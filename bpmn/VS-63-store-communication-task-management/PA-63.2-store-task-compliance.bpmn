    <bpmn:process id="W_W2367" name="W2367. Store-Level Task Execution &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Store receives task assignment
Frequency: ~400–800 tasks/month
Volume: ~2–4 tasks/store/week
Owner: Store Manager
Participants: Regional Ops Manager, Store Staff, HQ Function Mgr
Source: workflow W2367 — Store-Level Task Execution &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W2367_LaneSet3">
        <bpmn:lane id="W2367_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2367_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2367_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2367_Lane2" name="Store Staff">
        <bpmn:flowNodeRef>W2367_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2367_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2367_Start4" name="Store receives task assignment">
        <bpmn:outgoing>W2367_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2367_Task5" name="Store Manager reviews task requirements; assigns to appropriate Department…">
        <bpmn:documentation>Step 1: Store Manager reviews task requirements; assigns to appropriate Department Supervisor or staff member; sets internal deadline ahead of HQ deadline
Responsible (R): Store Manager
Accountable (A): Regional Ops Mgr
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2367_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2367_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2367_Task6" name="Staff executes task; documents completion with required evidence (photo, form…">
        <bpmn:documentation>Step 2: Staff executes task; documents completion with required evidence (photo, form, confirmation); submits via store manager app; Store Manager reviews and approves before submission to HQ
Responsible (R): Store Staff / Store Manager
Accountable (A): HQ Function Mgr
Duration: Varies by task</bpmn:documentation>
        <bpmn:incoming>W2367_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2367_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2367_End7" name="Complete">
        <bpmn:incoming>W2367_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2367_Annotation8">
        <bpmn:text>Controls: - CTL-419 (ensure controlled execution — Store Task Assignment &amp; Compliance Tracking (PA-63.2).) | - Operational: Store Manager approval-before-submission (step 2); Regional Ops Mgr oversight
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2367_Assoc9" sourceRef="W2367_Annotation8" targetRef="W2367_Start4" associationDirection="None" />
