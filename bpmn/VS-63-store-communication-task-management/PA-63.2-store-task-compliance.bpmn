    <bpmn:process id="W_W2366" name="W2366. Task Creation &amp; Assignment from HQ" isExecutable="false">
      <bpmn:documentation>Trigger: HQ function creates task for stores
Frequency: ~100–200 tasks/week across all HQ functions
Volume: ~400–800 tasks/month to 200 stores
Owner: HQ Function Manager
Participants: HQ Function Mgr, VP Store Operations, Store Manager
Source: workflow W2366 — Task Creation &amp; Assignment from HQ</bpmn:documentation>
      <bpmn:laneSet id="W2366_LaneSet3">
        <bpmn:lane id="W2366_Lane1" name="HQ Function Mgr">
        <bpmn:flowNodeRef>W2366_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2366_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2366_Lane2" name="System">
        <bpmn:flowNodeRef>W2366_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2366_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2366_Start4" name="HQ function creates task for stores">
        <bpmn:outgoing>W2366_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2366_Task5" name="HQ Manager creates task: description, assigned stores (all/regional/specific)…">
        <bpmn:documentation>Step 1: HQ Manager creates task: description, assigned stores (all/regional/specific), priority, category, deadline, required evidence (photo/checkbox/form), responsible role at store
Responsible (R): HQ Function Mgr
Accountable (A): VP Store Operations
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2366_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2366_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2366_Task6" name="System pushes to assigned stores; Store Manager acknowledges and assigns to…">
        <bpmn:documentation>Step 2: System pushes to assigned stores; Store Manager acknowledges and assigns to responsible staff; system tracks status (assigned/in-progress/completed/overdue)
Responsible (R): System / Store Manager
Accountable (A): HQ Function Mgr
Duration: Automated + 10 min</bpmn:documentation>
        <bpmn:incoming>W2366_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2366_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2366_End7" name="Complete">
        <bpmn:incoming>W2366_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2366_Annotation8">
        <bpmn:text>Controls: - CTL-199 (ensure store-communication task closure.) | - Operational: VP Store Operations task-volume oversight; HQ Function Manager priority-discipline
Owner: HQ Function Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2366_Assoc9" sourceRef="W2366_Annotation8" targetRef="W2366_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2366_Flow10" sourceRef="W2366_Start4" targetRef="W2366_Task5" />
      <bpmn:sequenceFlow id="W2366_Flow11" sourceRef="W2366_Task5" targetRef="W2366_Task6" />
      <bpmn:sequenceFlow id="W2366_Flow12" sourceRef="W2366_Task6" targetRef="W2366_End7" />
    </bpmn:process>
