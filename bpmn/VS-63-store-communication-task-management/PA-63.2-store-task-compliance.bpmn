      </bpmn:startEvent>
      <bpmn:serviceTask id="W2368_Task4" name="Dashboard: task completion rate by store, region, and function; overdue tasks…">
        <bpmn:documentation>Step 1: Dashboard: task completion rate by store, region, and function; overdue tasks highlighted; compliance score trending; non-responsive stores flagged for Regional Ops follow-up
Responsible (R): System / VP Store Operations
Accountable (A): COO
Duration: 30 min/day + 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2368_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2368_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2368_End5" name="Complete">
        <bpmn:incoming>W2368_Flow9</bpmn:incoming>
      </bpmn:endEvent>
