    <bpmn:process id="W_W2374" name="W2374. Communication Read Rate Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly analysis cycle — Communication Read Rate
Frequency: Weekly; all communications sent
Volume: ~10–15 broadcasts/week + ~400–800 tasks/month
Owner: VP Store Operations
Participants: VP Store Operations, COO
Source: workflow W2374 — Communication Read Rate Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2374_LaneSet2">
        <bpmn:lane id="W2374_Lane1" name="System">
        <bpmn:flowNodeRef>W2374_Task4</bpmn:flowNodeRef>
