        <bpmn:flowNodeRef>W2374_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2374_Start3" name="Weekly analysis cycle — Communication Read Rate">
        <bpmn:outgoing>W2374_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2374_Task4" name="System calculates: read rate per communication (target ≥95% within 24 hours for…">
        <bpmn:documentation>Step 1: System calculates: read rate per communication (target ≥95% within 24 hours for urgent, ≥90% within 48 hours for standard); identifies stores/regions with chronically low read rates
Responsible (R): System / VP Store Operations
Accountable (A): COO
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W2374_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2374_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2374_End5" name="Complete">
        <bpmn:incoming>W2374_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2374_Annotation6">
        <bpmn:text>Controls: - CTL-420 (ensure controlled execution — Communication Effectiveness &amp; Feedback Analytics (PA-63.3).) | - Operational: VP Store Operations weekly review; COO escalation on urgent-unread
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
