<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-157.3-period-close-disclosure-audit-and-new-revenue-stream-onboarding" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4641" name="W4641. Monthly/Quarterly Revenue Close, Reassessment &amp; Journal-Entry Cycle" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close (W9A); quarter-end; revenue-estimate update
Frequency: Monthly (close) + quarterly (comprehensive reassessment)
Volume: 5 entities × 12 months = 60 monthly closes; ~10–15 complex scenarios/quarter
Owner: Revenue Accounting Manager
Participants: Controller, GL/Close (VS-17.1), channel owners, Tax (VS-79)
Source: workflow W4641 — Monthly/Quarterly Revenue Close, Reassessment &amp; Journal-Entry Cycle</bpmn:documentation>
      <bpmn:laneSet id="W4641_LaneSet2">
        <bpmn:lane id="W4641_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4641_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4641_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4641_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4641_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4641_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4641_Start3" name="Month-end close (W9A); quarter-end; revenue-estimate update">
        <bpmn:outgoing>W4641_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4641_Task4" name="During month-end close (W9A), post the recurring PFRS 15 journals: gift-card…">
        <bpmn:documentation>Step 1: During month-end close (W9A), post the recurring PFRS 15 journals: gift-card breakage, points deferred-revenue release, subscription/warranty amortization, contract-cost amortization, variable-consideration estimate updates, principal-vs-agent net/gross postings
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Per close</bpmn:documentation>
        <bpmn:incoming>W4641_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4641_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4641_Task5" name="Reassess estimates quarterly (SSP, breakage, redemption, variable…">
        <bpmn:documentation>Step 2: Reassess estimates quarterly (SSP, breakage, redemption, variable consideration); post cumulative catch-ups; verify the allocation engine and deferral schedules across all entities
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4641_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4641_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4641_Task6" name="Tie total recognized revenue to the GL revenue accounts and to the channel…">
        <bpmn:documentation>Step 3: Tie total recognized revenue to the GL revenue accounts and to the channel subledgers; investigate any unreconciled variance before close sign-off
Responsible (R): Revenue Accounting / GL
Accountable (A): Controller
Duration: Per close</bpmn:documentation>
        <bpmn:incoming>W4641_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4641_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4641_End7" name="Complete">
        <bpmn:incoming>W4641_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4641_Annotation8">
        <bpmn:text>Controls: - CTL-703 (ensure controlled execution — Period Close, Disclosure, Audit &amp; New-Revenue-Stream Onboarding (PA-157.3).) | - CTL-703: close checklist; cumulative catch-ups posted quarterly; GL-subledger variance cleared before sign-off
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4641_Assoc9" sourceRef="W4641_Annotation8" targetRef="W4641_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4641_Flow10" sourceRef="W4641_Start3" targetRef="W4641_Task4" />
      <bpmn:sequenceFlow id="W4641_Flow11" sourceRef="W4641_Task4" targetRef="W4641_Task5" />
      <bpmn:sequenceFlow id="W4641_Flow12" sourceRef="W4641_Task5" targetRef="W4641_Task6" />
      <bpmn:sequenceFlow id="W4641_Flow13" sourceRef="W4641_Task6" targetRef="W4641_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4641_diag">
      <bpmndi:BPMNPlane id="W4641_plane" bpmnElement="W_W4641">
        <bpmndi:BPMNShape id="W4641_Lane1_di" bpmnElement="W4641_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4641_Task4_di" bpmnElement="W4641_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
