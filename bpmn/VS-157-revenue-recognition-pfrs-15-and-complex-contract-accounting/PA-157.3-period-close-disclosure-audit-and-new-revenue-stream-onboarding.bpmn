        <bpmndi:BPMNEdge id="W4641_Flow13_di" bpmnElement="W4641_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4641_Assoc9_di" bpmnElement="W4641_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4642" name="W4642. Year-End Comprehensive PFRS 15 Review, Policy Refresh &amp; Recalculation" isExecutable="false">
      <bpmn:documentation>Trigger: Year-end close (W9B); annual audit
Frequency: Annual
Volume: 1 enterprise review across 5 entities
Owner: Revenue Accounting Manager / Controller
Participants: CFO, channel owners, Tax (VS-79), External Auditor, Legal (VS-100.3)
Source: workflow W4642 — Year-End Comprehensive PFRS 15 Review, Policy Refresh &amp; Recalculation</bpmn:documentation>
      <bpmn:laneSet id="W4642_LaneSet3">
        <bpmn:lane id="W4642_Lane1" name="Controller">
        <bpmn:flowNodeRef>W4642_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4642_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4642_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4642_Lane2" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4642_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4642_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4642_Start4" name="Year-end close (W9B); annual audit">
        <bpmn:outgoing>W4642_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4642_Task5" name="Review all PFRS 15 accounting policies for continued appropriateness…">
        <bpmn:documentation>Step 1: Review all PFRS 15 accounting policies for continued appropriateness (principal-vs-agent, over-time/point-in-time, SSP methodology, breakage, variable consideration, financing component, contract costs); document any policy refresh
Responsible (R): Controller / Revenue Accounting
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4642_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4642_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4642_Task6" name="Recalculate breakage rates, SSP allocations, redemption estimates, and…">
        <bpmn:documentation>Step 2: Recalculate breakage rates, SSP allocations, redemption estimates, and deferred-revenue balances using full-year data; assess any new streams launched during the year (W4645) for PFRS 15 treatment
Responsible (R): Revenue Accounting / Analytics
Accountable (A): Controller
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4642_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4642_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4642_Task7" name="Coordinate with the External Auditor on the PFRS 15 audit approach and sampling…">
        <bpmn:documentation>Step 3: Coordinate with the External Auditor on the PFRS 15 audit approach and sampling (W4644); finalize the AFS disclosure note (W4643) and obtain CFO sign-off
Responsible (R): Controller / Revenue Accounting / External Auditor
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4642_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4642_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4642_End8" name="Complete">
        <bpmn:incoming>W4642_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4642_Annotation9">
        <bpmn:text>Controls: - CTL-703 (ensure controlled execution — Period Close, Disclosure, Audit &amp; New-Revenue-Stream Onboarding (PA-157.3).) | - CTL-703: policies reviewed annually; recalculations Controller/CFO-approved; disclosure note CFO-signed
Owner: Revenue Accounting Manager / Controller</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4642_Assoc10" sourceRef="W4642_Annotation9" targetRef="W4642_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4642_Flow11" sourceRef="W4642_Start4" targetRef="W4642_Task5" />
      <bpmn:sequenceFlow id="W4642_Flow12" sourceRef="W4642_Task5" targetRef="W4642_Task6" />
      <bpmn:sequenceFlow id="W4642_Flow13" sourceRef="W4642_Task6" targetRef="W4642_Task7" />
      <bpmn:sequenceFlow id="W4642_Flow14" sourceRef="W4642_Task7" targetRef="W4642_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4642_diag">
      <bpmndi:BPMNPlane id="W4642_plane" bpmnElement="W_W4642">
        <bpmndi:BPMNShape id="W4642_Lane1_di" bpmnElement="W4642_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Lane2_di" bpmnElement="W4642_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Task5_di" bpmnElement="W4642_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Task6_di" bpmnElement="W4642_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Task7_di" bpmnElement="W4642_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Start4_di" bpmnElement="W4642_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_End8_di" bpmnElement="W4642_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4642_Annotation9_di" bpmnElement="W4642_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4642_Flow11_di" bpmnElement="W4642_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4642_Flow12_di" bpmnElement="W4642_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4642_Flow13_di" bpmnElement="W4642_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4642_Flow14_di" bpmnElement="W4642_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4642_Assoc10_di" bpmnElement="W4642_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4643" name="W4643. Revenue Disaggregation, Disclosure Schedule &amp; AFS Note Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarter-end disclosure pack; year-end AFS
Frequency: Quarterly (interim) + annual (AFS)
Volume: 1 disclosure schedule; multiple disaggregation dimensions
Owner: Revenue Accounting Manager
Participants: Controller, CFO, External Auditor, Financial Reporting (VS-17.4)
Source: workflow W4643 — Revenue Disaggregation, Disclosure Schedule &amp; AFS Note Preparation</bpmn:documentation>
      <bpmn:laneSet id="W4643_LaneSet2">
        <bpmn:lane id="W4643_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4643_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4643_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4643_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4643_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4643_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4643_Start3" name="Quarter-end disclosure pack; year-end AFS">
        <bpmn:outgoing>W4643_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4643_Task4" name="Prepare the revenue disaggregation schedule: revenue by (a) nature/timing…">
        <bpmn:documentation>Step 1: Prepare the revenue disaggregation schedule: revenue by (a) nature/timing (goods, services, over-time, point-in-time), (b) channel (POS, ecommerce, trade, project, G2G, retail media, marketplace, VAS, subscription), (c) geography/region, (d) entity — per PFRS 15 ¶114 and SEC/PFRS presentation
Responsible (R): Revenue Accounting / Financial Reporting
Accountable (A): Controller
Duration: Per period</bpmn:documentation>
        <bpmn:incoming>W4643_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4643_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4643_Task5" name="Prepare the contract-balance disclosure: contract assets…">
        <bpmn:documentation>Step 2: Prepare the contract-balance disclosure: contract assets (recognized-but-unbilled), contract liabilities (deferred revenue, customer deposits), and significant judgments (SSP, breakage, variable-consideration constraint, financing component); include the revenue-reconciliation (opening/closing deferred revenue, recognized from prior-period deferred)
Responsible (R): Revenue Accounting
Accountable (A): Controller / CFO
Duration: Per period</bpmn:documentation>
        <bpmn:incoming>W4643_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4643_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4643_Task6" name="Roll the schedule into the AFS revenue note (year-end) and interim disclosure…">
        <bpmn:documentation>Step 3: Roll the schedule into the AFS revenue note (year-end) and interim disclosure pack; obtain External Auditor review and CFO sign-off; retain evidence (VS-88)
Responsible (R): Revenue Accounting / Financial Reporting / External Auditor
Accountable (A): CFO
Duration: Annual + quarterly</bpmn:documentation>
        <bpmn:incoming>W4643_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4643_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4643_End7" name="Complete">
        <bpmn:incoming>W4643_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4643_Annotation8">
        <bpmn:text>Controls: - CTL-703 (ensure controlled execution — Period Close, Disclosure, Audit &amp; New-Revenue-Stream Onboarding (PA-157.3).) | - CTL-703: disaggregation reconciled to GL/register; judgment checklist complete; note CFO-signed and auditor-reviewed
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4643_Assoc9" sourceRef="W4643_Annotation8" targetRef="W4643_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4643_Flow10" sourceRef="W4643_Start3" targetRef="W4643_Task4" />
      <bpmn:sequenceFlow id="W4643_Flow11" sourceRef="W4643_Task4" targetRef="W4643_Task5" />
      <bpmn:sequenceFlow id="W4643_Flow12" sourceRef="W4643_Task5" targetRef="W4643_Task6" />
      <bpmn:sequenceFlow id="W4643_Flow13" sourceRef="W4643_Task6" targetRef="W4643_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4643_diag">
      <bpmndi:BPMNPlane id="W4643_plane" bpmnElement="W_W4643">
        <bpmndi:BPMNShape id="W4643_Lane1_di" bpmnElement="W4643_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_Task4_di" bpmnElement="W4643_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_Task5_di" bpmnElement="W4643_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_Task6_di" bpmnElement="W4643_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_Start3_di" bpmnElement="W4643_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_End7_di" bpmnElement="W4643_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4643_Annotation8_di" bpmnElement="W4643_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4643_Flow10_di" bpmnElement="W4643_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4643_Flow11_di" bpmnElement="W4643_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4643_Flow12_di" bpmnElement="W4643_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4643_Flow13_di" bpmnElement="W4643_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4643_Assoc9_di" bpmnElement="W4643_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4644" name="W4644. External-Audit PFRS 15 Coordination, Sampling &amp; Evidence" isExecutable="false">
      <bpmn:documentation>Trigger: Audit planning; year-end audit; interim review
Frequency: Annual audit + interim
Volume: 1 audit cycle; ~ audit-selected sample of contracts/transactions
Owner: Revenue Accounting Manager / Controller
Participants: External Auditor, CFO, channel owners, Internal Audit (VS-21)
Source: workflow W4644 — External-Audit PFRS 15 Coordination, Sampling &amp; Evidence</bpmn:documentation>
      <bpmn:laneSet id="W4644_LaneSet3">
        <bpmn:lane id="W4644_Lane1" name="Controller">
        <bpmn:flowNodeRef>W4644_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4644_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4644_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4644_Lane2" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4644_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4644_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4644_Start4" name="Audit planning; year-end audit; interim review">
        <bpmn:outgoing>W4644_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4644_Task5" name="Engage the External Auditor early on the PFRS 15 audit plan, risk areas…">
        <bpmn:documentation>Step 1: Engage the External Auditor early on the PFRS 15 audit plan, risk areas (judgment-heavy: SSP, breakage, over-time measure, principal-vs-agent), and the sampling approach; agree the population (revenue-stream register W4625)
Responsible (R): Controller / Revenue Accounting / External Auditor
Accountable (A): CFO
Duration: Audit planning</bpmn:documentation>
        <bpmn:incoming>W4644_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4644_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4644_Task6" name="Provide auditor-requested evidence: contracts, SSP methodology and data…">
        <bpmn:documentation>Step 2: Provide auditor-requested evidence: contracts, SSP methodology and data, allocation samples, deferral/breakage calculations, principal-vs-agent analyses, disclosure support; respond to queries
Responsible (R): Revenue Accounting / Channel Owners
Accountable (A): Controller
Duration: During audit</bpmn:documentation>
        <bpmn:incoming>W4644_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4644_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4644_Task7" name="Track audit findings/adjustments to resolution; incorporate into the next…">
        <bpmn:documentation>Step 3: Track audit findings/adjustments to resolution; incorporate into the next policy-refresh (W4642) and control improvements (W4648); coordinate with Internal Audit (VS-21) on any control deficiencies
Responsible (R): Controller / Revenue Accounting / Internal Audit
Accountable (A): CFO
Duration: During + post-audit</bpmn:documentation>
