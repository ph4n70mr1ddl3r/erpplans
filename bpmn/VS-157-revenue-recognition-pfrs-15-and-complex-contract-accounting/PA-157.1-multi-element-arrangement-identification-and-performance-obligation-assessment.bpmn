        <bpmndi:BPMNShape id="W4626_Task7_di" bpmnElement="W4626_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4626_Start4_di" bpmnElement="W4626_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4626_End8_di" bpmnElement="W4626_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4626_Annotation9_di" bpmnElement="W4626_Annotation9"><dc:Bounds x="160" y="460" width="360" height="100" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4626_Flow11_di" bpmnElement="W4626_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4626_Flow12_di" bpmnElement="W4626_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4626_Flow13_di" bpmnElement="W4626_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4626_Flow14_di" bpmnElement="W4626_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4626_Assoc10_di" bpmnElement="W4626_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4627" name="W4627. Performance-Obligation Identification for Bundled Product + Service Arrangements" isExecutable="false">
      <bpmn:documentation>Trigger: New bundle/kit launch (VS-92); installation-with-product sale (VS-12); design+build (VS-66)
Frequency: Per bundle SKU/service combo + annual review
Volume: ~300–500 kit/bundle SKUs in catalog; every product+install sale (VS-12)
Owner: Revenue Accounting Manager
Participants: Merchandising (VS-01.1/VS-92), Services (VS-12/VS-66), Pricing, Controller
Source: workflow W4627 — Performance-Obligation Identification for Bundled Product + Service Arrangements</bpmn:documentation>
      <bpmn:laneSet id="W4627_LaneSet2">
        <bpmn:lane id="W4627_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4627_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4627_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4627_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4627_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4627_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4627_Start3" name="New bundle/kit launch (VS-92); installation-with-product sale (VS-12); design+build…">
        <bpmn:outgoing>W4627_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4627_Task4" name="For each bundle (VS-92) and product+installation sale (VS-12), identify the…">
        <bpmn:documentation>Step 1: For each bundle (VS-92) and product+installation sale (VS-12), identify the distinct performance obligations: is the product distinct from the installation service? Is the design service (VS-66) distinct from materials? Apply the &quot;distinct&quot; criteria (capable of being used alone; identifiable in the contract)
Responsible (R): Revenue Accounting / Merchandising / Services
Accountable (A): Controller
Duration: Per bundle/combo</bpmn:documentation>
        <bpmn:incoming>W4627_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4627_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4627_Task5" name="Determine recognition timing per obligation: product = point in time…">
        <bpmn:documentation>Step 2: Determine recognition timing per obligation: product = point in time (delivery/POS, control transfer); installation = point in time (completion) or over-time if it creates an asset with no alternative use + right to payment; design = over-time/point-in-time per terms
Responsible (R): Revenue Accounting
Accountable (A): Controller
Duration: Per combo</bpmn:documentation>
        <bpmn:incoming>W4627_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4627_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4627_Task6" name="Tag the kit/BOM (VS-92.1) and the service-work-order (W544) with the…">
        <bpmn:documentation>Step 3: Tag the kit/BOM (VS-92.1) and the service-work-order (W544) with the performance-obligigation structure so POS/order posting routes revenue to the correct obligation and period
Responsible (R): Revenue Accounting / IT
Accountable (A): Controller / CIO
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4627_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4627_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4627_End7" name="Complete">
        <bpmn:incoming>W4627_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4627_Annotation8">
        <bpmn:text>Controls: - CTL-701 (ensure controlled execution — Multi-Element Arrangement Identification &amp; Performance Obligation Assessment (PA-157.1).) | - CTL-701: distinct-obligation assessment documented per bundle; recognition-timing criteria checklist; obligation tags reviewed at kit setup
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4627_Assoc9" sourceRef="W4627_Annotation8" targetRef="W4627_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4627_Flow10" sourceRef="W4627_Start3" targetRef="W4627_Task4" />
      <bpmn:sequenceFlow id="W4627_Flow11" sourceRef="W4627_Task4" targetRef="W4627_Task5" />
      <bpmn:sequenceFlow id="W4627_Flow12" sourceRef="W4627_Task5" targetRef="W4627_Task6" />
      <bpmn:sequenceFlow id="W4627_Flow13" sourceRef="W4627_Task6" targetRef="W4627_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4627_diag">
      <bpmndi:BPMNPlane id="W4627_plane" bpmnElement="W_W4627">
        <bpmndi:BPMNShape id="W4627_Lane1_di" bpmnElement="W4627_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_Task4_di" bpmnElement="W4627_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_Task5_di" bpmnElement="W4627_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_Task6_di" bpmnElement="W4627_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_Start3_di" bpmnElement="W4627_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_End7_di" bpmnElement="W4627_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4627_Annotation8_di" bpmnElement="W4627_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4627_Flow10_di" bpmnElement="W4627_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4627_Flow11_di" bpmnElement="W4627_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4627_Flow12_di" bpmnElement="W4627_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4627_Flow13_di" bpmnElement="W4627_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4627_Assoc9_di" bpmnElement="W4627_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4628" name="W4628. Principal-vs-Agent (Gross-vs-Net) Determination for Marketplace, Retail Media, VAS &amp; COD" isExecutable="false">
      <bpmn:documentation>Trigger: New marketplace/retail-media/VAS/COD flow; annual gross/net review
Frequency: Per flow + annual
Volume: ~7 principal-vs-agent decisions across VS-48/VS-95/VS-156/VS-142/VS-154/VS-155/VS-11(3P)
Owner: Revenue Accounting Manager
Participants: Channel owners (VS-48/95/156/142/154/155), Legal (VS-100.3), Tax (VS-79), Controller, External Auditor
Source: workflow W4628 — Principal-vs-Agent (Gross-vs-Net) Determination for Marketplace, Retail Media, VAS &amp; COD</bpmn:documentation>
      <bpmn:laneSet id="W4628_LaneSet3">
        <bpmn:lane id="W4628_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4628_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4628_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4628_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4628_Lane2" name="Revenue Accounting Manager">
        <bpmn:flowNodeRef>W4628_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4628_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4628_Start4" name="New marketplace/retail-media/VAS/COD flow; annual gross/net review">
        <bpmn:outgoing>W4628_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4628_Task5" name="For each flow where BuildRight sits between a third party and a customer…">
        <bpmn:documentation>Step 1: For each flow where BuildRight sits between a third party and a customer (marketplace 3P seller VS-95, retail media VS-48, VAS/financial-agency VS-156, COD VS-142, construction-finance referral VS-154, trade-in resale VS-155), apply the principal-vs-agent indicators: control of the good/service before transfer; primary obligor; inventory risk; pricing discretion; credit risk
Responsible (R): Revenue Accounting / Channel / Legal
Accountable (A): Controller / VP Legal
Duration: Per flow</bpmn:documentation>
        <bpmn:incoming>W4628_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4628_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4628_Task6" name="Conclude gross (recognize full revenue + offsetting cost) vs. net (recognize…">
        <bpmn:documentation>Step 2: Conclude gross (recognize full revenue + offsetting cost) vs. net (recognize only commission/fee) and document the rationale + indicator evidence; for VAS (VS-156) confirm BuildRight is agent of the principal; for marketplace confirm BuildRight is platform operator (net on commission)
Responsible (R): Revenue Accounting Manager
Accountable (A): Controller / CFO
Duration: Per flow</bpmn:documentation>
        <bpmn:incoming>W4628_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4628_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4628_Task7" name="Configure the ERP/POS/ecommerce posting to gross or net per the conclusion…">
        <bpmn:documentation>Step 3: Configure the ERP/POS/ecommerce posting to gross or net per the conclusion; reflect in the disclosure schedule (W4643) and re-assess annually or on flow change
Responsible (R): Revenue Accounting / IT
Accountable (A): Controller / CIO
Duration: Per setup + annual</bpmn:documentation>
        <bpmn:incoming>W4628_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4628_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4628_End8" name="Complete">
        <bpmn:incoming>W4628_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4628_Annotation9">
        <bpmn:text>Controls: - CTL-701 (ensure controlled execution — Multi-Element Arrangement Identification &amp; Performance Obligation Assessment (PA-157.1).) | - CTL-701: documented indicator-based principal-vs-agent decision per flow (reviewed by External Auditor); system posting matches the conclusion; re-assessed annually
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
