        <bpmndi:BPMNEdge id="W4625_Flow11_di" bpmnElement="W4625_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4625_Flow12_di" bpmnElement="W4625_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4625_Flow13_di" bpmnElement="W4625_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4625_Flow14_di" bpmnElement="W4625_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4625_Assoc10_di" bpmnElement="W4625_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4626" name="W4626. Contract Identification, Combination &amp; Modification Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: New/custom contract; contract modification; bundling of separate contracts
Frequency: Per significant contract + periodic review of template contracts
Volume: ~hundreds of B2B/project/template contracts/yr; ~5–10 complex combinations/yr
Owner: Revenue Accounting Manager
Participants: Legal (VS-100.3), Channel owners, Tax (VS-79), Controller
Source: workflow W4626 — Contract Identification, Combination &amp; Modification Assessment</bpmn:documentation>
      <bpmn:laneSet id="W4626_LaneSet3">
        <bpmn:lane id="W4626_Lane1" name="Revenue Accounting">
        <bpmn:flowNodeRef>W4626_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4626_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4626_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4626_Lane2" name="Revenue Accounting Manager">
        <bpmn:flowNodeRef>W4626_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4626_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4626_Start4" name="New/custom contract; contract modification; bundling of separate contracts">
        <bpmn:outgoing>W4626_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4626_Task5" name="Revenue Accounting/Legal determine whether a contract exists under PFRS 15…">
        <bpmn:documentation>Step 1: Revenue Accounting/Legal determine whether a contract exists under PFRS 15 (enforceable rights/obligations, commercial substance, collectibility probable) for atypical arrangements (trade-in W4577, construction-finance referral W4553, COD W4265, design-service MOUs VS-66)
Responsible (R): Revenue Accounting / Legal
Accountable (A): Controller / VP Legal
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W4626_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4626_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4626_Task6" name="Assess contract combination (multiple contracts with same customer entered near…">
        <bpmn:documentation>Step 2: Assess contract combination (multiple contracts with same customer entered near in time with single commercial objective — common in project/B2B VS-11/VS-46) and contract modification (change-scope/price — is it a separate contract or a cumulative catch-up?)
Responsible (R): Revenue Accounting / Legal
Accountable (A): Controller
Duration: Per modification</bpmn:documentation>
        <bpmn:incoming>W4626_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4626_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4626_Task7" name="Document the identification/combination/modification conclusion and the…">
        <bpmn:documentation>Step 3: Document the identification/combination/modification conclusion and the resulting performance-obligation remeasurement; route consequential changes to W4641 close cycle and W4645 if a new pattern
Responsible (R): Revenue Accounting Manager
Accountable (A): Controller
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W4626_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4626_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4626_End8" name="Complete">
        <bpmn:incoming>W4626_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4626_Annotation9">
        <bpmn:text>Controls: - CTL-701 (ensure controlled execution — Multi-Element Arrangement Identification &amp; Performance Obligation Assessment (PA-157.1).) | - CTL-701: contract-identification decision documented for atypical arrangements; modification classification reviewed by Controller; Legal sign-off on combined-contract conclusions
Owner: Revenue Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4626_Assoc10" sourceRef="W4626_Annotation9" targetRef="W4626_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4626_Flow11" sourceRef="W4626_Start4" targetRef="W4626_Task5" />
      <bpmn:sequenceFlow id="W4626_Flow12" sourceRef="W4626_Task5" targetRef="W4626_Task6" />
      <bpmn:sequenceFlow id="W4626_Flow13" sourceRef="W4626_Task6" targetRef="W4626_Task7" />
      <bpmn:sequenceFlow id="W4626_Flow14" sourceRef="W4626_Task7" targetRef="W4626_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4626_diag">
      <bpmndi:BPMNPlane id="W4626_plane" bpmnElement="W_W4626">
        <bpmndi:BPMNShape id="W4626_Lane1_di" bpmnElement="W4626_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4626_Lane2_di" bpmnElement="W4626_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4626_Task5_di" bpmnElement="W4626_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
