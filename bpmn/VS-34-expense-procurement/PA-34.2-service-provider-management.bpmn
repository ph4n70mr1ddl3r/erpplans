      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1681" name="W1681. Security &amp; Cleaning Service Provider Management" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing service management cycle
Frequency: Monthly monitoring; quarterly review
Volume: ~200 store security guards + 200 store cleaning contracts + 4 DC security + HQ security
Owner: Facilities Manager
Participants: Facilities Manager, Store Managers, Security Agency, Cleaning Agency
Source: workflow W1681 — Security &amp; Cleaning Service Provider Management</bpmn:documentation>
      <bpmn:laneSet id="W1681_LaneSet3">
        <bpmn:lane id="W1681_Lane1" name="Facilities Manager">
        <bpmn:flowNodeRef>W1681_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1681_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1681_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1681_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1681_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1681_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1681_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1681_Start4" name="Ongoing service management cycle">
        <bpmn:outgoing>W1681_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1681_Task5" name="Facilities Manager manages security service: (a) contracted security agency…">
        <bpmn:documentation>Step 1: Facilities Manager manages security service: (a) contracted security agency provides guards for all 200 stores (typically 1 guard per store during operating hours; 2 for high-risk locations), (b) DC security: 24/7 coverage at 4 DCs, (c) HQ security: reception and after-hours, (d) guard rotation and deployment scheduling, (e) guard licensing verification (per SOSIA — Supervisory Office for Security and Investigation Agencies)
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1681_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1681_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1681_Task6" name="Monthly: Store Manager rates security guard performance: (a) attendance and…">
        <bpmn:documentation>Step 2: Monthly: Store Manager rates security guard performance: (a) attendance and punctuality, (b) alertness and professionalism, (c) incident response, (d) report submission; ratings aggregated by security agency for quarterly review
Responsible (R): Store Manager
Accountable (A): Facilities Manager
Duration: 15 min/month</bpmn:documentation>
        <bpmn:incoming>W1681_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1681_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1681_Task7" name="Cleaning service management: (a) contracted cleaning service provides daily…">
        <bpmn:documentation>Step 3: Cleaning service management: (a) contracted cleaning service provides daily cleaning for all stores (before/after hours), (b) DC deep cleaning quarterly, (c) monthly cleanliness inspection by Facilities Manager or Regional Manager (scored 1–5)
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1681_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1681_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1681_Task8" name="Quarterly: Facilities Manager reviews security and cleaning agency performance…">
        <bpmn:documentation>Step 4: Quarterly: Facilities Manager reviews security and cleaning agency performance with Procurement Specialist; addresses issues; plans contract renewals per W1676
Responsible (R): Facilities Manager / Procurement Specialist
Accountable (A): VP Store Operations
Duration: 2 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1681_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1681_End9" name="Complete">
        <bpmn:incoming>W1681_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1681_Annotation10">
        <bpmn:text>Controls: - CTL-344 (ensure controlled execution — Service Provider &amp; Contract Management (PA-34.2).) | - operational: Facilities Manager review and approval gate
Owner: Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1681_Assoc11" sourceRef="W1681_Annotation10" targetRef="W1681_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1681_Flow12" sourceRef="W1681_Start4" targetRef="W1681_Task5" />
      <bpmn:sequenceFlow id="W1681_Flow13" sourceRef="W1681_Task5" targetRef="W1681_Task6" />
