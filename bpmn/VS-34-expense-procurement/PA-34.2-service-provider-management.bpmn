    <bpmn:process id="W_W1680" name="W1680. Third-Party Logistics (3PL) Service Contract Management" isExecutable="false">
      <bpmn:documentation>Trigger: 3PL contract management cycle
Frequency: Monthly monitoring; quarterly review; annual renewal
Volume: ~10–15 active 3PL contracts (80% of fleet is third-party per model company profile)
Owner: Logistics Coordinator
Participants: Logistics Coordinator, VP Supply Chain, Procurement Specialist, Finance
Source: workflow W1680 — Third-Party Logistics (3PL) Service Contract Management</bpmn:documentation>
      <bpmn:laneSet id="W1680_LaneSet3">
        <bpmn:lane id="W1680_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W1680_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1680_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1680_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1680_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1680_Lane2" name="Finance">
        <bpmn:flowNodeRef>W1680_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1680_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1680_Start4" name="3PL contract management cycle">
        <bpmn:outgoing>W1680_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1680_Task5" name="Logistics Coordinator manages 3PL contracts for: (a) DC-to-store delivery…">
        <bpmn:documentation>Step 1: Logistics Coordinator manages 3PL contracts for: (a) DC-to-store delivery trucks (~160 3PL-contracted = 80% of the ~200-truck fleet; 40 owned), (b) last-mile delivery partners (Lalamove, Transportify for ecommerce), (c) inter-island ferry transport, (d) port drayage (container pickup from port to DC)
Responsible (R): Logistics Coordinator
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1680_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1680_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1680_Task6" name="Monthly SLA tracking: (a) on-time pickup rate (target: &gt; 95%), (b) on-time…">
        <bpmn:documentation>Step 2: Monthly SLA tracking: (a) on-time pickup rate (target: &gt; 95%), (b) on-time delivery rate (target: &gt; 95%), (c) damage rate during transport (target: &lt; 0.5%), (d) vehicle availability rate, (e) driver compliance (uniform, PPE, behavior), (f) cost per delivery vs. contract rate
Responsible (R): Logistics Coordinator
Accountable (A): VP Supply Chain
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1680_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1680_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1680_Task7" name="Monthly freight cost reconciliation: (a) verify 3PL invoices against delivery…">
        <bpmn:documentation>Step 3: Monthly freight cost reconciliation: (a) verify 3PL invoices against delivery records, (b) rate verification per contract, (c) fuel surcharge calculation verification (per DOE fuel price index), (d) penalty deduction for SLA breaches
Responsible (R): Finance / Logistics Coordinator
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1680_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1680_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1680_Task8" name="Annual contract review per W1676; retender if performance below SLA or market…">
        <bpmn:documentation>Step 4: Annual contract review per W1676; retender if performance below SLA or market rates more competitive
Responsible (R): Logistics Coordinator / Procurement Specialist
Accountable (A): VP Supply Chain
Duration: Per W1676</bpmn:documentation>
        <bpmn:incoming>W1680_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1680_End9" name="Complete">
        <bpmn:incoming>W1680_Flow16</bpmn:incoming>
      </bpmn:endEvent>
