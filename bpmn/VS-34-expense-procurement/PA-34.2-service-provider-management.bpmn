      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1682" name="W1682. Service Provider Contract Termination &amp; Transition Management" isExecutable="false">
      <bpmn:documentation>Trigger: Contract non-renewal decision or early termination due to performance failure
Frequency: ~5–10 terminations/transitions/year
Volume: Variable
Owner: Procurement Specialist
Participants: Procurement Specialist, Contract Owner, Legal, Finance, incoming provider
Source: workflow W1682 — Service Provider Contract Termination &amp; Transition Management</bpmn:documentation>
      <bpmn:laneSet id="W1682_LaneSet4">
        <bpmn:lane id="W1682_Lane1" name="Contract Owner">
        <bpmn:flowNodeRef>W1682_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1682_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1682_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1682_Lane2" name="Legal">
        <bpmn:flowNodeRef>W1682_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1682_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1682_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1682_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1682_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1682_Start5" name="Contract non-renewal decision or early termination due to performance failure">
        <bpmn:outgoing>W1682_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1682_Task6" name="Contract Owner initiates termination: (a) documents reason (performance…">
        <bpmn:documentation>Step 1: Contract Owner initiates termination: (a) documents reason (performance failure, strategic change, cost reduction), (b) reviews contract termination provisions (notice period — typically 30–90 days; early termination fees), (c) obtains approval from VP and Finance
Responsible (R): Contract Owner
Accountable (A): Procurement Specialist
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1682_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1682_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1682_Task7" name="Legal reviews termination for compliance with contract terms and Philippine…">
        <bpmn:documentation>Step 2: Legal reviews termination for compliance with contract terms and Philippine labor law (if outsourced staff at BuildRight locations are affected — security guards, cleaners may have tenure rights under DOLE DO 174)
Responsible (R): Legal
Accountable (A): VP Legal
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1682_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1682_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1682_Task8" name="Procurement Specialist provides formal notice to provider per contract terms…">
        <bpmn:documentation>Step 3: Procurement Specialist provides formal notice to provider per contract terms; initiates transition planning with incoming provider (identified per W1677)
Responsible (R): Procurement Specialist
Accountable (A): Contract Owner
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1682_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1682_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1682_Task9" name="Transition execution: (a) phase-out schedule (overlapping with new provider for…">
        <bpmn:documentation>Step 4: Transition execution: (a) phase-out schedule (overlapping with new provider for 2–4 weeks), (b) asset return (if provider has BuildRight equipment/materials), (c) final invoice and payment settlement, (d) outstanding SLA penalty deduction, (e) knowledge transfer to incoming provider
Responsible (R): Procurement Specialist / Contract Owner
Accountable (A): —
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1682_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1682_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1682_Task10" name="Post-transition: Contract Owner monitors new provider performance closely for…">
        <bpmn:documentation>Step 5: Post-transition: Contract Owner monitors new provider performance closely for first 30 days; compares to predecessor performance
Responsible (R): Contract Owner
Accountable (A): —
Duration: 30 days</bpmn:documentation>
        <bpmn:incoming>W1682_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1682_End11" name="Complete">
        <bpmn:incoming>W1682_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1682_Annotation12">
        <bpmn:text>Controls: - CTL-344 (ensure controlled execution — Service Provider &amp; Contract Management (PA-34.2).) | - operational: Procurement Specialist review and approval gate
Owner: Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1682_Assoc13" sourceRef="W1682_Annotation12" targetRef="W1682_Start5" associationDirection="None" />
