<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-34.2-service-provider-management" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1676" name="W1676. Annual Service Contract Renewal &amp; Renegotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Contract expiry alert (90 days before expiry)
Frequency: ~80–120 contract renewals/year
Volume: ~8–10 renewals/month
Owner: Procurement Specialist
Participants: Procurement Specialist, Contract Owner (department head), Finance, Legal
Source: workflow W1676 — Annual Service Contract Renewal &amp; Renegotiation</bpmn:documentation>
      <bpmn:laneSet id="W1676_LaneSet5">
        <bpmn:lane id="W1676_Lane1" name="System">
        <bpmn:flowNodeRef>W1676_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1676_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1676_Lane2" name="Contract Owner">
        <bpmn:flowNodeRef>W1676_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1676_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1676_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1676_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1676_Task11</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1676_Lane4" name="Finance">
        <bpmn:flowNodeRef>W1676_Task12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1676_End13</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1676_Start6" name="Contract expiry alert (90 days before expiry)">
        <bpmn:outgoing>W1676_Flow16</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1676_Task7" name="System alerts Procurement Specialist of upcoming contract expirations (90…">
        <bpmn:documentation>Step 1: System alerts Procurement Specialist of upcoming contract expirations (90 days); contract owner (department head) receives notification to assess service quality and renewal interest
Responsible (R): System
Accountable (A): Procurement Specialist
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1676_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1676_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1676_Task8" name="Contract owner assesses: (a) service quality over past year (per SLA monitoring…">
        <bpmn:documentation>Step 2: Contract owner assesses: (a) service quality over past year (per SLA monitoring W1678), (b) pricing competitiveness (market benchmark), (c) strategic fit (are needs changing?), (d) recommends: renew, renegotiate, or retender
Responsible (R): Contract Owner
Accountable (A): —
Duration: 2 hours/contract</bpmn:documentation>
        <bpmn:incoming>W1676_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1676_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1676_Task9" name="Renew">
        <bpmn:documentation>Step 3: Renew: if service quality satisfactory and pricing competitive, Procurement Specialist renews at existing or inflation-adjusted terms (CPI + 1–2% typical for Philippine service contracts)
Responsible (R): Procurement Specialist
Accountable (A): Contract Owner
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1676_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1676_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1676_Task10" name="Renegotiate">
        <bpmn:documentation>Step 4: Renegotiate: if service quality issues or pricing above market, Procurement Specialist: (a) obtains competitive quotes from alternative providers, (b) negotiates improved terms with current provider (using competitive quotes as leverage), (c) presents options to contract owner with recommendation
Responsible (R): Procurement Specialist
Accountable (A): Contract Owner / Finance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1676_Flow19</bpmn:incoming>
        <bpmn:outgoing>W1676_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1676_Task11" name="Retender">
        <bpmn:documentation>Step 5: Retender: if significant dissatisfaction or high-value contract (&gt; PHP 5M/year), Procurement Specialist conducts formal bidding process: (a) prepare request for proposal (RFP) with specifications, (b) invite 3–5 qualified bidders, (c) evaluate bids: price (40%), quality/capability (30%), track record (20%), terms (10%), (d) recommend to contract owner
Responsible (R): Procurement Specialist
Accountable (A): Contract Owner / Finance / Legal
Duration: 4 weeks</bpmn:documentation>
        <bpmn:incoming>W1676_Flow20</bpmn:incoming>
        <bpmn:outgoing>W1676_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1676_Task12" name="Finance approves contract value; Legal reviews contract terms; signing…">
        <bpmn:documentation>Step 6: Finance approves contract value; Legal reviews contract terms; signing authority per corporate policy (Board resolution for contracts &gt; PHP 10M)
Responsible (R): Finance / Legal
Accountable (A): CFO / CEO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1676_Flow21</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1676_End13" name="Complete">
        <bpmn:incoming>W1676_Flow22</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1676_Annotation14">
        <bpmn:text>Controls: - CTL-207 (prevent unauthorized non-merchandise spend.) | - operational: Procurement Specialist review and approval gate
Owner: Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1676_Assoc15" sourceRef="W1676_Annotation14" targetRef="W1676_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1676_Flow16" sourceRef="W1676_Start6" targetRef="W1676_Task7" />
      <bpmn:sequenceFlow id="W1676_Flow17" sourceRef="W1676_Task7" targetRef="W1676_Task8" />
      <bpmn:sequenceFlow id="W1676_Flow18" sourceRef="W1676_Task8" targetRef="W1676_Task9" />
      <bpmn:sequenceFlow id="W1676_Flow19" sourceRef="W1676_Task9" targetRef="W1676_Task10" />
      <bpmn:sequenceFlow id="W1676_Flow20" sourceRef="W1676_Task10" targetRef="W1676_Task11" />
      <bpmn:sequenceFlow id="W1676_Flow21" sourceRef="W1676_Task11" targetRef="W1676_Task12" />
      <bpmn:sequenceFlow id="W1676_Flow22" sourceRef="W1676_Task12" targetRef="W1676_End13" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1676_diag">
      <bpmndi:BPMNPlane id="W1676_plane" bpmnElement="W_W1676">
        <bpmndi:BPMNShape id="W1676_Lane1_di" bpmnElement="W1676_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
