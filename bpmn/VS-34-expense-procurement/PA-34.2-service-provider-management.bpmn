    <bpmn:process id="W_W1679" name="W1679. Professional Services Engagement &amp; Statement of Work Management" isExecutable="false">
      <bpmn:documentation>Trigger: Need for specialized professional services (consulting, legal, audit, design)
Frequency: ~30–50 professional services engagements/year
Volume: ~3–4 per month
Owner: Engaging Department Head
Participants: Department Head, Procurement Specialist, Finance, Legal
Source: workflow W1679 — Professional Services Engagement &amp; Statement of Work Management</bpmn:documentation>
      <bpmn:laneSet id="W1679_LaneSet3">
        <bpmn:lane id="W1679_Lane1" name="Department Head">
        <bpmn:flowNodeRef>W1679_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1679_Lane2" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1679_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1679_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1679_Start4" name="Need for specialized professional services (consulting, legal, audit, design)">
        <bpmn:outgoing>W1679_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1679_Task5" name="Department Head identifies need for professional services: (a) management…">
        <bpmn:documentation>Step 1: Department Head identifies need for professional services: (a) management consulting (e.g., organizational restructuring, process improvement), (b) legal services (e.g., contract review, litigation, regulatory compliance), (c) external audit (e.g., financial statement audit, internal audit co-sourcing), (d) design services (e.g., store layout, marketing creative), (e) engineering (e.g., structural assessment, construction management)
Responsible (R): Department Head
Accountable (A): C-Suite sponsor
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1679_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1679_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1679_Task6" name="Department Head creates statement of work (SOW): (a) objectives and…">
        <bpmn:documentation>Step 2: Department Head creates statement of work (SOW): (a) objectives and deliverables, (b) scope and exclusions, (c) timeline and milestones, (d) resource requirements (consultant hours, team composition), (e) acceptance criteria, (f) budget estimate
Responsible (R): Department Head
Accountable (A): —
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1679_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1679_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1679_Task7" name="Procurement Specialist sources and evaluates providers: (a) for recurring needs…">
        <bpmn:documentation>Step 3: Procurement Specialist sources and evaluates providers: (a) for recurring needs (legal, audit): use retained firms, (b) for project-based needs: obtain 2–3 proposals, (c) evaluate: expertise, track record, team composition, fees, availability, (d) recommend to engaging department head
Responsible (R): Procurement Specialist
Accountable (A): Department Head
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1679_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1679_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1679_Task8" name="Engagement setup: (a) sign SOW or engagement letter, (b) NDA (non-disclosure…">
        <bpmn:documentation>Step 4: Engagement setup: (a) sign SOW or engagement letter, (b) NDA (non-disclosure agreement) signed per W243, (c) system creates service PO with SOW reference, (d) budget allocated from department OpEx
Responsible (R): Department Head / Legal
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1679_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1679_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1679_Task9" name="During engagement: Department Head monitors progress against SOW milestones…">
        <bpmn:documentation>Step 5: During engagement: Department Head monitors progress against SOW milestones; approves deliverables; authorizes milestone payments upon acceptance
Responsible (R): Department Head
Accountable (A): C-Suite sponsor
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1679_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1679_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1679_Task10" name="At engagement completion: (a) final deliverable accepted, (b) final invoice…">
        <bpmn:documentation>Step 6: At engagement completion: (a) final deliverable accepted, (b) final invoice processed, (c) provider performance evaluation recorded, (d) lessons learned documented
Responsible (R): Department Head
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1679_Flow19</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1679_End11" name="Complete">
        <bpmn:incoming>W1679_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1679_Annotation12">
        <bpmn:text>Controls: - CTL-344 (ensure controlled execution — Service Provider &amp; Contract Management (PA-34.2).) | - operational: Engaging Department Head review and approval gate
Owner: Engaging Department Head</bpmn:text>
      </bpmn:textAnnotation>
