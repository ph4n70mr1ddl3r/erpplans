        <bpmndi:BPMNEdge id="W1676_Flow21_di" bpmnElement="W1676_Flow21"><di:waypoint x="1420" y="505" /><di:waypoint x="1450" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1676_Flow22_di" bpmnElement="W1676_Flow22"><di:waypoint x="1630" y="675" /><di:waypoint x="1680" y="675" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1676_Assoc15_di" bpmnElement="W1676_Assoc15"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1677" name="W1677. New Service Provider Evaluation &amp; Onboarding" isExecutable="false">
      <bpmn:documentation>Trigger: New service need identified or retender decision from W1676
Frequency: ~20–30 new service provider evaluations/year
Volume: ~2–3 per month
Owner: Procurement Specialist
Participants: Procurement Specialist, Contract Owner, Finance, Legal
Source: workflow W1677 — New Service Provider Evaluation &amp; Onboarding</bpmn:documentation>
      <bpmn:laneSet id="W1677_LaneSet3">
        <bpmn:lane id="W1677_Lane1" name="Contract Owner">
        <bpmn:flowNodeRef>W1677_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1677_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1677_Lane2" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1677_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1677_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1677_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1677_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1677_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1677_Start4" name="New service need identified or retender decision from W1676">
        <bpmn:outgoing>W1677_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1677_Task5" name="Contract Owner defines service requirements: (a) scope of services, (b)…">
        <bpmn:documentation>Step 1: Contract Owner defines service requirements: (a) scope of services, (b) expected volume and frequency, (c) SLA expectations, (d) geographic coverage (nationwide across 200 stores + 4 DCs + HQ), (e) budget range
Responsible (R): Contract Owner
Accountable (A): Procurement Specialist
Duration: 4 hours</bpmn:documentation>
        <bpmn:incoming>W1677_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1677_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1677_Task6" name="Procurement Specialist sources potential providers: (a) market research…">
        <bpmn:documentation>Step 2: Procurement Specialist sources potential providers: (a) market research (Philippine market), (b) industry referrals, (c) invite 3–5 providers to bid, (d) provide RFP with detailed requirements
Responsible (R): Procurement Specialist
Accountable (A): Contract Owner
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1677_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1677_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1677_Task7" name="Evaluate proposals: (a) capability assessment: can they serve 200+ locations…">
        <bpmn:documentation>Step 3: Evaluate proposals: (a) capability assessment: can they serve 200+ locations across Philippine islands?, (b) financial stability: check business registration, financial references, (c) reference checks: contact existing clients (preferably in retail), (d) pilot or site visit if high-value contract
Responsible (R): Procurement Specialist / Contract Owner
Accountable (A): Finance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1677_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1677_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1677_Task8" name="Select provider; negotiate contract terms: (a) pricing and payment terms, (b)…">
        <bpmn:documentation>Step 4: Select provider; negotiate contract terms: (a) pricing and payment terms, (b) SLAs with penalty/incentive clauses, (c) termination provisions, (d) insurance requirements, (e) data privacy compliance (RA 10173 if provider handles customer data), (f) Legal review
Responsible (R): Procurement Specialist / Legal
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1677_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1677_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1677_Task9" name="Onboard provider: (a) system setup (vendor master, contract record), (b)…">
        <bpmn:documentation>Step 5: Onboard provider: (a) system setup (vendor master, contract record), (b) service commencement communication to all affected locations, (c) training/orientation on BuildRight processes and systems (if applicable), (d) 30-day post-commencement review
Responsible (R): Procurement Specialist / Contract Owner
Accountable (A): —
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1677_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1677_End10" name="Complete">
        <bpmn:incoming>W1677_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1677_Annotation11">
        <bpmn:text>Controls: - CTL-344 (ensure controlled execution — Service Provider &amp; Contract Management (PA-34.2).) | - operational: Procurement Specialist review and approval gate
Owner: Procurement Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1677_Assoc12" sourceRef="W1677_Annotation11" targetRef="W1677_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1677_Flow13" sourceRef="W1677_Start4" targetRef="W1677_Task5" />
      <bpmn:sequenceFlow id="W1677_Flow14" sourceRef="W1677_Task5" targetRef="W1677_Task6" />
      <bpmn:sequenceFlow id="W1677_Flow15" sourceRef="W1677_Task6" targetRef="W1677_Task7" />
      <bpmn:sequenceFlow id="W1677_Flow16" sourceRef="W1677_Task7" targetRef="W1677_Task8" />
      <bpmn:sequenceFlow id="W1677_Flow17" sourceRef="W1677_Task8" targetRef="W1677_Task9" />
      <bpmn:sequenceFlow id="W1677_Flow18" sourceRef="W1677_Task9" targetRef="W1677_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1677_diag">
      <bpmndi:BPMNPlane id="W1677_plane" bpmnElement="W_W1677">
        <bpmndi:BPMNShape id="W1677_Lane1_di" bpmnElement="W1677_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Lane2_di" bpmnElement="W1677_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1370" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Task5_di" bpmnElement="W1677_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Task6_di" bpmnElement="W1677_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Task7_di" bpmnElement="W1677_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Task8_di" bpmnElement="W1677_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Task9_di" bpmnElement="W1677_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Start4_di" bpmnElement="W1677_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_End10_di" bpmnElement="W1677_End10"><dc:Bounds x="1470" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1677_Annotation11_di" bpmnElement="W1677_Annotation11"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1677_Flow13_di" bpmnElement="W1677_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Flow14_di" bpmnElement="W1677_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Flow15_di" bpmnElement="W1677_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Flow16_di" bpmnElement="W1677_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Flow17_di" bpmnElement="W1677_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Flow18_di" bpmnElement="W1677_Flow18"><di:waypoint x="1420" y="335" /><di:waypoint x="1470" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1677_Assoc12_di" bpmnElement="W1677_Assoc12"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1678" name="W1678. Service Level Agreement (SLA) Monitoring &amp; Performance Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing monitoring cycle
Frequency: Monthly SLA reporting; quarterly review meetings with providers
Volume: ~40–60 active service contracts with SLAs
Owner: Contract Owner (department head)
Participants: Contract Owner, Procurement Specialist, Service Provider
Source: workflow W1678 — Service Level Agreement (SLA) Monitoring &amp; Performance Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1678_LaneSet4">
        <bpmn:lane id="W1678_Lane1" name="System">
        <bpmn:flowNodeRef>W1678_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1678_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1678_Lane2" name="Contract Owner">
        <bpmn:flowNodeRef>W1678_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1678_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1678_Lane3" name="Procurement Specialist">
        <bpmn:flowNodeRef>W1678_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1678_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1678_Start5" name="Ongoing monitoring cycle">
        <bpmn:outgoing>W1678_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1678_Task6" name="System tracks SLA metrics per contract (automated where possible): (a) response…">
        <bpmn:documentation>Step 1: System tracks SLA metrics per contract (automated where possible): (a) response time (e.g., maintenance: 4-hour emergency response), (b) resolution time (e.g., IT helpdesk: 24-hour resolution), (c) uptime (e.g., POS systems: 99.9%), (d) delivery accuracy (e.g., 3PL: on-time delivery %), (e) quality metrics (e.g., cleaning: inspection score), (f) customer satisfaction (e.g., security: incident rate)
Responsible (R): System / Contract Owner
Accountable (A): —
Duration: Automated + monthly</bpmn:documentation>
        <bpmn:incoming>W1678_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1678_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1678_Task7" name="Monthly: Contract Owner reviews SLA performance report: (a) SLA achievement…">
        <bpmn:documentation>Step 2: Monthly: Contract Owner reviews SLA performance report: (a) SLA achievement rate per metric, (b) trend analysis (improving/declining), (c) SLA breaches with root cause, (d) penalty/incentive calculations per contract terms
Responsible (R): Contract Owner
Accountable (A): Procurement Specialist
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1678_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1678_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1678_Task8" name="Quarterly: Contract Owner and Procurement Specialist meet with service provider…">
        <bpmn:documentation>Step 3: Quarterly: Contract Owner and Procurement Specialist meet with service provider for SLA review: (a) present performance data, (b) discuss improvement areas, (c) agree on action plan for underperforming areas, (d) document meeting minutes with action items
Responsible (R): Contract Owner / Procurement Specialist
Accountable (A): —
Duration: 1 hour/provider</bpmn:documentation>
        <bpmn:incoming>W1678_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1678_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1678_Task9" name="SLA breach penalties applied: (a) Procurement Specialist calculates penalty per…">
        <bpmn:documentation>Step 4: SLA breach penalties applied: (a) Procurement Specialist calculates penalty per contract terms, (b) Finance deducts penalty from next payment, (c) chronic breach (&gt; 3 consecutive months) triggers contract review per W1676
Responsible (R): Procurement Specialist / Finance
Accountable (A): CFO
Duration: Per breach</bpmn:documentation>
        <bpmn:incoming>W1678_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1678_End10" name="Complete">
        <bpmn:incoming>W1678_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1678_Annotation11">
        <bpmn:text>Controls: - CTL-207 (prevent unauthorized non-merchandise spend.) | - operational: Contract Owner (department head) review and approval gate
Owner: Contract Owner (department head)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1678_Assoc12" sourceRef="W1678_Annotation11" targetRef="W1678_Start5" associationDirection="None" />
