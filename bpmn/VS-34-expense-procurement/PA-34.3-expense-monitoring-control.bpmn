    <bpmn:process id="W_W1686" name="W1686. Travel &amp; Business Entertainment Expense Management" isExecutable="false">
      <bpmn:documentation>Trigger: Employee business travel or entertainment event
Frequency: ~200–300 travel/entertainment expense reports/month
Volume: ~10–15 per department per month
Owner: HR / Finance
Participants: Traveling employee, Approving manager, Finance
Source: workflow W1686 — Travel &amp; Business Entertainment Expense Management</bpmn:documentation>
      <bpmn:laneSet id="W1686_LaneSet3">
        <bpmn:lane id="W1686_Lane1" name="Employee">
        <bpmn:flowNodeRef>W1686_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1686_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1686_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1686_Lane2" name="Finance">
        <bpmn:flowNodeRef>W1686_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1686_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1686_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1686_Start4" name="Employee business travel or entertainment event">
        <bpmn:outgoing>W1686_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1686_Task5" name="Travel authorization: (a) employee creates travel request in system…">
        <bpmn:documentation>Step 1: Travel authorization: (a) employee creates travel request in system: destination, dates, purpose, estimated cost, (b) approval: &lt; PHP 20K by direct supervisor; &lt; PHP 50K by department head; &gt; PHP 50K by VP, (c) travel booking: through designated travel agency or approved booking platform (for cost control)
Responsible (R): Employee / Approver
Accountable (A): Finance
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1686_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1686_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1686_Task6" name="Per diem and reimbursement rates (Philippine standard): (a) domestic travel per…">
        <bpmn:documentation>Step 2: Per diem and reimbursement rates (Philippine standard): (a) domestic travel per diem: PHP 1,500/day (covers meals and incidentals), (b) hotel: actual cost up to tier limit (Executive: PHP 5K/night; Manager: PHP 3K/night; Staff: PHP 2K/night), (c) transportation: economy class for domestic flights; business class for international only with VP approval; local transport: taxi/Grab with receipts
Responsible (R): Finance
Accountable (A): CFO
Duration: Policy</bpmn:documentation>
        <bpmn:incoming>W1686_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1686_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1686_Task7" name="Post-travel: employee submits expense report within 5 business days: (a)…">
        <bpmn:documentation>Step 3: Post-travel: employee submits expense report within 5 business days: (a) itemized expenses with receipts, (b) per diem calculation (days × rate), (c) actual vs. pre-approved budget comparison, (d) approver reviews and approves
Responsible (R): Employee / Approver
Accountable (A): Finance
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1686_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1686_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1686_Task8" name="Finance processes reimbursement: (a) verify compliance with policy, (b) deduct…">
        <bpmn:documentation>Step 4: Finance processes reimbursement: (a) verify compliance with policy, (b) deduct advances if any, (c) reimburse via payroll or separate bank transfer, (d) GL posting to correct department and expense category
Responsible (R): Finance
Accountable (A): CFO
Duration: 10 min/report</bpmn:documentation>
        <bpmn:incoming>W1686_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1686_End9" name="Complete">
        <bpmn:incoming>W1686_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1686_Annotation10">
        <bpmn:text>Controls: - CTL-207 (prevent unauthorized non-merchandise spend.) | - operational: HR / Finance review and approval gate
Owner: HR / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1686_Assoc11" sourceRef="W1686_Annotation10" targetRef="W1686_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1686_Flow12" sourceRef="W1686_Start4" targetRef="W1686_Task5" />
      <bpmn:sequenceFlow id="W1686_Flow13" sourceRef="W1686_Task5" targetRef="W1686_Task6" />
      <bpmn:sequenceFlow id="W1686_Flow14" sourceRef="W1686_Task6" targetRef="W1686_Task7" />
      <bpmn:sequenceFlow id="W1686_Flow15" sourceRef="W1686_Task7" targetRef="W1686_Task8" />
      <bpmn:sequenceFlow id="W1686_Flow16" sourceRef="W1686_Task8" targetRef="W1686_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1686_diag">
      <bpmndi:BPMNPlane id="W1686_plane" bpmnElement="W_W1686">
        <bpmndi:BPMNShape id="W1686_Lane1_di" bpmnElement="W1686_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
