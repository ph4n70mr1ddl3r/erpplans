    <bpmn:process id="W_W1687" name="W1687. Utility Expense Monitoring &amp; Energy Cost Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly utility bill processing
Frequency: Monthly bill review; quarterly energy optimization review
Volume: 200 stores + 4 DCs + HQ = ~205 utility accounts (electricity); ~205 water accounts
Owner: Facilities Manager
Participants: Facilities Manager, VP Store Operations, Store Managers, Finance
Source: workflow W1687 — Utility Expense Monitoring &amp; Energy Cost Optimization</bpmn:documentation>
      <bpmn:laneSet id="W1687_LaneSet3">
        <bpmn:lane id="W1687_Lane1" name="Finance">
        <bpmn:flowNodeRef>W1687_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1687_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1687_Lane2" name="Facilities Manager">
        <bpmn:flowNodeRef>W1687_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1687_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1687_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1687_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1687_Start4" name="Monthly utility bill processing">
        <bpmn:outgoing>W1687_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1687_Task5" name="Monthly: Finance processes utility bills: (a) electricity bills from Meralco…">
        <bpmn:documentation>Step 1: Monthly: Finance processes utility bills: (a) electricity bills from Meralco (Metro Manila/Luzon), Davao Light (Mindanao), VECO (Cebu), and other regional electric cooperatives, (b) water bills from local water districts, (c) system records bill amount per location per month
Responsible (R): Finance / System
Accountable (A): Facilities Manager
Duration: 2 days/month</bpmn:documentation>
        <bpmn:incoming>W1687_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1687_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1687_Task6" name="Facilities Manager monitors utility KPIs: (a) electricity cost per sqm per…">
        <bpmn:documentation>Step 2: Facilities Manager monitors utility KPIs: (a) electricity cost per sqm per month (benchmark: PHP 80–120/sqm/month for warehouse retail), (b) water cost per sqm per month, (c) trend analysis: month-over-month and year-over-year, (d) flags locations with &gt; 20% increase vs. same month prior year
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1687_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1687_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1687_Task7" name="Energy optimization opportunities: (a) LED lighting retrofit (stores still…">
        <bpmn:documentation>Step 3: Energy optimization opportunities: (a) LED lighting retrofit (stores still using fluorescent — ROI ~18 months), (b) aircon temperature standardization (set at 24–25°C per DOE recommendation), (c) motion-sensor lighting in backroom/warehouse areas, (d) solar panel installation for stores with large roof area (Philippine solar viability is high — ROI ~4–5 years), (e) generator fuel optimization per W808
Responsible (R): Facilities Manager
Accountable (A): VP Store Operations / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W1687_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1687_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1687_Task8" name="Annual: Facilities Manager and Finance evaluate energy optimization…">
        <bpmn:documentation>Step 4: Annual: Facilities Manager and Finance evaluate energy optimization investments: (a) total utility spend (~PHP 300–500M/year for 200 stores + 4 DCs), (b) savings from implemented measures, (c) proposed new investments with ROI analysis, (d) present to CFO for capex budget inclusion
Responsible (R): Facilities Manager / Finance
Accountable (A): CFO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1687_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1687_End9" name="Complete">
        <bpmn:incoming>W1687_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1687_Annotation10">
        <bpmn:text>Controls: - CTL-345 (ensure controlled execution — Expense Monitoring &amp; Control (PA-34.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Facilities Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1687_Assoc11" sourceRef="W1687_Annotation10" targetRef="W1687_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1687_Flow12" sourceRef="W1687_Start4" targetRef="W1687_Task5" />
      <bpmn:sequenceFlow id="W1687_Flow13" sourceRef="W1687_Task5" targetRef="W1687_Task6" />
      <bpmn:sequenceFlow id="W1687_Flow14" sourceRef="W1687_Task6" targetRef="W1687_Task7" />
      <bpmn:sequenceFlow id="W1687_Flow15" sourceRef="W1687_Task7" targetRef="W1687_Task8" />
      <bpmn:sequenceFlow id="W1687_Flow16" sourceRef="W1687_Task8" targetRef="W1687_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1687_diag">
      <bpmndi:BPMNPlane id="W1687_plane" bpmnElement="W_W1687">
        <bpmndi:BPMNShape id="W1687_Lane1_di" bpmnElement="W1687_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Lane2_di" bpmnElement="W1687_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Task5_di" bpmnElement="W1687_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Task6_di" bpmnElement="W1687_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Task7_di" bpmnElement="W1687_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Task8_di" bpmnElement="W1687_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Start4_di" bpmnElement="W1687_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_End9_di" bpmnElement="W1687_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1687_Annotation10_di" bpmnElement="W1687_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1687_Flow12_di" bpmnElement="W1687_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1687_Flow13_di" bpmnElement="W1687_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1687_Flow14_di" bpmnElement="W1687_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1687_Flow15_di" bpmnElement="W1687_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1687_Flow16_di" bpmnElement="W1687_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1687_Assoc11_di" bpmnElement="W1687_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1688" name="W1688. Petty Cash Management &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Petty cash disbursement or replenishment request
Frequency: Daily disbursements; bi-weekly or monthly replenishment
Volume: 200 stores × PHP 20K float + 4 DCs × PHP 50K float = PHP 4.2M total petty cash
Owner: Store Manager (store); DC Supervisor (DC)
Participants: Store Manager, DC Supervisor, Finance
Source: workflow W1688 — Petty Cash Management &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1688_LaneSet3">
        <bpmn:lane id="W1688_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1688_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1688_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1688_Lane2" name="Custodian">
        <bpmn:flowNodeRef>W1688_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1688_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1688_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1688_Start4" name="Petty cash disbursement or replenishment request">
        <bpmn:outgoing>W1688_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1688_Task5" name="Petty cash disbursement (per FIN-017): (a) employee requests petty cash for…">
        <bpmn:documentation>Step 1: Petty cash disbursement (per FIN-017): (a) employee requests petty cash for small expense (&lt; PHP 5K per transaction; &gt; PHP 5K requires purchase requisition per W1675), (b) Store Manager or DC Supervisor approves and disburses cash, (c) employee provides receipt within 3 business days, (d) custodian records transaction in petty cash log
Responsible (R): Store Manager / DC Supervisor
Accountable (A): Finance
Duration: 5 min/transaction</bpmn:documentation>
        <bpmn:incoming>W1688_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1688_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1688_Task6" name="Petty cash replenishment: (a) when float drops below 30% (PHP 6K for stores…">
        <bpmn:documentation>Step 2: Petty cash replenishment: (a) when float drops below 30% (PHP 6K for stores; PHP 15K for DCs), custodian submits replenishment request with all receipts attached, (b) Finance reviews receipts for compliance, (c) approves replenishment, (d) fund transfer or cash delivery via CIT service per FIN-025
Responsible (R): Custodian / Finance
Accountable (A): Controller
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1688_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1688_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1688_Task7" name="Monthly reconciliation: (a) custodian counts physical cash on hand, (b) system…">
        <bpmn:documentation>Step 3: Monthly reconciliation: (a) custodian counts physical cash on hand, (b) system calculates expected balance (float − disbursements + replenishments), (c) variance documented and investigated, (d) &gt; PHP 500 variance requires Store Manager explanation, (e) Finance audits random sample of 10 stores per month for petty cash compliance
Responsible (R): Custodian / Finance
Accountable (A): Controller
Duration: 30 min/location</bpmn:documentation>
        <bpmn:incoming>W1688_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1688_End8" name="Complete">
        <bpmn:incoming>W1688_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1688_Annotation9">
        <bpmn:text>Controls: - CTL-345 (ensure controlled execution — Expense Monitoring &amp; Control (PA-34.3).) | - operational: Store Manager (store); DC Supervisor (DC) review and approval gate; periodic reconciliation against source documents
Owner: Store Manager (store); DC Supervisor (DC)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1688_Assoc10" sourceRef="W1688_Annotation9" targetRef="W1688_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1688_Flow11" sourceRef="W1688_Start4" targetRef="W1688_Task5" />
      <bpmn:sequenceFlow id="W1688_Flow12" sourceRef="W1688_Task5" targetRef="W1688_Task6" />
      <bpmn:sequenceFlow id="W1688_Flow13" sourceRef="W1688_Task6" targetRef="W1688_Task7" />
      <bpmn:sequenceFlow id="W1688_Flow14" sourceRef="W1688_Task7" targetRef="W1688_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1688_diag">
      <bpmndi:BPMNPlane id="W1688_plane" bpmnElement="W_W1688">
        <bpmndi:BPMNShape id="W1688_Lane1_di" bpmnElement="W1688_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1688_Lane2_di" bpmnElement="W1688_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1688_Task5_di" bpmnElement="W1688_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
