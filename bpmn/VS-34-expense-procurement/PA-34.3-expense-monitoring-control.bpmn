<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-34.3-expense-monitoring-control" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1683" name="W1683. Monthly Department Expense Budget vs. Actual Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial close cycle
Frequency: Monthly
Volume: ~15 departments × ~30 expense line items = ~450 data points
Owner: FP&amp;A
Participants: FP&amp;A, all department heads, CFO
Source: workflow W1683 — Monthly Department Expense Budget vs. Actual Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1683_LaneSet5">
        <bpmn:lane id="W1683_Lane1" name="System">
        <bpmn:flowNodeRef>W1683_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1683_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1683_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1683_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1683_Lane3" name="Department Heads">
        <bpmn:flowNodeRef>W1683_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1683_Lane4" name="CFO">
        <bpmn:flowNodeRef>W1683_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1683_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1683_Start6" name="Monthly financial close cycle">
        <bpmn:outgoing>W1683_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1683_Task7" name="System generates monthly expense budget vs. actual report per department by Day…">
        <bpmn:documentation>Step 1: System generates monthly expense budget vs. actual report per department by Day 3: (a) actual spend by expense category vs. monthly budget and YTD budget, (b) variance amount and %, (c) forecast for remaining months (based on run rate and known commitments)
Responsible (R): System
Accountable (A): FP&amp;A
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1683_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1683_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1683_Task8" name="FP&amp;A reviews departmental expense reports: (a) flags variances &gt; 5% of monthly…">
        <bpmn:documentation>Step 2: FP&amp;A reviews departmental expense reports: (a) flags variances &gt; 5% of monthly budget or &gt; PHP 100K, (b) identifies root cause categories (one-time vs. recurring), (c) assesses YTD implications for full-year budget
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1683_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1683_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1683_Task9" name="Department heads review their expense reports: (a) explain significant…">
        <bpmn:documentation>Step 3: Department heads review their expense reports: (a) explain significant variances to FP&amp;A, (b) identify corrective actions if over budget, (c) confirm or adjust remaining year forecast
Responsible (R): Department Heads
Accountable (A): FP&amp;A
Duration: 1 hour/department</bpmn:documentation>
        <bpmn:incoming>W1683_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1683_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1683_Task10" name="CFO reviews consolidated expense performance at monthly operating review…">
        <bpmn:documentation>Step 4: CFO reviews consolidated expense performance at monthly operating review (W1653): (a) total OpEx vs. budget, (b) department-level highlights, (c) action items for over-budget departments
Responsible (R): CFO
Accountable (A): CEO
Duration: Per W1653</bpmn:documentation>
        <bpmn:incoming>W1683_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1683_End11" name="Complete">
        <bpmn:incoming>W1683_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1683_Annotation12">
        <bpmn:text>Controls: - CTL-345 (ensure controlled execution — Expense Monitoring &amp; Control (PA-34.3).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1683_Assoc13" sourceRef="W1683_Annotation12" targetRef="W1683_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1683_Flow14" sourceRef="W1683_Start6" targetRef="W1683_Task7" />
      <bpmn:sequenceFlow id="W1683_Flow15" sourceRef="W1683_Task7" targetRef="W1683_Task8" />
      <bpmn:sequenceFlow id="W1683_Flow16" sourceRef="W1683_Task8" targetRef="W1683_Task9" />
      <bpmn:sequenceFlow id="W1683_Flow17" sourceRef="W1683_Task9" targetRef="W1683_Task10" />
      <bpmn:sequenceFlow id="W1683_Flow18" sourceRef="W1683_Task10" targetRef="W1683_End11" />
    </bpmn:process>
