    <bpmn:process id="W_W1684" name="W1684. Store-Level Controllable Expense Monitoring &amp; Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly store scorecard generation (W1655)
Frequency: Monthly
Volume: 200 stores
Owner: VP Store Operations
Participants: VP Store Operations, Regional Managers, Store Managers, Finance
Source: workflow W1684 — Store-Level Controllable Expense Monitoring &amp; Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W1684_LaneSet4">
        <bpmn:lane id="W1684_Lane1" name="System">
        <bpmn:flowNodeRef>W1684_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1684_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1684_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1684_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1684_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1684_Lane3" name="Regional Manager">
        <bpmn:flowNodeRef>W1684_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1684_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1684_Start5" name="Monthly store scorecard generation (W1655)">
        <bpmn:outgoing>W1684_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1684_Task6" name="System calculates monthly controllable expense KPIs per store: (a) utilities…">
        <bpmn:documentation>Step 1: System calculates monthly controllable expense KPIs per store: (a) utilities per sqm (electricity, water), (b) maintenance cost as % of revenue, (c) supplies cost per transaction, (d) shrinkage as % of revenue, (e) overtime cost as % of payroll, (f) total controllable expense as % of revenue
Responsible (R): System
Accountable (A): VP Store Operations
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1684_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1684_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1684_Task7" name="VP Store Operations benchmarks stores: (a) compare each store to cluster…">
        <bpmn:documentation>Step 2: VP Store Operations benchmarks stores: (a) compare each store to cluster average (stores of similar size and format), (b) compare each store to chain average, (c) identify top 10 and bottom 10 stores by controllable expense ratio, (d) trend analysis (improving vs. declining)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1684_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1684_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1684_Task8" name="Regional Manager coaches bottom 10 stores: (a) review specific expense…">
        <bpmn:documentation>Step 3: Regional Manager coaches bottom 10 stores: (a) review specific expense categories driving high costs, (b) identify root causes (e.g., high electricity → aging aircon units; high maintenance → deferred maintenance), (c) agree on action plans with Store Managers
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 30 min/store</bpmn:documentation>
        <bpmn:incoming>W1684_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1684_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1684_Task9" name="Best practice sharing: VP Store Operations communicates expense management…">
        <bpmn:documentation>Step 4: Best practice sharing: VP Store Operations communicates expense management practices from top 10 performing stores to bottom 10 through regional manager network
Responsible (R): VP Store Operations
Accountable (A): —
Duration: 1 hour/month</bpmn:documentation>
        <bpmn:incoming>W1684_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1684_End10" name="Complete">
        <bpmn:incoming>W1684_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1684_Annotation11">
        <bpmn:text>Controls: - CTL-345 (ensure controlled execution — Expense Monitoring &amp; Control (PA-34.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1684_Assoc12" sourceRef="W1684_Annotation11" targetRef="W1684_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1684_Flow13" sourceRef="W1684_Start5" targetRef="W1684_Task6" />
      <bpmn:sequenceFlow id="W1684_Flow14" sourceRef="W1684_Task6" targetRef="W1684_Task7" />
      <bpmn:sequenceFlow id="W1684_Flow15" sourceRef="W1684_Task7" targetRef="W1684_Task8" />
      <bpmn:sequenceFlow id="W1684_Flow16" sourceRef="W1684_Task8" targetRef="W1684_Task9" />
      <bpmn:sequenceFlow id="W1684_Flow17" sourceRef="W1684_Task9" targetRef="W1684_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1684_diag">
      <bpmndi:BPMNPlane id="W1684_plane" bpmnElement="W_W1684">
        <bpmndi:BPMNShape id="W1684_Lane1_di" bpmnElement="W1684_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Lane2_di" bpmnElement="W1684_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Lane3_di" bpmnElement="W1684_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Task6_di" bpmnElement="W1684_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Task7_di" bpmnElement="W1684_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Task8_di" bpmnElement="W1684_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Task9_di" bpmnElement="W1684_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Start5_di" bpmnElement="W1684_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_End10_di" bpmnElement="W1684_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1684_Annotation11_di" bpmnElement="W1684_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1684_Flow13_di" bpmnElement="W1684_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1684_Flow14_di" bpmnElement="W1684_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1684_Flow15_di" bpmnElement="W1684_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1684_Flow16_di" bpmnElement="W1684_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1684_Flow17_di" bpmnElement="W1684_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1684_Assoc12_di" bpmnElement="W1684_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1685" name="W1685. Company Expense Card &amp; Corporate Credit Card Management" isExecutable="false">
      <bpmn:documentation>Trigger: Corporate credit card program for authorized personnel
Frequency: Monthly statement reconciliation; ongoing compliance monitoring
Volume: ~50–80 corporate cards issued (C-Suite, department heads, regional managers, selected store managers)
Owner: Finance — Treasury
Participants: Cardholder, Finance, CFO
Source: workflow W1685 — Company Expense Card &amp; Corporate Credit Card Management</bpmn:documentation>
      <bpmn:laneSet id="W1685_LaneSet3">
        <bpmn:lane id="W1685_Lane1" name="Finance">
        <bpmn:flowNodeRef>W1685_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1685_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1685_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1685_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1685_Lane2" name="Cardholder">
        <bpmn:flowNodeRef>W1685_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1685_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1685_Start4" name="Corporate credit card program for authorized personnel">
        <bpmn:outgoing>W1685_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1685_Task5" name="Corporate card issuance: (a) authorized positions: C-Suite, VP-level…">
        <bpmn:documentation>Step 1: Corporate card issuance: (a) authorized positions: C-Suite, VP-level, department heads, regional managers, selected store managers (for emergency purchases), (b) credit limit per card tier: Executive (PHP 500K), Department Head (PHP 200K), Regional Manager (PHP 100K), Store Manager (PHP 50K), (c) cardholder signs cardholder agreement with usage policy
Responsible (R): Finance
Accountable (A): CFO
Duration: Per issuance</bpmn:documentation>
        <bpmn:incoming>W1685_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1685_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1685_Task6" name="Monthly: cardholder reconciles statement: (a) match each transaction to expense…">
        <bpmn:documentation>Step 2: Monthly: cardholder reconciles statement: (a) match each transaction to expense category and budget code, (b) attach receipts/invoices for all transactions &gt; PHP 1,000, (c) submit reconciled statement to Finance by 5th of month
Responsible (R): Cardholder
Accountable (A): Finance
Duration: 30 min/month</bpmn:documentation>
        <bpmn:incoming>W1685_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1685_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1685_Task7" name="Finance reviews reconciliation: (a) verify receipts attached, (b) check for…">
        <bpmn:documentation>Step 3: Finance reviews reconciliation: (a) verify receipts attached, (b) check for policy violations (personal expenses, unauthorized merchants, excessive amounts), (c) process payment (auto-debit from corporate bank account)
Responsible (R): Finance
Accountable (A): CFO
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1685_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1685_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1685_Task8" name="Quarterly: Finance audits corporate card usage: (a) compliance rate (receipts…">
        <bpmn:documentation>Step 4: Quarterly: Finance audits corporate card usage: (a) compliance rate (receipts provided ÷ total transactions), (b) policy violation rate, (c) average spend per card, (d) unusual patterns
Responsible (R): Finance
Accountable (A): CFO
Duration: 4 hours/quarter</bpmn:documentation>
        <bpmn:incoming>W1685_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1685_End9" name="Complete">
        <bpmn:incoming>W1685_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1685_Annotation10">
        <bpmn:text>Controls: - CTL-207 (prevent unauthorized non-merchandise spend.) | - operational: Finance — Treasury review and approval gate; periodic reconciliation against source documents
Owner: Finance — Treasury</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1685_Assoc11" sourceRef="W1685_Annotation10" targetRef="W1685_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1685_Flow12" sourceRef="W1685_Start4" targetRef="W1685_Task5" />
      <bpmn:sequenceFlow id="W1685_Flow13" sourceRef="W1685_Task5" targetRef="W1685_Task6" />
      <bpmn:sequenceFlow id="W1685_Flow14" sourceRef="W1685_Task6" targetRef="W1685_Task7" />
      <bpmn:sequenceFlow id="W1685_Flow15" sourceRef="W1685_Task7" targetRef="W1685_Task8" />
      <bpmn:sequenceFlow id="W1685_Flow16" sourceRef="W1685_Task8" targetRef="W1685_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1685_diag">
      <bpmndi:BPMNPlane id="W1685_plane" bpmnElement="W_W1685">
        <bpmndi:BPMNShape id="W1685_Lane1_di" bpmnElement="W1685_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Lane2_di" bpmnElement="W1685_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Task5_di" bpmnElement="W1685_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Task6_di" bpmnElement="W1685_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Task7_di" bpmnElement="W1685_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Task8_di" bpmnElement="W1685_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1685_Start4_di" bpmnElement="W1685_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
