    <bpmn:process id="W_W1689" name="W1689. Expense Policy Compliance Monitoring &amp; Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly compliance monitoring cycle; quarterly internal audit
Frequency: Monthly monitoring; quarterly audit
Volume: ~1,500–2,000 expense transactions/month
Owner: Internal Audit
Participants: Internal Audit, Finance, department heads, Loss Prevention
Source: workflow W1689 — Expense Policy Compliance Monitoring &amp; Audit</bpmn:documentation>
      <bpmn:laneSet id="W1689_LaneSet3">
        <bpmn:lane id="W1689_Lane1" name="Finance">
        <bpmn:flowNodeRef>W1689_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1689_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1689_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1689_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W1689_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1689_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1689_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1689_Start4" name="Monthly compliance monitoring cycle; quarterly internal audit">
        <bpmn:outgoing>W1689_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1689_Task5" name="Monthly: Finance monitors expense policy compliance: (a) transactions without…">
        <bpmn:documentation>Step 1: Monthly: Finance monitors expense policy compliance: (a) transactions without proper approval, (b) transactions exceeding budget without override approval, (c) duplicate expense claims, (d) expense reports submitted late (&gt; 5 business days after travel), (e) missing receipts on corporate card transactions, (f) petty cash transactions exceeding PHP 5K limit
Responsible (R): Finance
Accountable (A): Controller
Duration: 4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1689_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1689_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1689_Task6" name="Quarterly: Internal Audit conducts expense audit: (a) sample 50–100 expense…">
        <bpmn:documentation>Step 2: Quarterly: Internal Audit conducts expense audit: (a) sample 50–100 expense transactions across departments, (b) verify compliance with approval thresholds, documentation requirements, and policy limits, (c) test petty cash at 10 random stores, (d) test corporate card transactions for 10 cardholders, (e) report findings with severity rating and corrective actions
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: 1 week/quarter</bpmn:documentation>
        <bpmn:incoming>W1689_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1689_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1689_Task7" name="Findings communicated to department heads; corrective actions tracked to…">
        <bpmn:documentation>Step 3: Findings communicated to department heads; corrective actions tracked to closure; repeat findings escalated to CFO and CEO
Responsible (R): Internal Audit / Finance
Accountable (A): CFO
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1689_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1689_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1689_Task8" name="Annual: Finance reviews and updates expense policy based on: (a) audit findings…">
        <bpmn:documentation>Step 4: Annual: Finance reviews and updates expense policy based on: (a) audit findings and common compliance gaps, (b) changes in Philippine tax regulations (BIR requirements for deductible expenses), (c) organizational changes (new roles, new locations), (d) communicate policy updates to all employees
Responsible (R): Finance
Accountable (A): CFO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1689_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1689_End9" name="Complete">
        <bpmn:incoming>W1689_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1689_Annotation10">
        <bpmn:text>Controls: - CTL-345 (ensure controlled execution — Expense Monitoring &amp; Control (PA-34.3).) | - operational: Internal Audit review and approval gate
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1689_Assoc11" sourceRef="W1689_Annotation10" targetRef="W1689_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1689_Flow12" sourceRef="W1689_Start4" targetRef="W1689_Task5" />
      <bpmn:sequenceFlow id="W1689_Flow13" sourceRef="W1689_Task5" targetRef="W1689_Task6" />
      <bpmn:sequenceFlow id="W1689_Flow14" sourceRef="W1689_Task6" targetRef="W1689_Task7" />
      <bpmn:sequenceFlow id="W1689_Flow15" sourceRef="W1689_Task7" targetRef="W1689_Task8" />
      <bpmn:sequenceFlow id="W1689_Flow16" sourceRef="W1689_Task8" targetRef="W1689_End9" />
    </bpmn:process>
