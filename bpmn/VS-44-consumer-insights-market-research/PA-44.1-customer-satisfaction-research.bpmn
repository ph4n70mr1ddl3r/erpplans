      <bpmn:sequenceFlow id="W1907_Flow12" sourceRef="W1907_Task4" targetRef="W1907_Task5" />
      <bpmn:sequenceFlow id="W1907_Flow13" sourceRef="W1907_Task5" targetRef="W1907_Task6" />
      <bpmn:sequenceFlow id="W1907_Flow14" sourceRef="W1907_Task6" targetRef="W1907_Task7" />
      <bpmn:sequenceFlow id="W1907_Flow15" sourceRef="W1907_Task7" targetRef="W1907_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1907_diag">
      <bpmndi:BPMNPlane id="W1907_plane" bpmnElement="W_W1907">
        <bpmndi:BPMNShape id="W1907_Lane1_di" bpmnElement="W1907_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1907_Task4_di" bpmnElement="W1907_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1907_Task5_di" bpmnElement="W1907_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1907_Task6_di" bpmnElement="W1907_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
