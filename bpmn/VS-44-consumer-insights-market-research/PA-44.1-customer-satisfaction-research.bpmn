    <bpmn:process id="W_W1904" name="W1904. Customer Effort Score (CES) Measurement for Key Service Touchpoints" isExecutable="false">
      <bpmn:documentation>Trigger: Post-interaction survey at key touchpoints
Frequency: Continuous measurement; monthly reporting
Volume: Touchpoints: returns, special orders, BOPIS pickup, delivery, complaints
Owner: Market Research Analyst
Participants: Market Research Analyst, VP Store Operations, VP Merchandising
Source: workflow W1904 — Customer Effort Score (CES) Measurement for Key Service Touchpoints</bpmn:documentation>
      <bpmn:laneSet id="W1904_LaneSet4">
        <bpmn:lane id="W1904_Lane1" name="System">
        <bpmn:flowNodeRef>W1904_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1904_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1904_Lane2" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1904_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1904_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1904_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1904_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1904_Start5" name="Post-interaction survey at key touchpoints">
        <bpmn:outgoing>W1904_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1904_Task6" name="System triggers CES survey after key service interactions: (a) returns: &quot;How…">
        <bpmn:documentation>Step 1: System triggers CES survey after key service interactions: (a) returns: &quot;How easy was it to return your item today?&quot; (1–7 scale, 1 = very difficult, 7 = very easy), (b) BOPIS pickup: &quot;How easy was it to pick up your online order?&quot;, (c) delivery: &quot;How easy was it to schedule and receive your delivery?&quot;, (d) complaint resolution: &quot;How easy was it to resolve your issue?&quot;, (e) special order: &quot;How easy was it to place and receive your special order?&quot;
Responsible (R): System
Accountable (A): Market Research Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1904_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1904_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1904_Task7" name="Monthly analysis: (a) CES by touchpoint and trend, (b) identify touchpoints…">
        <bpmn:documentation>Step 2: Monthly analysis: (a) CES by touchpoint and trend, (b) identify touchpoints with CES &lt; 5 (high effort = poor experience): priority for process improvement, (c) CES by store for returns and BOPIS (identifies stores with poor service execution), (d) correlate CES with repeat purchase behavior
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1904_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1904_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1904_Task8" name="Quarterly: VP Store Operations reviews low-CES touchpoints: (a) identify root…">
        <bpmn:documentation>Step 3: Quarterly: VP Store Operations reviews low-CES touchpoints: (a) identify root cause of high customer effort, (b) implement process improvements to reduce effort (simplify return process, improve BOPIS pickup signage, streamline complaint resolution), (c) track CES improvement post-intervention
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1904_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1904_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1904_End9" name="Complete">
        <bpmn:incoming>W1904_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1904_Annotation10">
        <bpmn:text>Controls: - CTL-373 (ensure controlled execution — Customer Satisfaction &amp; Experience Research (PA-44.1).) | - operational: Market Research Analyst review and approval gate
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1904_Assoc11" sourceRef="W1904_Annotation10" targetRef="W1904_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1904_Flow12" sourceRef="W1904_Start5" targetRef="W1904_Task6" />
      <bpmn:sequenceFlow id="W1904_Flow13" sourceRef="W1904_Task6" targetRef="W1904_Task7" />
      <bpmn:sequenceFlow id="W1904_Flow14" sourceRef="W1904_Task7" targetRef="W1904_Task8" />
      <bpmn:sequenceFlow id="W1904_Flow15" sourceRef="W1904_Task8" targetRef="W1904_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1904_diag">
      <bpmndi:BPMNPlane id="W1904_plane" bpmnElement="W_W1904">
        <bpmndi:BPMNShape id="W1904_Lane1_di" bpmnElement="W1904_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Lane2_di" bpmnElement="W1904_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Lane3_di" bpmnElement="W1904_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Task6_di" bpmnElement="W1904_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Task7_di" bpmnElement="W1904_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Task8_di" bpmnElement="W1904_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Start5_di" bpmnElement="W1904_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_End9_di" bpmnElement="W1904_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1904_Annotation10_di" bpmnElement="W1904_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1904_Flow12_di" bpmnElement="W1904_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1904_Flow13_di" bpmnElement="W1904_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1904_Flow14_di" bpmnElement="W1904_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
