    <bpmn:process id="W_W1909" name="W1909. Store-Level Customer Experience Benchmarking &amp; Improvement Action Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly CX benchmark reporting
Frequency: Monthly benchmarking; quarterly action planning
Volume: 200 stores benchmarked on CX metrics
Owner: VP Store Operations
Participants: VP Store Operations, Market Research Analyst, Store Managers, Regional Managers
Source: workflow W1909 — Store-Level Customer Experience Benchmarking &amp; Improvement Action Planning</bpmn:documentation>
      <bpmn:laneSet id="W1909_LaneSet3">
        <bpmn:lane id="W1909_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1909_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1909_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1909_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1909_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1909_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1909_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1909_Start4" name="Monthly CX benchmark reporting">
        <bpmn:outgoing>W1909_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1909_Task5" name="Monthly: Market Research Analyst generates store-level CX benchmark report: (a)…">
        <bpmn:documentation>Step 1: Monthly: Market Research Analyst generates store-level CX benchmark report: (a) composite CX score per store: weighted average of NPS, CSAT, CES, mystery shop score, complaint rate, (b) rank stores by CX score: top 20 and bottom 20, (c) trend: improving or declining vs. previous month/quarter, (d) identify outlier stores: (i) high sales but low CX (profitable but unsustainable — customer experience will erode sales), (ii) low sales but high CX (room to grow sales with improved traffic — good experience foundation)
Responsible (R): Market Research Analyst
Accountable (A): VP Store Operations
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1909_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1909_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1909_Task6" name="Quarterly: VP Store Operations conducts CX action planning for bottom 20…">
        <bpmn:documentation>Step 2: Quarterly: VP Store Operations conducts CX action planning for bottom 20 stores: (a) review CX scorecard with each Store Manager and Regional Manager, (b) identify specific CX gaps per store: is it staffing, training, facility condition, inventory availability?, (c) develop 90-day improvement plan: specific actions, responsible parties, measurable targets, (d) allocate resources: additional training (W41), facility improvements (W47), staffing adjustments (W34)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1909_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1909_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1909_Task7" name="Quarterly: VP Store Operations recognizes top 20 CX-performing stores: (a)…">
        <bpmn:documentation>Step 3: Quarterly: VP Store Operations recognizes top 20 CX-performing stores: (a) include in monthly store performance review per W67, (b) financial incentive: bonus for Store Manager and team (PHP 10K–30K), (c) feature in internal newsletter as best practice examples, (d) share improvement techniques with bottom-performing stores
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1909_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1909_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1909_End8" name="Complete">
        <bpmn:incoming>W1909_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1909_Annotation9">
        <bpmn:text>Controls: - CTL-373 (ensure controlled execution — Customer Satisfaction &amp; Experience Research (PA-44.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1909_Assoc10" sourceRef="W1909_Annotation9" targetRef="W1909_Start4" associationDirection="None" />
