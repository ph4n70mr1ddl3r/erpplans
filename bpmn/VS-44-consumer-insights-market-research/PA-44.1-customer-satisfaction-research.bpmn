        <bpmndi:BPMNEdge id="W1902_Flow13_di" bpmnElement="W1902_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1902_Flow14_di" bpmnElement="W1902_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1902_Flow15_di" bpmnElement="W1902_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1902_Flow16_di" bpmnElement="W1902_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1902_Assoc11_di" bpmnElement="W1902_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1903" name="W1903. Net Promoter Score (NPS) Monthly Measurement &amp; Trend Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly NPS measurement cycle
Frequency: Monthly measurement
Volume: ~1,000–3,000 responses/month
Owner: Market Research Analyst
Participants: Market Research Analyst, CMO, VP Store Operations
Source: workflow W1903 — Net Promoter Score (NPS) Monthly Measurement &amp; Trend Analysis</bpmn:documentation>
      <bpmn:laneSet id="W1903_LaneSet4">
        <bpmn:lane id="W1903_Lane1" name="System">
        <bpmn:flowNodeRef>W1903_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1903_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1903_Lane2" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1903_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1903_Lane3" name="CMO">
        <bpmn:flowNodeRef>W1903_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1903_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1903_Start5" name="Monthly NPS measurement cycle">
        <bpmn:outgoing>W1903_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1903_Task6" name="Monthly: system sends NPS survey to random sample of customers within 48 hours…">
        <bpmn:documentation>Step 1: Monthly: system sends NPS survey to random sample of customers within 48 hours of purchase: (a) single question: &quot;On a scale of 0–10, how likely are you to recommend BuildRight to a friend or colleague?&quot;, (b) follow-up: &quot;What is the primary reason for your score?&quot;, (c) classification: Promoters (9–10), Passives (7–8), Detractors (0–6), (d) NPS = % Promoters − % Detractors
Responsible (R): System / Market Research Analyst
Accountable (A): CMO
Duration: Automated + 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1903_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1903_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1903_Task7" name="Monthly analysis: (a) overall NPS score and trend, (b) NPS by store, region…">
        <bpmn:documentation>Step 2: Monthly analysis: (a) overall NPS score and trend, (b) NPS by store, region, and customer segment, (c) NPS by purchase channel (in-store, ecommerce, B2B), (d) theme analysis of verbatim responses, (e) identify stores or segments with declining NPS for targeted intervention
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1903_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1903_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1903_Task8" name="Quarterly: CMO presents NPS trend to executive team: (a) target NPS: ≥ 50…">
        <bpmn:documentation>Step 3: Quarterly: CMO presents NPS trend to executive team: (a) target NPS: ≥ 50 (good) → ≥ 70 (excellent) for Philippine retail, (b) benchmark against Philippine retail industry NPS (if available), (c) correlation analysis: NPS vs. same-store sales growth, (d) &quot;close the loop&quot;: contact Detractors who provided contact information to address their issues per W13.1
Responsible (R): CMO
Accountable (A): CEO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1903_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1903_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1903_End9" name="Complete">
        <bpmn:incoming>W1903_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1903_Annotation10">
        <bpmn:text>Controls: - CTL-373 (ensure controlled execution — Customer Satisfaction &amp; Experience Research (PA-44.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1903_Assoc11" sourceRef="W1903_Annotation10" targetRef="W1903_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1903_Flow12" sourceRef="W1903_Start5" targetRef="W1903_Task6" />
      <bpmn:sequenceFlow id="W1903_Flow13" sourceRef="W1903_Task6" targetRef="W1903_Task7" />
      <bpmn:sequenceFlow id="W1903_Flow14" sourceRef="W1903_Task7" targetRef="W1903_Task8" />
      <bpmn:sequenceFlow id="W1903_Flow15" sourceRef="W1903_Task8" targetRef="W1903_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1903_diag">
      <bpmndi:BPMNPlane id="W1903_plane" bpmnElement="W_W1903">
        <bpmndi:BPMNShape id="W1903_Lane1_di" bpmnElement="W1903_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1903_Lane2_di" bpmnElement="W1903_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1903_Lane3_di" bpmnElement="W1903_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
