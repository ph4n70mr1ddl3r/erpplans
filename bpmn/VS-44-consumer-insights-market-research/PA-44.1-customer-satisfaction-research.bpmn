    <bpmn:process id="W_W1908" name="W1908. Mystery Shopping Program Execution &amp; Compliance Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly mystery shopping cycle
Frequency: Monthly mystery shopping at ~65–70 stores (rotated quarterly across all 200)
Volume: ~65–70 mystery shops/month (~800/year; each store visited at least once per quarter)
Owner: Market Research Analyst
Participants: Market Research Analyst, VP Store Operations, Mystery Shopping Agency, Store Managers
Source: workflow W1908 — Mystery Shopping Program Execution &amp; Compliance Scoring</bpmn:documentation>
      <bpmn:laneSet id="W1908_LaneSet4">
        <bpmn:lane id="W1908_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1908_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1908_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1908_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1908_Lane2" name="Mystery Shopping Agency">
        <bpmn:flowNodeRef>W1908_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1908_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1908_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1908_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1908_Start5" name="Monthly mystery shopping cycle">
        <bpmn:outgoing>W1908_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1908_Task6" name="Market Research Analyst manages mystery shopping program: (a) engage mystery…">
        <bpmn:documentation>Step 1: Market Research Analyst manages mystery shopping program: (a) engage mystery shopping agency (Philippine-based with nationwide coverage), (b) evaluation criteria: (i) greeting and acknowledgment by Sales Associate, (ii) product knowledge: can associate answer basic product questions?, (iii) store cleanliness and organization, (iv) shelf price accuracy vs. POS price, (v) checkout experience: queue time, cashier friendliness, transaction accuracy, (vi) trade account recognition (if applicable), (vii) BOPIS experience (if applicable), (viii) fitting/estimation service availability (if applicable), (c) scoring rubric: 100-point scale per evaluation
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 day setup + ongoing</bpmn:documentation>
        <bpmn:incoming>W1908_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1908_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1908_Task7" name="Mystery shopping agency executes monthly visits: (a) ~65–70 stores per month…">
        <bpmn:documentation>Step 2: Mystery shopping agency executes monthly visits: (a) ~65–70 stores per month (rotated to ensure all 200 stores covered quarterly), (b) mystery shoppers: mix of profiles (DIY homeowner, trade professional, new customer, returning customer), (c) scenarios: purchase specific item, ask product question, return an item, inquire about special order, (d) results submitted within 48 hours of visit
Responsible (R): Mystery Shopping Agency
Accountable (A): Market Research Analyst
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1908_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1908_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1908_Task8" name="Monthly: Market Research Analyst analyzes mystery shopping results: (a) overall…">
        <bpmn:documentation>Step 3: Monthly: Market Research Analyst analyzes mystery shopping results: (a) overall compliance score by store and trend, (b) scores by evaluation category: identify weak areas (e.g., product knowledge scoring lowest chain-wide), (c) recognize top-performing stores and associates, (d) flag stores with scores &lt; 70% for VP Store Operations intervention, (e) distribute store-level results to Store Managers (confidentially)
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1908_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1908_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1908_Task9" name="Store Manager receives results and implements improvements: (a) address…">
        <bpmn:documentation>Step 4: Store Manager receives results and implements improvements: (a) address specific deficiencies identified in mystery shop report, (b) recognize associates who scored well, (c) retrain associates who scored poorly in specific areas, (d) target improvement in next quarter&#x27;s mystery shop
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: Per store</bpmn:documentation>
        <bpmn:incoming>W1908_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1908_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1908_End10" name="Complete">
        <bpmn:incoming>W1908_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1908_Annotation11">
        <bpmn:text>Controls: - CTL-190 (protect research-participant data &amp; insight validity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1908_Assoc12" sourceRef="W1908_Annotation11" targetRef="W1908_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1908_Flow13" sourceRef="W1908_Start5" targetRef="W1908_Task6" />
      <bpmn:sequenceFlow id="W1908_Flow14" sourceRef="W1908_Task6" targetRef="W1908_Task7" />
      <bpmn:sequenceFlow id="W1908_Flow15" sourceRef="W1908_Task7" targetRef="W1908_Task8" />
      <bpmn:sequenceFlow id="W1908_Flow16" sourceRef="W1908_Task8" targetRef="W1908_Task9" />
      <bpmn:sequenceFlow id="W1908_Flow17" sourceRef="W1908_Task9" targetRef="W1908_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1908_diag">
      <bpmndi:BPMNPlane id="W1908_plane" bpmnElement="W_W1908">
        <bpmndi:BPMNShape id="W1908_Lane1_di" bpmnElement="W1908_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1908_Lane2_di" bpmnElement="W1908_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1908_Lane3_di" bpmnElement="W1908_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1908_Task6_di" bpmnElement="W1908_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
