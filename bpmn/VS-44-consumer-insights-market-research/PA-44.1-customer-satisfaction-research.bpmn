    <bpmn:process id="W_W1906" name="W1906. Post-Purchase Experience Survey &amp; Product Satisfaction Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Purchase event (7–14 days post-purchase)
Frequency: Continuous; monthly reporting
Volume: ~2,000–5,000 post-purchase surveys/month
Owner: Market Research Analyst
Participants: Market Research Analyst, Category Manager, VP Merchandising
Source: workflow W1906 — Post-Purchase Experience Survey &amp; Product Satisfaction Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1906_LaneSet4">
        <bpmn:lane id="W1906_Lane1" name="System">
        <bpmn:flowNodeRef>W1906_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1906_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1906_Lane2" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1906_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1906_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W1906_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1906_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1906_Start5" name="Purchase event (7–14 days post-purchase)">
        <bpmn:outgoing>W1906_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1906_Task6" name="System sends post-purchase survey 7 days after transaction: (a) email to…">
        <bpmn:documentation>Step 1: System sends post-purchase survey 7 days after transaction: (a) email to loyalty members and online customers, (b) SMS to POS customers with mobile number on file, (c) questions: (i) &quot;Are you satisfied with the product(s) you purchased?&quot;, (ii) &quot;Did the product meet your expectations?&quot;, (iii) &quot;Would you recommend this product to a friend?&quot;, (iv) &quot;Any issues or concerns with the product?&quot;, (v) product-specific questions based on category (e.g., &quot;How is the paint coverage?&quot; for paint, &quot;How is the tool durability?&quot; for power tools)
Responsible (R): System
Accountable (A): Market Research Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1906_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1906_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1906_Task7" name="Monthly analysis: (a) product satisfaction score by category and SKU, (b)…">
        <bpmn:documentation>Step 2: Monthly analysis: (a) product satisfaction score by category and SKU, (b) identify SKUs with satisfaction score &lt; 3.5/5.0 for Category Manager review, (c) product return correlation: are low-satisfaction SKUs also returned more frequently?, (d) feed into private label quality monitoring (W1839) for BuildRight-branded products
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1906_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1906_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1906_Task8" name="Quarterly: Category Manager reviews product satisfaction data: (a) national…">
        <bpmn:documentation>Step 3: Quarterly: Category Manager reviews product satisfaction data: (a) national brand products with low satisfaction: discuss with vendor, consider alternative products, (b) private label products with low satisfaction: escalate to QA Manager per W1839, (c) customer satisfaction trends inform assortment decisions per W679 (assortment optimization)
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1906_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1906_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1906_End9" name="Complete">
        <bpmn:incoming>W1906_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1906_Annotation10">
        <bpmn:text>Controls: - CTL-373 (ensure controlled execution — Customer Satisfaction &amp; Experience Research (PA-44.1).) | - operational: Market Research Analyst review and approval gate
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
