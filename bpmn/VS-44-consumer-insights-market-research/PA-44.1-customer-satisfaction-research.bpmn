<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-44.1-customer-satisfaction-research" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1902" name="W1902. Quarterly Customer Satisfaction (CSAT) Survey Design &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly survey cycle
Frequency: Quarterly survey execution
Volume: ~2,000–5,000 responses per quarter (email, SMS, in-store)
Owner: Market Research Analyst
Participants: Market Research Analyst, CMO, VP Store Operations
Source: workflow W1902 — Quarterly Customer Satisfaction (CSAT) Survey Design &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W1902_LaneSet3">
        <bpmn:lane id="W1902_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1902_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1902_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1902_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1902_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1902_Lane2" name="CMO">
        <bpmn:flowNodeRef>W1902_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1902_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1902_Start4" name="Quarterly survey cycle">
        <bpmn:outgoing>W1902_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1902_Task5" name="Market Research Analyst designs CSAT survey instrument: (a) overall…">
        <bpmn:documentation>Step 1: Market Research Analyst designs CSAT survey instrument: (a) overall satisfaction: &quot;How satisfied are you with your recent BuildRight experience?&quot; (1–5 scale), (b) satisfaction drivers: product availability, store cleanliness, staff helpfulness, checkout speed, pricing competitiveness, product quality, returns experience, (c) open-ended: &quot;What could BuildRight do to improve your experience?&quot;, (d) segment questions: DIY homeowner vs. trade professional vs. corporate buyer, (e) channel: email to loyalty members, SMS to recent POS customers, in-store tablet survey at exit
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1902_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1902_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1902_Task6" name="Survey distribution: (a) email survey to random sample of 10,000 loyalty…">
        <bpmn:documentation>Step 2: Survey distribution: (a) email survey to random sample of 10,000 loyalty members per quarter, (b) SMS survey to 5,000 recent POS customers (purchase in last 30 days), (c) in-store tablet at 20 stores (rotated quarterly) for exit survey, (d) incentive: 50 loyalty points for completion; target response rate ≥ 15%
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1902_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1902_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1902_Task7" name="Analysis: (a) overall CSAT score by quarter and trend, (b) CSAT by store…">
        <bpmn:documentation>Step 3: Analysis: (a) overall CSAT score by quarter and trend, (b) CSAT by store cluster and region, (c) CSAT by customer segment (DIY, trade, corporate), (d) driver analysis: which satisfaction drivers have the strongest correlation with overall CSAT?, (e) text analytics on open-ended responses: identify top 10 improvement themes, (f) statistical significance testing for quarter-over-quarter changes
Responsible (R): Market Research Analyst
Accountable (A): CMO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1902_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1902_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1902_Task8" name="Presentation and action planning: (a) CMO presents findings to VP Store…">
        <bpmn:documentation>Step 4: Presentation and action planning: (a) CMO presents findings to VP Store Operations and VP Merchandising, (b) identify top 3 improvement priorities per quarter, (c) assign action items to relevant departments with timelines, (d) track action item completion for next quarter&#x27;s survey
Responsible (R): CMO
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1902_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1902_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1902_End9" name="Complete">
        <bpmn:incoming>W1902_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1902_Annotation10">
        <bpmn:text>Controls: - CTL-190 (protect research-participant data &amp; insight validity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1902_Assoc11" sourceRef="W1902_Annotation10" targetRef="W1902_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1902_Flow12" sourceRef="W1902_Start4" targetRef="W1902_Task5" />
      <bpmn:sequenceFlow id="W1902_Flow13" sourceRef="W1902_Task5" targetRef="W1902_Task6" />
      <bpmn:sequenceFlow id="W1902_Flow14" sourceRef="W1902_Task6" targetRef="W1902_Task7" />
      <bpmn:sequenceFlow id="W1902_Flow15" sourceRef="W1902_Task7" targetRef="W1902_Task8" />
      <bpmn:sequenceFlow id="W1902_Flow16" sourceRef="W1902_Task8" targetRef="W1902_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1902_diag">
      <bpmndi:BPMNPlane id="W1902_plane" bpmnElement="W_W1902">
        <bpmndi:BPMNShape id="W1902_Lane1_di" bpmnElement="W1902_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
