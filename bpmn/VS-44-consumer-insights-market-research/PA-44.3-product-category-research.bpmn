    <bpmn:process id="W_W1919" name="W1919. New Category Viability Study &amp; Consumer Demand Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Category Manager proposes new product category addition
Frequency: ~3–5 category viability studies/year
Volume: Per proposed category
Owner: Market Research Analyst
Participants: Market Research Analyst, Category Manager, VP Merchandising, FP&amp;A
Source: workflow W1919 — New Category Viability Study &amp; Consumer Demand Assessment</bpmn:documentation>
      <bpmn:laneSet id="W1919_LaneSet4">
        <bpmn:lane id="W1919_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1919_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1919_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1919_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1919_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1919_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W1919_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1919_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1919_Start5" name="Category Manager proposes new product category addition">
        <bpmn:outgoing>W1919_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1919_Task6" name="Market Research Analyst assesses consumer demand for proposed category: (a)…">
        <bpmn:documentation>Step 1: Market Research Analyst assesses consumer demand for proposed category: (a) desk research: category market size in Philippines, growth rate, key players, (b) customer survey: include questions about proposed category in quarterly CSAT survey, (c) trade account feedback: Account Managers ask trade professionals about demand for proposed products, (d) competitor analysis: do competitors carry this category? How much shelf space? What pricing?, (e) import feasibility: can the products be sourced at competitive landed cost?
Responsible (R): Market Research Analyst
Accountable (A): Category Manager
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1919_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1919_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1919_Task7" name="FP&amp;A builds financial model: (a) projected annual revenue from category…">
        <bpmn:documentation>Step 2: FP&amp;A builds financial model: (a) projected annual revenue from category (conservative, base, optimistic), (b) projected gross margin, (c) required investment: initial inventory, fixtures, training, marketing, (d) payback period and NPV, (e) impact on adjacent categories (cannibalization vs. complementarity)
Responsible (R): FP&amp;A
Accountable (A): Category Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1919_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1919_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1919_Task8" name="Category Manager presents viability study to VP Merchandising for go/no-go…">
        <bpmn:documentation>Step 3: Category Manager presents viability study to VP Merchandising for go/no-go decision
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1919_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1919_End9" name="Complete">
        <bpmn:incoming>W1919_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1919_Annotation10">
        <bpmn:text>Controls: - CTL-375 (ensure controlled execution — Product Category &amp; Shopper Research (PA-44.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1919_Assoc11" sourceRef="W1919_Annotation10" targetRef="W1919_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1919_Flow12" sourceRef="W1919_Start5" targetRef="W1919_Task6" />
      <bpmn:sequenceFlow id="W1919_Flow13" sourceRef="W1919_Task6" targetRef="W1919_Task7" />
      <bpmn:sequenceFlow id="W1919_Flow14" sourceRef="W1919_Task7" targetRef="W1919_Task8" />
      <bpmn:sequenceFlow id="W1919_Flow15" sourceRef="W1919_Task8" targetRef="W1919_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1919_diag">
      <bpmndi:BPMNPlane id="W1919_plane" bpmnElement="W_W1919">
        <bpmndi:BPMNShape id="W1919_Lane1_di" bpmnElement="W1919_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
