<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-44.3-product-category-research" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1918" name="W1918. Category Shopper Behavior Analysis &amp; Purchase Path Research" isExecutable="false">
      <bpmn:documentation>Trigger: Annual category strategy review; new category launch planning
Frequency: Annual per category; per new category launch
Volume: 13 product categories per model company profile
Owner: Market Research Analyst
Participants: Market Research Analyst, Category Manager, VP Merchandising
Source: workflow W1918 — Category Shopper Behavior Analysis &amp; Purchase Path Research</bpmn:documentation>
      <bpmn:laneSet id="W1918_LaneSet3">
        <bpmn:lane id="W1918_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1918_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1918_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1918_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1918_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1918_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1918_Start4" name="Annual category strategy review; new category launch planning">
        <bpmn:outgoing>W1918_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1918_Task5" name="Market Research Analyst analyzes shopper behavior by category using loyalty/POS…">
        <bpmn:documentation>Step 1: Market Research Analyst analyzes shopper behavior by category using loyalty/POS data: (a) purchase frequency by category: how often do customers buy from each category? (b) average basket composition: what categories are bought together? (c) category penetration: what % of BuildRight customers buy from each category? (d) purchase trigger: planned purchase vs. impulse purchase by category (survey data), (e) channel preference: in-store vs. online by category, (f) time-of-purchase patterns: weekend vs. weekday, payday vs. non-payday, (g) trade vs. DIY purchase patterns by category
Responsible (R): Market Research Analyst
Accountable (A): Category Manager
Duration: 3–5 days/category</bpmn:documentation>
        <bpmn:incoming>W1918_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1918_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1918_Task6" name="Category Manager uses shopper behavior data for category strategy: (a) identify…">
        <bpmn:documentation>Step 2: Category Manager uses shopper behavior data for category strategy: (a) identify cross-selling opportunities: categories frequently bought together (e.g., lumber + nails + adhesive) → create bundle promotions, (b) identify underperforming categories: low penetration or declining frequency → investigate cause, (c) optimize shelf allocation: high-frequency categories in accessible locations; low-frequency categories in destination locations, (d) inform assortment decisions per W679
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 days/category</bpmn:documentation>
        <bpmn:incoming>W1918_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1918_End7" name="Complete">
        <bpmn:incoming>W1918_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1918_Annotation8">
        <bpmn:text>Controls: - CTL-375 (ensure controlled execution — Product Category &amp; Shopper Research (PA-44.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1918_Assoc9" sourceRef="W1918_Annotation8" targetRef="W1918_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1918_Flow10" sourceRef="W1918_Start4" targetRef="W1918_Task5" />
      <bpmn:sequenceFlow id="W1918_Flow11" sourceRef="W1918_Task5" targetRef="W1918_Task6" />
      <bpmn:sequenceFlow id="W1918_Flow12" sourceRef="W1918_Task6" targetRef="W1918_End7" />
    </bpmn:process>
