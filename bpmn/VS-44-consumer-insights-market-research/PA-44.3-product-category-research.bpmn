    <bpmn:process id="W_W1923" name="W1923. Product Package Size &amp; Format Optimization Research" isExecutable="false">
      <bpmn:documentation>Trigger: Category review; customer feedback on packaging; competitive packaging analysis
Frequency: Annual per category
Volume: High-volume SKU packaging review
Owner: Category Manager
Participants: Category Manager, Market Research Analyst, Merchandise Planner
Source: workflow W1923 — Product Package Size &amp; Format Optimization Research</bpmn:documentation>
      <bpmn:laneSet id="W1923_LaneSet3">
        <bpmn:lane id="W1923_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W1923_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1923_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1923_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1923_Lane2" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1923_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1923_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1923_Start4" name="Category review; customer feedback on packaging; competitive packaging analysis">
        <bpmn:outgoing>W1923_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1923_Task5" name="Category Manager identifies SKUs for package size review: (a) SKUs where…">
        <bpmn:documentation>Step 1: Category Manager identifies SKUs for package size review: (a) SKUs where customers buy multiple units frequently (opportunity for bulk packaging), (b) SKUs where customers complain about packaging size (too large for DIY, too small for trade), (c) SKUs where competitor packaging is more convenient or cost-effective, (d) private label SKUs where packaging optimization can improve margin
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 day/category</bpmn:documentation>
        <bpmn:incoming>W1923_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1923_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1923_Task6" name="Market Research Analyst conducts packaging preference research: (a) survey…">
        <bpmn:documentation>Step 2: Market Research Analyst conducts packaging preference research: (a) survey: &quot;What package size would you prefer for [product]?&quot;, (b) trade account feedback: &quot;Do you need bulk packaging for this product?&quot;, (c) price per unit analysis: compare unit economics across different package sizes, (d) shelf space productivity: which package sizes generate highest sales per linear meter?, (e) competitive packaging audit: what package sizes do competitors offer?
Responsible (R): Market Research Analyst
Accountable (A): Category Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1923_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1923_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1923_Task7" name="Category Manager recommends packaging changes: (a) add bulk pack for…">
        <bpmn:documentation>Step 3: Category Manager recommends packaging changes: (a) add bulk pack for trade-frequented categories (e.g., 1kg nail pack → 5kg contractor pack), (b) add smaller pack for DIY categories (e.g., 4L paint → 1L sample size), (c) optimize packaging for ecommerce: smaller, lighter, damage-resistant, (d) coordinate with Buyer and factory for packaging change implementation
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1923_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1923_End8" name="Complete">
        <bpmn:incoming>W1923_Flow14</bpmn:incoming>
      </bpmn:endEvent>
