      <bpmndi:BPMNPlane id="W1918_plane" bpmnElement="W_W1918">
        <bpmndi:BPMNShape id="W1918_Lane1_di" bpmnElement="W1918_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="740" height="170" /></bpmndi:BPMNShape>
