        <bpmndi:BPMNEdge id="W1911_Flow10_di" bpmnElement="W1911_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1911_Flow11_di" bpmnElement="W1911_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1911_Flow12_di" bpmnElement="W1911_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1911_Flow13_di" bpmnElement="W1911_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1911_Assoc9_di" bpmnElement="W1911_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1912" name="W1912. Competitive New Store Opening &amp; Expansion Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: News report, trade intelligence, or competitor announcement of new store opening
Frequency: Continuous monitoring; monthly summary
Volume: ~10–20 competitor store openings/year in BuildRight&#x27;s trade areas
Owner: Market Research Analyst
Participants: Market Research Analyst, VP Store Operations, COO
Source: workflow W1912 — Competitive New Store Opening &amp; Expansion Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1912_LaneSet2">
        <bpmn:lane id="W1912_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1912_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1912_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1912_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1912_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1912_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1912_Start3" name="News report, trade intelligence, or competitor announcement of new store opening">
        <bpmn:outgoing>W1912_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1912_Task4" name="Market Research Analyst monitors competitor expansion: (a) Google Alerts for…">
        <bpmn:documentation>Step 1: Market Research Analyst monitors competitor expansion: (a) Google Alerts for competitor names + &quot;new store&quot; + &quot;opening&quot;, (b) social media monitoring of competitor Facebook/Instagram pages for new store announcements, (c) local news monitoring in BuildRight&#x27;s 4 regions, (d) trade account feedback: contractors mentioning competitor openings, (e) LGU business permit tracking (new permits issued to competitors)
Responsible (R): Market Research Analyst
Accountable (A): VP Store Operations
Duration: Ongoing (1–2 hours/week)</bpmn:documentation>
        <bpmn:incoming>W1912_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1912_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1912_Task5" name="Upon detecting competitor new store in BuildRight&#x27;s trade area: (a) assess…">
        <bpmn:documentation>Step 2: Upon detecting competitor new store in BuildRight&#x27;s trade area: (a) assess impact: is the new store within 5 km of an existing BuildRight store? Within 10 km?, (b) estimate competitive threat: store size, format (big-box vs. small-format), categories carried, (c) assess BuildRight store vulnerability: current store sales trend, market saturation, customer loyalty in the area, (d) develop defensive strategy recommendations: (i) increase promotional activity, (ii) enhance trade account engagement in area, (iii) improve store experience, (iv) accelerate planned improvements
Responsible (R): Market Research Analyst
Accountable (A): VP Store Operations
Duration: 4–8 hours</bpmn:documentation>
        <bpmn:incoming>W1912_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1912_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1912_Task6" name="Monthly: Market Research Analyst distributes competitive expansion summary to…">
        <bpmn:documentation>Step 3: Monthly: Market Research Analyst distributes competitive expansion summary to VP Store Operations and COO: (a) new competitor stores opened this month (location, format, estimated size), (b) BuildRight stores potentially impacted, (c) defensive actions taken and results, (d) implications for BuildRight&#x27;s own expansion planning (W1652)
Responsible (R): Market Research Analyst
Accountable (A): VP Store Operations
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1912_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1912_End7" name="Complete">
        <bpmn:incoming>W1912_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1912_Annotation8">
        <bpmn:text>Controls: - CTL-374 (ensure controlled execution — Market &amp; Competitive Intelligence (PA-44.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
