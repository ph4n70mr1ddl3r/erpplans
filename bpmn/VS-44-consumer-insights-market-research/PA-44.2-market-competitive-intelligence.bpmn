<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-44.2-market-competitive-intelligence" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1910" name="W1910. Quarterly Competitive Store Visit &amp; Price Benchmarking" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly competitive intelligence cycle
Frequency: Quarterly visits to 3–5 key competitors in 4 regions
Volume: ~15–20 competitor store visits/quarter across Mindanao, Visayas, Luzon, NCR
Owner: Market Research Analyst
Participants: Market Research Analyst, Category Manager, VP Merchandising
Source: workflow W1910 — Quarterly Competitive Store Visit &amp; Price Benchmarking</bpmn:documentation>
      <bpmn:laneSet id="W1910_LaneSet3">
        <bpmn:lane id="W1910_Lane1" name="Market Research Analyst">
        <bpmn:flowNodeRef>W1910_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1910_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1910_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1910_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1910_Lane2" name="VP Merchandising">
        <bpmn:flowNodeRef>W1910_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1910_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1910_Start4" name="Quarterly competitive intelligence cycle">
        <bpmn:outgoing>W1910_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1910_Task5" name="Market Research Analyst plans competitive visits: (a) target competitors…">
        <bpmn:documentation>Step 1: Market Research Analyst plans competitive visits: (a) target competitors: CitiHardware (Mindanao/Visayas focus), Wilcon Depot (national), ACE Hardware (national), Handyman (Metro Manila), local independents, (b) visit frequency: top 3 competitors quarterly; secondary competitors semi-annually, (c) visit team: Market Research Analyst + Category Manager (rotated by category), (d) visit protocol: pose as regular customer; observe and document
Responsible (R): Market Research Analyst
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1910_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1910_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1910_Task6" name="During visit, document: (a) store layout and planogram: department…">
        <bpmn:documentation>Step 2: During visit, document: (a) store layout and planogram: department organization, traffic flow, signage quality, (b) product assortment: SKUs carried that BuildRight does not (and vice versa), (c) pricing: photograph shelf prices for 50–100 benchmark SKUs (same across all competitors for comparison), (d) promotional activity: current sale events, promotional signage, discount depth, (e) staff interaction: greeting, product knowledge, upselling behavior, (f) store conditions: cleanliness, lighting, stock levels, checkout queue, (g) customer profile: observed customer types and estimated foot traffic
Responsible (R): Market Research Analyst / Category Manager
Accountable (A): VP Merchandising
Duration: 2–4 hours/visit</bpmn:documentation>
        <bpmn:incoming>W1910_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1910_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1910_Task7" name="Analysis: (a) price comparison: BuildRight vs. competitors for benchmark SKU…">
        <bpmn:documentation>Step 3: Analysis: (a) price comparison: BuildRight vs. competitors for benchmark SKU basket — is BuildRight cheaper or more expensive? By how much?, (b) assortment gaps: competitor products that BuildRight should consider adding, (c) competitive advantages: where does BuildRight excel? Where do competitors excel?, (d) promotional strategy comparison: frequency, depth, categories promoted, (e) recommendations for BuildRight pricing, assortment, and merchandising adjustments
Responsible (R): Market Research Analyst
Accountable (A): VP Merchandising
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1910_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1910_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1910_Task8" name="VP Merchandising reviews findings: (a) adjust pricing strategy if BuildRight is…">
        <bpmn:documentation>Step 4: VP Merchandising reviews findings: (a) adjust pricing strategy if BuildRight is significantly above/below market, (b) evaluate assortment additions based on competitor gaps, (c) adjust promotional calendar if competitors are outpromoting BuildRight, (d) share relevant findings with Category Managers for category-level action
Responsible (R): VP Merchandising
Accountable (A): CEO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1910_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1910_End9" name="Complete">
        <bpmn:incoming>W1910_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1910_Annotation10">
        <bpmn:text>Controls: - CTL-374 (ensure controlled execution — Market &amp; Competitive Intelligence (PA-44.2).) | - operational: Market Research Analyst review and approval gate
Owner: Market Research Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1910_Assoc11" sourceRef="W1910_Annotation10" targetRef="W1910_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1910_Flow12" sourceRef="W1910_Start4" targetRef="W1910_Task5" />
      <bpmn:sequenceFlow id="W1910_Flow13" sourceRef="W1910_Task5" targetRef="W1910_Task6" />
      <bpmn:sequenceFlow id="W1910_Flow14" sourceRef="W1910_Task6" targetRef="W1910_Task7" />
      <bpmn:sequenceFlow id="W1910_Flow15" sourceRef="W1910_Task7" targetRef="W1910_Task8" />
      <bpmn:sequenceFlow id="W1910_Flow16" sourceRef="W1910_Task8" targetRef="W1910_End9" />
    </bpmn:process>
