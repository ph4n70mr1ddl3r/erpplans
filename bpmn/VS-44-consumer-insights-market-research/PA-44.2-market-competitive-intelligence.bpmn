    <bpmn:process id="W_W1911" name="W1911. Philippine Home Improvement Market Size &amp; Growth Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Annual market sizing update; quarterly trend monitoring
Frequency: Annual market sizing; quarterly trend updates
Volume: Total addressable market (TAM) for Philippine home improvement retail
Owner: FP&amp;A
Participants: FP&amp;A, VP Merchandising, VP Store Operations
Source: workflow W1911 — Philippine Home Improvement Market Size &amp; Growth Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1911_LaneSet2">
        <bpmn:lane id="W1911_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1911_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1911_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1911_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1911_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1911_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1911_Start3" name="Annual market sizing update; quarterly trend monitoring">
        <bpmn:outgoing>W1911_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1911_Task4" name="Annual: FP&amp;A estimates Philippine home improvement retail market: (a) total…">
        <bpmn:documentation>Step 1: Annual: FP&amp;A estimates Philippine home improvement retail market: (a) total market size: ~PHP 400–600B (estimated based on PSA construction spending data, DTI retail census, and industry reports), (b) market segments: (i) big-box retail (BuildRight, Wilcon, CitiHardware, ACE): ~30–40% of market, (ii) traditional hardware (neighborhood hardware stores): ~40–50%, (iii) online/marketplace: ~5–10%, (iv) direct-from-factory/wholesale: ~10–15%, (c) market growth rate: 6–10% annually (driven by population growth, urbanization, OFW remittance-driven home construction), (d) BuildRight market share: ~PHP 62.3B ÷ ~PHP 500B = ~12.4% of total market; ~30–40% of big-box segment
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 week/year</bpmn:documentation>
        <bpmn:incoming>W1911_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1911_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1911_Task5" name="Quarterly: FP&amp;A updates market trend indicators: (a) PSA construction…">
        <bpmn:documentation>Step 2: Quarterly: FP&amp;A updates market trend indicators: (a) PSA construction statistics (building permits issued, construction value), (b) BSP consumer spending and credit data, (c) OFW remittance trends (key driver for Philippine home construction), (d) cement and steel industry production/sales data (proxy for construction activity), (e) competitor financial reports (Wilcon Depot is publicly listed — quarterly financials available)
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1911_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1911_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1911_Task6" name="Annual: FP&amp;A presents market outlook to CEO and Board: (a) market size and…">
        <bpmn:documentation>Step 3: Annual: FP&amp;A presents market outlook to CEO and Board: (a) market size and share, (b) growth forecast and key drivers, (c) competitive landscape changes, (d) BuildRight growth targets relative to market growth, (e) strategic implications: store expansion pace, category focus, digital investment
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1911_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1911_End7" name="Complete">
        <bpmn:incoming>W1911_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1911_Annotation8">
        <bpmn:text>Controls: - CTL-190 (protect research-participant data &amp; insight validity.) | - operational: standard operating procedures; system-enforced validation rules
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1911_Assoc9" sourceRef="W1911_Annotation8" targetRef="W1911_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1911_Flow10" sourceRef="W1911_Start3" targetRef="W1911_Task4" />
      <bpmn:sequenceFlow id="W1911_Flow11" sourceRef="W1911_Task4" targetRef="W1911_Task5" />
      <bpmn:sequenceFlow id="W1911_Flow12" sourceRef="W1911_Task5" targetRef="W1911_Task6" />
      <bpmn:sequenceFlow id="W1911_Flow13" sourceRef="W1911_Task6" targetRef="W1911_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1911_diag">
      <bpmndi:BPMNPlane id="W1911_plane" bpmnElement="W_W1911">
        <bpmndi:BPMNShape id="W1911_Lane1_di" bpmnElement="W1911_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
