      <bpmndi:BPMNPlane id="W1912_plane" bpmnElement="W_W1912">
        <bpmndi:BPMNShape id="W1912_Lane1_di" bpmnElement="W1912_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
