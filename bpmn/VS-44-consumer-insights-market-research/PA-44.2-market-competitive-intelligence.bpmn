      <bpmn:sequenceFlow id="W1912_Flow11" sourceRef="W1912_Task4" targetRef="W1912_Task5" />
      <bpmn:sequenceFlow id="W1912_Flow12" sourceRef="W1912_Task5" targetRef="W1912_Task6" />
      <bpmn:sequenceFlow id="W1912_Flow13" sourceRef="W1912_Task6" targetRef="W1912_End7" />
    </bpmn:process>
