    <bpmn:process id="W_W2622" name="W2622. Contractor Job Site Delivery Order Capture &amp; Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor places bulk order for job site delivery
Frequency: ~300–500 deliveries/month
Volume: ~300–500/month
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Logistics Coordinator, Contractor
Source: workflow W2622 — Contractor Job Site Delivery Order Capture &amp; Planning</bpmn:documentation>
      <bpmn:laneSet id="W2622_LaneSet4">
        <bpmn:lane id="W2622_Lane1" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2622_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2622_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2622_Lane2" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2622_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2622_Lane3" name="System">
        <bpmn:flowNodeRef>W2622_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2622_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2622_Start5" name="Contractor places bulk order for job site delivery">
        <bpmn:outgoing>W2622_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2622_Task6" name="Trade Sales Rep captures order: delivery address, site contact, access…">
        <bpmn:documentation>Step 1: Trade Sales Rep captures order: delivery address, site contact, access restrictions, required delivery window, special equipment needed (crane, boom truck)
Responsible (R): Trade Sales Rep
Accountable (A): Regional Sales Manager
Duration: 20–30 min</bpmn:documentation>
        <bpmn:incoming>W2622_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2622_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2622_Task7" name="Logistics Coordinator plans delivery: maps route to job site, verifies truck…">
        <bpmn:documentation>Step 2: Logistics Coordinator plans delivery: maps route to job site, verifies truck accessibility, coordinates with contractor for site preparation, schedules delivery within agreed window
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2622_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2622_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2622_Task8" name="System generates delivery order with job site details: GPS coordinates, site…">
        <bpmn:documentation>Step 3: System generates delivery order with job site details: GPS coordinates, site contact, special handling instructions; assigns to appropriate vehicle type; contractor receives SMS confirmation with ETA
Responsible (R): System / Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2622_Flow14</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2622_End9" name="Complete">
        <bpmn:incoming>W2622_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2622_Annotation10">
        <bpmn:text>Controls: - CTL-451 (ensure controlled execution — Job Site Delivery Planning &amp; Scheduling (PA-74.1).) | - operational: Trade Sales Representative sign-off on the workflow output
Owner: Trade Sales Representative</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2622_Assoc11" sourceRef="W2622_Annotation10" targetRef="W2622_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2622_Flow12" sourceRef="W2622_Start5" targetRef="W2622_Task6" />
      <bpmn:sequenceFlow id="W2622_Flow13" sourceRef="W2622_Task6" targetRef="W2622_Task7" />
      <bpmn:sequenceFlow id="W2622_Flow14" sourceRef="W2622_Task7" targetRef="W2622_Task8" />
      <bpmn:sequenceFlow id="W2622_Flow15" sourceRef="W2622_Task8" targetRef="W2622_End9" />
    </bpmn:process>
