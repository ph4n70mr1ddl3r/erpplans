        <bpmn:outgoing>W2627_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2627_Task5" name="Logistics Coordinator verifies job site access: gate location, security…">
        <bpmn:documentation>Step 1: Logistics Coordinator verifies job site access: gate location, security clearance, vehicle restrictions, unloading area; for Metro Manila: checks LGU truck ban hours (6–9AM and 4–8PM)
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2627_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2627_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2627_Task6" name="Coordinator arranges special access if needed: LGU delivery permit, barangay…">
        <bpmn:documentation>Step 2: Coordinator arranges special access if needed: LGU delivery permit, barangay clearance, temporary road closure coordination, security guard notification
Responsible (R): Logistics Coordinator / Contractor
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2627_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2627_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2627_Task7" name="Driver confirms site access upon arrival; if denied: contacts Logistics…">
        <bpmn:documentation>Step 3: Driver confirms site access upon arrival; if denied: contacts Logistics Coordinator for alternative; documents access issues for future planning
Responsible (R): Driver / Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15 min per delivery</bpmn:documentation>
        <bpmn:incoming>W2627_Flow13</bpmn:incoming>
      </bpmn:userTask>
