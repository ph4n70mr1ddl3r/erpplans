    <bpmn:process id="W_W2627" name="W2627. Job Site Delivery Access &amp; Permit Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery requires access planning
Frequency: Per delivery requiring coordination
Volume: ~100–150/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Contractor, LGU Traffic Office
Source: workflow W2627 — Job Site Delivery Access &amp; Permit Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2627_LaneSet3">
        <bpmn:lane id="W2627_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2627_Task5</bpmn:flowNodeRef>
