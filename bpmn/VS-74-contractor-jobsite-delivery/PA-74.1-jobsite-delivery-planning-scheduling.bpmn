    <bpmn:process id="W_W2626" name="W2626. Emergency &amp; Same-Day Contractor Delivery Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor requests urgent same-day delivery
Frequency: Ad-hoc; 20–30 emergency deliveries/month
Volume: 20–30/month
Owner: Store Manager / Logistics Coordinator
Participants: Store Manager, Logistics Coord, Trade Sales Rep, DC Ops
Source: workflow W2626 — Emergency &amp; Same-Day Contractor Delivery Processing</bpmn:documentation>
