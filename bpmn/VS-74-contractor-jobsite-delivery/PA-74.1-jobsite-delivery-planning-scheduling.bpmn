    <bpmn:process id="W_W2629" name="W2629. Contractor Delivery Special Equipment Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery requires special equipment
Frequency: Ad-hoc; 20–30/month
Volume: 20–30/month
Owner: Logistics Coordinator
Participants: Logistics Coord, 3PL Heavy Equipment Partner, Contractor
Source: workflow W2629 — Contractor Delivery Special Equipment Coordination</bpmn:documentation>
      <bpmn:laneSet id="W2629_LaneSet3">
        <bpmn:lane id="W2629_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2629_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2629_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2629_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2629_Lane2" name="Driver">
        <bpmn:flowNodeRef>W2629_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2629_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2629_Start4" name="Delivery requires special equipment">
        <bpmn:outgoing>W2629_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2629_Task5" name="Logistics Coordinator identifies equipment needs: flatbed for steel/lumber…">
        <bpmn:documentation>Step 1: Logistics Coordinator identifies equipment needs: flatbed for steel/lumber, refrigerated truck for adhesives, forklift for palletized cement, boom truck for rooftop placement
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2629_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2629_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2629_Task6" name="Coordinator arranges equipment: contacts 3PL partners, negotiates rate (50–100%…">
        <bpmn:documentation>Step 2: Coordinator arranges equipment: contacts 3PL partners, negotiates rate (50–100% premium), confirms availability; provides specs to contractor for site compatibility
Responsible (R): Logistics Coordinator / 3PL
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2629_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2629_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2629_Task7" name="Special equipment delivery executed; contractor confirms receipt; Logistics…">
        <bpmn:documentation>Step 3: Special equipment delivery executed; contractor confirms receipt; Logistics tracks costs vs. benchmarks for proactive fleet planning
Responsible (R): Driver / Contractor / Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 2–6 hours</bpmn:documentation>
        <bpmn:incoming>W2629_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2629_End8" name="Complete">
        <bpmn:incoming>W2629_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2629_Annotation9">
        <bpmn:text>Controls: - CTL-451 (ensure controlled execution — Job Site Delivery Planning &amp; Scheduling (PA-74.1).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
