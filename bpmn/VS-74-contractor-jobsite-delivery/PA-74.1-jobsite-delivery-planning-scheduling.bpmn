    <bpmn:process id="W_W2625" name="W2625. Phased Construction Delivery Schedule Management" isExecutable="false">
      <bpmn:documentation>Trigger: Large contractor project requires multiple deliveries
Frequency: Per major project; ~20–30 active projects
Volume: ~20–30 active projects
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Logistics, Supply Planning, Contractor
Source: workflow W2625 — Phased Construction Delivery Schedule Management</bpmn:documentation>
      <bpmn:laneSet id="W2625_LaneSet4">
        <bpmn:lane id="W2625_Lane1" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2625_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2625_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2625_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W2625_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2625_Lane3" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2625_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2625_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2625_Start5" name="Large contractor project requires multiple deliveries">
        <bpmn:outgoing>W2625_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2625_Task6" name="Trade Sales Rep develops phased delivery schedule with contractor: project…">
        <bpmn:documentation>Step 1: Trade Sales Rep develops phased delivery schedule with contractor: project phases (foundation → framing → electrical → finishing), material quantities per phase, delivery dates aligned with construction timeline
Responsible (R): Trade Sales Rep / Contractor
Accountable (A): Regional Sales Manager
Duration: 2–3 hours</bpmn:documentation>
        <bpmn:incoming>W2625_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2625_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2625_Task7" name="Supply Planning reserves inventory for phased deliveries: sets aside materials…">
        <bpmn:documentation>Step 2: Supply Planning reserves inventory for phased deliveries: sets aside materials for future phases; adjusts ROP and safety stock for high-demand project SKUs
Responsible (R): Supply Planning
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2625_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2625_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2625_Task8" name="Logistics Coordinator manages ongoing phased delivery calendar: confirms dates…">
        <bpmn:documentation>Step 3: Logistics Coordinator manages ongoing phased delivery calendar: confirms dates 3 days before each phase, adjusts for construction delays; system tracks completion against plan
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: Ongoing</bpmn:documentation>
