    <bpmn:process id="W_W2623" name="W2623. Multi-Drop Job Site Delivery Route Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Multiple contractor deliveries in same region
Frequency: Daily per DC
Volume: 4 DCs; ~300–500 deliveries/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Drivers, 3PL Partners, DC Ops
Source: workflow W2623 — Multi-Drop Job Site Delivery Route Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2623_LaneSet4">
        <bpmn:lane id="W2623_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2623_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2623_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2623_Lane2" name="System">
        <bpmn:flowNodeRef>W2623_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2623_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W2623_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2623_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2623_Start5" name="Multiple contractor deliveries in same region">
        <bpmn:outgoing>W2623_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2623_Task6" name="Logistics Coordinator consolidates orders by region: groups 2–4 job site…">
        <bpmn:documentation>Step 1: Logistics Coordinator consolidates orders by region: groups 2–4 job site deliveries per route; sequences by proximity and time window; ensures total weight within vehicle capacity
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1–2 hours</bpmn:documentation>
        <bpmn:incoming>W2623_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2623_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2623_Task7" name="System optimizes route considering: road restrictions, job site access times…">
        <bpmn:documentation>Step 2: System optimizes route considering: road restrictions, job site access times, unloading duration per site, driver hours of service compliance
Responsible (R): System / Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2623_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2623_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2623_Task8" name="DC Ops picks and loads multi-drop delivery: organizes by drop sequence…">
        <bpmn:documentation>Step 3: DC Ops picks and loads multi-drop delivery: organizes by drop sequence; includes delivery manifest per drop; driver receives route plan via mobile app with GPS navigation
Responsible (R): DC Ops / Driver
Accountable (A): DC Ops Manager
Duration: 2–3 hours loading</bpmn:documentation>
        <bpmn:incoming>W2623_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2623_End9" name="Complete">
        <bpmn:incoming>W2623_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2623_Annotation10">
        <bpmn:text>Controls: - CTL-451 (ensure controlled execution — Job Site Delivery Planning &amp; Scheduling (PA-74.1).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2623_Assoc11" sourceRef="W2623_Annotation10" targetRef="W2623_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2623_Flow12" sourceRef="W2623_Start5" targetRef="W2623_Task6" />
      <bpmn:sequenceFlow id="W2623_Flow13" sourceRef="W2623_Task6" targetRef="W2623_Task7" />
      <bpmn:sequenceFlow id="W2623_Flow14" sourceRef="W2623_Task7" targetRef="W2623_Task8" />
      <bpmn:sequenceFlow id="W2623_Flow15" sourceRef="W2623_Task8" targetRef="W2623_End9" />
    </bpmn:process>
