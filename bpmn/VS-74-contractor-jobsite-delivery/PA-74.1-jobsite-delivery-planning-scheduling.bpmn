      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2624" name="W2624. Crane &amp; Boom Truck Delivery Scheduling" isExecutable="false">
      <bpmn:documentation>Trigger: Order includes heavy/bulky items requiring crane
Frequency: Ad-hoc; 30–50 crane deliveries/month
Volume: 30–50/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Heavy Equipment Operator, Contractor, Safety Officer
Source: workflow W2624 — Crane &amp; Boom Truck Delivery Scheduling</bpmn:documentation>
      <bpmn:laneSet id="W2624_LaneSet3">
        <bpmn:lane id="W2624_Lane1" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2624_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2624_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2624_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2624_Lane2" name="Driver">
        <bpmn:flowNodeRef>W2624_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2624_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2624_Start4" name="Order includes heavy/bulky items requiring crane">
        <bpmn:outgoing>W2624_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2624_Task5" name="Logistics Coordinator identifies crane-required items: steel beams, large…">
        <bpmn:documentation>Step 1: Logistics Coordinator identifies crane-required items: steel beams, large appliances, bulk cement; confirms site has suitable crane positioning, ground bearing capacity, overhead clearance
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2624_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2624_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2624_Task6" name="Coordinator books crane/boom truck from owned fleet or 3PL (PHP 15K–30K per…">
        <bpmn:documentation>Step 2: Coordinator books crane/boom truck from owned fleet or 3PL (PHP 15K–30K per delivery); schedules operator and rigger; confirms contractor has receiving personnel
Responsible (R): Logistics Coordinator / 3PL Partner
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2624_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2624_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2624_Task7" name="Driver and crane operator execute delivery: position crane safely, lift…">
        <bpmn:documentation>Step 3: Driver and crane operator execute delivery: position crane safely, lift materials to placement area; contractor signs delivery receipt; Logistics tracks actual vs. planned cost
Responsible (R): Driver / Crane Operator / Contractor
Accountable (A): Logistics Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2624_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2624_End8" name="Complete">
        <bpmn:incoming>W2624_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2624_Annotation9">
        <bpmn:text>Controls: - CTL-451 (ensure controlled execution — Job Site Delivery Planning &amp; Scheduling (PA-74.1).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2624_Assoc10" sourceRef="W2624_Annotation9" targetRef="W2624_Start4" associationDirection="None" />
