        <bpmn:outgoing>W2626_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2626_Task6" name="Trade Sales Rep receives urgent request: critical material needed same-day…">
        <bpmn:documentation>Step 1: Trade Sales Rep receives urgent request: critical material needed same-day; verifies availability; Store Manager approves emergency prioritization
Responsible (R): Trade Sales Rep / Store Manager
Accountable (A): Regional Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2626_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2626_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2626_Task7" name="Logistics Coordinator dispatches emergency delivery: assigns available truck…">
        <bpmn:documentation>Step 2: Logistics Coordinator dispatches emergency delivery: assigns available truck, loads from store stock (bypasses DC); premium delivery fee applied (PHP 2K–5K) unless waived for key account
Responsible (R): Logistics Coordinator / Store Manager
Accountable (A): Logistics Manager
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2626_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2626_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2626_Task8" name="Driver executes same-day delivery; contractor signs receipt; Store Manager…">
        <bpmn:documentation>Step 3: Driver executes same-day delivery; contractor signs receipt; Store Manager tracks emergency frequency per contractor; Trade Sales Rep follows up on additional needs
Responsible (R): Driver / Trade Sales Rep
Accountable (A): Logistics Manager
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2626_Flow14</bpmn:incoming>
      </bpmn:userTask>
