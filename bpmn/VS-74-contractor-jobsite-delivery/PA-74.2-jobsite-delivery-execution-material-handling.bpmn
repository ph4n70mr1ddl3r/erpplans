      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2631" name="W2631. Job Site Delivery Damage &amp; Shortage Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor reports discrepancy
Frequency: Ad-hoc; ~30–50 incidents/month
Volume: ~30–50/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Driver, Trade Sales Rep, Contractor, LP
Source: workflow W2631 — Job Site Delivery Damage &amp; Shortage Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2631_LaneSet4">
        <bpmn:lane id="W2631_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W2631_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2631_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2631_Lane2" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2631_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2631_Lane3" name="Logistics Coord">
        <bpmn:flowNodeRef>W2631_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2631_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2631_Start5" name="Contractor reports discrepancy">
        <bpmn:outgoing>W2631_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2631_Task6" name="Contractor reports damage or shortage with photos; Trade Sales Rep logs…">
        <bpmn:documentation>Step 1: Contractor reports damage or shortage with photos; Trade Sales Rep logs incident in ERP; severity classification: minor (&lt;PHP 5K), moderate, major (&gt;PHP 50K)
Responsible (R): Contractor / Trade Sales Rep
Accountable (A): Regional Sales Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2631_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2631_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2631_Task7" name="Logistics Coordinator investigates: reviews driver photos, checks loading…">
        <bpmn:documentation>Step 2: Logistics Coordinator investigates: reviews driver photos, checks loading records; determines responsibility (BuildRight, 3PL, contractor)
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2631_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2631_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2631_Task8" name="Resolution: replacement within 48 hours for BuildRight-caused issues; credit…">
        <bpmn:documentation>Step 3: Resolution: replacement within 48 hours for BuildRight-caused issues; credit note for shortages; LP investigates patterns; 3PL liability claim for carrier damage
Responsible (R): Logistics Coord / Trade Sales Rep / LP
Accountable (A): Logistics Manager
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W2631_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2631_End9" name="Complete">
        <bpmn:incoming>W2631_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2631_Annotation10">
        <bpmn:text>Controls: - CTL-452 (ensure controlled execution — Job Site Delivery Execution &amp; Material Handling (PA-74.2).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2631_Assoc11" sourceRef="W2631_Annotation10" targetRef="W2631_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2631_Flow12" sourceRef="W2631_Start5" targetRef="W2631_Task6" />
      <bpmn:sequenceFlow id="W2631_Flow13" sourceRef="W2631_Task6" targetRef="W2631_Task7" />
      <bpmn:sequenceFlow id="W2631_Flow14" sourceRef="W2631_Task7" targetRef="W2631_Task8" />
      <bpmn:sequenceFlow id="W2631_Flow15" sourceRef="W2631_Task8" targetRef="W2631_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2631_diag">
      <bpmndi:BPMNPlane id="W2631_plane" bpmnElement="W_W2631">
        <bpmndi:BPMNShape id="W2631_Lane1_di" bpmnElement="W2631_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2631_Lane2_di" bpmnElement="W2631_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2631_Lane3_di" bpmnElement="W2631_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
