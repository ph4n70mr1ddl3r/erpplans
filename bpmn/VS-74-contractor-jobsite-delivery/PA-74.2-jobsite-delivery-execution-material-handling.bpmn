    <bpmn:process id="W_W2636" name="W2636. Job Site Delivery Quality Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor questions material quality
Frequency: Ad-hoc; 10–20 issues/month
Volume: ~10–20/month
Owner: Trade Sales Representative
Participants: Trade Sales Rep, Quality Inspector, Contractor, Category Manager
Source: workflow W2636 — Job Site Delivery Quality Verification</bpmn:documentation>
      <bpmn:laneSet id="W2636_LaneSet3">
        <bpmn:lane id="W2636_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W2636_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2636_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2636_Lane2" name="Trade Sales Rep">
        <bpmn:flowNodeRef>W2636_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2636_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2636_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2636_Start4" name="Contractor questions material quality">
        <bpmn:outgoing>W2636_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2636_Task5" name="Contractor identifies quality concern at delivery: lumber grade mismatch, tile…">
        <bpmn:documentation>Step 1: Contractor identifies quality concern at delivery: lumber grade mismatch, tile color variation, cement moisture damage, steel dimension off-spec; refuses affected items
Responsible (R): Contractor / Trade Sales Rep
Accountable (A): Regional Sales Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2636_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2636_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2636_Task6" name="Trade Sales Rep escalates: Quality Inspector visits site within 24 hours to…">
        <bpmn:documentation>Step 2: Trade Sales Rep escalates: Quality Inspector visits site within 24 hours to assess; compares against specification and order agreement
Responsible (R): Trade Sales Rep / Quality Inspector
Accountable (A): Category Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2636_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2636_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2636_Task7" name="Resolution: valid issue — replacement within 48 hours, vendor claim filed…">
        <bpmn:documentation>Step 3: Resolution: valid issue — replacement within 48 hours, vendor claim filed; specification misunderstanding — clarifies and offers exchange; Category Manager updates product description
Responsible (R): Trade Sales Rep / Category Manager
Accountable (A): VP Merchandising
Duration: 2–5 days</bpmn:documentation>
        <bpmn:incoming>W2636_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2636_End8" name="Complete">
        <bpmn:incoming>W2636_Flow14</bpmn:incoming>
      </bpmn:endEvent>
