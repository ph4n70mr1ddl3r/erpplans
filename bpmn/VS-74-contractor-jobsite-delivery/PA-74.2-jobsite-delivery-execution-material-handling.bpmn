<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-74.2-jobsite-delivery-execution-material-handling" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2630" name="W2630. Job Site Delivery Unloading &amp; Material Placement" isExecutable="false">
      <bpmn:documentation>Trigger: Truck arrives at construction site
Frequency: ~300–500 deliveries/month
Volume: ~300–500/month
Owner: Driver / Delivery Crew
Participants: Driver, Delivery Crew, Contractor Site Foreman
Source: workflow W2630 — Job Site Delivery Unloading &amp; Material Placement</bpmn:documentation>
      <bpmn:laneSet id="W2630_LaneSet4">
        <bpmn:lane id="W2630_Lane1" name="Driver">
        <bpmn:flowNodeRef>W2630_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2630_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2630_Lane2" name="Delivery Crew">
        <bpmn:flowNodeRef>W2630_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2630_Lane3" name="Site Foreman">
        <bpmn:flowNodeRef>W2630_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2630_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2630_Start5" name="Truck arrives at construction site">
        <bpmn:outgoing>W2630_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2630_Task6" name="Driver arrives at site: contacts foreman, confirms unloading location, verifies…">
        <bpmn:documentation>Step 1: Driver arrives at site: contacts foreman, confirms unloading location, verifies site access and safety (hard hat area, PPE required); positions truck
Responsible (R): Driver
Accountable (A): Logistics Coordinator
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2630_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2630_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2630_Task7" name="Delivery crew and contractor personnel unload: hand-bomb materials if no…">
        <bpmn:documentation>Step 2: Delivery crew and contractor personnel unload: hand-bomb materials if no forklift/crane; place in designated staging area per contractor direction; separate by type and phase
Responsible (R): Delivery Crew / Contractor Personnel
Accountable (A): Driver
Duration: 30–90 min</bpmn:documentation>
        <bpmn:incoming>W2630_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2630_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2630_Task8" name="Site foreman verifies delivery against manifest: counts items, notes damage or…">
        <bpmn:documentation>Step 3: Site foreman verifies delivery against manifest: counts items, notes damage or shortage, signs receipt; Driver photographs delivered materials as proof
Responsible (R): Site Foreman / Driver
Accountable (A): Logistics Coordinator
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2630_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2630_End9" name="Complete">
        <bpmn:incoming>W2630_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2630_Annotation10">
        <bpmn:text>Controls: - CTL-452 (ensure controlled execution — Job Site Delivery Execution &amp; Material Handling (PA-74.2).) | - operational: Driver / Delivery Crew sign-off on the workflow output
Owner: Driver / Delivery Crew</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2630_Assoc11" sourceRef="W2630_Annotation10" targetRef="W2630_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2630_Flow12" sourceRef="W2630_Start5" targetRef="W2630_Task6" />
      <bpmn:sequenceFlow id="W2630_Flow13" sourceRef="W2630_Task6" targetRef="W2630_Task7" />
      <bpmn:sequenceFlow id="W2630_Flow14" sourceRef="W2630_Task7" targetRef="W2630_Task8" />
      <bpmn:sequenceFlow id="W2630_Flow15" sourceRef="W2630_Task8" targetRef="W2630_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2630_diag">
      <bpmndi:BPMNPlane id="W2630_plane" bpmnElement="W_W2630">
        <bpmndi:BPMNShape id="W2630_Lane1_di" bpmnElement="W2630_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2630_Lane2_di" bpmnElement="W2630_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2630_Lane3_di" bpmnElement="W2630_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
