    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2637" name="W2637. Job Site Delivery Real-Time Tracking &amp; ETA Communication" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery dispatched from DC or store
Frequency: Per delivery
Volume: ~300–500/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Driver, Contractor, Trade Sales Rep
Source: workflow W2637 — Job Site Delivery Real-Time Tracking &amp; ETA Communication</bpmn:documentation>
      <bpmn:laneSet id="W2637_LaneSet4">
        <bpmn:lane id="W2637_Lane1" name="System">
        <bpmn:flowNodeRef>W2637_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2637_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2637_Lane2" name="Driver">
        <bpmn:flowNodeRef>W2637_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2637_Lane3" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2637_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2637_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2637_Start5" name="Delivery dispatched from DC or store">
        <bpmn:outgoing>W2637_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2637_Task6" name="System sends automated ETA notification to contractor when dispatched…">
        <bpmn:documentation>Step 1: System sends automated ETA notification to contractor when dispatched: estimated arrival, driver name and contact, vehicle plate, delivery contents summary
Responsible (R): System
Accountable (A): Logistics Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2637_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2637_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2637_Task7" name="Driver updates status in mobile app: departed, en route (GPS tracking)…">
        <bpmn:documentation>Step 2: Driver updates status in mobile app: departed, en route (GPS tracking), arrived, unloading started, complete; contractor tracks via app
Responsible (R): Driver / System
Accountable (A): Logistics Coordinator
Duration: Per status update</bpmn:documentation>
        <bpmn:incoming>W2637_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2637_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2637_Task8" name="Logistics Coordinator manages ETA exceptions: if delayed &gt;30 min, notifies…">
        <bpmn:documentation>Step 3: Logistics Coordinator manages ETA exceptions: if delayed &gt;30 min, notifies contractor with updated ETA; tracks on-time delivery rate (target: ≥90%)
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2637_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2637_End9" name="Complete">
        <bpmn:incoming>W2637_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2637_Annotation10">
        <bpmn:text>Controls: - CTL-452 (ensure controlled execution — Job Site Delivery Execution &amp; Material Handling (PA-74.2).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2637_Assoc11" sourceRef="W2637_Annotation10" targetRef="W2637_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2637_Flow12" sourceRef="W2637_Start5" targetRef="W2637_Task6" />
      <bpmn:sequenceFlow id="W2637_Flow13" sourceRef="W2637_Task6" targetRef="W2637_Task7" />
      <bpmn:sequenceFlow id="W2637_Flow14" sourceRef="W2637_Task7" targetRef="W2637_Task8" />
      <bpmn:sequenceFlow id="W2637_Flow15" sourceRef="W2637_Task8" targetRef="W2637_End9" />
    </bpmn:process>
