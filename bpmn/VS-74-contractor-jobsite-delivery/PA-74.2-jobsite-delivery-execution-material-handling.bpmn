        <bpmndi:BPMNShape id="W2631_End9_di" bpmnElement="W2631_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2631_Annotation10_di" bpmnElement="W2631_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2631_Flow12_di" bpmnElement="W2631_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2631_Flow13_di" bpmnElement="W2631_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2631_Flow14_di" bpmnElement="W2631_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2631_Flow15_di" bpmnElement="W2631_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2631_Assoc11_di" bpmnElement="W2631_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2632" name="W2632. Delivery Return &amp; Excess Material Pickup" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor has excess materials for return
Frequency: Ad-hoc; ~50–100 returns/month
Volume: ~50–100/month
Owner: Logistics Coordinator
Participants: Logistics Coord, Trade Sales Rep, Contractor, Receiving Clerk
Source: workflow W2632 — Delivery Return &amp; Excess Material Pickup</bpmn:documentation>
      <bpmn:laneSet id="W2632_LaneSet4">
        <bpmn:lane id="W2632_Lane1" name="Contractor">
        <bpmn:flowNodeRef>W2632_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2632_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2632_Lane2" name="Logistics Coordinator">
        <bpmn:flowNodeRef>W2632_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2632_Lane3" name="Receiving Clerk">
        <bpmn:flowNodeRef>W2632_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2632_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2632_Start5" name="Contractor has excess materials for return">
        <bpmn:outgoing>W2632_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2632_Task6" name="Contractor requests return: provides PO reference, item list; Rep verifies…">
        <bpmn:documentation>Step 1: Contractor requests return: provides PO reference, item list; Rep verifies eligibility (within 30 days, unused condition); creates return authorization
Responsible (R): Contractor / Trade Sales Rep
Accountable (A): Regional Sales Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2632_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2632_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2632_Task7" name="Logistics Coordinator schedules pickup: combines with next delivery to same…">
        <bpmn:documentation>Step 2: Logistics Coordinator schedules pickup: combines with next delivery to same area; driver collects with return manifest
Responsible (R): Logistics Coordinator / Driver
Accountable (A): Logistics Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2632_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2632_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2632_Task8" name="Receiving Clerk processes return: inspects condition, verifies against…">
        <bpmn:documentation>Step 3: Receiving Clerk processes return: inspects condition, verifies against authorization, processes goods receipt; Finance issues credit note
Responsible (R): Receiving Clerk / Finance
Accountable (A): Store Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2632_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2632_End9" name="Complete">
        <bpmn:incoming>W2632_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2632_Annotation10">
        <bpmn:text>Controls: - CTL-452 (ensure controlled execution — Job Site Delivery Execution &amp; Material Handling (PA-74.2).) | - operational: Logistics Coordinator sign-off on the workflow output
Owner: Logistics Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2632_Assoc11" sourceRef="W2632_Annotation10" targetRef="W2632_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2632_Flow12" sourceRef="W2632_Start5" targetRef="W2632_Task6" />
      <bpmn:sequenceFlow id="W2632_Flow13" sourceRef="W2632_Task6" targetRef="W2632_Task7" />
      <bpmn:sequenceFlow id="W2632_Flow14" sourceRef="W2632_Task7" targetRef="W2632_Task8" />
      <bpmn:sequenceFlow id="W2632_Flow15" sourceRef="W2632_Task8" targetRef="W2632_End9" />
    </bpmn:process>
