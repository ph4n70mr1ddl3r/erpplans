    <bpmn:process id="W_W2633" name="W2633. Job Site Delivery Proof of Delivery &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery completion
Frequency: Per delivery; ~300–500/month
Volume: ~300–500/month
Owner: Driver
Participants: Driver, Logistics Coordinator, Trade Sales Rep, Finance
Source: workflow W2633 — Job Site Delivery Proof of Delivery &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W2633_LaneSet4">
        <bpmn:lane id="W2633_Lane1" name="Driver">
        <bpmn:flowNodeRef>W2633_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2633_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2633_Lane2" name="System">
        <bpmn:flowNodeRef>W2633_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2633_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2633_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2633_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2633_Start5" name="Delivery completion">
        <bpmn:outgoing>W2633_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2633_Task6" name="Driver collects POD: signed receipt from foreman (paper or electronic)…">
        <bpmn:documentation>Step 1: Driver collects POD: signed receipt from foreman (paper or electronic), photographs of materials at placement, GPS coordinates, delivery timestamp
Responsible (R): Driver
Accountable (A): Logistics Coordinator
Duration: 10 min per delivery</bpmn:documentation>
        <bpmn:incoming>W2633_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2633_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2633_Task7" name="System uploads POD data: matches to delivery order, records GPS and timestamp…">
        <bpmn:documentation>Step 2: System uploads POD data: matches to delivery order, records GPS and timestamp, stores photos; auto-matches to sales order for billing
Responsible (R): System / Driver
Accountable (A): Logistics Coordinator
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2633_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2633_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2633_Task8" name="Finance uses POD for billing: triggers invoice for trade accounts; settles 3PL…">
