        <bpmn:flowNodeRef>W2634_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2634_Lane2" name="Safety Officer">
        <bpmn:flowNodeRef>W2634_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2634_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2634_Start4" name="Truck arrives at active construction site">
        <bpmn:outgoing>W2634_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2634_Task5" name="Driver dons required PPE: hard hat, safety vest, safety shoes; attends site…">
        <bpmn:documentation>Step 1: Driver dons required PPE: hard hat, safety vest, safety shoes; attends site safety briefing; identifies hazards (excavations, overhead work, equipment)
Responsible (R): Driver
Accountable (A): Logistics Coordinator
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2634_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2634_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2634_Task6" name="Driver follows site-specific safety rules: speed limit, designated routes…">
        <bpmn:documentation>Step 2: Driver follows site-specific safety rules: speed limit, designated routes, prohibited areas, emergency assembly point; reports unsafe conditions
Responsible (R): Driver / Safety Officer
Accountable (A): Logistics Manager
Duration: During delivery</bpmn:documentation>
        <bpmn:incoming>W2634_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2634_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2634_Task7" name="Safety Officer conducts random compliance checks; tracks safety incident rate…">
        <bpmn:documentation>Step 3: Safety Officer conducts random compliance checks; tracks safety incident rate (target: zero); incorporates into driver training
Responsible (R): Safety Officer
Accountable (A): COO
Duration: Monthly review</bpmn:documentation>
        <bpmn:incoming>W2634_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2634_End8" name="Complete">
        <bpmn:incoming>W2634_Flow14</bpmn:incoming>
      </bpmn:endEvent>
