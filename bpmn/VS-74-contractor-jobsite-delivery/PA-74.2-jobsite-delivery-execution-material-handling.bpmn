    <bpmn:process id="W_W2634" name="W2634. Contractor Site Safety Compliance During Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Truck arrives at active construction site
Frequency: Per delivery to active sites
Volume: ~200–300/month
Owner: Driver
Participants: Driver, Safety Officer, Contractor Site Safety Manager
Source: workflow W2634 — Contractor Site Safety Compliance During Delivery</bpmn:documentation>
      <bpmn:laneSet id="W2634_LaneSet3">
