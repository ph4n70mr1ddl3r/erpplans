        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2635_Start5" name="Delivery of bulk construction materials">
        <bpmn:outgoing>W2635_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2635_Task6" name="Logistics Coordinator arranges bulk delivery (sand, gravel, cement): requires…">
        <bpmn:documentation>Step 1: Logistics Coordinator arranges bulk delivery (sand, gravel, cement): requires dump trucks; coordinates with DSD vendor or 3PL; confirms contractor has designated dump area
Responsible (R): Logistics Coordinator
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2635_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2635_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2635_Task7" name="Driver delivers: positions dump truck, tips load carefully; contractor foreman…">
        <bpmn:documentation>Step 2: Driver delivers: positions dump truck, tips load carefully; contractor foreman visually estimates quantity; photographs tipped load
Responsible (R): Driver / Contractor Foreman
Accountable (A): Logistics Coordinator
Duration: 30–60 min</bpmn:documentation>
        <bpmn:incoming>W2635_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2635_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W2635_Task8" name="System processes bulk delivery: catch-weight recorded with estimated weight…">
        <bpmn:documentation>Step 3: System processes bulk delivery: catch-weight recorded with estimated weight; Finance bills based on delivered weight; Logistics tracks cost per cubic meter
Responsible (R): System / Finance / Logistics
Accountable (A): Finance Controller
Duration: Per delivery</bpmn:documentation>
        <bpmn:incoming>W2635_Flow14</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2635_End9" name="Complete">
        <bpmn:incoming>W2635_Flow15</bpmn:incoming>
      </bpmn:endEvent>
