      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2639" name="W2639. Contractor Delivery Cost per Order Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cost analysis
Frequency: Monthly
Volume: ~300–500 deliveries/month
Owner: Finance Analyst
Participants: Finance Analyst, Logistics Manager, CFO
Source: workflow W2639 — Contractor Delivery Cost per Order Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2639_LaneSet3">
        <bpmn:lane id="W2639_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2639_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2639_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2639_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2639_Lane2" name="Finance Controller">
        <bpmn:flowNodeRef>W2639_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2639_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2639_Start4" name="Monthly cost analysis">
        <bpmn:outgoing>W2639_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2639_Task5" name="Finance Analyst calculates delivery cost per contractor order: direct costs…">
        <bpmn:documentation>Step 1: Finance Analyst calculates delivery cost per contractor order: direct costs (fuel, driver, 3PL), indirect costs, special equipment surcharges; compares against fee charged
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2639_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2639_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2639_Task6" name="Analyst identifies cost optimization: consolidate routes, negotiate better 3PL…">
        <bpmn:documentation>Step 2: Analyst identifies cost optimization: consolidate routes, negotiate better 3PL rates, reduce crane frequency, encourage self-pickup for smaller orders
Responsible (R): Finance Analyst / Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2639_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2639_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2639_Task7" name="Finance Controller reviews contractor delivery profitability: revenue vs. cost…">
        <bpmn:documentation>Step 3: Finance Controller reviews contractor delivery profitability: revenue vs. cost; identifies money-losing routes; proposes fee adjustments or minimum orders for free delivery
Responsible (R): Finance Controller
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W2639_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2639_End8" name="Complete">
        <bpmn:incoming>W2639_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2639_Annotation9">
        <bpmn:text>Controls: - CTL-453 (ensure controlled execution — Job Site Delivery Performance &amp; Analytics (PA-74.3).) | - operational: Finance Analyst sign-off on the workflow output
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2639_Assoc10" sourceRef="W2639_Annotation9" targetRef="W2639_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2639_Flow11" sourceRef="W2639_Start4" targetRef="W2639_Task5" />
      <bpmn:sequenceFlow id="W2639_Flow12" sourceRef="W2639_Task5" targetRef="W2639_Task6" />
      <bpmn:sequenceFlow id="W2639_Flow13" sourceRef="W2639_Task6" targetRef="W2639_Task7" />
      <bpmn:sequenceFlow id="W2639_Flow14" sourceRef="W2639_Task7" targetRef="W2639_End8" />
    </bpmn:process>
