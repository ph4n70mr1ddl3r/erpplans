<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-74.3-jobsite-delivery-performance-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2638" name="W2638. Contractor Delivery On-Time Performance Measurement" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly reporting cycle
Frequency: Monthly
Volume: ~300–500 deliveries/month
Owner: Logistics Analyst
Participants: Logistics Analyst, Logistics Manager, VP Supply Chain
Source: workflow W2638 — Contractor Delivery On-Time Performance Measurement</bpmn:documentation>
      <bpmn:laneSet id="W2638_LaneSet3">
        <bpmn:lane id="W2638_Lane1" name="Logistics Analyst">
        <bpmn:flowNodeRef>W2638_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2638_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2638_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2638_Lane2" name="Logistics Manager">
        <bpmn:flowNodeRef>W2638_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2638_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2638_Start4" name="Monthly reporting cycle">
        <bpmn:outgoing>W2638_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2638_Task5" name="Logistics Analyst compiles contractor delivery OTIF metrics: On-Time, In-Full…">
        <bpmn:documentation>Step 1: Logistics Analyst compiles contractor delivery OTIF metrics: On-Time, In-Full, Damage-Free; calculates score per DC and contractor segment
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2638_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2638_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2638_Task6" name="Analyst identifies trends: compares vs. standard replenishment, identifies…">
        <bpmn:documentation>Step 2: Analyst identifies trends: compares vs. standard replenishment, identifies chronic late routes, analyzes root causes; produces Pareto analysis
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W2638_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2638_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2638_Task7" name="Logistics Manager reviews with VP Supply Chain: proposes corrective actions…">
        <bpmn:documentation>Step 3: Logistics Manager reviews with VP Supply Chain: proposes corrective actions, evaluates 3PL performance, sets improvement targets
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W2638_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2638_End8" name="Complete">
        <bpmn:incoming>W2638_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2638_Annotation9">
        <bpmn:text>Controls: - CTL-453 (ensure controlled execution — Job Site Delivery Performance &amp; Analytics (PA-74.3).) | - operational: Logistics Analyst sign-off on the workflow output
Owner: Logistics Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2638_Assoc10" sourceRef="W2638_Annotation9" targetRef="W2638_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2638_Flow11" sourceRef="W2638_Start4" targetRef="W2638_Task5" />
      <bpmn:sequenceFlow id="W2638_Flow12" sourceRef="W2638_Task5" targetRef="W2638_Task6" />
      <bpmn:sequenceFlow id="W2638_Flow13" sourceRef="W2638_Task6" targetRef="W2638_Task7" />
      <bpmn:sequenceFlow id="W2638_Flow14" sourceRef="W2638_Task7" targetRef="W2638_End8" />
    </bpmn:process>
