      <bpmndi:BPMNPlane id="W2639_plane" bpmnElement="W_W2639">
        <bpmndi:BPMNShape id="W2639_Lane1_di" bpmnElement="W2639_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2639_Lane2_di" bpmnElement="W2639_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
