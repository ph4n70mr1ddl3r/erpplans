    <bpmn:process id="W_W2641" name="W2641. Contractor Delivery Route Optimization Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review cycle — Contractor Delivery Route
Frequency: Quarterly
Volume: 4 DCs; ~50–100 routes
Owner: Logistics Analyst
Participants: Logistics Analyst, Logistics Manager, DC Ops
Source: workflow W2641 — Contractor Delivery Route Optimization Analytics</bpmn:documentation>
      <bpmn:laneSet id="W2641_LaneSet3">
        <bpmn:lane id="W2641_Lane1" name="Logistics Analyst">
        <bpmn:flowNodeRef>W2641_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2641_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2641_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2641_Lane2" name="Logistics Manager">
        <bpmn:flowNodeRef>W2641_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2641_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2641_Start4" name="Quarterly review cycle — Contractor Delivery Route">
        <bpmn:outgoing>W2641_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2641_Task5" name="Logistics Analyst maps all contractor routes: identifies overlapping routes…">
        <bpmn:documentation>Step 1: Logistics Analyst maps all contractor routes: identifies overlapping routes, underutilized trucks, excessive empty return miles; uses GIS analysis
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2641_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2641_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2641_Task6" name="Analyst models optimization: combine stores + contractor deliveries, dedicated…">
        <bpmn:documentation>Step 2: Analyst models optimization: combine stores + contractor deliveries, dedicated contractor delivery days, zone-based scheduling; quantifies savings
Responsible (R): Logistics Analyst
Accountable (A): Logistics Manager
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W2641_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2641_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2641_Task7" name="Logistics Manager implements optimizations: adjusts schedules, communicates to…">
        <bpmn:documentation>Step 3: Logistics Manager implements optimizations: adjusts schedules, communicates to contractors, monitors 4 weeks; reports savings quarterly
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2641_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2641_End8" name="Complete">
        <bpmn:incoming>W2641_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2641_Annotation9">
        <bpmn:text>Controls: - CTL-453 (ensure controlled execution — Job Site Delivery Performance &amp; Analytics (PA-74.3).) | - operational: Logistics Analyst sign-off on the workflow output
Owner: Logistics Analyst</bpmn:text>
