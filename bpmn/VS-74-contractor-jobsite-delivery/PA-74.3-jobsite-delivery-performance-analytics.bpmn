      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2640" name="W2640. Contractor Delivery Satisfaction Survey &amp; Feedback" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly survey cycle — Contractor Delivery Satisfaction
Frequency: Quarterly
Volume: ~5,200 trade customers
Owner: Trade Sales Manager
Participants: Trade Sales Mgr, Customer Experience, Logistics Manager
Source: workflow W2640 — Contractor Delivery Satisfaction Survey &amp; Feedback</bpmn:documentation>
      <bpmn:laneSet id="W2640_LaneSet4">
        <bpmn:lane id="W2640_Lane1" name="Customer Experience">
        <bpmn:flowNodeRef>W2640_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2640_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2640_Lane2" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2640_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2640_Lane3" name="Logistics Manager">
        <bpmn:flowNodeRef>W2640_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2640_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2640_Start5" name="Quarterly survey cycle — Contractor Delivery Satisfaction">
        <bpmn:outgoing>W2640_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2640_Task6" name="Customer Experience sends delivery satisfaction survey post-delivery…">
        <bpmn:documentation>Step 1: Customer Experience sends delivery satisfaction survey post-delivery: timeliness, driver professionalism, material condition, scheduling ease; target &gt;30% response
Responsible (R): Customer Experience
Accountable (A): COO
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2640_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2640_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2640_Task7" name="Trade Sales Manager analyzes results: scores by region, driver, DC, delivery…">
        <bpmn:documentation>Step 2: Trade Sales Manager analyzes results: scores by region, driver, DC, delivery type; identifies low areas; follows up with detractors within 48 hours
Responsible (R): Trade Sales Manager
Accountable (A): VP Merchandising
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2640_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2640_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2640_Task8" name="Logistics Manager addresses feedback: driver retraining, scheduling…">
        <bpmn:documentation>Step 3: Logistics Manager addresses feedback: driver retraining, scheduling improvements, packaging improvements; reports quarterly
Responsible (R): Logistics Manager
Accountable (A): VP Supply Chain
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2640_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2640_End9" name="Complete">
        <bpmn:incoming>W2640_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2640_Annotation10">
        <bpmn:text>Controls: - CTL-453 (ensure controlled execution — Job Site Delivery Performance &amp; Analytics (PA-74.3).) | - operational: Trade Sales Manager sign-off on the workflow output
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2640_Assoc11" sourceRef="W2640_Annotation10" targetRef="W2640_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2640_Flow12" sourceRef="W2640_Start5" targetRef="W2640_Task6" />
      <bpmn:sequenceFlow id="W2640_Flow13" sourceRef="W2640_Task6" targetRef="W2640_Task7" />
      <bpmn:sequenceFlow id="W2640_Flow14" sourceRef="W2640_Task7" targetRef="W2640_Task8" />
      <bpmn:sequenceFlow id="W2640_Flow15" sourceRef="W2640_Task8" targetRef="W2640_End9" />
    </bpmn:process>
