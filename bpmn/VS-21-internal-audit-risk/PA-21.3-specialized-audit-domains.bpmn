        <bpmndi:BPMNShape id="W335_Task9_di" bpmnElement="W335_Task9"><dc:Bounds x="1240" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W335_Task10_di" bpmnElement="W335_Task10"><dc:Bounds x="1450" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W335_Start4_di" bpmnElement="W335_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W335_End11_di" bpmnElement="W335_End11"><dc:Bounds x="1680" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W335_Annotation12_di" bpmnElement="W335_Annotation12"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W335_Flow14_di" bpmnElement="W335_Flow14"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow15_di" bpmnElement="W335_Flow15"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow16_di" bpmnElement="W335_Flow16"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow17_di" bpmnElement="W335_Flow17"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow18_di" bpmnElement="W335_Flow18"><di:waypoint x="1210" y="335" /><di:waypoint x="1240" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow19_di" bpmnElement="W335_Flow19"><di:waypoint x="1420" y="335" /><di:waypoint x="1450" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Flow20_di" bpmnElement="W335_Flow20"><di:waypoint x="1630" y="165" /><di:waypoint x="1680" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W335_Assoc13_di" bpmnElement="W335_Assoc13"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W341" name="W341. ESG Assurance &amp; Sustainability Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual reporting cycle (post-Sustainability Report draft)
Frequency: Annual
Volume: Audit of Scope 1, 2, and 3 data for 200 stores and 4 DCs
Owner: Internal Audit / ESG Lead
Participants: Sustainability Team, Finance, Maintenance, HR, Legal
Source: workflow W341 — ESG Assurance &amp; Sustainability Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W341_LaneSet3">
        <bpmn:lane id="W341_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W341_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W341_Lane2" name="Head of IA">
        <bpmn:flowNodeRef>W341_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W341_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W341_Start4" name="Annual reporting cycle (post-Sustainability Report draft)">
        <bpmn:outgoing>W341_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W341_Task5" name="Data Source Validation">
        <bpmn:documentation>Step 1: Data Source Validation: Trace GHG emission data (Scope 1 &amp; 2) back to utility bills (W7) and fuel logs (W196)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W341_Flow14</bpmn:incoming>
        <bpmn:outgoing>W341_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W341_Task6" name="Metric Calculation Review">
        <bpmn:documentation>Step 2: Metric Calculation Review: Verify that emission factors used are consistent with DOE/DENR and SEC PH guidelines
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W341_Flow15</bpmn:incoming>
        <bpmn:outgoing>W341_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W341_Task7" name="Supply Chain Disclosure Audit">
        <bpmn:documentation>Step 3: Supply Chain Disclosure Audit: Verify &quot;Sustainable Sourcing&quot; claims (W195) by sampling vendor audit reports and certifications
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W341_Flow16</bpmn:incoming>
        <bpmn:outgoing>W341_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W341_Task8" name="Social Impact Verification">
        <bpmn:documentation>Step 4: Social Impact Verification: Sample CSR spend and community development projects (W194) for evidence of completion and impact
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W341_Flow17</bpmn:incoming>
        <bpmn:outgoing>W341_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W341_Task9" name="SEC Reporting Compliance">
        <bpmn:documentation>Step 5: SEC Reporting Compliance: Review draft Sustainability Report against SEC Memo Circular No. 4 requirements
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W341_Flow18</bpmn:incoming>
        <bpmn:outgoing>W341_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W341_Task10" name="Final Assurance Memo">
        <bpmn:documentation>Step 6: Final Assurance Memo: Issue internal assurance statement to the Board Sustainability Committee
Responsible (R): Head of IA
Accountable (A): Sustainability Committee
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W341_Flow19</bpmn:incoming>
        <bpmn:outgoing>W341_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W341_End11" name="Complete">
        <bpmn:incoming>W341_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W341_Annotation12">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: Internal Audit / ESG Lead review and approval gate
Owner: Internal Audit / ESG Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W341_Assoc13" sourceRef="W341_Annotation12" targetRef="W341_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W341_Flow14" sourceRef="W341_Start4" targetRef="W341_Task5" />
      <bpmn:sequenceFlow id="W341_Flow15" sourceRef="W341_Task5" targetRef="W341_Task6" />
      <bpmn:sequenceFlow id="W341_Flow16" sourceRef="W341_Task6" targetRef="W341_Task7" />
      <bpmn:sequenceFlow id="W341_Flow17" sourceRef="W341_Task7" targetRef="W341_Task8" />
      <bpmn:sequenceFlow id="W341_Flow18" sourceRef="W341_Task8" targetRef="W341_Task9" />
      <bpmn:sequenceFlow id="W341_Flow19" sourceRef="W341_Task9" targetRef="W341_Task10" />
      <bpmn:sequenceFlow id="W341_Flow20" sourceRef="W341_Task10" targetRef="W341_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W341_diag">
      <bpmndi:BPMNPlane id="W341_plane" bpmnElement="W_W341">
        <bpmndi:BPMNShape id="W341_Lane1_di" bpmnElement="W341_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W341_Lane2_di" bpmnElement="W341_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1580" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W341_Task5_di" bpmnElement="W341_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W341_Task6_di" bpmnElement="W341_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
