    <bpmn:process id="W_W364" name="W364. Marketing Agency &amp; Media Spend Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan
Frequency: Annual
Volume: Top 5 media/creative agencies by spend
Owner: Internal Audit
Participants: Marketing Director, Procurement, Media Agencies
Source: workflow W364 — Marketing Agency &amp; Media Spend Audit</bpmn:documentation>
      <bpmn:laneSet id="W364_LaneSet3">
        <bpmn:lane id="W364_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W364_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W364_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W364_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W364_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W364_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W364_Lane2" name="IT Auditor">
        <bpmn:flowNodeRef>W364_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W364_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W364_Start4" name="Annual audit plan">
        <bpmn:outgoing>W364_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W364_Task5" name="Contract Compliance Audit">
        <bpmn:documentation>Step 1: Contract Compliance Audit: Verify agency billings match the fee structures and overhead caps in the signed contracts
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W364_Flow13</bpmn:incoming>
        <bpmn:outgoing>W364_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W364_Task6" name="Media Placement Verification">
        <bpmn:documentation>Step 2: Media Placement Verification: Sample media buy invoices (TV, Radio, Digital) and request &quot;Certificate of Performance&quot; or 3rd party logs
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W364_Flow14</bpmn:incoming>
        <bpmn:outgoing>W364_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W364_Task7" name="Production Cost Audit">
        <bpmn:documentation>Step 3: Production Cost Audit: Review &quot;out-of-pocket&quot; production expenses for campaign shoots to ensure no unauthorized markups
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W364_Flow15</bpmn:incoming>
        <bpmn:outgoing>W364_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W364_Task8" name="Digital Ad Fraud Review">
        <bpmn:documentation>Step 4: Digital Ad Fraud Review: Audit agency reports for &quot;Invalid Traffic&quot; (IVT) and bot detection in digital campaigns
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W364_Flow16</bpmn:incoming>
        <bpmn:outgoing>W364_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W364_Task9" name="Rebate &amp; Commission Audit">
        <bpmn:documentation>Step 5: Rebate &amp; Commission Audit: Verify that any volume rebates or discounts from media owners are passed back to the company
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W364_Flow17</bpmn:incoming>
        <bpmn:outgoing>W364_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W364_End10" name="Complete">
        <bpmn:incoming>W364_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W364_Annotation11">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: Internal Audit review and approval gate
Owner: Internal Audit</bpmn:text>
