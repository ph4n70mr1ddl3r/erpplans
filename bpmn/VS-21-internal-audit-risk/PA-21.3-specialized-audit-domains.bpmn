        </bpmn:lane>
        <bpmn:lane id="W353_Lane3" name="Procurement">
        <bpmn:flowNodeRef>W353_Task11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W353_End12</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W353_Start5" name="Vendor onboarding or Annual risk-based cycle">
        <bpmn:outgoing>W353_Flow15</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W353_Task6" name="Risk Profiling">
        <bpmn:documentation>Step 1: Risk Profiling: Identify high-risk vendors based on region, category (e.g., textiles, lumber), and spend
Responsible (R): Compliance
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W353_Flow15</bpmn:incoming>
        <bpmn:outgoing>W353_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W353_Task7" name="Self-Assessment">
        <bpmn:documentation>Step 2: Self-Assessment: Send Social Compliance Questionnaire to vendors
Responsible (R): Compliance
Accountable (A): Compliance
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W353_Flow16</bpmn:incoming>
        <bpmn:outgoing>W353_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W353_Task8" name="Audit Selection">
        <bpmn:documentation>Step 3: Audit Selection: Select vendors for on-site audit or request recent SMETA/BSCI reports
Responsible (R): Compliance
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W353_Flow17</bpmn:incoming>
        <bpmn:outgoing>W353_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W353_Task9" name="On-site Audit">
        <bpmn:documentation>Step 4: On-site Audit: Conduct (or shadow) audit covering labor practices, safety, and environmental impact
Responsible (R): Auditor
Accountable (A): Compliance
Duration: 2-3 days</bpmn:documentation>
        <bpmn:incoming>W353_Flow18</bpmn:incoming>
        <bpmn:outgoing>W353_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W353_Task10" name="CAP Management">
        <bpmn:documentation>Step 5: CAP Management: Issue Corrective Action Plan for findings (e.g., missing fire exits, excessive OT)
Responsible (R): Auditor
Accountable (A): Compliance
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W353_Flow19</bpmn:incoming>
        <bpmn:outgoing>W353_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W353_Task11" name="Verification">
        <bpmn:documentation>Step 6: Verification: Follow up on CAP implementation; terminate vendor if critical violations persist
Responsible (R): Procurement
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W353_Flow20</bpmn:incoming>
        <bpmn:outgoing>W353_Flow21</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W353_End12" name="Complete">
        <bpmn:incoming>W353_Flow21</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W353_Annotation13">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Compliance Officer / Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
