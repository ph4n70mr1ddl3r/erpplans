    <bpmn:process id="W_W344" name="W344. Trade Promotion, Rebate &amp; Marketing Spend Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly review of marketing spend
Frequency: Quarterly
Volume: Audit of top 10 vendor rebate agreements and top 5 marketing campaigns
Owner: Internal Audit
Participants: Merchandising, Marketing, AP, Vendor
Source: workflow W344 — Trade Promotion, Rebate &amp; Marketing Spend Audit</bpmn:documentation>
      <bpmn:laneSet id="W344_LaneSet3">
        <bpmn:lane id="W344_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W344_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W344_Lane2" name="Head of IA">
        <bpmn:flowNodeRef>W344_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W344_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W344_Start4" name="Quarterly review of marketing spend">
        <bpmn:outgoing>W344_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W344_Task5" name="Agreement Audit">
        <bpmn:documentation>Step 1: Agreement Audit: Verify existence of signed vendor rebate contracts for the period
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W344_Flow14</bpmn:incoming>
        <bpmn:outgoing>W344_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W344_Task6" name="Rebate Calculation">
        <bpmn:documentation>Step 2: Rebate Calculation: Independently calculate rebates based on purchase/sales volume from ERP
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W344_Flow15</bpmn:incoming>
        <bpmn:outgoing>W344_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W344_Task7" name="Collection Audit">
        <bpmn:documentation>Step 3: Collection Audit: Trace rebate accruals to actual collection or offsetting against AP (W100)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W344_Flow16</bpmn:incoming>
        <bpmn:outgoing>W344_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W344_Task8" name="Marketing Spend Proof">
        <bpmn:documentation>Step 4: Marketing Spend Proof: Sample &quot;Trade Spend&quot; invoices for proof of execution (e.g., photos of end-caps, print ads)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W344_Flow17</bpmn:incoming>
        <bpmn:outgoing>W344_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W344_Task9" name="Campaign ROI Audit">
        <bpmn:documentation>Step 5: Campaign ROI Audit: Verify that &quot;Bonus Buys&quot; or &quot;Bundles&quot; were correctly configured in POS
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W344_Flow18</bpmn:incoming>
        <bpmn:outgoing>W344_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W344_Task10" name="Findings Distribution">
        <bpmn:documentation>Step 6: Findings Distribution: Report leakage (unclaimed rebates) or unauthorized spend to Merchandising
Responsible (R): Head of IA
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W344_Flow19</bpmn:incoming>
        <bpmn:outgoing>W344_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W344_End11" name="Complete">
        <bpmn:incoming>W344_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W344_Annotation12">
