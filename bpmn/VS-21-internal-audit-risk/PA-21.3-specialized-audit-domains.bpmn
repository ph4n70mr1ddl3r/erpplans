    <bpmn:process id="W_W365" name="W365. Strategic Workforce Planning &amp; Succession Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual audit plan
Frequency: Annual
Volume: Top 50 &quot;Critical Roles&quot; across the enterprise
Owner: Internal Audit
Participants: CHRO, Succession Committee, Board Remuneration Committee
Source: workflow W365 — Strategic Workforce Planning &amp; Succession Audit</bpmn:documentation>
      <bpmn:laneSet id="W365_LaneSet2">
        <bpmn:lane id="W365_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W365_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W365_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W365_Start3" name="Annual audit plan">
        <bpmn:outgoing>W365_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W365_Task4" name="Criticality Audit">
        <bpmn:documentation>Step 1: Criticality Audit: Verify that the list of &quot;Critical Roles&quot; is updated and covers all key functional areas
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W365_Flow13</bpmn:incoming>
        <bpmn:outgoing>W365_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W365_Task5" name="Succession Pipeline Review">
        <bpmn:documentation>Step 2: Succession Pipeline Review: Verify that each critical role has at least two identified &quot;Ready Now&quot; or &quot;Ready 1-2 Years&quot; successors (W178)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W365_Flow14</bpmn:incoming>
        <bpmn:outgoing>W365_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W365_Task6" name="Development Plan Verification">
        <bpmn:documentation>Step 3: Development Plan Verification: Sample successors and verify that their &quot;Individual Development Plans&quot; (IDP) are being executed
Responsible (R): Auditor
Accountable (A): CHRO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W365_Flow15</bpmn:incoming>
        <bpmn:outgoing>W365_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W365_Task7" name="Retention Risk Audit">
        <bpmn:documentation>Step 4: Retention Risk Audit: Review the &quot;Flight Risk&quot; assessment for top talent and effectiveness of retention bonuses
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W365_Flow16</bpmn:incoming>
        <bpmn:outgoing>W365_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W365_Task8" name="Trainee Program ROI">
        <bpmn:documentation>Step 5: Trainee Program ROI: Audit the retention and promotion rates of the Management Trainee program (W179)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W365_Flow17</bpmn:incoming>
        <bpmn:outgoing>W365_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W365_Task9" name="Board Governance">
        <bpmn:documentation>Step 6: Board Governance: Verify that the Board is updated quarterly on the succession health of the C-Suite
Responsible (R): Auditor
Accountable (A): Board Committee
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W365_Flow18</bpmn:incoming>
        <bpmn:outgoing>W365_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W365_End10" name="Complete">
        <bpmn:incoming>W365_Flow19</bpmn:incoming>
      </bpmn:endEvent>
