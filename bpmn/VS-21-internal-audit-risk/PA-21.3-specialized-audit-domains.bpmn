      <bpmn:sequenceFlow id="W490_Flow22" sourceRef="W490_Task10" targetRef="W490_Task11" />
      <bpmn:sequenceFlow id="W490_Flow23" sourceRef="W490_Task11" targetRef="W490_Task12" />
      <bpmn:sequenceFlow id="W490_Flow24" sourceRef="W490_Task12" targetRef="W490_Task13" />
      <bpmn:sequenceFlow id="W490_Flow25" sourceRef="W490_Task13" targetRef="W490_End14" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W490_diag">
      <bpmndi:BPMNPlane id="W490_plane" bpmnElement="W_W490">
        <bpmndi:BPMNShape id="W490_Lane1_di" bpmnElement="W490_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W490_Lane2_di" bpmnElement="W490_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="2000" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W490_Lane3_di" bpmnElement="W490_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="2000" height="170" /></bpmndi:BPMNShape>
