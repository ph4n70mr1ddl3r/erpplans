    <bpmn:process id="W_W358" name="W358. Physical Security, CCTV &amp; Guard Force Audit" isExecutable="false">
      <bpmn:documentation>Trigger: High shrinkage alerts (W37) or quarterly store rotation
Frequency: Quarterly (rotational)
Volume: Covers 200 stores and 4 DCs
Owner: Internal Audit / Loss Prevention
Participants: Store Managers, Security Agencies, Facilities
Source: workflow W358 — Physical Security, CCTV &amp; Guard Force Audit</bpmn:documentation>
      <bpmn:laneSet id="W358_LaneSet3">
        <bpmn:lane id="W358_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W358_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W358_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W358_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W358_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W358_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W358_Lane2" name="IT Auditor">
        <bpmn:flowNodeRef>W358_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W358_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W358_Start4" name="High shrinkage alerts (W37) or quarterly store rotation">
        <bpmn:outgoing>W358_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W358_Task5" name="Blind Spot Analysis">
        <bpmn:documentation>Step 1: Blind Spot Analysis: Conduct physical walkthroughs to identify gaps in CCTV coverage (e.g., high-value aisles, loading docks)
Responsible (R): Auditor
Accountable (A): LP Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W358_Flow13</bpmn:incoming>
        <bpmn:outgoing>W358_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W358_Task6" name="Guard Performance Audit">
        <bpmn:documentation>Step 2: Guard Performance Audit: Review guard logs, roving reports, and response times to simulated alarms
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W358_Flow14</bpmn:incoming>
        <bpmn:outgoing>W358_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W358_Task7" name="Physical Access Test">
        <bpmn:documentation>Step 3: Physical Access Test: Verify integrity of back-of-house locks, safe combinations, and key control logs
Responsible (R): Auditor
Accountable (A): Store Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W358_Flow15</bpmn:incoming>
        <bpmn:outgoing>W358_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W358_Task8" name="Retention Audit">
        <bpmn:documentation>Step 4: Retention Audit: Verify that CCTV footage is retained for the required 30–60 day window and is searchable
Responsible (R): IT Auditor
Accountable (A): LP Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W358_Flow16</bpmn:incoming>
        <bpmn:outgoing>W358_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W358_Task9" name="Agency Compliance">
        <bpmn:documentation>Step 5: Agency Compliance: Audit the security agency&#x27;s billing vs. actual guard man-hours and license validity
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W358_Flow17</bpmn:incoming>
        <bpmn:outgoing>W358_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W358_End10" name="Complete">
        <bpmn:incoming>W358_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W358_Annotation11">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: Downtime — Non-functional cameras during critical incidents
Owner: Internal Audit / Loss Prevention</bpmn:text>
      </bpmn:textAnnotation>
