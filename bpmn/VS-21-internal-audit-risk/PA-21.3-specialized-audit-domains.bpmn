    <bpmn:process id="W_W357" name="W357. Board Governance &amp; Manual on Corporate Governance (MCG) Compliance Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Annual SEC compliance cycle
Frequency: Annual
Volume: Review of all Board and Committee meetings (Audit, Risk, Gov, Nom, Rem)
Owner: Internal Audit / Corporate Secretary
Participants: Board of Directors, Legal, CFO
Source: workflow W357 — Board Governance &amp; Manual on Corporate Governance (MCG) Compliance Audit</bpmn:documentation>
      <bpmn:laneSet id="W357_LaneSet2">
        <bpmn:lane id="W357_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W357_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W357_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W357_Start3" name="Annual SEC compliance cycle">
        <bpmn:outgoing>W357_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W357_Task4" name="Charter Review">
        <bpmn:documentation>Step 1: Charter Review: Verify that all Board Committees are operating within their approved charters
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W357_Flow12</bpmn:incoming>
        <bpmn:outgoing>W357_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W357_Task5" name="Attendance &amp; Minutes Audit">
        <bpmn:documentation>Step 2: Attendance &amp; Minutes Audit: Reconcile meeting minutes against attendance logs and verify quorum requirements
Responsible (R): Auditor
Accountable (A): Corp Sec
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W357_Flow13</bpmn:incoming>
        <bpmn:outgoing>W357_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W357_Task6" name="Evaluation Integrity">
        <bpmn:documentation>Step 3: Evaluation Integrity: Audit the process used for the annual Board Self-Assessment and Individual Director Peer Reviews
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W357_Flow14</bpmn:incoming>
        <bpmn:outgoing>W357_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W357_Task7" name="MCG Compliance">
        <bpmn:documentation>Step 4: MCG Compliance: Verify adherence to the Manual on Corporate Governance (e.g., Lead Independent Director role, training hours)
Responsible (R): Auditor
Accountable (A): VP Legal
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W357_Flow15</bpmn:incoming>
        <bpmn:outgoing>W357_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W357_Task8" name="Related Party Transaction (RPT) Review">
        <bpmn:documentation>Step 5: Related Party Transaction (RPT) Review: Audit the Board&#x27;s review and approval of material RPTs (W102)
Responsible (R): Auditor
Accountable (A): Audit Committee
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W357_Flow16</bpmn:incoming>
        <bpmn:outgoing>W357_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W357_End9" name="Complete">
        <bpmn:incoming>W357_Flow17</bpmn:incoming>
      </bpmn:endEvent>
