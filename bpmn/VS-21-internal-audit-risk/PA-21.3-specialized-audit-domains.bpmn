<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-21.3-specialized-audit-domains" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W335" name="W335. Major Capex &amp; Post-Implementation Project Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Completion of a major capital project (e.g., new DC, ERP implementation)
Frequency: Post-project (Ad-hoc)
Volume: 2-4 major project audits per year
Owner: Internal Audit
Participants: Project Management Office (PMO), Finance, Business Owners
Source: workflow W335 — Major Capex &amp; Post-Implementation Project Audit</bpmn:documentation>
      <bpmn:laneSet id="W335_LaneSet3">
        <bpmn:lane id="W335_Lane1" name="Head of IA">
        <bpmn:flowNodeRef>W335_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W335_Lane2" name="Audit Team">
        <bpmn:flowNodeRef>W335_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W335_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W335_Start4" name="Completion of a major capital project (e.g., new DC, ERP implementation)">
        <bpmn:outgoing>W335_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W335_Task5" name="Select major projects completed in the last 6-12 months for post-implementation…">
        <bpmn:documentation>Step 1: Select major projects completed in the last 6-12 months for post-implementation review (PIR)
Responsible (R): Head of IA
Accountable (A): Audit Committee
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W335_Flow14</bpmn:incoming>
        <bpmn:outgoing>W335_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W335_Task6" name="Compare actual project spend against approved Capex budget (W21)">
        <bpmn:documentation>Step 2: Compare actual project spend against approved Capex budget (W21)
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W335_Flow15</bpmn:incoming>
        <bpmn:outgoing>W335_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W335_Task7" name="Evaluate project deliverables against original business case and ROI projections">
        <bpmn:documentation>Step 3: Evaluate project deliverables against original business case and ROI projections
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W335_Flow16</bpmn:incoming>
        <bpmn:outgoing>W335_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W335_Task8" name="Assess project governance, change management effectiveness, and vendor contract…">
        <bpmn:documentation>Step 4: Assess project governance, change management effectiveness, and vendor contract adherence
Responsible (R): Audit Team
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W335_Flow17</bpmn:incoming>
        <bpmn:outgoing>W335_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W335_Task9" name="Document lessons learned and root causes for budget/timeline overruns">
        <bpmn:documentation>Step 5: Document lessons learned and root causes for budget/timeline overruns
Responsible (R): Audit Team
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W335_Flow18</bpmn:incoming>
        <bpmn:outgoing>W335_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W335_Task10" name="Issue PIR report to Executive Team and Audit Committee">
        <bpmn:documentation>Step 6: Issue PIR report to Executive Team and Audit Committee
Responsible (R): Head of IA
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W335_Flow19</bpmn:incoming>
        <bpmn:outgoing>W335_Flow20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W335_End11" name="Complete">
        <bpmn:incoming>W335_Flow20</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W335_Annotation12">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: Internal Audit review and approval gate
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W335_Assoc13" sourceRef="W335_Annotation12" targetRef="W335_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W335_Flow14" sourceRef="W335_Start4" targetRef="W335_Task5" />
      <bpmn:sequenceFlow id="W335_Flow15" sourceRef="W335_Task5" targetRef="W335_Task6" />
      <bpmn:sequenceFlow id="W335_Flow16" sourceRef="W335_Task6" targetRef="W335_Task7" />
      <bpmn:sequenceFlow id="W335_Flow17" sourceRef="W335_Task7" targetRef="W335_Task8" />
      <bpmn:sequenceFlow id="W335_Flow18" sourceRef="W335_Task8" targetRef="W335_Task9" />
      <bpmn:sequenceFlow id="W335_Flow19" sourceRef="W335_Task9" targetRef="W335_Task10" />
      <bpmn:sequenceFlow id="W335_Flow20" sourceRef="W335_Task10" targetRef="W335_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W335_diag">
      <bpmndi:BPMNPlane id="W335_plane" bpmnElement="W_W335">
        <bpmndi:BPMNShape id="W335_Lane1_di" bpmnElement="W335_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1580" height="170" /></bpmndi:BPMNShape>
