    <bpmn:process id="W_W346" name="W346. Capex Construction &amp; Store Build-out Audit" isExecutable="false">
      <bpmn:documentation>Trigger: High-value store opening (W16) or major renovation
Frequency: Per project (ad-hoc)
Volume: 2–3 store construction audits per year
Owner: Internal Audit
Participants: Engineering, Procurement, Project Management (EPM), Contractor
Source: workflow W346 — Capex Construction &amp; Store Build-out Audit</bpmn:documentation>
      <bpmn:laneSet id="W346_LaneSet2">
        <bpmn:lane id="W346_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W346_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W346_Task5</bpmn:flowNodeRef>
