        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W346_Start3" name="High-value store opening (W16) or major renovation">
        <bpmn:outgoing>W346_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W346_Task4" name="Bidding Audit">
        <bpmn:documentation>Step 1: Bidding Audit: Verify that the contractor selection process complied with Procurement SOP (W2)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W346_Flow13</bpmn:incoming>
        <bpmn:outgoing>W346_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W346_Task5" name="Progress Billing Audit">
        <bpmn:documentation>Step 2: Progress Billing Audit: Match contractor billings against actual project milestones and site inspection reports
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W346_Flow14</bpmn:incoming>
        <bpmn:outgoing>W346_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W346_Task6" name="Change Order Review">
        <bpmn:documentation>Step 3: Change Order Review: Audit &quot;Change Orders&quot; for validity and proper authorization (avoiding &quot;scope creep&quot;)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W346_Flow15</bpmn:incoming>
        <bpmn:outgoing>W346_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W346_Task7" name="Material Usage Verification">
        <bpmn:documentation>Step 4: Material Usage Verification: Sample high-value materials (e.g., HVAC units, tiles) to ensure spec compliance
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W346_Flow16</bpmn:incoming>
        <bpmn:outgoing>W346_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W346_Task8" name="Retention Audit">
        <bpmn:documentation>Step 5: Retention Audit: Verify that &quot;Retention&quot; amounts are withheld and only released after defect liability period
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W346_Flow17</bpmn:incoming>
        <bpmn:outgoing>W346_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W346_Task9" name="Final Account Reconciliation">
        <bpmn:documentation>Step 6: Final Account Reconciliation: Reconcile final project cost vs. approved budget and EPM records (W128)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W346_Flow18</bpmn:incoming>
        <bpmn:outgoing>W346_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W346_End10" name="Complete">
        <bpmn:incoming>W346_Flow19</bpmn:incoming>
      </bpmn:endEvent>
