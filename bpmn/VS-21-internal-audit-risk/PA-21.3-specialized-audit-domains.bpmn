    <bpmn:process id="W_W348" name="W348. Revenue Assurance &amp; Payment Gateway Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial close
Frequency: Monthly
Volume: ~P5B+ monthly revenue across all channels
Owner: Revenue Assurance Lead / Internal Audit
Participants: Finance (Treasury), IT (POS Support), Sales Ops
Source: workflow W348 — Revenue Assurance &amp; Payment Gateway Audit</bpmn:documentation>
      <bpmn:laneSet id="W348_LaneSet3">
        <bpmn:lane id="W348_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W348_Task5</bpmn:flowNodeRef>
