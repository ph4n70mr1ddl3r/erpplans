        <bpmn:flowNodeRef>W348_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W348_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W348_Start4" name="Monthly financial close">
        <bpmn:outgoing>W348_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W348_Task5" name="Sales-to-Cash Reconciliation">
        <bpmn:documentation>Step 1: Sales-to-Cash Reconciliation: Reconcile POS Gross Sales to Bank Statement deposits (W215)
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W348_Flow13</bpmn:incoming>
        <bpmn:outgoing>W348_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W348_Task6" name="Fee Audit">
        <bpmn:documentation>Step 2: Fee Audit: Verify MDR (Merchant Discount Rate) deductions for Credit Card and E-Wallets
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W348_Flow14</bpmn:incoming>
        <bpmn:outgoing>W348_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W348_Task7" name="Override Review">
        <bpmn:documentation>Step 3: Override Review: Audit &quot;Sale-No-Stock&quot; and manual price overrides for potential collusion
Responsible (R): Auditor
Accountable (A): Senior Auditor
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W348_Flow15</bpmn:incoming>
        <bpmn:outgoing>W348_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W348_Task8" name="Loyalty/Gift Card Audit">
        <bpmn:documentation>Step 4: Loyalty/Gift Card Audit: Verify integrity of point issuance and gift card redemption (W112)
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W348_Flow16</bpmn:incoming>
        <bpmn:outgoing>W348_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W348_Task9" name="Data Integrity Test">
        <bpmn:documentation>Step 5: Data Integrity Test: Trace end-to-end data flow from POS transaction to ERP GL entry
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W348_Flow17</bpmn:incoming>
        <bpmn:outgoing>W348_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W348_End10" name="Complete">
        <bpmn:incoming>W348_Flow18</bpmn:incoming>
      </bpmn:endEvent>
