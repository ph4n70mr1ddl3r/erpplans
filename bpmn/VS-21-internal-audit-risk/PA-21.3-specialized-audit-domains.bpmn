    <bpmn:process id="W_W359" name="W359. AI Governance, Algorithmic Bias &amp; Data Ethics Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Deployment of new AI/ML models or annual review
Frequency: Annual
Volume: Focus on high-impact models (Pricing, Recruitment, Credit Scoring)
Owner: IT Auditor / Data Privacy Officer (DPO)
Participants: Data Science Team, IT, HR, Marketing
Source: workflow W359 — AI Governance, Algorithmic Bias &amp; Data Ethics Audit</bpmn:documentation>
      <bpmn:laneSet id="W359_LaneSet4">
        <bpmn:lane id="W359_Lane1" name="IT Auditor">
        <bpmn:flowNodeRef>W359_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W359_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W359_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W359_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W359_Lane2" name="Data Analyst">
        <bpmn:flowNodeRef>W359_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W359_Lane3" name="DPO">
        <bpmn:flowNodeRef>W359_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W359_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W359_Start5" name="Deployment of new AI/ML models or annual review">
        <bpmn:outgoing>W359_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W359_Task6" name="Model Inventory">
        <bpmn:documentation>Step 1: Model Inventory: Maintain an audit of all AI/ML models used in production and their data sources
Responsible (R): IT Auditor
Accountable (A): CIO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W359_Flow14</bpmn:incoming>
        <bpmn:outgoing>W359_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W359_Task7" name="Bias Testing">
        <bpmn:documentation>Step 2: Bias Testing: Audit model outputs for discriminatory bias (e.g., gender/age bias in hiring or credit models)
Responsible (R): Data Analyst
Accountable (A): IT Auditor
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W359_Flow15</bpmn:incoming>
        <bpmn:outgoing>W359_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W359_Task8" name="Explainability Audit">
        <bpmn:documentation>Step 3: Explainability Audit: Verify that &quot;Black Box&quot; models have documentation explaining the key features driving decisions
Responsible (R): IT Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W359_Flow16</bpmn:incoming>
        <bpmn:outgoing>W359_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W359_Task9" name="Data Ethics Review">
        <bpmn:documentation>Step 4: Data Ethics Review: Audit the source of training data for PII compliance and &quot;right to be forgotten&quot; adherence
Responsible (R): DPO
Accountable (A): IT Auditor
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W359_Flow17</bpmn:incoming>
        <bpmn:outgoing>W359_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W359_Task10" name="Human-in-the-loop (HITL)">
        <bpmn:documentation>Step 5: Human-in-the-loop (HITL): Verify that high-impact automated decisions have a manual override/review process
Responsible (R): IT Auditor
Accountable (A): DPO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W359_Flow18</bpmn:incoming>
        <bpmn:outgoing>W359_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W359_End11" name="Complete">
        <bpmn:incoming>W359_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W359_Annotation12">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: IT Auditor / Data Privacy Officer (DPO) review and approval gate
Owner: IT Auditor / Data Privacy Officer (DPO)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W359_Assoc13" sourceRef="W359_Annotation12" targetRef="W359_Start5" associationDirection="None" />
