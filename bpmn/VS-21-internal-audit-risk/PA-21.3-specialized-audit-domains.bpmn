    <bpmn:process id="W_W360" name="W360. Crisis Response &amp; Incident Management Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Post-incident (Major Typhoon, Cyber Attack, Public Relations Crisis)
Frequency: Ad-hoc (Post-Event)
Volume: Covers all major business disruptions
Owner: Internal Audit
Participants: Crisis Management Team (CMT), Executive Leadership, PR/Comms
Source: workflow W360 — Crisis Response &amp; Incident Management Audit</bpmn:documentation>
      <bpmn:laneSet id="W360_LaneSet2">
        <bpmn:lane id="W360_Lane1" name="Auditor">
        <bpmn:flowNodeRef>W360_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W360_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W360_Start3" name="Post-incident (Major Typhoon, Cyber Attack, Public Relations Crisis)">
        <bpmn:outgoing>W360_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W360_Task4" name="Timeline Reconstruction">
        <bpmn:documentation>Step 1: Timeline Reconstruction: Audit the &quot;Golden Hour&quot; response—time from incident detection to CMT activation
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W360_Flow13</bpmn:incoming>
        <bpmn:outgoing>W360_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W360_Task5" name="Decision Log Audit">
        <bpmn:documentation>Step 2: Decision Log Audit: Review the crisis decision log for clarity, authorization, and rationale
Responsible (R): Auditor
Accountable (A): CEO
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W360_Flow14</bpmn:incoming>
        <bpmn:outgoing>W360_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W360_Task6" name="Communication Review">
        <bpmn:documentation>Step 3: Communication Review: Audit the accuracy and timeliness of internal and external communications vs. the PR plan
Responsible (R): Auditor
Accountable (A): PR Head
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W360_Flow15</bpmn:incoming>
        <bpmn:outgoing>W360_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W360_Task7" name="Resource Allocation Audit">
        <bpmn:documentation>Step 4: Resource Allocation Audit: Verify that emergency funds and resources were deployed as authorized
Responsible (R): Auditor
Accountable (A): CFO
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W360_Flow16</bpmn:incoming>
        <bpmn:outgoing>W360_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W360_Task8" name="Gap Analysis (Plan vs. Reality)">
        <bpmn:documentation>Step 5: Gap Analysis (Plan vs. Reality): Compare the actual response against the BC/DR plans (W55/W350) and identify failures
Responsible (R): Auditor
Accountable (A): Head of IA
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W360_Flow17</bpmn:incoming>
        <bpmn:outgoing>W360_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W360_Task9" name="Lessons Learned Integration">
        <bpmn:documentation>Step 6: Lessons Learned Integration: Verify that incident findings are incorporated into updated plans and training
Responsible (R): Auditor
Accountable (A): CMT Lead
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W360_Flow18</bpmn:incoming>
        <bpmn:outgoing>W360_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W360_End10" name="Complete">
        <bpmn:incoming>W360_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W360_Annotation11">
        <bpmn:text>Controls: - CTL-306 (ensure controlled execution — Specialized Audit Domains (PA-21.3).) | - operational: Internal Audit review and approval gate
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W360_Assoc12" sourceRef="W360_Annotation11" targetRef="W360_Start3" associationDirection="None" />
