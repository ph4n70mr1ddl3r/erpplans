    <bpmn:process id="W_W1794" name="W1794. Rebate Accrual-to-Settlement Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Quarter-end and year-end financial close
Frequency: Quarterly; comprehensive at year-end
Volume: ~100–200 active rebate agreements
Owner: AP Manager
Participants: AP Manager, Accounting Manager, External Auditor
Source: workflow W1794 — Rebate Accrual-to-Settlement Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1794_LaneSet4">
        <bpmn:lane id="W1794_Lane1" name="AP Manager">
        <bpmn:flowNodeRef>W1794_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1794_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1794_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1794_Lane2" name="External Auditor">
        <bpmn:flowNodeRef>W1794_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1794_Lane3" name="Accounting Manager">
        <bpmn:flowNodeRef>W1794_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1794_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1794_Start5" name="Quarter-end and year-end financial close">
        <bpmn:outgoing>W1794_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1794_Task6" name="Quarterly: AP Manager reconciles rebate accruals to actual settlements: (a)…">
        <bpmn:documentation>Step 1: Quarterly: AP Manager reconciles rebate accruals to actual settlements: (a) total accrued per agreement YTD, (b) total claimed YTD, (c) total received (credit notes + cash) YTD, (d) accrual variance: accrued − received = still pending or overstated, (e) aging of claimed but not received: &lt; 60 days (normal), 60–90 days (follow-up needed), &gt; 90 days (risk of non-collection — consider reversal)
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1794_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1794_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1794_Task7" name="Year-end: comprehensive reconciliation required for external audit: (a) all…">
        <bpmn:documentation>Step 2: Year-end: comprehensive reconciliation required for external audit: (a) all rebate agreements reviewed, (b) accrual vs. settlement variance explained per agreement, (c) overstated accruals reversed (reduce rebate income), (d) understated accruals increased (additional rebate income), (e) rebates claimed but not yet received at year-end: assessed for collectibility (vendor financial health, dispute status)
Responsible (R): AP Manager / Accounting Manager
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1794_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1794_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1794_Task8" name="External auditor reviews: (a) sample of rebate agreements: verify terms…">
        <bpmn:documentation>Step 3: External auditor reviews: (a) sample of rebate agreements: verify terms, accrual calculation, claim documentation, settlement evidence, (b) test rebate income recognition per PFRS (reliable measurement, probable economic benefit), (c) assess accrual estimation methodology and accuracy
Responsible (R): External Auditor
Accountable (A): CFO
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1794_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1794_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1794_Task9" name="Adjustments posted based on reconciliation; final rebate income recognized in…">
        <bpmn:documentation>Step 4: Adjustments posted based on reconciliation; final rebate income recognized in financial statements
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: At year-end close</bpmn:documentation>
        <bpmn:incoming>W1794_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1794_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1794_End10" name="Complete">
        <bpmn:incoming>W1794_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1794_Annotation11">
        <bpmn:text>Controls: - CTL-358 (ensure controlled execution — Rebate Agreement &amp; Accrual Management (PA-39.1).) | - operational: AP Manager review and approval gate; periodic reconciliation against source documents
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1794_Assoc12" sourceRef="W1794_Annotation11" targetRef="W1794_Start5" associationDirection="None" />
