    <bpmn:process id="W_W1788" name="W1788. Rebate Accrual Estimation &amp; Monthly Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close (Day 1 of following month)
Frequency: Monthly
Volume: ~100–200 rebate agreements accrued
Owner: AP Manager
Participants: AP Manager, Accounting Manager, VP Merchandising
Source: workflow W1788 — Rebate Accrual Estimation &amp; Monthly Posting</bpmn:documentation>
      <bpmn:laneSet id="W1788_LaneSet3">
        <bpmn:lane id="W1788_Lane1" name="System">
        <bpmn:flowNodeRef>W1788_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1788_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1788_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1788_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1788_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1788_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1788_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1788_Start4" name="Month-end close (Day 1 of following month)">
        <bpmn:outgoing>W1788_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1788_Task5" name="System calculates estimated rebate accrual per active agreement: (a) volume…">
        <bpmn:documentation>Step 1: System calculates estimated rebate accrual per active agreement: (a) volume rebate: YTD purchases × applicable rebate % (considering tier thresholds already reached), (b) growth rebate: estimated based on YTD actual purchases and projected full-year growth rate, (c) quarterly rebate: QTD purchases × applicable rate, (d) accrual = estimated full-year/quarterly rebate − previously accrued amount
Responsible (R): System
Accountable (A): AP Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1788_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1788_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1788_Task6" name="AP Manager reviews accrual calculations: (a) verify purchase volumes match AP…">
        <bpmn:documentation>Step 2: AP Manager reviews accrual calculations: (a) verify purchase volumes match AP records (invoices paid to vendor), (b) check tier threshold calculations (is the vendor on track to hit threshold?), (c) compare accrual rate to historical claim rate (some vendors have 80–90% claim rate vs. 100% accrued; adjust accrual if consistently over/under-claimed), (d) flag agreements where vendor is significantly below volume threshold (reduce accrual accordingly)
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: 2–4 hours/month</bpmn:documentation>
        <bpmn:incoming>W1788_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1788_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1788_Task7" name="Journal entry posted: (a) debit: accrued rebate receivable (asset), (b) credit…">
        <bpmn:documentation>Step 3: Journal entry posted: (a) debit: accrued rebate receivable (asset), (b) credit: rebate income (contra-COGS — reduces cost of goods sold), (c) posted per vendor agreement, (d) entity-specific posting for 5-entity structure
Responsible (R): AP Manager / System
Accountable (A): Accounting Manager
Duration: Automated after review</bpmn:documentation>
        <bpmn:incoming>W1788_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1788_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1788_Task8" name="Monthly: AP Manager prepares rebate accrual summary for Accounting Manager…">
        <bpmn:documentation>Step 4: Monthly: AP Manager prepares rebate accrual summary for Accounting Manager: total accrual by vendor, by category, by rebate type; YTD accrual vs. YTD claims received; projected annual rebate income
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1788_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1788_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1788_End9" name="Complete">
        <bpmn:incoming>W1788_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1788_Annotation10">
        <bpmn:text>Controls: - CTL-209 (ensure vendor rebate accuracy &amp; recognition.) | - operational: AP Manager review and approval gate
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1788_Assoc11" sourceRef="W1788_Annotation10" targetRef="W1788_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1788_Flow12" sourceRef="W1788_Start4" targetRef="W1788_Task5" />
      <bpmn:sequenceFlow id="W1788_Flow13" sourceRef="W1788_Task5" targetRef="W1788_Task6" />
      <bpmn:sequenceFlow id="W1788_Flow14" sourceRef="W1788_Task6" targetRef="W1788_Task7" />
      <bpmn:sequenceFlow id="W1788_Flow15" sourceRef="W1788_Task7" targetRef="W1788_Task8" />
      <bpmn:sequenceFlow id="W1788_Flow16" sourceRef="W1788_Task8" targetRef="W1788_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1788_diag">
      <bpmndi:BPMNPlane id="W1788_plane" bpmnElement="W_W1788">
        <bpmndi:BPMNShape id="W1788_Lane1_di" bpmnElement="W1788_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Lane2_di" bpmnElement="W1788_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Task5_di" bpmnElement="W1788_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Task6_di" bpmnElement="W1788_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Task7_di" bpmnElement="W1788_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Task8_di" bpmnElement="W1788_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Start4_di" bpmnElement="W1788_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_End9_di" bpmnElement="W1788_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1788_Annotation10_di" bpmnElement="W1788_Annotation10"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1788_Flow12_di" bpmnElement="W1788_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1788_Flow13_di" bpmnElement="W1788_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1788_Flow14_di" bpmnElement="W1788_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1788_Flow15_di" bpmnElement="W1788_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1788_Flow16_di" bpmnElement="W1788_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1788_Assoc11_di" bpmnElement="W1788_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1789" name="W1789. Volume-Based Rebate Tracking &amp; Threshold Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly purchase volume update
Frequency: Monthly review
Volume: ~200 vendors with volume thresholds
Owner: Category Manager
Participants: Category Managers, Buyers, VP Merchandising
Source: workflow W1789 — Volume-Based Rebate Tracking &amp; Threshold Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1789_LaneSet3">
        <bpmn:lane id="W1789_Lane1" name="System">
        <bpmn:flowNodeRef>W1789_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1789_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1789_Lane2" name="Category Manager">
        <bpmn:flowNodeRef>W1789_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1789_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1789_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1789_Start4" name="Monthly purchase volume update">
        <bpmn:outgoing>W1789_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1789_Task5" name="System tracks YTD purchase volume per vendor against agreement thresholds: (a)…">
        <bpmn:documentation>Step 1: System tracks YTD purchase volume per vendor against agreement thresholds: (a) display: vendor name, YTD purchases, threshold, gap to threshold, projected year-end purchases (based on run rate), (b) color coding: green (above threshold), yellow (80–100% of threshold), red (&lt; 80% with time running out), (c) auto-notification to Category Manager when vendor crosses threshold
Responsible (R): System
Accountable (A): Category Manager
Duration: Automated dashboard</bpmn:documentation>
        <bpmn:incoming>W1789_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1789_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1789_Task6" name="Category Manager reviews monthly: (a) vendors approaching threshold — can we…">
        <bpmn:documentation>Step 2: Category Manager reviews monthly: (a) vendors approaching threshold — can we push additional purchases to reach threshold (and earn rebate)? (b) vendors above threshold — is incremental volume pushing to next tier? (c) vendors below threshold — should we shift purchases to other vendors with better rebate terms?
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1789_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1789_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1789_Task7" name="For vendors approaching year-end below threshold: (a) Category Manager assesses…">
        <bpmn:documentation>Step 3: For vendors approaching year-end below threshold: (a) Category Manager assesses if consolidation of orders to push vendor over threshold is economically justified (cost of additional purchases vs. rebate income), (b) if not justified: let threshold miss occur; adjust accrual down, (c) if justified: place additional orders before year-end
Responsible (R): Category Manager / Buyer
Accountable (A): VP Merchandising
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1789_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1789_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1789_End8" name="Complete">
        <bpmn:incoming>W1789_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1789_Annotation9">
        <bpmn:text>Controls: - CTL-209 (ensure vendor rebate accuracy &amp; recognition.) | - operational: Category Manager review and approval gate
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1789_Assoc10" sourceRef="W1789_Annotation9" targetRef="W1789_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1789_Flow11" sourceRef="W1789_Start4" targetRef="W1789_Task5" />
      <bpmn:sequenceFlow id="W1789_Flow12" sourceRef="W1789_Task5" targetRef="W1789_Task6" />
      <bpmn:sequenceFlow id="W1789_Flow13" sourceRef="W1789_Task6" targetRef="W1789_Task7" />
      <bpmn:sequenceFlow id="W1789_Flow14" sourceRef="W1789_Task7" targetRef="W1789_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1789_diag">
      <bpmndi:BPMNPlane id="W1789_plane" bpmnElement="W_W1789">
        <bpmndi:BPMNShape id="W1789_Lane1_di" bpmnElement="W1789_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Lane2_di" bpmnElement="W1789_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Task5_di" bpmnElement="W1789_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Task6_di" bpmnElement="W1789_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Task7_di" bpmnElement="W1789_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Start4_di" bpmnElement="W1789_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_End8_di" bpmnElement="W1789_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1789_Annotation9_di" bpmnElement="W1789_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
