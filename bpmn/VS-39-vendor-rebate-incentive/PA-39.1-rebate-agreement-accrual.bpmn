<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-39.1-rebate-agreement-accrual" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1787" name="W1787. Vendor Rebate Agreement Negotiation &amp; Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor negotiation cycle; new vendor onboarding; contract renewal
Frequency: ~100–200 rebate agreements maintained; ~30–50 new/renewed per year
Volume: ~800–1,000 active vendors; ~15–25% have some form of rebate/incentive agreement (~100–200 agreements per this register)
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, Buyers, CFO, VP Supply Chain
Source: workflow W1787 — Vendor Rebate Agreement Negotiation &amp; Setup</bpmn:documentation>
      <bpmn:laneSet id="W1787_LaneSet4">
        <bpmn:lane id="W1787_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W1787_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1787_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1787_Lane2" name="Buyer">
        <bpmn:flowNodeRef>W1787_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1787_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1787_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1787_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1787_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1787_Start5" name="Annual vendor negotiation cycle; new vendor onboarding; contract renewal">
        <bpmn:outgoing>W1787_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1787_Task6" name="volume rebate">
        <bpmn:documentation>Step 1: Rebate agreement types negotiated with vendors: (a) volume rebate: % rebate on total purchases once annual volume threshold met (e.g., 2% rebate on all purchases after PHP 50M annual spend), (b) growth rebate: additional % rebate for year-over-year purchase growth (e.g., 1% additional if purchases grow &gt; 10%), (c) listing/introductory rebate: flat payment or % rebate for agreeing to stock new products, (d) quarterly performance rebate: % rebate on quarterly purchases if targets met, (e) category exclusivity rebate: premium rebate for giving vendor dominant shelf space, (f) new store opening rebate: contribution from vendor toward new store setup costs
Responsible (R): Category Managers / Buyers
Accountable (A): VP Merchandising
Duration: Per negotiation</bpmn:documentation>
        <bpmn:incoming>W1787_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1787_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1787_Task7" name="System setup of rebate agreement: (a) vendor number, agreement ID, effective…">
        <bpmn:documentation>Step 2: System setup of rebate agreement: (a) vendor number, agreement ID, effective dates, (b) rebate type and calculation method (% of purchases, fixed amount per unit, flat amount), (c) volume thresholds and tier structure, (d) eligible products (all purchases, specific categories, specific SKUs), (e) accrual basis: purchase-based or sales-based, (f) claim frequency (monthly, quarterly, annual), (g) required documentation for claim, (h) settlement method (credit note, cash payment, offset against AP)
Responsible (R): Buyer / System
Accountable (A): VP Merchandising
Duration: 30 min/agreement</bpmn:documentation>
        <bpmn:incoming>W1787_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1787_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1787_Task8" name="CFO reviews rebate terms for margin impact: (a) project annual rebate income…">
        <bpmn:documentation>Step 3: CFO reviews rebate terms for margin impact: (a) project annual rebate income per agreement, (b) assess impact on vendor gross margin, (c) verify accrual methodology is consistent with PFRS, (d) approve agreements with total annual rebate value &gt; PHP 5M
Responsible (R): CFO
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1787_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1787_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1787_Task9" name="Agreement stored in vendor contract management system; key terms communicated…">
        <bpmn:documentation>Step 4: Agreement stored in vendor contract management system; key terms communicated to AP team for accrual and claim processing
Responsible (R): Buyer / AP
Accountable (A): VP Merchandising
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1787_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1787_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1787_End10" name="Complete">
        <bpmn:incoming>W1787_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1787_Annotation11">
        <bpmn:text>Controls: - CTL-209 (ensure vendor rebate accuracy &amp; recognition.) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1787_Assoc12" sourceRef="W1787_Annotation11" targetRef="W1787_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1787_Flow13" sourceRef="W1787_Start5" targetRef="W1787_Task6" />
      <bpmn:sequenceFlow id="W1787_Flow14" sourceRef="W1787_Task6" targetRef="W1787_Task7" />
      <bpmn:sequenceFlow id="W1787_Flow15" sourceRef="W1787_Task7" targetRef="W1787_Task8" />
      <bpmn:sequenceFlow id="W1787_Flow16" sourceRef="W1787_Task8" targetRef="W1787_Task9" />
      <bpmn:sequenceFlow id="W1787_Flow17" sourceRef="W1787_Task9" targetRef="W1787_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1787_diag">
      <bpmndi:BPMNPlane id="W1787_plane" bpmnElement="W_W1787">
        <bpmndi:BPMNShape id="W1787_Lane1_di" bpmnElement="W1787_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
