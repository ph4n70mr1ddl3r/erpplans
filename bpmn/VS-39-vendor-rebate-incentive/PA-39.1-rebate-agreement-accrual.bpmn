    <bpmn:process id="W_W1793" name="W1793. Rebate Claim Submission &amp; Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Rebate claim period end (monthly, quarterly, or annual per agreement)
Frequency: ~50–100 claims submitted/quarter
Volume: ~200–400 claims/year
Owner: AP Manager
Participants: AP Manager, Category Manager, Vendor
Source: workflow W1793 — Rebate Claim Submission &amp; Verification</bpmn:documentation>
      <bpmn:laneSet id="W1793_LaneSet3">
        <bpmn:lane id="W1793_Lane1" name="System">
        <bpmn:flowNodeRef>W1793_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1793_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1793_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1793_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1793_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1793_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1793_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1793_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1793_Start4" name="Rebate claim period end (monthly, quarterly, or annual per agreement)">
        <bpmn:outgoing>W1793_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1793_Task5" name="System generates rebate claim worksheet per vendor per period: (a) eligible…">
        <bpmn:documentation>Step 1: System generates rebate claim worksheet per vendor per period: (a) eligible purchase volume (invoices paid during claim period), (b) applicable rebate rate per agreement tier, (c) calculated rebate amount, (d) supporting documentation: invoice list, proof of payment
Responsible (R): System
Accountable (A): AP Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1793_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1793_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1793_Task6" name="AP Manager reviews and validates claim: (a) verify purchase volumes match AP…">
        <bpmn:documentation>Step 2: AP Manager reviews and validates claim: (a) verify purchase volumes match AP records, (b) confirm rebate calculation per agreement terms (tier, rate, eligible products), (c) cross-check with Category Manager for any disputed purchases or returns, (d) attach supporting documentation
Responsible (R): AP Manager
Accountable (A): Category Manager
Duration: 1–2 days/claim batch</bpmn:documentation>
        <bpmn:incoming>W1793_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1793_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1793_Task7" name="Claim submitted to vendor: (a) via vendor portal (preferred — direct…">
        <bpmn:documentation>Step 3: Claim submitted to vendor: (a) via vendor portal (preferred — direct system-to-system), (b) via email with supporting documentation, (c) vendor reviews and validates claim (typically 30–60 days), (d) vendor issues credit note or payment
Responsible (R): AP Manager
Accountable (A): —
Duration: 1 day submission</bpmn:documentation>
        <bpmn:incoming>W1793_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1793_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1793_Task8" name="Claim follow-up: AP Manager tracks submitted claims; if vendor does not respond…">
        <bpmn:documentation>Step 4: Claim follow-up: AP Manager tracks submitted claims; if vendor does not respond within 60 days: escalate to Category Manager for vendor relationship follow-up; unclaimed rebates reversed from accrual after 90 days
Responsible (R): AP Manager
Accountable (A): Category Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W1793_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1793_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1793_Task9" name="Settlement received: (a) credit note: applied to vendor AP balance (reduces…">
        <bpmn:documentation>Step 5: Settlement received: (a) credit note: applied to vendor AP balance (reduces next payment), (b) cash payment: received in bank account, (c) system matches settlement to claim; accrual reversed; any variance between accrued and settled amount recorded as adjustment
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: Per settlement</bpmn:documentation>
        <bpmn:incoming>W1793_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1793_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1793_End10" name="Complete">
        <bpmn:incoming>W1793_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1793_Annotation11">
        <bpmn:text>Controls: - CTL-358 (ensure controlled execution — Rebate Agreement &amp; Accrual Management (PA-39.1).) | - operational: AP Manager review and approval gate
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1793_Assoc12" sourceRef="W1793_Annotation11" targetRef="W1793_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1793_Flow13" sourceRef="W1793_Start4" targetRef="W1793_Task5" />
      <bpmn:sequenceFlow id="W1793_Flow14" sourceRef="W1793_Task5" targetRef="W1793_Task6" />
      <bpmn:sequenceFlow id="W1793_Flow15" sourceRef="W1793_Task6" targetRef="W1793_Task7" />
      <bpmn:sequenceFlow id="W1793_Flow16" sourceRef="W1793_Task7" targetRef="W1793_Task8" />
      <bpmn:sequenceFlow id="W1793_Flow17" sourceRef="W1793_Task8" targetRef="W1793_Task9" />
      <bpmn:sequenceFlow id="W1793_Flow18" sourceRef="W1793_Task9" targetRef="W1793_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1793_diag">
      <bpmndi:BPMNPlane id="W1793_plane" bpmnElement="W_W1793">
        <bpmndi:BPMNShape id="W1793_Lane1_di" bpmnElement="W1793_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
