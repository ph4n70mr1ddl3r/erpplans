      <bpmn:sequenceFlow id="W1792_Flow18" sourceRef="W1792_Task10" targetRef="W1792_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1792_diag">
      <bpmndi:BPMNPlane id="W1792_plane" bpmnElement="W_W1792">
        <bpmndi:BPMNShape id="W1792_Lane1_di" bpmnElement="W1792_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1792_Lane2_di" bpmnElement="W1792_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1792_Lane3_di" bpmnElement="W1792_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1792_Lane4_di" bpmnElement="W1792_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1792_Task7_di" bpmnElement="W1792_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
