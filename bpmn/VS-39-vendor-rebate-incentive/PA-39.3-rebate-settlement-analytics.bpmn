    <bpmn:process id="W_W1808" name="W1808. Rebate Audit &amp; Compliance Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual internal audit plan; external audit
Frequency: Annual internal audit; external audit annually
Volume: 1 comprehensive audit/year
Owner: Internal Audit
Participants: Internal Audit, AP Manager, VP Merchandising, External Auditor
Source: workflow W1808 — Rebate Audit &amp; Compliance Review</bpmn:documentation>
      <bpmn:laneSet id="W1808_LaneSet4">
        <bpmn:lane id="W1808_Lane1" name="Internal Audit">
        <bpmn:flowNodeRef>W1808_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1808_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1808_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1808_Lane2" name="External Auditor">
        <bpmn:flowNodeRef>W1808_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1808_Lane3" name="AP Manager">
        <bpmn:flowNodeRef>W1808_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1808_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1808_Start5" name="Annual internal audit plan; external audit">
        <bpmn:outgoing>W1808_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1808_Task6" name="Internal audit scope for rebates: (a) verify rebate accrual methodology is…">
        <bpmn:documentation>Step 1: Internal audit scope for rebates: (a) verify rebate accrual methodology is appropriate and consistently applied, (b) sample 20–30 rebate agreements: verify terms, accrual calculation accuracy, claim documentation, settlement recording, (c) test for unclaimed rebates (vendors with agreements but no claims filed), (d) verify co-op marketing fund utilization and documentation, (e) check for fictitious rebate claims (fraud risk: claiming rebates for purchases not made)
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1808_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1808_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1808_Task7" name="Key audit findings typically addressed: (a) missed claims: vendor agreements…">
        <bpmn:documentation>Step 2: Key audit findings typically addressed: (a) missed claims: vendor agreements exist but claims not submitted (direct margin leakage), (b) accrual accuracy: over/under accrual due to incorrect threshold assumptions, (c) documentation gaps: claims denied by vendor due to insufficient proof, (d) process inefficiency: manual claim process causes delays and errors
Responsible (R): Internal Audit
Accountable (A): Head of Internal Audit
Duration: Report within 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1808_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1808_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1808_Task8" name="External auditor review: (a) rebate income is material (PHP 800M–1.8B…">
        <bpmn:documentation>Step 3: External auditor review: (a) rebate income is material (PHP 800M–1.8B annually); receives significant audit attention, (b) test accrual estimation methodology (management judgment area), (c) confirm settlements with vendors (sample of top vendors), (d) assess collectibility of rebate receivables at year-end
Responsible (R): External Auditor
Accountable (A): CFO
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1808_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1808_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1808_Task9" name="Management response: AP Manager and VP Merchandising address audit findings…">
        <bpmn:documentation>Step 4: Management response: AP Manager and VP Merchandising address audit findings; implement process improvements per W1810
Responsible (R): AP Manager / VP Merchandising
Accountable (A): CFO
Duration: Within 30 days</bpmn:documentation>
        <bpmn:incoming>W1808_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1808_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1808_End10" name="Complete">
        <bpmn:incoming>W1808_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1808_Annotation11">
        <bpmn:text>Controls: - CTL-360 (ensure controlled execution — Rebate Settlement &amp; Analytics (PA-39.3).) | - operational: Internal Audit review and approval gate
Owner: Internal Audit</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1808_Assoc12" sourceRef="W1808_Annotation11" targetRef="W1808_Start5" associationDirection="None" />
