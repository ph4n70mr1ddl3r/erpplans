    <bpmn:process id="W_W1804" name="W1804. Rebate Income Recognition &amp; GL Posting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close; rebate accrual or settlement processing
Frequency: Monthly
Volume: ~100–200 active agreements
Owner: Accounting Manager
Participants: Accounting Manager, AP Manager, CFO
Source: workflow W1804 — Rebate Income Recognition &amp; GL Posting</bpmn:documentation>
      <bpmn:laneSet id="W1804_LaneSet3">
        <bpmn:lane id="W1804_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W1804_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1804_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1804_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1804_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1804_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1804_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1804_Start4" name="Monthly close; rebate accrual or settlement processing">
        <bpmn:outgoing>W1804_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1804_Task5" name="reduction of COGS">
        <bpmn:documentation>Step 1: Rebate income recognition method (BuildRight policy): (a) rebates treated as reduction of COGS (IAS 2 / PAS 2 treatment — most common for retail), (b) alternative: treat as other income (IAS 18 / PAS 18) — less preferred as it inflates gross margin, (c) consistently applied across all rebate types, (d) accrued on a systematic basis (monthly) to match purchase period, (e) recognized when: (i) amount can be measured reliably, (ii) receipt is probable (vendor financial health assessed)
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: Policy-level</bpmn:documentation>
        <bpmn:incoming>W1804_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1804_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1804_Task6" name="accrual">
        <bpmn:documentation>Step 2: Monthly journal entries: (a) accrual: debit rebate receivable, credit COGS reduction (contra-COGS), (b) settlement: debit AP (credit note) or cash (cash payment), credit rebate receivable, (c) adjustment: debit/credit COGS reduction for accrual variances, (d) entries posted per vendor agreement for traceability
Responsible (R): AP Manager / System
Accountable (A): Accounting Manager
Duration: Automated after review</bpmn:documentation>
        <bpmn:incoming>W1804_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1804_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1804_Task7" name="Financial statement presentation: (a) rebate income shown as reduction of COGS…">
        <bpmn:documentation>Step 3: Financial statement presentation: (a) rebate income shown as reduction of COGS in P&amp;L (net presentation), (b) rebate receivable shown as current asset in balance sheet (if material), (c) note disclosure: rebate income policy, significant agreements, and contingent rebates
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: At reporting date</bpmn:documentation>
        <bpmn:incoming>W1804_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1804_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1804_End8" name="Complete">
        <bpmn:incoming>W1804_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1804_Annotation9">
        <bpmn:text>Controls: - CTL-209 (ensure vendor rebate accuracy &amp; recognition.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1804_Assoc10" sourceRef="W1804_Annotation9" targetRef="W1804_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1804_Flow11" sourceRef="W1804_Start4" targetRef="W1804_Task5" />
      <bpmn:sequenceFlow id="W1804_Flow12" sourceRef="W1804_Task5" targetRef="W1804_Task6" />
      <bpmn:sequenceFlow id="W1804_Flow13" sourceRef="W1804_Task6" targetRef="W1804_Task7" />
      <bpmn:sequenceFlow id="W1804_Flow14" sourceRef="W1804_Task7" targetRef="W1804_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1804_diag">
      <bpmndi:BPMNPlane id="W1804_plane" bpmnElement="W_W1804">
        <bpmndi:BPMNShape id="W1804_Lane1_di" bpmnElement="W1804_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
