    <bpmn:process id="W_W1809" name="W1809. Vendor Rebate Agreement Renewal &amp; Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor negotiation cycle (Q4)
Frequency: Annual
Volume: ~100–200 agreements reviewed
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, Buyers, CFO
Source: workflow W1809 — Vendor Rebate Agreement Renewal &amp; Optimization</bpmn:documentation>
      <bpmn:laneSet id="W1809_LaneSet4">
        <bpmn:lane id="W1809_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W1809_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1809_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1809_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1809_Lane2" name="CFO">
        <bpmn:flowNodeRef>W1809_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1809_Lane3" name="Buyers">
        <bpmn:flowNodeRef>W1809_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1809_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1809_Start5" name="Annual vendor negotiation cycle (Q4)">
        <bpmn:outgoing>W1809_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1809_Task6" name="Category Managers review each vendor&#x27;s rebate performance for the year: (a)…">
        <bpmn:documentation>Step 1: Category Managers review each vendor&#x27;s rebate performance for the year: (a) actual rebate income earned vs. agreement potential, (b) claim realization rate, (c) vendor cooperation in claim processing, (d) comparison to competitive vendor rebate offers (benchmarking)
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1809_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1809_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1809_Task7" name="Optimization opportunities identified: (a) increase rebate rate: if…">
        <bpmn:documentation>Step 2: Optimization opportunities identified: (a) increase rebate rate: if BuildRight&#x27;s volume grew significantly, negotiate higher rate for next year, (b) lower thresholds: if current thresholds are consistently exceeded, negotiate lower threshold for same or higher rate, (c) consolidate vendor agreements: if purchasing from multiple vendors in same category, consolidate to fewer vendors for higher volume and better rates, (d) add new rebate types: co-op marketing funds, new store opening incentives, digital marketing support
Responsible (R): Category Managers / Buyers
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1809_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1809_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1809_Task8" name="CFO sets rebate income target for next year based on optimization opportunities…">
        <bpmn:documentation>Step 3: CFO sets rebate income target for next year based on optimization opportunities and purchase volume projections; Category Managers incorporate into vendor negotiations
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1809_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1809_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1809_Task9" name="Negotiated agreements updated in system per W1787; accrual parameters updated…">
        <bpmn:documentation>Step 4: Negotiated agreements updated in system per W1787; accrual parameters updated for new rates and thresholds
Responsible (R): Buyers / AP Manager
Accountable (A): VP Merchandising
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1809_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1809_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1809_End10" name="Complete">
        <bpmn:incoming>W1809_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1809_Annotation11">
        <bpmn:text>Controls: - CTL-360 (ensure controlled execution — Rebate Settlement &amp; Analytics (PA-39.3).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1809_Assoc12" sourceRef="W1809_Annotation11" targetRef="W1809_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1809_Flow13" sourceRef="W1809_Start5" targetRef="W1809_Task6" />
