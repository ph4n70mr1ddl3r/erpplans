        <bpmndi:BPMNShape id="W1804_End8_di" bpmnElement="W1804_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1804_Annotation9_di" bpmnElement="W1804_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1804_Flow11_di" bpmnElement="W1804_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1804_Flow12_di" bpmnElement="W1804_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1804_Flow13_di" bpmnElement="W1804_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1804_Flow14_di" bpmnElement="W1804_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1804_Assoc10_di" bpmnElement="W1804_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1805" name="W1805. Rebate Vendor Scorecard &amp; Partnership Tiering" isExecutable="false">
      <bpmn:documentation>Trigger: Annual vendor scorecard review (Q4)
Frequency: Annual
Volume: Top 100 vendors by rebate value
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, CFO, VP Supply Chain
Source: workflow W1805 — Rebate Vendor Scorecard &amp; Partnership Tiering</bpmn:documentation>
      <bpmn:laneSet id="W1805_LaneSet3">
        <bpmn:lane id="W1805_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W1805_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1805_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1805_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1805_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W1805_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1805_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1805_Start4" name="Annual vendor scorecard review (Q4)">
        <bpmn:outgoing>W1805_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1805_Task5" name="Platinum">
        <bpmn:documentation>Step 1: VP Merchandising develops vendor partnership tiering based on rebate and overall vendor performance: (a) Platinum (top 10 vendors — ~45% of COGS): highest rebate rates, co-op budgets, strategic collaboration, annual business planning together, (b) Gold (next 20 vendors): good rebate terms, regular co-op marketing, quarterly business reviews, (c) Silver (next 30 vendors): standard rebate terms, semi-annual reviews, (d) Standard (remaining vendors): basic rebate or no rebate, transactional relationship
Responsible (R): VP Merchandising
Accountable (A): CFO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1805_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1805_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1805_Task6" name="Vendor rebate scorecard metrics: (a) total rebate income earned, (b) rebate as…">
        <bpmn:documentation>Step 2: Vendor rebate scorecard metrics: (a) total rebate income earned, (b) rebate as % of purchases (effective margin improvement), (c) claim settlement rate (% of claimed amount actually received), (d) settlement speed (days from claim to payment), (e) co-op marketing funds utilized, (f) dispute rate (% of claims disputed by vendor), (g) year-over-year trend
Responsible (R): Category Managers / FP&amp;A
Accountable (A): VP Merchandising
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1805_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1805_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1805_Task7" name="Tiering used for: (a) next year&#x27;s negotiation leverage (higher tiers get more…">
        <bpmn:documentation>Step 3: Tiering used for: (a) next year&#x27;s negotiation leverage (higher tiers get more favorable terms), (b) allocation of limited shelf space, (c) new store opening rebate solicitation, (d) co-op marketing budget allocation
Responsible (R): VP Merchandising
Accountable (A): —
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W1805_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1805_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1805_End8" name="Complete">
        <bpmn:incoming>W1805_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1805_Annotation9">
        <bpmn:text>Controls: - CTL-360 (ensure controlled execution — Rebate Settlement &amp; Analytics (PA-39.3).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1805_Assoc10" sourceRef="W1805_Annotation9" targetRef="W1805_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1805_Flow11" sourceRef="W1805_Start4" targetRef="W1805_Task5" />
      <bpmn:sequenceFlow id="W1805_Flow12" sourceRef="W1805_Task5" targetRef="W1805_Task6" />
      <bpmn:sequenceFlow id="W1805_Flow13" sourceRef="W1805_Task6" targetRef="W1805_Task7" />
      <bpmn:sequenceFlow id="W1805_Flow14" sourceRef="W1805_Task7" targetRef="W1805_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1805_diag">
      <bpmndi:BPMNPlane id="W1805_plane" bpmnElement="W_W1805">
        <bpmndi:BPMNShape id="W1805_Lane1_di" bpmnElement="W1805_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Lane2_di" bpmnElement="W1805_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Task5_di" bpmnElement="W1805_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Task6_di" bpmnElement="W1805_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Task7_di" bpmnElement="W1805_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Start4_di" bpmnElement="W1805_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_End8_di" bpmnElement="W1805_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1805_Annotation9_di" bpmnElement="W1805_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1805_Flow11_di" bpmnElement="W1805_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1805_Flow12_di" bpmnElement="W1805_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
