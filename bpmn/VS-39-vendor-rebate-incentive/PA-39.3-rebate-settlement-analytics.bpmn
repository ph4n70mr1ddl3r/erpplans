      <bpmndi:BPMNPlane id="W1803_plane" bpmnElement="W_W1803">
        <bpmndi:BPMNShape id="W1803_Lane1_di" bpmnElement="W1803_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
