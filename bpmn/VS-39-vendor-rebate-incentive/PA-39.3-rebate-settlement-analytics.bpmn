<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-39.3-rebate-settlement-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1803" name="W1803. Rebate Settlement Processing (Credit Note &amp; Cash)" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor approves rebate claim (W1793) or co-op reimbursement (W1799)
Frequency: ~100–200 settlements/quarter
Volume: ~PHP 800M–1.8B in annual rebate settlements
Owner: AP Manager
Participants: AP Manager, Treasury, Vendor
Source: workflow W1803 — Rebate Settlement Processing (Credit Note &amp; Cash)</bpmn:documentation>
      <bpmn:laneSet id="W1803_LaneSet4">
        <bpmn:lane id="W1803_Lane1" name="Vendor → System">
        <bpmn:flowNodeRef>W1803_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1803_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1803_Lane2" name="AP Manager">
        <bpmn:flowNodeRef>W1803_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1803_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1803_Task10</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1803_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W1803_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1803_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1803_Start5" name="Vendor approves rebate claim (W1793) or co-op reimbursement (W1799)">
        <bpmn:outgoing>W1803_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1803_Task6" name="credit note">
        <bpmn:documentation>Step 1: Vendor settlement received in one of two forms: (a) credit note: vendor issues credit note against outstanding AP; reduces amount owed to vendor on next payment cycle, (b) cash payment: vendor wires payment to BuildRight bank account
Responsible (R): Vendor → System
Accountable (A): AP Manager
Duration: Per settlement</bpmn:documentation>
        <bpmn:incoming>W1803_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1803_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1803_Task7" name="For credit note settlement: (a) AP Manager verifies credit note matches…">
        <bpmn:documentation>Step 2: For credit note settlement: (a) AP Manager verifies credit note matches approved claim amount (or documents variance), (b) credit note entered in AP system against vendor account, (c) next payment to vendor reduced by credit note amount, (d) system posts: debit AP, credit rebate income
Responsible (R): AP Manager / System
Accountable (A): Accounting Manager
Duration: 10 min/credit note</bpmn:documentation>
        <bpmn:incoming>W1803_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1803_Flow16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W1803_Task8" name="For cash settlement: (a) Treasury confirms receipt in bank account, (b)…">
        <bpmn:documentation>Step 3: For cash settlement: (a) Treasury confirms receipt in bank account, (b) Treasury applies payment to rebate receivable in system, (c) system posts: debit cash, credit rebate receivable, (d) rebate income already recognized at accrual — no additional P&amp;L impact
Responsible (R): Treasury / System
Accountable (A): AP Manager
Duration: 10 min/payment</bpmn:documentation>
        <bpmn:incoming>W1803_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1803_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1803_Task9" name="Partial settlement handling: (a) if vendor settles less than claimed amount: AP…">
        <bpmn:documentation>Step 4: Partial settlement handling: (a) if vendor settles less than claimed amount: AP Manager investigates reason (documentation gap, calculation dispute, vendor policy limit), (b) unresolved variance escalated to Category Manager for vendor negotiation, (c) any unrecoverable portion reversed from rebate income
Responsible (R): AP Manager
Accountable (A): Accounting Manager
Duration: As needed</bpmn:documentation>
        <bpmn:incoming>W1803_Flow17</bpmn:incoming>
        <bpmn:outgoing>W1803_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1803_Task10" name="Monthly: AP Manager reconciles all rebate settlements to claims and accruals…">
        <bpmn:documentation>Step 5: Monthly: AP Manager reconciles all rebate settlements to claims and accruals; unresolved items &gt; 90 days escalated to CFO
Responsible (R): AP Manager
Accountable (A): CFO
Duration: 1 day/month</bpmn:documentation>
        <bpmn:incoming>W1803_Flow18</bpmn:incoming>
        <bpmn:outgoing>W1803_Flow19</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1803_End11" name="Complete">
        <bpmn:incoming>W1803_Flow19</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1803_Annotation12">
        <bpmn:text>Controls: - CTL-360 (ensure controlled execution — Rebate Settlement &amp; Analytics (PA-39.3).) | - operational: AP Manager review and approval gate; periodic reconciliation against source documents
Owner: AP Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1803_Assoc13" sourceRef="W1803_Annotation12" targetRef="W1803_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1803_Flow14" sourceRef="W1803_Start5" targetRef="W1803_Task6" />
      <bpmn:sequenceFlow id="W1803_Flow15" sourceRef="W1803_Task6" targetRef="W1803_Task7" />
      <bpmn:sequenceFlow id="W1803_Flow16" sourceRef="W1803_Task7" targetRef="W1803_Task8" />
      <bpmn:sequenceFlow id="W1803_Flow17" sourceRef="W1803_Task8" targetRef="W1803_Task9" />
      <bpmn:sequenceFlow id="W1803_Flow18" sourceRef="W1803_Task9" targetRef="W1803_Task10" />
      <bpmn:sequenceFlow id="W1803_Flow19" sourceRef="W1803_Task10" targetRef="W1803_End11" />
    </bpmn:process>
