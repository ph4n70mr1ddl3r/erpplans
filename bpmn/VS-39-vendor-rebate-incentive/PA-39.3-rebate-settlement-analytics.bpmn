      <bpmn:sequenceFlow id="W1807_Flow12" sourceRef="W1807_Task5" targetRef="W1807_Task6" />
      <bpmn:sequenceFlow id="W1807_Flow13" sourceRef="W1807_Task6" targetRef="W1807_End7" />
    </bpmn:process>
