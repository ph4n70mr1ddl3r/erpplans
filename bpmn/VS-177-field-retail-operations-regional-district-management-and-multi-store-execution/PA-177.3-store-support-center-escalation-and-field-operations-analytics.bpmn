      <bpmn:sequenceFlow id="W5122_Flow13" sourceRef="W5122_Task6" targetRef="W5122_Task7" />
      <bpmn:sequenceFlow id="W5122_Flow14" sourceRef="W5122_Task7" targetRef="W5122_End8" />
    </bpmn:process>
