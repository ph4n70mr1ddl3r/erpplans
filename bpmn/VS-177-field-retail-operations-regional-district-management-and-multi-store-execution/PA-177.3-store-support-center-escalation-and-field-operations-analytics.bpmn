    <bpmn:process id="W_W5125" name="W5125. Cross-Functional Store-Issue Coordination (Merch/IT/HR/Facilities/LP)" isExecutable="false">
      <bpmn:documentation>Trigger: Multi-function store issue (e.g. product defect + recall, system outage + manual workaround, facility failure + safety, shrink ring + LP)
Frequency: Continuous
Volume: ~10–15% of issues requiring multi-function coordination
Owner: Store Support Center Lead / Director Field Retail Operations
Participants: Merchandising (VS-01), IT (VS-27), HR (VS-103), Facilities (VS-138), LP (VS-23), Quality (VS-31), Recall (VS-89), functional leads
Source: workflow W5125 — Cross-Functional Store-Issue Coordination (Merch/IT/HR/Facilities/LP)</bpmn:documentation>
      <bpmn:laneSet id="W5125_LaneSet4">
        <bpmn:lane id="W5125_Lane1" name="Support Center Lead">
        <bpmn:flowNodeRef>W5125_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5125_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
