    <bpmn:process id="W_W5105" name="W5105. Field Retail Operations Strategy, Charter &amp; Operating-Model Design" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy refresh (VS-33); new CEO/COO; format evolution; major footprint change
Frequency: Annual + event-driven
Volume: 1 program covering the 200-store chain
Owner: VP Store Operations / Director Field Retail Operations
Participants: Strategy (VS-33), Store Ops (VS-07), HR (VS-103/VS-102), LP (VS-23), Finance FP&amp;A (VS-17.4), IT (VS-27), CX (VS-13), Facilities (VS-138)
Source: workflow W5105 — Field Retail Operations Strategy, Charter &amp; Operating-Model Design</bpmn:documentation>
      <bpmn:laneSet id="W5105_LaneSet3">
        <bpmn:lane id="W5105_Lane1" name="Director Field Retail Operations">
        <bpmn:flowNodeRef>W5105_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5105_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5105_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5105_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W5105_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5105_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5105_Start4" name="Strategy refresh (VS-33); new CEO/COO; format evolution; major footprint change">
        <bpmn:outgoing>W5105_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5105_Task5" name="Set the field-operating model: span-of-control philosophy (stores-per-manager)…">
        <bpmn:documentation>Step 1: Set the field-operating model: span-of-control philosophy (stores-per-manager), the regional/district/area hierarchy, the visit cadence standard, the decision-rights matrix (store-vs-field-vs-HQ), and the field KPIs (comp sales, standards-compliance %, turnaround success, store-hotline resolution time)
Responsible (R): Director Field Retail Operations / VP Store Operations
Accountable (A): VP Store Operations
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5105_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5105_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5105_Task6" name="Align the field model to strategy &amp; growth: coverage of the 200-store…">
        <bpmn:documentation>Step 2: Align the field model to strategy &amp; growth: coverage of the 200-store six-region footprint, the 10–15 new-store/year ramp (links VS-37), remodel-program field support (VS-109), and the omnichannel/marketplace store role (VS-10/VS-60)
Responsible (R): Director Field Retail Operations / Strategy
Accountable (A): VP Store Operations / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5105_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5105_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5105_Task7" name="Govern &amp; approve: leadership sign-off (VS-36), the field org-cost envelope with…">
        <bpmn:documentation>Step 3: Govern &amp; approve: leadership sign-off (VS-36), the field org-cost envelope with FP&amp;A, and the entity placement with HR/Legal
Responsible (R): VP Store Operations / FP&amp;A / HR
Accountable (A): VP Store Operations / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W5105_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5105_End8" name="Complete">
        <bpmn:incoming>W5105_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5105_Annotation9">
        <bpmn:text>Controls: - CTL-761 (ensure controlled execution — Field Organization, Territory Design &amp; Regional/District Store Management (PA-177.1).) | - CTL-761: operating model leadership-approved (VS-36); cost envelope FP&amp;A-validated; KPIs tied to VS-33 corporate scorecard
Owner: VP Store Operations / Director Field Retail Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5105_Assoc10" sourceRef="W5105_Annotation9" targetRef="W5105_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5105_Flow11" sourceRef="W5105_Start4" targetRef="W5105_Task5" />
      <bpmn:sequenceFlow id="W5105_Flow12" sourceRef="W5105_Task5" targetRef="W5105_Task6" />
      <bpmn:sequenceFlow id="W5105_Flow13" sourceRef="W5105_Task6" targetRef="W5105_Task7" />
      <bpmn:sequenceFlow id="W5105_Flow14" sourceRef="W5105_Task7" targetRef="W5105_End8" />
    </bpmn:process>
