      <bpmndi:BPMNPlane id="W4209_plane" bpmnElement="W_W4209">
        <bpmndi:BPMNShape id="W4209_Lane1_di" bpmnElement="W4209_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
