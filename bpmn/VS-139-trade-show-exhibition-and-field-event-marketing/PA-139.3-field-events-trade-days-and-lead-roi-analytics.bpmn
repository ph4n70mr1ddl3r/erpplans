    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4211" name="W4211. Store Grand-Opening &amp; In-Store Event Marketing" isExecutable="false">
      <bpmn:documentation>Trigger: New-store opening (VS-37); store event calendar
Frequency: Per opening (10–15/yr) + in-store events
Volume: Grand openings + ongoing in-store events (DIY clinics, seasonal)
Owner: Event Marketing Manager / Store Ops (VS-07) / Store Opening (VS-37)
Participants: Store Opening (VS-37), Store Ops (VS-07), Marketing (VS-14), Trade-Pro (VS-43), Local community/LGU (VS-76)
Source: workflow W4211 — Store Grand-Opening &amp; In-Store Event Marketing</bpmn:documentation>
      <bpmn:laneSet id="W4211_LaneSet2">
        <bpmn:lane id="W4211_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4211_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4211_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4211_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4211_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4211_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4211_Start3" name="New-store opening (VS-37); store event calendar">
        <bpmn:outgoing>W4211_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4211_Task4" name="Event Marketing/Store Opening plan the grand-opening event (ribbon-cutting…">
        <bpmn:documentation>Step 1: Event Marketing/Store Opening plan the grand-opening event (ribbon-cutting, promo, trade-pro preview, DIY clinic, local-community/LGU engagement links to VS-76) tied to store opening (VS-37)
Responsible (R): Event Marketing Mgr / Store Opening / Store Ops
Accountable (A): Event Marketing Mgr
Duration: Per opening</bpmn:documentation>
        <bpmn:incoming>W4211_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4211_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4211_Task5" name="Event Marketing/Store Ops execute the event (offers, demos, giveaways, traffic…">
        <bpmn:documentation>Step 2: Event Marketing/Store Ops execute the event (offers, demos, giveaways, traffic drivers), with compliance (permits/prize W4198) and stock/readiness (VS-37)
Responsible (R): Event Marketing Mgr / Store Ops
Accountable (A): Event Marketing Mgr
Duration: Per opening</bpmn:documentation>
        <bpmn:incoming>W4211_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4211_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4211_Task6" name="Event Marketing run ongoing in-store events (DIY clinics W4156 content…">
        <bpmn:documentation>Step 3: Event Marketing run ongoing in-store events (DIY clinics W4156 content, seasonal), measure footfall/sales lift, and report (W4216)
Responsible (R): Event Marketing Mgr / Store Ops
Accountable (A): Event Marketing Mgr
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4211_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4211_End7" name="Complete">
        <bpmn:incoming>W4211_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4211_Annotation8">
        <bpmn:text>Controls: - CTL-649 (ensure controlled execution — Field Events, Trade Days &amp; Lead/ROI Analytics (PA-139.3).) | - CTL-649: opening-event permit/LGU-compliant (W4198/VS-76); store-readiness gate (VS-37)
Owner: Event Marketing Manager / Store Ops (VS-07) / Store Opening (VS-37)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4211_Assoc9" sourceRef="W4211_Annotation8" targetRef="W4211_Start3" associationDirection="None" />
