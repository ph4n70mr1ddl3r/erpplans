      <bpmndi:BPMNPlane id="W4211_plane" bpmnElement="W_W4211">
        <bpmndi:BPMNShape id="W4211_Lane1_di" bpmnElement="W4211_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
