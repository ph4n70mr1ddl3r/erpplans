      <bpmn:sequenceFlow id="W4211_Flow11" sourceRef="W4211_Task4" targetRef="W4211_Task5" />
      <bpmn:sequenceFlow id="W4211_Flow12" sourceRef="W4211_Task5" targetRef="W4211_Task6" />
      <bpmn:sequenceFlow id="W4211_Flow13" sourceRef="W4211_Task6" targetRef="W4211_End7" />
    </bpmn:process>
