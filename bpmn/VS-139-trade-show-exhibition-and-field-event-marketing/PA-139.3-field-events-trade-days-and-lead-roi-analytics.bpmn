    <bpmn:process id="W_W4210" name="W4210. Product Launch &amp; New-Arrival Showcase Events" isExecutable="false">
      <bpmn:documentation>Trigger: New-product launch (VS-01.1 NPI); private-label (VS-41); vendor launch
Frequency: Per launch
Volume: Major launches per merchandising calendar
Owner: Event Marketing Manager / Merchandising (VS-01) / Brand (VS-14)
Participants: Merchandising (VS-01), Brand (VS-14), Private-Label (VS-41), Vendors, Trade Sales (VS-11), Media (VS-14)
Source: workflow W4210 — Product Launch &amp; New-Arrival Showcase Events</bpmn:documentation>
      <bpmn:laneSet id="W4210_LaneSet2">
        <bpmn:lane id="W4210_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4210_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4210_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4210_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4210_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4210_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4210_Start3" name="New-product launch (VS-01.1 NPI); private-label (VS-41); vendor launch">
        <bpmn:outgoing>W4210_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4210_Task4" name="Event Marketing/Merchandising plan the product-launch event (audience —…">
        <bpmn:documentation>Step 1: Event Marketing/Merchandising plan the product-launch event (audience — trade/media/key accounts, venue, demo, messaging) tied to the NPI/range decision (VS-01.1) and brand (VS-14)
Responsible (R): Event Marketing Mgr / Merchandising / Brand
Accountable (A): Event Marketing Mgr
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W4210_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4210_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4210_Task5" name="Event Marketing/Vendor execute the launch (product reveal, demos, press/PR…">
        <bpmn:documentation>Step 2: Event Marketing/Vendor execute the launch (product reveal, demos, press/PR links to VS-14.3, trade-pro preview), with product content ready (VS-137) and stock (VS-02)
Responsible (R): Event Marketing Mgr / Vendor / Brand
Accountable (A): Event Marketing Mgr
Duration: Per launch</bpmn:documentation>
        <bpmn:incoming>W4210_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4210_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4210_Task6" name="Event Marketing measure launch impact (media reach, leads, initial sales…">
        <bpmn:documentation>Step 3: Event Marketing measure launch impact (media reach, leads, initial sales, sell-through), coordinate post-launch promotion (VS-58), and report (W4216)
Responsible (R): Event Marketing Mgr / Merchandising / Brand
Accountable (A): Event Marketing Mgr
Duration: Post-launch</bpmn:documentation>
        <bpmn:incoming>W4210_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4210_End7" name="Complete">
        <bpmn:incoming>W4210_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4210_Annotation8">
        <bpmn:text>Controls: - CTL-649 (ensure controlled execution — Field Events, Trade Days &amp; Lead/ROI Analytics (PA-139.3).) | - CTL-649: launch-readiness gate (content VS-137 + stock VS-02); claims reviewed (VS-14/VS-100.3)
Owner: Event Marketing Manager / Merchandising (VS-01) / Brand (VS-14)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4210_Assoc9" sourceRef="W4210_Annotation8" targetRef="W4210_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4210_Flow10" sourceRef="W4210_Start3" targetRef="W4210_Task4" />
      <bpmn:sequenceFlow id="W4210_Flow11" sourceRef="W4210_Task4" targetRef="W4210_Task5" />
      <bpmn:sequenceFlow id="W4210_Flow12" sourceRef="W4210_Task5" targetRef="W4210_Task6" />
      <bpmn:sequenceFlow id="W4210_Flow13" sourceRef="W4210_Task6" targetRef="W4210_End7" />
    </bpmn:process>
