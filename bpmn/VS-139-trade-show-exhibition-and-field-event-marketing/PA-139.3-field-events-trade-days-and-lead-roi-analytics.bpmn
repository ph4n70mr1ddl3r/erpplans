    <bpmn:process id="W_W4209" name="W4209. Hosted Trade Day &amp; Contractor Event Operations" isExecutable="false">
      <bpmn:documentation>Trigger: Trade-day calendar (W4194); trade-pro engagement cycle
Frequency: Periodic (per cluster/store/region)
Volume: Trade-pro members + contractors (~5,200 trade accounts base)
Owner: Event Marketing Manager / Trade-Pro Program (VS-43) / Trade Sales
Participants: Trade-Pro (VS-43), Trade Sales (VS-11), Merchandising (VS-01), Store Ops (VS-07), Vendors (W4197)
Source: workflow W4209 — Hosted Trade Day &amp; Contractor Event Operations</bpmn:documentation>
      <bpmn:laneSet id="W4209_LaneSet2">
        <bpmn:lane id="W4209_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4209_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4209_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4209_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4209_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4209_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4209_Start3" name="Trade-day calendar (W4194); trade-pro engagement cycle">
        <bpmn:outgoing>W4209_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4209_Task4" name="Event Marketing/Trade-Pro plan the hosted trade day (theme — e.g., &quot;Pro Pricing…">
        <bpmn:documentation>Step 1: Event Marketing/Trade-Pro plan the hosted trade day (theme — e.g., &quot;Pro Pricing Days&quot;, product focus, offer, venue — store/DC/external), and target the trade-pro base (VS-43) and prospects (W4196)
Responsible (R): Event Marketing Mgr / Trade-Pro
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4209_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4209_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4209_Task5" name="Event Marketing/Merchandising/Vendors execute the trade day (exclusive offers…">
        <bpmn:documentation>Step 2: Event Marketing/Merchandising/Vendors execute the trade day (exclusive offers, demos W4203, vendor reps, consultations/estimates, training sessions), and capture leads (W4214)
Responsible (R): Event Marketing Mgr / Trade Sales / Vendor
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4209_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4209_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4209_Task6" name="Event Marketing/Trade-Pro measure trade-day results (attendance, offers…">
        <bpmn:documentation>Step 3: Event Marketing/Trade-Pro measure trade-day results (attendance, offers redeemed, leads, incremental sales), nurture attendees (W4215), and report ROI (W4216)
Responsible (R): Event Marketing Mgr / Trade-Pro / Trade Sales
Accountable (A): Event Marketing Mgr
Duration: Post-event</bpmn:documentation>
        <bpmn:incoming>W4209_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4209_End7" name="Complete">
        <bpmn:incoming>W4209_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4209_Annotation8">
        <bpmn:text>Controls: - CTL-649 (ensure controlled execution — Field Events, Trade Days &amp; Lead/ROI Analytics (PA-139.3).) | - CTL-649: trade-day offers within pricing governance (VS-16/VS-58); leads routed (W4214)
Owner: Event Marketing Manager / Trade-Pro Program (VS-43) / Trade Sales</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4209_Assoc9" sourceRef="W4209_Annotation8" targetRef="W4209_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4209_Flow10" sourceRef="W4209_Start3" targetRef="W4209_Task4" />
      <bpmn:sequenceFlow id="W4209_Flow11" sourceRef="W4209_Task4" targetRef="W4209_Task5" />
      <bpmn:sequenceFlow id="W4209_Flow12" sourceRef="W4209_Task5" targetRef="W4209_Task6" />
      <bpmn:sequenceFlow id="W4209_Flow13" sourceRef="W4209_Task6" targetRef="W4209_End7" />
    </bpmn:process>
