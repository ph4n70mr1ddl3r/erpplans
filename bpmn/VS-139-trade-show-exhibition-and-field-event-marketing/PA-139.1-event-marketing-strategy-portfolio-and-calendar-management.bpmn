    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4194" name="W4194. Annual Event Portfolio &amp; Calendar Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning cycle; strategy (W4193)
Frequency: Annual + quarterly adjustment
Volume: ~15–30 events/yr (national/regional shows + hosted events + store events)
Owner: Event Marketing Manager
Participants: Marketing (VS-14), Trade Sales (VS-11/VS-107), Merchandising (VS-01), Store Ops (VS-07), Vendor Mgmt (VS-03)
Source: workflow W4194 — Annual Event Portfolio &amp; Calendar Planning</bpmn:documentation>
      <bpmn:laneSet id="W4194_LaneSet2">
        <bpmn:lane id="W4194_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4194_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4194_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4194_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4194_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4194_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4194_Start3" name="Annual planning cycle; strategy (W4193)">
        <bpmn:outgoing>W4194_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4194_Task4" name="Event Marketing build the annual event portfolio/calendar (priority trade…">
        <bpmn:documentation>Step 1: Event Marketing build the annual event portfolio/calendar (priority trade shows, hosted trade days, product launches, store grand openings, sponsorships), sequenced with seasonal/merchandising calendar (VS-01 §13.2) and promo calendar (VS-58)
Responsible (R): Event Marketing Mgr / Marketing
Accountable (A): CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4194_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4194_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4194_Task5" name="Event Marketing prioritize the portfolio by strategic fit, audience reach…">
        <bpmn:documentation>Step 2: Event Marketing prioritize the portfolio by strategic fit, audience reach, lead/ROI potential, and budget (W4195), balancing national flagship vs regional/store events
Responsible (R): Event Marketing Mgr / Finance / Trade Sales
Accountable (A): CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4194_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4194_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4194_Task6" name="Event Marketing publish the calendar, allocate owners/budget per event, and…">
        <bpmn:documentation>Step 3: Event Marketing publish the calendar, allocate owners/budget per event, and adjust quarterly based on performance (W4216) and opportunities
Responsible (R): Event Marketing Mgr
Accountable (A): CMO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4194_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4194_End7" name="Complete">
        <bpmn:incoming>W4194_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4194_Annotation8">
        <bpmn:text>Controls: - CTL-647 (ensure controlled execution — Event Marketing Strategy, Portfolio &amp; Calendar Management (PA-139.1).) | - CTL-647: event calendar reconciled with promo/seasonal calendars; portfolio prioritized &amp; approved
Owner: Event Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4194_Assoc9" sourceRef="W4194_Annotation8" targetRef="W4194_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4194_Flow10" sourceRef="W4194_Start3" targetRef="W4194_Task4" />
      <bpmn:sequenceFlow id="W4194_Flow11" sourceRef="W4194_Task4" targetRef="W4194_Task5" />
      <bpmn:sequenceFlow id="W4194_Flow12" sourceRef="W4194_Task5" targetRef="W4194_Task6" />
      <bpmn:sequenceFlow id="W4194_Flow13" sourceRef="W4194_Task6" targetRef="W4194_End7" />
    </bpmn:process>
