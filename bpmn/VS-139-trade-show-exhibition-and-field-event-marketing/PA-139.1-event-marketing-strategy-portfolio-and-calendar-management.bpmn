    <bpmn:process id="W_W4198" name="W4198. Event Compliance, Permits &amp; Promo-Prize Governance" isExecutable="false">
      <bpmn:documentation>Trigger: Event with public presence, raffle/prize, LGU/exhibition permit need
Frequency: Per event
Volume: Per-event compliance (permits, prize-promo, ABC, data privacy)
Owner: Event Marketing Manager / Compliance (VS-22) / Legal (VS-100.3)
Participants: Compliance (VS-22), Legal (VS-100.3), LGU Affairs (VS-76), Privacy (VS-91), DTI (VS-117)
Source: workflow W4198 — Event Compliance, Permits &amp; Promo-Prize Governance</bpmn:documentation>
      <bpmn:laneSet id="W4198_LaneSet2">
        <bpmn:lane id="W4198_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4198_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4198_Task5</bpmn:flowNodeRef>
