      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4195" name="W4195. Event Budget, Business Case &amp; Sponsorship Funding" isExecutable="false">
      <bpmn:documentation>Trigger: Per-event decision; annual budget cycle
Frequency: Per event + annual
Volume: Per-event spend PHP 0.2M–3M+; portfolio ~PHP millions/yr
Owner: Event Marketing Manager / Finance (VS-17.4)
Participants: Finance (VS-17.4/VS-34.3), Vendor Mgmt (VS-03/VS-39 co-op), Trade Sales, Procurement (VS-34)
Source: workflow W4195 — Event Budget, Business Case &amp; Sponsorship Funding</bpmn:documentation>
      <bpmn:laneSet id="W4195_LaneSet2">
        <bpmn:lane id="W4195_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4195_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4195_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4195_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4195_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4195_Start3" name="Per-event decision; annual budget cycle">
        <bpmn:outgoing>W4195_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4195_Task4" name="Event Marketing/Finance build the event business case (booth/sponsorship cost…">
        <bpmn:documentation>Step 1: Event Marketing/Finance build the event business case (booth/sponsorship cost, logistics, travel, samples, staff, MDF/co-fund links to VS-39) with target leads/sales and ROI model
Responsible (R): Event Marketing Mgr / Finance
Accountable (A): CMO / CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4195_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4195_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4195_Task5" name="Event Marketing/Vendor Mgmt secure vendor co-funding/co-exhibition…">
        <bpmn:documentation>Step 2: Event Marketing/Vendor Mgmt secure vendor co-funding/co-exhibition (market-development funds, co-op links to VS-39.2), and structure sponsorship tiers/benefits with show organizers
Responsible (R): Event Marketing Mgr / Vendor Mgmt
Accountable (A): CMO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4195_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4195_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4195_Task6" name="Event Marketing/Finance route approval (capex/expense governance…">
        <bpmn:documentation>Step 3: Event Marketing/Finance route approval (capex/expense governance VS-40/VS-34.3), lock budget, and track spend vs plan post-event (W4216)
Responsible (R): Event Marketing Mgr / Finance
Accountable (A): CMO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4195_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4195_End7" name="Complete">
        <bpmn:incoming>W4195_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4195_Annotation8">
        <bpmn:text>Controls: - CTL-647 (ensure controlled execution — Event Marketing Strategy, Portfolio &amp; Calendar Management (PA-139.1).) | - CTL-647: business case with ROI model approved; vendor MDF/co-op documented (VS-39); spend reconciled post-event
Owner: Event Marketing Manager / Finance (VS-17.4)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4195_Assoc9" sourceRef="W4195_Annotation8" targetRef="W4195_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4195_Flow10" sourceRef="W4195_Start3" targetRef="W4195_Task4" />
      <bpmn:sequenceFlow id="W4195_Flow11" sourceRef="W4195_Task4" targetRef="W4195_Task5" />
