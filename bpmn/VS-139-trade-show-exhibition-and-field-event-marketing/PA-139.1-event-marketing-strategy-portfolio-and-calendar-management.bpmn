        <bpmn:outgoing>W4198_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4198_Task4" name="Event Marketing/Compliance secure event permits (LGU/exhibition-organizer, DTI…">
        <bpmn:documentation>Step 1: Event Marketing/Compliance secure event permits (LGU/exhibition-organizer, DTI for promo permits, local permits for hosted events links to VS-22.1/VS-76.1) and meet organizer/exhibition rules
Responsible (R): Event Marketing Mgr / Compliance / LGU Affairs
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4198_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4198_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4198_Task5" name="Event Marketing/Legal govern promo-prize mechanics (raffle/contest permits, DTI…">
        <bpmn:documentation>Step 2: Event Marketing/Legal govern promo-prize mechanics (raffle/contest permits, DTI promo-permit, fairness, terms — links to VS-58 promo, VS-22.1), and ensure prize sourcing/tax (links to VS-79 withholding)
Responsible (R): Event Marketing Mgr / Legal
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4198_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4198_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4198_Task6" name="Event Marketing/Privacy ensure data-privacy compliance (lead-data consent…">
        <bpmn:documentation>Step 3: Event Marketing/Privacy ensure data-privacy compliance (lead-data consent, registration privacy notice links to VS-91), ABC for hospitality/gifts (VS-86.3), and product-safety/labeling for samples (VS-117/VS-114)
Responsible (R): Event Marketing Mgr / Privacy / Legal
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4198_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4198_End7" name="Complete">
        <bpmn:incoming>W4198_Flow13</bpmn:incoming>
      </bpmn:endEvent>
