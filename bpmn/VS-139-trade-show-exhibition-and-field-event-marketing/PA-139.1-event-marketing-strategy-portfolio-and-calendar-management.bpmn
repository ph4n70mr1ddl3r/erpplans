    <bpmn:process id="W_W4193" name="W4193. Event Marketing Strategy &amp; Channel Role" isExecutable="false">
      <bpmn:documentation>Trigger: Annual marketing strategy (VS-14); B2B-growth objective
Frequency: Annual + on strategy change
Volume: Enterprise event-channel strategy (~40% B2B revenue base)
Owner: Event Marketing Manager / Marketing (VS-14)
Participants: CMO, Trade Sales (VS-11/VS-107), Trade-Pro Program (VS-43), Merchandising (VS-01), Insights (VS-44)
Source: workflow W4193 — Event Marketing Strategy &amp; Channel Role</bpmn:documentation>
      <bpmn:laneSet id="W4193_LaneSet2">
        <bpmn:lane id="W4193_Lane1" name="Event Marketing Mgr">
        <bpmn:flowNodeRef>W4193_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4193_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4193_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4193_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4193_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4193_Start3" name="Annual marketing strategy (VS-14); B2B-growth objective">
        <bpmn:outgoing>W4193_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4193_Task4" name="Event Marketing define the role of events in the B2B/customer-acquisition mix…">
        <bpmn:documentation>Step 1: Event Marketing define the role of events in the B2B/customer-acquisition mix (trade shows vs hosted trade days vs store events vs sponsorships), aligned to marketing strategy (VS-14) and B2B-growth goals
Responsible (R): Event Marketing Mgr / Marketing
Accountable (A): CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4193_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4193_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4193_Task5" name="Event Marketing/Insights assess the event landscape (PhilConstruct, Worldbex…">
        <bpmn:documentation>Step 2: Event Marketing/Insights assess the event landscape (PhilConstruct, Worldbex, CebuCon, regional shows, association events) and audience fit vs BuildRight&#x27;s trade/corporate segments (links to VS-44 insights, VS-43 trade-pro)
Responsible (R): Event Marketing Mgr / Insights
Accountable (A): CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4193_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4193_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4193_Task6" name="Event Marketing document the strategy, channel role, and investment envelope…">
        <bpmn:documentation>Step 3: Event Marketing document the strategy, channel role, and investment envelope, obtain approval, and cascade to the annual portfolio/calendar (W4194)
Responsible (R): Event Marketing Mgr / Finance
Accountable (A): CMO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4193_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4193_End7" name="Complete">
        <bpmn:incoming>W4193_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4193_Annotation8">
        <bpmn:text>Controls: - CTL-647 (ensure controlled execution — Event Marketing Strategy, Portfolio &amp; Calendar Management (PA-139.1).) | - CTL-647: event strategy approved by CMO; aligned to marketing/B2B strategy (VS-14)
Owner: Event Marketing Manager / Marketing (VS-14)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4193_Assoc9" sourceRef="W4193_Annotation8" targetRef="W4193_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4193_Flow10" sourceRef="W4193_Start3" targetRef="W4193_Task4" />
      <bpmn:sequenceFlow id="W4193_Flow11" sourceRef="W4193_Task4" targetRef="W4193_Task5" />
      <bpmn:sequenceFlow id="W4193_Flow12" sourceRef="W4193_Task5" targetRef="W4193_Task6" />
      <bpmn:sequenceFlow id="W4193_Flow13" sourceRef="W4193_Task6" targetRef="W4193_End7" />
    </bpmn:process>
