        <bpmn:flowNodeRef>W4197_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4197_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4197_Start3" name="Event decision; vendor partnership opportunity">
        <bpmn:outgoing>W4197_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4197_Task4" name="Event Marketing/Vendor Mgmt identify co-funding/co-exhibition partners (brands…">
        <bpmn:documentation>Step 1: Event Marketing/Vendor Mgmt identify co-funding/co-exhibition partners (brands wanting trade-show presence, product-launch tie-ins), and pitch co-exhibition/sponsorship/MDF (links to VS-39.2)
Responsible (R): Event Marketing Mgr / Vendor Mgmt
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4197_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4197_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4197_Task5" name="Event Marketing/Vendor Mgmt structure the co-fund agreement (scope…">
        <bpmn:documentation>Step 2: Event Marketing/Vendor Mgmt structure the co-fund agreement (scope, contribution, branding, lead-sharing, ABC compliance VS-86.3) and coordinate logistics (booth space, samples, demonstrators)
Responsible (R): Event Marketing Mgr / Vendor Mgmt / Legal
Accountable (A): Event Marketing Mgr
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4197_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4197_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4197_Task6" name="Event Marketing reconcile vendor contributions vs spend (links to VS-39.2 co-op…">
        <bpmn:documentation>Step 3: Event Marketing reconcile vendor contributions vs spend (links to VS-39.2 co-op settlement), manage partner relationships, and report co-fund ROI (W4216)
Responsible (R): Event Marketing Mgr / Finance / Vendor Mgmt
Accountable (A): Event Marketing Mgr
Duration: Post-event</bpmn:documentation>
        <bpmn:incoming>W4197_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4197_End7" name="Complete">
        <bpmn:incoming>W4197_Flow13</bpmn:incoming>
      </bpmn:endEvent>
