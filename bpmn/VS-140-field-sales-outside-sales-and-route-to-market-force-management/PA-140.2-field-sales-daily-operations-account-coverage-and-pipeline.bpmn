        <bpmn:outgoing>W4231_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4231_Task4" name="Rep/Merchandising arrange samples/demos for the customer (tile samples, product…">
        <bpmn:documentation>Step 1: Rep/Merchandising arrange samples/demos for the customer (tile samples, product demo, mock-up) to support the spec/sale decision, from sample inventory (VS-62)
Responsible (R): Field Sales Rep / Merchandising / Sample Mgmt
Accountable (A): Regional Mgr
Duration: Per need</bpmn:documentation>
        <bpmn:incoming>W4231_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4231_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4231_Task5" name="Rep/Logistics deliver samples/demo to the jobsite/office, conduct product…">
        <bpmn:documentation>Step 2: Rep/Logistics deliver samples/demo to the jobsite/office, conduct product demonstration (links to VS-09/VS-124), and support jobsite merchandising/display
Responsible (R): Field Sales Rep / Logistics / Trade Specialist
Accountable (A): Regional Mgr
Duration: Per need</bpmn:documentation>
        <bpmn:incoming>W4231_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4231_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4231_Task6" name="Rep/Sample Mgmt track sample inventory, recover/reuse samples, and measure…">
        <bpmn:documentation>Step 3: Rep/Sample Mgmt track sample inventory, recover/reuse samples, and measure sample-to-sale conversion (links to VS-62 analytics)
Responsible (R): Field Sales Rep / Sample Mgmt
Accountable (A): Regional Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4231_Flow12</bpmn:incoming>
      </bpmn:userTask>
