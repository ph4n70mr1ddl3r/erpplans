    <bpmn:process id="W_W4229" name="W4229. Field Order Capture, Pricing &amp; Fulfillment Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Quote accepted (W4227); reorder; field order
Frequency: Per order
Volume: B2B orders (subset of ~3,500 AR invoices/month across ~5,200 trade + 200 corporate accounts; ecommerce links VS-10)
Owner: Field Sales Rep / Trade Sales (VS-11)
Participants: Trade Sales (VS-11), Credit (VS-16.1), Logistics/Delivery (VS-06/VS-74), Store (VS-07)
Source: workflow W4229 — Field Order Capture, Pricing &amp; Fulfillment Coordination</bpmn:documentation>
      <bpmn:laneSet id="W4229_LaneSet2">
        <bpmn:lane id="W4229_Lane1" name="Field Sales Rep">
        <bpmn:flowNodeRef>W4229_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4229_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4229_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4229_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4229_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4229_Start3" name="Quote accepted (W4227); reorder; field order">
        <bpmn:outgoing>W4229_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4229_Task4" name="Rep capture the order in mobile CRM/ERP (VS-11/VS-16) — items, qty, price…">
        <bpmn:documentation>Step 1: Rep capture the order in mobile CRM/ERP (VS-11/VS-16) — items, qty, price (trade/project), delivery — from the accepted quote, checking availability (VS-05)
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4229_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4229_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4229_Task5" name="Rep/Credit check trade-credit (limit/standing links to VS-16.1, VS-68…">
        <bpmn:documentation>Step 2: Rep/Credit check trade-credit (limit/standing links to VS-16.1, VS-68 trade-credit-risk), apply price approval (W4227), and confirm order to the customer
Responsible (R): Field Sales Rep / Credit
Accountable (A): Regional Mgr
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4229_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4229_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4229_Task6" name="Rep coordinate fulfillment (DC/store allocation, delivery scheduling links to…">
        <bpmn:documentation>Step 3: Rep coordinate fulfillment (DC/store allocation, delivery scheduling links to VS-06/VS-74 jobsite delivery), track to delivery, and confirm satisfaction
Responsible (R): Field Sales Rep / Logistics
Accountable (A): Regional Mgr
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4229_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4229_End7" name="Complete">
        <bpmn:incoming>W4229_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4229_Annotation8">
        <bpmn:text>Controls: - CTL-90 (ensure field-sales conduct &amp; pipeline integrity.) | - CTL-651: credit check before order (VS-16.1/VS-68); price within approval; availability confirmed
Owner: Field Sales Rep / Trade Sales (VS-11)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4229_Assoc9" sourceRef="W4229_Annotation8" targetRef="W4229_Start3" associationDirection="None" />
