<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-140.2-field-sales-daily-operations-account-coverage-and-pipeline" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4225" name="W4225. Daily Route &amp; Call Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Daily sales cycle; coverage plan (W4220)
Frequency: Daily
Volume: Field reps × daily routes (visits/day)
Owner: Field Sales Rep / Sales Operations
Participants: Regional Mgrs, Trade Sales (VS-11), Logistics (route — VS-06)
Source: workflow W4225 — Daily Route &amp; Call Planning</bpmn:documentation>
      <bpmn:laneSet id="W4225_LaneSet2">
        <bpmn:lane id="W4225_Lane1" name="Field Sales Rep">
        <bpmn:flowNodeRef>W4225_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4225_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4225_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4225_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4225_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4225_Start3" name="Daily sales cycle; coverage plan (W4220)">
        <bpmn:outgoing>W4225_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4225_Task4" name="Rep/Sales Ops plan the daily route from the coverage plan (W4220), prioritizing…">
        <bpmn:documentation>Step 1: Rep/Sales Ops plan the daily route from the coverage plan (W4220), prioritizing high-value/at-risk/active-opportunity accounts, and scheduling visits within travel/time capacity
Responsible (R): Field Sales Rep / Sales Ops
Accountable (A): Regional Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4225_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4225_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4225_Task5" name="Rep optimize the route for travel efficiency (geography, traffic, cluster)…">
        <bpmn:documentation>Step 2: Rep optimize the route for travel efficiency (geography, traffic, cluster), align with appointments, and prepare per-account briefs (history, open opps, last visit — from CRM VS-11/CDP VS-126)
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4225_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4225_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4225_Task6" name="Rep execute visits, log activity/next steps in mobile CRM (W4224), and report…">
        <bpmn:documentation>Step 3: Rep execute visits, log activity/next steps in mobile CRM (W4224), and report daily activity to the manager
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4225_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4225_End7" name="Complete">
        <bpmn:incoming>W4225_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4225_Annotation8">
        <bpmn:text>Controls: - CTL-90 (ensure field-sales conduct &amp; pipeline integrity.) | - CTL-651: daily route from coverage plan; activity logged in CRM; adherence monitored
Owner: Field Sales Rep / Sales Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4225_Assoc9" sourceRef="W4225_Annotation8" targetRef="W4225_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4225_Flow10" sourceRef="W4225_Start3" targetRef="W4225_Task4" />
      <bpmn:sequenceFlow id="W4225_Flow11" sourceRef="W4225_Task4" targetRef="W4225_Task5" />
      <bpmn:sequenceFlow id="W4225_Flow12" sourceRef="W4225_Task5" targetRef="W4225_Task6" />
      <bpmn:sequenceFlow id="W4225_Flow13" sourceRef="W4225_Task6" targetRef="W4225_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4225_diag">
      <bpmndi:BPMNPlane id="W4225_plane" bpmnElement="W_W4225">
        <bpmndi:BPMNShape id="W4225_Lane1_di" bpmnElement="W4225_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_Task4_di" bpmnElement="W4225_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_Task5_di" bpmnElement="W4225_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_Task6_di" bpmnElement="W4225_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_Start3_di" bpmnElement="W4225_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_End7_di" bpmnElement="W4225_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4225_Annotation8_di" bpmnElement="W4225_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4225_Flow10_di" bpmnElement="W4225_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4225_Flow11_di" bpmnElement="W4225_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4225_Flow12_di" bpmnElement="W4225_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4225_Flow13_di" bpmnElement="W4225_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4225_Assoc9_di" bpmnElement="W4225_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4226" name="W4226. Customer Visit, Needs Analysis &amp; Relationship Management" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled visit (W4225); account need
Frequency: Per visit (call-frequency per tier W4220)
Volume: Visits across ~5,400 B2B accounts per coverage plan
Owner: Field Sales Rep
Participants: Account contact (contractor/developer/architect/buyer), Trade-Pro (VS-43), Trade Sales (VS-11)
Source: workflow W4226 — Customer Visit, Needs Analysis &amp; Relationship Management</bpmn:documentation>
      <bpmn:laneSet id="W4226_LaneSet2">
        <bpmn:lane id="W4226_Lane1" name="Field Sales Rep">
        <bpmn:flowNodeRef>W4226_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4226_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4226_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4226_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4226_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4226_Start3" name="Scheduled visit (W4225); account need">
        <bpmn:outgoing>W4226_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4226_Task4" name="Rep conduct the visit — relationship-building, needs discovery (upcoming…">
        <bpmn:documentation>Step 1: Rep conduct the visit — relationship-building, needs discovery (upcoming projects, specifications, pain points), and consultative advice (links to VS-124 selling)
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4226_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4226_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4226_Task5" name="Rep capture needs/opportunities in CRM (VS-11), identify cross-sell/attach…">
        <bpmn:documentation>Step 2: Rep capture needs/opportunities in CRM (VS-11), identify cross-sell/attach (VS-137 relationships), and refer to specialists/trade-pro where relevant (VS-43/VS-70)
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4226_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4226_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4226_Task6" name="Rep agree next steps/actions with the customer, log commitments, and follow up…">
        <bpmn:documentation>Step 3: Rep agree next steps/actions with the customer, log commitments, and follow up — maintaining the account relationship over time
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Per visit</bpmn:documentation>
        <bpmn:incoming>W4226_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4226_End7" name="Complete">
        <bpmn:incoming>W4226_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4226_Annotation8">
        <bpmn:text>Controls: - CTL-651 (ensure controlled execution — Field Sales Daily Operations, Account Coverage &amp; Pipeline (PA-140.2).) | - CTL-651: needs/opportunities logged in CRM; commitments tracked; consultative coaching (VS-124)
Owner: Field Sales Rep</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4226_Assoc9" sourceRef="W4226_Annotation8" targetRef="W4226_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4226_Flow10" sourceRef="W4226_Start3" targetRef="W4226_Task4" />
      <bpmn:sequenceFlow id="W4226_Flow11" sourceRef="W4226_Task4" targetRef="W4226_Task5" />
      <bpmn:sequenceFlow id="W4226_Flow12" sourceRef="W4226_Task5" targetRef="W4226_Task6" />
      <bpmn:sequenceFlow id="W4226_Flow13" sourceRef="W4226_Task6" targetRef="W4226_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4226_diag">
      <bpmndi:BPMNPlane id="W4226_plane" bpmnElement="W_W4226">
        <bpmndi:BPMNShape id="W4226_Lane1_di" bpmnElement="W4226_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_Task4_di" bpmnElement="W4226_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_Task5_di" bpmnElement="W4226_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_Task6_di" bpmnElement="W4226_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_Start3_di" bpmnElement="W4226_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_End7_di" bpmnElement="W4226_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4226_Annotation8_di" bpmnElement="W4226_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4226_Flow10_di" bpmnElement="W4226_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4226_Flow11_di" bpmnElement="W4226_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4226_Flow12_di" bpmnElement="W4226_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4226_Flow13_di" bpmnElement="W4226_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4226_Assoc9_di" bpmnElement="W4226_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4227" name="W4227. Project Discovery, Estimating &amp; Quoting" isExecutable="false">
      <bpmn:documentation>Trigger: Customer project opportunity (W4226); RFQ
Frequency: Per opportunity
Volume: Many project estimates/quotes/yr (project-driven B2B)
Owner: Field Sales Rep / Estimating Specialist
Participants: Estimating (VS-09/VS-66), Merchandising/Pricing (VS-57/VS-16), Trade Sales (VS-11), Vendor (spec)
Source: workflow W4227 — Project Discovery, Estimating &amp; Quoting</bpmn:documentation>
      <bpmn:laneSet id="W4227_LaneSet2">
        <bpmn:lane id="W4227_Lane1" name="Field Sales Rep">
        <bpmn:flowNodeRef>W4227_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4227_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4227_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4227_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4227_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4227_Start3" name="Customer project opportunity (W4226); RFQ">
        <bpmn:outgoing>W4227_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4227_Task4" name="Rep/Estimating gather project requirements (bill of materials, quantities…">
        <bpmn:documentation>Step 1: Rep/Estimating gather project requirements (bill of materials, quantities, specs, timeline), from the customer/site, using estimating tools (links to VS-09/VS-66 estimating)
Responsible (R): Field Sales Rep / Estimating Specialist
Accountable (A): Regional Mgr
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4227_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4227_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4227_Task5" name="Rep/Pricing build the quote (BOM, pricing — trade/project price links to VS-16…">
        <bpmn:documentation>Step 2: Rep/Pricing build the quote (BOM, pricing — trade/project price links to VS-16, margin, validity), apply approval for discount (links to VS-16 credit/price approval, VS-118 pricing integrity)
Responsible (R): Field Sales Rep / Pricing
Accountable (A): Regional Mgr
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4227_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4227_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4227_Task6" name="Rep present the quote to the customer, negotiate, capture outcome in CRM (VS-11…">
        <bpmn:documentation>Step 3: Rep present the quote to the customer, negotiate, capture outcome in CRM (VS-11 → opportunity W4228), and convert to order on acceptance (W4229)
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4227_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4227_End7" name="Complete">
        <bpmn:incoming>W4227_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4227_Annotation8">
        <bpmn:text>Controls: - CTL-651 (ensure controlled execution — Field Sales Daily Operations, Account Coverage &amp; Pipeline (PA-140.2).) | - CTL-651: estimates reviewed; discount within approval (VS-16/VS-118); quote validity tracked
Owner: Field Sales Rep / Estimating Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4227_Assoc9" sourceRef="W4227_Annotation8" targetRef="W4227_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4227_Flow10" sourceRef="W4227_Start3" targetRef="W4227_Task4" />
      <bpmn:sequenceFlow id="W4227_Flow11" sourceRef="W4227_Task4" targetRef="W4227_Task5" />
      <bpmn:sequenceFlow id="W4227_Flow12" sourceRef="W4227_Task5" targetRef="W4227_Task6" />
      <bpmn:sequenceFlow id="W4227_Flow13" sourceRef="W4227_Task6" targetRef="W4227_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4227_diag">
      <bpmndi:BPMNPlane id="W4227_plane" bpmnElement="W_W4227">
        <bpmndi:BPMNShape id="W4227_Lane1_di" bpmnElement="W4227_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_Task4_di" bpmnElement="W4227_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_Task5_di" bpmnElement="W4227_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_Task6_di" bpmnElement="W4227_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_Start3_di" bpmnElement="W4227_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_End7_di" bpmnElement="W4227_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4227_Annotation8_di" bpmnElement="W4227_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4227_Flow10_di" bpmnElement="W4227_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4227_Flow11_di" bpmnElement="W4227_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4227_Flow12_di" bpmnElement="W4227_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4227_Flow13_di" bpmnElement="W4227_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4227_Assoc9_di" bpmnElement="W4227_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4228" name="W4228. Opportunity, Pipeline &amp; Forecast Management" isExecutable="false">
      <bpmn:documentation>Trigger: Opportunity created (W4227); pipeline cycle
Frequency: Continuous + weekly forecast
Volume: Active opportunities × pipeline value
Owner: Field Sales Rep / Sales Operations
Participants: Regional Mgrs, Trade Sales (VS-11), Key Accounts (VS-107), Finance/Forecast (VS-17.4/VS-127)
Source: workflow W4228 — Opportunity, Pipeline &amp; Forecast Management</bpmn:documentation>
      <bpmn:laneSet id="W4228_LaneSet4">
        <bpmn:lane id="W4228_Lane1" name="Field Sales Rep">
        <bpmn:flowNodeRef>W4228_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4228_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4228_Lane2" name="Regional Mgr">
        <bpmn:flowNodeRef>W4228_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4228_Lane3" name="Sales Ops">
        <bpmn:flowNodeRef>W4228_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4228_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4228_Start5" name="Opportunity created (W4227); pipeline cycle">
        <bpmn:outgoing>W4228_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4228_Task6" name="Rep manage opportunities in CRM (VS-11) — stage, probability, value, close…">
        <bpmn:documentation>Step 1: Rep manage opportunities in CRM (VS-11) — stage, probability, value, close date, next step — and keep pipeline current/accurate
Responsible (R): Field Sales Rep
Accountable (A): Regional Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4228_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4228_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4228_Task7" name="Regional Mgr/Sales Ops review pipeline (weekly), coach reps on stuck/at-risk…">
        <bpmn:documentation>Step 2: Regional Mgr/Sales Ops review pipeline (weekly), coach reps on stuck/at-risk deals, and validate forecast accuracy vs actual (links to VS-127 S&amp;OP demand feed)
Responsible (R): Regional Mgr / Sales Ops
Accountable (A): Head of Field Sales
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W4228_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4228_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4228_Task8" name="Sales Ops consolidate the B2B forecast, feed demand/sales planning…">
        <bpmn:documentation>Step 3: Sales Ops consolidate the B2B forecast, feed demand/sales planning (VS-127/VS-101), and report pipeline health/coverage to leadership (W4233)
Responsible (R): Sales Ops / Finance
Accountable (A): Head of Trade / Account Management
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W4228_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4228_End9" name="Complete">
        <bpmn:incoming>W4228_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4228_Annotation10">
        <bpmn:text>Controls: - CTL-651 (ensure controlled execution — Field Sales Daily Operations, Account Coverage &amp; Pipeline (PA-140.2).) | - CTL-651: pipeline reviewed weekly; forecast accuracy tracked; fed to S&amp;OP (VS-127)
Owner: Field Sales Rep / Sales Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4228_Assoc11" sourceRef="W4228_Annotation10" targetRef="W4228_Start5" associationDirection="None" />
