    <bpmn:process id="W_W4231" name="W4231. Field Sample, Demo &amp; Merchandising Support" isExecutable="false">
      <bpmn:documentation>Trigger: Customer need for sample/demo; jobsite merchandising support
Frequency: Per need
Volume: Samples/demos issued to B2B accounts/jobsites
Owner: Field Sales Rep / Merchandising (VS-01) / Sample Mgmt (VS-62)
Participants: Merchandising (VS-01), Sample Mgmt (VS-62), Trade Specialists, Logistics (VS-06)
Source: workflow W4231 — Field Sample, Demo &amp; Merchandising Support</bpmn:documentation>
      <bpmn:laneSet id="W4231_LaneSet2">
        <bpmn:lane id="W4231_Lane1" name="Field Sales Rep">
