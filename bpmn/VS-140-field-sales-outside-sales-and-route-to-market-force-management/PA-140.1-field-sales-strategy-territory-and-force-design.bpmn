        <bpmndi:BPMNEdge id="W4218_Flow13_di" bpmnElement="W4218_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4218_Assoc9_di" bpmnElement="W4218_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4219" name="W4219. Territory Design, Alignment &amp; Balancing" isExecutable="false">
      <bpmn:documentation>Trigger: Force structure (W4218); account growth; rebalance cycle
Frequency: Annual + on major change
Volume: Territories across the Philippine archipelago (Mindanao/Visayas/Luzon/NCR)
Owner: Head of Field Sales / Sales Operations
Participants: Regional Sales Managers, Key Accounts (VS-107), Trade-Pro (VS-43), Analytics (VS-28)
Source: workflow W4219 — Territory Design, Alignment &amp; Balancing</bpmn:documentation>
      <bpmn:laneSet id="W4219_LaneSet2">
        <bpmn:lane id="W4219_Lane1" name="Sales Ops">
        <bpmn:flowNodeRef>W4219_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4219_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4219_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4219_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4219_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4219_Start3" name="Force structure (W4218); account growth; rebalance cycle">
        <bpmn:outgoing>W4219_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4219_Task4" name="Sales Ops/Analytics design territories balancing workload (account count…">
        <bpmn:documentation>Step 1: Sales Ops/Analytics design territories balancing workload (account count, revenue potential, geography/travel, project density) via territory-modeling, aligned to store/DC regions (VS-07/VS-136)
Responsible (R): Sales Ops / Analytics
Accountable (A): Head of Field Sales
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4219_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4219_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4219_Task5" name="Sales Ops assign accounts to territories/reps, handle overlaps (multi-territory…">
        <bpmn:documentation>Step 2: Sales Ops assign accounts to territories/reps, handle overlaps (multi-territory corporate accounts links to VS-107), and document territory boundaries
Responsible (R): Sales Ops / Regional Mgrs
Accountable (A): Head of Field Sales
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4219_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4219_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4219_Task6" name="Sales Ops rebalance on growth/reorg, manage territory-change…">
        <bpmn:documentation>Step 3: Sales Ops rebalance on growth/reorg, manage territory-change communications/disputes, and monitor territory equity (W4232)
Responsible (R): Sales Ops / Regional Mgrs
Accountable (A): Head of Field Sales
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4219_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4219_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4219_End7" name="Complete">
        <bpmn:incoming>W4219_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4219_Annotation8">
        <bpmn:text>Controls: - CTL-650 (ensure controlled execution — Field Sales Strategy, Territory &amp; Force Design (PA-140.1).) | - CTL-650: territories workload-balanced; assignments complete &amp; audited; disputes managed
Owner: Head of Field Sales / Sales Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4219_Assoc9" sourceRef="W4219_Annotation8" targetRef="W4219_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4219_Flow10" sourceRef="W4219_Start3" targetRef="W4219_Task4" />
      <bpmn:sequenceFlow id="W4219_Flow11" sourceRef="W4219_Task4" targetRef="W4219_Task5" />
      <bpmn:sequenceFlow id="W4219_Flow12" sourceRef="W4219_Task5" targetRef="W4219_Task6" />
      <bpmn:sequenceFlow id="W4219_Flow13" sourceRef="W4219_Task6" targetRef="W4219_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4219_diag">
      <bpmndi:BPMNPlane id="W4219_plane" bpmnElement="W_W4219">
        <bpmndi:BPMNShape id="W4219_Lane1_di" bpmnElement="W4219_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_Task4_di" bpmnElement="W4219_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_Task5_di" bpmnElement="W4219_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_Task6_di" bpmnElement="W4219_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_Start3_di" bpmnElement="W4219_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_End7_di" bpmnElement="W4219_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4219_Annotation8_di" bpmnElement="W4219_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4219_Flow10_di" bpmnElement="W4219_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4219_Flow11_di" bpmnElement="W4219_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4219_Flow12_di" bpmnElement="W4219_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4219_Flow13_di" bpmnElement="W4219_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4219_Assoc9_di" bpmnElement="W4219_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
