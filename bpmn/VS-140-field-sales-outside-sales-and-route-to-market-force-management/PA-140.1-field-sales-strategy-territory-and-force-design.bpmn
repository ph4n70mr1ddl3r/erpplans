<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-140.1-field-sales-strategy-territory-and-force-design" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4217" name="W4217. Field Sales Strategy &amp; Go-to-Coverage Model" isExecutable="false">
      <bpmn:documentation>Trigger: B2B-growth strategy; coverage review; competitive pressure
Frequency: Annual + on strategy change
Volume: Enterprise field-sales strategy (~40% B2B revenue; ~5,200 trade + ~200 corporate accounts)
Owner: Head of Field Sales / Head of Trade / Account Management / Commercial Leadership
Participants: Trade Sales (VS-11), Key Accounts (VS-107), Trade-Pro (VS-43), Strategy (VS-33), Merchandising (VS-01)
Source: workflow W4217 — Field Sales Strategy &amp; Go-to-Coverage Model</bpmn:documentation>
      <bpmn:laneSet id="W4217_LaneSet2">
        <bpmn:lane id="W4217_Lane1" name="Head of Field Sales">
        <bpmn:flowNodeRef>W4217_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4217_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4217_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4217_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4217_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4217_Start3" name="B2B-growth strategy; coverage review; competitive pressure">
        <bpmn:outgoing>W4217_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4217_Task4" name="Field Sales define the go-to-coverage model — which B2B segments/projects are…">
        <bpmn:documentation>Step 1: Field Sales define the go-to-coverage model — which B2B segments/projects are covered by field reps (high-value/strategic) vs digital/self-service (VS-10/VS-11 portal) vs store (VS-07) — aligned to B2B strategy (VS-33)
Responsible (R): Head of Field Sales / Strategy
Accountable (A): Head of Trade / Account Management / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4217_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4217_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4217_Task5" name="Field Sales define the field-sales value proposition and selling motion…">
        <bpmn:documentation>Step 2: Field Sales define the field-sales value proposition and selling motion (consultative/spec selling, project pursuit, account farming vs new-logo hunting), and the segment focus (trade, corporate, B2G links to VS-46)
Responsible (R): Head of Field Sales / Trade Sales / Key Accounts
Accountable (A): Head of Trade / Account Management
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4217_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4217_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4217_Task6" name="Field Sales document the strategy, obtain approval, resource it (W4218), and…">
        <bpmn:documentation>Step 3: Field Sales document the strategy, obtain approval, resource it (W4218), and cascade to territory/account/coverage plans (W4219–W4221)
Responsible (R): Head of Field Sales / Finance
Accountable (A): Head of Trade / Account Management / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4217_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4217_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4217_End7" name="Complete">
        <bpmn:incoming>W4217_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4217_Annotation8">
        <bpmn:text>Controls: - CTL-650 (ensure controlled execution — Field Sales Strategy, Territory &amp; Force Design (PA-140.1).) | - CTL-650: field-sales strategy approved; aligned to B2B strategy (VS-33); channel conflict managed
Owner: Head of Field Sales / Head of Trade / Account Management / Commercial Leadership</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4217_Assoc9" sourceRef="W4217_Annotation8" targetRef="W4217_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4217_Flow10" sourceRef="W4217_Start3" targetRef="W4217_Task4" />
      <bpmn:sequenceFlow id="W4217_Flow11" sourceRef="W4217_Task4" targetRef="W4217_Task5" />
      <bpmn:sequenceFlow id="W4217_Flow12" sourceRef="W4217_Task5" targetRef="W4217_Task6" />
      <bpmn:sequenceFlow id="W4217_Flow13" sourceRef="W4217_Task6" targetRef="W4217_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4217_diag">
      <bpmndi:BPMNPlane id="W4217_plane" bpmnElement="W_W4217">
        <bpmndi:BPMNShape id="W4217_Lane1_di" bpmnElement="W4217_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4217_Task4_di" bpmnElement="W4217_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
