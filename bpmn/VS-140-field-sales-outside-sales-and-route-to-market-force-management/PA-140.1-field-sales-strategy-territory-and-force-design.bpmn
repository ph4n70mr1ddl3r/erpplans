        <bpmndi:BPMNEdge id="W4217_Assoc9_di" bpmnElement="W4217_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4218" name="W4218. Force Sizing, Structure &amp; Role Design" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W4217); growth; cost review
Frequency: Annual + on change
Volume: Field-sales headcount sized to ~5,400 B2B accounts + prospects
Owner: Head of Field Sales / HR (VS-19) / Workforce Planning (VS-103.3)
Participants: HR (VS-19), Finance (VS-17.4), Workforce Planning (VS-103.3), Comp (VS-102)
Source: workflow W4218 — Force Sizing, Structure &amp; Role Design</bpmn:documentation>
      <bpmn:laneSet id="W4218_LaneSet2">
        <bpmn:lane id="W4218_Lane1" name="Head of Field Sales">
        <bpmn:flowNodeRef>W4218_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4218_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4218_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4218_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4218_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4218_Start3" name="Strategy (W4217); growth; cost review">
        <bpmn:outgoing>W4218_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4218_Task4" name="Field Sales/HR size the force (workload-based: accounts × call-frequency ×…">
        <bpmn:documentation>Step 1: Field Sales/HR size the force (workload-based: accounts × call-frequency × call-duration; capacity model), and structure roles (outside sales rep, trade-account exec, project/spec specialist, sales engineer)
Responsible (R): Head of Field Sales / HR / Workforce Planning
Accountable (A): Head of Trade / Account Management / CHRO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4218_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4218_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4218_Task5" name="Field Sales/HR design role profiles, spans of control, reporting lines, and…">
        <bpmn:documentation>Step 2: Field Sales/HR design role profiles, spans of control, reporting lines, and specialist roles (e.g., solar/renewable spec links to VS-70, electrical/plumbing spec), aligned to coverage (W4220)
Responsible (R): Head of Field Sales / HR
Accountable (A): Head of Trade / Account Management
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4218_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4218_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4218_Task6" name="Field Sales/Finance build the force business case (cost vs incremental B2B…">
        <bpmn:documentation>Step 3: Field Sales/Finance build the force business case (cost vs incremental B2B revenue), obtain approval, and sequence hiring with recruitment (VS-121/VS-19.1)
Responsible (R): Head of Field Sales / Finance
Accountable (A): Head of Trade / Account Management / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4218_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4218_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4218_End7" name="Complete">
        <bpmn:incoming>W4218_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4218_Annotation8">
        <bpmn:text>Controls: - CTL-650 (ensure controlled execution — Field Sales Strategy, Territory &amp; Force Design (PA-140.1).) | - CTL-650: force sizing workload-justified; business case approved (Finance/COO)
Owner: Head of Field Sales / HR (VS-19) / Workforce Planning (VS-103.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4218_Assoc9" sourceRef="W4218_Annotation8" targetRef="W4218_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4218_Flow10" sourceRef="W4218_Start3" targetRef="W4218_Task4" />
      <bpmn:sequenceFlow id="W4218_Flow11" sourceRef="W4218_Task4" targetRef="W4218_Task5" />
      <bpmn:sequenceFlow id="W4218_Flow12" sourceRef="W4218_Task5" targetRef="W4218_Task6" />
      <bpmn:sequenceFlow id="W4218_Flow13" sourceRef="W4218_Task6" targetRef="W4218_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4218_diag">
      <bpmndi:BPMNPlane id="W4218_plane" bpmnElement="W_W4218">
        <bpmndi:BPMNShape id="W4218_Lane1_di" bpmnElement="W4218_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
