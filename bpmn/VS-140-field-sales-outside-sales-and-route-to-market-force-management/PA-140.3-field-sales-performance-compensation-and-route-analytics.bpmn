    <bpmn:process id="W_W4235" name="W4235. Pipeline Conversion, Win/Loss &amp; Sales Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics; strategy/margin review
Frequency: Monthly + quarterly
Volume: Pipeline conversion, win/loss across B2B
Owner: Sales Operations / Analytics (VS-28)
Participants: Analytics (VS-28), Regional Mgrs, Insights (VS-44), Merchandising (VS-01), Pricing (VS-57)
Source: workflow W4235 — Pipeline Conversion, Win/Loss &amp; Sales Analytics</bpmn:documentation>
      <bpmn:laneSet id="W4235_LaneSet2">
        <bpmn:lane id="W4235_Lane1" name="Sales Ops">
        <bpmn:flowNodeRef>W4235_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4235_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4235_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4235_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4235_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4235_Start3" name="Monthly analytics; strategy/margin review">
        <bpmn:outgoing>W4235_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4235_Task4" name="Sales Ops/Analytics measure pipeline metrics — conversion rate by stage…">
        <bpmn:documentation>Step 1: Sales Ops/Analytics measure pipeline metrics — conversion rate by stage, win-rate, sales-cycle length, average deal size, slip/loss reasons
Responsible (R): Sales Ops / Analytics
Accountable (A): Head of Field Sales
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4235_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4235_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4235_Task5" name="Sales Ops/Insights analyze win/loss drivers (price, availability, spec…">
        <bpmn:documentation>Step 2: Sales Ops/Insights analyze win/loss drivers (price, availability, spec, competitor, relationship — links to VS-33.3 competitive intel, VS-44 insights) and share with merchandising/pricing
Responsible (R): Sales Ops / Insights
Accountable (A): Head of Trade / Account Management
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4235_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4235_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4235_Task6" name="Sales Ops act on insights (pricing/availability/spec/enablement changes), track…">
        <bpmn:documentation>Step 3: Sales Ops act on insights (pricing/availability/spec/enablement changes), track improvement, and report to leadership (W4233)
Responsible (R): Sales Ops / Merchandising / Pricing
Accountable (A): Head of Trade / Account Management
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4235_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4235_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4235_End7" name="Complete">
        <bpmn:incoming>W4235_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4235_Annotation8">
        <bpmn:text>Controls: - CTL-652 (ensure controlled execution — Field Sales Performance, Compensation &amp; Route Analytics (PA-140.3).) | - CTL-652: win/loss reasons captured &amp; analyzed; metrics outcome-focused
Owner: Sales Operations / Analytics (VS-28)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4235_Assoc9" sourceRef="W4235_Annotation8" targetRef="W4235_Start3" associationDirection="None" />
