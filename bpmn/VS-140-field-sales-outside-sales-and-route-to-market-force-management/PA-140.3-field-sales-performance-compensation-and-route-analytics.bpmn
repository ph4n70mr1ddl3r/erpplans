      <bpmn:sequenceFlow id="W4235_Flow11" sourceRef="W4235_Task4" targetRef="W4235_Task5" />
      <bpmn:sequenceFlow id="W4235_Flow12" sourceRef="W4235_Task5" targetRef="W4235_Task6" />
      <bpmn:sequenceFlow id="W4235_Flow13" sourceRef="W4235_Task6" targetRef="W4235_End7" />
    </bpmn:process>
