    <bpmn:process id="W_W4234" name="W4234. Field Sales Compensation &amp; Incentive Administration" isExecutable="false">
      <bpmn:documentation>Trigger: Pay cycle; plan change; attainment (W4233)
Frequency: Monthly/quarterly pay + annual plan
Volume: Force-wide variable comp/commission
Owner: Compensation (VS-102) / Sales Comp Admin / Payroll (VS-19.2)
Participants: Comp (VS-102.3), Payroll (VS-19.2), Finance (VS-17.4), Sales Ops, HR (VS-19)
Source: workflow W4234 — Field Sales Compensation &amp; Incentive Administration</bpmn:documentation>
      <bpmn:laneSet id="W4234_LaneSet3">
        <bpmn:lane id="W4234_Lane1" name="Sales Comp Admin">
        <bpmn:flowNodeRef>W4234_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4234_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4234_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4234_Lane2" name="Comp">
        <bpmn:flowNodeRef>W4234_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4234_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4234_Start4" name="Pay cycle; plan change; attainment (W4233)">
        <bpmn:outgoing>W4234_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4234_Task5" name="Comp/Sales Ops compute commission/incentive from attainment (W4233) per the…">
        <bpmn:documentation>Step 1: Comp/Sales Ops compute commission/incentive from attainment (W4233) per the plan (W4221/VS-102.3), with splits/credits, caps, and margin adjustments
Responsible (R): Sales Comp Admin / Comp
Accountable (A): Head of Field Sales / Comp
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4234_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4234_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4234_Task6" name="Comp/Payroll validate, route approvals, and pay via payroll (VS-19.2), with…">
        <bpmn:documentation>Step 2: Comp/Payroll validate, route approvals, and pay via payroll (VS-19.2), with transparency (rep statement) and dispute handling
Responsible (R): Sales Comp Admin / Payroll
Accountable (A): Comp
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4234_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4234_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4234_Task7" name="Comp/Finance/HR review plan effectiveness (does it drive right behavior/ROI?)…">
        <bpmn:documentation>Step 3: Comp/Finance/HR review plan effectiveness (does it drive right behavior/ROI?), adjust annually (W4221), and govern plan change (VS-102)
Responsible (R): Comp / Finance / HR / Head of Field Sales
Accountable (A): Head of Trade / Account Management / CHRO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4234_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4234_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4234_End8" name="Complete">
        <bpmn:incoming>W4234_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4234_Annotation9">
        <bpmn:text>Controls: - CTL-652 (ensure controlled execution — Field Sales Performance, Compensation &amp; Route Analytics (PA-140.3).) | - CTL-652: comp validated &amp; transparent; plan margin-aware &amp; reviewed annually (VS-102)
Owner: Compensation (VS-102) / Sales Comp Admin / Payroll (VS-19.2)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4234_Assoc10" sourceRef="W4234_Annotation9" targetRef="W4234_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4234_Flow11" sourceRef="W4234_Start4" targetRef="W4234_Task5" />
      <bpmn:sequenceFlow id="W4234_Flow12" sourceRef="W4234_Task5" targetRef="W4234_Task6" />
      <bpmn:sequenceFlow id="W4234_Flow13" sourceRef="W4234_Task6" targetRef="W4234_Task7" />
      <bpmn:sequenceFlow id="W4234_Flow14" sourceRef="W4234_Task7" targetRef="W4234_End8" />
    </bpmn:process>
