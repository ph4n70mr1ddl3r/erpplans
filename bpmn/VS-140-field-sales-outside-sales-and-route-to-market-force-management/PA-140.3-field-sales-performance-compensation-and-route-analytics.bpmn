<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-140.3-field-sales-performance-compensation-and-route-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4233" name="W4233. Field Sales Performance &amp; Quota Attainment Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly cycle; attainment review
Frequency: Monthly + quarterly
Volume: Force-wide attainment vs quotas (W4221)
Owner: Sales Operations / Head of Field Sales
Participants: Regional Mgrs, Finance (VS-17.4), Comp (VS-102), Analytics (VS-28)
Source: workflow W4233 — Field Sales Performance &amp; Quota Attainment Management</bpmn:documentation>
      <bpmn:laneSet id="W4233_LaneSet3">
        <bpmn:lane id="W4233_Lane1" name="Sales Ops">
        <bpmn:flowNodeRef>W4233_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4233_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4233_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4233_Lane2" name="Regional Mgrs">
        <bpmn:flowNodeRef>W4233_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4233_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4233_Start4" name="Monthly/quarterly cycle; attainment review">
        <bpmn:outgoing>W4233_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4233_Task5" name="Sales Ops measure rep/territory/team attainment vs quota (W4221), and pipeline…">
        <bpmn:documentation>Step 1: Sales Ops measure rep/territory/team attainment vs quota (W4221), and pipeline coverage vs target, with margin/revenue/mix views
Responsible (R): Sales Ops / Analytics
Accountable (A): Head of Field Sales
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4233_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4233_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4233_Task6" name="Regional Mgr review attainment with reps, identify high/low performers, and…">
        <bpmn:documentation>Step 2: Regional Mgr review attainment with reps, identify high/low performers, and intervene (coaching W4238, reallocation, PIP)
Responsible (R): Regional Mgrs
Accountable (A): Head of Field Sales
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4233_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4233_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4233_Task7" name="Sales Ops report attainment/performance to leadership, feed comp (W4234) and…">
        <bpmn:documentation>Step 3: Sales Ops report attainment/performance to leadership, feed comp (W4234) and workforce planning (W4239), and adjust forecasts (W4228)
Responsible (R): Sales Ops / Finance
Accountable (A): Head of Trade / Account Management
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4233_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4233_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4233_End8" name="Complete">
        <bpmn:incoming>W4233_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4233_Annotation9">
        <bpmn:text>Controls: - CTL-652 (ensure controlled execution — Field Sales Performance, Compensation &amp; Route Analytics (PA-140.3).) | - CTL-652: attainment rules clean &amp; audited; underperformance managed (PIP)
Owner: Sales Operations / Head of Field Sales</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4233_Assoc10" sourceRef="W4233_Annotation9" targetRef="W4233_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4233_Flow11" sourceRef="W4233_Start4" targetRef="W4233_Task5" />
      <bpmn:sequenceFlow id="W4233_Flow12" sourceRef="W4233_Task5" targetRef="W4233_Task6" />
      <bpmn:sequenceFlow id="W4233_Flow13" sourceRef="W4233_Task6" targetRef="W4233_Task7" />
      <bpmn:sequenceFlow id="W4233_Flow14" sourceRef="W4233_Task7" targetRef="W4233_End8" />
    </bpmn:process>
