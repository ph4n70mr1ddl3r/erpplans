        <bpmn:outgoing>W5238_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5238_Task5" name="Receive customs duties and VAT assessment sheet from Broker (via BOC portal).">
        <bpmn:documentation>Step 1: Receive customs duties and VAT assessment sheet from Broker (via BOC portal).
Responsible (R): Import Coordinator
Accountable (A): Tax Accountant
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5238_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5238_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5238_Task6" name="Verify duties and excise-tax calculation against HS code rates and the VAT base…">
        <bpmn:documentation>Step 2: Verify duties and excise-tax calculation against HS code rates and the VAT base (12% of the BOC dutiable value plus duty, excise and other charges per NIRC §107).
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5238_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5238_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5238_Task7" name="Initiate online payment through bank portal to BOC collection account.">
        <bpmn:documentation>Step 3: Initiate online payment through bank portal to BOC collection account.
Responsible (R): Tax Accountant
Accountable (A): Tax Accountant
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5238_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5238_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5238_Task8" name="Secure bank confirmation receipt and transmit to Customs Broker.">
        <bpmn:documentation>Step 4: Secure bank confirmation receipt and transmit to Customs Broker.
Responsible (R): Import Coordinator
Accountable (A): Tax Accountant
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5238_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5238_Flow16</bpmn:outgoing>
      </bpmn:userTask>
