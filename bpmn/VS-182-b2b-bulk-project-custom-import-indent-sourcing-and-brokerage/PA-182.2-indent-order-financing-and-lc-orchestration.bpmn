Responsible (R): Freight Coordinator
Accountable (A): Freight Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5240_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5240_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5240_Task6" name="Verify container number, seal status, and destination address matching delivery…">
        <bpmn:documentation>Step 2: Verify container number, seal status, and destination address matching delivery order.
Responsible (R): Customs Broker
Accountable (A): Freight Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5240_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5240_Flow14</bpmn:outgoing>
      </bpmn:userTask>
