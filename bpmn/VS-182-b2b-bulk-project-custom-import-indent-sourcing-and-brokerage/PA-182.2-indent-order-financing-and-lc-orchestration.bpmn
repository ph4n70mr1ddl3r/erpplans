    <bpmn:process id="W_W5234" name="W5234. Pro-Forma Invoice Verification and LC Amendment Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Supplier request for LC amendment or contract adjustment
Frequency: Ad-hoc per amendment request
Volume: ~10-15 amendments processed annually
Owner: Import Buyer
Participants: Treasury Manager, B2B Sourcing Manager, Partner Bank Officer
Source: workflow W5234 — Pro-Forma Invoice Verification and LC Amendment Processing</bpmn:documentation>
      <bpmn:laneSet id="W5234_LaneSet5">
        <bpmn:lane id="W5234_Lane1" name="Import Buyer">
        <bpmn:flowNodeRef>W5234_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5234_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5234_Lane2" name="B2B Sourcing Manager">
        <bpmn:flowNodeRef>W5234_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5234_Lane3" name="Treasury Manager">
        <bpmn:flowNodeRef>W5234_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5234_Lane4" name="Partner Bank Officer">
        <bpmn:flowNodeRef>W5234_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5234_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5234_Start6" name="Supplier request for LC amendment or contract adjustment">
        <bpmn:outgoing>W5234_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5234_Task7" name="Verify validity of supplier amendment request (price change, delivery window…">
        <bpmn:documentation>Step 1: Verify validity of supplier amendment request (price change, delivery window extension).
Responsible (R): Import Buyer
Accountable (A): Import Buyer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5234_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5234_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5234_Task8" name="Calculate margin and project delivery schedule impact.">
        <bpmn:documentation>Step 2: Calculate margin and project delivery schedule impact.
Responsible (R): B2B Sourcing Manager
Accountable (A): Import Buyer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5234_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5234_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5234_Task9" name="Submit approved amendment request to bank and pay amendment fees.">
        <bpmn:documentation>Step 3: Submit approved amendment request to bank and pay amendment fees.
Responsible (R): Treasury Manager
Accountable (A): Import Buyer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5234_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5234_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5234_Task10" name="Transmit bank SWIFT amendment notice to supplier bank.">
        <bpmn:documentation>Step 4: Transmit bank SWIFT amendment notice to supplier bank.
Responsible (R): Partner Bank Officer
Accountable (A): Import Buyer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5234_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5234_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5234_End11" name="Complete">
        <bpmn:incoming>W5234_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5234_Annotation12">
        <bpmn:text>Controls: - CTL-01: Prevent unauthorized purchases; CFO approval required for amendments affecting price or margin.
Owner: Import Buyer</bpmn:text>
      </bpmn:textAnnotation>
