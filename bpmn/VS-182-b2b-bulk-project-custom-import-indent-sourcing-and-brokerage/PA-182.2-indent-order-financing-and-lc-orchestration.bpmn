    <bpmn:process id="W_W5239" name="W5239. Bureau of Customs Formal Entry Filing and Single Administrative Document Release" isExecutable="false">
      <bpmn:documentation>Trigger: Goods arrival at port / LC availability (W5236); formal entry due before release
Frequency: Per customs clearing cycle
Volume: ~40-50 clearances annually
Owner: Customs Broker Coordinator
Participants: In-house Customs Broker (VS-02.2), BOC Inspector
Source: workflow W5239 — Bureau of Customs Formal Entry Filing and Single Administrative Document Release</bpmn:documentation>
      <bpmn:laneSet id="W5239_LaneSet3">
        <bpmn:lane id="W5239_Lane1" name="Customs Broker Coordinator">
