Responsible (R): Freight Coordinator
Accountable (A): Freight Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5240_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5240_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5240_Task8" name="Update container status in import control tower system.">
        <bpmn:documentation>Step 4: Update container status in import control tower system.
Responsible (R): Freight Coordinator
Accountable (A): Freight Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5240_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5240_Flow16</bpmn:outgoing>
