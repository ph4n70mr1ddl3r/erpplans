    <bpmn:process id="W_W5233" name="W5233. Letter of Credit Opening and Trade Finance Allocation for Indent Orders" isExecutable="false">
      <bpmn:documentation>Trigger: Signed contract (W5228) and downpayment clearance (W5229)
Frequency: Per contract execution
Volume: ~40-50 LCs opened annually
Owner: Treasury Manager
Participants: Import Buyer, Finance Controller (VS-17.4), Partner Bank Officer
Source: workflow W5233 — Letter of Credit Opening and Trade Finance Allocation for Indent Orders</bpmn:documentation>
      <bpmn:laneSet id="W5233_LaneSet5">
        <bpmn:lane id="W5233_Lane1" name="Import Buyer">
        <bpmn:flowNodeRef>W5233_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5233_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5233_Lane2" name="Treasury Manager">
        <bpmn:flowNodeRef>W5233_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5233_Lane3" name="Finance Controller">
        <bpmn:flowNodeRef>W5233_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5233_Lane4" name="Partner Bank Officer">
        <bpmn:flowNodeRef>W5233_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5233_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5233_Start6" name="Signed contract (W5228) and downpayment clearance (W5229)">
        <bpmn:outgoing>W5233_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5233_Task7" name="Submit LC application packet to partner bank matching contract terms.">
        <bpmn:documentation>Step 1: Submit LC application packet to partner bank matching contract terms.
Responsible (R): Import Buyer
Accountable (A): Treasury Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5233_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5233_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5233_Task8" name="Allocate trade credit facility limit and reserve funding availability.">
        <bpmn:documentation>Step 2: Allocate trade credit facility limit and reserve funding availability.
Responsible (R): Treasury Manager
Accountable (A): Treasury Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5233_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5233_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5233_Task9" name="Review LC draft with Legal Operations (VS-100) to verify payment conditions.">
        <bpmn:documentation>Step 3: Review LC draft with Legal Operations (VS-100) to verify payment conditions.
Responsible (R): Finance Controller
Accountable (A): Treasury Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5233_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5233_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5233_Task10" name="Confirm bank issuance of LC and transmit SWIFT message to supplier.">
        <bpmn:documentation>Step 4: Confirm bank issuance of LC and transmit SWIFT message to supplier.
Responsible (R): Partner Bank Officer
Accountable (A): Treasury Manager
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5233_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5233_Flow18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5233_End11" name="Complete">
        <bpmn:incoming>W5233_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5233_Annotation12">
        <bpmn:text>Controls: - CTL-01: Prevent unauthorized purchases; Treasury Director check-off on credit facilities.
Owner: Treasury Manager</bpmn:text>
      </bpmn:textAnnotation>
