    <bpmn:process id="W_W5235" name="W5235. Shipping Document Receipt Discrepancy Auditing and Bank Release" isExecutable="false">
      <bpmn:documentation>Trigger: Vessel departure notification and doc submission to bank
Frequency: Per shipment dispatch
Volume: ~40-50 document reviews annually
Owner: Import Coordinator
Participants: Customs Broker Coordinator, Treasury Specialist, Partner Bank Auditor
Source: workflow W5235 — Shipping Document Receipt Discrepancy Auditing and Bank Release</bpmn:documentation>
      <bpmn:laneSet id="W5235_LaneSet3">
        <bpmn:lane id="W5235_Lane1" name="Import Coordinator">
        <bpmn:flowNodeRef>W5235_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5235_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5235_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5235_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5235_Lane2" name="Treasury Specialist">
        <bpmn:flowNodeRef>W5235_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5235_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5235_Start4" name="Vessel departure notification and doc submission to bank">
        <bpmn:outgoing>W5235_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5235_Task5" name="Receive shipping documents (Bill of Lading, Invoice, Packing List, Certificate…">
        <bpmn:documentation>Step 1: Receive shipping documents (Bill of Lading, Invoice, Packing List, Certificate of Origin, PSI).
Responsible (R): Import Coordinator
Accountable (A): Import Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5235_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5235_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5235_Task6" name="Audit documents for consistency: exact matching of quantities, descriptions…">
        <bpmn:documentation>Step 2: Audit documents for consistency: exact matching of quantities, descriptions, weights, and LC terms.
Responsible (R): Import Coordinator
Accountable (A): Import Coordinator
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5235_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5235_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5235_Task7" name="Authorize bank to release shipping documents to Customs Broker upon zero…">
        <bpmn:documentation>Step 3: Authorize bank to release shipping documents to Customs Broker upon zero discrepancies.
Responsible (R): Treasury Specialist
Accountable (A): Import Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5235_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5235_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5235_Task8" name="Reconcile bank document fees and record in import ledger.">
        <bpmn:documentation>Step 4: Reconcile bank document fees and record in import ledger.
Responsible (R): Import Coordinator
Accountable (A): Import Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5235_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5235_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5235_End9" name="Complete">
        <bpmn:incoming>W5235_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5235_Annotation10">
        <bpmn:text>Controls: - CTL-14: 3-way match validation controls; Import Director verification signature.
Owner: Import Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5235_Assoc11" sourceRef="W5235_Annotation10" targetRef="W5235_Start4" associationDirection="None" />
