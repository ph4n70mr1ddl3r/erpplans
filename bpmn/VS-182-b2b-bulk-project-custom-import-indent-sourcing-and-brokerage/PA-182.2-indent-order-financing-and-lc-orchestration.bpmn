      <bpmn:startEvent id="W5239_Start4" name="Goods arrival at port / LC availability (W5236); formal entry due before release">
        <bpmn:outgoing>W5239_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5239_Task5" name="File formal import entry (Single Administrative Document - SAD) in BOC e2m…">
        <bpmn:documentation>Step 1: File formal import entry (Single Administrative Document - SAD) in BOC e2m system; the BOC assessment it returns triggers duty/VAT payment per W5238.
Responsible (R): Customs Broker Coordinator
Accountable (A): Customs Broker Coordinator
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5239_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5239_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5239_Task6" name="Coordinate physical container inspection (BOC Red Lane if triggered).">
        <bpmn:documentation>Step 2: Coordinate physical container inspection (BOC Red Lane if triggered).
Responsible (R): In-house Customs Broker
Accountable (A): Customs Broker Coordinator
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5239_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5239_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5239_Task7" name="Verify duties/VAT paid per W5238 and assessment cleared, then secure Gate-Pass…">
        <bpmn:documentation>Step 3: Verify duties/VAT paid per W5238 and assessment cleared, then secure Gate-Pass approval from port operator.
Responsible (R): Customs Broker Coordinator
Accountable (A): Customs Broker Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5239_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5239_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5239_Task8" name="Download and file approved SAD in import document repository.">
        <bpmn:documentation>Step 4: Download and file approved SAD in import document repository.
Responsible (R): Customs Broker Coordinator
Accountable (A): Customs Broker Coordinator
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5239_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5239_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5239_End9" name="Complete">
