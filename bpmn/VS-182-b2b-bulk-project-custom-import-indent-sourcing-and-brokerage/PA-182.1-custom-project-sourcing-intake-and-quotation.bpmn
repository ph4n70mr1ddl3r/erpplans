    <bpmn:process id="W_W5232" name="W5232. Pre-Shipment Inspection Coordination and Quality Gate Sign-off" isExecutable="false">
      <bpmn:documentation>Trigger: Supplier notification of production completion
Frequency: Per completed production order
Volume: ~40-50 inspections coordinated annually
Owner: Quality Assurance Manager
Participants: Supplier Quality Liaison, Third-Party Inspector, B2B Sourcing Manager
Source: workflow W5232 — Pre-Shipment Inspection Coordination and Quality Gate Sign-off</bpmn:documentation>
      <bpmn:laneSet id="W5232_LaneSet4">
        <bpmn:lane id="W5232_Lane1" name="Supplier Quality Liaison">
        <bpmn:flowNodeRef>W5232_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5232_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5232_Lane2" name="Quality Assurance Manager">
        <bpmn:flowNodeRef>W5232_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5232_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5232_Lane3" name="B2B Sourcing Manager">
        <bpmn:flowNodeRef>W5232_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5232_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5232_Start5" name="Supplier notification of production completion">
        <bpmn:outgoing>W5232_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5232_Task6" name="Schedule third-party inspection (SGS, TUV, Bureau Veritas) at foreign factory…">
        <bpmn:documentation>Step 1: Schedule third-party inspection (SGS, TUV, Bureau Veritas) at foreign factory location.
Responsible (R): Supplier Quality Liaison
Accountable (A): Quality Assurance Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5232_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5232_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5232_Task7" name="Review Pre-Shipment Inspection (PSI) report against specifications and approved…">
        <bpmn:documentation>Step 2: Review Pre-Shipment Inspection (PSI) report against specifications and approved samples.
Responsible (R): Quality Assurance Manager
Accountable (A): Quality Assurance Manager
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5232_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5232_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5232_Task8" name="Issue &quot;Release for Shipment&quot; certificate in ERP upon satisfactory PSI report.">
        <bpmn:documentation>Step 3: Issue &quot;Release for Shipment&quot; certificate in ERP upon satisfactory PSI report.
Responsible (R): Quality Assurance Manager
Accountable (A): Quality Assurance Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5232_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5232_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5232_Task9" name="Authorize final container booking request with logistics partners.">
        <bpmn:documentation>Step 4: Authorize final container booking request with logistics partners.
Responsible (R): B2B Sourcing Manager
Accountable (A): Quality Assurance Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5232_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5232_End10" name="Complete">
        <bpmn:incoming>W5232_Flow17</bpmn:incoming>
      </bpmn:endEvent>
