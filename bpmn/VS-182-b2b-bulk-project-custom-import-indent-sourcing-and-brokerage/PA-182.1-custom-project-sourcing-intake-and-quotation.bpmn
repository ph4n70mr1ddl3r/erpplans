        <bpmn:documentation>Step 1: Identify qualified overseas suppliers and transmit RFQ package.
Responsible (R): Import Buyer
Accountable (A): Import Buyer
Duration: 2-3 hours</bpmn:documentation>
        <bpmn:incoming>W5226_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5226_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5226_Task7" name="Review factory capability and ISO/accreditation records with Global Sourcing…">
        <bpmn:documentation>Step 2: Review factory capability and ISO/accreditation records with Global Sourcing Agent.
Responsible (R): Global Sourcing Agent
Accountable (A): Import Buyer
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5226_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5226_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5226_Task8" name="Request prototype/production samples and track air-freight delivery.">
        <bpmn:documentation>Step 3: Request prototype/production samples and track air-freight delivery.
Responsible (R): Import Buyer
Accountable (A): Import Buyer
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5226_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5226_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5226_Task9" name="Conduct physical and structural testing on received samples; issue sample…">
