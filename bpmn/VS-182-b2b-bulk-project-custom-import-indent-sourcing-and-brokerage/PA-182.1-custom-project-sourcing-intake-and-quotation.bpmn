    <bpmn:process id="W_W5225" name="W5225. B2B Project Custom Sourcing Intake and Specifications Scoping" isExecutable="false">
      <bpmn:documentation>Trigger: B2B key account customer submits request for custom/bulk imported materials (VS-107, VS-11)
Frequency: Ad-hoc per project request
Volume: ~80-120 custom inquiries annually
Owner: B2B Sourcing Manager
Participants: Key Account Manager, Customer Project Design Specialist (VS-66), Technical Standards Officer (VS-117)
Source: workflow W5225 — B2B Project Custom Sourcing Intake and Specifications Scoping</bpmn:documentation>
      <bpmn:laneSet id="W5225_LaneSet4">
        <bpmn:lane id="W5225_Lane1" name="Key Account Manager">
        <bpmn:flowNodeRef>W5225_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5225_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
