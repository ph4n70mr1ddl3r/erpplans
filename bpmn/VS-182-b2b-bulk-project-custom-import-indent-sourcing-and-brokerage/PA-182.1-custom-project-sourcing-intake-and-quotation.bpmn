    <bpmn:process id="W_W5226" name="W5226. Overseas Supplier RFQ Factory Vetting and Sample Approval" isExecutable="false">
      <bpmn:documentation>Trigger: Approved specifications sheet (W5225)
Frequency: Per verified custom project inquiry
Volume: ~60-80 RFQs sent annually
Owner: Import Buyer
Participants: B2B Sourcing Manager, Global Sourcing Agent (VS-122), Quality Inspector (VS-31)
Source: workflow W5226 — Overseas Supplier RFQ Factory Vetting and Sample Approval</bpmn:documentation>
      <bpmn:laneSet id="W5226_LaneSet4">
        <bpmn:lane id="W5226_Lane1" name="Import Buyer">
        <bpmn:flowNodeRef>W5226_Task6</bpmn:flowNodeRef>
