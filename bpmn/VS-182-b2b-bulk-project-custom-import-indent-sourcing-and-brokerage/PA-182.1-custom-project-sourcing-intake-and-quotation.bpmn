    <bpmn:process id="W_W5227" name="W5227. Project Landing Cost Calculation Pricing and Margin Matrix Modeling" isExecutable="false">
      <bpmn:documentation>Trigger: Approved sample evaluation report (W5226)
Frequency: Per approved sample
Volume: ~50-60 cost models generated annually
Owner: Logistics Finance Analyst
Participants: Import Buyer, Category Manager (VS-01.2), Freight Coordinator (VS-110)
Source: workflow W5227 — Project Landing Cost Calculation Pricing and Margin Matrix Modeling</bpmn:documentation>
      <bpmn:laneSet id="W5227_LaneSet4">
        <bpmn:lane id="W5227_Lane1" name="Import Buyer">
        <bpmn:flowNodeRef>W5227_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5227_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5227_Lane2" name="Logistics Finance Analyst">
        <bpmn:flowNodeRef>W5227_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5227_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5227_Lane3" name="Category Manager">
        <bpmn:flowNodeRef>W5227_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5227_End10</bpmn:flowNodeRef>
