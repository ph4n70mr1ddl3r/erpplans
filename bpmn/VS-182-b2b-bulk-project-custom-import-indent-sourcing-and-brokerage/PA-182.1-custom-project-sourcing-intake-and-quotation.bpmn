        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5225_Start5" name="B2B key account customer submits request for custom/bulk imported materials (VS-107…">
        <bpmn:outgoing>W5225_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5225_Task6" name="Receive custom material specifications from client.">
        <bpmn:documentation>Step 1: Receive custom material specifications from client.
Responsible (R): Key Account Manager
Accountable (A): B2B Sourcing Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5225_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5225_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5225_Task7" name="Review technical feasibility and local regulatory compliance (BPS standards)…">
        <bpmn:documentation>Step 2: Review technical feasibility and local regulatory compliance (BPS standards) with Technical Standards Officer.
Responsible (R): Customer Project Design Specialist
Accountable (A): B2B Sourcing Manager
Duration: 2-4 hours</bpmn:documentation>
        <bpmn:incoming>W5225_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5225_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5225_Task8" name="Define final technical scope, packaging requirements, and target jobsite…">
        <bpmn:documentation>Step 3: Define final technical scope, packaging requirements, and target jobsite delivery dates.
Responsible (R): B2B Sourcing Manager
Accountable (A): B2B Sourcing Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5225_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5225_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5225_Task9" name="Upload specifications sheet to ERP custom sourcing module.">
        <bpmn:documentation>Step 4: Upload specifications sheet to ERP custom sourcing module.
Responsible (R): B2B Sourcing Manager
Accountable (A): B2B Sourcing Manager
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W5225_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5225_End10" name="Complete">
        <bpmn:incoming>W5225_Flow17</bpmn:incoming>
      </bpmn:endEvent>
