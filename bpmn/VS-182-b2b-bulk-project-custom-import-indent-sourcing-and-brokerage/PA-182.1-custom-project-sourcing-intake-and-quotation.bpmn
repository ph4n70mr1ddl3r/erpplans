    <bpmn:process id="W_W5231" name="W5231. Production Scheduling and Weekly Factory Progress Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Executed Quality Agreement (W5230)
Frequency: Weekly during production cycle
Volume: ~10-15 active production lines monitored weekly
Owner: Supplier Quality Liaison / Global Sourcing Coordinator
Participants: Import Buyer, Global Sourcing Agent (VS-122)
Source: workflow W5231 — Production Scheduling and Weekly Factory Progress Verification</bpmn:documentation>
      <bpmn:laneSet id="W5231_LaneSet3">
        <bpmn:lane id="W5231_Lane1" name="Supplier Quality Liaison">
