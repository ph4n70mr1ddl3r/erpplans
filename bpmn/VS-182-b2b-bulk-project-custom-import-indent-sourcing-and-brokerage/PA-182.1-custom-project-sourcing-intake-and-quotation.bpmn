      <bpmn:startEvent id="W5231_Start4" name="Executed Quality Agreement (W5230)">
        <bpmn:outgoing>W5231_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5231_Task5" name="Request weekly production status report and photo/video evidence from supplier.">
        <bpmn:documentation>Step 1: Request weekly production status report and photo/video evidence from supplier.
Responsible (R): Supplier Quality Liaison
Accountable (A): Supplier Quality Liaison / Global Sourcing Coordinator
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W5231_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5231_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5231_Task6" name="Verify production milestone dates (raw material cutting, assembly, finishing).">
