    <bpmn:process id="W_W2236" name="W2236. Pricing System &amp; Master Data Accuracy" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly data quality audit
Frequency: Monthly; 35,000 SKUs
Volume: ~35,000 price records
Owner: IT System Admin / Pricing Analyst
Participants: — (system-executed audit; owner roles only)
Source: workflow W2236 — Pricing System &amp; Master Data Accuracy</bpmn:documentation>
      <bpmn:laneSet id="W2236_LaneSet2">
        <bpmn:lane id="W2236_Lane1" name="System">
