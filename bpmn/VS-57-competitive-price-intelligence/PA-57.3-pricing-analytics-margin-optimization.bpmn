    <bpmn:process id="W_W2232" name="W2232. Vendor Cost-Driven Price Adjustment" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor cost change
Frequency: ~5–10/month
Volume: ~5–10 reviews/month
Owner: Category Manager
Participants: VP Merchandising
Source: workflow W2232 — Vendor Cost-Driven Price Adjustment</bpmn:documentation>
      <bpmn:laneSet id="W2232_LaneSet2">
        <bpmn:lane id="W2232_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2232_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2232_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2232_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2232_Start3" name="Vendor cost change">
        <bpmn:outgoing>W2232_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2232_Task4" name="Vendor notifies cost change; Category Manager evaluates: pass-through (raise…">
        <bpmn:documentation>Step 1: Vendor notifies cost change; Category Manager evaluates: pass-through (raise price), absorb (hold price, accept margin compression), or negotiate (challenge the cost increase); executes the decision
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 1–2 hours/review</bpmn:documentation>
        <bpmn:incoming>W2232_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2232_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2232_End5" name="Complete">
        <bpmn:incoming>W2232_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2232_Annotation6">
        <bpmn:text>Controls: - CTL-402 (ensure controlled execution — Pricing Analytics &amp; Margin Optimization (PA-57.3).) | - CTL-402 (price-change authorization); CTL-115 (vendor-cost accuracy — links to VS-158); operational: VP Merchandising sign-off on absorb decisions
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2232_Assoc7" sourceRef="W2232_Annotation6" targetRef="W2232_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2232_Flow8" sourceRef="W2232_Start3" targetRef="W2232_Task4" />
      <bpmn:sequenceFlow id="W2232_Flow9" sourceRef="W2232_Task4" targetRef="W2232_End5" />
    </bpmn:process>
