    <bpmn:process id="W_W2233" name="W2233. Pricing Strategy Annual Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual comprehensive review
Frequency: Annual; all 13 categories
Volume: Full category pricing strategy
Owner: VP Merchandising
Participants: COO
Source: workflow W2233 — Pricing Strategy Annual Review</bpmn:documentation>
      <bpmn:laneSet id="W2233_LaneSet2">
        <bpmn:lane id="W2233_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W2233_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2233_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2233_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2233_Start3" name="Annual comprehensive review">
        <bpmn:outgoing>W2233_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2233_Task4" name="VP Merchandising reviews the full pricing strategy: positioning, elasticity…">
        <bpmn:documentation>Step 1: VP Merchandising reviews the full pricing strategy: positioning, elasticity, competitive position, margin, promo effectiveness; incorporates the year&#x27;s analytics; recommends next-year strategy
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2233_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2233_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2233_End5" name="Complete">
        <bpmn:incoming>W2233_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2233_Annotation6">
        <bpmn:text>Controls: - CTL-402 (ensure controlled execution — Pricing Analytics &amp; Margin Optimization (PA-57.3).) | - Operational: COO sign-off on the strategy
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2233_Assoc7" sourceRef="W2233_Annotation6" targetRef="W2233_Start3" associationDirection="None" />
