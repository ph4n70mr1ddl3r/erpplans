    <bpmn:process id="W_W2231" name="W2231. Price Sensitivity Dashboard" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly update cycle — Price Sensitivity
Frequency: Weekly; ~100 key SKUs
Volume: ~100 SKUs monitored
Owner: Pricing Analyst
Participants: Category Manager
Source: workflow W2231 — Price Sensitivity Dashboard</bpmn:documentation>
      <bpmn:laneSet id="W2231_LaneSet2">
        <bpmn:lane id="W2231_Lane1" name="System">
        <bpmn:flowNodeRef>W2231_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2231_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2231_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2231_Start3" name="Weekly update cycle — Price Sensitivity">
        <bpmn:outgoing>W2231_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2231_Task4" name="Dashboard tracks the ~100 key SKUs: current price, competitor price, price gap…">
        <bpmn:documentation>Step 1: Dashboard tracks the ~100 key SKUs: current price, competitor price, price gap, volume trend, margin; flags SKUs where the gap or the volume-trend warrants action
Responsible (R): System / Pricing Analyst
Accountable (A): Category Manager
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2231_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2231_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2231_End5" name="Complete">
        <bpmn:incoming>W2231_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2231_Annotation6">
        <bpmn:text>Controls: - CTL-402 (ensure controlled execution — Pricing Analytics &amp; Margin Optimization (PA-57.3).) | - Operational: Category Manager weekly review
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2231_Assoc7" sourceRef="W2231_Annotation6" targetRef="W2231_Start3" associationDirection="None" />
