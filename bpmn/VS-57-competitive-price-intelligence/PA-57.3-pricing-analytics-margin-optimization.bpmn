    <bpmn:process id="W_W2237" name="W2237. Cross-Channel Price Consistency" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly consistency check
Frequency: Weekly; POS, ecommerce, marketplace
Volume: 3 channels × ~35,000 SKUs
Owner: Ecommerce Operations Manager
Participants: Ecom Ops Manager, VP Marketing
Source: workflow W2237 — Cross-Channel Price Consistency</bpmn:documentation>
      <bpmn:laneSet id="W2237_LaneSet2">
        <bpmn:lane id="W2237_Lane1" name="System">
        <bpmn:flowNodeRef>W2237_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2237_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2237_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2237_Start3" name="Weekly consistency check">
        <bpmn:outgoing>W2237_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2237_Task4" name="System compares prices across POS, ecommerce, and marketplace channels; flags…">
        <bpmn:documentation>Step 1: System compares prices across POS, ecommerce, and marketplace channels; flags inconsistencies; Ecom Ops Manager investigates root cause (sync error, channel-specific override, marketplace feed lag); remediates
Responsible (R): System / Ecom Ops Manager
Accountable (A): VP Marketing
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2237_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2237_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
