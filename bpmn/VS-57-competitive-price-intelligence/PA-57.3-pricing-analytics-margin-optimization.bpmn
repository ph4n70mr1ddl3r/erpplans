    <bpmn:process id="W_W2234" name="W2234. Promotional Pricing ROI Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Post-promotional analysis
Frequency: 18 analyses/year
Volume: 18/year
Owner: FP&amp;A Analyst
Participants: CFO
Source: workflow W2234 — Promotional Pricing ROI Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2234_LaneSet2">
        <bpmn:lane id="W2234_Lane1" name="FP&amp;A Analyst">
        <bpmn:flowNodeRef>W2234_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2234_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2234_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2234_Start3" name="Post-promotional analysis">
        <bpmn:outgoing>W2234_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2234_Task4" name="FP&amp;A computes the promo ROI: incremental sales vs. baseline, promo cost…">
        <bpmn:documentation>Step 1: FP&amp;A computes the promo ROI: incremental sales vs. baseline, promo cost (discount + marketing), margin impact, halo effect; recommends next-promo adjustments
Responsible (R): FP&amp;A Analyst
Accountable (A): CFO
Duration: 4–6 hours/promo</bpmn:documentation>
        <bpmn:incoming>W2234_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2234_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2234_End5" name="Complete">
        <bpmn:incoming>W2234_Flow9</bpmn:incoming>
      </bpmn:endEvent>
