    <bpmn:process id="W_W2235" name="W2235. Price Image &amp; Customer Perception Survey" isExecutable="false">
      <bpmn:documentation>Trigger: Semi-annual survey cycle — Price Image
Frequency: Semi-annual; ~1,000 respondents
Volume: ~1,000 respondents
Owner: Marketing Research Manager
Participants: Marketing Research Mgr, VP Marketing
Source: workflow W2235 — Price Image &amp; Customer Perception Survey</bpmn:documentation>
      <bpmn:laneSet id="W2235_LaneSet2">
        <bpmn:lane id="W2235_Lane1" name="Marketing Research Mgr">
        <bpmn:flowNodeRef>W2235_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2235_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2235_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2235_Start3" name="Semi-annual survey cycle — Price Image">
        <bpmn:outgoing>W2235_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2235_Task4" name="Survey: customer perception of BuildRight&#x27;s price image…">
        <bpmn:documentation>Step 1: Survey: customer perception of BuildRight&#x27;s price image (expensive/competitive/cheap), price-vs-competitor perception, value-for-money; informs the pricing strategy and the basket-positioning
Responsible (R): Marketing Research Mgr
Accountable (A): VP Marketing
Duration: 2–3 days/semi-annual</bpmn:documentation>
        <bpmn:incoming>W2235_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2235_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2235_End5" name="Complete">
        <bpmn:incoming>W2235_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2235_Annotation6">
        <bpmn:text>Controls: - CTL-402 (ensure controlled execution — Pricing Analytics &amp; Margin Optimization (PA-57.3).) | - Operational: Marketing Research Manager methodology sign-off; VP Marketing review
Owner: Marketing Research Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2235_Assoc7" sourceRef="W2235_Annotation6" targetRef="W2235_Start3" associationDirection="None" />
