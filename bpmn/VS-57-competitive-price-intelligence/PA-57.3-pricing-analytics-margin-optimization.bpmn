    <bpmn:process id="W_W2230" name="W2230. Gross Margin Analysis by Category" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly financial analysis
Frequency: Monthly; 13 categories
Volume: 13 category analyses
Owner: Finance Manager
Participants: CFO
Source: workflow W2230 — Gross Margin Analysis by Category</bpmn:documentation>
      <bpmn:laneSet id="W2230_LaneSet2">
        <bpmn:lane id="W2230_Lane1" name="Finance Manager">
        <bpmn:flowNodeRef>W2230_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2230_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2230_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2230_Start3" name="Monthly financial analysis">
        <bpmn:outgoing>W2230_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2230_Task4" name="Finance Manager analyzes gross margin by category: revenue, COGS, markdowns…">
        <bpmn:documentation>Step 1: Finance Manager analyzes gross margin by category: revenue, COGS, markdowns, net margin %; identifies margin-eroding categories and recommends pricing/cost actions
Responsible (R): Finance Manager
Accountable (A): CFO
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2230_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2230_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2230_End5" name="Complete">
        <bpmn:incoming>W2230_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2230_Annotation6">
        <bpmn:text>Controls: - CTL-402 (ensure controlled execution — Pricing Analytics &amp; Margin Optimization (PA-57.3).) | - CTL-402 (cost-of-goods accuracy — links to VS-158); operational: CFO monthly sign-off
Owner: Finance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2230_Assoc7" sourceRef="W2230_Annotation6" targetRef="W2230_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2230_Flow8" sourceRef="W2230_Start3" targetRef="W2230_Task4" />
      <bpmn:sequenceFlow id="W2230_Flow9" sourceRef="W2230_Task4" targetRef="W2230_End5" />
    </bpmn:process>
