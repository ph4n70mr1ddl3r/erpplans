      <bpmn:startEvent id="W2236_Start3" name="Monthly data quality audit">
        <bpmn:outgoing>W2236_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2236_Task4" name="System runs monthly data-quality checks on the pricing master: missing prices…">
        <bpmn:documentation>Step 1: System runs monthly data-quality checks on the pricing master: missing prices, expired prices, anomalous prices (&gt;50% deviation from prior), orphaned SKUs; Pricing Analyst remediates
Responsible (R): System / Pricing Analyst
Accountable (A): IT System Admin
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2236_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2236_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2236_End5" name="Complete">
        <bpmn:incoming>W2236_Flow9</bpmn:incoming>
      </bpmn:endEvent>
