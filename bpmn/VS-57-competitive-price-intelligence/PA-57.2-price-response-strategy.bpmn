        <bpmndi:BPMNShape id="W2222_Start3_di" bpmnElement="W2222_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2222_End5_di" bpmnElement="W2222_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2222_Annotation6_di" bpmnElement="W2222_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2222_Flow8_di" bpmnElement="W2222_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2222_Flow9_di" bpmnElement="W2222_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2222_Assoc7_di" bpmnElement="W2222_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2223" name="W2223. Promotional Price Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Upcoming promotional calendar event
Frequency: 6 major + 12 monthly per year
Volume: ~18 cycles/year
Owner: Pricing Analyst
Participants: Category Manager
Source: workflow W2223 — Promotional Price Planning</bpmn:documentation>
      <bpmn:laneSet id="W2223_LaneSet2">
        <bpmn:lane id="W2223_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2223_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2223_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2223_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2223_Start3" name="Upcoming promotional calendar event">
        <bpmn:outgoing>W2223_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2223_Task4" name="Pricing Analyst plans the promo pricing: discount depth, duration, eligible…">
        <bpmn:documentation>Step 1: Pricing Analyst plans the promo pricing: discount depth, duration, eligible SKUs, competitive counter-positioning; configures in the pricing master and promo system; coordinates with Marketing for the campaign
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 1–2 days/cycle</bpmn:documentation>
        <bpmn:incoming>W2223_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2223_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2223_End5" name="Complete">
        <bpmn:incoming>W2223_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2223_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) | - CTL-401 (promo-price authorization); CTL-283 (DTI promo-permit compliance — review per W833); operational: Category Manager sign-off
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2223_Assoc7" sourceRef="W2223_Annotation6" targetRef="W2223_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2223_Flow8" sourceRef="W2223_Start3" targetRef="W2223_Task4" />
      <bpmn:sequenceFlow id="W2223_Flow9" sourceRef="W2223_Task4" targetRef="W2223_End5" />
    </bpmn:process>
