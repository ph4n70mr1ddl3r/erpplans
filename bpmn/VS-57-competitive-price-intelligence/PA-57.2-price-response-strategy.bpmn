    <bpmn:process id="W_W2227" name="W2227. Trade Price Competitive Alignment" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly trade price review
Frequency: Quarterly; ~5,200 trade accounts
Volume: ~5,200 accounts
Owner: Trade Sales Manager
Participants: Head of Trade / Account Management
Source: workflow W2227 — Trade Price Competitive Alignment</bpmn:documentation>
      <bpmn:laneSet id="W2227_LaneSet2">
        <bpmn:lane id="W2227_Lane1" name="Trade Sales Manager">
        <bpmn:flowNodeRef>W2227_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2227_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2227_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2227_Start3" name="Quarterly trade price review">
        <bpmn:outgoing>W2227_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2227_Task4" name="Trade Sales Manager reviews trade-account pricing tiers vs. competitor trade…">
        <bpmn:documentation>Step 1: Trade Sales Manager reviews trade-account pricing tiers vs. competitor trade pricing; adjusts tier discounts to maintain the trade-account value proposition
Responsible (R): Trade Sales Manager
Accountable (A): Head of Trade / Account Management
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2227_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2227_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2227_End5" name="Complete">
        <bpmn:incoming>W2227_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2227_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) | - CTL-401 (trade-pricing authorization — links to VS-11); operational: Head of Trade / Account Management sign-off
Owner: Trade Sales Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2227_Assoc7" sourceRef="W2227_Annotation6" targetRef="W2227_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2227_Flow8" sourceRef="W2227_Start3" targetRef="W2227_Task4" />
