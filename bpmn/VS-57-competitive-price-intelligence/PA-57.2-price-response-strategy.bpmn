      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2224" name="W2224. Markdown Optimization for Clearance" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-season or slow-moving inventory
Frequency: Monthly; ~500–1,000 markdown decisions
Volume: ~500–1,000/month
Owner: Category Manager
Participants: VP Merchandising
Source: workflow W2224 — Markdown Optimization for Clearance</bpmn:documentation>
      <bpmn:laneSet id="W2224_LaneSet2">
        <bpmn:lane id="W2224_Lane1" name="System">
        <bpmn:flowNodeRef>W2224_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2224_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2224_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2224_Start3" name="End-of-season or slow-moving inventory">
        <bpmn:outgoing>W2224_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2224_Task4" name="System recommends markdown depth per SKU based on sell-through…">
        <bpmn:documentation>Step 1: System recommends markdown depth per SKU based on sell-through, weeks-of-supply, and residual value; Category Manager approves; executes in pricing master
Responsible (R): System / Category Manager
Accountable (A): VP Merchandising
Duration: Automated + 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2224_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2224_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2224_End5" name="Complete">
        <bpmn:incoming>W2224_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2224_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) | - CTL-401 (price-change authorization); CTL-108 (margin-floor / stop-loss); operational: Category Manager monthly sign-off
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2224_Assoc7" sourceRef="W2224_Annotation6" targetRef="W2224_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2224_Flow8" sourceRef="W2224_Start3" targetRef="W2224_Task4" />
      <bpmn:sequenceFlow id="W2224_Flow9" sourceRef="W2224_Task4" targetRef="W2224_End5" />
    </bpmn:process>
