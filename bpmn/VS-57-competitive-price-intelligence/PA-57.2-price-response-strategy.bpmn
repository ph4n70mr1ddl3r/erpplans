    <bpmn:process id="W_W2226" name="W2226. Price Change Communication to Stores" isExecutable="false">
      <bpmn:documentation>Trigger: Price change approved
Frequency: ~200–300 changes/month
Volume: ~200–300/month
Owner: Merchandising Coordinator
Participants: Merchandising Planner
Source: workflow W2226 — Price Change Communication to Stores</bpmn:documentation>
      <bpmn:laneSet id="W2226_LaneSet2">
        <bpmn:lane id="W2226_Lane1" name="System">
        <bpmn:flowNodeRef>W2226_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2226_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2226_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2226_Start3" name="Price change approved">
        <bpmn:outgoing>W2226_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2226_Task4" name="System auto-pushes the price change to POS and ecommerce; generates shelf…">
        <bpmn:documentation>Step 1: System auto-pushes the price change to POS and ecommerce; generates shelf labels; Merchandising Coordinator distributes the change notification to stores with deadline for label application
Responsible (R): System / Merch Coordinator
Accountable (A): Merchandising Planner
Duration: Automated + 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2226_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2226_Flow9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2226_End5" name="Complete">
        <bpmn:incoming>W2226_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2226_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) — price-distribution integrity incl. duplicate-change guard; operational: Merchandising Coordinator sign-off
Owner: Merchandising Coordinator</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2226_Assoc7" sourceRef="W2226_Annotation6" targetRef="W2226_Start3" associationDirection="None" />
