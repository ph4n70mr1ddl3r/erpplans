<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-57.2-price-response-strategy" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2222" name="W2222. Rapid Price Response Workflow" isExecutable="false">
      <bpmn:documentation>Trigger: Competitor unexpected price move on key SKU
Frequency: Ad-hoc; ~5–10 rapid responses/month
Volume: ~5–10/month
Owner: Category Manager
Participants: VP Merchandising
Source: workflow W2222 — Rapid Price Response Workflow</bpmn:documentation>
      <bpmn:laneSet id="W2222_LaneSet2">
        <bpmn:lane id="W2222_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2222_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2222_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2222_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2222_Start3" name="Competitor unexpected price move on key SKU">
        <bpmn:outgoing>W2222_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2222_Task4" name="Category Manager evaluates the competitor move; decides match/counter/hold…">
        <bpmn:documentation>Step 1: Category Manager evaluates the competitor move; decides match/counter/hold; executes the price change within 24–48 hours; communicates to stores and ecommerce
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 2–4 hours</bpmn:documentation>
        <bpmn:incoming>W2222_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2222_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2222_End5" name="Complete">
        <bpmn:incoming>W2222_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2222_Annotation6">
        <bpmn:text>Controls: - CTL-175 (ensure competitor-price data integrity &amp; price-match governance.) | - CTL-401 (price-change authorization; margin-floor guard); operational: VP Merchandising post-hoc review of rapid responses
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2222_Assoc7" sourceRef="W2222_Annotation6" targetRef="W2222_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2222_Flow8" sourceRef="W2222_Start3" targetRef="W2222_Task4" />
      <bpmn:sequenceFlow id="W2222_Flow9" sourceRef="W2222_Task4" targetRef="W2222_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2222_diag">
      <bpmndi:BPMNPlane id="W2222_plane" bpmnElement="W_W2222">
        <bpmndi:BPMNShape id="W2222_Lane1_di" bpmnElement="W2222_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
