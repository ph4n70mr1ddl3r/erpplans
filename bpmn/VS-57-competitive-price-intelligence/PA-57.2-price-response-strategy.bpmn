    <bpmn:process id="W_W2225" name="W2225. Store-Level Price Override" isExecutable="false">
      <bpmn:documentation>Trigger: Store requests override for competitive reason
Frequency: ~200–400 requests/month
Volume: ~200–400/month
Owner: Store Manager / Regional Ops Manager
Participants: VP Store Operations
Source: workflow W2225 — Store-Level Price Override</bpmn:documentation>
      <bpmn:laneSet id="W2225_LaneSet2">
        <bpmn:lane id="W2225_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2225_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2225_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2225_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2225_Start3" name="Store requests override for competitive reason">
        <bpmn:outgoing>W2225_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2225_Task4" name="Store Manager submits override request (SKU, requested price, competitive…">
        <bpmn:documentation>Step 1: Store Manager submits override request (SKU, requested price, competitive reason); Regional Ops approves/denies within 24 hours; system updates if approved
Responsible (R): Store Manager / Regional Ops Mgr
Accountable (A): VP Store Operations
Duration: 15 min/request</bpmn:documentation>
        <bpmn:incoming>W2225_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2225_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2225_End5" name="Complete">
        <bpmn:incoming>W2225_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2225_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) | - CTL-401 (price-override authorization — links to VS-08 / POS-006); CTL-108 (margin-floor guard — loss-making price prevention); operational: Regional Ops Manager approval; VP Store Operations audit
Owner: Store Manager / Regional Ops Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2225_Assoc7" sourceRef="W2225_Annotation6" targetRef="W2225_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2225_Flow8" sourceRef="W2225_Start3" targetRef="W2225_Task4" />
      <bpmn:sequenceFlow id="W2225_Flow9" sourceRef="W2225_Task4" targetRef="W2225_End5" />
    </bpmn:process>
