    <bpmn:process id="W_W2229" name="W2229. Customer Price Match Guarantee" isExecutable="false">
      <bpmn:documentation>Trigger: Customer requests price match at POS
Frequency: ~3,000–5,000 requests/month
Volume: ~3K–5K/month
Owner: Cashier / Store Manager
Participants: Regional Ops Manager
Source: workflow W2229 — Customer Price Match Guarantee</bpmn:documentation>
      <bpmn:laneSet id="W2229_LaneSet2">
        <bpmn:lane id="W2229_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2229_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2229_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2229_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2229_Start3" name="Customer requests price match at POS">
        <bpmn:outgoing>W2229_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2229_Task4" name="Customer presents competitor price evidence (ad, screenshot); Cashier verifies…">
        <bpmn:documentation>Step 1: Customer presents competitor price evidence (ad, screenshot); Cashier verifies per policy (same SKU, current, valid competitor); Manager approves if over threshold; POS applies the match; system logs the match for analytics
Responsible (R): Cashier / Store Manager
Accountable (A): Regional Ops Mgr
Duration: 3–5 min</bpmn:documentation>
        <bpmn:incoming>W2229_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2229_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2229_End5" name="Complete">
        <bpmn:incoming>W2229_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2229_Annotation6">
        <bpmn:text>Controls: - CTL-401 (ensure controlled execution — Price Response Strategy &amp; Execution (PA-57.2).) | - CTL-401 (price-match authorization — links to VS-08 / POS-006); fraud-guard cross-reference to VS-125/W2249 monitoring; operational: Store Manager approval above threshold
Owner: Cashier / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
