        <bpmndi:BPMNShape id="W2223_End5_di" bpmnElement="W2223_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2223_Annotation6_di" bpmnElement="W2223_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
