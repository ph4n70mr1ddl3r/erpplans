    <bpmn:process id="W_W2219" name="W2219. Market Basket Price Comparison" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly comprehensive cycle — Market Basket Price Comparison
Frequency: Quarterly; 100-SKU basket
Volume: ~100 SKUs × 4–5 competitors
Owner: Pricing Analyst
Participants: VP Merchandising
Source: workflow W2219 — Market Basket Price Comparison</bpmn:documentation>
      <bpmn:laneSet id="W2219_LaneSet2">
        <bpmn:lane id="W2219_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2219_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2219_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2219_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2219_Start3" name="Quarterly comprehensive cycle — Market Basket Price Comparison">
        <bpmn:outgoing>W2219_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2219_Task4" name="Pricing Analyst compares BuildRight&#x27;s 100-SKU benchmark basket (the…">
        <bpmn:documentation>Step 1: Pricing Analyst compares BuildRight&#x27;s 100-SKU benchmark basket (the high-visibility basket customers use to judge &quot;expensive vs. cheap&quot;) vs. each competitor; identifies where BuildRight is above/below; recommends the basket-positioning adjustment
Responsible (R): Pricing Analyst
Accountable (A): VP Merchandising
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2219_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2219_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2219_End5" name="Complete">
        <bpmn:incoming>W2219_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2219_Annotation6">
        <bpmn:text>Controls: - CTL-175 (ensure competitor-price data integrity &amp; price-match governance.) | - Operational: VP Merchandising quarterly basket sign-off
Owner: Pricing Analyst</bpmn:text>
