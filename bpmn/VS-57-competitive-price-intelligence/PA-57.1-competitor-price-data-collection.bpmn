        <bpmndi:BPMNEdge id="W2215_Assoc7_di" bpmnElement="W2215_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2216" name="W2216. Competitor Promotion Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Competitor launches promo
Frequency: Ad-hoc; ~2–3 major events/quarter
Volume: ~2–3 events/quarter
Owner: Pricing Analyst
Participants: Category Manager
Source: workflow W2216 — Competitor Promotion Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2216_LaneSet2">
        <bpmn:lane id="W2216_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2216_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2216_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2216_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2216_Start3" name="Competitor launches promo">
        <bpmn:outgoing>W2216_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2216_Task4" name="Pricing Analyst monitors competitor promos (weekly ad circulars, social media…">
        <bpmn:documentation>Step 1: Pricing Analyst monitors competitor promos (weekly ad circulars, social media, in-store signage); assesses the competitive threat; recommends BuildRight&#x27;s counter-promo or hold
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2216_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2216_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2216_End5" name="Complete">
        <bpmn:incoming>W2216_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2216_Annotation6">
        <bpmn:text>Controls: - CTL-400 (ensure controlled execution — Competitor Price Data Collection &amp; Analysis (PA-57.1).) | - Operational: Category Manager counter-promo sign-off
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2216_Assoc7" sourceRef="W2216_Annotation6" targetRef="W2216_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2216_Flow8" sourceRef="W2216_Start3" targetRef="W2216_Task4" />
      <bpmn:sequenceFlow id="W2216_Flow9" sourceRef="W2216_Task4" targetRef="W2216_End5" />
    </bpmn:process>
