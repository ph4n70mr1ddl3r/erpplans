      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2217" name="W2217. Price Positioning Strategy Review" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly pricing strategy review
Frequency: Quarterly; 13 categories
Volume: ~13 reviews/quarter
Owner: VP Merchandising
Participants: COO
Source: workflow W2217 — Price Positioning Strategy Review</bpmn:documentation>
      <bpmn:laneSet id="W2217_LaneSet2">
        <bpmn:lane id="W2217_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W2217_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2217_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2217_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2217_Start3" name="Quarterly pricing strategy review">
        <bpmn:outgoing>W2217_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2217_Task4" name="VP Merchandising reviews each category&#x27;s price position: price-leader, parity…">
        <bpmn:documentation>Step 1: VP Merchandising reviews each category&#x27;s price position: price-leader, parity, premium; validates against the competitive data (W2214) and the category strategy; adjusts the positioning where the data warrants
Responsible (R): VP Merchandising
Accountable (A): COO
Duration: 1–2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2217_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2217_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2217_End5" name="Complete">
        <bpmn:incoming>W2217_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2217_Annotation6">
        <bpmn:text>Controls: - CTL-400 (ensure controlled execution — Competitor Price Data Collection &amp; Analysis (PA-57.1).) | - Operational: COO quarterly positioning sign-off
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2217_Assoc7" sourceRef="W2217_Annotation6" targetRef="W2217_Start3" associationDirection="None" />
