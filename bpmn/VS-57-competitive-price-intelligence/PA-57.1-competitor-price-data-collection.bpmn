<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-57.1-competitor-price-data-collection" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2214" name="W2214. Competitor Price Scraping &amp; Collection" isExecutable="false">
      <bpmn:documentation>Trigger: Weekly collection cycle
Frequency: Weekly; ~500–1,000 price points
Volume: ~500–1,000 prices/week across 4–5 competitors
Owner: Pricing Analyst
Participants: Category Manager
Source: workflow W2214 — Competitor Price Scraping &amp; Collection</bpmn:documentation>
      <bpmn:laneSet id="W2214_LaneSet2">
        <bpmn:lane id="W2214_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2214_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2214_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2214_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2214_Start3" name="Weekly collection cycle">
        <bpmn:outgoing>W2214_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2214_Task4" name="Pricing Analyst collects competitor prices: web scraping of competitor…">
        <bpmn:documentation>Step 1: Pricing Analyst collects competitor prices: web scraping of competitor ecommerce sites, mystery-shop store visits for in-store prices, third-party price-intelligence feed; normalizes to BuildRight&#x27;s SKU equivalents
Responsible (R): Pricing Analyst
Accountable (A): Category Manager
Duration: 4–6 hours/week</bpmn:documentation>
        <bpmn:incoming>W2214_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2214_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2214_End5" name="Complete">
        <bpmn:incoming>W2214_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2214_Annotation6">
        <bpmn:text>Controls: - CTL-175 (ensure competitor-price data integrity &amp; price-match governance.) | - CTL-400 (competition-law conduct — links to VS-129 / W2683); operational: Category Manager weekly collection-review
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2214_Assoc7" sourceRef="W2214_Annotation6" targetRef="W2214_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2214_Flow8" sourceRef="W2214_Start3" targetRef="W2214_Task4" />
      <bpmn:sequenceFlow id="W2214_Flow9" sourceRef="W2214_Task4" targetRef="W2214_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2214_diag">
      <bpmndi:BPMNPlane id="W2214_plane" bpmnElement="W_W2214">
        <bpmndi:BPMNShape id="W2214_Lane1_di" bpmnElement="W2214_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="530" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2214_Task4_di" bpmnElement="W2214_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2214_Start3_di" bpmnElement="W2214_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2214_End5_di" bpmnElement="W2214_End5"><dc:Bounds x="630" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2214_Annotation6_di" bpmnElement="W2214_Annotation6"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2214_Flow8_di" bpmnElement="W2214_Flow8"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2214_Flow9_di" bpmnElement="W2214_Flow9"><di:waypoint x="580" y="165" /><di:waypoint x="630" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2214_Assoc7_di" bpmnElement="W2214_Assoc7"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2215" name="W2215. Price Matching Decision &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Significant price gap identified (&gt;10%)
Frequency: Ad-hoc; ~20–30 decisions/month
Volume: ~20–30/month
Owner: Category Manager
Participants: VP Merchandising
Source: workflow W2215 — Price Matching Decision &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W2215_LaneSet2">
        <bpmn:lane id="W2215_Lane1" name="Category Manager">
        <bpmn:flowNodeRef>W2215_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2215_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2215_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2215_Start3" name="Significant price gap identified (&gt;10%)">
        <bpmn:outgoing>W2215_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2215_Task4" name="Category Manager reviews the &gt;10%-gap SKUs; decides: match (lower price)…">
        <bpmn:documentation>Step 1: Category Manager reviews the &gt;10%-gap SKUs; decides: match (lower price), differentiate (justify premium via value-add), or hold (transient competitor promo); executes the price change in the pricing master
Responsible (R): Category Manager
Accountable (A): VP Merchandising
Duration: 30–60 min/decision</bpmn:documentation>
        <bpmn:incoming>W2215_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2215_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2215_End5" name="Complete">
        <bpmn:incoming>W2215_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2215_Annotation6">
        <bpmn:text>Controls: - CTL-175 (ensure competitor-price data integrity &amp; price-match governance.) | - CTL-400 (price-change authorization — links to VS-08 / W40); CTL-108 (margin-floor guard — loss-making price prevention); operational: VP Merchandising sign-off on matches below the margin floor
Owner: Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2215_Assoc7" sourceRef="W2215_Annotation6" targetRef="W2215_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2215_Flow8" sourceRef="W2215_Start3" targetRef="W2215_Task4" />
      <bpmn:sequenceFlow id="W2215_Flow9" sourceRef="W2215_Task4" targetRef="W2215_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2215_diag">
