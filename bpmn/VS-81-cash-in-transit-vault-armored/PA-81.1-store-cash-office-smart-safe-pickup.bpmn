      <bpmndi:BPMNPlane id="W2802_plane" bpmnElement="W_W2802">
        <bpmndi:BPMNShape id="W2802_Lane1_di" bpmnElement="W2802_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
