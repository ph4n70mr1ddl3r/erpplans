        <bpmn:flowNodeRef>W2806_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2806_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2806_Start5" name="Suspect note detected at POS or smart safe">
        <bpmn:outgoing>W2806_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2806_Task6" name="Cashier authenticates notes via UV/magnetic detector and tactile check; smart…">
        <bpmn:documentation>Step 1: Cashier authenticates notes via UV/magnetic detector and tactile check; smart safe performs automated counterfeit scan on drop
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: Per large note</bpmn:documentation>
        <bpmn:incoming>W2806_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2806_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2806_Task7" name="Cashier/Store Manager sequesters suspect note; records serial, customer info…">
        <bpmn:documentation>Step 2: Cashier/Store Manager sequesters suspect note; records serial, customer info, time; does not return to customer per BSP protocol; logs incident
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15–30 min</bpmn:documentation>
        <bpmn:incoming>W2806_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2806_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2806_Task8" name="LP reports suspect note to BSP bank for verification; tracks outcome; if…">
        <bpmn:documentation>Step 3: LP reports suspect note to BSP bank for verification; tracks outcome; if confirmed counterfeit, write-off absorbed by store LP budget
Responsible (R): LP
Accountable (A): LP Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2806_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2806_End9" name="Complete">
        <bpmn:incoming>W2806_Flow15</bpmn:incoming>
      </bpmn:endEvent>
