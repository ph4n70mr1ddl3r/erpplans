      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2802" name="W2802. Smart Safe Cash Drop, Validation &amp; CIT-Ready Flagging" isExecutable="false">
      <bpmn:documentation>Trigger: Cash bundle ready for deposit
Frequency: 1–3× per day per store
Volume: ~200 smart safes network-wide
Owner: Store Cashier Lead
Participants: Cashier, Store Manager, CIT Operations
Source: workflow W2802 — Smart Safe Cash Drop, Validation &amp; CIT-Ready Flagging</bpmn:documentation>
      <bpmn:laneSet id="W2802_LaneSet4">
        <bpmn:lane id="W2802_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2802_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2802_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2802_Lane2" name="CIT Operations">
        <bpmn:flowNodeRef>W2802_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2802_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W2802_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2802_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2802_Start5" name="Cash bundle ready for deposit">
        <bpmn:outgoing>W2802_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2802_Task6" name="Cashier drops strapped bundle into smart safe; safe validates…">
        <bpmn:documentation>Step 1: Cashier drops strapped bundle into smart safe; safe validates denomination/counterfeit via note reader; credits amount to store deposit account in ERP
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 5 min/drop</bpmn:documentation>
        <bpmn:incoming>W2802_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2802_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2802_Task7" name="Smart safe transmits real-time deposit data to CIT Operations dashboard; flags…">
        <bpmn:documentation>Step 2: Smart safe transmits real-time deposit data to CIT Operations dashboard; flags &quot;CIT-ready&quot; once threshold (e.g., PHP 200K) reached or scheduled pickup
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2802_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2802_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2802_Task8" name="Store Manager reviews daily smart-safe report; reconciles to POS cash sales…">
        <bpmn:documentation>Step 3: Store Manager reviews daily smart-safe report; reconciles to POS cash sales; investigates discrepancies; confirms pickup readiness
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 15 min</bpmn:documentation>
        <bpmn:incoming>W2802_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2802_End9" name="Complete">
        <bpmn:incoming>W2802_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2802_Annotation10">
        <bpmn:text>Controls: - CTL-183 (ensure CIT custody-chain &amp; cash-in-transit integrity.) | - operational: note-reader validation and daily reconciliation
Owner: Store Cashier Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2802_Assoc11" sourceRef="W2802_Annotation10" targetRef="W2802_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2802_Flow12" sourceRef="W2802_Start5" targetRef="W2802_Task6" />
      <bpmn:sequenceFlow id="W2802_Flow13" sourceRef="W2802_Task6" targetRef="W2802_Task7" />
      <bpmn:sequenceFlow id="W2802_Flow14" sourceRef="W2802_Task7" targetRef="W2802_Task8" />
      <bpmn:sequenceFlow id="W2802_Flow15" sourceRef="W2802_Task8" targetRef="W2802_End9" />
    </bpmn:process>
