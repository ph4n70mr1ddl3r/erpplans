        <bpmndi:BPMNEdge id="W2802_Flow12_di" bpmnElement="W2802_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2802_Flow13_di" bpmnElement="W2802_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2802_Flow14_di" bpmnElement="W2802_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2802_Flow15_di" bpmnElement="W2802_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2802_Assoc11_di" bpmnElement="W2802_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2803" name="W2803. Mid-Day Cash Skim &amp; Cash Drawer Threshold Management" isExecutable="false">
      <bpmn:documentation>Trigger: Cash drawer exceeds threshold (e.g., PHP 30K)
Frequency: 1–2× per day per terminal during peak
Volume: 600 terminals
Owner: Store Cashier Lead
Participants: Cashier, Assistant Store Manager
Source: workflow W2803 — Mid-Day Cash Skim &amp; Cash Drawer Threshold Management</bpmn:documentation>
      <bpmn:laneSet id="W2803_LaneSet4">
        <bpmn:lane id="W2803_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2803_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2803_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2803_Lane2" name="Assistant Store Manager">
        <bpmn:flowNodeRef>W2803_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2803_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W2803_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2803_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2803_Start5" name="Cash drawer exceeds threshold (e.g., PHP 30K)">
        <bpmn:outgoing>W2803_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2803_Task6" name="Cashier performs mid-day skim when drawer exceeds threshold; counts excess…">
        <bpmn:documentation>Step 1: Cashier performs mid-day skim when drawer exceeds threshold; counts excess cash; moves to smart safe/drop safe under dual-control
Responsible (R): Cashier
Accountable (A): Assistant Store Manager
Duration: 15–20 min</bpmn:documentation>
        <bpmn:incoming>W2803_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2803_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2803_Task7" name="Assistant Store Manager validates skim amount and drawer balance; updates…">
        <bpmn:documentation>Step 2: Assistant Store Manager validates skim amount and drawer balance; updates drawer float; returns working change
Responsible (R): Assistant Store Manager
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W2803_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2803_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2803_Task8" name="Store Manager monitors per-terminal cash levels via dashboard; rebalances…">
        <bpmn:documentation>Step 3: Store Manager monitors per-terminal cash levels via dashboard; rebalances drawer floats across terminals to optimize checkout flow
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2803_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2803_End9" name="Complete">
        <bpmn:incoming>W2803_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2803_Annotation10">
        <bpmn:text>Controls: - CTL-472 (ensure controlled execution — Store Cash Office, Smart Safe &amp; Pickup Planning (PA-81.1).) | - operational: threshold-driven skimming
Owner: Store Cashier Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2803_Assoc11" sourceRef="W2803_Annotation10" targetRef="W2803_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2803_Flow12" sourceRef="W2803_Start5" targetRef="W2803_Task6" />
      <bpmn:sequenceFlow id="W2803_Flow13" sourceRef="W2803_Task6" targetRef="W2803_Task7" />
      <bpmn:sequenceFlow id="W2803_Flow14" sourceRef="W2803_Task7" targetRef="W2803_Task8" />
      <bpmn:sequenceFlow id="W2803_Flow15" sourceRef="W2803_Task8" targetRef="W2803_End9" />
    </bpmn:process>
