    <bpmn:process id="W_W2806" name="W2806. Counterfeit Detection, Note Authentication &amp; Suspect Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Suspect note detected at POS or smart safe
Frequency: Event-driven; ~20–50 notes/year
Volume: ~30 suspect events/year
Owner: Store Cashier Lead
Participants: Cashier, Store Manager, LP, BSP
Source: workflow W2806 — Counterfeit Detection, Note Authentication &amp; Suspect Handling</bpmn:documentation>
      <bpmn:laneSet id="W2806_LaneSet4">
        <bpmn:lane id="W2806_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2806_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2806_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2806_Lane2" name="Store Manager">
