<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-81.1-store-cash-office-smart-safe-pickup" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2801" name="W2801. Store Cash Office End-of-Day Skim, Denomination &amp; Bundle Preparation" isExecutable="false">
      <bpmn:documentation>Trigger: End-of-day cash office close per store
Frequency: Daily per store
Volume: 200 stores; ~PHP 2.1B monthly cash sales (~PHP 10.6M/store/month, per the VS-18.1 canon)
Owner: Store Cashier Lead
Participants: Cashier, Store Manager, Assistant Store Manager
Source: workflow W2801 — Store Cash Office End-of-Day Skim, Denomination &amp; Bundle Preparation</bpmn:documentation>
      <bpmn:laneSet id="W2801_LaneSet3">
        <bpmn:lane id="W2801_Lane1" name="Cashier">
        <bpmn:flowNodeRef>W2801_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2801_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2801_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2801_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2801_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2801_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2801_Start4" name="End-of-day cash office close per store">
        <bpmn:outgoing>W2801_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2801_Task5" name="Cashier counts cash drawer per terminal; reconciles to POS Z-report…">
        <bpmn:documentation>Step 1: Cashier counts cash drawer per terminal; reconciles to POS Z-report; investigates over/short variance &gt; PHP 500
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 20–30 min/terminal</bpmn:documentation>
        <bpmn:incoming>W2801_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2801_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2801_Task6" name="Cashier sorts and denominates currency by note value; straps bundles per BSP…">
        <bpmn:documentation>Step 2: Cashier sorts and denominates currency by note value; straps bundles per BSP denomination standard (100 pcs/bundle); prepares deposit bag with manifest
Responsible (R): Cashier
Accountable (A): Store Manager
Duration: 30–45 min</bpmn:documentation>
        <bpmn:incoming>W2801_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2801_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2801_Task7" name="Store Manager witnesses sealing and signs deposit manifest under dual-control…">
        <bpmn:documentation>Step 3: Store Manager witnesses sealing and signs deposit manifest under dual-control; logs sealed-bag ID into smart safe or CIT deposit log
Responsible (R): Store Manager / Cashier
Accountable (A): Store Manager
Duration: 10 min</bpmn:documentation>
        <bpmn:incoming>W2801_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2801_End8" name="Complete">
        <bpmn:incoming>W2801_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2801_Annotation9">
        <bpmn:text>Controls: - CTL-183 (ensure CIT custody-chain &amp; cash-in-transit integrity.) | - operational: dual-control witnessing and CCTV
Owner: Store Cashier Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2801_Assoc10" sourceRef="W2801_Annotation9" targetRef="W2801_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2801_Flow11" sourceRef="W2801_Start4" targetRef="W2801_Task5" />
      <bpmn:sequenceFlow id="W2801_Flow12" sourceRef="W2801_Task5" targetRef="W2801_Task6" />
      <bpmn:sequenceFlow id="W2801_Flow13" sourceRef="W2801_Task6" targetRef="W2801_Task7" />
      <bpmn:sequenceFlow id="W2801_Flow14" sourceRef="W2801_Task7" targetRef="W2801_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2801_diag">
      <bpmndi:BPMNPlane id="W2801_plane" bpmnElement="W_W2801">
        <bpmndi:BPMNShape id="W2801_Lane1_di" bpmnElement="W2801_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2801_Lane2_di" bpmnElement="W2801_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
