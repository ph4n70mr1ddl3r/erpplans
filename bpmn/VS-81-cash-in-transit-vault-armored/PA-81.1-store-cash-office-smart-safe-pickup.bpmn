      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2804" name="W2804. CIT Pickup Schedule Planning &amp; Store Request Management" isExecutable="false">
      <bpmn:documentation>Trigger: Standing schedule + ad-hoc store request
Frequency: 2–4× per week per store
Volume: ~200 stores × ~3 pickups/week ≈ 600 pickups/week
Owner: CIT Operations Manager
Participants: CIT Operations, Store Manager, CIT Vendor
Source: workflow W2804 — CIT Pickup Schedule Planning &amp; Store Request Management</bpmn:documentation>
      <bpmn:laneSet id="W2804_LaneSet3">
        <bpmn:lane id="W2804_Lane1" name="CIT Operations">
        <bpmn:flowNodeRef>W2804_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2804_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2804_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2804_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W2804_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2804_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2804_Start4" name="Standing schedule + ad-hoc store request">
        <bpmn:outgoing>W2804_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2804_Task5" name="CIT Operations maintains standing pickup schedule per store (frequency based on…">
        <bpmn:documentation>Step 1: CIT Operations maintains standing pickup schedule per store (frequency based on cash volume tier); optimizes armored car routes by geography
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2804_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2804_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2804_Task6" name="Store Manager requests ad-hoc pickup via app when cash exceeds security…">
        <bpmn:documentation>Step 2: Store Manager requests ad-hoc pickup via app when cash exceeds security threshold or for special events (paydays, holidays); confirms pickup window
Responsible (R): Store Manager
Accountable (A): CIT Operations Manager
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W2804_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2804_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2804_Task7" name="CIT Operations dispatches confirmation and ETA to store; store prepares…">
        <bpmn:documentation>Step 3: CIT Operations dispatches confirmation and ETA to store; store prepares deposit; verifies armored guard identity and route manifest at handover
Responsible (R): CIT Operations / Store Manager
Accountable (A): CIT Operations Manager
Duration: Per pickup</bpmn:documentation>
        <bpmn:incoming>W2804_Flow13</bpmn:incoming>
      </bpmn:userTask>
