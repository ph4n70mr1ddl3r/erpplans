    <bpmn:process id="W_W2820" name="W2820. Cash Forecasting, Bank Sweep &amp; Liquidity Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Daily cash position; weekly forecast
Frequency: Daily + weekly
Volume: Network-wide ~PHP 1B+ monthly cash
Owner: Treasury Analyst
Participants: Treasury, CIT Operations, Finance
Source: workflow W2820 — Cash Forecasting, Bank Sweep &amp; Liquidity Optimization</bpmn:documentation>
      <bpmn:laneSet id="W2820_LaneSet4">
        <bpmn:lane id="W2820_Lane1" name="Treasury Analyst">
        <bpmn:flowNodeRef>W2820_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2820_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2820_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W2820_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2820_Lane3" name="Finance">
        <bpmn:flowNodeRef>W2820_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2820_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2820_Start5" name="Daily cash position; weekly forecast">
        <bpmn:outgoing>W2820_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2820_Task6" name="Treasury forecasts store cash generation by region/day; plans CIT pickup and…">
        <bpmn:documentation>Step 1: Treasury forecasts store cash generation by region/day; plans CIT pickup and bank deposit timing to minimize idle cash
Responsible (R): Treasury Analyst
Accountable (A): Treasury Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2820_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2820_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2820_Task7" name="Treasury executes bank sweep to concentration account; invests surplus in…">
        <bpmn:documentation>Step 2: Treasury executes bank sweep to concentration account; invests surplus in short-term placements; maintains operating minimum
Responsible (R): Treasury
Accountable (A): CFO
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2820_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2820_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2820_Task8" name="Finance reports cash velocity (days sales in cash), sweep effectiveness, and…">
        <bpmn:documentation>Step 3: Finance reports cash velocity (days sales in cash), sweep effectiveness, and yield on surplus placement; recommends optimization
Responsible (R): Finance
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2820_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2820_End9" name="Complete">
        <bpmn:incoming>W2820_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2820_Annotation10">
        <bpmn:text>Controls: - CTL-474 (ensure controlled execution — CIT Risk, Insurance &amp; Cash Analytics (PA-81.3).) | - operational: daily sweep and short-term placement
