    <bpmn:process id="W_W2819" name="W2819. Cash Loss Event Investigation, LP Correlation &amp; Write-Off" isExecutable="false">
      <bpmn:documentation>Trigger: Cash variance beyond tolerance or suspected theft
Frequency: Event-driven; ~50–100 investigations/year
Volume: ~5–8 events/month
Owner: LP Investigator
Participants: LP Investigator, Store Manager, HR, Internal Audit
Source: workflow W2819 — Cash Loss Event Investigation, LP Correlation &amp; Write-Off</bpmn:documentation>
      <bpmn:laneSet id="W2819_LaneSet3">
        <bpmn:lane id="W2819_Lane1" name="LP Investigator">
        <bpmn:flowNodeRef>W2819_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2819_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2819_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2819_Lane2" name="Internal Audit">
        <bpmn:flowNodeRef>W2819_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2819_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2819_Start4" name="Cash variance beyond tolerance or suspected theft">
        <bpmn:outgoing>W2819_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2819_Task5" name="LP Investigator opens case for cash variance &gt; threshold; reviews CCTV, POS…">
        <bpmn:documentation>Step 1: LP Investigator opens case for cash variance &gt; threshold; reviews CCTV, POS exception, smart-safe logs, and employee pattern
Responsible (R): LP Investigator
Accountable (A): LP Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2819_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2819_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2819_Task6" name="LP Investigator conducts interview with involved staff (HR present); documents…">
        <bpmn:documentation>Step 2: LP Investigator conducts interview with involved staff (HR present); documents findings; determines root cause (error vs. theft)
Responsible (R): LP Investigator / HR
Accountable (A): LP Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2819_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2819_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2819_Task7" name="Internal Audit/LP recommends write-off, restitution, or disciplinary action…">
        <bpmn:documentation>Step 3: Internal Audit/LP recommends write-off, restitution, or disciplinary action; updates LP trend dashboard; closes case with control remediation
Responsible (R): Internal Audit / LP
Accountable (A): LP Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W2819_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2819_End8" name="Complete">
        <bpmn:incoming>W2819_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2819_Annotation9">
        <bpmn:text>Controls: - CTL-474 (ensure controlled execution — CIT Risk, Insurance &amp; Cash Analytics (PA-81.3).) | - operational: SLA-bounded investigation and trend analysis
Owner: LP Investigator</bpmn:text>
      </bpmn:textAnnotation>
