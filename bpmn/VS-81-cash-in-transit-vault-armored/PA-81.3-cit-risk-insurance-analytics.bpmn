    <bpmn:process id="W_W2818" name="W2818. Cash Holding Limit Compliance &amp; Store Vault Capacity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous monitoring; new store design
Frequency: Daily monitoring; annual capacity review
Volume: 200 stores
Owner: LP Manager
Participants: LP, Store Manager, Risk, CIT Operations
Source: workflow W2818 — Cash Holding Limit Compliance &amp; Store Vault Capacity Planning</bpmn:documentation>
      <bpmn:laneSet id="W2818_LaneSet3">
        <bpmn:lane id="W2818_Lane1" name="LP">
        <bpmn:flowNodeRef>W2818_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2818_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2818_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2818_Lane2" name="ERP automation">
        <bpmn:flowNodeRef>W2818_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2818_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2818_Start4" name="Continuous monitoring; new store design">
        <bpmn:outgoing>W2818_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2818_Task5" name="LP sets per-store cash holding limit based on sales velocity, insurance…">
        <bpmn:documentation>Step 1: LP sets per-store cash holding limit based on sales velocity, insurance sub-limit, and vault capacity; configures alert thresholds in ERP
Responsible (R): LP
Accountable (A): LP Manager
Duration: Per store</bpmn:documentation>
        <bpmn:incoming>W2818_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2818_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2818_Task6" name="ERP alerts Store Manager and CIT Operations when cash exceeds 80% of holding…">
        <bpmn:documentation>Step 2: ERP alerts Store Manager and CIT Operations when cash exceeds 80% of holding limit; auto-triggers ad-hoc pickup
Responsible (R): ERP automation
Accountable (A): LP Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2818_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2818_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2818_Task7" name="LP reviews holding-limit breaches monthly; investigates chronic over-limit…">
        <bpmn:documentation>Step 3: LP reviews holding-limit breaches monthly; investigates chronic over-limit stores; adjusts pickup frequency or vault capacity
Responsible (R): LP
Accountable (A): LP Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2818_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2818_End8" name="Complete">
        <bpmn:incoming>W2818_Flow14</bpmn:incoming>
      </bpmn:endEvent>
