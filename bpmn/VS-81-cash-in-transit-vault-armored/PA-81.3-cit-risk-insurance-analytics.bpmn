    <bpmn:process id="W_W2817" name="W2817. CIT Insurance Program, Coverage Limits &amp; Claims Management" isExecutable="false">
      <bpmn:documentation>Trigger: Annual renewal; loss event
Frequency: Annual + event-driven
Volume: Network-wide cash-in-transit + cash-on-premises coverage
Owner: Risk &amp; Insurance Manager
Participants: Risk Mgr, Treasury, LP, Insurance Broker, CIT Vendor
Source: workflow W2817 — CIT Insurance Program, Coverage Limits &amp; Claims Management</bpmn:documentation>
      <bpmn:laneSet id="W2817_LaneSet4">
        <bpmn:lane id="W2817_Lane1" name="Risk Manager">
        <bpmn:flowNodeRef>W2817_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2817_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2817_Lane2" name="Treasury">
        <bpmn:flowNodeRef>W2817_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2817_Lane3" name="LP">
        <bpmn:flowNodeRef>W2817_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2817_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2817_Start5" name="Annual renewal; loss event">
        <bpmn:outgoing>W2817_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2817_Task6" name="Risk Manager structures CIT and cash-on-premises insurance: per-occurrence…">
        <bpmn:documentation>Step 1: Risk Manager structures CIT and cash-on-premises insurance: per-occurrence limits, aggregate, deductible; coordinates with CIT vendor&#x27;s own coverage to avoid gaps/overlap
Responsible (R): Risk Manager
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W2817_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2817_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2817_Task7" name="Treasury/Risk validates store vault holding limits align with insurance…">
        <bpmn:documentation>Step 2: Treasury/Risk validates store vault holding limits align with insurance sub-limits; flags over-limit stores for pickup frequency adjustment
Responsible (R): Treasury / Risk Manager
Accountable (A): Risk Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2817_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2817_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2817_Task8" name="On loss event, LP/Risk files claim with evidence; pursues CIT vendor recovery…">
        <bpmn:documentation>Step 3: On loss event, LP/Risk files claim with evidence; pursues CIT vendor recovery where liable; tracks claim outcome and recovered amount
Responsible (R): LP / Risk Manager
Accountable (A): CFO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2817_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2817_End9" name="Complete">
        <bpmn:incoming>W2817_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2817_Annotation10">
        <bpmn:text>Controls: - CTL-474 (ensure controlled execution — CIT Risk, Insurance &amp; Cash Analytics (PA-81.3).) | - operational: annual coverage review and sub-limit alignment
Owner: Risk &amp; Insurance Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2817_Assoc11" sourceRef="W2817_Annotation10" targetRef="W2817_Start5" associationDirection="None" />
