    <bpmn:process id="W_W2813" name="W2813. Bank Deposit Posting, Clearance &amp; Difference Resolution" isExecutable="false">
      <bpmn:documentation>Trigger: Vault-to-bank deposit
Frequency: Daily per region
Volume: ~4 deposits/day across partner banks
Owner: Finance Analyst
Participants: Finance, Vault Ops, Bank, Treasury
Source: workflow W2813 — Bank Deposit Posting, Clearance &amp; Difference Resolution</bpmn:documentation>
      <bpmn:laneSet id="W2813_LaneSet4">
        <bpmn:lane id="W2813_Lane1" name="Vault Ops">
