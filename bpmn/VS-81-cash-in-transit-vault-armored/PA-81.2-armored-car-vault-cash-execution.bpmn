        <bpmn:flowNodeRef>W2814_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2814_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2814_Start5" name="Robbery attempt, accident, or service disruption">
        <bpmn:outgoing>W2814_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2814_Task6" name="CIT vendor activates emergency protocol (panic button, GPS alert); coordinates…">
        <bpmn:documentation>Step 1: CIT vendor activates emergency protocol (panic button, GPS alert); coordinates with PNP; LP notifies CIT Operations Manager immediately
Responsible (R): CIT Vendor / LP
Accountable (A): CIT Operations Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W2814_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2814_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2814_Task7" name="LP preserves evidence (CCTV, telematics, witness statements); liaises with PNP…">
        <bpmn:documentation>Step 2: LP preserves evidence (CCTV, telematics, witness statements); liaises with PNP for investigation; secures alternative pickup for affected stores
Responsible (R): LP / Security
Accountable (A): LP Manager
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W2814_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2814_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2814_Task8" name="Legal/Insurance files insurance claim for CIT-insured loss; Legal pursues…">
        <bpmn:documentation>Step 3: Legal/Insurance files insurance claim for CIT-insured loss; Legal pursues vendor liability per contract; BCM updates risk register and reroutes services
Responsible (R): Legal / Insurance / BCM
Accountable (A): CFO
Duration: Weeks</bpmn:documentation>
        <bpmn:incoming>W2814_Flow14</bpmn:incoming>
      </bpmn:userTask>
