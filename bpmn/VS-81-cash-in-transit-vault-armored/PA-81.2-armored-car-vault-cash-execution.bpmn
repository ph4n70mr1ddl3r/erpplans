    <bpmn:process id="W_W2815" name="W2815. Cash Recirculation &amp; Cross-Store Float Rebalancing" isExecutable="false">
      <bpmn:documentation>Trigger: Imbalance in change-fund demand across stores
Frequency: Weekly review
Volume: 200 stores; PHP 20K float each
Owner: CIT Operations Manager
Participants: CIT Operations, Store Manager, Treasury
Source: workflow W2815 — Cash Recirculation &amp; Cross-Store Float Rebalancing</bpmn:documentation>
      <bpmn:laneSet id="W2815_LaneSet3">
        <bpmn:lane id="W2815_Lane1" name="CIT Operations">
        <bpmn:flowNodeRef>W2815_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2815_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2815_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2815_Lane2" name="Treasury">
