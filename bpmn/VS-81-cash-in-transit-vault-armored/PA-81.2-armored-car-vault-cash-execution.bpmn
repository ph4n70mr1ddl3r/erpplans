        <bpmn:flowNodeRef>W2816_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2816_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2816_Start5" name="Monthly vendor review">
        <bpmn:outgoing>W2816_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2816_Task6" name="CIT Operations tracks KPIs: on-time pickup %, custody discrepancies…">
        <bpmn:documentation>Step 1: CIT Operations tracks KPIs: on-time pickup %, custody discrepancies, robbery/loss incidents, change-order fulfillment, cost per pickup
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W2816_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2816_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2816_Task7" name="Procurement/LP conducts QBR with vendor; reviews SLA compliance, credits for…">
        <bpmn:documentation>Step 2: Procurement/LP conducts QBR with vendor; reviews SLA compliance, credits for service failures, and contract renewals
Responsible (R): Procurement / LP
Accountable (A): CIT Operations Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2816_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2816_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2816_Task8" name="Finance benchmarks CIT cost vs. cash-handling cost reduction; recommends vendor…">
        <bpmn:documentation>Step 3: Finance benchmarks CIT cost vs. cash-handling cost reduction; recommends vendor mix optimization and contract renegotiation
Responsible (R): Finance
Accountable (A): CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W2816_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2816_End9" name="Complete">
        <bpmn:incoming>W2816_Flow15</bpmn:incoming>
      </bpmn:endEvent>
