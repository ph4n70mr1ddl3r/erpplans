      <bpmn:startEvent id="W2815_Start4" name="Imbalance in change-fund demand across stores">
        <bpmn:outgoing>W2815_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2815_Task5" name="CIT Operations monitors cash surplus/deficit by store; identifies stores with…">
        <bpmn:documentation>Step 1: CIT Operations monitors cash surplus/deficit by store; identifies stores with chronic coin shortage vs. note surplus
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2815_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2815_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2815_Task6" name="CIT Operations redistributes cash between stores via armored car (cross-store…">
        <bpmn:documentation>Step 2: CIT Operations redistributes cash between stores via armored car (cross-store transfer) instead of bank withdrawal/deposit; reduces cost
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2815_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2815_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2815_Task7" name="Treasury validates net cash position unaffected; updates store float GL…">
        <bpmn:documentation>Step 3: Treasury validates net cash position unaffected; updates store float GL; reports recirculation savings to Finance
Responsible (R): Treasury
Accountable (A): CFO
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W2815_Flow13</bpmn:incoming>
      </bpmn:userTask>
