    <bpmn:process id="W_W2816" name="W2816. CIT Vendor Performance, SLA &amp; Cost Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly vendor review
Frequency: Monthly + quarterly business review
Volume: 2–3 CIT partners
Owner: CIT Operations Manager
Participants: CIT Ops Mgr, Procurement, Finance, LP
Source: workflow W2816 — CIT Vendor Performance, SLA &amp; Cost Management</bpmn:documentation>
      <bpmn:laneSet id="W2816_LaneSet4">
        <bpmn:lane id="W2816_Lane1" name="CIT Operations">
        <bpmn:flowNodeRef>W2816_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2816_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2816_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2816_Task7</bpmn:flowNodeRef>
