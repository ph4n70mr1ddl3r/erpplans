<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-81.2-armored-car-vault-cash-execution" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2809" name="W2809. Armored Car Partner Onboarding, Vetting &amp; Contract Management" isExecutable="false">
      <bpmn:documentation>Trigger: RFP, contract renewal, or new region expansion
Frequency: Event-driven; ~3–5 year contracts
Volume: 2–3 CIT partners (e.g., ARMSCOR, LBC, private armored fleets)
Owner: CIT Operations Manager
Participants: CIT Ops Mgr, Procurement, Security/LP, Legal, Treasury
Source: workflow W2809 — Armored Car Partner Onboarding, Vetting &amp; Contract Management</bpmn:documentation>
      <bpmn:laneSet id="W2809_LaneSet4">
        <bpmn:lane id="W2809_Lane1" name="Security">
        <bpmn:flowNodeRef>W2809_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2809_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2809_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W2809_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2809_Lane3" name="Treasury">
        <bpmn:flowNodeRef>W2809_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2809_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2809_Start5" name="RFP, contract renewal, or new region expansion">
        <bpmn:outgoing>W2809_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2809_Task6" name="Security/LP vets CIT partner: PNP SOSIA license, BSP registration, insurance…">
        <bpmn:documentation>Step 1: Security/LP vets CIT partner: PNP SOSIA license, BSP registration, insurance coverage (cash-in-transit), employee background checks, armored vehicle specifications
Responsible (R): Security / LP
Accountable (A): CIT Operations Manager
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W2809_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2809_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2809_Task7" name="Procurement leads RFP and commercial negotiation (per-pickup fee, route…">
        <bpmn:documentation>Step 2: Procurement leads RFP and commercial negotiation (per-pickup fee, route pricing, change-order fee, SLA); Legal reviews liability/indemnity clauses
Responsible (R): Procurement / Legal
Accountable (A): CIT Operations Manager
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W2809_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2809_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2809_Task8" name="Treasury/Payment Ops executes contract; configures partner in CIT operations…">
        <bpmn:documentation>Step 3: Treasury/Payment Ops executes contract; configures partner in CIT operations system; pilots one region before nationwide rollout
Responsible (R): Treasury / CIT Operations Manager
Accountable (A): CFO
Duration: 4–6 weeks pilot</bpmn:documentation>
        <bpmn:incoming>W2809_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2809_End9" name="Complete">
        <bpmn:incoming>W2809_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2809_Annotation10">
        <bpmn:text>Controls: - CTL-473 (ensure controlled execution — Armored Car, Vault &amp; Cash Logistics Execution (PA-81.2).) | - operational: SOSIA/BSP license validation and reference checks
Owner: CIT Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2809_Assoc11" sourceRef="W2809_Annotation10" targetRef="W2809_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2809_Flow12" sourceRef="W2809_Start5" targetRef="W2809_Task6" />
      <bpmn:sequenceFlow id="W2809_Flow13" sourceRef="W2809_Task6" targetRef="W2809_Task7" />
      <bpmn:sequenceFlow id="W2809_Flow14" sourceRef="W2809_Task7" targetRef="W2809_Task8" />
      <bpmn:sequenceFlow id="W2809_Flow15" sourceRef="W2809_Task8" targetRef="W2809_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2809_diag">
      <bpmndi:BPMNPlane id="W2809_plane" bpmnElement="W_W2809">
        <bpmndi:BPMNShape id="W2809_Lane1_di" bpmnElement="W2809_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2809_Lane2_di" bpmnElement="W2809_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2809_Lane3_di" bpmnElement="W2809_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
