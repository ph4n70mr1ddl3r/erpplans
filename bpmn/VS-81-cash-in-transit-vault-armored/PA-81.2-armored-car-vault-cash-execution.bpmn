    <bpmn:process id="W_W2814" name="W2814. CIT Service Disruption, Robbery &amp; Emergency Response" isExecutable="false">
      <bpmn:documentation>Trigger: Robbery attempt, accident, or service disruption
Frequency: Event-driven; rare
Volume: ~1–3 incidents/year network-wide
Owner: CIT Operations Manager
Participants: CIT Ops Mgr, LP, Security, Legal, PNP, Insurance, BCM
Source: workflow W2814 — CIT Service Disruption, Robbery &amp; Emergency Response</bpmn:documentation>
      <bpmn:laneSet id="W2814_LaneSet4">
        <bpmn:lane id="W2814_Lane1" name="CIT Vendor">
        <bpmn:flowNodeRef>W2814_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2814_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
