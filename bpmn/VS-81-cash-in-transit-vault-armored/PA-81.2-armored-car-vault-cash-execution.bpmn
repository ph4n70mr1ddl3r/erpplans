      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2810" name="W2810. Pickup Execution, Guard Verification &amp; Handover Protocol" isExecutable="false">
      <bpmn:documentation>Trigger: Scheduled or ad-hoc pickup
Frequency: ~600 pickups/week
Volume: 200 stores
Owner: Store Manager
Participants: Store Manager, CIT Guard, CIT Operations
Source: workflow W2810 — Pickup Execution, Guard Verification &amp; Handover Protocol</bpmn:documentation>
      <bpmn:laneSet id="W2810_LaneSet3">
        <bpmn:lane id="W2810_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W2810_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2810_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2810_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2810_Lane2" name="CIT Operations">
        <bpmn:flowNodeRef>W2810_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2810_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2810_Start4" name="Scheduled or ad-hoc pickup">
        <bpmn:outgoing>W2810_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2810_Task5" name="Store Manager verifies armored guard identity (ID, route manifest, photo match…">
        <bpmn:documentation>Step 1: Store Manager verifies armored guard identity (ID, route manifest, photo match, pre-shared code) before opening; denies access on mismatch
Responsible (R): Store Manager
Accountable (A): Store Manager
Duration: 5–10 min</bpmn:documentation>
        <bpmn:incoming>W2810_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2810_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2810_Task6" name="Store Manager and guard execute two-man handover; count/verify sealed-bag IDs…">
        <bpmn:documentation>Step 2: Store Manager and guard execute two-man handover; count/verify sealed-bag IDs against manifest; both sign custody transfer receipt
Responsible (R): Store Manager / CIT Guard
Accountable (A): Store Manager
Duration: 10–15 min</bpmn:documentation>
        <bpmn:incoming>W2810_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2810_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2810_Task7" name="CIT Operations confirms pickup completion in system; store cash-office system…">
        <bpmn:documentation>Step 3: CIT Operations confirms pickup completion in system; store cash-office system updates custody status; LP flags any unconfirmed handover for investigation
Responsible (R): CIT Operations / LP
Accountable (A): CIT Operations Manager
Duration: Per pickup</bpmn:documentation>
        <bpmn:incoming>W2810_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2810_End8" name="Complete">
        <bpmn:incoming>W2810_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2810_Annotation9">
        <bpmn:text>Controls: - CTL-183 (ensure CIT custody-chain &amp; cash-in-transit integrity.) | - operational: multi-factor guard verification (ID + photo + code)
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2810_Assoc10" sourceRef="W2810_Annotation9" targetRef="W2810_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2810_Flow11" sourceRef="W2810_Start4" targetRef="W2810_Task5" />
      <bpmn:sequenceFlow id="W2810_Flow12" sourceRef="W2810_Task5" targetRef="W2810_Task6" />
      <bpmn:sequenceFlow id="W2810_Flow13" sourceRef="W2810_Task6" targetRef="W2810_Task7" />
      <bpmn:sequenceFlow id="W2810_Flow14" sourceRef="W2810_Task7" targetRef="W2810_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2810_diag">
      <bpmndi:BPMNPlane id="W2810_plane" bpmnElement="W_W2810">
        <bpmndi:BPMNShape id="W2810_Lane1_di" bpmnElement="W2810_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Lane2_di" bpmnElement="W2810_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Task5_di" bpmnElement="W2810_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Task6_di" bpmnElement="W2810_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Task7_di" bpmnElement="W2810_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Start4_di" bpmnElement="W2810_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_End8_di" bpmnElement="W2810_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2810_Annotation9_di" bpmnElement="W2810_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2810_Flow11_di" bpmnElement="W2810_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2810_Flow12_di" bpmnElement="W2810_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2810_Flow13_di" bpmnElement="W2810_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2810_Flow14_di" bpmnElement="W2810_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2810_Assoc10_di" bpmnElement="W2810_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2811" name="W2811. In-Transit Custody Chain, GPS Telematics &amp; Route Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Each cash movement
Frequency: Continuous
Volume: ~120 transit events/day
Owner: CIT Operations Manager
Participants: CIT Operations, CIT Vendor, LP
Source: workflow W2811 — In-Transit Custody Chain, GPS Telematics &amp; Route Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2811_LaneSet4">
        <bpmn:lane id="W2811_Lane1" name="CIT Vendor">
        <bpmn:flowNodeRef>W2811_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2811_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2811_Lane2" name="CIT Operations">
        <bpmn:flowNodeRef>W2811_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2811_Lane3" name="LP">
        <bpmn:flowNodeRef>W2811_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2811_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2811_Start5" name="Each cash movement">
        <bpmn:outgoing>W2811_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2811_Task6" name="CIT vendor&#x27;s armored vehicles transmit GPS location and route adherence to CIT…">
        <bpmn:documentation>Step 1: CIT vendor&#x27;s armored vehicles transmit GPS location and route adherence to CIT Operations dashboard; deviation triggers alert
Responsible (R): CIT Vendor / CIT Operations
Accountable (A): CIT Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2811_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2811_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2811_Task7" name="CIT Operations monitors route ETA, geofenced stops, and vehicle stoppage…">
        <bpmn:documentation>Step 2: CIT Operations monitors route ETA, geofenced stops, and vehicle stoppage; investigates unplanned stops or off-route deviation in real time
Responsible (R): CIT Operations
Accountable (A): CIT Operations Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W2811_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2811_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2811_Task8" name="LP correlates in-transit data with incident history; maintains custody chain…">
        <bpmn:documentation>Step 3: LP correlates in-transit data with incident history; maintains custody chain evidence (timestamp, location, guard ID) for each deposit
Responsible (R): LP
Accountable (A): LP Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W2811_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2811_End9" name="Complete">
        <bpmn:incoming>W2811_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2811_Annotation10">
        <bpmn:text>Controls: - CTL-183 (ensure CIT custody-chain &amp; cash-in-transit integrity.) | - operational: real-time GPS and geofencing
Owner: CIT Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2811_Assoc11" sourceRef="W2811_Annotation10" targetRef="W2811_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W2811_Flow12" sourceRef="W2811_Start5" targetRef="W2811_Task6" />
      <bpmn:sequenceFlow id="W2811_Flow13" sourceRef="W2811_Task6" targetRef="W2811_Task7" />
      <bpmn:sequenceFlow id="W2811_Flow14" sourceRef="W2811_Task7" targetRef="W2811_Task8" />
      <bpmn:sequenceFlow id="W2811_Flow15" sourceRef="W2811_Task8" targetRef="W2811_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2811_diag">
      <bpmndi:BPMNPlane id="W2811_plane" bpmnElement="W_W2811">
        <bpmndi:BPMNShape id="W2811_Lane1_di" bpmnElement="W2811_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Lane2_di" bpmnElement="W2811_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Lane3_di" bpmnElement="W2811_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Task6_di" bpmnElement="W2811_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Task7_di" bpmnElement="W2811_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Task8_di" bpmnElement="W2811_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Start5_di" bpmnElement="W2811_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_End9_di" bpmnElement="W2811_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2811_Annotation10_di" bpmnElement="W2811_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W2811_Flow12_di" bpmnElement="W2811_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2811_Flow13_di" bpmnElement="W2811_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2811_Flow14_di" bpmnElement="W2811_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2811_Flow15_di" bpmnElement="W2811_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2811_Assoc11_di" bpmnElement="W2811_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2812" name="W2812. DC/Regional Vault Operations, Counting &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Cash received at regional/DC vault
Frequency: Daily per vault
Volume: ~4 regional vaults
Owner: Vault Operations Supervisor
Participants: Vault Ops, CIT Operations, Finance, LP
Source: workflow W2812 — DC/Regional Vault Operations, Counting &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W2812_LaneSet3">
        <bpmn:lane id="W2812_Lane1" name="Vault Ops">
        <bpmn:flowNodeRef>W2812_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2812_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2812_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2812_Lane2" name="Finance">
        <bpmn:flowNodeRef>W2812_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2812_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2812_Start4" name="Cash received at regional/DC vault">
        <bpmn:outgoing>W2812_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2812_Task5" name="Vault Ops receives sealed deposit bags under dual-control; logs custody…">
        <bpmn:documentation>Step 1: Vault Ops receives sealed deposit bags under dual-control; logs custody transfer; schedules counting by denomination
Responsible (R): Vault Ops
Accountable (A): Vault Operations Supervisor
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2812_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2812_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2812_Task6" name="Vault Ops counts via currency counter with counterfeit detection; reconciles to…">
        <bpmn:documentation>Step 2: Vault Ops counts via currency counter with counterfeit detection; reconciles to store-reported amount; investigates variances &gt; PHP 1,000
Responsible (R): Vault Ops
Accountable (A): Vault Operations Supervisor
Duration: 2–4 hours/day</bpmn:documentation>
        <bpmn:incoming>W2812_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2812_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2812_Task7" name="Finance posts vault cash to GL; prepares bank deposit; LP reviews variance…">
        <bpmn:documentation>Step 3: Finance posts vault cash to GL; prepares bank deposit; LP reviews variance trend by store for shrink indicators
Responsible (R): Finance / LP
Accountable (A): Finance Controller
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W2812_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2812_End8" name="Complete">
