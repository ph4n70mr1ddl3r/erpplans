        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2813_Start5" name="Vault-to-bank deposit">
        <bpmn:outgoing>W2813_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2813_Task6" name="Vault Ops hands over consolidated deposit to bank under manifest; bank issues…">
        <bpmn:documentation>Step 1: Vault Ops hands over consolidated deposit to bank under manifest; bank issues deposit receipt with counted amount
Responsible (R): Vault Ops / Bank
Accountable (A): Vault Operations Supervisor
Duration: Per deposit</bpmn:documentation>
        <bpmn:incoming>W2813_Flow12</bpmn:incoming>
        <bpmn:outgoing>W2813_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2813_Task7" name="Finance posts deposit receipt to GL; reconciles bank-credited amount to…">
        <bpmn:documentation>Step 2: Finance posts deposit receipt to GL; reconciles bank-credited amount to vault-reported amount; investigates any bank adjustment (counterfeit, mutilated)
Responsible (R): Finance
Accountable (A): Finance Controller
Duration: Per deposit</bpmn:documentation>
        <bpmn:incoming>W2813_Flow13</bpmn:incoming>
        <bpmn:outgoing>W2813_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2813_Task8" name="Treasury confirms bank credit reflected in account; clears cash-in-transit GL…">
        <bpmn:documentation>Step 3: Treasury confirms bank credit reflected in account; clears cash-in-transit GL; resolves timing differences within 1–2 business days
Responsible (R): Treasury
Accountable (A): CFO
Duration: Per deposit</bpmn:documentation>
        <bpmn:incoming>W2813_Flow14</bpmn:incoming>
      </bpmn:userTask>
