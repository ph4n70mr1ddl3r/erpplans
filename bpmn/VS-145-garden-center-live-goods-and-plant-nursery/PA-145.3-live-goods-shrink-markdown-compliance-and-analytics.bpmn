    <bpmn:process id="W_W4358" name="W4358. Live-Goods Inventory Accuracy, Cycle Count &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Cycle-count cycle; inventory-close; accuracy concern
Frequency: Frequent cycle count (live-goods drift faster than hard goods)
Volume: ~1,050 live SKUs × 200 stores cycle counting
Owner: Inventory (VS-05) / Garden Ops / Store Ops (VS-07)
Participants: Inventory (VS-05), Garden Ops, Store Ops (VS-07), Finance (VS-17.4), LP (VS-23)
Source: workflow W4358 — Live-Goods Inventory Accuracy, Cycle Count &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W4358_LaneSet4">
        <bpmn:lane id="W4358_Lane1" name="Inventory">
        <bpmn:flowNodeRef>W4358_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4358_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4358_Lane2" name="Garden Staff">
        <bpmn:flowNodeRef>W4358_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4358_Lane3" name="Finance">
