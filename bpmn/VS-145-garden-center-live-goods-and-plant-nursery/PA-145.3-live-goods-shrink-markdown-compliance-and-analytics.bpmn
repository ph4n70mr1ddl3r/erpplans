    <bpmn:process id="W_W4356" name="W4356. Pesticide/Chemical Handling, PPE &amp; FPA/DENR Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Pesticide use (W4347); chemical storage; compliance cycle
Frequency: Continuous handling + periodic compliance
Volume: Garden pesticide/agrochemical handling
Owner: Garden Ops / HSE (VS-24) / Compliance (VS-22)
Participants: HSE (VS-24), Compliance (VS-22), Garden Staff, DG/Hazmat (VS-114), FPA, DENR, Facilities (VS-138)
Source: workflow W4356 — Pesticide/Chemical Handling, PPE &amp; FPA/DENR Compliance</bpmn:documentation>
      <bpmn:laneSet id="W4356_LaneSet3">
        <bpmn:lane id="W4356_Lane1" name="HSE">
        <bpmn:flowNodeRef>W4356_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4356_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4356_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4356_Lane2" name="Garden Staff">
        <bpmn:flowNodeRef>W4356_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4356_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4356_Start4" name="Pesticide use (W4347); chemical storage; compliance cycle">
