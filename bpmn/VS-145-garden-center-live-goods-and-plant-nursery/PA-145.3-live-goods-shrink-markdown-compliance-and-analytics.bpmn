        <bpmn:flowNodeRef>W4358_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4358_Start5" name="Cycle-count cycle; inventory-close; accuracy concern">
        <bpmn:outgoing>W4358_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4358_Task6" name="Inventory/Garden Ops set live-goods cycle-count frequency (higher than…">
        <bpmn:documentation>Step 1: Inventory/Garden Ops set live-goods cycle-count frequency (higher than hard-goods weekly, given mortality/drift) and the count method (by health-zone/SKU)
Responsible (R): Inventory / Garden Ops
Accountable (A): Inventory Lead / Garden Ops Lead
Duration: Standard</bpmn:documentation>
        <bpmn:incoming>W4358_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4358_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4358_Task7" name="Garden staff/Inventory execute the count, reconcile to system (VS-05)…">
        <bpmn:documentation>Step 2: Garden staff/Inventory execute the count, reconcile to system (VS-05), investigate variance (mortality un-written W4353, theft VS-23, scan-error), and adjust
Responsible (R): Garden Staff / Inventory
Accountable (A): Garden Ops Lead / Inventory Lead
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4358_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4358_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4358_Task8" name="Finance/LP analyze accuracy/variance trends, attribute loss, and feed…">
        <bpmn:documentation>Step 3: Finance/LP analyze accuracy/variance trends, attribute loss, and feed prevention (care, write-off timeliness, security)
Responsible (R): Finance / LP / Inventory
Accountable (A): CFO / LP Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4358_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4358_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4358_End9" name="Complete">
        <bpmn:incoming>W4358_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4358_Annotation10">
        <bpmn:text>Controls: - CTL-91 (ensure live-goods compliance &amp; inventory accuracy.) | - CTL-667: live-goods cycle-counted at higher frequency; variance investigated; loss attributed
Owner: Inventory (VS-05) / Garden Ops / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
