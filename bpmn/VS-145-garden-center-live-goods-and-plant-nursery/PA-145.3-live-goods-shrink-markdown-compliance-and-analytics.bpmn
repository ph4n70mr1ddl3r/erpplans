    <bpmn:process id="W_W4355" name="W4355. Live-Goods Waste, Composting &amp; DENR/Composting Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Dead/unsellable plant disposition; waste cycle
Frequency: Continuous + periodic disposition
Volume: Live-goods green-waste volume
Owner: Garden Ops / Waste (VS-73) / Sustainability (VS-25)
Participants: Waste (VS-73), Sustainability (VS-25), Garden Ops, Facilities (VS-138), DENR/Compost partner, ESG (VS-25)
Source: workflow W4355 — Live-Goods Waste, Composting &amp; DENR/Composting Compliance</bpmn:documentation>
      <bpmn:laneSet id="W4355_LaneSet3">
        <bpmn:lane id="W4355_Lane1" name="Garden Ops">
        <bpmn:flowNodeRef>W4355_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4355_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4355_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4355_Lane2" name="Sustainability">
        <bpmn:flowNodeRef>W4355_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4355_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4355_Start4" name="Dead/unsellable plant disposition; waste cycle">
        <bpmn:outgoing>W4355_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4355_Task5" name="Garden Ops/Waste set the green-waste disposition — on-site composting, partner…">
        <bpmn:documentation>Step 1: Garden Ops/Waste set the green-waste disposition — on-site composting, partner composting, organic-waste collection, or (last resort) disposal — preferring diversion
Responsible (R): Garden Ops / Waste / Sustainability
Accountable (A): Garden Ops Lead / Sustainability Lead
Duration: Standard</bpmn:documentation>
        <bpmn:incoming>W4355_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4355_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4355_Task6" name="Garden Ops/Waste process dead/unsellable plants to the chosen channel, exclude…">
        <bpmn:documentation>Step 2: Garden Ops/Waste process dead/unsellable plants to the chosen channel, exclude chemically-treated/pesticide-contaminated material from compost, and document
Responsible (R): Garden Ops / Waste
Accountable (A): Garden Ops Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4355_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4355_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4355_Task7" name="Sustainability/ESG track diversion tonnes, compost output, and the disposal…">
        <bpmn:documentation>Step 3: Sustainability/ESG track diversion tonnes, compost output, and the disposal outcome for ESG reporting (VS-25) and the circular economy
Responsible (R): Sustainability / ESG
Accountable (A): Sustainability Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4355_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4355_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4355_End8" name="Complete">
        <bpmn:incoming>W4355_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4355_Annotation9">
        <bpmn:text>Controls: - CTL-91 (ensure live-goods compliance &amp; inventory accuracy.) | - CTL-667: pesticide-contaminated material excluded from compost; diversion preferred; outcome documented (VS-25)
Owner: Garden Ops / Waste (VS-73) / Sustainability (VS-25)</bpmn:text>
      </bpmn:textAnnotation>
