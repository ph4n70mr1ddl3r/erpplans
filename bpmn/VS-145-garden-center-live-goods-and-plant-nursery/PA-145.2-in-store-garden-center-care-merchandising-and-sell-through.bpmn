    <bpmn:process id="W_W4345" name="W4345. Garden Center Daily Care, Watering, Pruning &amp; Rotation" isExecutable="false">
      <bpmn:documentation>Trigger: Daily store operation (garden center)
Frequency: Daily per store garden center
Volume: 200 store garden centers × daily care cycles
Owner: Garden Center Staff / Store Ops (VS-07) / Garden Ops
Participants: Garden Staff, Store Ops (VS-07), Garden Ops, Vendor (VS-03), HSE (VS-24)
Source: workflow W4345 — Garden Center Daily Care, Watering, Pruning &amp; Rotation</bpmn:documentation>
      <bpmn:laneSet id="W4345_LaneSet3">
        <bpmn:lane id="W4345_Lane1" name="Garden Staff">
        <bpmn:flowNodeRef>W4345_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4345_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4345_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4345_Lane2" name="Store Ops">
        <bpmn:flowNodeRef>W4345_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4345_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4345_Start4" name="Daily store operation (garden center)">
        <bpmn:outgoing>W4345_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4345_Task5" name="Garden staff execute the daily care schedule — water by plant need…">
        <bpmn:documentation>Step 1: Garden staff execute the daily care schedule — water by plant need (species/season), inspect/prune, remove dead material, and rotate stock (oldest/declining to front for sell-through)
Responsible (R): Garden Staff
Accountable (A): Garden Ops Lead / Store Mgr
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4345_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4345_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4345_Task6" name="Garden staff monitor micro-climate (sun/shade/heat), adjust protection (shade…">
        <bpmn:documentation>Step 2: Garden staff monitor micro-climate (sun/shade/heat), adjust protection (shade net, misting) for hot/rainy conditions, and flag declining stock for markdown (W4341)
Responsible (R): Garden Staff
Accountable (A): Garden Ops Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4345_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4345_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4345_Task7" name="Store Ops/Garden Ops verify care execution (checklist), track plant condition…">
        <bpmn:documentation>Step 3: Store Ops/Garden Ops verify care execution (checklist), track plant condition, and feed shrink/markdown data (W4353)
Responsible (R): Store Ops / Garden Ops
Accountable (A): Store Mgr / Garden Ops Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4345_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4345_End8" name="Complete">
        <bpmn:incoming>W4345_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4345_Annotation9">
        <bpmn:text>Controls: - CTL-666 (ensure controlled execution — In-Store Garden Center Care, Merchandising &amp; Sell-Through (PA-145.2).) | - CTL-666: daily care checklist executed; declining stock flagged for markdown (W4341); care verified
Owner: Garden Center Staff / Store Ops (VS-07) / Garden Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4345_Assoc10" sourceRef="W4345_Annotation9" targetRef="W4345_Start4" associationDirection="None" />
