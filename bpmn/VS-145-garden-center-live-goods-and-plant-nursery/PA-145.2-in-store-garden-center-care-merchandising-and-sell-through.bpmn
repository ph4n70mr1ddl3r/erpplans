    <bpmn:process id="W_W4347" name="W4347. Plant Health Monitoring, Pest/Disease &amp; Treatment" isExecutable="false">
      <bpmn:documentation>Trigger: Pest/disease detected; routine monitoring
Frequency: Continuous monitoring + per outbreak
Volume: Per-store plant-health across live stock
Owner: Garden Ops / Garden Staff / Quality (VS-31)
Participants: Garden Staff, Quality (VS-31), HSE (VS-24), Pest-control Vendor, Compliance (FPA VS-22)
Source: workflow W4347 — Plant Health Monitoring, Pest/Disease &amp; Treatment</bpmn:documentation>
      <bpmn:laneSet id="W4347_LaneSet4">
        <bpmn:lane id="W4347_Lane1" name="Garden Staff">
        <bpmn:flowNodeRef>W4347_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4347_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4347_Lane2" name="Garden Ops">
        <bpmn:flowNodeRef>W4347_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4347_Lane3" name="Quality">
        <bpmn:flowNodeRef>W4347_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4347_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4347_Start5" name="Pest/disease detected; routine monitoring">
        <bpmn:outgoing>W4347_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4347_Task6" name="Garden staff monitor plant health daily (yellowing, wilting, spots, pests)…">
        <bpmn:documentation>Step 1: Garden staff monitor plant health daily (yellowing, wilting, spots, pests), identify pest/disease early, and isolate affected plants
Responsible (R): Garden Staff
Accountable (A): Garden Ops Lead
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W4347_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4347_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4347_Task7" name="Garden Ops/staff treat per protocol (biological/preferred-first, pesticide per…">
        <bpmn:documentation>Step 2: Garden Ops/staff treat per protocol (biological/preferred-first, pesticide per FPA W4356), apply safely with PPE, and document treatment
Responsible (R): Garden Ops / Staff
Accountable (A): Garden Ops Lead / HSE
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4347_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4347_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4347_Task8" name="Quality/HSE verify treatment efficacy &amp; safety, escalate severe outbreak, and…">
        <bpmn:documentation>Step 3: Quality/HSE verify treatment efficacy &amp; safety, escalate severe outbreak, and feed prevention/protocol improvement
Responsible (R): Quality / HSE
Accountable (A): Quality Lead / HSE Mgr
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W4347_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4347_End9" name="Complete">
        <bpmn:incoming>W4347_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4347_Annotation10">
        <bpmn:text>Controls: - CTL-91 (ensure live-goods compliance &amp; inventory accuracy.) | - CTL-666: daily health monitoring; affected plants isolated; treatment FPA-compliant with PPE (W4356)
Owner: Garden Ops / Garden Staff / Quality (VS-31)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4347_Assoc11" sourceRef="W4347_Annotation10" targetRef="W4347_Start5" associationDirection="None" />
