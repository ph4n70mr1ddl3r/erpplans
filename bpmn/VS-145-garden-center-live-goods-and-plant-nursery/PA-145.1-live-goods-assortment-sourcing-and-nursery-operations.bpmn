      <bpmn:startEvent id="W4344_Start5" name="Seasonal event (ber-months, Valentine, Holy Week, rainy); promo cycle">
        <bpmn:outgoing>W4344_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4344_Task6" name="Garden Buyer/Marketing plan the seasonal program (poinsettias/Christmas…">
        <bpmn:documentation>Step 1: Garden Buyer/Marketing plan the seasonal program (poinsettias/Christmas, Valentine, Holy Week, rainy-season) — range, volume, land-dates, promo, display, and sell-through/clear target
Responsible (R): Garden Buyer / Marketing
Accountable (A): Head of Merch / CMO
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4344_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4344_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4344_Task7" name="Supply/Garden Ops align grower delivery to land-dates and store capacity, and…">
        <bpmn:documentation>Step 2: Supply/Garden Ops align grower delivery to land-dates and store capacity, and stage the seasonal flow to hit peak without overstock → mortality
Responsible (R): Supply / Garden Ops
Accountable (A): Head of Merch
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4344_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4344_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4344_Task8" name="Marketing/Store execute promo/display, drive sell-through, and clear post-event…">
        <bpmn:documentation>Step 3: Marketing/Store execute promo/display, drive sell-through, and clear post-event per the markdown/clearance ladder (W4341) to minimize mortality
Responsible (R): Marketing / Store / Garden Ops
Accountable (A): CMO / Head of Merch
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4344_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4344_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4344_End9" name="Complete">
        <bpmn:incoming>W4344_Flow15</bpmn:incoming>
      </bpmn:endEvent>
