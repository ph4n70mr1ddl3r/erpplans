    <bpmn:process id="W_W4339" name="W4339. Live-Goods Inbound Receiving, Acclimatization &amp; Quarantine" isExecutable="false">
      <bpmn:documentation>Trigger: Live-goods delivery to DC/store garden center
Frequency: Per live-goods receipt (seasonal peaks)
Volume: Live-goods receipts (seasonal-batched)
Owner: Garden Ops / DC Inbound (VS-04) / Quality (VS-31)
Participants: DC Ops (VS-04), Store Ops (VS-07), Quality (VS-31), Vendor (VS-03), HSE (VS-24)
Source: workflow W4339 — Live-Goods Inbound Receiving, Acclimatization &amp; Quarantine</bpmn:documentation>
      <bpmn:laneSet id="W4339_LaneSet2">
        <bpmn:lane id="W4339_Lane1" name="Garden Ops">
        <bpmn:flowNodeRef>W4339_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4339_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4339_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4339_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4339_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4339_Start3" name="Live-goods delivery to DC/store garden center">
        <bpmn:outgoing>W4339_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4339_Task4" name="Garden Ops/Quality receive live goods — inspect survival/health on arrival (vs…">
        <bpmn:documentation>Step 1: Garden Ops/Quality receive live goods — inspect survival/health on arrival (vs grower), check pest/disease, verify phytosanitary (W4338), and reject/sub-standard stock
Responsible (R): Garden Ops / Quality
Accountable (A): Garden Ops Lead / Quality Lead
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W4339_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4339_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4339_Task5" name="Garden Ops acclimatize received plants (shade/light/humidity transition) and…">
        <bpmn:documentation>Step 2: Garden Ops acclimatize received plants (shade/light/humidity transition) and quarantine suspect/infested stock before floor placement
Responsible (R): Garden Ops
Accountable (A): Garden Ops Lead
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W4339_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4339_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4339_Task6" name="Garden Ops/DC post receipt to inventory (VS-05) with received condition…">
        <bpmn:documentation>Step 3: Garden Ops/DC post receipt to inventory (VS-05) with received condition, attribute health-grade, and trigger any vendor claim (W4353) for sub-standard/dead-on-arrival
Responsible (R): Garden Ops / DC
Accountable (A): Garden Ops Lead
Duration: Per receipt</bpmn:documentation>
        <bpmn:incoming>W4339_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4339_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4339_End7" name="Complete">
        <bpmn:incoming>W4339_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4339_Annotation8">
        <bpmn:text>Controls: - CTL-665 (ensure controlled execution — Live-Goods Assortment, Sourcing &amp; Nursery Operations (PA-145.1).) | - CTL-665: survival/health inspected on arrival; quarantine for suspect stock; DOA claimed vs vendor (VS-90/VS-31)
Owner: Garden Ops / DC Inbound (VS-04) / Quality (VS-31)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4339_Assoc9" sourceRef="W4339_Annotation8" targetRef="W4339_Start3" associationDirection="None" />
