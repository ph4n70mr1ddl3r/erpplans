    <bpmn:process id="W_W4340" name="W4340. Garden Center Nursery, Propagation &amp; Plant Health Care" isExecutable="false">
      <bpmn:documentation>Trigger: Store garden-center operation; propagation cycle
Frequency: Continuous + propagation cycles
Volume: Per-store nursery/back-stock operations
Owner: Garden Ops / Garden Center Staff
Participants: Garden Center Staff, Store Ops (VS-07), Quality (VS-31), Vendor (VS-03), HSE (VS-24)
Source: workflow W4340 — Garden Center Nursery, Propagation &amp; Plant Health Care</bpmn:documentation>
      <bpmn:laneSet id="W4340_LaneSet4">
        <bpmn:lane id="W4340_Lane1" name="Garden Ops">
        <bpmn:flowNodeRef>W4340_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4340_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4340_Lane2" name="Staff">
        <bpmn:flowNodeRef>W4340_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4340_Lane3" name="Quality">
        <bpmn:flowNodeRef>W4340_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4340_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4340_Start5" name="Store garden-center operation; propagation cycle">
        <bpmn:outgoing>W4340_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4340_Task6" name="Garden Ops/staff run the store nursery/back-stock — holding/recovery area for…">
        <bpmn:documentation>Step 1: Garden Ops/staff run the store nursery/back-stock — holding/recovery area for plants needing care, propagation of select lines, and rotation of back-stock to floor
Responsible (R): Garden Ops / Staff
Accountable (A): Garden Ops Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4340_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4340_Flow13</bpmn:outgoing>
      </bpmn:userTask>
