        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5421_Start5" name="New connected-device procurement/deployment (new POS model, SCO rollout VS-149…">
        <bpmn:outgoing>W5421_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5421_Task6" name="Require a pre-procurement OT security review of any new connected device —…">
        <bpmn:documentation>Step 1: Require a pre-procurement OT security review of any new connected device — vendor SBOM, firmware update model, cloud-dependency, default-credential posture, disclosed vulnerabilities/CVE history.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per model</bpmn:documentation>
        <bpmn:incoming>W5421_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5421_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5421_Task7" name="Verify the device passes its class secure-configuration baseline (W5420) and…">
        <bpmn:documentation>Step 2: Verify the device passes its class secure-configuration baseline (W5420) and IT/OT segmentation placement (W5418) before PO release.
Responsible (R): OT Security Engineer
Accountable (A): OT Security Lead
Duration: per model</bpmn:documentation>
        <bpmn:incoming>W5421_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5421_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5421_Task8" name="Confirm default credentials replaced, vendor cloud links explicitly approved or…">
        <bpmn:documentation>Step 3: Confirm default credentials replaced, vendor cloud links explicitly approved or disabled, and logging/monitoring onboarded (W5425) at install.
Responsible (R): OT Security Engineer
Accountable (A): OT Security Lead
Duration: per site</bpmn:documentation>
        <bpmn:incoming>W5421_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5421_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5421_Task9" name="Register the device in the OT asset register (W5417) with criticality tier and…">
        <bpmn:documentation>Step 4: Register the device in the OT asset register (W5417) with criticality tier and onboarding evidence; block go-live until registered.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per device</bpmn:documentation>
        <bpmn:incoming>W5421_Flow17</bpmn:incoming>
        <bpmn:outgoing>W5421_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5421_Task10" name="Feed device vendor risk into the TPRM tiering (VS-161) and contractual security…">
        <bpmn:documentation>Step 5: Feed device vendor risk into the TPRM tiering (VS-161) and contractual security requirements (SBOM, vuln disclosure, support lifecycle).
Responsible (R): OT Security Lead
Accountable (A): VP Legal &amp; Compliance
Duration: per model</bpmn:documentation>
        <bpmn:incoming>W5421_Flow18</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5421_End11" name="Complete">
        <bpmn:incoming>W5421_Flow19</bpmn:incoming>
      </bpmn:endEvent>
