<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-190.1-ot-asset-inventory-architecture-and-it-ot-segmentation-governance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5417" name="W5417. OT/ICS Asset Discovery, Inventory &amp; Cyber Risk Taxonomy" isExecutable="false">
      <bpmn:documentation>Trigger: Program stand-up; new site/store/DC commissioning (VS-37); new connected-device channel go-live (VS-163/VS-164/VS-149)
Frequency: Continuous discovery; full re-inventory quarterly
Volume: 1 OT estate across ~205 sites + 4 DCs + HQ — ~25,000–40,000 OT endpoints (600 POS, ~3–5 BMS/fire panels/site, access-control controllers, ~200+ generators, SCADA on solar plants, EV/locker/SCO controllers, weighbridges, IoT sensors)
Owner: OT Security Lead (IT Security, VS-27.3)
Participants: Facilities/IFM (VS-138), DC Ops (VS-04), Store Ops (VS-07), Energy/Solar Ops (VS-108), EV/Locker Ops (VS-163/VS-164), IT Asset Mgmt (VS-99)
Source: workflow W5417 — OT/ICS Asset Discovery, Inventory &amp; Cyber Risk Taxonomy</bpmn:documentation>
      <bpmn:laneSet id="W5417_LaneSet3">
        <bpmn:lane id="W5417_Lane1" name="OT Security Analyst">
        <bpmn:flowNodeRef>W5417_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5417_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5417_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5417_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5417_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5417_Lane2" name="OT Security Lead">
        <bpmn:flowNodeRef>W5417_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5417_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5417_Start4" name="Program stand-up; new site/store/DC commissioning (VS-37); new connected-device channel…">
        <bpmn:outgoing>W5417_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5417_Task5" name="Passive/active-discover OT endpoints per site (ARP/LLDP sweeps, asset tags…">
        <bpmn:documentation>Step 1: Passive/active-discover OT endpoints per site (ARP/LLDP sweeps, asset tags, vendor manifests from IFM/DC) — never active-scan a safety PLC without ops sign-off.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per site</bpmn:documentation>
        <bpmn:incoming>W5417_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5417_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5417_Task6" name="Classify each asset into the OT taxonomy: BMS/HVAC, fire/life-safety, access…">
        <bpmn:documentation>Step 2: Classify each asset into the OT taxonomy: BMS/HVAC, fire/life-safety, access control, CCTV/EAS (VS-23), generator/ATS, fuel monitoring, paint/cutting PLC, lumber-yard automation, SCADA solar, EV controller, locker/SCO controller, POS, RF/WMS infra, weighbridge, IoT sensor.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per asset</bpmn:documentation>
        <bpmn:incoming>W5417_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5417_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5417_Task7" name="Capture the cyber attributes IT CMDBs miss: firmware/PLC revision…">
        <bpmn:documentation>Step 3: Capture the cyber attributes IT CMDBs miss: firmware/PLC revision, engineering-workstation exposure, default-credential status, serial/fieldbus (Modbus/BACnet/OPC-UA), vendor, safety impact level.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: per asset</bpmn:documentation>
        <bpmn:incoming>W5417_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5417_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5417_Task8" name="Assign OT criticality tier (Safety-of-life / Store-closing / Revenue /…">
        <bpmn:documentation>Step 4: Assign OT criticality tier (Safety-of-life / Store-closing / Revenue / Operational) driving segmentation and monitoring priority.
Responsible (R): OT Security Lead
Accountable (A): OT Security Lead
Duration: per asset</bpmn:documentation>
        <bpmn:incoming>W5417_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5417_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5417_Task9" name="Load into the OT asset register (separate view from IT CMDB per VS-99) and…">
        <bpmn:documentation>Step 5: Load into the OT asset register (separate view from IT CMDB per VS-99) and reconcile against IFM/DC/EV/locker asset lists.
Responsible (R): OT Security Analyst
Accountable (A): OT Security Lead
Duration: quarterly</bpmn:documentation>
        <bpmn:incoming>W5417_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5417_End10" name="Complete">
        <bpmn:incoming>W5417_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5417_Annotation11">
        <bpmn:text>Controls: - CTL-800 (ensure controlled execution — OT Asset Inventory, Architecture &amp; IT/OT Segmentation Governance (PA-190.1).) | - operational: asset-inventory completeness extended to OT; segregation of duties on OT criticality assignment; no active scan of a safety PLC without facilities/ops sign-off.
Owner: OT Security Lead (IT Security, VS-27.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5417_Assoc12" sourceRef="W5417_Annotation11" targetRef="W5417_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5417_Flow13" sourceRef="W5417_Start4" targetRef="W5417_Task5" />
      <bpmn:sequenceFlow id="W5417_Flow14" sourceRef="W5417_Task5" targetRef="W5417_Task6" />
      <bpmn:sequenceFlow id="W5417_Flow15" sourceRef="W5417_Task6" targetRef="W5417_Task7" />
      <bpmn:sequenceFlow id="W5417_Flow16" sourceRef="W5417_Task7" targetRef="W5417_Task8" />
      <bpmn:sequenceFlow id="W5417_Flow17" sourceRef="W5417_Task8" targetRef="W5417_Task9" />
      <bpmn:sequenceFlow id="W5417_Flow18" sourceRef="W5417_Task9" targetRef="W5417_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5417_diag">
      <bpmndi:BPMNPlane id="W5417_plane" bpmnElement="W_W5417">
        <bpmndi:BPMNShape id="W5417_Lane1_di" bpmnElement="W5417_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1370" height="170" /></bpmndi:BPMNShape>
