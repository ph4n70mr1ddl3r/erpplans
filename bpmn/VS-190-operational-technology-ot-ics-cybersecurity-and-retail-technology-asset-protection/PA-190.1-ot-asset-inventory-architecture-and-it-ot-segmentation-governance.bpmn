Accountable (A): OT Security Lead
Duration: quarterly</bpmn:documentation>
        <bpmn:incoming>W5422_Flow16</bpmn:incoming>
        <bpmn:outgoing>W5422_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5422_Task9" name="Approve and apply rule changes through change control (VS-27.1) with documented…">
