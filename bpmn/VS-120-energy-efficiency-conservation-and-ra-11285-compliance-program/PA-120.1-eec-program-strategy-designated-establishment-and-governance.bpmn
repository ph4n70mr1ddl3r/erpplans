    <bpmn:process id="W_W3738" name="W3738. RA 11285 Designated-Establishment Classification &amp; DOE Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Program strategy (W3737); new site; threshold change
Frequency: Annual + on change
Volume: ~205 sites; entity-level designation
Owner: EEO / Compliance
Participants: EEO, Compliance (links to VS-22), Sustainability (links to VS-25), Facilities (links to VS-20.3), Legal (links to VS-100.3), Cross-Entity (links to VS-72), Records (links to VS-88)
Source: workflow W3738 — RA 11285 Designated-Establishment Classification &amp; DOE Registration</bpmn:documentation>
      <bpmn:laneSet id="W3738_LaneSet2">
        <bpmn:lane id="W3738_Lane1" name="EEO">
        <bpmn:flowNodeRef>W3738_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3738_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3738_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3738_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3738_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3738_Start3" name="Program strategy (W3737); new site; threshold change">
        <bpmn:outgoing>W3738_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3738_Task4" name="EEO/Compliance classify each site/entity under RA 11285…">
        <bpmn:documentation>Step 1: EEO/Compliance classify each site/entity under RA 11285 designated-establishment thresholds (Type 1: 500,000–4,000,000 kWh/yr; Type 2: &gt;4,000,000 kWh/yr), determine the per-site and per-entity obligations (energy audit frequency, conservation plan, EEO designation, reporting), and register with DOE per the IRR
Responsible (R): EEO / Compliance / Legal
Accountable (A): EEO
Duration: Annual + on new site</bpmn:documentation>
        <bpmn:incoming>W3738_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3738_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3738_Task5" name="EEO/Compliance manage the DOE registration and designation lifecycle: submit…">
        <bpmn:documentation>Step 2: EEO/Compliance manage the DOE registration and designation lifecycle: submit the EEO designation, maintain the designated-establishment record, manage DOE designated-establishment registration and annual reporting via the DEOS portal, and respond to DOE inquiries
Responsible (R): EEO / Compliance / Records
Accountable (A): EEO
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W3738_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3738_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3738_Task6" name="EEO/Compliance track obligation compliance per site/entity (audit due-dates…">
        <bpmn:documentation>Step 3: EEO/Compliance track obligation compliance per site/entity (audit due-dates, plan submission, reporting deadlines), report compliance status to governance (links to W3737/VS-22) and audit (links to VS-21), and manage any non-compliance corrective action
Responsible (R): EEO / Compliance
Accountable (A): EEO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3738_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3738_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3738_End7" name="Complete">
        <bpmn:incoming>W3738_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3738_Annotation8">
        <bpmn:text>Controls: - CTL-138 (ensure RA 11285 energy compliance &amp; M&amp;V integrity.) | - operational: threshold-based classification; operational: deadline tracking
Owner: EEO / Compliance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3738_Assoc9" sourceRef="W3738_Annotation8" targetRef="W3738_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3738_Flow10" sourceRef="W3738_Start3" targetRef="W3738_Task4" />
      <bpmn:sequenceFlow id="W3738_Flow11" sourceRef="W3738_Task4" targetRef="W3738_Task5" />
      <bpmn:sequenceFlow id="W3738_Flow12" sourceRef="W3738_Task5" targetRef="W3738_Task6" />
      <bpmn:sequenceFlow id="W3738_Flow13" sourceRef="W3738_Task6" targetRef="W3738_End7" />
    </bpmn:process>
