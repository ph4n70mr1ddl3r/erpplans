<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-37.1-new-store-project-planning" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1737" name="W1737. New Store Project Charter &amp; Kickoff" isExecutable="false">
      <bpmn:documentation>Trigger: Site approved per W20.1 (Site Selection &amp; Lease Management); lease signed
Frequency: ~10–15 new stores/year
Volume: 1 project charter per new store
Owner: VP Store Operations
Participants: VP Store Operations, COO, CFO, CIO, CHRO, CMO, VP Supply Chain
Source: workflow W1737 — New Store Project Charter &amp; Kickoff</bpmn:documentation>
      <bpmn:laneSet id="W1737_LaneSet4">
        <bpmn:lane id="W1737_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1737_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1737_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1737_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1737_Lane2" name="Store Opening Coordinator">
        <bpmn:flowNodeRef>W1737_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1737_Lane3" name="COO">
        <bpmn:flowNodeRef>W1737_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1737_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1737_Start5" name="Site approved per W20.1 (Site Selection &amp; Lease Management); lease signed">
        <bpmn:outgoing>W1737_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1737_Task6" name="VP Store Operations creates project charter for new store: (a) store number and…">
        <bpmn:documentation>Step 1: VP Store Operations creates project charter for new store: (a) store number and name (format: BRD-XXX sequential), (b) location: address, region, store size (sqm), (c) target opening date (typically 4–6 months from lease signing), (d) project budget per financial model from W1652, (e) project team: Store Opening Coordinator (dedicated), Store Manager (appointed 3 months before opening), department representatives from IT, HR, Supply Chain, Marketing, (f) key milestones: construction complete, staff hired, inventory received, systems live, soft opening, grand opening
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1737_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1737_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1737_Task7" name="Kickoff meeting with all functional leads: (a) review project charter and…">
        <bpmn:documentation>Step 2: Kickoff meeting with all functional leads: (a) review project charter and timeline, (b) assign functional workstreams and owners, (c) agree on communication cadence (weekly status meetings, steering committee bi-weekly), (d) identify cross-functional dependencies, (e) risk identification and mitigation planning
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1737_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1737_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1737_Task8" name="Project setup in project management tool: (a) work breakdown structure per…">
        <bpmn:documentation>Step 3: Project setup in project management tool: (a) work breakdown structure per functional area, (b) task assignments with due dates, (c) critical path highlighted, (d) budget allocated per workstream, (e) status reporting template
Responsible (R): Store Opening Coordinator
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1737_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1737_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1737_Task9" name="Steering committee formed: COO (chair), VP Store Operations, CFO, CIO, COO…">
        <bpmn:documentation>Step 4: Steering committee formed: COO (chair), VP Store Operations, CFO, CIO, COO; meets bi-weekly to review progress and resolve escalations
Responsible (R): COO
Accountable (A): —
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1737_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1737_End10" name="Complete">
        <bpmn:incoming>W1737_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1737_Annotation11">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1737_Assoc12" sourceRef="W1737_Annotation11" targetRef="W1737_Start5" associationDirection="None" />
