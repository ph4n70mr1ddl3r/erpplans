    <bpmn:process id="W_W1741" name="W1741. IT Infrastructure &amp; Systems Setup Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Project kickoff (W1737)
Frequency: ~10–15 setups/year
Volume: 1 complete IT setup per new store
Owner: IT Infrastructure Manager
Participants: IT Infrastructure Manager, IT Applications, Network Team, POS Vendor, Store Opening Coordinator
Source: workflow W1741 — IT Infrastructure &amp; Systems Setup Planning</bpmn:documentation>
      <bpmn:laneSet id="W1741_LaneSet5">
        <bpmn:lane id="W1741_Lane1" name="IT Infrastructure Manager">
        <bpmn:flowNodeRef>W1741_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1741_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1741_Lane2" name="IT Applications">
        <bpmn:flowNodeRef>W1741_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1741_Lane3" name="IT Infrastructure Team">
        <bpmn:flowNodeRef>W1741_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1741_Lane4" name="IT Helpdesk">
        <bpmn:flowNodeRef>W1741_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1741_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1741_Start6" name="Project kickoff (W1737)">
        <bpmn:outgoing>W1741_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1741_Task7" name="IT Infrastructure Manager plans store IT setup: (a) network: MPLS or VPN…">
        <bpmn:documentation>Step 1: IT Infrastructure Manager plans store IT setup: (a) network: MPLS or VPN connection to HQ (primary) + 4G/5G backup (critical for POS offline capability), (b) Wi-Fi access points for store operations and customer Wi-Fi, (c) POS: 3 terminals configured with store-specific settings (tax, pricing, loyalty), (d) RF guns: 4–6 handhelds configured and connected to WMS, (e) CCTV: IP cameras connected to NVR (local) and central monitoring (HQ), (f) backroom: workstation for Store Manager, receiving tablet, (g) UPS (uninterruptible power supply) for POS and network equipment, (h) printer/scanner for backroom operations
Responsible (R): IT Infrastructure Manager
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1741_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1741_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1741_Task8" name="ERP system configuration for new store: (a) create new store location in master…">
        <bpmn:documentation>Step 2: ERP system configuration for new store: (a) create new store location in master data (store number, address, DC assignment, pricing zone, tax jurisdiction — LGU), (b) configure POS terminal profiles for the new store, (c) set up store-specific pricing (regional pricing if applicable), (d) configure replenishment parameters (ROP, safety stock for 35,000 SKUs), (e) establish store GL cost center and profit center, (f) configure store-specific reporting hierarchy, (g) set up store in ecommerce fulfillment network (BOPIS location)
Responsible (R): IT Applications
Accountable (A): CIO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1741_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1741_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1741_Task9" name="Physical IT installation: (a) ISP installs primary and backup internet…">
        <bpmn:documentation>Step 3: Physical IT installation: (a) ISP installs primary and backup internet connections (schedule 4 weeks before opening — ISP lead time in provincial areas can be 2–4 weeks), (b) network equipment (router, switch, access points) installed and tested, (c) POS terminals installed, connected to network, and tested (transaction, receipt, cash drawer), (d) RF guns configured and connectivity tested, (e) CCTV installed and central monitoring verified, (f) UPS tested under load, (g) offline POS capability tested (simulate network failure — must sell for ≥ 8 hours offline)
Responsible (R): IT Infrastructure Team
Accountable (A): IT Infrastructure Manager
Duration: 1–2 weeks on-site</bpmn:documentation>
        <bpmn:incoming>W1741_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1741_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1741_Task10" name="User accounts created: Store Manager and all staff accounts in ERP, POS login…">
        <bpmn:documentation>Step 4: User accounts created: Store Manager and all staff accounts in ERP, POS login credentials, email accounts, system access per role
Responsible (R): IT Helpdesk
Accountable (A): IT Infrastructure Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1741_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1741_End11" name="Complete">
        <bpmn:incoming>W1741_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1741_Annotation12">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
