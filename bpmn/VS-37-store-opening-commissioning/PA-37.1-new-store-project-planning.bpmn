      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1738" name="W1738. Store Layout Design &amp; Planogram Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Project kickoff (W1737); floor plans received from Real Estate/Construction team
Frequency: ~10–15 designs/year
Volume: 1 layout per new store (8,000–15,000 sqm)
Owner: VP Merchandising
Participants: VP Merchandising, Category Managers, VP Store Operations, Store Opening Coordinator
Source: workflow W1738 — Store Layout Design &amp; Planogram Planning</bpmn:documentation>
      <bpmn:laneSet id="W1738_LaneSet4">
        <bpmn:lane id="W1738_Lane1" name="VP Merchandising">
        <bpmn:flowNodeRef>W1738_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1738_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1738_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1738_Lane2" name="Category Managers">
        <bpmn:flowNodeRef>W1738_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1738_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1738_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1738_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1738_Start5" name="Project kickoff (W1737); floor plans received from Real Estate/Construction team">
        <bpmn:outgoing>W1738_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1738_Task6" name="VP Merchandising and Category Managers design store layout based on…">
        <bpmn:documentation>Step 1: VP Merchandising and Category Managers design store layout based on standardized big-box template with adjustments for store size and local market: (a) zone allocation: main sales floor, lumber yard, tile gallery, appliance section, tool wall, paint station, checkout area, receiving/backroom, customer service counter, (b) category adjacencies: plumbing near tools, electrical near lighting, paint near finishes, (c) traffic flow: entrance → impulse/high-margin → destination categories → checkout, (d) fixture type and quantity per category per store size
Responsible (R): VP Merchandising / Category Managers
Accountable (A): VP Store Operations
Duration: 1–2 weeks/store</bpmn:documentation>
        <bpmn:incoming>W1738_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1738_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1738_Task7" name="Planogram creation per category: (a) shelf layout with SKU placement, (b)…">
        <bpmn:documentation>Step 2: Planogram creation per category: (a) shelf layout with SKU placement, (b) product grouping (brand blocks, price laddering), (c) signage and price tag placement, (d) seasonal/promotional display locations, (e) use standardized planogram templates (adjusted for store size tier: small 8,000 sqm, medium 10,000 sqm, large 15,000 sqm)
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: 3–5 days/store</bpmn:documentation>
        <bpmn:incoming>W1738_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1738_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1738_Task8" name="VP Store Operations reviews layout for operational feasibility: (a) receiving…">
        <bpmn:documentation>Step 3: VP Store Operations reviews layout for operational feasibility: (a) receiving dock accessibility for trucks, (b) backroom size adequate for receiving and BOPIS staging, (c) aisle width for cart and forklift access, (d) POS terminal placement for customer flow, (e) safety: fire exits, emergency routes, hazmat storage for paint/chemicals
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W1738_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1738_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1738_Task9" name="Final layout approved; fixture and equipment list generated for procurement per…">
        <bpmn:documentation>Step 4: Final layout approved; fixture and equipment list generated for procurement per W1740
Responsible (R): VP Merchandising / VP Store Operations
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1738_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1738_End10" name="Complete">
        <bpmn:incoming>W1738_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1738_Annotation11">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: VP Merchandising review and approval gate
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1738_Assoc12" sourceRef="W1738_Annotation11" targetRef="W1738_Start5" associationDirection="None" />
