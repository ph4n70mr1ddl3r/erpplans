    <bpmn:process id="W_W1740" name="W1740. Store Equipment &amp; Fixture Procurement" isExecutable="false">
      <bpmn:documentation>Trigger: Store layout approved (W1738); equipment list generated
Frequency: ~10–15 procurement cycles/year
Volume: ~PHP 15–25M in fixtures and equipment per store
Owner: VP Store Operations
Participants: VP Store Operations, Procurement, Suppliers, Store Opening Coordinator
Source: workflow W1740 — Store Equipment &amp; Fixture Procurement</bpmn:documentation>
      <bpmn:laneSet id="W1740_LaneSet5">
        <bpmn:lane id="W1740_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1740_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1740_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1740_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W1740_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1740_Lane3" name="Contractor">
        <bpmn:flowNodeRef>W1740_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1740_Lane4" name="Store Opening Coordinator">
        <bpmn:flowNodeRef>W1740_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1740_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1740_Start6" name="Store layout approved (W1738); equipment list generated">
        <bpmn:outgoing>W1740_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1740_Task7" name="Standard equipment and fixture list per store: (a) shelving and racking (main…">
        <bpmn:documentation>Step 1: Standard equipment and fixture list per store: (a) shelving and racking (main floor, lumber yard, backroom), (b) 3 POS terminals + cash drawers + receipt printers + customer displays, (c) paint mixing station, (d) lumber cutting station, (e) pipe threading/cutting equipment, (f) shopping carts (50–100 per store), (g) hand trucks and pallet jacks (receiving), (h) RF guns / handheld scanners (4–6 per store), (i) CCTV cameras (16–24 per store), (j) safety equipment (fire extinguishers, first aid kits, PPE), (k) signage (exterior, department, category, promotional), (l) customer service counter, (m) breakroom equipment, (n) generator (backup power — critical for Philippine power reliability)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day (standard list)</bpmn:documentation>
        <bpmn:incoming>W1740_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1740_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1740_Task8" name="Procurement sources equipment: (a) leverage existing vendor contracts for…">
        <bpmn:documentation>Step 2: Procurement sources equipment: (a) leverage existing vendor contracts for standardized items (POS, shelving, CCTV), (b) obtain quotes for store-specific items (custom signage, fixtures), (c) place POs with delivery target 2–3 weeks before opening, (d) track delivery status per W1744 timeline
Responsible (R): Procurement
Accountable (A): VP Store Operations
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1740_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1740_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1740_Task9" name="Equipment received and installed: (a) contractor installs shelving and racking…">
        <bpmn:documentation>Step 3: Equipment received and installed: (a) contractor installs shelving and racking per layout, (b) POS vendor installs and configures terminals, (c) CCTV vendor installs cameras and connects to central monitoring, (d) paint mixing station installed and calibrated, (e) generator installed and tested, (f) all equipment registered as fixed assets per W1690
Responsible (R): Contractor / Vendors / Receiving Clerk
Accountable (A): Store Opening Coordinator
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1740_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1740_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1740_Task10" name="Punch list review: Store Opening Coordinator inspects all installations…">
        <bpmn:documentation>Step 4: Punch list review: Store Opening Coordinator inspects all installations; defects or incomplete items documented and escalated to contractor for resolution before opening
Responsible (R): Store Opening Coordinator
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1740_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1740_End11" name="Complete">
        <bpmn:incoming>W1740_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1740_Annotation12">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1740_Assoc13" sourceRef="W1740_Annotation12" targetRef="W1740_Start6" associationDirection="None" />
