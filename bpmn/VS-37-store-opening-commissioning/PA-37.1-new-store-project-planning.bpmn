        <bpmndi:BPMNEdge id="W1737_Flow15_di" bpmnElement="W1737_Flow15"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1737_Flow16_di" bpmnElement="W1737_Flow16"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="505" /></bpmndi:BPMNEdge>
