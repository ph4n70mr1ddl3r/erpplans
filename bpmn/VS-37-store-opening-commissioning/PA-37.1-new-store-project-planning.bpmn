        <bpmndi:BPMNShape id="W1738_Start5_di" bpmnElement="W1738_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_End10_di" bpmnElement="W1738_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Annotation11_di" bpmnElement="W1738_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1738_Flow13_di" bpmnElement="W1738_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1738_Flow14_di" bpmnElement="W1738_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1738_Flow15_di" bpmnElement="W1738_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1738_Flow16_di" bpmnElement="W1738_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1738_Flow17_di" bpmnElement="W1738_Flow17"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1738_Assoc12_di" bpmnElement="W1738_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1739" name="W1739. Initial Inventory Planning &amp; Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Store layout approved (W1738); target opening date confirmed
Frequency: ~10–15 inventory plans/year
Volume: ~35,000 active SKUs per store; initial stock value ~PHP 15–25M per store
Owner: VP Supply Chain
Participants: VP Supply Chain, Category Managers, Merchandise Planners, DC Operations, Store Opening Coordinator
Source: workflow W1739 — Initial Inventory Planning &amp; Allocation</bpmn:documentation>
      <bpmn:laneSet id="W1739_LaneSet5">
        <bpmn:lane id="W1739_Lane1" name="Merchandise Planners">
        <bpmn:flowNodeRef>W1739_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1739_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1739_Lane2" name="VP Supply Chain">
        <bpmn:flowNodeRef>W1739_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1739_Lane3" name="DC Operations">
        <bpmn:flowNodeRef>W1739_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1739_Lane4" name="Receiving Clerk">
        <bpmn:flowNodeRef>W1739_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1739_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1739_Start6" name="Store layout approved (W1738); target opening date confirmed">
        <bpmn:outgoing>W1739_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1739_Task7" name="Merchandise Planners develop initial stock plan per category: (a)…">
        <bpmn:documentation>Step 1: Merchandise Planners develop initial stock plan per category: (a) planogram-driven SKU assortment (35,000 active SKUs adjusted for store size), (b) initial quantity per SKU: (i) A-items: 3–4 weeks of projected sales, (ii) B-items: 2–3 weeks, (iii) C-items: 1–2 weeks, (c) projected sales by category based on comparable store performance in similar trade area, (d) new store ramp curve: 70% of mature sales in Month 1, 85% in Month 3, 95% in Month 6
Responsible (R): Merchandise Planners
Accountable (A): VP Supply Chain
Duration: 1 week/store</bpmn:documentation>
        <bpmn:incoming>W1739_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1739_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1739_Task8" name="VP Supply Chain assigns sourcing DC and schedules replenishment: (a) identify…">
        <bpmn:documentation>Step 2: VP Supply Chain assigns sourcing DC and schedules replenishment: (a) identify which DC serves the new store location, (b) initial stock pull from assigned DC — order placed 2 weeks before opening, (c) DSD vendors (cement, lumber, sand) scheduled for delivery 3–5 days before opening, (d) import-specific items: ensure stock allocated from existing DC inventory or special import order placed with sufficient lead time
Responsible (R): VP Supply Chain
Accountable (A): Category Managers
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1739_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1739_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1739_Task9" name="DC picks and stages initial stock order: (a) separate pick wave for new store…">
        <bpmn:documentation>Step 3: DC picks and stages initial stock order: (a) separate pick wave for new store initial stock, (b) labeled per store zone/section for efficient shelving, (c) loaded on trucks for delivery 3–5 days before opening, (d) DC coordinates delivery schedule with Store Opening Coordinator
Responsible (R): DC Operations
Accountable (A): VP Supply Chain
Duration: 3–5 days</bpmn:documentation>
        <bpmn:incoming>W1739_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1739_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1739_Task10" name="Initial stock received at new store: (a) Receiving Clerk and stock associates…">
        <bpmn:documentation>Step 4: Initial stock received at new store: (a) Receiving Clerk and stock associates shelve merchandise per planogram, (b) system verifies quantities received vs. initial stock plan, (c) variances flagged for immediate replenishment, (d) all inventory visible in ERP system at store opening
Responsible (R): Receiving Clerk / Stock Associates
Accountable (A): Store Manager
Duration: 3–5 days before opening</bpmn:documentation>
        <bpmn:incoming>W1739_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1739_End11" name="Complete">
        <bpmn:incoming>W1739_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1739_Annotation12">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Supply Chain</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1739_Assoc13" sourceRef="W1739_Annotation12" targetRef="W1739_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1739_Flow14" sourceRef="W1739_Start6" targetRef="W1739_Task7" />
      <bpmn:sequenceFlow id="W1739_Flow15" sourceRef="W1739_Task7" targetRef="W1739_Task8" />
      <bpmn:sequenceFlow id="W1739_Flow16" sourceRef="W1739_Task8" targetRef="W1739_Task9" />
      <bpmn:sequenceFlow id="W1739_Flow17" sourceRef="W1739_Task9" targetRef="W1739_Task10" />
      <bpmn:sequenceFlow id="W1739_Flow18" sourceRef="W1739_Task10" targetRef="W1739_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1739_diag">
      <bpmndi:BPMNPlane id="W1739_plane" bpmnElement="W_W1739">
        <bpmndi:BPMNShape id="W1739_Lane1_di" bpmnElement="W1739_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
