    <bpmn:process id="W_W1742" name="W1742. Permit &amp; License Acquisition for New Store" isExecutable="false">
      <bpmn:documentation>Trigger: Lease signed; construction nearing completion
Frequency: ~10–15 permit sets/year
Volume: ~8–12 permits/licenses per new store
Owner: Legal Counsel
Participants: Legal Counsel, COO, Store Opening Coordinator, Compliance Officer
Source: workflow W1742 — Permit &amp; License Acquisition for New Store</bpmn:documentation>
      <bpmn:laneSet id="W1742_LaneSet3">
        <bpmn:lane id="W1742_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W1742_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1742_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1742_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1742_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1742_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W1742_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1742_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1742_Start4" name="Lease signed; construction nearing completion">
        <bpmn:outgoing>W1742_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1742_Task5" name="Required permits and licenses for each new store (Philippine requirements): (a)…">
        <bpmn:documentation>Step 1: Required permits and licenses for each new store (Philippine requirements): (a) Barangay Clearance, (b) Mayor&#x27;s Permit / Business Permit (LGU), (c) BIR Certificate of Registration (BIR Form 1903), (d) BIR Authority to Print (ATP) for receipts, (e) BIR Point-of-Sale Registration (for POS system), (f) Fire Safety Inspection Certificate (BFP), (g) DENR Environmental Compliance Certificate (ECC) or CNC (if required for store size), (h) Locational Clearance (zoning), (i) Sanitary/Health Permit (if applicable), (j) Building Permit and Certificate of Occupancy (for new construction or major renovation)
Responsible (R): Legal Counsel / Compliance Officer
Accountable (A): VP Legal
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W1742_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1742_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1742_Task6" name="Legal Counsel coordinates with LGU and government agencies: (a) applications…">
        <bpmn:documentation>Step 2: Legal Counsel coordinates with LGU and government agencies: (a) applications submitted with required documents (SEC registration, lease contract, fire safety plan, environmental plan), (b) follow-up on processing timelines (LGU processing can take 2–6 weeks), (c) arrange inspections (fire, building, health), (d) pay permit fees
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 4–8 weeks</bpmn:documentation>
        <bpmn:incoming>W1742_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1742_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1742_Task7" name="BIR registration critical path: (a) register store as BIR taxpaying location…">
        <bpmn:documentation>Step 3: BIR registration critical path: (a) register store as BIR taxpaying location, (b) obtain authority to use POS system (CAS registration if not covered by group registration), (c) register books of accounts, (d) obtain ATP for sales invoices, (e) BIR POS inspection and sealing
Responsible (R): Tax Accountant / Legal Counsel
Accountable (A): CFO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1742_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1742_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1742_Task8" name="Permits received and filed; Store Manager trained on permit renewal…">
        <bpmn:documentation>Step 4: Permits received and filed; Store Manager trained on permit renewal requirements (annual Business Permit renewal in January per LGU schedule); copies maintained at store for government inspection
Responsible (R): Legal Counsel / Store Manager
Accountable (A): VP Legal
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1742_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1742_End9" name="Complete">
        <bpmn:incoming>W1742_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1742_Annotation10">
        <bpmn:text>Controls: - CTL-188 (prevent premature store go-live.) | - operational: — can take 2–4 weeks and requires physical BIR inspection
Owner: Legal Counsel</bpmn:text>
      </bpmn:textAnnotation>
