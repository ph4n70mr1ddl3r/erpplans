    <bpmn:process id="W_W1744" name="W1744. Pre-Opening Timeline &amp; Critical Path Management" isExecutable="false">
      <bpmn:documentation>Trigger: Project kickoff (W1737)
Frequency: ~10–15 timelines managed concurrently
Volume: 1 critical path per new store (~200+ tasks)
Owner: Store Opening Coordinator
Participants: Store Opening Coordinator, all functional leads, Steering Committee
Source: workflow W1744 — Pre-Opening Timeline &amp; Critical Path Management</bpmn:documentation>
      <bpmn:laneSet id="W1744_LaneSet4">
        <bpmn:lane id="W1744_Lane1" name="Store Opening Coordinator">
        <bpmn:flowNodeRef>W1744_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1744_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1744_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1744_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1744_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1744_Lane3" name="COO">
        <bpmn:flowNodeRef>W1744_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1744_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1744_Start5" name="Project kickoff (W1737)">
        <bpmn:outgoing>W1744_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1744_Task6" name="Store Opening Coordinator maintains critical path with key milestones: (a)…">
        <bpmn:documentation>Step 1: Store Opening Coordinator maintains critical path with key milestones: (a) Month 1: project kickoff, layout design, permits filed, IT ISP ordered, staff recruitment started, (b) Month 2: construction in progress, equipment POs placed, staff interviews, IT network setup begins, (c) Month 3: construction complete, equipment delivered and installed, permits received, staff hired, training begins, (d) Month 4 (opening month): systems tested, inventory received and shelved, soft opening (1 week before), grand opening, (e) each milestone has buffer (1–2 weeks) for delays
Responsible (R): Store Opening Coordinator
Accountable (A): VP Store Operations
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1744_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1744_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1744_Task7" name="Weekly status meetings (30 min): (a) each functional lead reports task status…">
        <bpmn:documentation>Step 2: Weekly status meetings (30 min): (a) each functional lead reports task status (green/yellow/red), (b) dependencies reviewed and conflicts resolved, (c) risk register updated, (d) decisions needed escalated to steering committee
Responsible (R): Store Opening Coordinator
Accountable (A): VP Store Operations
Duration: 30 min/week</bpmn:documentation>
        <bpmn:incoming>W1744_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1744_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1744_Task8" name="Bi-weekly steering committee: (a) overall status (on track / at risk /…">
        <bpmn:documentation>Step 3: Bi-weekly steering committee: (a) overall status (on track / at risk / delayed), (b) budget vs. actual, (c) critical path status — any milestone slippage, (d) decisions requiring steering committee approval, (e) corrective actions for delayed items
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 hour/bi-weekly</bpmn:documentation>
        <bpmn:incoming>W1744_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1744_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1744_Task9" name="Go/No-Go decision (1 week before opening): (a) all permits received, (b)…">
        <bpmn:documentation>Step 4: Go/No-Go decision (1 week before opening): (a) all permits received, (b) systems tested and operational, (c) staff trained, (d) inventory shelved and system counted, (e) safety inspection passed, (f) COO gives final approval to proceed with opening or delays if critical items incomplete
Responsible (R): COO
Accountable (A): CEO
Duration: 1 hour</bpmn:documentation>
        <bpmn:incoming>W1744_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1744_End10" name="Complete">
        <bpmn:incoming>W1744_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1744_Annotation11">
        <bpmn:text>Controls: - CTL-352 (ensure controlled execution — New Store Project Planning &amp; Coordination (PA-37.1).) | - operational: Store Opening Coordinator review and approval gate
Owner: Store Opening Coordinator</bpmn:text>
      </bpmn:textAnnotation>
