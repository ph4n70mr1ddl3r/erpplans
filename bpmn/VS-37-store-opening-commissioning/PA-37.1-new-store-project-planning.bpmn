    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1738_diag">
      <bpmndi:BPMNPlane id="W1738_plane" bpmnElement="W_W1738">
        <bpmndi:BPMNShape id="W1738_Lane1_di" bpmnElement="W1738_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Lane2_di" bpmnElement="W1738_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Lane3_di" bpmnElement="W1738_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Task6_di" bpmnElement="W1738_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Task7_di" bpmnElement="W1738_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1738_Task8_di" bpmnElement="W1738_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
