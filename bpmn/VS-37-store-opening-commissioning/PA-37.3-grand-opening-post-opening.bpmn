<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-37.3-grand-opening-post-opening" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1755" name="W1755. Grand Opening Event Planning &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Go/no-go decision confirmed (W1744); 2 weeks before opening
Frequency: ~10–15 events/year
Volume: 1 event per new store
Owner: CMO
Participants: CMO, Marketing Team, Store Manager, VP Store Operations, LGU Officials, Media
Source: workflow W1755 — Grand Opening Event Planning &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W1755_LaneSet4">
        <bpmn:lane id="W1755_Lane1" name="Marketing Team">
        <bpmn:flowNodeRef>W1755_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1755_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1755_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1755_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1755_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1755_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1755_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1755_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1755_Start5" name="Go/no-go decision confirmed (W1744); 2 weeks before opening">
        <bpmn:outgoing>W1755_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1755_Task6" name="Marketing develops grand opening plan: (a) event date selection (preferably…">
        <bpmn:documentation>Step 1: Marketing develops grand opening plan: (a) event date selection (preferably Saturday for maximum foot traffic; avoid rainy season dates if possible), (b) promotional offers: doorbuster deals (10–20 items at deep discount), gift-with-purchase, raffle prizes, (c) local marketing: barangay flyers, local radio, Facebook ads targeted within 10 km radius, (d) VIP preview: invite local government officials (barangay captain, mayor), contractors, trade account customers, (e) media coverage: invite local press/social media influencers, (f) store decoration: balloons, banners, promotional signage, (g) entertainment: local band, kids&#x27; activities, product demos
Responsible (R): Marketing Team
Accountable (A): CMO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1755_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1755_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1755_Task7" name="Budget: (a) grand opening budget ~PHP 200–500K per store (from marketing…">
        <bpmn:documentation>Step 2: Budget: (a) grand opening budget ~PHP 200–500K per store (from marketing budget, partially funded by vendor co-op per VS-39), (b) promotional discount costs (markdown budget from merchandising), (c) venue setup (tent, sound system, decorations)
Responsible (R): FP&amp;A / CMO
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1755_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1755_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1755_Task8" name="Coordination with Store Manager: (a) staffing plan for opening day (all 29…">
        <bpmn:documentation>Step 3: Coordination with Store Manager: (a) staffing plan for opening day (all 29 staff on duty, split into morning and evening shifts), (b) crowd management plan for high-traffic periods, (c) security coordination (additional security for opening day crowd), (d) emergency plan (medical standby for large crowd events)
Responsible (R): Store Manager / Marketing Team
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1755_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1755_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1755_Task9" name="Grand opening day execution: (a) store opens at announced time (typically 8…">
        <bpmn:documentation>Step 4: Grand opening day execution: (a) store opens at announced time (typically 8 AM), (b) VIP ribbon-cutting ceremony, (c) promotional offers activated in POS system, (d) marketing team manages event logistics, (e) Store Manager focuses on store operations and customer service
Responsible (R): Marketing Team / Store Manager
Accountable (A): CMO / VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1755_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1755_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1755_End10" name="Complete">
        <bpmn:incoming>W1755_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1755_Annotation11">
        <bpmn:text>Controls: - CTL-354 (ensure controlled execution — Grand Opening Execution &amp; Post-Opening Stabilization (PA-37.3).) | - operational: CMO review and approval gate
Owner: CMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1755_Assoc12" sourceRef="W1755_Annotation11" targetRef="W1755_Start5" associationDirection="None" />
