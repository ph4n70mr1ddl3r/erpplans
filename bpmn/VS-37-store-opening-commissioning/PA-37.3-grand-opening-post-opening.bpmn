    <bpmn:process id="W_W1756" name="W1756. Grand Opening Day Operations Management" isExecutable="false">
      <bpmn:documentation>Trigger: Grand opening day
Frequency: ~10–15 opening days/year
Volume: 1 opening day per store
Owner: Store Manager
Participants: Store Manager, all 29 staff, Regional Manager, VP Store Operations, IT Support
Source: workflow W1756 — Grand Opening Day Operations Management</bpmn:documentation>
      <bpmn:laneSet id="W1756_LaneSet3">
        <bpmn:lane id="W1756_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1756_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1756_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1756_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1756_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1756_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W1756_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1756_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1756_Start4" name="Grand opening day">
        <bpmn:outgoing>W1756_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1756_Task5" name="Pre-opening (6 AM): (a) Store Manager opens store, (b) all staff arrive and…">
        <bpmn:documentation>Step 1: Pre-opening (6 AM): (a) Store Manager opens store, (b) all staff arrive and prepare: stock replenishment, display checks, cash float in registers, (c) final systems check: POS, network, CCTV all operational, (d) staff briefing: expected traffic, promotional items, role assignments, safety reminders, (e) last-minute merchandising touches, (f) security team positioned
Responsible (R): Store Manager
Accountable (A): —
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1756_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1756_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1756_Task6" name="Opening day operations: (a) Store Manager monitors floor for customer service…">
        <bpmn:documentation>Step 2: Opening day operations: (a) Store Manager monitors floor for customer service issues, (b) Assistant Manager monitors checkout queues (add backup cashier if lines &gt; 5 customers), (c) Department Supervisors support sales associates and handle customer escalations, (d) Receiving Clerks handle any deliveries (DSD vendors may deliver opening day stock), (e) Stock Associates continuously replenish fast-selling promotional items, (f) IT on standby (on-site or remote) for system issues
Responsible (R): Store Manager / all staff
Accountable (A): Regional Manager
Duration: Full day</bpmn:documentation>
        <bpmn:incoming>W1756_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1756_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1756_Task7" name="Real-time monitoring by Regional Manager and VP Store Operations: (a) POS…">
        <bpmn:documentation>Step 3: Real-time monitoring by Regional Manager and VP Store Operations: (a) POS transaction count and revenue (viewed in real-time dashboard), (b) stockout alerts for promotional items, (c) system health monitoring, (d) customer complaints or safety incidents
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: Full day</bpmn:documentation>
        <bpmn:incoming>W1756_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1756_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1756_Task8" name="End-of-day: (a) extended hours if traffic warrants (standard hours: 8 AM–8 PM…">
        <bpmn:documentation>Step 4: End-of-day: (a) extended hours if traffic warrants (standard hours: 8 AM–8 PM; may extend to 10 PM), (b) end-of-day close: Z-report, cash count, reconciliation, (c) Store Manager sends opening day summary to Regional Manager: revenue, transactions, stockouts, issues, incidents, (d) cash deposit prepared and secured per W1754
Responsible (R): Store Manager / Cashier
Accountable (A): Regional Manager
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1756_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1756_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1756_End9" name="Complete">
        <bpmn:incoming>W1756_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1756_Annotation10">
        <bpmn:text>Controls: - CTL-354 (ensure controlled execution — Grand Opening Execution &amp; Post-Opening Stabilization (PA-37.3).) | - operational: periodic reconciliation against source documents
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1756_Assoc11" sourceRef="W1756_Annotation10" targetRef="W1756_Start4" associationDirection="None" />
