      <bpmndi:BPMNPlane id="W1759_plane" bpmnElement="W_W1759">
        <bpmndi:BPMNShape id="W1759_Lane1_di" bpmnElement="W1759_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Lane2_di" bpmnElement="W1759_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Lane3_di" bpmnElement="W1759_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Task6_di" bpmnElement="W1759_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Task7_di" bpmnElement="W1759_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Task8_di" bpmnElement="W1759_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Task9_di" bpmnElement="W1759_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Start5_di" bpmnElement="W1759_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_End10_di" bpmnElement="W1759_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1759_Annotation11_di" bpmnElement="W1759_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1759_Flow13_di" bpmnElement="W1759_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1759_Flow14_di" bpmnElement="W1759_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1759_Flow15_di" bpmnElement="W1759_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1759_Flow16_di" bpmnElement="W1759_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1759_Flow17_di" bpmnElement="W1759_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1759_Assoc12_di" bpmnElement="W1759_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1760" name="W1760. Store Handover from Project to Operations" isExecutable="false">
      <bpmn:documentation>Trigger: 30-day review completed (W1759); store deemed stable
Frequency: ~10–15 handovers/year
Volume: 1 handover per new store
Owner: Store Opening Coordinator
Participants: Store Opening Coordinator, Store Manager, VP Store Operations, all functional leads
Source: workflow W1760 — Store Handover from Project to Operations</bpmn:documentation>
      <bpmn:laneSet id="W1760_LaneSet3">
        <bpmn:lane id="W1760_Lane1" name="Store Opening Coordinator">
        <bpmn:flowNodeRef>W1760_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1760_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1760_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1760_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1760_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1760_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1760_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1760_Start4" name="30-day review completed (W1759); store deemed stable">
        <bpmn:outgoing>W1760_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1760_Task5" name="Store Opening Coordinator prepares handover checklist: (a) construction: all…">
        <bpmn:documentation>Step 1: Store Opening Coordinator prepares handover checklist: (a) construction: all work complete, punch list cleared, warranties transferred, (b) permits: all required permits received and filed, (c) equipment: all fixtures and equipment installed and operational, registered as fixed assets per W1690, (d) IT: all systems live and stable, user accounts active, support process transferred to standard IT helpdesk, (e) HR: all staff hired, onboarded, and in payroll system, (f) inventory: fully stocked and on auto-replenishment, (g) financial: bank account active, cash management operational, GL posting verified, (h) marketing: grand opening complete, store included in standard marketing calendar
Responsible (R): Store Opening Coordinator
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1760_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1760_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1760_Task6" name="Handover meeting: Store Opening Coordinator walks through checklist with Store…">
        <bpmn:documentation>Step 2: Handover meeting: Store Opening Coordinator walks through checklist with Store Manager and Regional Manager; all items confirmed or outstanding items assigned to functional owners with deadlines
Responsible (R): Store Opening Coordinator / Store Manager
Accountable (A): VP Store Operations
Duration: 2 hours</bpmn:documentation>
        <bpmn:incoming>W1760_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1760_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1760_Task7" name="Project closure: (a) Store Opening Coordinator closes project in project…">
        <bpmn:documentation>Step 3: Project closure: (a) Store Opening Coordinator closes project in project management system, (b) FP&amp;A finalizes project cost per W1745, (c) project documents archived (construction drawings, permits, vendor contracts, equipment manuals), (d) Store Manager assumes full operational responsibility
Responsible (R): Store Opening Coordinator / FP&amp;A
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1760_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1760_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1760_Task8" name="VP Store Operations formally confirms store transition to standard operations…">
        <bpmn:documentation>Step 4: VP Store Operations formally confirms store transition to standard operations; Store Opening Coordinator released to next project
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1760_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1760_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1760_End9" name="Complete">
        <bpmn:incoming>W1760_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1760_Annotation10">
        <bpmn:text>Controls: - CTL-188 (prevent premature store go-live.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Opening Coordinator</bpmn:text>
      </bpmn:textAnnotation>
