        <bpmndi:BPMNShape id="W1756_Task7_di" bpmnElement="W1756_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1756_Task8_di" bpmnElement="W1756_Task8"><dc:Bounds x="1030" y="125" width="180" height="80" /></bpmndi:BPMNShape>
