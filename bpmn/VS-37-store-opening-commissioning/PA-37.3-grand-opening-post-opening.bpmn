    <bpmn:process id="W_W1761" name="W1761. Post-Opening Issue Resolution &amp; Punch List Closure" isExecutable="false">
      <bpmn:documentation>Trigger: Outstanding items from handover (W1760) or issues discovered post-opening
Frequency: ~50–100 punch list items across all new stores/year
Volume: ~5–10 items per store on average
Owner: Store Manager
Participants: Store Manager, COO, IT, Maintenance, contractors
Source: workflow W1761 — Post-Opening Issue Resolution &amp; Punch List Closure</bpmn:documentation>
      <bpmn:laneSet id="W1761_LaneSet4">
        <bpmn:lane id="W1761_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1761_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1761_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1761_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1761_Lane2" name="Store Opening Coordinator">
        <bpmn:flowNodeRef>W1761_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1761_Lane3" name="COO">
        <bpmn:flowNodeRef>W1761_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1761_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1761_Start5" name="Outstanding items from handover (W1760) or issues discovered post-opening">
        <bpmn:outgoing>W1761_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1761_Task6" name="Store Manager maintains punch list of outstanding construction, equipment, and…">
        <bpmn:documentation>Step 1: Store Manager maintains punch list of outstanding construction, equipment, and system issues: (a) construction defects (leaks, uneven flooring, door alignment), (b) equipment not functioning properly (POS glitch, HVAC noise, generator test failure), (c) missing items (signage not delivered, fixture missing), (d) system issues (incorrect pricing, missing SKUs, reporting errors)
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1761_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1761_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1761_Task7" name="Each item assigned to responsible party: (a) construction: COO coordinates with…">
        <bpmn:documentation>Step 2: Each item assigned to responsible party: (a) construction: COO coordinates with contractor (typically under warranty for 6–12 months), (b) equipment: vendor support or maintenance team, (c) IT: IT helpdesk ticket and resolution, (d) system: IT Applications team for configuration fixes
Responsible (R): Store Opening Coordinator / Store Manager
Accountable (A): Functional owners
Duration: As assigned</bpmn:documentation>
        <bpmn:incoming>W1761_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1761_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1761_Task8" name="Store Manager tracks resolution; escalates to Regional Manager if items not…">
        <bpmn:documentation>Step 3: Store Manager tracks resolution; escalates to Regional Manager if items not resolved within agreed timeframes; all items must be closed before contractor retention payment released (typically 10% of construction cost held for 6 months)
Responsible (R): Store Manager / Regional Manager
Accountable (A): VP Store Operations
Duration: 1–6 months</bpmn:documentation>
        <bpmn:incoming>W1761_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1761_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1761_Task9" name="Final punch list closure confirmed by COO and VP Store Operations; retention…">
        <bpmn:documentation>Step 4: Final punch list closure confirmed by COO and VP Store Operations; retention payment released to contractor
Responsible (R): COO / VP Store Operations
Accountable (A): CFO
Duration: 6 months post-opening</bpmn:documentation>
        <bpmn:incoming>W1761_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1761_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1761_End10" name="Complete">
        <bpmn:incoming>W1761_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1761_Annotation11">
        <bpmn:text>Controls: - CTL-354 (ensure controlled execution — Grand Opening Execution &amp; Post-Opening Stabilization (PA-37.3).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1761_Assoc12" sourceRef="W1761_Annotation11" targetRef="W1761_Start5" associationDirection="None" />
