      <bpmn:sequenceFlow id="W1758_Flow14" sourceRef="W1758_Task6" targetRef="W1758_Task7" />
      <bpmn:sequenceFlow id="W1758_Flow15" sourceRef="W1758_Task7" targetRef="W1758_Task8" />
      <bpmn:sequenceFlow id="W1758_Flow16" sourceRef="W1758_Task8" targetRef="W1758_End9" />
    </bpmn:process>
