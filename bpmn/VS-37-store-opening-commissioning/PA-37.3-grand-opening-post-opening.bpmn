    <bpmn:process id="W_W1759" name="W1759. First Month Performance Review &amp; Stabilization" isExecutable="false">
      <bpmn:documentation>Trigger: 30 days post-opening
Frequency: ~10–15 reviews/year
Volume: 1 review per new store
Owner: VP Store Operations
Participants: VP Store Operations, Regional Manager, Store Manager, CFO, CMO
Source: workflow W1759 — First Month Performance Review &amp; Stabilization</bpmn:documentation>
      <bpmn:laneSet id="W1759_LaneSet4">
        <bpmn:lane id="W1759_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1759_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1759_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1759_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1759_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1759_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1759_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1759_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1759_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1759_Start5" name="30 days post-opening">
        <bpmn:outgoing>W1759_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1759_Task6" name="FP&amp;A prepares 30-day store performance report: (a) revenue vs. plan (daily…">
        <bpmn:documentation>Step 1: FP&amp;A prepares 30-day store performance report: (a) revenue vs. plan (daily trend), (b) gross margin (actual vs. plan — adjusted for promotional markdowns), (c) controllable expenses vs. budget, (d) customer traffic and conversion, (e) top-selling categories and SKUs, (f) stockout rate and replenishment fill rate, (g) customer complaints and returns, (h) staff overtime and turnover, (i) cash management accuracy
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1759_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1759_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1759_Task7" name="VP Store Operations conducts store visit: (a) operational assessment: store…">
        <bpmn:documentation>Step 2: VP Store Operations conducts store visit: (a) operational assessment: store cleanliness, stock organization, planogram compliance, receiving efficiency, (b) staff performance review with Store Manager, (c) customer service observation, (d) safety inspection, (e) discuss issues and develop action plan
Responsible (R): VP Store Operations / Regional Manager
Accountable (A): COO
Duration: 1 day on-site</bpmn:documentation>
        <bpmn:incoming>W1759_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1759_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1759_Task8" name="Stabilization actions: (a) staffing adjustments (add or reduce based on actual…">
        <bpmn:documentation>Step 3: Stabilization actions: (a) staffing adjustments (add or reduce based on actual traffic patterns), (b) inventory parameter finalization, (c) schedule optimization (match staffing to peak hours), (d) any system configuration adjustments, (e) Store Manager coaching on specific improvement areas
Responsible (R): Store Manager / Regional Manager
Accountable (A): VP Store Operations
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1759_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1759_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1759_Task9" name="30-day report presented to steering committee; project formally moves from…">
        <bpmn:documentation>Step 4: 30-day report presented to steering committee; project formally moves from &quot;opening&quot; to &quot;operations&quot; per W1760
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 30 min</bpmn:documentation>
        <bpmn:incoming>W1759_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1759_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1759_End10" name="Complete">
        <bpmn:incoming>W1759_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1759_Annotation11">
        <bpmn:text>Controls: - CTL-354 (ensure controlled execution — Grand Opening Execution &amp; Post-Opening Stabilization (PA-37.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1759_Assoc12" sourceRef="W1759_Annotation11" targetRef="W1759_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1759_Flow13" sourceRef="W1759_Start5" targetRef="W1759_Task6" />
      <bpmn:sequenceFlow id="W1759_Flow14" sourceRef="W1759_Task6" targetRef="W1759_Task7" />
      <bpmn:sequenceFlow id="W1759_Flow15" sourceRef="W1759_Task7" targetRef="W1759_Task8" />
      <bpmn:sequenceFlow id="W1759_Flow16" sourceRef="W1759_Task8" targetRef="W1759_Task9" />
      <bpmn:sequenceFlow id="W1759_Flow17" sourceRef="W1759_Task9" targetRef="W1759_End10" />
    </bpmn:process>
