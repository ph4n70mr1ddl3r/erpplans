        <bpmndi:BPMNShape id="W1756_End9_di" bpmnElement="W1756_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1756_Annotation10_di" bpmnElement="W1756_Annotation10"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1756_Flow12_di" bpmnElement="W1756_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1756_Flow13_di" bpmnElement="W1756_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1756_Flow14_di" bpmnElement="W1756_Flow14"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1756_Flow15_di" bpmnElement="W1756_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1756_Flow16_di" bpmnElement="W1756_Flow16"><di:waypoint x="1210" y="165" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1756_Assoc11_di" bpmnElement="W1756_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1757" name="W1757. Opening Week Performance Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Day 2 of new store operations
Frequency: Daily for first 7 days; weekly for first month
Volume: 1 dashboard per new store
Owner: VP Store Operations
Participants: VP Store Operations, Regional Manager, Store Manager, FP&amp;A
Source: workflow W1757 — Opening Week Performance Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W1757_LaneSet4">
        <bpmn:lane id="W1757_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1757_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1757_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1757_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1757_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1757_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1757_Lane3" name="FP&amp;A">
        <bpmn:flowNodeRef>W1757_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1757_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1757_Start5" name="Day 2 of new store operations">
        <bpmn:outgoing>W1757_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1757_Task6" name="Daily metrics tracked for opening week: (a) revenue vs. target, (b) transaction…">
        <bpmn:documentation>Step 1: Daily metrics tracked for opening week: (a) revenue vs. target, (b) transaction count and ATV, (c) basket size (lines per transaction), (d) conversion rate (foot traffic estimate vs. transactions), (e) stockout rate (items ordered but not available), (f) customer complaints, (g) system uptime, (h) staff overtime hours
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: Daily review</bpmn:documentation>
        <bpmn:incoming>W1757_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1757_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1757_Task7" name="Daily standup call (15 min) between Store Manager and Regional Manager: (a)…">
        <bpmn:documentation>Step 2: Daily standup call (15 min) between Store Manager and Regional Manager: (a) yesterday&#x27;s performance, (b) today&#x27;s issues and support needed, (c) inventory replenishment status, (d) staffing adjustments if needed
Responsible (R): Store Manager / Regional Manager
Accountable (A): VP Store Operations
Duration: 15 min/day</bpmn:documentation>
        <bpmn:incoming>W1757_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1757_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1757_Task8" name="VP Store Operations reviews all new store dashboards weekly: (a) compare…">
        <bpmn:documentation>Step 3: VP Store Operations reviews all new store dashboards weekly: (a) compare opening week performance across stores opened in same period, (b) identify stores underperforming target (provide additional support — marketing boost, staff coaching, inventory rebalancing), (c) share best practices between stores
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 hour/week</bpmn:documentation>
        <bpmn:incoming>W1757_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1757_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1757_Task9" name="FP&amp;A prepares first week flash report for CFO: (a) revenue vs. plan, (b) gross…">
        <bpmn:documentation>Step 4: FP&amp;A prepares first week flash report for CFO: (a) revenue vs. plan, (b) gross margin (promotional markdown impact), (c) operating costs, (d) initial customer feedback summary
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1757_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1757_Flow17</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1757_End10" name="Complete">
        <bpmn:incoming>W1757_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1757_Annotation11">
        <bpmn:text>Controls: - CTL-354 (ensure controlled execution — Grand Opening Execution &amp; Post-Opening Stabilization (PA-37.3).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1757_Assoc12" sourceRef="W1757_Annotation11" targetRef="W1757_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1757_Flow13" sourceRef="W1757_Start5" targetRef="W1757_Task6" />
      <bpmn:sequenceFlow id="W1757_Flow14" sourceRef="W1757_Task6" targetRef="W1757_Task7" />
      <bpmn:sequenceFlow id="W1757_Flow15" sourceRef="W1757_Task7" targetRef="W1757_Task8" />
      <bpmn:sequenceFlow id="W1757_Flow16" sourceRef="W1757_Task8" targetRef="W1757_Task9" />
      <bpmn:sequenceFlow id="W1757_Flow17" sourceRef="W1757_Task9" targetRef="W1757_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1757_diag">
      <bpmndi:BPMNPlane id="W1757_plane" bpmnElement="W_W1757">
        <bpmndi:BPMNShape id="W1757_Lane1_di" bpmnElement="W1757_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1757_Lane2_di" bpmnElement="W1757_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1757_Lane3_di" bpmnElement="W1757_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1757_Task6_di" bpmnElement="W1757_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
