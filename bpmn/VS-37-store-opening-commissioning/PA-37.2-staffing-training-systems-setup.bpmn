    <bpmn:process id="W_W1749" name="W1749. POS &amp; Systems Training for New Store Staff" isExecutable="false">
      <bpmn:documentation>Trigger: Staff onboarded (W1748); 3 weeks before opening
Frequency: ~10–15 training sessions/year
Volume: 29 staff per store (role-specific training)
Owner: IT Training Lead
Participants: IT Training Lead, Store Manager, all store staff
Source: workflow W1749 — POS &amp; Systems Training for New Store Staff</bpmn:documentation>
      <bpmn:laneSet id="W1749_LaneSet2">
        <bpmn:lane id="W1749_Lane1" name="IT Training Lead">
        <bpmn:flowNodeRef>W1749_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1749_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1749_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1749_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1749_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1749_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1749_Start3" name="Staff onboarded (W1748); 3 weeks before opening">
        <bpmn:outgoing>W1749_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1749_Task4" name="Cashier training (3 Cashiers + 1 backup from Customer Service Rep): (a) POS…">
        <bpmn:documentation>Step 1: Cashier training (3 Cashiers + 1 backup from Customer Service Rep): (a) POS login and navigation, (b) barcode scanning (1D and 2D), (c) transaction types: cash, card, e-wallet, charge account, (d) multi-tender transactions (split payment), (e) returns and exchanges, (f) price override with manager authorization, (g) loyalty points earning and redemption, (h) weight-based items (nails, screws by kg), (i) cut-to-length items (lumber, pipes), (j) paint mixing custom SKU generation, (k) age-restricted product prompts, (l) end-of-day: Z-report, cash count, reconciliation, deposit, (m) offline POS operation
Responsible (R): IT Training Lead
Accountable (A): Store Manager
Duration: 3 days</bpmn:documentation>
        <bpmn:incoming>W1749_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1749_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1749_Task5" name="Receiving Clerk training (2 Clerks): (a) PO/ASN lookup on handheld tablet, (b)…">
        <bpmn:documentation>Step 2: Receiving Clerk training (2 Clerks): (a) PO/ASN lookup on handheld tablet, (b) goods receipt processing: scan, verify quantities, note discrepancies, (c) DSD receiving procedures, (d) return-to-vendor processing, (e) receiving exception handling (damaged goods, wrong items)
Responsible (R): IT Training Lead
Accountable (A): Store Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1749_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1749_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1749_Task6" name="Stock Associate training (4 Associates): (a) RF gun operation for cycle…">
        <bpmn:documentation>Step 3: Stock Associate training (4 Associates): (a) RF gun operation for cycle counting, (b) inventory lookup and stock inquiry, (c) replenishment from backroom, (d) BOPIS order picking and staging, (e) shelf label printing and price tag updates
Responsible (R): IT Training Lead
Accountable (A): Store Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1749_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1749_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1749_Task7" name="Store Manager and Assistant Manager training: (a) all above modules, plus: (b)…">
        <bpmn:documentation>Step 4: Store Manager and Assistant Manager training: (a) all above modules, plus: (b) store dashboard and KPI monitoring, (c) approval workflows (price overrides, expense approvals, overtime), (d) daily store reporting, (e) cash management and deposit verification, (f) incident reporting in system
Responsible (R): IT Training Lead
Accountable (A): Regional Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1749_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1749_End8" name="Complete">
        <bpmn:incoming>W1749_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1749_Annotation9">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: IT Training Lead review and approval gate; periodic reconciliation against source documents
Owner: IT Training Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1749_Assoc10" sourceRef="W1749_Annotation9" targetRef="W1749_Start3" associationDirection="None" />
