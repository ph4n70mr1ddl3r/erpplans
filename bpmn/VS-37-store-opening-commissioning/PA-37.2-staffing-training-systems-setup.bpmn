      <bpmn:sequenceFlow id="W1752_Flow16" sourceRef="W1752_Task8" targetRef="W1752_Task9" />
      <bpmn:sequenceFlow id="W1752_Flow17" sourceRef="W1752_Task9" targetRef="W1752_Task10" />
      <bpmn:sequenceFlow id="W1752_Flow18" sourceRef="W1752_Task10" targetRef="W1752_End11" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1752_diag">
      <bpmndi:BPMNPlane id="W1752_plane" bpmnElement="W_W1752">
        <bpmndi:BPMNShape id="W1752_Lane1_di" bpmnElement="W1752_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1752_Lane2_di" bpmnElement="W1752_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1752_Lane3_di" bpmnElement="W1752_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1752_Lane4_di" bpmnElement="W1752_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
