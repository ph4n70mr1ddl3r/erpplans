        <bpmndi:BPMNEdge id="W1752_Assoc13_di" bpmnElement="W1752_Assoc13"><di:waypoint x="340" y="800" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1753" name="W1753. Soft Opening Operations &amp; Dry Run" isExecutable="false">
      <bpmn:documentation>Trigger: Systems verified (W1752); 3–5 days before grand opening
Frequency: ~10–15 soft openings/year
Volume: 1 soft opening per new store
Owner: Store Manager
Participants: Store Manager, all store staff, Store Opening Coordinator, VP Store Operations
Source: workflow W1753 — Soft Opening Operations &amp; Dry Run</bpmn:documentation>
      <bpmn:laneSet id="W1753_LaneSet3">
        <bpmn:lane id="W1753_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1753_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1753_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1753_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1753_Lane2" name="Regional Manager">
        <bpmn:flowNodeRef>W1753_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1753_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1753_Start4" name="Systems verified (W1752); 3–5 days before grand opening">
        <bpmn:outgoing>W1753_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1753_Task5" name="Soft opening day 1 (invite-only): (a) open store to employees&#x27; families and…">
        <bpmn:documentation>Step 1: Soft opening day 1 (invite-only): (a) open store to employees&#x27; families and friends (limited to 200–300 customers), (b) purpose: test all systems and processes under real customer load, (c) Store Manager and supervisors observe and document issues, (d) IT on standby for system issues
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1753_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1753_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1753_Task6" name="Issue resolution between soft opening and grand opening: (a) system bugs…">
        <bpmn:documentation>Step 2: Issue resolution between soft opening and grand opening: (a) system bugs reported to IT for immediate fix, (b) process issues (queue management, signage confusion, checkout delays) addressed by Store Manager, (c) staff coaching for observed performance gaps, (d) inventory replenishment for items that sold out during soft opening
Responsible (R): Store Manager / IT / VP Store Operations
Accountable (A): —
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1753_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1753_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1753_Task7" name="Regional Manager conducts readiness review: (a) reviews soft opening…">
        <bpmn:documentation>Step 3: Regional Manager conducts readiness review: (a) reviews soft opening performance metrics, (b) assesses staff readiness, (c) confirms grand opening readiness, (d) provides final go/no-go recommendation to VP Store Operations per W1744
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1753_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1753_End8" name="Complete">
        <bpmn:incoming>W1753_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1753_Annotation9">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: Store Manager review and approval gate
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1753_Assoc10" sourceRef="W1753_Annotation9" targetRef="W1753_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1753_Flow11" sourceRef="W1753_Start4" targetRef="W1753_Task5" />
      <bpmn:sequenceFlow id="W1753_Flow12" sourceRef="W1753_Task5" targetRef="W1753_Task6" />
      <bpmn:sequenceFlow id="W1753_Flow13" sourceRef="W1753_Task6" targetRef="W1753_Task7" />
      <bpmn:sequenceFlow id="W1753_Flow14" sourceRef="W1753_Task7" targetRef="W1753_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1753_diag">
      <bpmndi:BPMNPlane id="W1753_plane" bpmnElement="W_W1753">
        <bpmndi:BPMNShape id="W1753_Lane1_di" bpmnElement="W1753_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1753_Lane2_di" bpmnElement="W1753_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
