    <bpmn:process id="W_W1747" name="W1747. Store Staff Recruitment &amp; Hiring" isExecutable="false">
      <bpmn:documentation>Trigger: Store Manager appointed (W1746); 2 months before opening
Frequency: ~10–15 hiring campaigns/year
Volume: 28 staff per new store (29 total minus Store Manager already appointed)
Owner: Store Manager
Participants: Store Manager, HR Recruitment, Regional Manager
Source: workflow W1747 — Store Staff Recruitment &amp; Hiring</bpmn:documentation>
      <bpmn:laneSet id="W1747_LaneSet3">
        <bpmn:lane id="W1747_Lane1" name="Store Manager">
        <bpmn:flowNodeRef>W1747_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1747_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1747_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1747_Lane2" name="HR Recruitment">
        <bpmn:flowNodeRef>W1747_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1747_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1747_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1747_Start4" name="Store Manager appointed (W1746); 2 months before opening">
        <bpmn:outgoing>W1747_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1747_Task5" name="Store Manager and HR Recruitment plan hiring for 28 positions: (a) 1 Assistant…">
        <bpmn:documentation>Step 1: Store Manager and HR Recruitment plan hiring for 28 positions: (a) 1 Assistant Store Manager, (b) 4 Department Supervisors (Lumber, Plumbing/Electrical, Tiles, Tools/Hardware), (c) 12 Sales Associates, (d) 3 Cashiers, (e) 2 Receiving Clerks, (f) 4 Stock Associates, (g) 1 Customer Service Rep, (h) 1 Maintenance/Utility
Responsible (R): Store Manager / HR Recruitment
Accountable (A): CHRO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1747_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1747_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1747_Task6" name="Recruitment channels: (a) internal postings (for supervisor promotions from…">
        <bpmn:documentation>Step 2: Recruitment channels: (a) internal postings (for supervisor promotions from existing stores), (b) local job postings (barangay bulletin boards, local Facebook groups, job boards), (c) walk-in applications at store site during construction, (d) referrals from existing store staff, (e) recruitment agency for specialized roles (paint mixing, tool experts)
Responsible (R): HR Recruitment
Accountable (A): Store Manager
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1747_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1747_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1747_Task7" name="Interview and selection: (a) Store Manager screens applications, (b) Regional…">
        <bpmn:documentation>Step 3: Interview and selection: (a) Store Manager screens applications, (b) Regional Manager interviews supervisor candidates, (c) practical assessments: cashier candidates test on POS simulator, sales associates assessed on product knowledge, (d) background checks and reference verification, (e) offers extended; target: all staff hired 4 weeks before opening
Responsible (R): Store Manager / Regional Manager
Accountable (A): VP Store Operations
Duration: 2–3 weeks</bpmn:documentation>
        <bpmn:incoming>W1747_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1747_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1747_Task8" name="Pre-employment requirements collected: (a) SSS, PhilHealth, Pag-IBIG numbers…">
        <bpmn:documentation>Step 4: Pre-employment requirements collected: (a) SSS, PhilHealth, Pag-IBIG numbers, (b) TIN (Tax Identification Number), (c) NBI clearance, (d) medical certificate, (e) barangay clearance, (f) diploma/transcripts, (g) emergency contact information
Responsible (R): HR Recruitment
Accountable (A): Store Manager
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1747_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1747_End9" name="Complete">
        <bpmn:incoming>W1747_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1747_Annotation10">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
