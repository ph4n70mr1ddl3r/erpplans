        <bpmndi:BPMNShape id="W1753_Annotation9_di" bpmnElement="W1753_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1753_Flow11_di" bpmnElement="W1753_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1753_Flow12_di" bpmnElement="W1753_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1753_Flow13_di" bpmnElement="W1753_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1753_Flow14_di" bpmnElement="W1753_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1753_Assoc10_di" bpmnElement="W1753_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1754" name="W1754. Store Cash Float &amp; Financial Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Systems verified (W1752); 1 week before opening
Frequency: ~10–15 setups/year
Volume: 1 financial setup per new store
Owner: Treasury
Participants: Treasury, Store Manager, Accounting Manager
Source: workflow W1754 — Store Cash Float &amp; Financial Setup</bpmn:documentation>
      <bpmn:laneSet id="W1754_LaneSet4">
        <bpmn:lane id="W1754_Lane1" name="Treasury">
        <bpmn:flowNodeRef>W1754_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1754_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1754_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1754_Lane2" name="Accounting Manager">
        <bpmn:flowNodeRef>W1754_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1754_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1754_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1754_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1754_Start5" name="Systems verified (W1752); 1 week before opening">
        <bpmn:outgoing>W1754_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1754_Task6" name="Treasury opens bank deposit account for new store: (a) bank chosen per company…">
        <bpmn:documentation>Step 1: Treasury opens bank deposit account for new store: (a) bank chosen per company banking relationship (BDO, BPI, Metrobank, or Chinabank — closest branch to store location), (b) corporate resolution per W1717 for account opening, (c) Store Manager and Assistant Manager listed as authorized signatories for deposits only (withdrawals require HQ approval)
Responsible (R): Treasury
Accountable (A): CFO
Duration: 1–2 weeks</bpmn:documentation>
        <bpmn:incoming>W1754_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1754_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1754_Task7" name="Petty cash float established: (a) PHP 20,000 petty cash fund per store policy…">
        <bpmn:documentation>Step 2: Petty cash float established: (a) PHP 20,000 petty cash fund per store policy per W1688, (b) cash float for 3 POS terminals: PHP 20,000 per terminal (PHP 60,000 total, per W764), (c) Store Manager receives and signs for cash floats; records in cash management system
Responsible (R): Treasury / Store Manager
Accountable (A): Accounting Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1754_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1754_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1754_Task8" name="GL setup: Accounting Manager verifies new store cost center and profit center…">
        <bpmn:documentation>Step 3: GL setup: Accounting Manager verifies new store cost center and profit center are active in GL chart of accounts; intercompany billing setup for lease payments to Property Management entity; payroll entity assignment confirmed (BuildRight Depot Inc. for store staff)
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1754_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1754_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1754_Task9" name="Daily cash deposit process established: (a) Store Manager prepares deposit…">
        <bpmn:documentation>Step 4: Daily cash deposit process established: (a) Store Manager prepares deposit after end-of-day close, (b) armored car or bank branch deposit per location arrangement, (c) deposit slip uploaded to treasury system, (d) treasury confirms deposit next business day
Responsible (R): Store Manager / Treasury
Accountable (A): Accounting Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1754_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1754_End10" name="Complete">
        <bpmn:incoming>W1754_Flow17</bpmn:incoming>
      </bpmn:endEvent>
