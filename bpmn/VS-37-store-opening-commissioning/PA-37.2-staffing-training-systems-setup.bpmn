      <bpmndi:BPMNPlane id="W1747_plane" bpmnElement="W_W1747">
        <bpmndi:BPMNShape id="W1747_Lane1_di" bpmnElement="W1747_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
