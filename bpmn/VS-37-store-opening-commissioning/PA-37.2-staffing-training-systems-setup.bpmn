    <bpmn:process id="W_W1750" name="W1750. Product Knowledge &amp; Category Training" isExecutable="false">
      <bpmn:documentation>Trigger: Staff systems-trained (W1749); 2 weeks before opening
Frequency: ~10–15 training sessions/year
Volume: 29 staff per store
Owner: Store Manager
Participants: Store Manager, Department Supervisors, Category Managers, Vendor Trainers, Regional Manager
Source: workflow W1750 — Product Knowledge &amp; Category Training</bpmn:documentation>
      <bpmn:laneSet id="W1750_LaneSet5">
        <bpmn:lane id="W1750_Lane1" name="Category Managers">
        <bpmn:flowNodeRef>W1750_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1750_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1750_Lane2" name="Department Supervisors">
        <bpmn:flowNodeRef>W1750_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1750_Lane3" name="Vendor Trainers">
        <bpmn:flowNodeRef>W1750_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1750_Lane4" name="Store Manager">
        <bpmn:flowNodeRef>W1750_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1750_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1750_Start6" name="Staff systems-trained (W1749); 2 weeks before opening">
        <bpmn:outgoing>W1750_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1750_Task7" name="Department Supervisors receive advanced product training from Category…">
        <bpmn:documentation>Step 1: Department Supervisors receive advanced product training from Category Managers: (a) product features and specifications per category, (b) common customer questions and how to answer, (c) upselling and cross-selling techniques, (d) product safety and handling requirements, (e) seasonal product knowledge
Responsible (R): Category Managers
Accountable (A): VP Merchandising
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1750_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1750_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1750_Task8" name="Sales Associates receive category-specific training assigned to their…">
        <bpmn:documentation>Step 2: Sales Associates receive category-specific training assigned to their department: (a) basic product knowledge for their assigned zone, (b) where to find product information in the system (specs, dimensions, availability), (c) how to direct customers to the right department, (d) basic project estimation concepts (for DIY customers asking &quot;how much do I need?&quot;)
Responsible (R): Department Supervisors
Accountable (A): Store Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1750_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1750_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1750_Task9" name="Vendor-led training for specialized categories: (a) paint mixing — paint vendor…">
        <bpmn:documentation>Step 3: Vendor-led training for specialized categories: (a) paint mixing — paint vendor trains designated staff on color matching, mixing ratios, equipment operation, (b) power tools — vendor demonstrates safe operation and customer demonstration techniques, (c) appliances — vendor trains on installation requirements, warranty terms, energy efficiency ratings, (d) tiles — vendor trains on tile selection guidance (size, material, application)
Responsible (R): Vendor Trainers
Accountable (A): Store Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1750_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1750_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1750_Task10" name="Store Manager assesses product knowledge readiness: (a) sample quiz per…">
        <bpmn:documentation>Step 4: Store Manager assesses product knowledge readiness: (a) sample quiz per department, (b) mystery shopper simulation (staff member acts as customer), (c) additional training for staff who do not pass assessment
Responsible (R): Store Manager
Accountable (A): Regional Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1750_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1750_End11" name="Complete">
        <bpmn:incoming>W1750_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1750_Annotation12">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1750_Assoc13" sourceRef="W1750_Annotation12" targetRef="W1750_Start6" associationDirection="None" />
