        <bpmndi:BPMNShape id="W1750_Start6_di" bpmnElement="W1750_Start6"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1750_End11_di" bpmnElement="W1750_End11"><dc:Bounds x="1260" y="657" width="36" height="36" /></bpmndi:BPMNShape>
