    <bpmn:process id="W_W1752" name="W1752. Store System Configuration &amp; Go-Live Verification" isExecutable="false">
      <bpmn:documentation>Trigger: IT infrastructure installed (W1741); 1 week before opening
Frequency: ~10–15 verifications/year
Volume: 1 system verification per new store
Owner: IT Infrastructure Manager
Participants: IT Infrastructure Manager, IT Applications, Store Manager, Store Opening Coordinator
Source: workflow W1752 — Store System Configuration &amp; Go-Live Verification</bpmn:documentation>
      <bpmn:laneSet id="W1752_LaneSet5">
        <bpmn:lane id="W1752_Lane1" name="IT Infrastructure Team">
        <bpmn:flowNodeRef>W1752_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1752_Start6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1752_Lane2" name="IT Applications">
        <bpmn:flowNodeRef>W1752_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1752_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1752_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1752_Lane4" name="IT Infrastructure Manager">
        <bpmn:flowNodeRef>W1752_Task10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1752_End11</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1752_Start6" name="IT infrastructure installed (W1741); 1 week before opening">
        <bpmn:outgoing>W1752_Flow14</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1752_Task7" name="System configuration verification: (a) store location active in ERP with…">
        <bpmn:documentation>Step 1: System configuration verification: (a) store location active in ERP with correct master data, (b) pricing zone and tax configuration verified, (c) POS terminals connected, logged in, and processing test transactions, (d) RF guns connected and scanning correctly, (e) CCTV recording and transmitting to central monitoring, (f) network connectivity tested (primary + backup), (g) offline POS capability tested (simulate outage for 30 min), (h) loyalty system integration tested (points earn and redeem), (i) ecommerce BOPIS integration tested (order received at store, pick confirmed)
Responsible (R): IT Infrastructure Team
Accountable (A): IT Infrastructure Manager
Duration: 2 days</bpmn:documentation>
        <bpmn:incoming>W1752_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1752_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1752_Task8" name="Data verification: (a) 35,000 SKU master loaded and pricing verified (sample…">
        <bpmn:documentation>Step 2: Data verification: (a) 35,000 SKU master loaded and pricing verified (sample 100 SKUs across categories), (b) store replenishment parameters active, (c) GL cost center and profit center posting correctly, (d) intercompany setup for BuildRight Depot Inc. entity
Responsible (R): IT Applications / Finance
Accountable (A): IT Infrastructure Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1752_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1752_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1752_Task9" name="User acceptance testing (UAT): (a) Store Manager processes full end-to-end…">
        <bpmn:documentation>Step 3: User acceptance testing (UAT): (a) Store Manager processes full end-to-end test: receive goods → shelve → sell at POS → tender → print receipt → end-of-day close → cash reconciliation → daily report, (b) all transaction types tested (cash, card, e-wallet, return, loyalty redemption, weight-based, cut-to-length), (c) any issues logged and resolved before opening
Responsible (R): Store Manager / IT
Accountable (A): IT Infrastructure Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1752_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1752_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1752_Task10" name="Go-live sign-off: IT Infrastructure Manager and Store Manager sign system…">
        <bpmn:documentation>Step 4: Go-live sign-off: IT Infrastructure Manager and Store Manager sign system readiness confirmation; Store Opening Coordinator updates critical path per W1744
Responsible (R): IT Infrastructure Manager / Store Manager
Accountable (A): CIO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1752_Flow17</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1752_End11" name="Complete">
        <bpmn:incoming>W1752_Flow18</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1752_Annotation12">
        <bpmn:text>Controls: - CTL-188 (prevent premature store go-live.) | - operational: periodic reconciliation against source documents
Owner: IT Infrastructure Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1752_Assoc13" sourceRef="W1752_Annotation12" targetRef="W1752_Start6" associationDirection="None" />
      <bpmn:sequenceFlow id="W1752_Flow14" sourceRef="W1752_Start6" targetRef="W1752_Task7" />
