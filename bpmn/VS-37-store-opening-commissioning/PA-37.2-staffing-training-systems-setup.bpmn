<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-37.2-staffing-training-systems-setup" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1746" name="W1746. Store Manager Selection &amp; Appointment" isExecutable="false">
      <bpmn:documentation>Trigger: New store project charter approved (W1737); Store Manager needed 3 months before opening
Frequency: ~10–15 selections/year
Volume: 1 Store Manager per new store
Owner: VP Store Operations
Participants: VP Store Operations, Regional Manager, CHRO, HR Recruitment
Source: workflow W1746 — Store Manager Selection &amp; Appointment</bpmn:documentation>
      <bpmn:laneSet id="W1746_LaneSet4">
        <bpmn:lane id="W1746_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1746_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1746_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1746_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1746_Lane2" name="CHRO">
        <bpmn:flowNodeRef>W1746_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1746_Lane3" name="Store Manager">
        <bpmn:flowNodeRef>W1746_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1746_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1746_Start5" name="New store project charter approved (W1737); Store Manager needed 3 months before opening">
        <bpmn:outgoing>W1746_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1746_Task6" name="VP Store Operations and Regional Manager identify Store Manager candidate: (a)…">
        <bpmn:documentation>Step 1: VP Store Operations and Regional Manager identify Store Manager candidate: (a) preferred: promote experienced Assistant Store Manager from existing store (internal), (b) alternative: experienced Department Supervisor ready for promotion, (c) external hire: only if no qualified internal candidates (hardware/DIY retail experience required)
Responsible (R): VP Store Operations / Regional Manager
Accountable (A): CHRO
Duration: 2–4 weeks</bpmn:documentation>
        <bpmn:incoming>W1746_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1746_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1746_Task7" name="Selection criteria: (a) minimum 2 years retail management experience…">
        <bpmn:documentation>Step 2: Selection criteria: (a) minimum 2 years retail management experience (preferably hardware/home improvement), (b) demonstrated P&amp;L awareness, (c) leadership and team management skills, (d) operational knowledge (receiving, inventory, POS, customer service), (e) willingness to relocate (if needed for new store location)
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1746_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1746_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1746_Task8" name="CHRO processes appointment: (a) offer letter with compensation package (Store…">
        <bpmn:documentation>Step 3: CHRO processes appointment: (a) offer letter with compensation package (Store Manager salary range per company structure), (b) transfer documentation (if internal), (c) appointment effective 3 months before store opening, (d) assigned to existing store for orientation during transition period
Responsible (R): CHRO
Accountable (A): VP Store Operations
Duration: 1 week</bpmn:documentation>
        <bpmn:incoming>W1746_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1746_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1746_Task9" name="New Store Manager assigned to project: (a) participates in all pre-opening…">
        <bpmn:documentation>Step 4: New Store Manager assigned to project: (a) participates in all pre-opening meetings per W1744, (b) begins learning store-specific details (location, trade area, layout, systems), (c) supports hiring of store team per W1747
Responsible (R): Store Manager
Accountable (A): VP Store Operations
Duration: 3 months pre-opening</bpmn:documentation>
        <bpmn:incoming>W1746_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1746_End10" name="Complete">
        <bpmn:incoming>W1746_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1746_Annotation11">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1746_Assoc12" sourceRef="W1746_Annotation11" targetRef="W1746_Start5" associationDirection="None" />
