        <bpmndi:BPMNShape id="W1750_Lane4_di" bpmnElement="W1750_Lane4" isHorizontal="true"><dc:Bounds x="160" y="590" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1750_Task7_di" bpmnElement="W1750_Task7"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1750_Task8_di" bpmnElement="W1750_Task8"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
