        <bpmndi:BPMNShape id="W1747_End9_di" bpmnElement="W1747_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1747_Annotation10_di" bpmnElement="W1747_Annotation10"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1747_Flow12_di" bpmnElement="W1747_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1747_Flow13_di" bpmnElement="W1747_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1747_Flow14_di" bpmnElement="W1747_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1747_Flow15_di" bpmnElement="W1747_Flow15"><di:waypoint x="1000" y="165" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1747_Flow16_di" bpmnElement="W1747_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1747_Assoc11_di" bpmnElement="W1747_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1748" name="W1748. New Store Staff Onboarding &amp; Orientation" isExecutable="false">
      <bpmn:documentation>Trigger: Staff hired (W1747); 3–4 weeks before opening
Frequency: ~10–15 onboardings/year
Volume: 28 new hires per store
Owner: Store Manager
Participants: Store Manager, HR, all new hires, Regional Manager
Source: workflow W1748 — New Store Staff Onboarding &amp; Orientation</bpmn:documentation>
      <bpmn:laneSet id="W1748_LaneSet4">
        <bpmn:lane id="W1748_Lane1" name="HR">
        <bpmn:flowNodeRef>W1748_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1748_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1748_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1748_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1748_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1748_Lane3" name="Regional Manager">
        <bpmn:flowNodeRef>W1748_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1748_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1748_Start5" name="Staff hired (W1747); 3–4 weeks before opening">
        <bpmn:outgoing>W1748_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1748_Task6" name="Day 1 — Company orientation (conducted by HR or Regional Manager): (a)…">
        <bpmn:documentation>Step 1: Day 1 — Company orientation (conducted by HR or Regional Manager): (a) BuildRight Depot company history, mission, values, (b) organizational structure and reporting lines, (c) employment terms and conditions, (d) compensation and benefits overview, (e) HR policies: attendance, leave, overtime, discipline, grievance, (f) code of conduct and ethics, (g) data privacy awareness
Responsible (R): HR / Regional Manager
Accountable (A): Store Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1748_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1748_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1748_Task7" name="Day 2 — Store-specific orientation: (a) store tour: layout, zones, receiving…">
        <bpmn:documentation>Step 2: Day 2 — Store-specific orientation: (a) store tour: layout, zones, receiving area, breakroom, emergency exits, (b) safety orientation: fire exits, extinguisher locations, emergency procedures, (c) introduction to all team members, (d) work schedule and shift assignments, (e) uniform and PPE issuance, (f) locker assignments
Responsible (R): Store Manager
Accountable (A): —
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1748_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1748_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1748_Task8" name="Days 3–5 — Systems training per W1749; Days 6–10 — product knowledge per W1750…">
        <bpmn:documentation>Step 3: Days 3–5 — Systems training per W1749; Days 6–10 — product knowledge per W1750; Days 11–14 — safety training per W1751
Responsible (R): Store Manager / Trainers
Accountable (A): VP Store Operations
Duration: 2 weeks</bpmn:documentation>
        <bpmn:incoming>W1748_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1748_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1748_Task9" name="Regional Manager conducts onboarding effectiveness check: (a) sample staff on…">
        <bpmn:documentation>Step 4: Regional Manager conducts onboarding effectiveness check: (a) sample staff on system proficiency, (b) quiz on key policies and safety procedures, (c) Store Manager provides assessment of each team member&#x27;s readiness
Responsible (R): Regional Manager
Accountable (A): VP Store Operations
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1748_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1748_End10" name="Complete">
        <bpmn:incoming>W1748_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1748_Annotation11">
        <bpmn:text>Controls: - CTL-353 (ensure controlled execution — Store Staffing, Training &amp; Systems Setup (PA-37.2).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1748_Assoc12" sourceRef="W1748_Annotation11" targetRef="W1748_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1748_Flow13" sourceRef="W1748_Start5" targetRef="W1748_Task6" />
      <bpmn:sequenceFlow id="W1748_Flow14" sourceRef="W1748_Task6" targetRef="W1748_Task7" />
      <bpmn:sequenceFlow id="W1748_Flow15" sourceRef="W1748_Task7" targetRef="W1748_Task8" />
      <bpmn:sequenceFlow id="W1748_Flow16" sourceRef="W1748_Task8" targetRef="W1748_Task9" />
      <bpmn:sequenceFlow id="W1748_Flow17" sourceRef="W1748_Task9" targetRef="W1748_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1748_diag">
      <bpmndi:BPMNPlane id="W1748_plane" bpmnElement="W_W1748">
        <bpmndi:BPMNShape id="W1748_Lane1_di" bpmnElement="W1748_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1748_Lane2_di" bpmnElement="W1748_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1748_Lane3_di" bpmnElement="W1748_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1748_Task6_di" bpmnElement="W1748_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1748_Task7_di" bpmnElement="W1748_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1748_Task8_di" bpmnElement="W1748_Task8"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
