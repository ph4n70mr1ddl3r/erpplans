    <bpmn:process id="W_W1751" name="W1751. Safety &amp; Compliance Training for New Store" isExecutable="false">
      <bpmn:documentation>Trigger: Staff onboarded (W1748); 2 weeks before opening
Frequency: ~10–15 training sessions/year
Volume: 29 staff per store
Owner: Safety Officer
Participants: Safety Officer, Store Manager, all store staff, Local Fire Department
Source: workflow W1751 — Safety &amp; Compliance Training for New Store</bpmn:documentation>
      <bpmn:laneSet id="W1751_LaneSet3">
        <bpmn:lane id="W1751_Lane1" name="Safety Officer">
        <bpmn:flowNodeRef>W1751_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1751_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1751_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1751_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1751_Lane2" name="Legal Counsel">
        <bpmn:flowNodeRef>W1751_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1751_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1751_Start4" name="Staff onboarded (W1748); 2 weeks before opening">
        <bpmn:outgoing>W1751_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1751_Task5" name="General safety orientation: (a) fire safety: extinguisher use (PASS technique)…">
        <bpmn:documentation>Step 1: General safety orientation: (a) fire safety: extinguisher use (PASS technique), evacuation routes and assembly points, (b) earthquake safety: drop-cover-hold, building evacuation, (c) typhoon preparedness: store securing procedures, emergency supplies, (d) first aid basics: wound care, burn treatment, CPR awareness, (e) PPE usage: when and how to use gloves, hard hats, safety glasses, masks
Responsible (R): Safety Officer
Accountable (A): Store Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1751_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1751_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1751_Task6" name="Category-specific safety: (a) paint and chemicals: SDS (Safety Data Sheet)…">
        <bpmn:documentation>Step 2: Category-specific safety: (a) paint and chemicals: SDS (Safety Data Sheet) reading, spill response, proper storage, ventilation requirements, (b) lumber yard: safe lifting techniques, forklift awareness, stacking safety, (c) power tools: demonstration safety, blade guard checks, electrical safety, (d) electrical section: no live wire handling by staff, customer referral to licensed electrician, (e) receiving dock: truck safety, forklift-pedestrian awareness, manual handling
Responsible (R): Safety Officer / Department Supervisors
Accountable (A): Store Manager
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1751_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1751_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1751_Task7" name="Compliance-specific training: (a) price tag display requirements (Consumer Act…">
        <bpmn:documentation>Step 3: Compliance-specific training: (a) price tag display requirements (Consumer Act RA 7394), (b) return policy and customer rights, (c) age-restricted product handling (solvents, cutting tools), (d) data privacy: customer information handling per RA 10173, (e) anti-money laundering awareness for large cash transactions (&gt; PHP 500K)
Responsible (R): Legal Counsel / Compliance Officer
Accountable (A): Store Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W1751_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1751_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1751_Task8" name="Fire drill conducted with local fire department; store emergency plan posted in…">
        <bpmn:documentation>Step 4: Fire drill conducted with local fire department; store emergency plan posted in breakroom and receiving area; safety committee formed (Store Manager + 2 staff volunteers)
Responsible (R): Safety Officer / Local Fire Dept
Accountable (A): Store Manager
Duration: 0.5 day</bpmn:documentation>
        <bpmn:incoming>W1751_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1751_End9" name="Complete">
        <bpmn:incoming>W1751_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1751_Annotation10">
        <bpmn:text>Controls: - CTL-188 (prevent premature store go-live.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Safety Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1751_Assoc11" sourceRef="W1751_Annotation10" targetRef="W1751_Start4" associationDirection="None" />
