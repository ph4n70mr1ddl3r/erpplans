    <bpmn:process id="W_W4738" name="W4738. Critical-Third-Party Resilience, Stress-Test &amp; Tabletop Exercise" isExecutable="false">
      <bpmn:documentation>Trigger: Annual resilience cycle; Critical third party; BCP exercise (VS-26)
Frequency: Annual + on significant change
Volume: ~40–60 Critical third parties and concentration points
Owner: TPRM Program Manager / BCP (VS-26)
Participants: BCP (VS-26), Supply (VS-02.3), IT/DR (VS-27.2), business owners, the third party, Cyber (VS-27.3)
Source: workflow W4738 — Critical-Third-Party Resilience, Stress-Test &amp; Tabletop Exercise</bpmn:documentation>
      <bpmn:laneSet id="W4738_LaneSet3">
        <bpmn:lane id="W4738_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4738_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4738_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4738_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4738_Lane2" name="BCP">
        <bpmn:flowNodeRef>W4738_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4738_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4738_Start4" name="Annual resilience cycle; Critical third party; BCP exercise (VS-26)">
        <bpmn:outgoing>W4738_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4738_Task5" name="For each Critical third party, conduct resilience stress-tests: scenario…">
        <bpmn:documentation>Step 1: For each Critical third party, conduct resilience stress-tests: scenario analysis (financial failure, cyber breach, operational outage, geopolitical, concentration shock) and assess BuildRight&#x27;s ability to continue operations within required RTO/RPO (W4733)
Responsible (R): TPRM Program Manager / BCP / Business Owners
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4738_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4738_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4738_Task6" name="Run tabletop exercises (joint with the third party where possible, and with BCP…">
        <bpmn:documentation>Step 2: Run tabletop exercises (joint with the third party where possible, and with BCP VS-26) simulating Critical third-party failure; test failover, alternates (W4737), communication, and customer/regulator notification
Responsible (R): BCP / TPRM Program Manager / Business Owners
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4738_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4738_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4738_Task7" name="Capture exercise findings; remediate resilience gaps (alternate source, safety…">
        <bpmn:documentation>Step 3: Capture exercise findings; remediate resilience gaps (alternate source, safety stock, contract RTO, BCP update VS-26); track to closure (W4741); report resilience posture to the board (W4728)
Responsible (R): TPRM Program Manager / BCP
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4738_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4738_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4738_End8" name="Complete">
        <bpmn:incoming>W4738_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4738_Annotation9">
        <bpmn:text>Controls: - CTL-715 (ensure controlled execution — Concentration, Resilience, Exit &amp; TPRM Governance/Analytics (PA-161.3).) | - CTL-715: Critical third parties stress-tested annually; findings remediated; resilience posture board-reported
Owner: TPRM Program Manager / BCP (VS-26)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4738_Assoc10" sourceRef="W4738_Annotation9" targetRef="W4738_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4738_Flow11" sourceRef="W4738_Start4" targetRef="W4738_Task5" />
      <bpmn:sequenceFlow id="W4738_Flow12" sourceRef="W4738_Task5" targetRef="W4738_Task6" />
      <bpmn:sequenceFlow id="W4738_Flow13" sourceRef="W4738_Task6" targetRef="W4738_Task7" />
      <bpmn:sequenceFlow id="W4738_Flow14" sourceRef="W4738_Task7" targetRef="W4738_End8" />
    </bpmn:process>
