      <bpmndi:BPMNPlane id="W4723_plane" bpmnElement="W_W4723">
        <bpmndi:BPMNShape id="W4723_Lane1_di" bpmnElement="W4723_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_Task4_di" bpmnElement="W4723_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_Task5_di" bpmnElement="W4723_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_Task6_di" bpmnElement="W4723_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_Start3_di" bpmnElement="W4723_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_End7_di" bpmnElement="W4723_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4723_Annotation8_di" bpmnElement="W4723_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4723_Flow10_di" bpmnElement="W4723_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4723_Flow11_di" bpmnElement="W4723_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4723_Flow12_di" bpmnElement="W4723_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4723_Flow13_di" bpmnElement="W4723_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4723_Assoc9_di" bpmnElement="W4723_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4724" name="W4724. Fourth-Party (Sub-Processor / Sub-Contractor) Risk Identification &amp; Mapping" isExecutable="false">
      <bpmn:documentation>Trigger: New third party with sub-contracting; annual mapping; data-processor flow
Frequency: Per third party + annual
Volume: ~150–300 mapped fourth parties (SaaS sub-processors, 3PL sub-carriers, BPO sub-vendors)
Owner: TPRM Program Manager
Participants: Privacy (VS-91), Cyber (VS-27.3), Procurement (VS-03), Legal (VS-100.3), third parties
Source: workflow W4724 — Fourth-Party (Sub-Processor / Sub-Contractor) Risk Identification &amp; Mapping</bpmn:documentation>
      <bpmn:laneSet id="W4724_LaneSet2">
        <bpmn:lane id="W4724_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4724_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4724_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4724_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4724_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4724_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4724_Start3" name="New third party with sub-contracting; annual mapping; data-processor flow">
        <bpmn:outgoing>W4724_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4724_Task4" name="Identify fourth parties (sub-processors, sub-contractors) for each…">
        <bpmn:documentation>Step 1: Identify fourth parties (sub-processors, sub-contractors) for each Critical/High third party — especially data-processing fourth parties (SaaS cloud/hosting sub-processors per VS-91) and logistics sub-carriers (VS-06/VS-56); require disclosure in contracts
Responsible (R): TPRM Program Manager / Privacy / Procurement
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Per third party + annual</bpmn:documentation>
        <bpmn:incoming>W4724_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4724_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4724_Task5" name="Map fourth-party exposure: which BuildRight data/processes touch which fourth…">
        <bpmn:documentation>Step 2: Map fourth-party exposure: which BuildRight data/processes touch which fourth party; assess concentration (a fourth party serving many BuildRight third parties = hidden concentration W4725) and flow-down obligations (privacy VS-91, security, ABC)
Responsible (R): TPRM Program Manager / Privacy / Cyber
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4724_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4724_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4724_Task6" name="Require flow-down of DD/controls/audit rights to fourth parties in contracts…">
        <bpmn:documentation>Step 3: Require flow-down of DD/controls/audit rights to fourth parties in contracts; monitor fourth-party changes (a third party adding a sub-processor per VS-91.2 W3052); manage unacceptable fourth-party exposure (W4739/W4740)
Responsible (R): TPRM Program Manager / Legal / Procurement
Accountable (A): TPRM Lead / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4724_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4724_End7" name="Complete">
        <bpmn:incoming>W4724_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4724_Annotation8">
        <bpmn:text>Controls: - CTL-167 (ensure third-party risk tiering &amp; oversight.) | - CTL-713: fourth parties disclosed and mapped; flow-down obligations in contracts; unacceptable exposure managed
Owner: TPRM Program Manager</bpmn:text>
      </bpmn:textAnnotation>
