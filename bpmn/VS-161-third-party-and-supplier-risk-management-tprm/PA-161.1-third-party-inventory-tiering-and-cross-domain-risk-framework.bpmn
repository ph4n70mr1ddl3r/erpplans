        <bpmndi:BPMNEdge id="W4721_Flow11_di" bpmnElement="W4721_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4721_Flow12_di" bpmnElement="W4721_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4721_Flow13_di" bpmnElement="W4721_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4721_Assoc9_di" bpmnElement="W4721_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4722" name="W4722. TPRM Framework, Risk Taxonomy &amp; Cross-Domain Risk Appetite" isExecutable="false">
      <bpmn:documentation>Trigger: TPRM setup; annual framework review; ERM refresh (VS-21.2)
Frequency: Annual + on change
Volume: 1 TPRM framework
Owner: TPRM Program Manager / Head of Internal Audit &amp; Risk
Participants: Head of Internal Audit &amp; Risk (VS-21.2), Compliance (VS-22), Cyber (VS-27.3), Privacy (VS-91), Legal (VS-100.3), Procurement (VS-03)
Source: workflow W4722 — TPRM Framework, Risk Taxonomy &amp; Cross-Domain Risk Appetite</bpmn:documentation>
      <bpmn:laneSet id="W4722_LaneSet2">
        <bpmn:lane id="W4722_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4722_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4722_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4722_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4722_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4722_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4722_Start3" name="TPRM setup; annual framework review; ERM refresh (VS-21.2)">
        <bpmn:outgoing>W4722_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4722_Task4" name="Define the TPRM framework and risk taxonomy: risk domains (financial…">
        <bpmn:documentation>Step 1: Define the TPRM framework and risk taxonomy: risk domains (financial, cyber/infosec, operational/resilience, regulatory/compliance, data-privacy, ESG/human-rights, geographic/geopolitical, concentration, fourth-party), inherent/residual scoring methodology, and risk-appetite per domain aligned to ERM (VS-21.2)
Responsible (R): TPRM Program Manager / Head of Internal Audit &amp; Risk
Accountable (A): Head of Internal Audit &amp; Risk / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4722_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4722_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4722_Task5" name="Map each risk domain to its domain-owner workflow (ABC VS-86.3, privacy…">
        <bpmn:documentation>Step 2: Map each risk domain to its domain-owner workflow (ABC VS-86.3, privacy VS-91.2, fraud VS-125.1, integrity VS-119.3, human-rights VS-131, supply VS-21.2, cyber VS-27.3, financial VS-105/VS-68); define how the TPRM backbone feeds and is fed by each
Responsible (R): TPRM Program Manager / Domain Owners
Accountable (A): Head of Internal Audit &amp; Risk
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4722_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4722_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4722_Task6" name="Obtain leadership endorsement (Head of Internal Audit &amp; Risk/CEO) and align to…">
        <bpmn:documentation>Step 3: Obtain leadership endorsement (Head of Internal Audit &amp; Risk/CEO) and align to international standards (ISO 31000, NIST CSF supply-chain, SOC 2); publish the framework and train business/procurement owners
Responsible (R): TPRM Program Manager / Head of Internal Audit &amp; Risk
Accountable (A): Head of Internal Audit &amp; Risk / CEO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4722_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4722_End7" name="Complete">
        <bpmn:incoming>W4722_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4722_Annotation8">
        <bpmn:text>Controls: - CTL-167 (ensure third-party risk tiering &amp; oversight.) | - CTL-713: cross-domain taxonomy ERM-aligned; domain-owners mapped; framework leadership-endorsed
Owner: TPRM Program Manager / Head of Internal Audit &amp; Risk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4722_Assoc9" sourceRef="W4722_Annotation8" targetRef="W4722_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4722_Flow10" sourceRef="W4722_Start3" targetRef="W4722_Task4" />
      <bpmn:sequenceFlow id="W4722_Flow11" sourceRef="W4722_Task4" targetRef="W4722_Task5" />
      <bpmn:sequenceFlow id="W4722_Flow12" sourceRef="W4722_Task5" targetRef="W4722_Task6" />
      <bpmn:sequenceFlow id="W4722_Flow13" sourceRef="W4722_Task6" targetRef="W4722_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4722_diag">
      <bpmndi:BPMNPlane id="W4722_plane" bpmnElement="W_W4722">
        <bpmndi:BPMNShape id="W4722_Lane1_di" bpmnElement="W4722_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_Task4_di" bpmnElement="W4722_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_Task5_di" bpmnElement="W4722_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_Task6_di" bpmnElement="W4722_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_Start3_di" bpmnElement="W4722_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_End7_di" bpmnElement="W4722_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4722_Annotation8_di" bpmnElement="W4722_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4722_Flow10_di" bpmnElement="W4722_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4722_Flow11_di" bpmnElement="W4722_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4722_Flow12_di" bpmnElement="W4722_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4722_Flow13_di" bpmnElement="W4722_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4722_Assoc9_di" bpmnElement="W4722_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4723" name="W4723. Third-Party Tiering &amp; Criticality Methodology (Inherent/Residual, All Domains)" isExecutable="false">
      <bpmn:documentation>Trigger: New third party; annual re-tier; material change
Frequency: Per third party + annual re-tier
Volume: ~all enterprise third parties (W4721)
Owner: TPRM Program Manager
Participants: Business/function owners, domain owners, Head of Internal Audit &amp; Risk (VS-21.2)
Source: workflow W4723 — Third-Party Tiering &amp; Criticality Methodology (Inherent/Residual, All Domains)</bpmn:documentation>
      <bpmn:laneSet id="W4723_LaneSet2">
        <bpmn:lane id="W4723_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4723_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4723_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4723_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4723_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4723_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4723_Start3" name="New third party; annual re-tier; material change">
        <bpmn:outgoing>W4723_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4723_Task4" name="Tier each third party by inherent risk across all domains (W4722)…">
        <bpmn:documentation>Step 1: Tier each third party by inherent risk across all domains (W4722): spend/materiality, criticality to operations (sole/single-source, revenue-impact), data-access (W4726), fourth-party exposure (W4724), and domain-specific exposure; assign Criticality Tier (Critical/High/Medium/Low) driving the DD depth (PA-161.2) and monitoring cadence
Responsible (R): TPRM Program Manager / Domain Owners
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Per third party</bpmn:documentation>
        <bpmn:incoming>W4723_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4723_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4723_Task5" name="Compute residual risk after controls/DD (PA-161.2); escalate high-residual…">
        <bpmn:documentation>Step 2: Compute residual risk after controls/DD (PA-161.2); escalate high-residual third parties; this extends enterprise-wide the supply-side tiering in VS-21.2 W1328 (which is scoped to merchandise-supply criticality)
Responsible (R): TPRM Program Manager / Head of Internal Audit &amp; Risk
Accountable (A): Head of Internal Audit &amp; Risk
Duration: Annual re-tier</bpmn:documentation>
        <bpmn:incoming>W4723_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4723_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4723_Task6" name="Maintain tiering transparency: document the scoring inputs and rationale…">
        <bpmn:documentation>Step 3: Maintain tiering transparency: document the scoring inputs and rationale; re-tier on material change (new data-access, acquisition, performance/financial deterioration); feed tiering to W1328 and each domain slice
Responsible (R): TPRM Program Manager
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4723_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4723_End7" name="Complete">
        <bpmn:incoming>W4723_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4723_Annotation8">
        <bpmn:text>Controls: - CTL-713 (ensure controlled execution — Third-Party Inventory, Tiering &amp; Cross-Domain Risk Framework (PA-161.1).) | - CTL-713: inherent/residual scoring documented; re-tier on material change + annual; extends W1328 enterprise-wide
Owner: TPRM Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4723_Assoc9" sourceRef="W4723_Annotation8" targetRef="W4723_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4723_Flow10" sourceRef="W4723_Start3" targetRef="W4723_Task4" />
      <bpmn:sequenceFlow id="W4723_Flow11" sourceRef="W4723_Task4" targetRef="W4723_Task5" />
      <bpmn:sequenceFlow id="W4723_Flow12" sourceRef="W4723_Task5" targetRef="W4723_Task6" />
      <bpmn:sequenceFlow id="W4723_Flow13" sourceRef="W4723_Task6" targetRef="W4723_End7" />
    </bpmn:process>
