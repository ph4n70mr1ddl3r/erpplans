<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-161.1-third-party-inventory-tiering-and-cross-domain-risk-framework" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4721" name="W4721. Enterprise Third-Party Inventory &amp; Relationship Register" isExecutable="false">
      <bpmn:documentation>Trigger: New third-party onboarding; periodic inventory reconcile; TPRM setup
Frequency: Continuous + quarterly reconcile
Volume: 1 enterprise register; ~800–1,000 merchandise vendors + ~hundreds of non-merchandise/SaaS/3PL/payment/BPO/CIT/professional third parties
Owner: TPRM Program Manager / Third-Party Risk Lead
Participants: Procurement (VS-03/VS-34), Vendor Mgmt (VS-03), IT (VS-27), Finance (VS-17), Compliance (VS-22), business owners
Source: workflow W4721 — Enterprise Third-Party Inventory &amp; Relationship Register</bpmn:documentation>
      <bpmn:laneSet id="W4721_LaneSet2">
        <bpmn:lane id="W4721_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4721_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4721_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4721_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4721_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4721_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4721_Start3" name="New third-party onboarding; periodic inventory reconcile; TPRM setup">
        <bpmn:outgoing>W4721_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4721_Task4" name="Maintain the enterprise third-party inventory &amp; relationship register: every…">
        <bpmn:documentation>Step 1: Maintain the enterprise third-party inventory &amp; relationship register: every external party with type (merchandise vendor, 3PL, SaaS/cloud, payment, BPO, CIT, security agency, sourcing agent, marketplace seller, professional/EPC), owning business/function, contract, spend, criticality tier (W4723), data-access posture (W4726), fourth-party exposure (W4724), and risk-domain scores
Responsible (R): TPRM Program Manager / Procurement / IT
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4721_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4721_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4721_Task5" name="Reconcile the register to procurement (VS-03/VS-34), AP (VS-15), IT/SaaS…">
        <bpmn:documentation>Step 2: Reconcile the register to procurement (VS-03/VS-34), AP (VS-15), IT/SaaS (VS-99), and contracts (VS-100.3) quarterly; flag third parties transacting without a register entry (&quot;shadow third parties&quot;)
Responsible (R): TPRM Program Manager / Procurement / Finance
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4721_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4721_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4721_Task6" name="Govern the register as the single source feeding each risk-domain slice (ABC…">
        <bpmn:documentation>Step 3: Govern the register as the single source feeding each risk-domain slice (ABC VS-86.3, privacy VS-91.2, fraud VS-125.1, integrity VS-119.3, supply VS-21.2 W1328, audit VS-21.1 W334)
Responsible (R): TPRM Program Manager
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4721_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4721_End7" name="Complete">
        <bpmn:incoming>W4721_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4721_Annotation8">
        <bpmn:text>Controls: - CTL-713 (ensure controlled execution — Third-Party Inventory, Tiering &amp; Cross-Domain Risk Framework (PA-161.1).) | - CTL-713: single enterprise register; reconciled quarterly to AP/procurement/IT; feeds all risk-domain slices
Owner: TPRM Program Manager / Third-Party Risk Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4721_Assoc9" sourceRef="W4721_Annotation8" targetRef="W4721_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4721_Flow10" sourceRef="W4721_Start3" targetRef="W4721_Task4" />
      <bpmn:sequenceFlow id="W4721_Flow11" sourceRef="W4721_Task4" targetRef="W4721_Task5" />
      <bpmn:sequenceFlow id="W4721_Flow12" sourceRef="W4721_Task5" targetRef="W4721_Task6" />
      <bpmn:sequenceFlow id="W4721_Flow13" sourceRef="W4721_Task6" targetRef="W4721_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4721_diag">
      <bpmndi:BPMNPlane id="W4721_plane" bpmnElement="W_W4721">
        <bpmndi:BPMNShape id="W4721_Lane1_di" bpmnElement="W4721_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_Task4_di" bpmnElement="W4721_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_Task5_di" bpmnElement="W4721_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_Task6_di" bpmnElement="W4721_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_Start3_di" bpmnElement="W4721_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_End7_di" bpmnElement="W4721_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4721_Annotation8_di" bpmnElement="W4721_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
