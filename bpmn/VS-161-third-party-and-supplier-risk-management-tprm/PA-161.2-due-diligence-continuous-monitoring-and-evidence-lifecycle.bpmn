        <bpmndi:BPMNEdge id="W4730_Assoc9_di" bpmnElement="W4730_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4731" name="W4731. Data-Privacy &amp; Processor Due Diligence (DPA, Transfer Mechanism)" isExecutable="false">
      <bpmn:documentation>Trigger: New data-handling third party; privacy review (VS-91); sub-processor change
Frequency: Per third party + on change
Volume: ~80–150 data-handling third parties (SaaS, BPO, payment, marketplace, CDP/fraud)
Owner: TPRM Program Manager (joint with Privacy/DPO VS-91)
Participants: Privacy/DPO (VS-91.2 W3052), Legal (VS-100.3), Cyber (VS-27.3), the third party
Source: workflow W4731 — Data-Privacy &amp; Processor Due Diligence (DPA, Transfer Mechanism)</bpmn:documentation>
      <bpmn:laneSet id="W4731_LaneSet2">
        <bpmn:lane id="W4731_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4731_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4731_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4731_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4731_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4731_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4731_Start3" name="New data-handling third party; privacy review (VS-91); sub-processor change">
        <bpmn:outgoing>W4731_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4731_Task4" name="For each data-handling third party, conduct privacy &amp; processor DD: Data…">
        <bpmn:documentation>Step 1: For each data-handling third party, conduct privacy &amp; processor DD: Data Processing Agreement (DPA), purpose limitation, sub-processor disclosure (W4724), cross-border transfer mechanism (vs. Philippine DPA RA 10173 and destination law), data-subject-rights support, breach-notification obligations — extends VS-91.2 W3052 enterprise-wide
Responsible (R): TPRM Program Manager / DPO / Legal
Accountable (A): TPRM Lead / DPO
Duration: Per third party</bpmn:documentation>
        <bpmn:incoming>W4731_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4731_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4731_Task5" name="Coordinate Privacy Impact Assessment (VS-91.2 DPIA) for high-risk data…">
        <bpmn:documentation>Step 2: Coordinate Privacy Impact Assessment (VS-91.2 DPIA) for high-risk data processing; ensure the DPA covers BuildRight&#x27;s obligations (VS-91) and the processor&#x27;s; manage cross-border transfers
Responsible (R): TPRM Program Manager / DPO / Legal
Accountable (A): TPRM Lead / DPO / VP Legal
Duration: Per third party</bpmn:documentation>
        <bpmn:incoming>W4731_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4731_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4731_Task6" name="Monitor sub-processor changes (a processor adding a fourth party per VS-91.2…">
        <bpmn:documentation>Step 3: Monitor sub-processor changes (a processor adding a fourth party per VS-91.2 W3052 requires notice/objection); manage privacy incidents (W4736) and data-return/deletion on exit (W4740)
Responsible (R): TPRM Program Manager / DPO
Accountable (A): TPRM Lead / DPO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4731_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4731_End7" name="Complete">
        <bpmn:incoming>W4731_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4731_Annotation8">
        <bpmn:text>Controls: - CTL-714 (ensure controlled execution — Due Diligence, Continuous Monitoring &amp; Evidence Lifecycle (PA-161.2).) | - CTL-714: DPA in place before data handling; transfer mechanism valid; sub-processor changes managed; extends W3052
Owner: TPRM Program Manager (joint with Privacy/DPO VS-91)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4731_Assoc9" sourceRef="W4731_Annotation8" targetRef="W4731_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4731_Flow10" sourceRef="W4731_Start3" targetRef="W4731_Task4" />
      <bpmn:sequenceFlow id="W4731_Flow11" sourceRef="W4731_Task4" targetRef="W4731_Task5" />
      <bpmn:sequenceFlow id="W4731_Flow12" sourceRef="W4731_Task5" targetRef="W4731_Task6" />
      <bpmn:sequenceFlow id="W4731_Flow13" sourceRef="W4731_Task6" targetRef="W4731_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4731_diag">
      <bpmndi:BPMNPlane id="W4731_plane" bpmnElement="W_W4731">
        <bpmndi:BPMNShape id="W4731_Lane1_di" bpmnElement="W4731_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_Task4_di" bpmnElement="W4731_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_Task5_di" bpmnElement="W4731_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_Task6_di" bpmnElement="W4731_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_Start3_di" bpmnElement="W4731_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_End7_di" bpmnElement="W4731_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4731_Annotation8_di" bpmnElement="W4731_Annotation8"><dc:Bounds x="160" y="290" width="360" height="86" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4731_Flow10_di" bpmnElement="W4731_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4731_Flow11_di" bpmnElement="W4731_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4731_Flow12_di" bpmnElement="W4731_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4731_Flow13_di" bpmnElement="W4731_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4731_Assoc9_di" bpmnElement="W4731_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4732" name="W4732. ABC, Sanctions &amp; Beneficial-Ownership Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: New third party; ABC risk (VS-86); sanctions watch-list refresh
Frequency: Per third party + continuous screening
Volume: ~ all third parties (sanctions); ~ higher-risk for ABC (intermediaries, government-facing)
Owner: TPRM Program Manager (joint with ABC/AML VS-86)
Participants: ABC/AML (VS-86.3 W2942), Legal (VS-100.3), Compliance (VS-22), screening provider
Source: workflow W4732 — ABC, Sanctions &amp; Beneficial-Ownership Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W4732_LaneSet2">
        <bpmn:lane id="W4732_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4732_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4732_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4732_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4732_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4732_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4732_Start3" name="New third party; ABC risk (VS-86); sanctions watch-list refresh">
        <bpmn:outgoing>W4732_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4732_Task4" name="For each third party, conduct ABC/sanctions/beneficial-ownership DD…">
        <bpmn:documentation>Step 1: For each third party, conduct ABC/sanctions/beneficial-ownership DD: sanctions/PEP/adverse-media screening (continuous), beneficial-ownership identification, and ABC DD scaled to risk (intermediaries, government-facing VS-46/VS-104) — extends VS-86.3 W2942 enterprise-wide
Responsible (R): TPRM Program Manager / ABC / Screening
Accountable (A): TPRM Lead / VP Legal
Duration: Per third party + continuous</bpmn:documentation>
        <bpmn:incoming>W4732_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4732_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4732_Task5" name="Apply enhanced DD for high-risk third parties (government-facing, high-risk…">
        <bpmn:documentation>Step 2: Apply enhanced DD for high-risk third parties (government-facing, high-risk geographies, complex ownership); require anti-bribery certifications and flow-downs in contracts
