        <bpmndi:BPMNEdge id="W4729_Flow11_di" bpmnElement="W4729_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4729_Flow12_di" bpmnElement="W4729_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4729_Flow13_di" bpmnElement="W4729_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4729_Assoc9_di" bpmnElement="W4729_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4730" name="W4730. Cybersecurity &amp; IT-Controls Attestation (SOC 2 / ISO 27001 / PCI DSS) Collection" isExecutable="false">
      <bpmn:documentation>Trigger: New IT/SaaS/payment third party; attestation expiry; cyber DD
Frequency: Per third party + annual attestation refresh
Volume: ~80–150 IT/SaaS/cloud/payment/marketplace third parties handling data or integrated to BuildRight systems
Owner: TPRM Program Manager (joint with Cyber VS-27.3)
Participants: Cyber (VS-27.3 W367), IT (VS-27), Privacy (VS-91), the third party
Source: workflow W4730 — Cybersecurity &amp; IT-Controls Attestation (SOC 2 / ISO 27001 / PCI DSS) Collection</bpmn:documentation>
      <bpmn:laneSet id="W4730_LaneSet2">
        <bpmn:lane id="W4730_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4730_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4730_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4730_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4730_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4730_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4730_Start3" name="New IT/SaaS/payment third party; attestation expiry; cyber DD">
        <bpmn:outgoing>W4730_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4730_Task4" name="For each IT/SaaS/payment third party, collect cybersecurity &amp; IT-controls…">
        <bpmn:documentation>Step 1: For each IT/SaaS/payment third party, collect cybersecurity &amp; IT-controls attestation appropriate to the data/risk: SOC 2 Type II, ISO 27001, PCI DSS (for payment data), or a security questionnaire for lower-tier; extend enterprise-wide the cyber-vendor slice in VS-27.3 W367
Responsible (R): TPRM Program Manager / Cyber / IT
Accountable (A): TPRM Lead / CIO
Duration: Per third party + annual</bpmn:documentation>
        <bpmn:incoming>W4730_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4730_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4730_Task5" name="Review the attestation for coverage and gaps (scope, exceptions, qualified…">
        <bpmn:documentation>Step 2: Review the attestation for coverage and gaps (scope, exceptions, qualified opinions); require remediation/compensating controls for gaps; coordinate with cyber (VS-27.3) on penetration-test/monitoring integration
Responsible (R): TPRM Program Manager / Cyber
Accountable (A): TPRM Lead / CIO
Duration: Per attestation</bpmn:documentation>
        <bpmn:incoming>W4730_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4730_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4730_Task6" name="Track attestation expiry and refresh (W4735); manage third-party cyber…">
        <bpmn:documentation>Step 3: Track attestation expiry and refresh (W4735); manage third-party cyber incidents (W4736) and integration-risk (VS-27.3/VS-113); retain evidence (VS-88)
Responsible (R): TPRM Program Manager / Cyber / IT
Accountable (A): TPRM Lead / CIO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4730_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4730_End7" name="Complete">
        <bpmn:incoming>W4730_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4730_Annotation8">
        <bpmn:text>Controls: - CTL-714 (ensure controlled execution — Due Diligence, Continuous Monitoring &amp; Evidence Lifecycle (PA-161.2).) | - CTL-714: attestation appropriate to data/risk; scope reviewed; gaps remediated; refresh tracked (W4735)
Owner: TPRM Program Manager (joint with Cyber VS-27.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4730_Assoc9" sourceRef="W4730_Annotation8" targetRef="W4730_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4730_Flow10" sourceRef="W4730_Start3" targetRef="W4730_Task4" />
      <bpmn:sequenceFlow id="W4730_Flow11" sourceRef="W4730_Task4" targetRef="W4730_Task5" />
      <bpmn:sequenceFlow id="W4730_Flow12" sourceRef="W4730_Task5" targetRef="W4730_Task6" />
      <bpmn:sequenceFlow id="W4730_Flow13" sourceRef="W4730_Task6" targetRef="W4730_End7" />
    </bpmn:process>
