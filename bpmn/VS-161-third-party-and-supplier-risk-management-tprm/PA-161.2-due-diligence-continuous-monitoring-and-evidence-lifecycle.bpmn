      <bpmndi:BPMNPlane id="W4730_plane" bpmnElement="W_W4730">
        <bpmndi:BPMNShape id="W4730_Lane1_di" bpmnElement="W4730_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
