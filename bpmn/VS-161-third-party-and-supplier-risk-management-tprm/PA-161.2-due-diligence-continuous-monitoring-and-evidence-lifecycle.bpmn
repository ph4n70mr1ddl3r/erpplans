<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-161.2-due-diligence-continuous-monitoring-and-evidence-lifecycle" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4729" name="W4729. Risk-Based Due Diligence Library &amp; Assessment Workflow (Pre-Contract &amp; Periodic)" isExecutable="false">
      <bpmn:documentation>Trigger: New Critical/High third party; periodic re-DD; material change
Frequency: Pre-contract + periodic (tier-driven cadence)
Volume: ~80–120 Critical/High third parties (deepest DD); ~300–500 Medium (standard); remainder Low (light)
Owner: TPRM Program Manager
Participants: Domain owners (ABC/privacy/cyber/ESG/financial), Procurement (VS-03), Legal (VS-100.3), business owners
Source: workflow W4729 — Risk-Based Due Diligence Library &amp; Assessment Workflow (Pre-Contract &amp; Periodic)</bpmn:documentation>
      <bpmn:laneSet id="W4729_LaneSet2">
        <bpmn:lane id="W4729_Lane1" name="TPRM Program Manager">
        <bpmn:flowNodeRef>W4729_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4729_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4729_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4729_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4729_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4729_Start3" name="New Critical/High third party; periodic re-DD; material change">
        <bpmn:outgoing>W4729_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4729_Task4" name="Maintain the risk-based DD library: tier-driven DD packs (Critical/High = full…">
        <bpmn:documentation>Step 1: Maintain the risk-based DD library: tier-driven DD packs (Critical/High = full cross-domain DD; Medium = standard; Low = light), each combining the domain-specific DD (cyber W4730, privacy W4731, ABC W4732, resilience W4733, financial/ESG W4727)
Responsible (R): TPRM Program Manager / Domain Owners
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4729_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4729_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4729_Task5" name="Run the DD assessment workflow per third party pre-contract and periodically…">
        <bpmn:documentation>Step 2: Run the DD assessment workflow per third party pre-contract and periodically: issue the pack, collect responses/evidence, score, and feed findings into tiering (W4723) and contract terms
Responsible (R): TPRM Program Manager / Domain Owners / Procurement
Accountable (A): TPRM Lead / Head of Internal Audit &amp; Risk
Duration: Per third party</bpmn:documentation>
        <bpmn:incoming>W4729_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4729_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4729_Task6" name="Document DD conclusions and residual risk; obtain risk acceptance for…">
        <bpmn:documentation>Step 3: Document DD conclusions and residual risk; obtain risk acceptance for high-residual third parties per the appetite (W4722); retain evidence (VS-88)
Responsible (R): TPRM Program Manager / Head of Internal Audit &amp; Risk
Accountable (A): Head of Internal Audit &amp; Risk
Duration: Per third party</bpmn:documentation>
        <bpmn:incoming>W4729_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4729_End7" name="Complete">
        <bpmn:incoming>W4729_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4729_Annotation8">
        <bpmn:text>Controls: - CTL-714 (ensure controlled execution — Due Diligence, Continuous Monitoring &amp; Evidence Lifecycle (PA-161.2).) | - CTL-714: tier-driven DD applied; findings feed tiering; high-residual risk formally accepted; evidence retained
Owner: TPRM Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4729_Assoc9" sourceRef="W4729_Annotation8" targetRef="W4729_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4729_Flow10" sourceRef="W4729_Start3" targetRef="W4729_Task4" />
      <bpmn:sequenceFlow id="W4729_Flow11" sourceRef="W4729_Task4" targetRef="W4729_Task5" />
      <bpmn:sequenceFlow id="W4729_Flow12" sourceRef="W4729_Task5" targetRef="W4729_Task6" />
      <bpmn:sequenceFlow id="W4729_Flow13" sourceRef="W4729_Task6" targetRef="W4729_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4729_diag">
      <bpmndi:BPMNPlane id="W4729_plane" bpmnElement="W_W4729">
        <bpmndi:BPMNShape id="W4729_Lane1_di" bpmnElement="W4729_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
