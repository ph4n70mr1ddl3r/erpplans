    <bpmn:process id="W_W4137" name="W4137. Network &amp; Inventory Performance Dashboard &amp; KPI Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous; weekly/monthly review
Frequency: Continuous
Volume: Enterprise network &amp; inventory (~7.2M parameter sets, 205 locations)
Owner: Supply Chain Analytics (VS-28) / Network Strategy Lead
Participants: BI (VS-28), Supply Planning (VS-02), DC Ops (VS-04), Logistics (VS-06)
Source: workflow W4137 — Network &amp; Inventory Performance Dashboard &amp; KPI Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W4137_LaneSet3">
        <bpmn:lane id="W4137_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4137_Task5</bpmn:flowNodeRef>
