        <bpmn:flowNodeRef>W4136_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4136_Start3" name="Working-capital target; turn target; finance review">
        <bpmn:outgoing>W4136_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4136_Task4" name="VP Supply Chain/Finance establish the inventory-investment plan and…">
        <bpmn:documentation>Step 1: VP Supply Chain/Finance establish the inventory-investment plan and turns/GMROI/WOS targets (6–8x turn) aligned to merchandise financial planning (VS-101) and working-capital management (VS-105)
Responsible (R): VP Supply Chain / Finance / Merchandising
Accountable (A): COO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4136_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4136_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4136_Task5" name="VP Supply Chain drive working-capital release: MEIO (W4130), slow-mover…">
        <bpmn:documentation>Step 2: VP Supply Chain drive working-capital release: MEIO (W4130), slow-mover reduction (W4134), lead-time reduction, and SCF/dynamic discounting (links to VS-105), balancing turn vs service
Responsible (R): VP Supply Chain / Finance
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4136_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4136_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4136_Task6" name="VP Supply Chain/Finance report inventory investment, turns, and working-capital…">
        <bpmn:documentation>Step 3: VP Supply Chain/Finance report inventory investment, turns, and working-capital to the executive/Board (VS-33/VS-36), and flag gaps
Responsible (R): VP Supply Chain / Finance
Accountable (A): COO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4136_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4136_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4136_End7" name="Complete">
        <bpmn:incoming>W4136_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4136_Annotation8">
        <bpmn:text>Controls: - CTL-639 (ensure controlled execution — Multi-Echelon Inventory Optimization &amp; Service-Level Engineering (PA-136.2).) | - CTL-639: turn/service targets balanced and approved; working-capital reconciled by Finance
Owner: VP Supply Chain / Finance (VS-105)</bpmn:text>
      </bpmn:textAnnotation>
