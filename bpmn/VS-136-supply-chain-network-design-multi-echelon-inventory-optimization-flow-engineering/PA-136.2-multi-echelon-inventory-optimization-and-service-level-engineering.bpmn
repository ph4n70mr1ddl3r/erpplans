    <bpmn:process id="W_W4136" name="W4136. Inventory Investment, Turns &amp; Working Capital Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Working-capital target; turn target; finance review
Frequency: Continuous + quarterly
Volume: Enterprise inventory investment (turns target 6–8x)
Owner: VP Supply Chain / Finance (VS-105)
Participants: Finance (VS-17.4/VS-105), Merchandising (VS-01/VS-101), Supply Planning (VS-02)
Source: workflow W4136 — Inventory Investment, Turns &amp; Working Capital Optimization</bpmn:documentation>
      <bpmn:laneSet id="W4136_LaneSet2">
        <bpmn:lane id="W4136_Lane1" name="VP Supply Chain">
        <bpmn:flowNodeRef>W4136_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4136_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4136_Task6</bpmn:flowNodeRef>
