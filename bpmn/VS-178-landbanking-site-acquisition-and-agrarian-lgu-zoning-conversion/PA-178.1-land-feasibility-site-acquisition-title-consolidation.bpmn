    <bpmn:process id="W_W5132" name="W5132. Extrajudicial Settlement (EJS) of Estate Negotiation &amp; Heir Consent" isExecutable="false">
      <bpmn:documentation>Trigger: Title search (W5130) showing deceased owner on TCT
Frequency: Event-driven per site transaction
Volume: ~5–10 multi-heir negotiations annually
Owner: Land Acquisition Manager / Legal Specialist
Participants: Heirs of the deceased owner, Legal Operations (VS-100), Notary Public
Source: workflow W5132 — Extrajudicial Settlement (EJS) of Estate Negotiation &amp; Heir Consent</bpmn:documentation>
      <bpmn:laneSet id="W5132_LaneSet2">
        <bpmn:lane id="W5132_Lane1" name="Land Acquisition Manager">
        <bpmn:flowNodeRef>W5132_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5132_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5132_Start3" name="Title search (W5130) showing deceased owner on TCT">
        <bpmn:outgoing>W5132_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5132_Task4" name="Identify and locate all legal heirs of the deceased registered owner; compile…">
        <bpmn:documentation>Step 1: Identify and locate all legal heirs of the deceased registered owner; compile family tree and birth/death certificates.
Responsible (R): Land Acquisition Manager / Legal Specialist
Accountable (A): Land Acquisition Manager / Legal Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5132_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5132_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5132_Task5" name="Negotiate settlement terms: distribute proceeds or arrange buy-out of…">
        <bpmn:documentation>Step 2: Negotiate settlement terms: distribute proceeds or arrange buy-out of minor/dissenting heirs&#x27; shares.
Responsible (R): Land Acquisition Manager / Legal Specialist
Accountable (A): Land Acquisition Manager / Legal Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5132_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5132_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5132_Task6" name="Draft the Deed of Extrajudicial Settlement of Estate with Absolute Sale…">
        <bpmn:documentation>Step 3: Draft the Deed of Extrajudicial Settlement of Estate with Absolute Sale (EJS-with-Sale).
Responsible (R): Land Acquisition Manager / Legal Specialist
Accountable (A): Land Acquisition Manager / Legal Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5132_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5132_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5132_Task7" name="Publish EJS in a newspaper of general circulation for three consecutive weeks…">
        <bpmn:documentation>Step 4: Publish EJS in a newspaper of general circulation for three consecutive weeks as legally required under Rules of Court.
Responsible (R): Land Acquisition Manager / Legal Specialist
Accountable (A): Land Acquisition Manager / Legal Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5132_Flow15</bpmn:incoming>
        <bpmn:outgoing>W5132_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5132_Task8" name="File EJS and proof of publication with the BIR for estate tax clearance and…">
        <bpmn:documentation>Step 5: File EJS and proof of publication with the BIR for estate tax clearance and local Registry of Deeds for transfer.
Responsible (R): Land Acquisition Manager / Legal Specialist
Accountable (A): Land Acquisition Manager / Legal Specialist
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5132_Flow16</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5132_End9" name="Complete">
        <bpmn:incoming>W5132_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5132_Annotation10">
        <bpmn:text>Controls: - CTL-141 (ensure land title &amp; acquisition due diligence.) | - CTL-764: EJS signed by 100% of heirs; publication affidavit verified by Legal; estate tax paid and BIR CAR (Certificate Authorizing Registration) secured.
Owner: Land Acquisition Manager / Legal Specialist</bpmn:text>
      </bpmn:textAnnotation>
