      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5130" name="W5130. Land Ownership Search, Title Verification &amp; Due Diligence" isExecutable="false">
      <bpmn:documentation>Trigger: Approved suitability report (W5129)
Frequency: Per approved site candidate
Volume: ~20–25 due diligence reviews annually
Owner: Legal &amp; Compliance Counsel / Land Acquisition Manager
Participants: Legal Operations (VS-100), Registry of Deeds (RD) liaison, Geodetic Engineer
Source: workflow W5130 — Land Ownership Search, Title Verification &amp; Due Diligence</bpmn:documentation>
      <bpmn:laneSet id="W5130_LaneSet2">
        <bpmn:lane id="W5130_Lane1" name="Legal &amp; Compliance Counsel">
        <bpmn:flowNodeRef>W5130_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5130_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5130_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5130_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5130_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5130_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5130_Start3" name="Approved suitability report (W5129)">
        <bpmn:outgoing>W5130_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5130_Task4" name="Request Certified True Copies of Transfer Certificates of Title (TCT) from the…">
        <bpmn:documentation>Step 1: Request Certified True Copies of Transfer Certificates of Title (TCT) from the Registry of Deeds.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5130_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5130_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5130_Task5" name="Trace title history (root search) to identify potential overlapping claims…">
        <bpmn:documentation>Step 2: Trace title history (root search) to identify potential overlapping claims, land patents, or free patents.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5130_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5130_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5130_Task6" name="Verify liens, mortgages, encumbrances, and pending litigations (lis pendens)…">
        <bpmn:documentation>Step 3: Verify liens, mortgages, encumbrances, and pending litigations (lis pendens) annotated on the title.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5130_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5130_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5130_Task7" name="Confirm land ownership matching with tax declarations and secure Certified True…">
        <bpmn:documentation>Step 4: Confirm land ownership matching with tax declarations and secure Certified True Copy of Tax Declarations from City/Municipal Assessor.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5130_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5130_End8" name="Complete">
        <bpmn:incoming>W5130_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5130_Annotation9">
        <bpmn:text>Controls: - CTL-141 (ensure land title &amp; acquisition due diligence.) | - CTL-764: Certified True Copies of TCT signed by RD Registrar; legal due diligence sign-off mandated before purchase offer.
Owner: Legal &amp; Compliance Counsel / Land Acquisition Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5130_Assoc10" sourceRef="W5130_Annotation9" targetRef="W5130_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5130_Flow11" sourceRef="W5130_Start3" targetRef="W5130_Task4" />
      <bpmn:sequenceFlow id="W5130_Flow12" sourceRef="W5130_Task4" targetRef="W5130_Task5" />
      <bpmn:sequenceFlow id="W5130_Flow13" sourceRef="W5130_Task5" targetRef="W5130_Task6" />
      <bpmn:sequenceFlow id="W5130_Flow14" sourceRef="W5130_Task6" targetRef="W5130_Task7" />
      <bpmn:sequenceFlow id="W5130_Flow15" sourceRef="W5130_Task7" targetRef="W5130_End8" />
    </bpmn:process>
