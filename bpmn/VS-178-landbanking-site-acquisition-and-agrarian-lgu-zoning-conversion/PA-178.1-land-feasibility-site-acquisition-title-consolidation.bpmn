    <bpmn:process id="W_W5134" name="W5134. Deed of Absolute Sale (DOAS) Negotiation, Drafting &amp; Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Clear title due diligence (W5130) and survey confirmation (W5133)
Frequency: Per site transaction
Volume: ~10–15 transactions annually
Owner: Legal &amp; Compliance Counsel / Land Acquisition Manager
Participants: Seller, Escrow Agent (Bank), CFO, CEO, Legal (VS-100), Treasury (VS-18)
Source: workflow W5134 — Deed of Absolute Sale (DOAS) Negotiation, Drafting &amp; Execution</bpmn:documentation>
      <bpmn:laneSet id="W5134_LaneSet2">
        <bpmn:lane id="W5134_Lane1" name="Legal &amp; Compliance Counsel">
        <bpmn:flowNodeRef>W5134_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5134_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5134_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5134_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5134_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5134_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5134_Start3" name="Clear title due diligence (W5130) and survey confirmation (W5133)">
        <bpmn:outgoing>W5134_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5134_Task4" name="Negotiate final purchase price, payment terms (escrow/milestones), and…">
        <bpmn:documentation>Step 1: Negotiate final purchase price, payment terms (escrow/milestones), and responsibility for transfer taxes (CGT, DST, Transfer Tax, Registration Fees).
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5134_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5134_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5134_Task5" name="Draft Deed of Absolute Sale (DOAS) incorporating technical descriptions…">
        <bpmn:documentation>Step 2: Draft Deed of Absolute Sale (DOAS) incorporating technical descriptions, warranties of title, and zoning conversion clauses.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5134_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5134_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5134_Task6" name="Execute DOAS: arrange simultaneous signing by parties, notarize the document…">
        <bpmn:documentation>Step 3: Execute DOAS: arrange simultaneous signing by parties, notarize the document, and request Treasury to release escrow/downpayment per contract terms.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5134_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5134_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5134_Task7" name="Prepare tax file for filing Capital Gains Tax (CGT) and Documentary Stamp Tax…">
        <bpmn:documentation>Step 4: Prepare tax file for filing Capital Gains Tax (CGT) and Documentary Stamp Tax (DST) with the BIR.
Responsible (R): Legal &amp; Compliance Counsel / Land Acquisition Manager
Accountable (A): Legal &amp; Compliance Counsel / Land Acquisition Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5134_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5134_End8" name="Complete">
        <bpmn:incoming>W5134_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5134_Annotation9">
        <bpmn:text>Controls: - CTL-764 (ensure controlled execution — Land Feasibility, Site Acquisition &amp; Title Consolidation (PA-178.1).) | - CTL-764: Dual officer signatures (COO/CFO/CEO) per corporate table of authority; notary verification; escrow release tied to notarized DOAS.
Owner: Legal &amp; Compliance Counsel / Land Acquisition Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5134_Assoc10" sourceRef="W5134_Annotation9" targetRef="W5134_Start3" associationDirection="None" />
