    <bpmn:process id="W_W5131" name="W5131. Real Property Tax (RPT) Arrears Investigation &amp; Settlement" isExecutable="false">
      <bpmn:documentation>Trigger: Title verification (W5130) showing tax declarations or tax liens
Frequency: Per transaction due diligence
Volume: ~15–20 investigations annually
Owner: Land Acquisition Specialist / Tax Accountant
Participants: Municipal/City Treasurer, Seller, Tax Management (VS-79)
Source: workflow W5131 — Real Property Tax (RPT) Arrears Investigation &amp; Settlement</bpmn:documentation>
      <bpmn:laneSet id="W5131_LaneSet2">
        <bpmn:lane id="W5131_Lane1" name="Land Acquisition Specialist">
        <bpmn:flowNodeRef>W5131_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5131_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5131_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5131_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5131_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5131_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5131_Start3" name="Title verification (W5130) showing tax declarations or tax liens">
        <bpmn:outgoing>W5131_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5131_Task4" name="Request Certified Statement of Real Property Tax Liabilities from the City or…">
        <bpmn:documentation>Step 1: Request Certified Statement of Real Property Tax Liabilities from the City or Municipal Treasurer&#x27;s Office.
Responsible (R): Land Acquisition Specialist / Tax Accountant
Accountable (A): Land Acquisition Specialist / Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5131_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5131_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5131_Task5" name="Verify historical arrears, penalties, and interest accrued on both land and…">
        <bpmn:documentation>Step 2: Verify historical arrears, penalties, and interest accrued on both land and improvements.
Responsible (R): Land Acquisition Specialist / Tax Accountant
Accountable (A): Land Acquisition Specialist / Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5131_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5131_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5131_Task6" name="Draft tax settlement agreement: compute total taxes due, negotiate deduction of…">
        <bpmn:documentation>Step 3: Draft tax settlement agreement: compute total taxes due, negotiate deduction of arrears from the final purchase price.
Responsible (R): Land Acquisition Specialist / Tax Accountant
Accountable (A): Land Acquisition Specialist / Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5131_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5131_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5131_Task7" name="Pay taxes at the Treasurer&#x27;s Office and secure a Tax Clearance Certificate.">
        <bpmn:documentation>Step 4: Pay taxes at the Treasurer&#x27;s Office and secure a Tax Clearance Certificate.
Responsible (R): Land Acquisition Specialist / Tax Accountant
Accountable (A): Land Acquisition Specialist / Tax Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5131_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5131_End8" name="Complete">
        <bpmn:incoming>W5131_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5131_Annotation9">
        <bpmn:text>Controls: - CTL-141 (ensure land title &amp; acquisition due diligence.) | - CTL-764: Tax Clearance Certificate secured from LGU Treasurer; payment matched to escrow deduction rules.
Owner: Land Acquisition Specialist / Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5131_Assoc10" sourceRef="W5131_Annotation9" targetRef="W5131_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5131_Flow11" sourceRef="W5131_Start3" targetRef="W5131_Task4" />
      <bpmn:sequenceFlow id="W5131_Flow12" sourceRef="W5131_Task4" targetRef="W5131_Task5" />
      <bpmn:sequenceFlow id="W5131_Flow13" sourceRef="W5131_Task5" targetRef="W5131_Task6" />
      <bpmn:sequenceFlow id="W5131_Flow14" sourceRef="W5131_Task6" targetRef="W5131_Task7" />
      <bpmn:sequenceFlow id="W5131_Flow15" sourceRef="W5131_Task7" targetRef="W5131_End8" />
    </bpmn:process>
