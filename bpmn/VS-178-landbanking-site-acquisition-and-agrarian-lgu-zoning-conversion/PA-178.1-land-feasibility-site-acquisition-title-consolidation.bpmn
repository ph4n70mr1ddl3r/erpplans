      <bpmn:sequenceFlow id="W5134_Flow12" sourceRef="W5134_Task4" targetRef="W5134_Task5" />
      <bpmn:sequenceFlow id="W5134_Flow13" sourceRef="W5134_Task5" targetRef="W5134_Task6" />
      <bpmn:sequenceFlow id="W5134_Flow14" sourceRef="W5134_Task6" targetRef="W5134_Task7" />
      <bpmn:sequenceFlow id="W5134_Flow15" sourceRef="W5134_Task7" targetRef="W5134_End8" />
    </bpmn:process>
