      <bpmndi:BPMNPlane id="W5130_plane" bpmnElement="W_W5130">
        <bpmndi:BPMNShape id="W5130_Lane1_di" bpmnElement="W5130_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
