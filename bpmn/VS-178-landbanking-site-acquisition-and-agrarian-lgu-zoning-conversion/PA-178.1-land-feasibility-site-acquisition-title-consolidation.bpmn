<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-178.1-land-feasibility-site-acquisition-title-consolidation" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5129" name="W5129. Store Footprint Expansion Site Suitability &amp; Strategic Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Annual expansion plan release (VS-33); site lead generation
Frequency: Ad-hoc per candidate site
Volume: ~30–40 site candidates evaluated annually for 10–15 selection slots
Owner: Director, Facilities &amp; Real Estate &amp; Land Acquisition
Participants: Strategy (VS-33), Finance (VS-17.4), Construction PMO (VS-112), Legal Operations (VS-100)
Source: workflow W5129 — Store Footprint Expansion Site Suitability &amp; Strategic Assessment</bpmn:documentation>
      <bpmn:laneSet id="W5129_LaneSet2">
        <bpmn:lane id="W5129_Lane1" name="Director, Facilities &amp; Real Estate &amp; Land…">
        <bpmn:flowNodeRef>W5129_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5129_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5129_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5129_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5129_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5129_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5129_Start3" name="Annual expansion plan release (VS-33); site lead generation">
        <bpmn:outgoing>W5129_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5129_Task4" name="Perform physical site evaluation: check plot area (8,000-15,000 sqm), frontage…">
        <bpmn:documentation>Step 1: Perform physical site evaluation: check plot area (8,000-15,000 sqm), frontage width, traffic access, utility availability, and terrain stability.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5129_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5129_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5129_Task5" name="Conduct market mapping: analyze regional trade area, competitor density…">
        <bpmn:documentation>Step 2: Conduct market mapping: analyze regional trade area, competitor density (VS-57), household income, and trade-pro concentration.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5129_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5129_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5129_Task6" name="Prepare preliminary financial model: estimate acquisition cost, site-prep…">
        <bpmn:documentation>Step 3: Prepare preliminary financial model: estimate acquisition cost, site-prep Capex, target payback period, and net present value (NPV).
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5129_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5129_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5129_Task7" name="Draft site suitability report and route to Real Estate Committee for stage-gate…">
        <bpmn:documentation>Step 4: Draft site suitability report and route to Real Estate Committee for stage-gate approval (VS-112).
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5129_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5129_End8" name="Complete">
        <bpmn:incoming>W5129_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5129_Annotation9">
        <bpmn:text>Controls: - CTL-764 (ensure controlled execution — Land Feasibility, Site Acquisition &amp; Title Consolidation (PA-178.1).) | - CTL-764: Real Estate Committee formal approval required before title search; board authorization limits adhered to.
Owner: Director, Facilities &amp; Real Estate &amp; Land Acquisition</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5129_Assoc10" sourceRef="W5129_Annotation9" targetRef="W5129_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5129_Flow11" sourceRef="W5129_Start3" targetRef="W5129_Task4" />
      <bpmn:sequenceFlow id="W5129_Flow12" sourceRef="W5129_Task4" targetRef="W5129_Task5" />
      <bpmn:sequenceFlow id="W5129_Flow13" sourceRef="W5129_Task5" targetRef="W5129_Task6" />
      <bpmn:sequenceFlow id="W5129_Flow14" sourceRef="W5129_Task6" targetRef="W5129_Task7" />
      <bpmn:sequenceFlow id="W5129_Flow15" sourceRef="W5129_Task7" targetRef="W5129_End8" />
    </bpmn:process>
