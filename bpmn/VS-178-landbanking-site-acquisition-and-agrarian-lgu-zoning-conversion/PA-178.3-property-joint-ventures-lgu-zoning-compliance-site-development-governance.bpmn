        <bpmn:flowNodeRef>W5151_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5151_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5151_Start4" name="Acquisition contract (W5134) and construction permit readiness (W5150)">
        <bpmn:outgoing>W5151_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5151_Task5" name="Set up the Site Acquisition &amp; Development project code in ERP Capex module.">
        <bpmn:documentation>Step 1: Set up the Site Acquisition &amp; Development project code in ERP Capex module.
Responsible (R): Real Estate Controller / Project Accountant
Accountable (A): Real Estate Controller / Project Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5151_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5151_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5151_Task6" name="Draft Capex budget allocation matching purchase milestones: downpayment, title…">
        <bpmn:documentation>Step 2: Draft Capex budget allocation matching purchase milestones: downpayment, title consolidation, zoning clearances, and land conversion order release.
Responsible (R): Real Estate Controller / Project Accountant
Accountable (A): Real Estate Controller / Project Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5151_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5151_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5151_Task7" name="Validate payment documentation (invoices, BIR clearances, notarized DOAS) prior…">
        <bpmn:documentation>Step 3: Validate payment documentation (invoices, BIR clearances, notarized DOAS) prior to milestone release requests.
Responsible (R): Real Estate Controller / Project Accountant
Accountable (A): Real Estate Controller / Project Accountant
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5151_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5151_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5151_Task8" name="Treasury executes payments to seller escrow or LGUs/contractors upon authorized…">
        <bpmn:documentation>Step 4: Treasury executes payments to seller escrow or LGUs/contractors upon authorized milestones approval.
Responsible (R): Treasury / Project Accountant
Accountable (A): CFO
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5151_Flow15</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5151_End9" name="Complete">
        <bpmn:incoming>W5151_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5151_Annotation10">
        <bpmn:text>Controls: - CTL-766 (ensure controlled execution — Property Joint-Ventures, LGU Zoning Compliance &amp; Site Development Governance (PA-178.3).) | - CTL-766: Payments match project budget; three-way match on land services invoices; CFO approval on land cash outputs.
Owner: Finance Controller / Project Accountant</bpmn:text>
      </bpmn:textAnnotation>
