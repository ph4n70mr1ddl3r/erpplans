    <bpmn:process id="W_W5147" name="W5147. LGU Comprehensive Land Use Plan (CLUP) Conformity &amp; Zoning Variance Application" isExecutable="false">
      <bpmn:documentation>Trigger: Locational clearance review indicating site zoning is borderline or conflicts with new CLUP maps
Frequency: Event-driven per site variance necessity
Volume: ~3–5 variance applications annually
Owner: Regulatory Compliance Officer / Land Liaison Officer
Participants: LGU Zoning Administrator, Local Zoning Board of Appeals (LZBA)
Source: workflow W5147 — LGU Comprehensive Land Use Plan (CLUP) Conformity &amp; Zoning Variance Application</bpmn:documentation>
      <bpmn:laneSet id="W5147_LaneSet2">
        <bpmn:lane id="W5147_Lane1" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W5147_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5147_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5147_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5147_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5147_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5147_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5147_Start3" name="Locational clearance review indicating site zoning is borderline or conflicts with new…">
        <bpmn:outgoing>W5147_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5147_Task4" name="File formal Application for Zoning Variance / Exception with the LGU Zoning…">
        <bpmn:documentation>Step 1: File formal Application for Zoning Variance / Exception with the LGU Zoning Administrator.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5147_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5147_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5147_Task5" name="Provide variance justification: job creation (~29 employees per store directly…">
        <bpmn:documentation>Step 2: Provide variance justification: job creation (~29 employees per store directly, plus construction labor), local business growth, and tax contributions.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5147_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5147_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5147_Task6" name="Present case before the Local Zoning Board of Appeals; address environmental…">
        <bpmn:documentation>Step 3: Present case before the Local Zoning Board of Appeals; address environmental, traffic, and noise concerns.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5147_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5147_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5147_Task7" name="Secure LZBA Board Resolution granting the zoning variance or exception…">
        <bpmn:documentation>Step 4: Secure LZBA Board Resolution granting the zoning variance or exception clearance.
Responsible (R): Regulatory Compliance Officer / Land Liaison Officer
Accountable (A): Regulatory Compliance Officer / Land Liaison Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5147_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5147_End8" name="Complete">
        <bpmn:incoming>W5147_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5147_Annotation9">
        <bpmn:text>Controls: - CTL-766 (ensure controlled execution — Property Joint-Ventures, LGU Zoning Compliance &amp; Site Development Governance (PA-178.3).) | - CTL-766: LZBA Board Resolution certified and filed with LGU City Engineer; signed copy attached to building permit application.
Owner: Regulatory Compliance Officer / Land Liaison Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5147_Assoc10" sourceRef="W5147_Annotation9" targetRef="W5147_Start3" associationDirection="None" />
