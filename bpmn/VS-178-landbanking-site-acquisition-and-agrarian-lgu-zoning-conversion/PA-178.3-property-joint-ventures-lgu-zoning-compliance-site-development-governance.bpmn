        <bpmn:flowNodeRef>W5152_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5152_Start3" name="Consolidated TCT (W5136), Zoning permit (W5149), and environmental ECC (W5144) secured…">
        <bpmn:outgoing>W5152_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5152_Task4" name="Compile Handover Folder: consolidated title TCT, approved geodetic plans, ECC…">
        <bpmn:documentation>Step 1: Compile Handover Folder: consolidated title TCT, approved geodetic plans, ECC, locational clearances, RROW agreements, and LGU permits.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5152_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5152_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5152_Task5" name="Conduct joint site walk-through with Construction Project PMO and Site Engineer.">
        <bpmn:documentation>Step 2: Conduct joint site walk-through with Construction Project PMO and Site Engineer.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5152_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5152_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5152_Task6" name="Review boundary benchmarks, utility connections, and LGU construction…">
        <bpmn:documentation>Step 3: Review boundary benchmarks, utility connections, and LGU construction conditions.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5152_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5152_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5152_Task7" name="Sign off on formal Site Handover Protocol, transferring site responsibility and…">
        <bpmn:documentation>Step 4: Sign off on formal Site Handover Protocol, transferring site responsibility and security to the Construction PMO.
Responsible (R): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Accountable (A): Director, Facilities &amp; Real Estate &amp; Land Acquisition
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5152_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5152_End8" name="Complete">
        <bpmn:incoming>W5152_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5152_Annotation9">
        <bpmn:text>Controls: - CTL-766 (ensure controlled execution — Property Joint-Ventures, LGU Zoning Compliance &amp; Site Development Governance (PA-178.3).) | - CTL-766: Handover Protocol signed by Real Estate Director and Construction PMO Director; documented in project file.
Owner: Director, Facilities &amp; Real Estate &amp; Land Acquisition</bpmn:text>
      </bpmn:textAnnotation>
