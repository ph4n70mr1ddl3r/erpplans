    <bpmn:process id="W_W5145" name="W5145. Joint-Venture (JV) Landowner Development Agreement Negotiation &amp; Structuring" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic target site owned by prominent local family refusing outright sale but open to JV development
Frequency: Event-driven per JV transaction
Volume: ~2–3 joint ventures annually
Owner: VP Store Operations / Director, Facilities &amp; Real Estate
Participants: Landowner, Legal (VS-100), Finance (VS-17.4), BuildRight Property Management, Inc.
Source: workflow W5145 — Joint-Venture (JV) Landowner Development Agreement Negotiation &amp; Structuring</bpmn:documentation>
      <bpmn:laneSet id="W5145_LaneSet2">
        <bpmn:lane id="W5145_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W5145_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5145_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5145_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5145_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5145_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5145_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5145_Start3" name="Strategic target site owned by prominent local family refusing outright sale but open to…">
        <bpmn:outgoing>W5145_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5145_Task4" name="Conduct commercial modeling: analyze land appraisal value vs. BuildRight&#x27;s…">
        <bpmn:documentation>Step 1: Conduct commercial modeling: analyze land appraisal value vs. BuildRight&#x27;s store-construction Capex.
Responsible (R): VP Store Operations / Director, Facilities &amp; Real Estate
Accountable (A): VP Store Operations / Director, Facilities &amp; Real Estate
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5145_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5145_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5145_Task5" name="Structure JV terms: land contribution as landowner equity; cash contribution…">
        <bpmn:documentation>Step 2: Structure JV terms: land contribution as landowner equity; cash contribution and store building as BuildRight equity; negotiate lease rentals, revenue sharing, or store-in-store concession rights.
Responsible (R): VP Store Operations / Director, Facilities &amp; Real Estate
Accountable (A): VP Store Operations / Director, Facilities &amp; Real Estate
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5145_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5145_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5145_Task6" name="Draft JV Development Agreement defining governance, board seats, profit…">
        <bpmn:documentation>Step 3: Draft JV Development Agreement defining governance, board seats, profit distribution, and exit strategies.
Responsible (R): VP Store Operations / Director, Facilities &amp; Real Estate
Accountable (A): VP Store Operations / Director, Facilities &amp; Real Estate
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5145_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5145_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5145_Task7" name="Incorporate a site-specific joint venture entity or register JV agreement under…">
        <bpmn:documentation>Step 4: Incorporate a site-specific joint venture entity or register JV agreement under BuildRight Property Management, Inc.
Responsible (R): VP Store Operations / Director, Facilities &amp; Real Estate
Accountable (A): VP Store Operations / Director, Facilities &amp; Real Estate
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5145_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5145_End8" name="Complete">
        <bpmn:incoming>W5145_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5145_Annotation9">
        <bpmn:text>Controls: - CTL-766 (ensure controlled execution — Property Joint-Ventures, LGU Zoning Compliance &amp; Site Development Governance (PA-178.3).) | - CTL-766: JV agreements reviewed by External Counsel, approved by Board of Directors (VS-36); corporate bank accounts mapped.
Owner: VP Store Operations / Director, Facilities &amp; Real Estate</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5145_Assoc10" sourceRef="W5145_Annotation9" targetRef="W5145_Start3" associationDirection="None" />
