    <bpmn:process id="W_W5152" name="W5152. Site Handover to Construction Project PMO" isExecutable="false">
      <bpmn:documentation>Trigger: Consolidated TCT (W5136), Zoning permit (W5149), and environmental ECC (W5144) secured; site mobilization complete (W5150)
Frequency: Per new store construction project
Volume: 10–15 handovers annually
Owner: Director, Facilities &amp; Real Estate &amp; Land Acquisition
Participants: Director of Construction PMO (VS-112), Site Engineer, Project Manager (VS-20)
Source: workflow W5152 — Site Handover to Construction Project PMO</bpmn:documentation>
      <bpmn:laneSet id="W5152_LaneSet2">
        <bpmn:lane id="W5152_Lane1" name="Director, Facilities &amp; Real Estate &amp; Land…">
        <bpmn:flowNodeRef>W5152_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5152_Task5</bpmn:flowNodeRef>
