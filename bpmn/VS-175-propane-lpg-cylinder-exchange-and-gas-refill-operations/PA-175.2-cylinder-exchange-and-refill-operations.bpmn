      <bpmndi:BPMNPlane id="W5066_plane" bpmnElement="W_W5066">
        <bpmndi:BPMNShape id="W5066_Lane1_di" bpmnElement="W5066_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5066_Lane2_di" bpmnElement="W5066_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5066_Lane3_di" bpmnElement="W5066_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5066_Task6_di" bpmnElement="W5066_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
