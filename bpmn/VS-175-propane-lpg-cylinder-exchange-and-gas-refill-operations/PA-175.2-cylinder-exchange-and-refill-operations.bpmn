        <bpmndi:BPMNEdge id="W5066_Flow13_di" bpmnElement="W5066_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5066_Flow14_di" bpmnElement="W5066_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5066_Flow15_di" bpmnElement="W5066_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W5066_Assoc11_di" bpmnElement="W5066_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5067" name="W5067. In-Store LPG Cage Daily Operations, Inventory &amp; Cylinder Receiving/Dispatch" isExecutable="false">
      <bpmn:documentation>Trigger: Daily cage ops; replenishment receipt; exchange activity
Frequency: Daily
Volume: ~200 stores × daily cage ops
Owner: Cage/Stock Associate (VS-07) / Store Manager
Participants: Cage Associate, Store Manager, HSE (VS-24), Receiving (VS-07)
Source: workflow W5067 — In-Store LPG Cage Daily Operations, Inventory &amp; Cylinder Receiving/Dispatch</bpmn:documentation>
      <bpmn:laneSet id="W5067_LaneSet2">
        <bpmn:lane id="W5067_Lane1" name="Cage Associate">
        <bpmn:flowNodeRef>W5067_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5067_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5067_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5067_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5067_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5067_Start3" name="Daily cage ops; replenishment receipt; exchange activity">
        <bpmn:outgoing>W5067_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5067_Task4" name="Open &amp; inspect the cage: daily leak/visual inspection (W5073), confirm…">
        <bpmn:documentation>Step 1: Open &amp; inspect the cage: daily leak/visual inspection (W5073), confirm max-cylinder limit not exceeded (W5061), and verify full/empty segregation &amp; signage
Responsible (R): Cage Associate / HSE
Accountable (A): Store Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5067_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5067_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5067_Task5" name="Manage cage inventory: scan cylinders in/out (replenishment receipt W5070…">
        <bpmn:documentation>Step 2: Manage cage inventory: scan cylinders in/out (replenishment receipt W5070, exchange W5065, refill W5068), maintain full/empty counts, and flag replenishment need
Responsible (R): Cage Associate
Accountable (A): Store Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5067_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5067_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5067_Task6" name="Close &amp; secure: end-of-day cage secure/lock, inventory reconciliation, and any…">
        <bpmn:documentation>Step 3: Close &amp; secure: end-of-day cage secure/lock, inventory reconciliation, and any incident/exception escalation (links W5073/W5075)
Responsible (R): Cage Associate / Store Manager
Accountable (A): Store Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5067_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5067_End7" name="Complete">
        <bpmn:incoming>W5067_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5067_Annotation8">
        <bpmn:text>Controls: - CTL-756 (ensure controlled execution — Cylinder Exchange &amp; Refill Operations (PA-175.2).) | - CTL-756: max-cylinder limit enforced; daily leak inspection (W5073); inventory reconciled (W5076)
Owner: Cage/Stock Associate (VS-07) / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5067_Assoc9" sourceRef="W5067_Annotation8" targetRef="W5067_Start3" associationDirection="None" />
