    <bpmn:process id="W_W5066" name="W5066. Cylinder Refill, Re-Valve &amp; Hydrostatic-Test Vendor Coordination &amp; Logistics" isExecutable="false">
      <bpmn:documentation>Trigger: Empty-cylinder backlog at store/DC; re-qual/expiry due
Frequency: Continuous (replenishment cycle)
Volume: ~thousands of cylinders per refill cycle
Owner: Logistics/Fleet (VS-06) / Category Manager
Participants: Logistics (VS-06), Refill Vendor (VS-03), DC Ops (VS-04), Store Ops (VS-07), HSE (VS-24)
Source: workflow W5066 — Cylinder Refill, Re-Valve &amp; Hydrostatic-Test Vendor Coordination &amp; Logistics</bpmn:documentation>
      <bpmn:laneSet id="W5066_LaneSet4">
        <bpmn:lane id="W5066_Lane1" name="Logistics">
        <bpmn:flowNodeRef>W5066_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5066_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5066_Lane2" name="Refill Vendor">
        <bpmn:flowNodeRef>W5066_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5066_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W5066_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5066_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5066_Start5" name="Empty-cylinder backlog at store/DC; re-qual/expiry due">
        <bpmn:outgoing>W5066_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5066_Task6" name="Consolidate empties &amp; dispatch to refill vendor: collect empties from store…">
        <bpmn:documentation>Step 1: Consolidate empties &amp; dispatch to refill vendor: collect empties from store cages, consolidate at DC/transfer point (VS-04/VS-06), and dispatch to the DOE-licensed refill/re-qual vendor (W5058) under DG transport rules (VS-114)
Responsible (R): Logistics / DC Ops
Accountable (A): Logistics Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5066_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5066_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5066_Task7" name="Coordinate refill/re-valve/hydrostatic-test: vendor fills to spec…">
        <bpmn:documentation>Step 2: Coordinate refill/re-valve/hydrostatic-test: vendor fills to spec, re-vals/re-quals per schedule (W5060), certifies (DTI-BPS/RA 11592 — VS-117/W5059), and returns full/certified cylinders
Responsible (R): Refill Vendor / Logistics / HSE
Accountable (A): Logistics Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5066_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5066_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5066_Task8" name="Receive &amp; reconcile: receive full cylinders, scan IDs back into the pool…">
        <bpmn:documentation>Step 3: Receive &amp; reconcile: receive full cylinders, scan IDs back into the pool (VS-151), reconcile counts/condition against dispatch, and replenish stores (W5070)
Responsible (R): DC Ops / Logistics
Accountable (A): Logistics Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5066_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5066_End9" name="Complete">
        <bpmn:incoming>W5066_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5066_Annotation10">
        <bpmn:text>Controls: - CTL-756 (ensure controlled execution — Cylinder Exchange &amp; Refill Operations (PA-175.2).) | - CTL-756: vendor DOE-licensed &amp; DTI-BPS-certified (VS-117); DG transport compliant (VS-114); cylinder reconciliation (W5076)
Owner: Logistics/Fleet (VS-06) / Category Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5066_Assoc11" sourceRef="W5066_Annotation10" targetRef="W5066_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W5066_Flow12" sourceRef="W5066_Start5" targetRef="W5066_Task6" />
      <bpmn:sequenceFlow id="W5066_Flow13" sourceRef="W5066_Task6" targetRef="W5066_Task7" />
      <bpmn:sequenceFlow id="W5066_Flow14" sourceRef="W5066_Task7" targetRef="W5066_Task8" />
      <bpmn:sequenceFlow id="W5066_Flow15" sourceRef="W5066_Task8" targetRef="W5066_End9" />
    </bpmn:process>
