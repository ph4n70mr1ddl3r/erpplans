<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-175.2-cylinder-exchange-and-refill-operations" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W5065" name="W5065. Customer Cylinder Exchange Transaction &amp; POS Workflow (Full-for-Empty)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer exchange request at store/counter
Frequency: Continuous; ~5,000–20,000 exchanges/week at maturity
Volume: 1 exchange transaction per customer
Owner: Store Services Lead / Cashier (VS-08)
Participants: Cashier (VS-08), Store Associate, Cage/Stock Associate (VS-07), LP (VS-23 — deposit integrity)
Source: workflow W5065 — Customer Cylinder Exchange Transaction &amp; POS Workflow (Full-for-Empty)</bpmn:documentation>
      <bpmn:laneSet id="W5065_LaneSet3">
        <bpmn:lane id="W5065_Lane1" name="Store Associate">
        <bpmn:flowNodeRef>W5065_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5065_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5065_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5065_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W5065_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5065_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5065_Start4" name="Customer exchange request at store/counter">
        <bpmn:outgoing>W5065_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5065_Task5" name="Intake the empty &amp; validate: inspect the customer&#x27;s empty cylinder…">
        <bpmn:documentation>Step 1: Intake the empty &amp; validate: inspect the customer&#x27;s empty cylinder (size/condition/brand per interchange policy W5059), scan the cylinder ID (VS-151), and confirm exchange eligibility (not condemned — W5069)
Responsible (R): Store Associate / Cage Associate
Accountable (A): Store Services Lead
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5065_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5065_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5065_Task6" name="Exchange &amp; charge: swap empty-for-full at the cage, process the exchange fee at…">
        <bpmn:documentation>Step 2: Exchange &amp; charge: swap empty-for-full at the cage, process the exchange fee at POS (price W5062), handle the deposit differential, and capture the full-cylinder ID out / empty-cylinder ID in
Responsible (R): Cashier / Cage Associate
Accountable (A): Store Services Lead
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5065_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5065_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5065_Task7" name="Customer handoff &amp; safety: brief the customer on safe transport/storage (no…">
        <bpmn:documentation>Step 3: Customer handoff &amp; safety: brief the customer on safe transport/storage (no enclosed vehicle cabin, upright, away from heat), issue receipt, and update cage inventory (W5067)
Responsible (R): Store Associate
Accountable (A): Store Services Lead
Duration: Per transaction</bpmn:documentation>
        <bpmn:incoming>W5065_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5065_End8" name="Complete">
        <bpmn:incoming>W5065_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5065_Annotation9">
        <bpmn:text>Controls: - CTL-756 (ensure controlled execution — Cylinder Exchange &amp; Refill Operations (PA-175.2).) | - CTL-756: empty-cylinder intake-inspected (W5069); deposit differential POS-controlled; cylinder IDs scanned (VS-151)
Owner: Store Services Lead / Cashier (VS-08)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5065_Assoc10" sourceRef="W5065_Annotation9" targetRef="W5065_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5065_Flow11" sourceRef="W5065_Start4" targetRef="W5065_Task5" />
      <bpmn:sequenceFlow id="W5065_Flow12" sourceRef="W5065_Task5" targetRef="W5065_Task6" />
      <bpmn:sequenceFlow id="W5065_Flow13" sourceRef="W5065_Task6" targetRef="W5065_Task7" />
      <bpmn:sequenceFlow id="W5065_Flow14" sourceRef="W5065_Task7" targetRef="W5065_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W5065_diag">
      <bpmndi:BPMNPlane id="W5065_plane" bpmnElement="W_W5065">
        <bpmndi:BPMNShape id="W5065_Lane1_di" bpmnElement="W5065_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W5065_Lane2_di" bpmnElement="W5065_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
