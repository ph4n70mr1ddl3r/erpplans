    <bpmn:process id="W_W5068" name="W5068. Customer-Owned-Cylinder Refill Service (Weigh, Fill, Seal, Charge)" isExecutable="false">
      <bpmn:documentation>Trigger: Customer brings own cylinder for refill (not exchange)
Frequency: Continuous; demand-driven
Volume: ~1,000–5,000 refills/week at maturity
Owner: Store Services Lead / Cage Associate
Participants: Cage Associate, Cashier (VS-08), Metrology/Calibration (VS-115), HSE (VS-24)
Source: workflow W5068 — Customer-Owned-Cylinder Refill Service (Weigh, Fill, Seal, Charge)</bpmn:documentation>
      <bpmn:laneSet id="W5068_LaneSet3">
        <bpmn:lane id="W5068_Lane1" name="Cage Associate">
        <bpmn:flowNodeRef>W5068_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5068_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5068_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5068_Lane2" name="Cashier">
        <bpmn:flowNodeRef>W5068_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5068_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5068_Start4" name="Customer brings own cylinder for refill (not exchange)">
        <bpmn:outgoing>W5068_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5068_Task5" name="Intake &amp; inspect the customer cylinder: confirm ownership/condition, check…">
        <bpmn:documentation>Step 1: Intake &amp; inspect the customer cylinder: confirm ownership/condition, check re-qual/expiry &amp; valve safety (condemn if unsafe — W5069), and weigh tare/empty
Responsible (R): Cage Associate / HSE
Accountable (A): Store Services Lead
Duration: Per refill</bpmn:documentation>
        <bpmn:incoming>W5068_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5068_Flow11</bpmn:outgoing>
      </bpmn:userTask>
