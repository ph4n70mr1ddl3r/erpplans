        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5079_Start4" name="Planning cycle; seasonality (summer grilling, holidays, typhoon/post-disaster VS-69)…">
        <bpmn:outgoing>W5079_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5079_Task5" name="Forecast demand: model exchange/refill seasonality (summer grilling, holidays…">
        <bpmn:documentation>Step 1: Forecast demand: model exchange/refill seasonality (summer grilling, holidays, camping, post-disaster VS-69), appliance-sale linkage (grill/heater), and external drivers
Responsible (R): Analytics / Supply Planning
Accountable (A): Category Mgr
Duration: Monthly/Quarterly</bpmn:documentation>
        <bpmn:incoming>W5079_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5079_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5079_Task6" name="Plan supply &amp; fleet: translate forecast to bulk supply (W5058), cylinder-pool…">
        <bpmn:documentation>Step 2: Plan supply &amp; fleet: translate forecast to bulk supply (W5058), cylinder-pool positioning (W5070), and refill-vendor capacity
Responsible (R): Supply Planning / Logistics
Accountable (A): Category Mgr
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W5079_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5079_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5079_Task7" name="Prevent stock-out &amp; reconcile: monitor actual vs forecast, feed replenishment…">
        <bpmn:documentation>Step 3: Prevent stock-out &amp; reconcile: monitor actual vs forecast, feed replenishment min-max (W5067/W5070), and S&amp;OP (VS-127) where LPG is a constraint
Responsible (R): Analytics / Supply Planning / FP&amp;A
Accountable (A): Category Mgr
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5079_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5079_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5079_End8" name="Complete">
        <bpmn:incoming>W5079_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5079_Annotation9">
