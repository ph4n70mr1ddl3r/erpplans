      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W5075" name="W5075. LPG Incident, Leak, Fire &amp; Emergency Response &amp; Reporting (DOLE/BFP/DOE)" isExecutable="false">
      <bpmn:documentation>Trigger: Leak/fire/explosion/injury incident
Frequency: Event-driven (rare but high-severity)
Volume: ~few incidents/year target (zero tolerance)
Owner: HSE Manager (VS-24) / Store Manager
Participants: HSE (VS-24), Security/LP (VS-23/VS-159), Store Manager, BC/DR (VS-26), Legal (VS-100), Facilities (VS-138), authorities (BFP/DOLE/DOE)
Source: workflow W5075 — LPG Incident, Leak, Fire &amp; Emergency Response &amp; Reporting (DOLE/BFP/DOE)</bpmn:documentation>
      <bpmn:laneSet id="W5075_LaneSet3">
        <bpmn:lane id="W5075_Lane1" name="Store Mgr">
        <bpmn:flowNodeRef>W5075_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5075_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5075_Lane2" name="HSE">
        <bpmn:flowNodeRef>W5075_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5075_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5075_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5075_Start4" name="Leak/fire/explosion/injury incident">
        <bpmn:outgoing>W5075_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5075_Task5" name="Respond &amp; contain: execute the emergency plan (W5064) — isolate/vent, evacuate…">
        <bpmn:documentation>Step 1: Respond &amp; contain: execute the emergency plan (W5064) — isolate/vent, evacuate, suppress (if safe), secure the scene, and call BFP/medical as needed
Responsible (R): Store Mgr / HSE / Security
Accountable (A): HSE Manager / Store Manager
Duration: Immediate</bpmn:documentation>
        <bpmn:incoming>W5075_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5075_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5075_Task6" name="Report to authorities: BFP (fire), DOLE/OSH (workplace injury), DOE (LPG…">
        <bpmn:documentation>Step 2: Report to authorities: BFP (fire), DOLE/OSH (workplace injury), DOE (LPG incident), LGU, and insurer (VS-26), within statutory deadlines (links VS-22/VS-166)
Responsible (R): HSE / Legal / Compliance
Accountable (A): HSE Manager / Compliance Officer
Duration: Per regulation</bpmn:documentation>
        <bpmn:incoming>W5075_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5075_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5075_Task7" name="Investigate, remedy &amp; learn: root-cause (links VS-24/VS-133), corrective…">
        <bpmn:documentation>Step 3: Investigate, remedy &amp; learn: root-cause (links VS-24/VS-133), corrective action, insurance claim (VS-26), record retention (VS-88), and distribution of lessons (W5064)
Responsible (R): HSE / Internal Audit / Legal
Accountable (A): HSE Manager
Duration: Post-incident</bpmn:documentation>
        <bpmn:incoming>W5075_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5075_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5075_End8" name="Complete">
        <bpmn:incoming>W5075_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5075_Annotation9">
        <bpmn:text>Controls: - CTL-757 (ensure controlled execution — LPG Safety, Compliance, Cylinder Reconciliation &amp; Analytics (PA-175.3).) | - CTL-757: emergency plan executed &amp; tested (W5064); authority reporting within deadlines (VS-22); incident investigated &amp; remedied (VS-133/VS-24); records retained (VS-88)
Owner: HSE Manager (VS-24) / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5075_Assoc10" sourceRef="W5075_Annotation9" targetRef="W5075_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5075_Flow11" sourceRef="W5075_Start4" targetRef="W5075_Task5" />
      <bpmn:sequenceFlow id="W5075_Flow12" sourceRef="W5075_Task5" targetRef="W5075_Task6" />
      <bpmn:sequenceFlow id="W5075_Flow13" sourceRef="W5075_Task6" targetRef="W5075_Task7" />
      <bpmn:sequenceFlow id="W5075_Flow14" sourceRef="W5075_Task7" targetRef="W5075_End8" />
    </bpmn:process>
