    <bpmn:process id="W_W5074" name="W5074. Cylinder Inventory Reconciliation, Shrink &amp; Deposit/Float Accounting" isExecutable="false">
      <bpmn:documentation>Trigger: Daily/weekly/monthly reconciliation cycle
Frequency: Daily/weekly/monthly
Volume: ~all stores × cylinder/deposit reconciliation
Owner: Inventory/O2C (VS-05/VS-16) / Store Manager
Participants: Inventory (VS-05), O2C (VS-16), Cage Associate, FP&amp;A (VS-17.4), LP (VS-23)
Source: workflow W5074 — Cylinder Inventory Reconciliation, Shrink &amp; Deposit/Float Accounting</bpmn:documentation>
      <bpmn:laneSet id="W5074_LaneSet3">
        <bpmn:lane id="W5074_Lane1" name="Cage Associate">
        <bpmn:flowNodeRef>W5074_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5074_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5074_Lane2" name="O2C">
        <bpmn:flowNodeRef>W5074_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5074_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5074_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5074_Start4" name="Daily/weekly/monthly reconciliation cycle">
        <bpmn:outgoing>W5074_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5074_Task5" name="Reconcile cylinder inventory: scan-count full/empty/quarantined cylinders vs…">
        <bpmn:documentation>Step 1: Reconcile cylinder inventory: scan-count full/empty/quarantined cylinders vs system (VS-151), investigate variances, and flag shrink (theft/loss) to LP (VS-23)
Responsible (R): Cage Associate / Inventory / LP
Accountable (A): Store Manager / Inventory Mgr
Duration: Weekly/Monthly</bpmn:documentation>
        <bpmn:incoming>W5074_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5074_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5074_Task6" name="Reconcile cash &amp; deposit float: exchange/refill cash vs POS (VS-08/VS-16)…">
        <bpmn:documentation>Step 2: Reconcile cash &amp; deposit float: exchange/refill cash vs POS (VS-08/VS-16), deposit-collected vs -refunded, and the cash-chain integrity (links VS-142)
Responsible (R): O2C / Cashier / LP
Accountable (A): O2C Manager
Duration: Daily/Monthly</bpmn:documentation>
        <bpmn:incoming>W5074_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5074_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5074_Task7" name="Report &amp; reserve: shrink/variance reporting, deposit-float GL reconciliation…">
        <bpmn:documentation>Step 3: Report &amp; reserve: shrink/variance reporting, deposit-float GL reconciliation (VS-17), bad-debt/shrink provision, and FP&amp;A analytics (VS-17.4)
Responsible (R): O2C / FP&amp;A / Inventory
Accountable (A): O2C Manager / FP&amp;A
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5074_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5074_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5074_End8" name="Complete">
        <bpmn:incoming>W5074_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5074_Annotation9">
        <bpmn:text>Controls: - CTL-100 (ensure LPG cylinder safety &amp; deposit accounting.) | - CTL-757: cylinder inventory reconciled (VS-151/VS-05); cash-chain controls (VS-142); deposit-float GL-reconciled (VS-17); shrink provisioned
Owner: Inventory/O2C (VS-05/VS-16) / Store Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5074_Assoc10" sourceRef="W5074_Annotation9" targetRef="W5074_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5074_Flow11" sourceRef="W5074_Start4" targetRef="W5074_Task5" />
      <bpmn:sequenceFlow id="W5074_Flow12" sourceRef="W5074_Task5" targetRef="W5074_Task6" />
      <bpmn:sequenceFlow id="W5074_Flow13" sourceRef="W5074_Task6" targetRef="W5074_Task7" />
      <bpmn:sequenceFlow id="W5074_Flow14" sourceRef="W5074_Task7" targetRef="W5074_End8" />
    </bpmn:process>
