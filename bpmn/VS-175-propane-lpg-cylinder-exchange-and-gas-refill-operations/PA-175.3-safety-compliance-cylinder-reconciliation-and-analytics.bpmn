    <bpmn:process id="W_W5073" name="W5073. LPG Daily Safety Inspection, Leak Detection &amp; BFP Fire-Code Compliance" isExecutable="false">
      <bpmn:documentation>Trigger: Daily cage cycle (W5067); incident
Frequency: Daily + continuous
Volume: ~200 stores × daily inspection
Owner: Cage Associate / HSE (VS-24)
Participants: Cage Associate, HSE (VS-24), Store Manager, Facilities (VS-138), BFP/fire consultant
Source: workflow W5073 — LPG Daily Safety Inspection, Leak Detection &amp; BFP Fire-Code Compliance</bpmn:documentation>
      <bpmn:laneSet id="W5073_LaneSet3">
        <bpmn:lane id="W5073_Lane1" name="Cage Associate">
        <bpmn:flowNodeRef>W5073_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5073_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5073_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5073_Lane2" name="HSE">
        <bpmn:flowNodeRef>W5073_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5073_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5073_Start4" name="Daily cage cycle (W5067); incident">
        <bpmn:outgoing>W5073_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5073_Task5" name="Daily leak &amp; condition inspection: sniff/soap-test/detector check on full…">
        <bpmn:documentation>Step 1: Daily leak &amp; condition inspection: sniff/soap-test/detector check on full cylinders &amp; valves, cage condition (ventilation, signage, max-cylinder limit W5061), and detection-alarm function
Responsible (R): Cage Associate / HSE
Accountable (A): Store Manager / HSE Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5073_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5073_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5073_Task6" name="Verify BFP fire-code compliance: extinguisher/suppression readiness, egress…">
        <bpmn:documentation>Step 2: Verify BFP fire-code compliance: extinguisher/suppression readiness, egress, ignition-control (no-smoking signage), FSIC currency (VS-166), and cage/yard integrity
Responsible (R): HSE / Facilities
Accountable (A): HSE Manager
Duration: Daily + periodic</bpmn:documentation>
        <bpmn:incoming>W5073_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5073_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5073_Task7" name="Log &amp; escalate: inspection log, flag any defect for condemnation (W5069) or…">
        <bpmn:documentation>Step 3: Log &amp; escalate: inspection log, flag any defect for condemnation (W5069) or maintenance (VS-138), and escalate leaks/incidents to emergency response (W5075)
Responsible (R): Cage Associate / HSE
Accountable (A): Store Manager
Duration: Daily</bpmn:documentation>
        <bpmn:incoming>W5073_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5073_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5073_End8" name="Complete">
        <bpmn:incoming>W5073_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5073_Annotation9">
        <bpmn:text>Controls: - CTL-100 (ensure LPG cylinder safety &amp; deposit accounting.) | - CTL-757: daily inspection logged (VS-24); FSIC current (VS-166); max-cylinder limit enforced; detection-alarm functional
Owner: Cage Associate / HSE (VS-24)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5073_Assoc10" sourceRef="W5073_Annotation9" targetRef="W5073_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5073_Flow11" sourceRef="W5073_Start4" targetRef="W5073_Task5" />
      <bpmn:sequenceFlow id="W5073_Flow12" sourceRef="W5073_Task5" targetRef="W5073_Task6" />
      <bpmn:sequenceFlow id="W5073_Flow13" sourceRef="W5073_Task6" targetRef="W5073_Task7" />
      <bpmn:sequenceFlow id="W5073_Flow14" sourceRef="W5073_Task7" targetRef="W5073_End8" />
    </bpmn:process>
