    <bpmn:process id="W_W5079" name="W5079. LPG Customer Demand Seasonality, Forecasting &amp; Stock-Out Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Planning cycle; seasonality (summer grilling, holidays, typhoon/post-disaster VS-69); replenishment
Frequency: Monthly/quarterly forecast
Volume: ~200 stores × forecast
Owner: Analytics/Supply (VS-28/VS-02) / Category Manager
Participants: Analytics (VS-28), Supply Planning (VS-02), Logistics (VS-06), Marketing (VS-14), S&amp;OP (VS-127)
Source: workflow W5079 — LPG Customer Demand Seasonality, Forecasting &amp; Stock-Out Prevention</bpmn:documentation>
      <bpmn:laneSet id="W5079_LaneSet3">
        <bpmn:lane id="W5079_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W5079_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5079_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5079_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5079_Lane2" name="Supply Planning">
        <bpmn:flowNodeRef>W5079_Task6</bpmn:flowNodeRef>
