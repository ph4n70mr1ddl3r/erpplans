        <bpmn:outgoing>W5078_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5078_Task4" name="Build the cylinder-pool KPIs: cylinder turn (cycles/unit/yr), refill yield…">
        <bpmn:documentation>Step 1: Build the cylinder-pool KPIs: cylinder turn (cycles/unit/yr), refill yield (gas-filled vs purchased), utilization (active vs idle), condemnation rate, and shrink/loss rate
Responsible (R): Analytics / Logistics / Inventory
Accountable (A): Category Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5078_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5078_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5078_Task5" name="Diagnose: under-utilized cylinders (capital-tie-up), refill-yield loss…">
        <bpmn:documentation>Step 2: Diagnose: under-utilized cylinders (capital-tie-up), refill-yield loss (under-fill/theft), high condemnation (vendor quality), and leak-rate (safety — links W5075)
Responsible (R): Analytics / HSE / Logistics
Accountable (A): Category Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5078_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5078_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5078_Task6" name="Drive action: fleet right-sizing (W5059/W5060), refill-yield recovery…">
        <bpmn:documentation>Step 3: Drive action: fleet right-sizing (W5059/W5060), refill-yield recovery, vendor-quality corrective (VS-67), and safety improvement (W5064)
Responsible (R): Analytics / Category Mgr / Logistics
Accountable (A): Category Mgr
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5078_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5078_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5078_End7" name="Complete">
        <bpmn:incoming>W5078_Flow13</bpmn:incoming>
      </bpmn:endEvent>
