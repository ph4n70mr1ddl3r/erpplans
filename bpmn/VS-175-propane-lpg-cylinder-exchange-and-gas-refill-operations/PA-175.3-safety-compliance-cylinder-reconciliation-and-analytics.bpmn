        <bpmn:lane id="W5078_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W5078_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5078_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5078_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5078_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5078_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
