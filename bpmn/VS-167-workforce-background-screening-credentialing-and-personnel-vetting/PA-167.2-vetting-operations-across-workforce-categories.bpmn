        <bpmndi:BPMNEdge id="W4874_Flow11_di" bpmnElement="W4874_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4874_Flow12_di" bpmnElement="W4874_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4874_Flow13_di" bpmnElement="W4874_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4874_Assoc9_di" bpmnElement="W4874_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4875" name="W4875. Vendor &amp; 3PL Personnel Site-Access Vetting (Drivers, Delivery, Service)" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor/3PL personnel granted site access (delivery drivers VS-56/VS-110, service technicians, installers VS-12); partner onboarding
Frequency: Per personnel + periodic
Volume: ~600–1,200 vendor/3PL personnel across 200 stores + 4 DCs (per VS-98)
Owner: Screening Program Manager / Procurement (VS-03/VS-34) / Store/DC Ops
Participants: Vendors/3PLs (VS-56/VS-110), Security (VS-159), Legal (VS-100.3), LP (VS-23)
Source: workflow W4875 — Vendor &amp; 3PL Personnel Site-Access Vetting (Drivers, Delivery, Service)</bpmn:documentation>
      <bpmn:laneSet id="W4875_LaneSet3">
        <bpmn:lane id="W4875_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4875_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4875_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4875_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4875_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4875_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4875_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4875_Start4" name="Vendor/3PL personnel granted site access (delivery drivers VS-56/VS-110, service…">
        <bpmn:outgoing>W4875_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4875_Task5" name="Define the site-access vetting standard for vendor/3PL personnel: identity…">
        <bpmn:documentation>Step 1: Define the site-access vetting standard for vendor/3PL personnel: identity verification, driver-license check (links to W1400/W4754 driver-license verification), NBI/basic screening for recurring-site-access roles (delivery, service, installation), and the access-control integration (badging, escorts)
Responsible (R): Screening Program Manager / Security / Procurement
Accountable (A): VP Legal &amp; Compliance / Chief Compliance &amp; Security Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4875_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4875_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4875_Task6" name="Flow the standard into vendor/3PL contracts (VS-56/VS-110/VS-100.3): the…">
        <bpmn:documentation>Step 2: Flow the standard into vendor/3PL contracts (VS-56/VS-110/VS-100.3): the partner certifies its personnel are vetted per the standard, BuildRight verifies (sample/license-authenticity), and access is granted only to cleared personnel; manage exceptions (one-time vs recurring access)
Responsible (R): Procurement / Legal / Screening Program Manager / Security
Accountable (A): VP Legal &amp; Compliance
Duration: Per partner + continuous</bpmn:documentation>
        <bpmn:incoming>W4875_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4875_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4875_Task7" name="Monitor &amp; enforce: track cleared-personnel rosters, revoke access on personnel…">
        <bpmn:documentation>Step 3: Monitor &amp; enforce: track cleared-personnel rosters, revoke access on personnel change, audit partner compliance, and feed vendor-screening compliance to TPRM (VS-161) and analytics (W4881); manage any incident involving vendor personnel (links to VS-23/VS-159)
Responsible (R): Screening Program Manager / Security / TPRM / Store Ops
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4875_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4875_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4875_End8" name="Complete">
        <bpmn:incoming>W4875_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4875_Annotation9">
        <bpmn:text>Controls: - CTL-732 (ensure controlled execution — Vetting Operations Across Workforce Categories (PA-167.2).) | - CTL-732: site-access vetting standard; partner contract flow-down; access only for cleared personnel; rosters current
Owner: Screening Program Manager / Procurement (VS-03/VS-34) / Store/DC Ops</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4875_Assoc10" sourceRef="W4875_Annotation9" targetRef="W4875_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4875_Flow11" sourceRef="W4875_Start4" targetRef="W4875_Task5" />
      <bpmn:sequenceFlow id="W4875_Flow12" sourceRef="W4875_Task5" targetRef="W4875_Task6" />
      <bpmn:sequenceFlow id="W4875_Flow13" sourceRef="W4875_Task6" targetRef="W4875_Task7" />
      <bpmn:sequenceFlow id="W4875_Flow14" sourceRef="W4875_Task7" targetRef="W4875_End8" />
    </bpmn:process>
