<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-167.2-vetting-operations-across-workforce-categories" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4873" name="W4873. Employee Pre-Hire Screening Integration &amp; Offer-Conditional Workflow" isExecutable="false">
      <bpmn:documentation>Trigger: Candidate selection (VS-121); offer-conditional on screening clearance
Frequency: Per hire (~1,200–1,600 hires/yr)
Volume: ~1,200–1,600 employee screens/yr
Owner: Screening Program Manager / Talent Acquisition (VS-121)
Participants: HR (VS-19), Hiring Manager, Screening vendor (W4867), Legal (VS-100.3), Adverse-Action Board (W4871)
Source: workflow W4873 — Employee Pre-Hire Screening Integration &amp; Offer-Conditional Workflow</bpmn:documentation>
      <bpmn:laneSet id="W4873_LaneSet3">
        <bpmn:lane id="W4873_Lane1" name="Talent Acquisition">
        <bpmn:flowNodeRef>W4873_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4873_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4873_Lane2" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4873_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4873_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4873_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4873_Start4" name="Candidate selection (VS-121); offer-conditional on screening clearance">
        <bpmn:outgoing>W4873_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4873_Task5" name="On candidate selection, trigger the screening order from the ATS/HRIS (VS-121)…">
        <bpmn:documentation>Step 1: On candidate selection, trigger the screening order from the ATS/HRIS (VS-121): capture consent (W4868), determine the role-package (W4866/W4869), and order the package from the screening vendor; structure the offer as conditional-on-screening-clearance for sensitive roles
Responsible (R): Talent Acquisition / Screening Program Manager
Accountable (A): Hiring Manager / HR
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W4873_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4873_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4873_Task6" name="Execute &amp; verify: vendor runs the package (NBI/employment/etc.), Screening…">
        <bpmn:documentation>Step 2: Execute &amp; verify: vendor runs the package (NBI/employment/etc.), Screening verifies authenticity and the chain-of-custody (W4870); track TAT against the SLA; for clear results, clear for hire; for adverse findings, route to the Adverse-Action Board (W4871/W4880)
Responsible (R): Screening Program Manager / Vendor
Accountable (A): Screening Program Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W4873_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4873_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4873_Task7" name="Record in the HRIS/worker record (VS-19/VS-29), file the evidence (W4872), set…">
        <bpmn:documentation>Step 3: Record in the HRIS/worker record (VS-19/VS-29), file the evidence (W4872), set the re-screening schedule (W4877), and feed screening metrics to analytics (W4881); for adverse outcomes, manage the candidate per the fair-chance framework (W4880)
Responsible (R): Screening Program Manager / HR / Records
Accountable (A): Screening Program Manager
Duration: Per hire</bpmn:documentation>
        <bpmn:incoming>W4873_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4873_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4873_End8" name="Complete">
        <bpmn:incoming>W4873_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4873_Annotation9">
        <bpmn:text>Controls: - CTL-732 (ensure controlled execution — Vetting Operations Across Workforce Categories (PA-167.2).) | - CTL-732: consent before order; sensitive roles offer-conditional; chain-of-custody; recorded in HRIS
Owner: Screening Program Manager / Talent Acquisition (VS-121)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4873_Assoc10" sourceRef="W4873_Annotation9" targetRef="W4873_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4873_Flow11" sourceRef="W4873_Start4" targetRef="W4873_Task5" />
      <bpmn:sequenceFlow id="W4873_Flow12" sourceRef="W4873_Task5" targetRef="W4873_Task6" />
      <bpmn:sequenceFlow id="W4873_Flow13" sourceRef="W4873_Task6" targetRef="W4873_Task7" />
      <bpmn:sequenceFlow id="W4873_Flow14" sourceRef="W4873_Task7" targetRef="W4873_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4873_diag">
      <bpmndi:BPMNPlane id="W4873_plane" bpmnElement="W_W4873">
        <bpmndi:BPMNShape id="W4873_Lane1_di" bpmnElement="W4873_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
