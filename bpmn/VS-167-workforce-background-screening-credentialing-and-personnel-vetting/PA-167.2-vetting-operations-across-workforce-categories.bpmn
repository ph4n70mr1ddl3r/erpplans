      <bpmn:startEvent id="W4879_Start4" name="Screening package includes drug/health/license checks (W4869); safety-sensitive role">
        <bpmn:outgoing>W4879_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4879_Task5" name="Integrate drug-test (VS-150), occupational-health (VS-83), and license checks…">
        <bpmn:documentation>Step 1: Integrate drug-test (VS-150), occupational-health (VS-83), and license checks (driver W1400/W4754, PRC/TESDA W600/W558) into the screening package for relevant roles (drivers, forklift/reach operators, paint/chemical handlers, security, PRC-licensed engineers); define the integrated package per role
Responsible (R): Screening Program Manager / Occupational Health / Drug-Free Officer
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per role-type</bpmn:documentation>
        <bpmn:incoming>W4879_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4879_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4879_Task6" name="Execute via the clinic (VS-83) and the drug-free program (VS-150) with consent…">
        <bpmn:documentation>Step 2: Execute via the clinic (VS-83) and the drug-free program (VS-150) with consent (W4868), lawful testing (DOLE D.O. 53-03 per VS-150), and license verification; manage results through the chain-of-custody (W4870)
Responsible (R): Occupational Health / Drug-Free Officer / Screening Program Manager
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per screen</bpmn:documentation>
        <bpmn:incoming>W4879_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4879_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4879_Task7" name="Manage adverse health/drug/license findings via the Adverse-Action Board…">
        <bpmn:documentation>Step 3: Manage adverse health/drug/license findings via the Adverse-Action Board (W4871/W4880) with due process (VS-150 substance-abuse due process, VS-84 NLRC); ensure safety-sensitive roles are not placed without clearance; feed integrated-screening metrics to analytics (W4881)
Responsible (R): Screening Program Manager / Drug-Free Officer / Legal
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per finding</bpmn:documentation>
        <bpmn:incoming>W4879_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4879_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4879_End8" name="Complete">
        <bpmn:incoming>W4879_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4879_Annotation9">
        <bpmn:text>Controls: - CTL-131 (ensure lawful &amp; consented personnel vetting.) | - CTL-732: drug/health/license checks per safety-sensitive role; lawful testing; clearance gate; due process
Owner: Screening Program Manager / Occupational Health (VS-83) / Drug-Free Program (VS-150)</bpmn:text>
      </bpmn:textAnnotation>
