      <bpmndi:BPMNPlane id="W4875_plane" bpmnElement="W_W4875">
        <bpmndi:BPMNShape id="W4875_Lane1_di" bpmnElement="W4875_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Lane2_di" bpmnElement="W4875_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Task5_di" bpmnElement="W4875_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Task6_di" bpmnElement="W4875_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Task7_di" bpmnElement="W4875_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Start4_di" bpmnElement="W4875_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_End8_di" bpmnElement="W4875_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4875_Annotation9_di" bpmnElement="W4875_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4875_Flow11_di" bpmnElement="W4875_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4875_Flow12_di" bpmnElement="W4875_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4875_Flow13_di" bpmnElement="W4875_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4875_Flow14_di" bpmnElement="W4875_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4875_Assoc10_di" bpmnElement="W4875_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4876" name="W4876. Executive &amp; Sensitive-Role Enhanced Vetting" isExecutable="false">
      <bpmn:documentation>Trigger: Executive/sensitive-role hire/appointment (CEO/CFO/CIO/IT Security Manager, finance/treasury, security/CIT, IT-admin/data, buyer/procurement); periodic re-vet
Frequency: Per appointment + periodic re-vet
Volume: ~30–60 executives + sensitive roles
Owner: Screening Program Manager / Corporate Security (VS-159) / Legal (VS-100.3)
Participants: CHRO, Board/ nominating (VS-36), External counsel/vetting firm, DPO (VS-91)
Source: workflow W4876 — Executive &amp; Sensitive-Role Enhanced Vetting</bpmn:documentation>
      <bpmn:laneSet id="W4876_LaneSet3">
        <bpmn:lane id="W4876_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4876_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4876_Task7</bpmn:flowNodeRef>
