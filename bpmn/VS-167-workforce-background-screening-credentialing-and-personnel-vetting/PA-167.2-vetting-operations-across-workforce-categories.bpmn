    <bpmn:process id="W_W4879" name="W4879. Drug-Test, Health &amp; License-Check Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Screening package includes drug/health/license checks (W4869); safety-sensitive role
Frequency: Per screen + periodic
Volume: ~2,000–3,000 safety-sensitive staff (drivers, forklift, paint/chemical handlers, security)
Owner: Screening Program Manager / Occupational Health (VS-83) / Drug-Free Program (VS-150)
Participants: Clinic (VS-83), Drug-Free Officer (VS-150), Fleet/Driver (VS-06/W1400), Legal (VS-100.3)
Source: workflow W4879 — Drug-Test, Health &amp; License-Check Integration</bpmn:documentation>
      <bpmn:laneSet id="W4879_LaneSet3">
        <bpmn:lane id="W4879_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4879_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4879_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4879_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
