    <bpmn:process id="W_W4874" name="W4874. Contingent/Outsourced Worker Screening Governance &amp; Agency Accountability" isExecutable="false">
      <bpmn:documentation>Trigger: Contractor/outsourced-worker assignment (before site entry) (VS-98); agency onboarding
Frequency: Per worker assignment (~10–20% of store/DC labor)
Volume: ~600–1,200 contingent workers across 200 stores + 4 DCs (security, janitorial, promodizers, agency labor; ~10–20% of site labor per VS-98)
Owner: Screening Program Manager / Contingent Workforce Coordinator (VS-98)
Participants: Agencies (VS-98), Security (VS-159), Legal (VS-100.3), LP (VS-23)
Source: workflow W4874 — Contingent/Outsourced Worker Screening Governance &amp; Agency Accountability</bpmn:documentation>
      <bpmn:laneSet id="W4874_LaneSet2">
        <bpmn:lane id="W4874_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4874_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4874_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4874_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4874_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4874_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4874_Start3" name="Contractor/outsourced-worker assignment (before site entry) (VS-98); agency onboarding">
        <bpmn:outgoing>W4874_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4874_Task4" name="Govern the agency screening obligation (extends W3223): each agency certifies…">
        <bpmn:documentation>Step 1: Govern the agency screening obligation (extends W3223): each agency certifies pre-engagement screening per BuildRight&#x27;s role-package (cash-handling, security, child-adjacent critical), with BuildRight-specified checks (NBI, police, prior-employment, drug where lawful, court for cash/security); flow the obligation into the agency contract (VS-98)
Responsible (R): Screening Program Manager / Contingent Coordinator / Legal / Procurement
Accountable (A): VP Legal &amp; Compliance / Contingent Workforce Mgr
Duration: Per agency + continuous</bpmn:documentation>
        <bpmn:incoming>W4874_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4874_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4874_Task5" name="Verify agency screening quality: BuildRight audits agency screening records…">
        <bpmn:documentation>Step 2: Verify agency screening quality: BuildRight audits agency screening records, verifies authenticity (NBI verification, sample re-check), and rejects uncertified workers; for high-risk roles (security, CIT VS-81, cash-handling, IT-admin) require enhanced screening + Security review (links to W3223/W4876)
Responsible (R): Screening Program Manager / Security / Contingent Coordinator
Accountable (A): Contingent Workforce Mgr
Duration: Continuous + per worker</bpmn:documentation>
        <bpmn:incoming>W4874_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4874_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4874_Task6" name="Manage re-screening (W4877), adverse-action (W4880), and records (W4872) for…">
        <bpmn:documentation>Step 3: Manage re-screening (W4877), adverse-action (W4880), and records (W4872) for contingent workers; ensure agency accountability for screening failures and feed screening-compliance to TPRM (VS-161), VS-98 governance, and analytics (W4881)
Responsible (R): Screening Program Manager / Contingent Coordinator / TPRM
Accountable (A): VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4874_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4874_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4874_End7" name="Complete">
        <bpmn:incoming>W4874_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4874_Annotation8">
        <bpmn:text>Controls: - CTL-131 (ensure lawful &amp; consented personnel vetting.) | - CTL-732: agency contract specifies screening; BuildRight audits; high-risk roles enhanced; failures attributed
Owner: Screening Program Manager / Contingent Workforce Coordinator (VS-98)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4874_Assoc9" sourceRef="W4874_Annotation8" targetRef="W4874_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4874_Flow10" sourceRef="W4874_Start3" targetRef="W4874_Task4" />
      <bpmn:sequenceFlow id="W4874_Flow11" sourceRef="W4874_Task4" targetRef="W4874_Task5" />
      <bpmn:sequenceFlow id="W4874_Flow12" sourceRef="W4874_Task5" targetRef="W4874_Task6" />
      <bpmn:sequenceFlow id="W4874_Flow13" sourceRef="W4874_Task6" targetRef="W4874_End7" />
    </bpmn:process>
