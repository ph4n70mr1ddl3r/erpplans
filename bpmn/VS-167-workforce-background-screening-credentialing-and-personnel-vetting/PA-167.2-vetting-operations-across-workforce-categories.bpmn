        <bpmndi:BPMNShape id="W4873_End8_di" bpmnElement="W4873_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4873_Annotation9_di" bpmnElement="W4873_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
