      <bpmndi:BPMNPlane id="W4874_plane" bpmnElement="W_W4874">
        <bpmndi:BPMNShape id="W4874_Lane1_di" bpmnElement="W4874_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
