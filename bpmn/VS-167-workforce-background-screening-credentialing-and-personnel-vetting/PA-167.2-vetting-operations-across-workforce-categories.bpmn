        <bpmn:outgoing>W4878_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4878_Task6" name="Handle transfers: when an employee transfers across entities or regions, verify…">
        <bpmn:documentation>Step 2: Handle transfers: when an employee transfers across entities or regions, verify prior screening meets the new role/entity standard, re-screen gaps, port the screening record (chain-of-custody W4870) with consent (W4868), and update the workforce roster (VS-29)
Responsible (R): HR Shared Services / Screening Program Manager
Accountable (A): CHRO
Duration: Per transfer</bpmn:documentation>
        <bpmn:incoming>W4878_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4878_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4878_Task7" name="Audit consistency: periodically audit entity/region screening for policy…">
        <bpmn:documentation>Step 3: Audit consistency: periodically audit entity/region screening for policy adherence and bias indicators (W4871); remediate inconsistencies; report consistency to governance (W4888) and analytics (W4881)
Responsible (R): Screening Program Manager / Internal Audit (VS-21) / HR Shared Services
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W4878_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4878_Flow14</bpmn:outgoing>
      </bpmn:userTask>
