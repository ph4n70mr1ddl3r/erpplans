      <bpmn:startEvent id="W4885_Start4" name="Annual budget; quarterly cost review; vendor consolidation; ROI justification">
        <bpmn:outgoing>W4885_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4885_Task5" name="Maintain the screening-cost ledger: vendor fees (W4867), agency screening costs…">
        <bpmn:documentation>Step 1: Maintain the screening-cost ledger: vendor fees (W4867), agency screening costs (VS-98), internal staffing, drug/health (VS-83/VS-150), and license-verification costs; reconcile to finance (VS-17) by category/role-tier
Responsible (R): Finance / Procurement / Screening Program Manager
Accountable (A): CHRO / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4885_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4885_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4885_Task6" name="Analyze cost &amp; ROI: cost-per-screen, cost-per-hire, vendor comparison…">
        <bpmn:documentation>Step 2: Analyze cost &amp; ROI: cost-per-screen, cost-per-hire, vendor comparison, consolidation opportunities, and the loss-avoided/loss-linked-to-screening-gaps (W4882) to justify the program; forecast spend
Responsible (R): Finance / Screening Program Manager / Analytics
Accountable (A): CHRO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4885_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4885_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4885_Task7" name="Drive cost optimization: consolidate vendors (W4867/W4884), negotiate volume…">
        <bpmn:documentation>Step 3: Drive cost optimization: consolidate vendors (W4867/W4884), negotiate volume pricing, automate (W4870/W4881), right-size packages (W4869 — avoid over-screening), and report cost/ROI to governance (W4888) and analytics (W4881)
Responsible (R): Screening Program Manager / Procurement / Finance
Accountable (A): CHRO / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4885_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4885_End8" name="Complete">
        <bpmn:incoming>W4885_Flow14</bpmn:incoming>
      </bpmn:endEvent>
