    <bpmn:process id="W_W4887" name="W4887. Internal Audit Coordination, Control Testing &amp; Compliance Assurance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual internal-audit plan (VS-21); regulator audit; assurance cycle
Frequency: Annual + on regulator audit
Volume: 1 assurance program
Owner: Screening Program Manager / Internal Audit (VS-21)
Participants: Legal (VS-100.3), DPO (VS-91), HR, Security (VS-159)
Source: workflow W4887 — Internal Audit Coordination, Control Testing &amp; Compliance Assurance</bpmn:documentation>
      <bpmn:laneSet id="W4887_LaneSet3">
        <bpmn:lane id="W4887_Lane1" name="Screening Program Manager">
