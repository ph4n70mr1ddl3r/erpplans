    <bpmn:process id="W_W4888" name="W4888. Program Maturity, Benchmarking &amp; Continuous Improvement" isExecutable="false">
      <bpmn:documentation>Trigger: Annual program review; maturity assessment; major incident (W4882); strategy refresh (W4865)
Frequency: Annual + on incident
Volume: 1 program
Owner: CHRO / Chief Compliance &amp; Security Officer / Screening Program Manager
Participants: Strategy (VS-33), Internal Audit (VS-21), OpEx (VS-133), HR, Security (VS-159)
Source: workflow W4888 — Program Maturity, Benchmarking &amp; Continuous Improvement</bpmn:documentation>
      <bpmn:laneSet id="W4888_LaneSet2">
        <bpmn:lane id="W4888_Lane1" name="Screening Program Manager">
        <bpmn:flowNodeRef>W4888_Task4</bpmn:flowNodeRef>
