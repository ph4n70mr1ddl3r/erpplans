        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4888_Start3" name="Annual program review; maturity assessment; major incident (W4882); strategy refresh…">
        <bpmn:outgoing>W4888_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4888_Task4" name="Assess program maturity across dimensions (coverage, package-design…">
        <bpmn:documentation>Step 1: Assess program maturity across dimensions (coverage, package-design, consent/privacy, chain-of-custody/evidence, re-screening/continuous-monitoring, vendor-governance, analytics/automation, governance) using a maturity model; benchmark vs industry/peer
Responsible (R): Screening Program Manager / Strategy / Internal Audit
Accountable (A): CHRO / Chief Compliance &amp; Security Officer
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4888_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4888_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4888_Task5" name="Drive improvement: prioritize initiatives (automation W4870/W4881, coverage…">
        <bpmn:documentation>Step 2: Drive improvement: prioritize initiatives (automation W4870/W4881, coverage expansion, package right-sizing, vendor consolidation), execute via OpEx (VS-133), and track benefit realization
Responsible (R): Screening Program Manager / OpEx / Strategy
Accountable (A): CHRO / Chief Compliance &amp; Security Officer
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4888_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4888_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4888_Task6" name="Report program maturity, metrics, and incidents (W4882) to the board/audit &amp;…">
        <bpmn:documentation>Step 3: Report program maturity, metrics, and incidents (W4882) to the board/audit &amp; risk committee (VS-36); capture emerging best-practice and feed to ERM (VS-21.2)
Responsible (R): Screening Program Manager / CHRO
Accountable (A): CHRO / Chief Compliance &amp; Security Officer / Board
Duration: Annual + quarterly</bpmn:documentation>
        <bpmn:incoming>W4888_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4888_End7" name="Complete">
        <bpmn:incoming>W4888_Flow13</bpmn:incoming>
      </bpmn:endEvent>
