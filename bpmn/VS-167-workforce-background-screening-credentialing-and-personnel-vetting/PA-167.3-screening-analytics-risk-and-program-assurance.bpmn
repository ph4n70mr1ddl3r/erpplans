      <bpmndi:BPMNPlane id="W4882_plane" bpmnElement="W_W4882">
        <bpmndi:BPMNShape id="W4882_Lane1_di" bpmnElement="W4882_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
