        <bpmndi:BPMNShape id="W4883_Lane1_di" bpmnElement="W4883_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4883_Lane2_di" bpmnElement="W4883_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
