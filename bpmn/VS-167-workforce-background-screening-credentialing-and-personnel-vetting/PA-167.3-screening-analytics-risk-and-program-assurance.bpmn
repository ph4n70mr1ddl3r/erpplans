      <bpmn:startEvent id="W4887_Start4" name="Annual internal-audit plan (VS-21); regulator audit; assurance cycle">
        <bpmn:outgoing>W4887_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4887_Task5" name="Coordinate the screening audit plan with Internal Audit (VS-21): risk-based…">
        <bpmn:documentation>Step 1: Coordinate the screening audit plan with Internal Audit (VS-21): risk-based coverage of consent (W4868), packages (W4869), chain-of-custody (W4870), adverse-action due process (W4880), retention (W4872), vendor governance (W4884), and coverage gaps (W4878); align with the internal-controls matrix
Responsible (R): Screening Program Manager / Internal Audit
Accountable (A): CHRO / VP Legal &amp; Compliance / Head of Internal Audit
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4887_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4887_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4887_Task6" name="Support control testing: walkthroughs, sample testing (consent-before-screen…">
        <bpmn:documentation>Step 2: Support control testing: walkthroughs, sample testing (consent-before-screen, package-completeness, adverse-action due-process, retention-disposal, vendor-DPA), and remediation of findings
Responsible (R): Internal Audit / Screening Program Manager / HR / DPO
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Per audit cycle</bpmn:documentation>
        <bpmn:incoming>W4887_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4887_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4887_Task7" name="Track audit-finding remediation to closure, report to the audit &amp; risk…">
        <bpmn:documentation>Step 3: Track audit-finding remediation to closure, report to the audit &amp; risk committee (VS-36), and feed findings to continuous improvement (W4888) and analytics (W4881)
Responsible (R): Screening Program Manager / Internal Audit
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4887_Flow13</bpmn:incoming>
      </bpmn:userTask>
