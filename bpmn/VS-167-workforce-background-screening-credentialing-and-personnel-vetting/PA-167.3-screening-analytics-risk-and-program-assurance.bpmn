    <bpmn:process id="W_W4885" name="W4885. Screening Cost &amp; ROI Analytics — Spend, Loss-Avoided, Vendor Consolidation" isExecutable="false">
      <bpmn:documentation>Trigger: Annual budget; quarterly cost review; vendor consolidation; ROI justification
Frequency: Quarterly + annual
Volume: Group screening spend
Owner: Screening Program Manager / Finance (VS-17.4) / Procurement (VS-03)
Participants: HR, TPRM (VS-161), Analytics (VS-28)
Source: workflow W4885 — Screening Cost &amp; ROI Analytics — Spend, Loss-Avoided, Vendor Consolidation</bpmn:documentation>
      <bpmn:laneSet id="W4885_LaneSet3">
        <bpmn:lane id="W4885_Lane1" name="Finance">
