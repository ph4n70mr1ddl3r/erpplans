<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-167.3-screening-analytics-risk-and-program-assurance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4881" name="W4881. Screening Operations Analytics — Volume, TAT, Hit-Rate, Vendor Performance" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly analytics cycle; vendor performance review (W4867); governance reporting
Frequency: Monthly + quarterly
Volume: Group screening operations
Owner: Screening Program Manager / Analytics (VS-28)
Participants: HR (VS-19/103), Procurement (VS-03), Contingent Coordinator (VS-98)
Source: workflow W4881 — Screening Operations Analytics — Volume, TAT, Hit-Rate, Vendor Performance</bpmn:documentation>
      <bpmn:laneSet id="W4881_LaneSet2">
        <bpmn:lane id="W4881_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4881_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4881_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4881_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4881_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4881_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4881_Start3" name="Monthly/quarterly analytics cycle; vendor performance review (W4867); governance reporting">
        <bpmn:outgoing>W4881_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4881_Task4" name="Build the screening-operations analytics suite: screening volume by category…">
        <bpmn:documentation>Step 1: Build the screening-operations analytics suite: screening volume by category (employee/contingent/vendor/executive) and role-tier, TAT by check-type/vendor, hit-rate (adverse findings) by check-type/role, re-screening currency, vendor performance (W4867), and cost (W4885)
Responsible (R): Analytics / Screening Program Manager
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4881_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4881_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4881_Task5" name="Analyze &amp; report: TAT vs SLA, bottleneck check-types, hit-rate trends (rising…">
        <bpmn:documentation>Step 2: Analyze &amp; report: TAT vs SLA, bottleneck check-types, hit-rate trends (rising criminal/sanctions hits?), vendor comparison, coverage gaps (unscreened categories/roles), and the adverse-action outcome mix (clear/conditional/disqualify)
Responsible (R): Analytics / Screening Program Manager / Procurement
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W4881_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4881_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4881_Task6" name="Feed insights to vendor governance (W4867/W4884), policy (W4866), resourcing…">
        <bpmn:documentation>Step 3: Feed insights to vendor governance (W4867/W4884), policy (W4866), resourcing, and continuous improvement (W4888); track action closure
Responsible (R): Analytics / Screening Program Manager
Accountable (A): CHRO / VP Legal &amp; Compliance
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4881_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4881_End7" name="Complete">
        <bpmn:incoming>W4881_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4881_Annotation8">
        <bpmn:text>Controls: - CTL-733 (ensure controlled execution — Screening Analytics, Risk &amp; Program Assurance (PA-167.3).) | - CTL-733: analytics reviewed quarterly; actions tracked to closure
Owner: Screening Program Manager / Analytics (VS-28)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4881_Assoc9" sourceRef="W4881_Annotation8" targetRef="W4881_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4881_Flow10" sourceRef="W4881_Start3" targetRef="W4881_Task4" />
      <bpmn:sequenceFlow id="W4881_Flow11" sourceRef="W4881_Task4" targetRef="W4881_Task5" />
      <bpmn:sequenceFlow id="W4881_Flow12" sourceRef="W4881_Task5" targetRef="W4881_Task6" />
      <bpmn:sequenceFlow id="W4881_Flow13" sourceRef="W4881_Task6" targetRef="W4881_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4881_diag">
