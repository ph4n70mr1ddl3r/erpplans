        <bpmndi:BPMNEdge id="W1958_Flow12_di" bpmnElement="W1958_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1958_Flow13_di" bpmnElement="W1958_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1958_Flow14_di" bpmnElement="W1958_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1958_Flow15_di" bpmnElement="W1958_Flow15"><di:waypoint x="1000" y="335" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1958_Flow16_di" bpmnElement="W1958_Flow16"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1958_Assoc11_di" bpmnElement="W1958_Assoc11"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1959" name="W1959. Government Shopping &amp; Small Value Procurement Quotation" isExecutable="false">
      <bpmn:documentation>Trigger: Government agency requests quotation for purchases below PHP 2M (shopping) or PHP 1M (small value)
Frequency: ~100–150 government quotations/year
Volume: ~PHP 50M–100M in annual shopping/small value sales
Owner: Trade Account Manager
Participants: Trade Account Manager, Pricing Analyst, Store Manager
Source: workflow W1959 — Government Shopping &amp; Small Value Procurement Quotation</bpmn:documentation>
      <bpmn:laneSet id="W1959_LaneSet3">
        <bpmn:lane id="W1959_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1959_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1959_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1959_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1959_Lane2" name="Store Manager">
        <bpmn:flowNodeRef>W1959_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1959_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1959_Start4" name="Government agency requests quotation for purchases below PHP 2M (shopping) or PHP 1M…">
        <bpmn:outgoing>W1959_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1959_Task5" name="Government procurement officer requests quotation: (a) verbal or written…">
        <bpmn:documentation>Step 1: Government procurement officer requests quotation: (a) verbal or written request with item list, quantities, delivery location, (b) shopping mode: agency canvasses at least 3 suppliers for each purchase, (c) small value procurement: simplified bidding for purchases below threshold
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per request</bpmn:documentation>
        <bpmn:incoming>W1959_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1959_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1959_Task6" name="Trade Account Manager prepares quotation: (a) real-time ATP check for each…">
        <bpmn:documentation>Step 2: Trade Account Manager prepares quotation: (a) real-time ATP check for each item, (b) pricing: standard government pricing tier or project-specific pricing, (c) delivery timeline and fee, (d) validity period: 30 days standard, (e) quotation formatted per BuildRight standard with TIN, business permit details
Responsible (R): Trade Account Manager / Pricing Analyst
Accountable (A): VP Store Operations
Duration: 1–2 days/quotation</bpmn:documentation>
        <bpmn:incoming>W1959_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1959_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1959_Task7" name="Store-level fulfillment for small orders: (a) if order can be fulfilled from a…">
        <bpmn:documentation>Step 3: Store-level fulfillment for small orders: (a) if order can be fulfilled from a single store: direct store pickup or delivery, (b) Store Manager processes as trade account sale at POS with government account pricing, (c) if order requires DC fulfillment: process as standard sales order with delivery
Responsible (R): Store Manager / Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W1959_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1959_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1959_End8" name="Complete">
        <bpmn:incoming>W1959_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1959_Annotation9">
        <bpmn:text>Controls: - CTL-191 (ensure B2G procurement compliance &amp; collection.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1959_Assoc10" sourceRef="W1959_Annotation9" targetRef="W1959_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1959_Flow11" sourceRef="W1959_Start4" targetRef="W1959_Task5" />
      <bpmn:sequenceFlow id="W1959_Flow12" sourceRef="W1959_Task5" targetRef="W1959_Task6" />
      <bpmn:sequenceFlow id="W1959_Flow13" sourceRef="W1959_Task6" targetRef="W1959_Task7" />
      <bpmn:sequenceFlow id="W1959_Flow14" sourceRef="W1959_Task7" targetRef="W1959_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1959_diag">
      <bpmndi:BPMNPlane id="W1959_plane" bpmnElement="W_W1959">
        <bpmndi:BPMNShape id="W1959_Lane1_di" bpmnElement="W1959_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1959_Lane2_di" bpmnElement="W1959_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1959_Task5_di" bpmnElement="W1959_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
