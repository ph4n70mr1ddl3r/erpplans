        <bpmndi:BPMNShape id="W1959_Task7_di" bpmnElement="W1959_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1959_Start4_di" bpmnElement="W1959_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1959_End8_di" bpmnElement="W1959_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1959_Annotation9_di" bpmnElement="W1959_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1959_Flow11_di" bpmnElement="W1959_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1959_Flow12_di" bpmnElement="W1959_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1959_Flow13_di" bpmnElement="W1959_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1959_Flow14_di" bpmnElement="W1959_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1959_Assoc10_di" bpmnElement="W1959_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1960" name="W1960. Government Negotiated Procurement &amp; Emergency Purchase Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Government agency invites BuildRight for negotiated procurement (highly technical, emergency, or repeat order)
Frequency: ~5–10 negotiated procurements/year
Volume: ~PHP 20M–50M in annual negotiated sales
Owner: VP Store Operations
Participants: VP Store Operations, Trade Account Manager, Category Manager, CFO
Source: workflow W1960 — Government Negotiated Procurement &amp; Emergency Purchase Processing</bpmn:documentation>
      <bpmn:laneSet id="W1960_LaneSet3">
        <bpmn:lane id="W1960_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1960_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1960_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1960_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1960_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1960_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1960_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1960_Start4" name="Government agency invites BuildRight for negotiated procurement (highly technical…">
        <bpmn:outgoing>W1960_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1960_Task5" name="VP Store Operations evaluates negotiated procurement opportunity: (a) verify…">
        <bpmn:documentation>Step 1: VP Store Operations evaluates negotiated procurement opportunity: (a) verify justification: is this a legitimate case for negotiated procurement per RA 9184?, (b) assess BuildRight&#x27;s position: is BuildRight the only supplier or one of few?, (c) pricing strategy: negotiated procurement allows direct negotiation — target higher margin than competitive bidding
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1960_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1960_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1960_Task6" name="Negotiation: (a) Trade Account Manager represents BuildRight in negotiation…">
        <bpmn:documentation>Step 2: Negotiation: (a) Trade Account Manager represents BuildRight in negotiation meeting, (b) present product capabilities, delivery plan, pricing, (c) negotiate terms: price, delivery schedule, warranty, payment terms, (d) document all negotiation proceedings per anti-bribery requirements (GOV-013)
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1960_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1960_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1960_Task7" name="Post-negotiation: (a) submit final offer with negotiated terms, (b) await…">
        <bpmn:documentation>Step 3: Post-negotiation: (a) submit final offer with negotiated terms, (b) await Notice of Award, (c) process as government PO per W1961
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per procurement</bpmn:documentation>
        <bpmn:incoming>W1960_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1960_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1960_End8" name="Complete">
        <bpmn:incoming>W1960_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1960_Annotation9">
        <bpmn:text>Controls: - CTL-191 (ensure B2G procurement compliance &amp; collection.) | - operational: standard operating procedures; system-enforced validation rules
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1960_Assoc10" sourceRef="W1960_Annotation9" targetRef="W1960_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1960_Flow11" sourceRef="W1960_Start4" targetRef="W1960_Task5" />
      <bpmn:sequenceFlow id="W1960_Flow12" sourceRef="W1960_Task5" targetRef="W1960_Task6" />
      <bpmn:sequenceFlow id="W1960_Flow13" sourceRef="W1960_Task6" targetRef="W1960_Task7" />
      <bpmn:sequenceFlow id="W1960_Flow14" sourceRef="W1960_Task7" targetRef="W1960_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1960_diag">
      <bpmndi:BPMNPlane id="W1960_plane" bpmnElement="W_W1960">
        <bpmndi:BPMNShape id="W1960_Lane1_di" bpmnElement="W1960_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Lane2_di" bpmnElement="W1960_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Task5_di" bpmnElement="W1960_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Task6_di" bpmnElement="W1960_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Task7_di" bpmnElement="W1960_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Start4_di" bpmnElement="W1960_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_End8_di" bpmnElement="W1960_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1960_Annotation9_di" bpmnElement="W1960_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1960_Flow11_di" bpmnElement="W1960_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1960_Flow12_di" bpmnElement="W1960_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1960_Flow13_di" bpmnElement="W1960_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1960_Flow14_di" bpmnElement="W1960_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1960_Assoc10_di" bpmnElement="W1960_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1961" name="W1961. Government Contract Award &amp; Purchase Order Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Notice of Award received from government agency
Frequency: ~10–15 contract awards/year
Volume: ~PHP 100M–300M in annual government contracts
Owner: Trade Account Manager
Participants: Trade Account Manager, VP Store Operations, VP Supply Chain, Legal &amp; Compliance Officer
Source: workflow W1961 — Government Contract Award &amp; Purchase Order Processing</bpmn:documentation>
      <bpmn:laneSet id="W1961_LaneSet3">
        <bpmn:lane id="W1961_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1961_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1961_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1961_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1961_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1961_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1961_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1961_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1961_Start4" name="Notice of Award received from government agency">
        <bpmn:outgoing>W1961_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1961_Task5" name="Receive Notice of Award (NOA): (a) Trade Account Manager receives NOA from…">
        <bpmn:documentation>Step 1: Receive Notice of Award (NOA): (a) Trade Account Manager receives NOA from government procuring entity, (b) review contract terms: scope, pricing, delivery schedule, warranty, payment terms, penalty clauses, (c) Legal &amp; Compliance Officer reviews contract terms for compliance and risk
Responsible (R): Trade Account Manager / Legal &amp; Compliance Officer
Accountable (A): VP Store Operations
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1961_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1961_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1961_Task6" name="Accept award and sign contract: (a) VP Store Operations approves contract…">
        <bpmn:documentation>Step 2: Accept award and sign contract: (a) VP Store Operations approves contract acceptance, (b) sign contract within validity period (typically 10–20 calendar days from NOA receipt), (c) post performance security (if required): bank guarantee or surety bond typically 5% of contract value for goods supply (10% for infrastructure works) per RA 9184
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1961_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1961_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1961_Task7" name="Create sales order in ERP: (a) convert government PO/contract to BuildRight…">
        <bpmn:documentation>Step 3: Create sales order in ERP: (a) convert government PO/contract to BuildRight sales order, (b) allocate inventory per delivery schedule, (c) if items not in stock: create procurement request per W2 for vendor purchase, (d) coordinate delivery schedule with VP Supply Chain
Responsible (R): Trade Account Manager / VP Supply Chain
Accountable (A): VP Store Operations
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1961_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1961_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1961_Task8" name="AR invoice processing: (a) generate government invoice per BIR requirements…">
        <bpmn:documentation>Step 4: AR invoice processing: (a) generate government invoice per BIR requirements with TIN, (b) include: PO reference, contract reference, delivery receipt, acceptance certificate, (c) submit invoice through government agency&#x27;s payment processing system
Responsible (R): Trade Account Manager
Accountable (A): AP/AR Manager
Duration: Per delivery milestone</bpmn:documentation>
        <bpmn:incoming>W1961_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1961_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1961_End9" name="Complete">
        <bpmn:incoming>W1961_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1961_Annotation10">
        <bpmn:text>Controls: - CTL-380 (ensure controlled execution — Government Bid, Quotation &amp; Order Processing (PA-46.2).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1961_Assoc11" sourceRef="W1961_Annotation10" targetRef="W1961_Start4" associationDirection="None" />
