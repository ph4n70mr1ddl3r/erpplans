    <bpmn:process id="W_W1963" name="W1963. Government Multi-Year Contract &amp; Blanket Purchase Order Management" isExecutable="false">
      <bpmn:documentation>Trigger: Government multi-year contract awarded; blanket PO issued
Frequency: ~5–10 multi-year contracts maintained
Volume: ~PHP 50M–100M in annual blanket PO value
Owner: Trade Account Manager
Participants: Trade Account Manager, VP Store Operations, VP Supply Chain, CFO
Source: workflow W1963 — Government Multi-Year Contract &amp; Blanket Purchase Order Management</bpmn:documentation>
      <bpmn:laneSet id="W1963_LaneSet3">
        <bpmn:lane id="W1963_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1963_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1963_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1963_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1963_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1963_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1963_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1963_Start4" name="Government multi-year contract awarded; blanket PO issued">
        <bpmn:outgoing>W1963_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1963_Task5" name="Multi-year contract setup: (a) Trade Account Manager sets up government blanket…">
        <bpmn:documentation>Step 1: Multi-year contract setup: (a) Trade Account Manager sets up government blanket PO in ERP, (b) contract terms: total contract value, annual allocation, release mechanism (call-off by government agency), (c) pricing: fixed or escalation clause per contract, (d) delivery: schedule or on-call per agency request
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1–2 days/contract</bpmn:documentation>
        <bpmn:incoming>W1963_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1963_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1963_Task6" name="Call-off order processing: (a) government agency issues call-off order against…">
        <bpmn:documentation>Step 2: Call-off order processing: (a) government agency issues call-off order against blanket PO, (b) Trade Account Manager creates delivery order from blanket PO, (c) ATP check for call-off items, (d) schedule delivery per agency timeline, (e) system tracks blanket PO utilization: total released vs. total contract value
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per call-off</bpmn:documentation>
        <bpmn:incoming>W1963_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1963_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1963_Task7" name="Annual review: (a) VP Store Operations reviews multi-year contract performance…">
        <bpmn:documentation>Step 3: Annual review: (a) VP Store Operations reviews multi-year contract performance: (i) utilization rate, (ii) revenue vs. target, (iii) margin vs. target, (iv) collection performance, (b) CFO reviews contract financial impact on revenue and working capital, (c) contract renewal or extension negotiation (if applicable)
Responsible (R): VP Store Operations / CFO
Accountable (A): COO
Duration: 1–2 days/year/contract</bpmn:documentation>
        <bpmn:incoming>W1963_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1963_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1963_End8" name="Complete">
        <bpmn:incoming>W1963_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1963_Annotation9">
        <bpmn:text>Controls: - CTL-380 (ensure controlled execution — Government Bid, Quotation &amp; Order Processing (PA-46.2).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
