<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-46.2-government-bid-order-processing" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1958" name="W1958. Government Competitive Bidding Preparation &amp; Submission" isExecutable="false">
      <bpmn:documentation>Trigger: Bidding opportunity identified per W1953
Frequency: ~20–30 bids/year
Volume: ~PHP 200M–500M in annual government bids
Owner: Trade Account Manager
Participants: Trade Account Manager, Category Manager, Pricing Analyst, Legal &amp; Compliance Officer, VP Store Operations
Source: workflow W1958 — Government Competitive Bidding Preparation &amp; Submission</bpmn:documentation>
      <bpmn:laneSet id="W1958_LaneSet3">
        <bpmn:lane id="W1958_Lane1" name="VP Store Operations">
        <bpmn:flowNodeRef>W1958_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1958_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1958_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1958_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1958_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1958_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1958_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1958_Start4" name="Bidding opportunity identified per W1953">
        <bpmn:outgoing>W1958_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1958_Task5" name="Bid/no-bid decision: (a) VP Store Operations reviews opportunity: (i) product…">
        <bpmn:documentation>Step 1: Bid/no-bid decision: (a) VP Store Operations reviews opportunity: (i) product availability — can BuildRight supply all requested items?, (ii) delivery feasibility — can BuildRight deliver to project site(s) within required timeline?, (iii) pricing competitiveness — can BuildRight offer competitive pricing given cost structure?, (iv) strategic fit — aligns with BuildRight&#x27;s government sales strategy?
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1–2 hours/opportunity</bpmn:documentation>
        <bpmn:incoming>W1958_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1958_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1958_Task6" name="Bid preparation: (a) eligibility documents: compile per W1954, (b) technical…">
        <bpmn:documentation>Step 2: Bid preparation: (a) eligibility documents: compile per W1954, (b) technical proposal: product specifications, brand/model details, delivery schedule, warranty terms, product data sheets, (c) financial proposal: unit pricing per item, total bid price, validity period (typically 90 days), (d) Pricing Analyst calculates competitive pricing: (i) standard cost + margin, (ii) volume discount if applicable, (iii) delivery cost inclusion, (iv) target margin: minimum 15% for government bids
Responsible (R): Trade Account Manager / Pricing Analyst
Accountable (A): VP Store Operations
Duration: 3–5 days/bid</bpmn:documentation>
        <bpmn:incoming>W1958_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1958_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1958_Task7" name="Bid submission: (a) submit through government procurement portal or physical…">
        <bpmn:documentation>Step 3: Bid submission: (a) submit through government procurement portal or physical submission per bidding documents, (b) ensure submission before deadline (late bids automatically disqualified), (c) obtain acknowledgment of receipt
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1 day/bid</bpmn:documentation>
        <bpmn:incoming>W1958_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1958_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1958_Task8" name="Post-submission: (a) attend pre-bid conference if scheduled, (b) respond to…">
        <bpmn:documentation>Step 4: Post-submission: (a) attend pre-bid conference if scheduled, (b) respond to clarifications from BAC, (c) attend bid opening (public opening — all bid prices visible to competitors), (d) await award decision
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per bid schedule</bpmn:documentation>
        <bpmn:incoming>W1958_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1958_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1958_End9" name="Complete">
        <bpmn:incoming>W1958_Flow16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1958_Annotation10">
        <bpmn:text>Controls: - CTL-380 (ensure controlled execution — Government Bid, Quotation &amp; Order Processing (PA-46.2).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1958_Assoc11" sourceRef="W1958_Annotation10" targetRef="W1958_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1958_Flow12" sourceRef="W1958_Start4" targetRef="W1958_Task5" />
      <bpmn:sequenceFlow id="W1958_Flow13" sourceRef="W1958_Task5" targetRef="W1958_Task6" />
      <bpmn:sequenceFlow id="W1958_Flow14" sourceRef="W1958_Task6" targetRef="W1958_Task7" />
      <bpmn:sequenceFlow id="W1958_Flow15" sourceRef="W1958_Task7" targetRef="W1958_Task8" />
      <bpmn:sequenceFlow id="W1958_Flow16" sourceRef="W1958_Task8" targetRef="W1958_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1958_diag">
      <bpmndi:BPMNPlane id="W1958_plane" bpmnElement="W_W1958">
        <bpmndi:BPMNShape id="W1958_Lane1_di" bpmnElement="W1958_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Lane2_di" bpmnElement="W1958_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Task5_di" bpmnElement="W1958_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Task6_di" bpmnElement="W1958_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Task7_di" bpmnElement="W1958_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Task8_di" bpmnElement="W1958_Task8"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_Start4_di" bpmnElement="W1958_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1958_End9_di" bpmnElement="W1958_End9"><dc:Bounds x="1260" y="317" width="36" height="36" /></bpmndi:BPMNShape>
