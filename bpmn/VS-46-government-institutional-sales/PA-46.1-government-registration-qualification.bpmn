      <bpmndi:BPMNPlane id="W1956_plane" bpmnElement="W_W1956">
        <bpmndi:BPMNShape id="W1956_Lane1_di" bpmnElement="W1956_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
