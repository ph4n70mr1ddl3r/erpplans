<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-46.1-government-registration-qualification" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1950" name="W1950. PHILGEPS Registration &amp; Renewal Management" isExecutable="false">
      <bpmn:documentation>Trigger: Initial registration; annual renewal cycle
Frequency: Initial: once per entity; Renewal: annual for 5 entities
Volume: 5 entity registrations maintained
Owner: Legal &amp; Compliance Officer
Participants: Legal &amp; Compliance Officer, CFO, VP Legal, Procurement Specialist
Source: workflow W1950 — PHILGEPS Registration &amp; Renewal Management</bpmn:documentation>
      <bpmn:laneSet id="W1950_LaneSet3">
        <bpmn:lane id="W1950_Lane1" name="Legal &amp; Compliance Officer">
        <bpmn:flowNodeRef>W1950_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1950_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1950_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1950_Lane2" name="System">
        <bpmn:flowNodeRef>W1950_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1950_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1950_Start4" name="Initial registration; annual renewal cycle">
        <bpmn:outgoing>W1950_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1950_Task5" name="Legal &amp; Compliance Officer manages PHILGEPS registration for each entity: (a)…">
        <bpmn:documentation>Step 1: Legal &amp; Compliance Officer manages PHILGEPS registration for each entity: (a) BuildRight Depot, Inc. (primary — retail operations), (b) BuildRight Logistics, Inc. (if supplying logistics services to government), (c) register at philgeps.gov.ph with: SEC registration, mayor&#x27;s permit, BIR registration, audited financial statements, PCAB license (if applicable for construction supply), (d) obtain &quot;Red&quot; or &quot;Platinum&quot; membership (Platinum required to download bidding documents and submit bids; web-verified — PhilGEPS tiers are Red/Platinum only)
Responsible (R): Legal &amp; Compliance Officer
Accountable (A): VP Legal
Duration: 2–3 days/entity initial</bpmn:documentation>
        <bpmn:incoming>W1950_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1950_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1950_Task6" name="Annual renewal: (a) update financial statements, (b) renew mayor&#x27;s permit and…">
        <bpmn:documentation>Step 2: Annual renewal: (a) update financial statements, (b) renew mayor&#x27;s permit and business registration, (c) update contact information and authorized representatives, (d) verify PCAB license currency, (e) submit renewal 30 days before expiration
Responsible (R): Legal &amp; Compliance Officer
Accountable (A): VP Legal
Duration: 1 day/entity/year</bpmn:documentation>
        <bpmn:incoming>W1950_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1950_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1950_Task7" name="System integration: (a) PHILGEPS registration status tracked per entity in…">
        <bpmn:documentation>Step 3: System integration: (a) PHILGEPS registration status tracked per entity in vendor master, (b) renewal calendar alerts 60 days before expiration, (c) registration certificate stored in document management per DOC-001
Responsible (R): System / Legal &amp; Compliance Officer
Accountable (A): CFO
Duration: Automated monitoring</bpmn:documentation>
        <bpmn:incoming>W1950_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1950_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1950_End8" name="Complete">
        <bpmn:incoming>W1950_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1950_Annotation9">
        <bpmn:text>Controls: - CTL-191 (ensure B2G procurement compliance &amp; collection.) | - operational: standard operating procedures; system-enforced validation rules
Owner: Legal &amp; Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1950_Assoc10" sourceRef="W1950_Annotation9" targetRef="W1950_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1950_Flow11" sourceRef="W1950_Start4" targetRef="W1950_Task5" />
      <bpmn:sequenceFlow id="W1950_Flow12" sourceRef="W1950_Task5" targetRef="W1950_Task6" />
      <bpmn:sequenceFlow id="W1950_Flow13" sourceRef="W1950_Task6" targetRef="W1950_Task7" />
      <bpmn:sequenceFlow id="W1950_Flow14" sourceRef="W1950_Task7" targetRef="W1950_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1950_diag">
      <bpmndi:BPMNPlane id="W1950_plane" bpmnElement="W_W1950">
        <bpmndi:BPMNShape id="W1950_Lane1_di" bpmnElement="W1950_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1950_Lane2_di" bpmnElement="W1950_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
