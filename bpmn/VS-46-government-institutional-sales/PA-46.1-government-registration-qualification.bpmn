        <bpmndi:BPMNEdge id="W1950_Flow13_di" bpmnElement="W1950_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1950_Flow14_di" bpmnElement="W1950_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1950_Assoc10_di" bpmnElement="W1950_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1951" name="W1951. Government Entity Account Creation &amp; Credit Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Government agency or LGU first purchase request
Frequency: ~20–30 new government accounts/year
Volume: ~150–200 active government/institutional accounts
Owner: Trade Account Manager
Participants: Trade Account Manager, Credit Analyst, Sales Team, VP Store Operations
Source: workflow W1951 — Government Entity Account Creation &amp; Credit Assessment</bpmn:documentation>
      <bpmn:laneSet id="W1951_LaneSet4">
        <bpmn:lane id="W1951_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1951_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1951_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1951_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W1951_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1951_Lane3" name="System">
        <bpmn:flowNodeRef>W1951_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1951_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1951_Start5" name="Government agency or LGU first purchase request">
        <bpmn:outgoing>W1951_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1951_Task6" name="Trade Account Manager creates government account: (a) entity type…">
        <bpmn:documentation>Step 1: Trade Account Manager creates government account: (a) entity type classification: national government agency, GOCC, LGU, state university, government hospital, public school, (b) collect: official designation, head of procuring entity (HOPE) name, procurement officer contact, billing address, TIN, (c) government accounts exempt from standard credit scoring — credit worthiness based on government entity status and approved budget
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1–2 days/account</bpmn:documentation>
        <bpmn:incoming>W1951_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1951_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1951_Task7" name="Credit Analyst sets government account terms: (a) credit limit: based on…">
        <bpmn:documentation>Step 2: Credit Analyst sets government account terms: (a) credit limit: based on entity&#x27;s annual procurement budget (if disclosed) or historical purchase pattern, (b) payment terms: government accounts typically Net 30–60 per government procurement law, (c) mandatory: government purchase order or purchase request as billing basis, (d) BIR withholding tax handling: government entities withhold 1% EWT per revenue regulation
Responsible (R): Credit Analyst
Accountable (A): Credit Manager
Duration: 1 day/account</bpmn:documentation>
        <bpmn:incoming>W1951_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1951_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1951_Task8" name="System setup: (a) government account flag in customer master, (b) VAT…">
        <bpmn:documentation>Step 3: System setup: (a) government account flag in customer master, (b) VAT treatment: government purchases are VAT-inclusive (BuildRight charges 12% VAT; government entity may be VAT-exempt per specific law — verify per entity), (c) EWT handling: system configured for 1% EWT on government sales, (d) payment terms and credit limit configured
Responsible (R): System / Trade Account Manager
Accountable (A): Credit Manager
Duration: 30 min/account</bpmn:documentation>
        <bpmn:incoming>W1951_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1951_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1951_End9" name="Complete">
        <bpmn:incoming>W1951_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1951_Annotation10">
        <bpmn:text>Controls: - CTL-379 (ensure controlled execution — Government Registration &amp; Qualification (PA-46.1).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1951_Assoc11" sourceRef="W1951_Annotation10" targetRef="W1951_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1951_Flow12" sourceRef="W1951_Start5" targetRef="W1951_Task6" />
      <bpmn:sequenceFlow id="W1951_Flow13" sourceRef="W1951_Task6" targetRef="W1951_Task7" />
      <bpmn:sequenceFlow id="W1951_Flow14" sourceRef="W1951_Task7" targetRef="W1951_Task8" />
      <bpmn:sequenceFlow id="W1951_Flow15" sourceRef="W1951_Task8" targetRef="W1951_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1951_diag">
      <bpmndi:BPMNPlane id="W1951_plane" bpmnElement="W_W1951">
        <bpmndi:BPMNShape id="W1951_Lane1_di" bpmnElement="W1951_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Lane2_di" bpmnElement="W1951_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Lane3_di" bpmnElement="W1951_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Task6_di" bpmnElement="W1951_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Task7_di" bpmnElement="W1951_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Task8_di" bpmnElement="W1951_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Start5_di" bpmnElement="W1951_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_End9_di" bpmnElement="W1951_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1951_Annotation10_di" bpmnElement="W1951_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1951_Flow12_di" bpmnElement="W1951_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1951_Flow13_di" bpmnElement="W1951_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1951_Flow14_di" bpmnElement="W1951_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1951_Flow15_di" bpmnElement="W1951_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1951_Assoc11_di" bpmnElement="W1951_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1952" name="W1952. LGU &amp; Government Agency Relationship Development" isExecutable="false">
      <bpmn:documentation>Trigger: Ongoing relationship management; annual planning
Frequency: Quarterly engagement per key account
Volume: ~20 key government accounts (top by revenue)
Owner: Trade Account Manager
Participants: Trade Account Manager, VP Store Operations, Regional Manager, Category Manager
Source: workflow W1952 — LGU &amp; Government Agency Relationship Development</bpmn:documentation>
      <bpmn:laneSet id="W1952_LaneSet2">
        <bpmn:lane id="W1952_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1952_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1952_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1952_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1952_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1952_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1952_Start3" name="Ongoing relationship management; annual planning">
        <bpmn:outgoing>W1952_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1952_Task4" name="Trade Account Manager develops government account relationships: (a) identify…">
        <bpmn:documentation>Step 1: Trade Account Manager develops government account relationships: (a) identify key decision-makers: procuring entity head, BAC (Bids and Awards Committee) members, end-user department heads, (b) understand entity&#x27;s annual procurement plan (APP) — when do they plan to purchase building materials?, (c) position BuildRight as preferred supplier: product range, nationwide coverage (200 stores), delivery capability, BIR compliance
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1952_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1952_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1952_Task5" name="Quarterly: Trade Account Manager reviews key government accounts: (a) purchase…">
        <bpmn:documentation>Step 2: Quarterly: Trade Account Manager reviews key government accounts: (a) purchase history and trends, (b) upcoming procurement opportunities from APP, (c) competitive landscape: which other suppliers serve this entity?, (d) plan engagement activities: site visits, product presentations, facility tours
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1952_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1952_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1952_Task6" name="Annual: participate in LGU development planning: (a) attend pre-procurement…">
        <bpmn:documentation>Step 3: Annual: participate in LGU development planning: (a) attend pre-procurement conferences, (b) provide product catalogs and pricing guides to government procurement offices, (c) register for LGU supplier databases beyond PHILGEPS (some LGUs maintain separate registries)
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1952_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1952_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1952_End7" name="Complete">
        <bpmn:incoming>W1952_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1952_Annotation8">
        <bpmn:text>Controls: - CTL-379 (ensure controlled execution — Government Registration &amp; Qualification (PA-46.1).) | - operational: Trade Account Manager review and approval gate
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1952_Assoc9" sourceRef="W1952_Annotation8" targetRef="W1952_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1952_Flow10" sourceRef="W1952_Start3" targetRef="W1952_Task4" />
      <bpmn:sequenceFlow id="W1952_Flow11" sourceRef="W1952_Task4" targetRef="W1952_Task5" />
      <bpmn:sequenceFlow id="W1952_Flow12" sourceRef="W1952_Task5" targetRef="W1952_Task6" />
      <bpmn:sequenceFlow id="W1952_Flow13" sourceRef="W1952_Task6" targetRef="W1952_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1952_diag">
      <bpmndi:BPMNPlane id="W1952_plane" bpmnElement="W_W1952">
        <bpmndi:BPMNShape id="W1952_Lane1_di" bpmnElement="W1952_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_Task4_di" bpmnElement="W1952_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_Task5_di" bpmnElement="W1952_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_Task6_di" bpmnElement="W1952_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_Start3_di" bpmnElement="W1952_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_End7_di" bpmnElement="W1952_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1952_Annotation8_di" bpmnElement="W1952_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1952_Flow10_di" bpmnElement="W1952_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1952_Flow11_di" bpmnElement="W1952_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1952_Flow12_di" bpmnElement="W1952_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1952_Flow13_di" bpmnElement="W1952_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1952_Assoc9_di" bpmnElement="W1952_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1953" name="W1953. Government Procurement Calendar Monitoring &amp; Opportunity Identification" isExecutable="false">
      <bpmn:documentation>Trigger: Daily PHILGEPS and government procurement portal monitoring
Frequency: Daily monitoring; weekly pipeline review
Volume: ~50–100 government procurement notices reviewed/week; ~5–10 opportunities pursued
Owner: Trade Account Manager
Participants: Trade Account Manager, Category Manager, VP Store Operations
Source: workflow W1953 — Government Procurement Calendar Monitoring &amp; Opportunity Identification</bpmn:documentation>
      <bpmn:laneSet id="W1953_LaneSet2">
        <bpmn:lane id="W1953_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1953_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1953_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1953_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1953_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1953_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1953_Start3" name="Daily PHILGEPS and government procurement portal monitoring">
        <bpmn:outgoing>W1953_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1953_Task4" name="Daily: Trade Account Manager monitors procurement opportunities: (a) PHILGEPS…">
        <bpmn:documentation>Step 1: Daily: Trade Account Manager monitors procurement opportunities: (a) PHILGEPS portal for new bidding opportunities in hardware/building materials categories, (b) LGU procurement portals for local government opportunities, (c) PhilGEPS shopping/small-value procurement modes (same portal as (a); &#x27;G-EPS&#x27; is its legacy name), (d) DPWH, DepEd, DOH, DND procurement notices for infrastructure, school, hospital, and military construction projects
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 30–60 min/day</bpmn:documentation>
        <bpmn:incoming>W1953_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1953_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1953_Task5" name="Weekly: Trade Account Manager reviews opportunity pipeline: (a) filter by: (i)…">
        <bpmn:documentation>Step 2: Weekly: Trade Account Manager reviews opportunity pipeline: (a) filter by: (i) product relevance (does BuildRight carry the requested items?), (ii) geographic coverage (can BuildRight deliver to project sites?), (iii) value threshold (pursue opportunities &gt; PHP 500K), (iv) competitiveness (does BuildRight have pricing advantage?), (b) categorize: hot (bidding deadline within 2 weeks), warm (bidding in 2–8 weeks), cold (advance notice only)
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1–2 hours/week</bpmn:documentation>
        <bpmn:incoming>W1953_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1953_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1953_Task6" name="For hot opportunities: (a) notify Category Manager for pricing preparation, (b)…">
        <bpmn:documentation>Step 3: For hot opportunities: (a) notify Category Manager for pricing preparation, (b) coordinate with VP Store Operations for bid/no-bid decision, (c) begin bid preparation per W1959
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W1953_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1953_Flow13</bpmn:outgoing>
