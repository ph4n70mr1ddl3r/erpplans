    <bpmn:process id="W_W1955" name="W1955. Government Procurement Training &amp; Staff Certification" isExecutable="false">
      <bpmn:documentation>Trigger: Annual training cycle; new staff onboarding
Frequency: Annual refresher; new hire training
Volume: ~10–15 staff involved in government sales
Owner: VP Store Operations
Participants: VP Store Operations, Trade Account Manager, Legal &amp; Compliance Officer
Source: workflow W1955 — Government Procurement Training &amp; Staff Certification</bpmn:documentation>
      <bpmn:laneSet id="W1955_LaneSet4">
        <bpmn:lane id="W1955_Lane1" name="Legal &amp; Compliance Officer">
        <bpmn:flowNodeRef>W1955_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1955_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1955_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1955_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1955_Lane3" name="VP Store Operations">
        <bpmn:flowNodeRef>W1955_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1955_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1955_Start5" name="Annual training cycle; new staff onboarding">
        <bpmn:outgoing>W1955_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1955_Task6" name="Annual training on RA 9184 (Government Procurement Reform Act): (a) modes of…">
        <bpmn:documentation>Step 1: Annual training on RA 9184 (Government Procurement Reform Act): (a) modes of procurement: competitive bidding, shopping, negotiated procurement, small value procurement, (b) bidding process: eligibility, technical, financial components, (c) BuildRight&#x27;s obligations as winning bidder: delivery timeline, warranty, quality standards, (d) prohibited acts: bribery, collusion, bid rigging per GOV-013, (e) sanctions for non-compliance: blacklisting, suspension from government procurement
Responsible (R): Legal &amp; Compliance Officer
Accountable (A): VP Store Operations
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1955_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1955_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1955_Task7" name="Practical training: (a) PHILGEPS portal navigation, (b) bid document…">
        <bpmn:documentation>Step 2: Practical training: (a) PHILGEPS portal navigation, (b) bid document preparation: eligibility requirements, technical proposal, financial proposal, (c) government billing and collection procedures, (d) EWT handling for government sales, (e) mock bidding exercise
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1955_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1955_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1955_Task8" name="Staff certification: (a) training completion recorded in HR system per W51, (b)…">
        <bpmn:documentation>Step 3: Staff certification: (a) training completion recorded in HR system per W51, (b) government procurement certification linked to role competency, (c) only certified staff authorized to prepare and submit government bids
Responsible (R): VP Store Operations / HR
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1955_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1955_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1955_End9" name="Complete">
        <bpmn:incoming>W1955_Flow15</bpmn:incoming>
      </bpmn:endEvent>
