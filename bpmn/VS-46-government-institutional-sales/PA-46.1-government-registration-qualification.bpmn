      <bpmn:startEvent id="W1954_Start5" name="Annual tax clearance; government bidding requirement">
        <bpmn:outgoing>W1954_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1954_Task6" name="Annual: Tax Accountant obtains BIR tax clearance per entity: (a) BIR Form 0605…">
        <bpmn:documentation>Step 1: Annual: Tax Accountant obtains BIR tax clearance per entity: (a) BIR Form 0605 (Registration Update), (b) certification of no pending tax cases, (c) proof of timely filing of monthly/quarterly returns, (d) tax clearance valid for 1 year — maintain current clearance for all 5 entities
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 2–3 days/entity/year</bpmn:documentation>
        <bpmn:incoming>W1954_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1954_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1954_Task7" name="Per bid: compile compliance document package: (a) BIR tax clearance, (b) SEC…">
        <bpmn:documentation>Step 2: Per bid: compile compliance document package: (a) BIR tax clearance, (b) SEC registration, (c) mayor&#x27;s permit / business permit, (d) PHILGEPS registration certificate, (e) audited financial statements (latest), (f) PCAB license (if required for construction supply), (g) BIR registration certificate, (h) mother company certification (if bidding on behalf of subsidiary)
Responsible (R): Legal &amp; Compliance Officer
Accountable (A): VP Legal
Duration: 1–2 days/bid</bpmn:documentation>
        <bpmn:incoming>W1954_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1954_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1954_Task8" name="System tracks compliance document expiration: (a) automated alerts 30 days…">
        <bpmn:documentation>Step 3: System tracks compliance document expiration: (a) automated alerts 30 days before expiration, (b) document repository for quick retrieval during bid preparation, (c) compliance status dashboard per entity
Responsible (R): System / Legal &amp; Compliance Officer
Accountable (A): CFO
Duration: Automated monitoring</bpmn:documentation>
        <bpmn:incoming>W1954_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1954_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1954_End9" name="Complete">
        <bpmn:incoming>W1954_Flow15</bpmn:incoming>
      </bpmn:endEvent>
