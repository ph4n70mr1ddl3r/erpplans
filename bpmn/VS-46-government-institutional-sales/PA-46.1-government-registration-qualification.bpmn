    <bpmn:process id="W_W1954" name="W1954. BIR Tax Clearance &amp; Government Supplier Compliance Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Annual tax clearance; government bidding requirement
Frequency: Annual tax clearance; per-bid submission
Volume: 5 entities; ~20–30 bids/year requiring compliance docs
Owner: Tax Accountant
Participants: Tax Accountant, Legal &amp; Compliance Officer, CFO
Source: workflow W1954 — BIR Tax Clearance &amp; Government Supplier Compliance Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W1954_LaneSet4">
        <bpmn:lane id="W1954_Lane1" name="Tax Accountant">
