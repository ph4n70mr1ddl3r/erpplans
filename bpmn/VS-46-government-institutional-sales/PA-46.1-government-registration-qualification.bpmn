    <bpmn:process id="W_W1957" name="W1957. Government Supplier Performance Scorecard &amp; Annual Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual government sales review
Frequency: Annual
Volume: Consolidated government sales performance
Owner: VP Store Operations
Participants: VP Store Operations, Trade Account Manager, CFO, VP Merchandising
Source: workflow W1957 — Government Supplier Performance Scorecard &amp; Annual Review</bpmn:documentation>
      <bpmn:laneSet id="W1957_LaneSet4">
        <bpmn:lane id="W1957_Lane1" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1957_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1957_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1957_Lane2" name="VP Store Operations">
        <bpmn:flowNodeRef>W1957_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1957_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1957_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1957_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1957_Start5" name="Annual government sales review">
        <bpmn:outgoing>W1957_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1957_Task6" name="Trade Account Manager compiles annual government sales scorecard: (a) total…">
        <bpmn:documentation>Step 1: Trade Account Manager compiles annual government sales scorecard: (a) total government revenue by entity type (national govt, LGU, GOCC, institutional), (b) number of bids submitted, won, and lost with win rate, (c) average deal size, (d) collection performance: DSO for government accounts vs. trade accounts, (e) top 10 government accounts by revenue, (f) government sales as % of total revenue (target: 3–5%)
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1957_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1957_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1957_Task7" name="VP Store Operations presents government sales review to executive team: (a)…">
        <bpmn:documentation>Step 2: VP Store Operations presents government sales review to executive team: (a) performance vs. prior year, (b) pipeline for next year (known upcoming government projects), (c) competitive landscape: which competitors are winning government bids?, (d) strategic recommendations: expand/contract government sales focus
Responsible (R): VP Store Operations
Accountable (A): COO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1957_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1957_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1957_Task8" name="CFO reviews government sales profitability: (a) gross margin on government…">
        <bpmn:documentation>Step 3: CFO reviews government sales profitability: (a) gross margin on government sales vs. retail/trade, (b) collection cost: government accounts may require more collection effort, (c) working capital impact: longer payment terms tie up cash, (d) EWT recovery: ensure 1% EWT is properly credited against income tax
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1957_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1957_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1957_End9" name="Complete">
        <bpmn:incoming>W1957_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1957_Annotation10">
        <bpmn:text>Controls: - CTL-379 (ensure controlled execution — Government Registration &amp; Qualification (PA-46.1).) | - operational: VP Store Operations review and approval gate
Owner: VP Store Operations</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1957_Assoc11" sourceRef="W1957_Annotation10" targetRef="W1957_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1957_Flow12" sourceRef="W1957_Start5" targetRef="W1957_Task6" />
      <bpmn:sequenceFlow id="W1957_Flow13" sourceRef="W1957_Task6" targetRef="W1957_Task7" />
      <bpmn:sequenceFlow id="W1957_Flow14" sourceRef="W1957_Task7" targetRef="W1957_Task8" />
      <bpmn:sequenceFlow id="W1957_Flow15" sourceRef="W1957_Task8" targetRef="W1957_End9" />
    </bpmn:process>
