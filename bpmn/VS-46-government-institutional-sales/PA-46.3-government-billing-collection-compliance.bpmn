    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1973" name="W1973. Government Account Aging &amp; Bad Debt Provision" isExecutable="false">
      <bpmn:documentation>Trigger: Month-end close; quarterly bad debt review
Frequency: Monthly aging review; quarterly provision assessment
Volume: ~150–200 active government accounts
Owner: Accounting Manager
Participants: Accounting Manager, Credit Analyst, CFO
Source: workflow W1973 — Government Account Aging &amp; Bad Debt Provision</bpmn:documentation>
      <bpmn:laneSet id="W1973_LaneSet4">
        <bpmn:lane id="W1973_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W1973_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1973_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1973_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W1973_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1973_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1973_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1973_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1973_Start5" name="Month-end close; quarterly bad debt review">
        <bpmn:outgoing>W1973_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1973_Task6" name="Monthly: Accounting Manager reviews government AR aging: (a) total government…">
        <bpmn:documentation>Step 1: Monthly: Accounting Manager reviews government AR aging: (a) total government AR balance, (b) aging distribution: current, 30, 60, 90, 120, 180+ days, (c) compare to prior month: is government AR improving or deteriorating?, (d) flag accounts &gt; 90 days for Trade Account Manager follow-up
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 1–2 hours/month</bpmn:documentation>
        <bpmn:incoming>W1973_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1973_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1973_Task7" name="Quarterly: Credit Analyst assesses bad debt provision for government accounts…">
        <bpmn:documentation>Step 2: Quarterly: Credit Analyst assesses bad debt provision for government accounts: (a) historical collection rate: government accounts collect ~95–98% eventually (very low actual write-off), (b) provision methodology: lower provision rate than trade accounts due to lower default risk, (c) specific provision for accounts &gt; 180 days: assess collectibility per account, (d) accounts &gt; 1 year: specific assessment — is there a legitimate reason for non-payment (dispute, documentation issue, budget reallocation)?
Responsible (R): Credit Analyst
Accountable (A): CFO
Duration: 1 day/quarter</bpmn:documentation>
        <bpmn:incoming>W1973_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1973_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1973_Task8" name="Annual: CFO reviews government bad debt provisioning policy: (a) is 95–98%…">
        <bpmn:documentation>Step 3: Annual: CFO reviews government bad debt provisioning policy: (a) is 95–98% collection rate assumption still valid?, (b) any systemic collection issues (e.g., specific government entity consistently paying late), (c) adjust provisioning policy if needed
Responsible (R): CFO
Accountable (A): CEO
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1973_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1973_End9" name="Complete">
        <bpmn:incoming>W1973_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1973_Annotation10">
        <bpmn:text>Controls: - CTL-381 (ensure controlled execution — Government Billing, Collection &amp; Compliance (PA-46.3).) | - operational: Accounting Manager review and approval gate
Owner: Accounting Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1973_Assoc11" sourceRef="W1973_Annotation10" targetRef="W1973_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1973_Flow12" sourceRef="W1973_Start5" targetRef="W1973_Task6" />
      <bpmn:sequenceFlow id="W1973_Flow13" sourceRef="W1973_Task6" targetRef="W1973_Task7" />
      <bpmn:sequenceFlow id="W1973_Flow14" sourceRef="W1973_Task7" targetRef="W1973_Task8" />
      <bpmn:sequenceFlow id="W1973_Flow15" sourceRef="W1973_Task8" targetRef="W1973_End9" />
    </bpmn:process>
