    <bpmn:process id="W_W1972" name="W1972. Government Sales Tax Compliance &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly VAT return preparation
Frequency: Monthly
Volume: All government sales transactions
Owner: Tax Accountant
Participants: Tax Accountant, AR Clerk, Accounting Manager
Source: workflow W1972 — Government Sales Tax Compliance &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1972_LaneSet2">
        <bpmn:lane id="W1972_Lane1" name="Tax Accountant">
        <bpmn:flowNodeRef>W1972_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1972_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1972_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1972_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1972_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1972_Start3" name="Monthly VAT return preparation">
        <bpmn:outgoing>W1972_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1972_Task4" name="Monthly: Tax Accountant includes government sales in VAT return: (a) government…">
        <bpmn:documentation>Step 1: Monthly: Tax Accountant includes government sales in VAT return: (a) government sales are generally VAT-inclusive (12% output VAT charged), (b) some government entities may be VAT-exempt per specific law (e.g., certain international organizations, diplomatic missions) — verify per entity, (c) VAT-exempt government sales reported in separate schedule of VAT return
Responsible (R): Tax Accountant
Accountable (A): Accounting Manager
Duration: Per monthly filing</bpmn:documentation>
        <bpmn:incoming>W1972_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1972_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1972_Task5" name="EWT reporting: (a) total government EWT withheld reported in quarterly income…">
        <bpmn:documentation>Step 2: EWT reporting: (a) total government EWT withheld reported in quarterly income tax return (BIR 1702Q), (b) annual reconciliation in annual income tax return (BIR 1702RT), (c) uncredited EWT from prior years carried forward
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Per quarterly/annual filing</bpmn:documentation>
        <bpmn:incoming>W1972_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1972_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1972_Task6" name="Local Business Tax (LBT): (a) government sales included in gross receipts for…">
        <bpmn:documentation>Step 3: Local Business Tax (LBT): (a) government sales included in gross receipts for LBT computation per LGU, (b) some LGUs offer LBT incentives for businesses with significant government contracts — investigate per location
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W1972_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1972_End7" name="Complete">
        <bpmn:incoming>W1972_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1972_Annotation8">
        <bpmn:text>Controls: - CTL-381 (ensure controlled execution — Government Billing, Collection &amp; Compliance (PA-46.3).) | - operational: periodic reconciliation against source documents
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1972_Assoc9" sourceRef="W1972_Annotation8" targetRef="W1972_Start3" associationDirection="None" />
