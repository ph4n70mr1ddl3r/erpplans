<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-46.3-government-billing-collection-compliance" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1966" name="W1966. Government Invoice Submission &amp; BIR-Compliant Billing" isExecutable="false">
      <bpmn:documentation>Trigger: Delivery completed and accepted by government entity
Frequency: Per delivery milestone; ~200–300 government invoices/year
Volume: ~200–300 government invoices/year
Owner: AR Clerk
Participants: AR Clerk, Trade Account Manager, Accounting Manager
Source: workflow W1966 — Government Invoice Submission &amp; BIR-Compliant Billing</bpmn:documentation>
      <bpmn:laneSet id="W1966_LaneSet3">
        <bpmn:lane id="W1966_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W1966_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1966_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1966_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1966_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1966_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1966_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1966_Start4" name="Delivery completed and accepted by government entity">
        <bpmn:outgoing>W1966_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1966_Task5" name="AR Clerk generates government invoice: (a) BIR-registered sales invoice or…">
        <bpmn:documentation>Step 1: AR Clerk generates government invoice: (a) BIR-registered sales invoice or official receipt per DOC-002, (b) include: government entity TIN, BuildRight TIN, CAS permit number, contract/PO reference, delivery receipt reference, acceptance certificate reference, (c) line items: product description, quantity, unit price, total per line, (d) VAT: 12% output VAT on gross amount (unless entity is VAT-exempt per specific law), (e) EWT: indicate 1% EWT to be withheld by government entity
Responsible (R): AR Clerk
Accountable (A): Accounting Manager
Duration: 15–30 min/invoice</bpmn:documentation>
        <bpmn:incoming>W1966_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1966_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1966_Task6" name="Supporting documents compiled: (a) signed delivery receipt, (b) acceptance…">
        <bpmn:documentation>Step 2: Supporting documents compiled: (a) signed delivery receipt, (b) acceptance certificate, (c) contract/PO copy, (d) inspection report (if applicable), (e) disbursement voucher (government payment request form — some agencies require BuildRight to prepare)
Responsible (R): Trade Account Manager / AR Clerk
Accountable (A): Accounting Manager
Duration: 30–60 min/invoice</bpmn:documentation>
        <bpmn:incoming>W1966_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1966_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1966_Task7" name="Invoice submission: (a) submit to government entity&#x27;s accounting/finance…">
        <bpmn:documentation>Step 3: Invoice submission: (a) submit to government entity&#x27;s accounting/finance department, (b) follow submission format required by specific agency (some have online portals, others require physical submission), (c) obtain acknowledgment of receipt with date stamp
Responsible (R): AR Clerk / Trade Account Manager
Accountable (A): Accounting Manager
Duration: Per submission</bpmn:documentation>
        <bpmn:incoming>W1966_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1966_End8" name="Complete">
        <bpmn:incoming>W1966_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1966_Annotation9">
        <bpmn:text>Controls: - CTL-191 (ensure B2G procurement compliance &amp; collection.) | - operational: standard operating procedures; system-enforced validation rules
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1966_Assoc10" sourceRef="W1966_Annotation9" targetRef="W1966_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1966_Flow11" sourceRef="W1966_Start4" targetRef="W1966_Task5" />
      <bpmn:sequenceFlow id="W1966_Flow12" sourceRef="W1966_Task5" targetRef="W1966_Task6" />
      <bpmn:sequenceFlow id="W1966_Flow13" sourceRef="W1966_Task6" targetRef="W1966_Task7" />
      <bpmn:sequenceFlow id="W1966_Flow14" sourceRef="W1966_Task7" targetRef="W1966_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1966_diag">
      <bpmndi:BPMNPlane id="W1966_plane" bpmnElement="W_W1966">
        <bpmndi:BPMNShape id="W1966_Lane1_di" bpmnElement="W1966_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Lane2_di" bpmnElement="W1966_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Task5_di" bpmnElement="W1966_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Task6_di" bpmnElement="W1966_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Task7_di" bpmnElement="W1966_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Start4_di" bpmnElement="W1966_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_End8_di" bpmnElement="W1966_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1966_Annotation9_di" bpmnElement="W1966_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1966_Flow11_di" bpmnElement="W1966_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1966_Flow12_di" bpmnElement="W1966_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1966_Flow13_di" bpmnElement="W1966_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1966_Flow14_di" bpmnElement="W1966_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1966_Assoc10_di" bpmnElement="W1966_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1967" name="W1967. Government Account Collection &amp; Payment Follow-Up" isExecutable="false">
      <bpmn:documentation>Trigger: Government invoice past due; monthly collection cycle
Frequency: Monthly collection cycle; weekly follow-up for overdue
Volume: ~150–200 active government accounts; ~200–300 invoices
Owner: AR Clerk
Participants: AR Clerk, Trade Account Manager, Accounting Manager
Source: workflow W1967 — Government Account Collection &amp; Payment Follow-Up</bpmn:documentation>
      <bpmn:laneSet id="W1967_LaneSet3">
        <bpmn:lane id="W1967_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W1967_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1967_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1967_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1967_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1967_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1967_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1967_Start4" name="Government invoice past due; monthly collection cycle">
        <bpmn:outgoing>W1967_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W1967_Task5" name="Monthly: AR Clerk generates government AR aging report: (a) by entity type…">
        <bpmn:documentation>Step 1: Monthly: AR Clerk generates government AR aging report: (a) by entity type (national govt, LGU, GOCC), (b) aging buckets: current, 30, 60, 90, 120+ days, (c) government accounts typically have longer collection cycle: average DSO 45–75 days vs. 30 days for trade accounts
Responsible (R): AR Clerk / System
Accountable (A): Accounting Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1967_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1967_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1967_Task6" name="Weekly: AR Clerk follows up on overdue government invoices: (a) 30+ days: call…">
        <bpmn:documentation>Step 2: Weekly: AR Clerk follows up on overdue government invoices: (a) 30+ days: call government accounting department, (b) 60+ days: Trade Account Manager contacts procurement officer for intervention, (c) 90+ days: escalate to VP Store Operations for management-level follow-up, (d) 120+ days: VP Legal issues formal demand letter
Responsible (R): AR Clerk / Trade Account Manager
Accountable (A): Accounting Manager
Duration: 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W1967_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1967_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1967_Task7" name="Collection tactics for government: (a) leverage relationship: Trade Account…">
        <bpmn:documentation>Step 3: Collection tactics for government: (a) leverage relationship: Trade Account Manager follows up during next sales interaction, (b) pre-payment verification: ensure all required documents submitted (government won&#x27;t pay without complete documentation), (c) COA (Commission on Audit) clearance: some payments require COA audit before release; ensure compliance
Responsible (R): Trade Account Manager / AR Clerk
Accountable (A): VP Store Operations
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1967_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1967_End8" name="Complete">
        <bpmn:incoming>W1967_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1967_Annotation9">
        <bpmn:text>Controls: - CTL-191 (ensure B2G procurement compliance &amp; collection.) | - operational: standard operating procedures; system-enforced validation rules
Owner: AR Clerk</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1967_Assoc10" sourceRef="W1967_Annotation9" targetRef="W1967_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1967_Flow11" sourceRef="W1967_Start4" targetRef="W1967_Task5" />
      <bpmn:sequenceFlow id="W1967_Flow12" sourceRef="W1967_Task5" targetRef="W1967_Task6" />
      <bpmn:sequenceFlow id="W1967_Flow13" sourceRef="W1967_Task6" targetRef="W1967_Task7" />
      <bpmn:sequenceFlow id="W1967_Flow14" sourceRef="W1967_Task7" targetRef="W1967_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1967_diag">
      <bpmndi:BPMNPlane id="W1967_plane" bpmnElement="W_W1967">
        <bpmndi:BPMNShape id="W1967_Lane1_di" bpmnElement="W1967_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Lane2_di" bpmnElement="W1967_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Task5_di" bpmnElement="W1967_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Task6_di" bpmnElement="W1967_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Task7_di" bpmnElement="W1967_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Start4_di" bpmnElement="W1967_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_End8_di" bpmnElement="W1967_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1967_Annotation9_di" bpmnElement="W1967_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1967_Flow11_di" bpmnElement="W1967_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1967_Flow12_di" bpmnElement="W1967_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1967_Flow13_di" bpmnElement="W1967_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1967_Flow14_di" bpmnElement="W1967_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1967_Assoc10_di" bpmnElement="W1967_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1968" name="W1968. Government EWT Certificate (BIR 2307) Collection &amp; Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Government entity withholds EWT on payment; quarterly BIR filing
Frequency: Per payment (EWT withheld); quarterly reconciliation
Volume: ~200–300 government payments/year with EWT
Owner: Tax Accountant
Participants: Tax Accountant, AR Clerk, Trade Account Manager
Source: workflow W1968 — Government EWT Certificate (BIR 2307) Collection &amp; Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W1968_LaneSet4">
        <bpmn:lane id="W1968_Lane1" name="AR Clerk">
        <bpmn:flowNodeRef>W1968_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1968_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1968_Lane2" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1968_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1968_Lane3" name="Tax Accountant">
        <bpmn:flowNodeRef>W1968_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1968_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1968_Start5" name="Government entity withholds EWT on payment; quarterly BIR filing">
        <bpmn:outgoing>W1968_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1968_Task6" name="Government entity withholds 1% EWT on payment: (a) government pays net of 1%…">
        <bpmn:documentation>Step 1: Government entity withholds 1% EWT on payment: (a) government pays net of 1% EWT (e.g., PHP 100K invoice → government pays PHP 99K + issues BIR Form 2307 for PHP 1K EWT), (b) AR Clerk records: (i) cash received: PHP 99K, (ii) EWT receivable: PHP 1K, (iii) AR cleared: PHP 100K
Responsible (R): AR Clerk
Accountable (A): Accounting Manager
Duration: Per payment</bpmn:documentation>
        <bpmn:incoming>W1968_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1968_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1968_Task7" name="BIR Form 2307 collection: (a) government entity issues BIR Form 2307…">
        <bpmn:documentation>Step 2: BIR Form 2307 collection: (a) government entity issues BIR Form 2307 (Certificate of Creditable Tax Withheld at Source), (b) Trade Account Manager follows up for 2307 issuance if not provided with payment, (c) collect 2307 within 30 days of payment — required for quarterly income tax filing
Responsible (R): Trade Account Manager / Tax Accountant
Accountable (A): Accounting Manager
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W1968_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1968_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1968_Task8" name="Quarterly: Tax Accountant reconciles government EWT: (a) total EWT withheld by…">
        <bpmn:documentation>Step 3: Quarterly: Tax Accountant reconciles government EWT: (a) total EWT withheld by all government entities in quarter, (b) total BIR 2307 certificates collected, (c) uncollected 2307: follow-up list for Trade Account Manager, (d) credit EWT against quarterly income tax payment per BIR 1702Q
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 1–2 days/quarter</bpmn:documentation>
        <bpmn:incoming>W1968_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1968_End9" name="Complete">
        <bpmn:incoming>W1968_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1968_Annotation10">
        <bpmn:text>Controls: - CTL-381 (ensure controlled execution — Government Billing, Collection &amp; Compliance (PA-46.3).) | - operational: periodic reconciliation against source documents
Owner: Tax Accountant</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1968_Assoc11" sourceRef="W1968_Annotation10" targetRef="W1968_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1968_Flow12" sourceRef="W1968_Start5" targetRef="W1968_Task6" />
      <bpmn:sequenceFlow id="W1968_Flow13" sourceRef="W1968_Task6" targetRef="W1968_Task7" />
      <bpmn:sequenceFlow id="W1968_Flow14" sourceRef="W1968_Task7" targetRef="W1968_Task8" />
      <bpmn:sequenceFlow id="W1968_Flow15" sourceRef="W1968_Task8" targetRef="W1968_End9" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1968_diag">
      <bpmndi:BPMNPlane id="W1968_plane" bpmnElement="W_W1968">
        <bpmndi:BPMNShape id="W1968_Lane1_di" bpmnElement="W1968_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Lane2_di" bpmnElement="W1968_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Lane3_di" bpmnElement="W1968_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Task6_di" bpmnElement="W1968_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Task7_di" bpmnElement="W1968_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Task8_di" bpmnElement="W1968_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Start5_di" bpmnElement="W1968_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_End9_di" bpmnElement="W1968_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1968_Annotation10_di" bpmnElement="W1968_Annotation10"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1968_Flow12_di" bpmnElement="W1968_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1968_Flow13_di" bpmnElement="W1968_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1968_Flow14_di" bpmnElement="W1968_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1968_Flow15_di" bpmnElement="W1968_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1968_Assoc11_di" bpmnElement="W1968_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1969" name="W1969. Government Year-End Liquidation &amp; Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Year-end government reporting cycle
Frequency: Annual
Volume: Consolidated government sales reporting
Owner: Accounting Manager
Participants: Accounting Manager, Tax Accountant, Trade Account Manager, CFO
Source: workflow W1969 — Government Year-End Liquidation &amp; Reporting</bpmn:documentation>
      <bpmn:laneSet id="W1969_LaneSet4">
        <bpmn:lane id="W1969_Lane1" name="Accounting Manager">
        <bpmn:flowNodeRef>W1969_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1969_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1969_Lane2" name="Tax Accountant">
        <bpmn:flowNodeRef>W1969_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1969_Lane3" name="Trade Account Manager">
        <bpmn:flowNodeRef>W1969_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1969_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1969_Start5" name="Year-end government reporting cycle">
        <bpmn:outgoing>W1969_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1969_Task6" name="Accounting Manager compiles annual government sales report: (a) total…">
        <bpmn:documentation>Step 1: Accounting Manager compiles annual government sales report: (a) total government revenue by entity type, (b) total government sales invoices issued, (c) total EWT withheld by government entities, (d) total BIR 2307 collected, (e) total government accounts receivable balance at year-end, (f) bad debt provision for government AR
Responsible (R): Accounting Manager
Accountable (A): CFO
Duration: 2–3 days/year</bpmn:documentation>
        <bpmn:incoming>W1969_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1969_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1969_Task7" name="Tax Accountant reconciles government EWT for annual income tax return: (a)…">
        <bpmn:documentation>Step 2: Tax Accountant reconciles government EWT for annual income tax return: (a) total EWT per BIR 2307 certificates, (b) credit against annual income tax liability per BIR 1702RT, (c) any uncollected 2307: document and carry forward to next year
Responsible (R): Tax Accountant
Accountable (A): CFO
Duration: 1–2 days/year</bpmn:documentation>
        <bpmn:incoming>W1969_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1969_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1969_Task8" name="Trade Account Manager prepares government relationship report: (a) active…">
        <bpmn:documentation>Step 3: Trade Account Manager prepares government relationship report: (a) active government accounts and their status, (b) contracts expiring in next year requiring renewal, (c) collection performance: average DSO by entity type, (d) pipeline for next year
Responsible (R): Trade Account Manager
Accountable (A): VP Store Operations
Duration: 1 day/year</bpmn:documentation>
        <bpmn:incoming>W1969_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W1969_End9" name="Complete">
        <bpmn:incoming>W1969_Flow15</bpmn:incoming>
      </bpmn:endEvent>
