        <bpmndi:BPMNShape id="W3546_End7_di" bpmnElement="W3546_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3546_Annotation8_di" bpmnElement="W3546_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3546_Flow10_di" bpmnElement="W3546_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3546_Flow11_di" bpmnElement="W3546_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3546_Flow12_di" bpmnElement="W3546_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3546_Flow13_di" bpmnElement="W3546_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3546_Assoc9_di" bpmnElement="W3546_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3547" name="W3547. Project Prioritization, Scoring &amp; Resource Allocation" isExecutable="false">
      <bpmn:documentation>Trigger: Intake (W3546); portfolio cycle; resource constraint
Frequency: Quarterly + on constraint
Volume: Project pipeline
Owner: PMO / Strategy
Participants: PMO, Strategy (links to VS-33), Finance (links to VS-40/VS-17.4), Sponsors, Resource Owners (links to VS-19), Executive Committee
Source: workflow W3547 — Project Prioritization, Scoring &amp; Resource Allocation</bpmn:documentation>
      <bpmn:laneSet id="W3547_LaneSet2">
        <bpmn:lane id="W3547_Lane1" name="PMO">
        <bpmn:flowNodeRef>W3547_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3547_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3547_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3547_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3547_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3547_Start3" name="Intake (W3546); portfolio cycle; resource constraint">
        <bpmn:outgoing>W3547_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3547_Task4" name="PMO/Strategy score and prioritize projects against criteria: strategic…">
        <bpmn:documentation>Step 1: PMO/Strategy score and prioritize projects against criteria: strategic alignment (links to VS-33), financial return (NPV/IRR/payback links to VS-40), risk, urgency/regulatory (links to VS-22), resource demand (W3553), and dependencies (W3550); produce the ranked portfolio view
Responsible (R): PMO / Strategy / Finance
Accountable (A): PMO Director
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3547_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3547_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3547_Task5" name="PMO/Finance allocate the portfolio to the investment envelope (links to…">
        <bpmn:documentation>Step 2: PMO/Finance allocate the portfolio to the investment envelope (links to VS-33.1/VS-40/VS-17.4) and resource/capacity (W3553): approve/defer/reject per ranking, balance across categories and the capital/OpEx split, and manage trade-offs; sequence against the multi-year plan
Responsible (R): PMO / Finance
Accountable (A): COO / CFO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3547_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3547_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3547_Task6" name="PMO publish the prioritized portfolio and resource allocation, communicate…">
        <bpmn:documentation>Step 3: PMO publish the prioritized portfolio and resource allocation, communicate approve/defer/reject decisions to sponsors, and update the portfolio register (W3546) and dashboards (W3552); re-prioritize on change (new request, constraint, strategic shift)
Responsible (R): PMO
Accountable (A): COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3547_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3547_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3547_End7" name="Complete">
        <bpmn:incoming>W3547_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3547_Annotation8">
        <bpmn:text>Controls: - CTL-565 (ensure controlled execution — Project Portfolio Governance, Prioritization &amp; Stage-Gate (PA-112.1).) | - operational: transparent scoring; operational: capacity-aware allocation (W3553)
Owner: PMO / Strategy</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3547_Assoc9" sourceRef="W3547_Annotation8" targetRef="W3547_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3547_Flow10" sourceRef="W3547_Start3" targetRef="W3547_Task4" />
      <bpmn:sequenceFlow id="W3547_Flow11" sourceRef="W3547_Task4" targetRef="W3547_Task5" />
      <bpmn:sequenceFlow id="W3547_Flow12" sourceRef="W3547_Task5" targetRef="W3547_Task6" />
      <bpmn:sequenceFlow id="W3547_Flow13" sourceRef="W3547_Task6" targetRef="W3547_End7" />
    </bpmn:process>
