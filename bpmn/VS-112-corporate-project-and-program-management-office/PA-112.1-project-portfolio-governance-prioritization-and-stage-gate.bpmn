        <bpmndi:BPMNShape id="W3547_Start3_di" bpmnElement="W3547_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3547_End7_di" bpmnElement="W3547_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3547_Annotation8_di" bpmnElement="W3547_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3547_Flow10_di" bpmnElement="W3547_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3547_Flow11_di" bpmnElement="W3547_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3547_Flow12_di" bpmnElement="W3547_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3547_Flow13_di" bpmnElement="W3547_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3547_Assoc9_di" bpmnElement="W3547_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3548" name="W3548. Stage-Gate Methodology &amp; Project Lifecycle Standards" isExecutable="false">
      <bpmn:documentation>Trigger: Portfolio strategy (W3545); methodology review
Frequency: Maintained + per-project application
Volume: All projects
Owner: PMO
Participants: PMO, Delivery Leads (links to VS-20/VS-37/VS-109/VS-108/VS-27), Quality (links to VS-31), Finance (links to VS-40), Sponsors
Source: workflow W3548 — Stage-Gate Methodology &amp; Project Lifecycle Standards</bpmn:documentation>
      <bpmn:laneSet id="W3548_LaneSet2">
        <bpmn:lane id="W3548_Lane1" name="PMO">
        <bpmn:flowNodeRef>W3548_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3548_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3548_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3548_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3548_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3548_Start3" name="Portfolio strategy (W3545); methodology review">
        <bpmn:outgoing>W3548_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3548_Task4" name="PMO maintain the stage-gate methodology and project-lifecycle standards: stages…">
        <bpmn:documentation>Step 1: PMO maintain the stage-gate methodology and project-lifecycle standards: stages (initiate → plan → execute → close, with domain-specific gates for capital/IT/transformation), gate criteria/deliverables, go/no-go/kill decisions, and the documentation/templates per stage (charter, plan, business case, risk register, closure); align to PMBOK/PRINCE2/Agile as appropriate
Responsible (R): PMO
Accountable (A): PMO Director
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3548_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3548_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3548_Task5" name="PMO apply the stage-gate to each project: review gate readiness (deliverables…">
        <bpmn:documentation>Step 2: PMO apply the stage-gate to each project: review gate readiness (deliverables, budget/schedule/benefit status, risk), conduct the gate review with the sponsor/governance, and make the go/no-go/kill/hold decision; capture the decision and conditions
Responsible (R): PMO / Sponsor / Governance
Accountable (A): PMO Director
Duration: Per gate</bpmn:documentation>
        <bpmn:incoming>W3548_Flow11</bpmn:incoming>
