    <bpmn:process id="W_W3552" name="W3552. Portfolio Dashboards, Reporting &amp; Executive / Board Oversight" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cycle; exec/board cycle (links to VS-33.2/VS-36)
Frequency: Monthly + quarterly
Volume: Enterprise portfolio
Owner: PMO
Participants: PMO, BI (links to VS-28.1), Strategy (links to VS-33.2), Finance (links to VS-17.4), Executive Committee, Board (links to VS-36)
Source: workflow W3552 — Portfolio Dashboards, Reporting &amp; Executive / Board Oversight</bpmn:documentation>
      <bpmn:laneSet id="W3552_LaneSet2">
        <bpmn:lane id="W3552_Lane1" name="PMO">
        <bpmn:flowNodeRef>W3552_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3552_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3552_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3552_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3552_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3552_Start3" name="Monthly cycle; exec/board cycle (links to VS-33.2/VS-36)">
        <bpmn:outgoing>W3552_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3552_Task4" name="PMO/BI produce the portfolio dashboards: status of all projects/programs…">
        <bpmn:documentation>Step 1: PMO/BI produce the portfolio dashboards: status of all projects/programs (stage, schedule, budget, benefits, risk, issues), portfolio KPIs (on-time/on-budget %, stage-gate compliance, benefits realization), resource utilization (W3553), and pipeline; tailored views per audience (PMO/exec/board)
Responsible (R): PMO / BI
Accountable (A): PMO Director
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3552_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3552_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3552_Task5" name="PMO/Strategy report the portfolio to the executive committee (links to…">
        <bpmn:documentation>Step 2: PMO/Strategy report the portfolio to the executive committee (links to VS-33.2): performance vs plan, at-risk projects/programs, decisions needed (re-prioritize, kill, fund), and strategic alignment; drive decisions and actions
Responsible (R): PMO / Strategy
Accountable (A): COO / CEO
Duration: Monthly/quarterly</bpmn:documentation>
        <bpmn:incoming>W3552_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3552_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3552_Task6" name="PMO/COO report to the Board (links to VS-36): major capital and transformation…">
        <bpmn:documentation>Step 3: PMO/COO report to the Board (links to VS-36): major capital and transformation programs, portfolio health, risk, and benefits; ensure board oversight of significant projects (per authority links to VS-36) and alignment to corporate strategy
Responsible (R): PMO / COO
Accountable (A): CEO / Board
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3552_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3552_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3552_End7" name="Complete">
        <bpmn:incoming>W3552_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3552_Annotation8">
        <bpmn:text>Controls: - CTL-137 (ensure project portfolio approval &amp; cost control.) | - operational: data discipline; operational: audience-tailored views
Owner: PMO</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3552_Assoc9" sourceRef="W3552_Annotation8" targetRef="W3552_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3552_Flow10" sourceRef="W3552_Start3" targetRef="W3552_Task4" />
      <bpmn:sequenceFlow id="W3552_Flow11" sourceRef="W3552_Task4" targetRef="W3552_Task5" />
      <bpmn:sequenceFlow id="W3552_Flow12" sourceRef="W3552_Task5" targetRef="W3552_Task6" />
      <bpmn:sequenceFlow id="W3552_Flow13" sourceRef="W3552_Task6" targetRef="W3552_End7" />
    </bpmn:process>
