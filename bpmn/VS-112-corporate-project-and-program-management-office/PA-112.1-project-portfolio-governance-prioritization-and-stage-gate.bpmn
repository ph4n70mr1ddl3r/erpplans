      <bpmndi:BPMNPlane id="W3547_plane" bpmnElement="W_W3547">
        <bpmndi:BPMNShape id="W3547_Lane1_di" bpmnElement="W3547_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3547_Task4_di" bpmnElement="W3547_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
