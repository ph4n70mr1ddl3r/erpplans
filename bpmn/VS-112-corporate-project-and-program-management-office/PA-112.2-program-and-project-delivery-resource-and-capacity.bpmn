<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-112.2-program-and-project-delivery-resource-and-capacity" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3553" name="W3553. Project Manager Assignment, Resource &amp; Capacity Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Project approval (W3551); portfolio cycle (W3547)
Frequency: Per project + portfolio capacity
Volume: PM/resource pool across the portfolio
Owner: PMO / Resource Owners
Participants: PMO, HR/Resource Management (links to VS-19/VS-103), Project Managers, Department Heads, Finance (links to VS-40)
Source: workflow W3553 — Project Manager Assignment, Resource &amp; Capacity Planning</bpmn:documentation>
      <bpmn:laneSet id="W3553_LaneSet2">
        <bpmn:lane id="W3553_Lane1" name="PMO">
        <bpmn:flowNodeRef>W3553_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3553_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3553_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3553_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3553_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3553_Start3" name="Project approval (W3551); portfolio cycle (W3547)">
        <bpmn:outgoing>W3553_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3553_Task4" name="PMO/HR assign the Project Manager and core team per project (W3551): match PM…">
        <bpmn:documentation>Step 1: PMO/HR assign the Project Manager and core team per project (W3551): match PM capability to project type/size, confirm availability vs other commitments (capacity), and negotiate resource commitment with department heads; manage internal vs external/contractor PMs (links to VS-98)
Responsible (R): PMO / HR / Department Heads
Accountable (A): PMO Director
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3553_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3553_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3553_Task5" name="PMO maintain the enterprise resource/capacity view: PM and specialist resource…">
        <bpmn:documentation>Step 2: PMO maintain the enterprise resource/capacity view: PM and specialist resource pool, utilization/allocation across active projects/programs (links to W3549), forecast demand from the pipeline (W3546/W3547), and identify capacity gaps; balance load to avoid over-allocation
Responsible (R): PMO / HR
Accountable (A): PMO Director
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3553_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3553_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3553_Task6" name="PMO/HR address capacity gaps: hire/contract (links to VS-19.1/VS-98)…">
        <bpmn:documentation>Step 3: PMO/HR address capacity gaps: hire/contract (links to VS-19.1/VS-98), reallocate, defer projects (W3547), or partner/vendor (links to VS-34.2); report resource utilization and capacity risk to governance (W3550/W3552)
Responsible (R): PMO / HR
Accountable (A): PMO Director / COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3553_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3553_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3553_End7" name="Complete">
        <bpmn:incoming>W3553_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3553_Annotation8">
        <bpmn:text>Controls: - CTL-566 (ensure controlled execution — Program &amp; Project Delivery Management, Resource &amp; Capacity (PA-112.2).) | - operational: capacity planning; operational: capability matching
Owner: PMO / Resource Owners</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3553_Assoc9" sourceRef="W3553_Annotation8" targetRef="W3553_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3553_Flow10" sourceRef="W3553_Start3" targetRef="W3553_Task4" />
      <bpmn:sequenceFlow id="W3553_Flow11" sourceRef="W3553_Task4" targetRef="W3553_Task5" />
      <bpmn:sequenceFlow id="W3553_Flow12" sourceRef="W3553_Task5" targetRef="W3553_Task6" />
      <bpmn:sequenceFlow id="W3553_Flow13" sourceRef="W3553_Task6" targetRef="W3553_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3553_diag">
      <bpmndi:BPMNPlane id="W3553_plane" bpmnElement="W_W3553">
        <bpmndi:BPMNShape id="W3553_Lane1_di" bpmnElement="W3553_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
