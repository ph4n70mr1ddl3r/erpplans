    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3555" name="W3555. Project Budget &amp; Cost Control" isExecutable="false">
      <bpmn:documentation>Trigger: Approved budget (W3551/VS-40); monthly cycle
Frequency: Continuous + monthly
Volume: All projects
Owner: Project Manager / Finance
Participants: Project Manager, Finance (links to VS-40/VS-17), PMO, Procurement (links to VS-03/VS-34), Contractors, Sponsor
Source: workflow W3555 — Project Budget &amp; Cost Control</bpmn:documentation>
      <bpmn:laneSet id="W3555_LaneSet3">
        <bpmn:lane id="W3555_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W3555_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3555_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3555_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3555_Lane2" name="PMO">
        <bpmn:flowNodeRef>W3555_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3555_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3555_Start4" name="Approved budget (W3551/VS-40); monthly cycle">
        <bpmn:outgoing>W3555_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3555_Task5" name="Project Manager/Finance establish the project budget baseline from the business…">
        <bpmn:documentation>Step 1: Project Manager/Finance establish the project budget baseline from the business case (W3551) and capex approval (links to VS-40/W1814): cost by WBS/category (materials, labor, services, equipment, contingency), commitments (PO/contract links to VS-40/W1817), and the cost-control plan
Responsible (R): Project Manager / Finance
Accountable (A): Sponsor / CFO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3555_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3555_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3555_Task6" name="Project Manager/Finance control cost during execution: capture…">
        <bpmn:documentation>Step 2: Project Manager/Finance control cost during execution: capture actuals/commitments (links to VS-40/W1819), forecast estimate-at-completion (EAC), manage variance, approve/decline spend within authority, and manage change-cost (W3556); coordinate AP/payments (links to VS-15/W1820)
Responsible (R): Project Manager / Finance
Accountable (A): Sponsor
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3555_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3555_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3555_Task7" name="PMO/Finance report project and portfolio cost performance (CPI…">
        <bpmn:documentation>Step 3: PMO/Finance report project and portfolio cost performance (CPI, budget-vs-actual, EAC, variance) to dashboards (W3552) and capex portfolio (links to VS-40/W1825/W3564); manage overruns via change control (W3556) and governance escalation
Responsible (R): PMO / Finance
Accountable (A): PMO Director / CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3555_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3555_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3555_End8" name="Complete">
        <bpmn:incoming>W3555_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3555_Annotation9">
        <bpmn:text>Controls: - CTL-137 (ensure project portfolio approval &amp; cost control.) | - operational: cost control and change management (W3556); operational: commitment tracking (links to VS-40)
Owner: Project Manager / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3555_Assoc10" sourceRef="W3555_Annotation9" targetRef="W3555_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3555_Flow11" sourceRef="W3555_Start4" targetRef="W3555_Task5" />
      <bpmn:sequenceFlow id="W3555_Flow12" sourceRef="W3555_Task5" targetRef="W3555_Task6" />
      <bpmn:sequenceFlow id="W3555_Flow13" sourceRef="W3555_Task6" targetRef="W3555_Task7" />
      <bpmn:sequenceFlow id="W3555_Flow14" sourceRef="W3555_Task7" targetRef="W3555_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3555_diag">
      <bpmndi:BPMNPlane id="W3555_plane" bpmnElement="W_W3555">
        <bpmndi:BPMNShape id="W3555_Lane1_di" bpmnElement="W3555_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Lane2_di" bpmnElement="W3555_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Task5_di" bpmnElement="W3555_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Task6_di" bpmnElement="W3555_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Task7_di" bpmnElement="W3555_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Start4_di" bpmnElement="W3555_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_End8_di" bpmnElement="W3555_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3555_Annotation9_di" bpmnElement="W3555_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3555_Flow11_di" bpmnElement="W3555_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3555_Flow12_di" bpmnElement="W3555_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3555_Flow13_di" bpmnElement="W3555_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3555_Flow14_di" bpmnElement="W3555_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3555_Assoc10_di" bpmnElement="W3555_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3556" name="W3556. Project Scope, Change &amp; Configuration Management" isExecutable="false">
      <bpmn:documentation>Trigger: Change request (scope/schedule/budget/quality); configuration need
Frequency: Event-driven
Volume: Changes across the portfolio
Owner: Project Manager / PMO
Participants: Project Manager, Sponsor, PMO, Finance (links to VS-40), Quality (links to VS-31), Stakeholders, Vendors
Source: workflow W3556 — Project Scope, Change &amp; Configuration Management</bpmn:documentation>
      <bpmn:laneSet id="W3556_LaneSet3">
        <bpmn:lane id="W3556_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W3556_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3556_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3556_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3556_Lane2" name="Sponsor">
        <bpmn:flowNodeRef>W3556_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3556_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3556_Start4" name="Change request (scope/schedule/budget/quality); configuration need">
        <bpmn:outgoing>W3556_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3556_Task5" name="Project Manager receive and log the change request: description, originator…">
        <bpmn:documentation>Step 1: Project Manager receive and log the change request: description, originator, rationale, scope/schedule/budget/quality impact assessment, and alternatives; classify (minor/major) and route per the change-control authority (links to VS-36)
Responsible (R): Project Manager / PMO
Accountable (A): Sponsor
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W3556_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3556_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3556_Task6" name="Sponsor/PMO review and decide on the change: approve/reject/defer per authority…">
        <bpmn:documentation>Step 2: Sponsor/PMO review and decide on the change: approve/reject/defer per authority (links to VS-40 scope-change W1815), assess impact on the baseline (W3554/W3555), benefits (W3561), and dependencies (W3550); document the decision and conditions
Responsible (R): Sponsor / PMO / Finance
Accountable (A): Sponsor / Governance
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W3556_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3556_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3556_Task7" name="Project Manager implement approved changes: update the baseline…">
        <bpmn:documentation>Step 3: Project Manager implement approved changes: update the baseline (scope/schedule/budget W3554/W3555), communicate (W3559), and manage configuration (versions, deliverables, documentation) for traceability; track change impact for lessons (W3560)
Responsible (R): Project Manager / Team
Accountable (A): Sponsor
Duration: Per change</bpmn:documentation>
        <bpmn:incoming>W3556_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3556_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3556_End8" name="Complete">
        <bpmn:incoming>W3556_Flow14</bpmn:incoming>
      </bpmn:endEvent>
