    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3554" name="W3554. Project Planning, Scheduling &amp; WBS Management" isExecutable="false">
      <bpmn:documentation>Trigger: Project charter (W3551); stage-gate plan
Frequency: Per project + maintained
Volume: All projects
Owner: Project Manager
Participants: Project Manager, Team, PMO, Sponsor, Contractors/Vendors (links to VS-03/VS-34), Delivery-domain leads (links to VS-20/VS-27/etc.)
Source: workflow W3554 — Project Planning, Scheduling &amp; WBS Management</bpmn:documentation>
      <bpmn:laneSet id="W3554_LaneSet3">
        <bpmn:lane id="W3554_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W3554_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3554_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3554_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3554_Lane2" name="PMO">
        <bpmn:flowNodeRef>W3554_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3554_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3554_Start4" name="Project charter (W3551); stage-gate plan">
        <bpmn:outgoing>W3554_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3554_Task5" name="Project Manager develop the project plan: work-breakdown-structure (WBS)…">
        <bpmn:documentation>Step 1: Project Manager develop the project plan: work-breakdown-structure (WBS), activities, durations, dependencies, milestones, critical path, resources (W3553), and the baseline schedule; integrate with the delivery-domain plan (e.g., construction links to VS-20/W3480, IT links to VS-27/W132 SDLC)
Responsible (R): Project Manager / Team
Accountable (A): Sponsor / PMO
Duration: Per project</bpmn:documentation>
        <bpmn:incoming>W3554_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3554_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3554_Task6" name="Project Manager maintain and update the schedule: track progress vs baseline…">
        <bpmn:documentation>Step 2: Project Manager maintain and update the schedule: track progress vs baseline, manage slippage/critical-path, re-forecast, and communicate changes (W3556/W3559); manage contractor/vendor schedules (links to VS-03/VS-34) and integrate to the program (W3549)
Responsible (R): Project Manager
Accountable (A): Sponsor / PMO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3554_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3554_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3554_Task7" name="PMO review schedule health across the portfolio (on-time %, critical-path risk…">
        <bpmn:documentation>Step 3: PMO review schedule health across the portfolio (on-time %, critical-path risk, slippage), enforce planning discipline, and feed to dashboards (W3552) and stage-gates (W3548); capture planning lessons (W3560)
Responsible (R): PMO
Accountable (A): PMO Director
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3554_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3554_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3554_End8" name="Complete">
        <bpmn:incoming>W3554_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3554_Annotation9">
        <bpmn:text>Controls: - CTL-566 (ensure controlled execution — Program &amp; Project Delivery Management, Resource &amp; Capacity (PA-112.2).) | - operational: critical-path management; operational: update discipline
Owner: Project Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3554_Assoc10" sourceRef="W3554_Annotation9" targetRef="W3554_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3554_Flow11" sourceRef="W3554_Start4" targetRef="W3554_Task5" />
      <bpmn:sequenceFlow id="W3554_Flow12" sourceRef="W3554_Task5" targetRef="W3554_Task6" />
      <bpmn:sequenceFlow id="W3554_Flow13" sourceRef="W3554_Task6" targetRef="W3554_Task7" />
      <bpmn:sequenceFlow id="W3554_Flow14" sourceRef="W3554_Task7" targetRef="W3554_End8" />
    </bpmn:process>
