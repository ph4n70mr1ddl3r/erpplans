      <bpmn:sequenceFlow id="W4554_Flow12" sourceRef="W4554_Task5" targetRef="W4554_Task6" />
      <bpmn:sequenceFlow id="W4554_Flow13" sourceRef="W4554_Task6" targetRef="W4554_End7" />
    </bpmn:process>
