      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4555" name="W4555. Brokerage/Referral Licensing, Accreditation &amp; Contract Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Partner onboarding (W4554); regulatory requirement
Frequency: Per partner + renewal
Volume: Brokerage accreditation/licensing across the lender network
Owner: Legal (VS-100.3) / Compliance (VS-22) / Commercial
Participants: Finance (VS-17), Risk (VS-21.2), Tax (VS-79), Trade (VS-11)
Source: workflow W4555 — Brokerage/Referral Licensing, Accreditation &amp; Contract Setup</bpmn:documentation>
      <bpmn:laneSet id="W4555_LaneSet3">
        <bpmn:lane id="W4555_Lane1" name="Legal">
        <bpmn:flowNodeRef>W4555_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4555_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4555_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4555_Lane2" name="Compliance">
        <bpmn:flowNodeRef>W4555_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4555_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4555_Start4" name="Partner onboarding (W4554); regulatory requirement">
        <bpmn:outgoing>W4555_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4555_Task5" name="Legal/Compliance determine BuildRight&#x27;s brokerage/accreditation status…">
        <bpmn:documentation>Step 1: Legal/Compliance determine BuildRight&#x27;s brokerage/accreditation status (accredited real-estate/marketing partner, loan-soliciting agent where BSP rules allow), and secure any required registrations/accreditations
Responsible (R): Legal / Compliance
Accountable (A): VP Legal / CFO
Duration: Per setup</bpmn:documentation>
        <bpmn:incoming>W4555_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4555_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4555_Task6" name="Legal/Commercial execute brokerage/referral agreements with each lender (scope…">
        <bpmn:documentation>Step 2: Legal/Commercial execute brokerage/referral agreements with each lender (scope, commission, compliance obligations, data/privacy, liability), per VS-100.3
Responsible (R): Legal / Commercial
Accountable (A): VP Legal / CFO
Duration: Per partner</bpmn:documentation>
        <bpmn:incoming>W4555_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4555_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4555_Task7" name="Compliance/Tax manage ongoing brokerage compliance (BSP consumer-protection…">
        <bpmn:documentation>Step 3: Compliance/Tax manage ongoing brokerage compliance (BSP consumer-protection, disclosure, tax on commission VS-79) and the accreditation lifecycle
Responsible (R): Compliance / Tax
Accountable (A): VP Legal / CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4555_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4555_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4555_End8" name="Complete">
        <bpmn:incoming>W4555_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4555_Annotation9">
        <bpmn:text>Controls: - CTL-113 (ensure construction-finance brokerage compliance.) | - CTL-692: brokerage properly accredited (VS-100.3/VS-22); disclosure compliant; commission tax-treated (VS-79)
Owner: Legal (VS-100.3) / Compliance (VS-22) / Commercial</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4555_Assoc10" sourceRef="W4555_Annotation9" targetRef="W4555_Start4" associationDirection="None" />
