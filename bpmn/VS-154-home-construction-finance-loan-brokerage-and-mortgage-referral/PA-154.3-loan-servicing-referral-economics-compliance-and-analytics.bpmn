    <bpmn:process id="W_W4570" name="W4570. Referral Commission, Incentive &amp; Revenue Management" isExecutable="false">
      <bpmn:documentation>Trigger: Loan closes/draws (W4566/W4567); commission cycle
Frequency: Per commission cycle (monthly)
Volume: Referral commission across closed/drawn loans
Owner: Finance (VS-17) / Commercial / Finance Strategy
Participants: Lenders, Treasury (VS-18), Tax (VS-79), HR/Comp (VS-102), Sales (VS-140)
Source: workflow W4570 — Referral Commission, Incentive &amp; Revenue Management</bpmn:documentation>
      <bpmn:laneSet id="W4570_LaneSet3">
        <bpmn:lane id="W4570_Lane1" name="Finance">
        <bpmn:flowNodeRef>W4570_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4570_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4570_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4570_Lane2" name="HR">
        <bpmn:flowNodeRef>W4570_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4570_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4570_Start4" name="Loan closes/draws (W4566/W4567); commission cycle">
        <bpmn:outgoing>W4570_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4570_Task5" name="Finance/Commercial calculate referral commission per lender agreements (W4555)…">
        <bpmn:documentation>Step 1: Finance/Commercial calculate referral commission per lender agreements (W4555) on closed/drawn loans, and reconcile to lender statements
Responsible (R): Finance / Commercial
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4570_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4570_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4570_Task6" name="Finance/Tax book referral revenue (commission income, VAT/withholding per…">
        <bpmn:documentation>Step 2: Finance/Tax book referral revenue (commission income, VAT/withholding per VS-79), and manage intercompany if applicable (VS-72)
Responsible (R): Finance / Tax
Accountable (A): CFO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4570_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4570_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4570_Task7" name="HR/Commercial pay frontline incentives (finance-desk/trade referral incentive…">
        <bpmn:documentation>Step 3: HR/Commercial pay frontline incentives (finance-desk/trade referral incentive per VS-102), aligned to compliant referrals (W4573), and report revenue to the board (VS-36)
Responsible (R): HR / Commercial / Finance
Accountable (A): CFO / CMO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W4570_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4570_End8" name="Complete">
        <bpmn:incoming>W4570_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4570_Annotation9">
        <bpmn:text>Controls: - CTL-694 (ensure controlled execution — Loan Servicing, Referral Economics, Compliance &amp; Analytics (PA-154.3).) | - CTL-694: commission reconciled to lender (W4555); revenue tax-treated (VS-79); incentives tied to compliant/suitable referrals (W4557)
Owner: Finance (VS-17) / Commercial / Finance Strategy</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4570_Assoc10" sourceRef="W4570_Annotation9" targetRef="W4570_Start4" associationDirection="None" />
