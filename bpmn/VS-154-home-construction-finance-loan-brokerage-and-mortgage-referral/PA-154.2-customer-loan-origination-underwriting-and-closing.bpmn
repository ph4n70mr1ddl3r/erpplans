        <bpmndi:BPMNShape id="W4561_Annotation8_di" bpmnElement="W4561_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4561_Flow10_di" bpmnElement="W4561_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4561_Flow11_di" bpmnElement="W4561_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4561_Flow12_di" bpmnElement="W4561_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4561_Flow13_di" bpmnElement="W4561_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4561_Assoc9_di" bpmnElement="W4561_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4562" name="W4562. Loan Application Intake &amp; Documentation" isExecutable="false">
      <bpmn:documentation>Trigger: Qualified lead (W4561); customer applies
Frequency: Per application
Volume: Loan applications across the partner network
Owner: Finance Desk / Lenders
Participants: Project Design (VS-66), Trade (VS-11), Compliance (VS-22), Privacy (VS-91)
Source: workflow W4562 — Loan Application Intake &amp; Documentation</bpmn:documentation>
      <bpmn:laneSet id="W4562_LaneSet2">
        <bpmn:lane id="W4562_Lane1" name="Finance Desk">
        <bpmn:flowNodeRef>W4562_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4562_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4562_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4562_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4562_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4562_Start3" name="Qualified lead (W4561); customer applies">
        <bpmn:outgoing>W4562_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4562_Task4" name="Finance Desk collect the application &amp; documentation (identity…">
        <bpmn:documentation>Step 1: Finance Desk collect the application &amp; documentation (identity, income/financials, property/project docs, contractor/quote VS-66) per lender checklist (W4556)
Responsible (R): Finance Desk / Customer
Accountable (A): Finance Desk Lead
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4562_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4562_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4562_Task5" name="Finance Desk/Privacy obtain consent (data-use, lender exchange, credit-bureau…">
        <bpmn:documentation>Step 2: Finance Desk/Privacy obtain consent (data-use, lender exchange, credit-bureau pull) per RA 10173 (VS-91), and validate document completeness
Responsible (R): Finance Desk / Privacy
Accountable (A): Finance Desk Lead / DPO
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4562_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4562_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4562_Task6" name="Finance Desk submit the complete application to the lender (W4565) and track…">
        <bpmn:documentation>Step 3: Finance Desk submit the complete application to the lender (W4565) and track status, keeping the customer informed
Responsible (R): Finance Desk / Lenders
Accountable (A): Finance Desk Lead
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4562_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4562_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4562_End7" name="Complete">
        <bpmn:incoming>W4562_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4562_Annotation8">
        <bpmn:text>Controls: - CTL-693 (ensure controlled execution — Customer Loan Origination, Underwriting &amp; Closing (PA-154.2).) | - CTL-693: application complete per lender checklist; consent obtained (VS-91); submission tracked
Owner: Finance Desk / Lenders</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4562_Assoc9" sourceRef="W4562_Annotation8" targetRef="W4562_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4562_Flow10" sourceRef="W4562_Start3" targetRef="W4562_Task4" />
      <bpmn:sequenceFlow id="W4562_Flow11" sourceRef="W4562_Task4" targetRef="W4562_Task5" />
      <bpmn:sequenceFlow id="W4562_Flow12" sourceRef="W4562_Task5" targetRef="W4562_Task6" />
      <bpmn:sequenceFlow id="W4562_Flow13" sourceRef="W4562_Task6" targetRef="W4562_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4562_diag">
      <bpmndi:BPMNPlane id="W4562_plane" bpmnElement="W_W4562">
        <bpmndi:BPMNShape id="W4562_Lane1_di" bpmnElement="W4562_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_Task4_di" bpmnElement="W4562_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_Task5_di" bpmnElement="W4562_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_Task6_di" bpmnElement="W4562_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_Start3_di" bpmnElement="W4562_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_End7_di" bpmnElement="W4562_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4562_Annotation8_di" bpmnElement="W4562_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4562_Flow10_di" bpmnElement="W4562_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4562_Flow11_di" bpmnElement="W4562_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4562_Flow12_di" bpmnElement="W4562_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4562_Flow13_di" bpmnElement="W4562_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4562_Assoc9_di" bpmnElement="W4562_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4563" name="W4563. Credit Assessment, Affordability &amp; Bureau Scoring Handoff" isExecutable="false">
      <bpmn:documentation>Trigger: Application submitted (W4562)
Frequency: Per application
Volume: Credit assessments across applications
Owner: Lenders (underwriting) / Finance Desk (handoff)
Participants: Risk (VS-21.2), Compliance (VS-22), Bureau/Credit data providers
Source: workflow W4563 — Credit Assessment, Affordability &amp; Bureau Scoring Handoff</bpmn:documentation>
      <bpmn:laneSet id="W4563_LaneSet3">
        <bpmn:lane id="W4563_Lane1" name="Lenders">
        <bpmn:flowNodeRef>W4563_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4563_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4563_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4563_Lane2" name="Finance Desk">
        <bpmn:flowNodeRef>W4563_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4563_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4563_Start4" name="Application submitted (W4562)">
        <bpmn:outgoing>W4563_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4563_Task5" name="Lenders perform credit assessment &amp; affordability (bureau score…">
        <bpmn:documentation>Step 1: Lenders perform credit assessment &amp; affordability (bureau score, debt-to-income, income verification) — the lender&#x27;s underwriting role, not BuildRight&#x27;s (W4557)
Responsible (R): Lenders
Accountable (A): Lender UW Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4563_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4563_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4563_Task6" name="Finance Desk/Lenders coordinate the credit-bureau pull &amp; supplementary info…">
        <bpmn:documentation>Step 2: Finance Desk/Lenders coordinate the credit-bureau pull &amp; supplementary info (with consent VS-91), and respond to underwriter queries
Responsible (R): Finance Desk / Lenders
Accountable (A): Finance Desk Lead
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4563_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4563_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4563_Task7" name="Lenders/Risk capture the credit decision (approve/decline/conditions), and…">
        <bpmn:documentation>Step 3: Lenders/Risk capture the credit decision (approve/decline/conditions), and Finance Desk communicates to the customer fairly &amp; without misleading reasons
Responsible (R): Lenders / Finance Desk
Accountable (A): Lender UW Manager / Finance Desk Lead
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4563_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4563_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4563_End8" name="Complete">
        <bpmn:incoming>W4563_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4563_Annotation9">
        <bpmn:text>Controls: - CTL-693 (ensure controlled execution — Customer Loan Origination, Underwriting &amp; Closing (PA-154.2).) | - CTL-693: underwriting is lender&#x27;s role (W4557); decisions communicated fairly; consent for bureau pull (VS-91)
Owner: Lenders (underwriting) / Finance Desk (handoff)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4563_Assoc10" sourceRef="W4563_Annotation9" targetRef="W4563_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4563_Flow11" sourceRef="W4563_Start4" targetRef="W4563_Task5" />
      <bpmn:sequenceFlow id="W4563_Flow12" sourceRef="W4563_Task5" targetRef="W4563_Task6" />
      <bpmn:sequenceFlow id="W4563_Flow13" sourceRef="W4563_Task6" targetRef="W4563_Task7" />
      <bpmn:sequenceFlow id="W4563_Flow14" sourceRef="W4563_Task7" targetRef="W4563_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4563_diag">
      <bpmndi:BPMNPlane id="W4563_plane" bpmnElement="W_W4563">
        <bpmndi:BPMNShape id="W4563_Lane1_di" bpmnElement="W4563_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Lane2_di" bpmnElement="W4563_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Task5_di" bpmnElement="W4563_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Task6_di" bpmnElement="W4563_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Task7_di" bpmnElement="W4563_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Start4_di" bpmnElement="W4563_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_End8_di" bpmnElement="W4563_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4563_Annotation9_di" bpmnElement="W4563_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4563_Flow11_di" bpmnElement="W4563_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4563_Flow12_di" bpmnElement="W4563_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4563_Flow13_di" bpmnElement="W4563_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4563_Flow14_di" bpmnElement="W4563_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4563_Assoc10_di" bpmnElement="W4563_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4564" name="W4564. Property/Project Valuation &amp; Collateral Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Collateralized loan (W4563); lender requirement
Frequency: Per collateralized application
Volume: Property/project valuations across housing-loan applications
Owner: Lenders / Appraisers / Project Design (VS-66)
Participants: Finance Desk, Trade (VS-11), Risk (VS-21.2), Legal (VS-100.3)
Source: workflow W4564 — Property/Project Valuation &amp; Collateral Assessment</bpmn:documentation>
      <bpmn:laneSet id="W4564_LaneSet3">
        <bpmn:lane id="W4564_Lane1" name="Lenders">
        <bpmn:flowNodeRef>W4564_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4564_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4564_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4564_Lane2" name="Project Design">
        <bpmn:flowNodeRef>W4564_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4564_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4564_Start4" name="Collateralized loan (W4563); lender requirement">
        <bpmn:outgoing>W4564_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4564_Task5" name="Lenders/Appraisers arrange property/project valuation (collateral value…">
        <bpmn:documentation>Step 1: Lenders/Appraisers arrange property/project valuation (collateral value, project scope/cost reasonableness per VS-66 quote), and title/lien check (VS-42/VS-100.3)
Responsible (R): Lenders / Appraisers / Legal
Accountable (A): Lender UW Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4564_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4564_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4564_Task6" name="Project Design/Trade provide the BuildRight scope/materials quote (VS-66/VS-11)…">
        <bpmn:documentation>Step 2: Project Design/Trade provide the BuildRight scope/materials quote (VS-66/VS-11) supporting the project-cost basis for the loan amount
Responsible (R): Project Design / Trade
Accountable (A): Project Design Manager
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4564_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4564_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4564_Task7" name="Lenders/Risk assess loan-to-value/collateral coverage, set conditions, and…">
        <bpmn:documentation>Step 3: Lenders/Risk assess loan-to-value/collateral coverage, set conditions, and complete the collateral assessment feeding approval (W4565)
Responsible (R): Lenders / Risk
Accountable (A): Lender UW Manager / Head of Internal Audit &amp; Risk
Duration: Per application</bpmn:documentation>
        <bpmn:incoming>W4564_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4564_Flow14</bpmn:outgoing>
      </bpmn:userTask>
