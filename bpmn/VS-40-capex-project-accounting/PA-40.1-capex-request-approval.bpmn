    <bpmn:process id="W_W1815" name="W1815. Capex Request Revision &amp; Scope Change Management" isExecutable="false">
      <bpmn:documentation>Trigger: Project scope change, cost increase, or timeline extension
Frequency: ~10–20 revisions/year
Volume: ~20–30% of projects require revision
Owner: Project Manager
Participants: Project Manager, FP&amp;A, CFO
Source: workflow W1815 — Capex Request Revision &amp; Scope Change Management</bpmn:documentation>
      <bpmn:laneSet id="W1815_LaneSet4">
        <bpmn:lane id="W1815_Lane1" name="Project Manager">
        <bpmn:flowNodeRef>W1815_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1815_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1815_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1815_Lane2" name="FP&amp;A">
        <bpmn:flowNodeRef>W1815_Task8</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1815_Lane3" name="System">
        <bpmn:flowNodeRef>W1815_Task9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1815_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1815_Start5" name="Project scope change, cost increase, or timeline extension">
        <bpmn:outgoing>W1815_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1815_Task6" name="Project Manager identifies need for scope change: (a) construction discovers…">
        <bpmn:documentation>Step 1: Project Manager identifies need for scope change: (a) construction discovers unforeseen site conditions (common in Philippine construction — soil issues, utility relocation), (b) vendor price increase since original quote, (c) design change requested by Store Operations, (d) regulatory requirement not initially anticipated, (e) scope reduction opportunity (value engineering)
Responsible (R): Project Manager
Accountable (A): Department Head
Duration: Event-driven</bpmn:documentation>
        <bpmn:incoming>W1815_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1815_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1815_Task7" name="Project Manager submits change order request: (a) description of change, (b)…">
        <bpmn:documentation>Step 2: Project Manager submits change order request: (a) description of change, (b) reason for change, (c) cost impact (increase or decrease), (d) schedule impact, (e) revised total project cost and timeline
Responsible (R): Project Manager
Accountable (A): FP&amp;A
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1815_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1815_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1815_Task8" name="FP&amp;A evaluates change order: (a) revised NPV/IRR if revenue impact, (b) revised…">
        <bpmn:documentation>Step 3: FP&amp;A evaluates change order: (a) revised NPV/IRR if revenue impact, (b) revised budget vs. available contingency, (c) if within original budget + contingency (&lt; 10% increase): CFO approves, (d) if exceeding contingency or &gt; 10% budget increase: requires approval per W1813 tiers
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1815_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1815_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1815_Task9" name="System updates project budget with approved change order; revised budget…">
        <bpmn:documentation>Step 4: System updates project budget with approved change order; revised budget tracked going forward
Responsible (R): System
Accountable (A): FP&amp;A
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1815_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1815_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1815_End10" name="Complete">
        <bpmn:incoming>W1815_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1815_Annotation11">
        <bpmn:text>Controls: - CTL-210 (ensure capex authorization &amp; commitment control.) | - operational: Project Manager review and approval gate
Owner: Project Manager</bpmn:text>
      </bpmn:textAnnotation>
