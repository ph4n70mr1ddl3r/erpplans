        <bpmndi:BPMNShape id="W1817_Annotation9_di" bpmnElement="W1817_Annotation9"><dc:Bounds x="160" y="460" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1817_Flow11_di" bpmnElement="W1817_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1817_Flow12_di" bpmnElement="W1817_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1817_Flow13_di" bpmnElement="W1817_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1817_Flow14_di" bpmnElement="W1817_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1817_Assoc10_di" bpmnElement="W1817_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1818" name="W1818. Capex Approval Documentation &amp; Audit Trail" isExecutable="false">
      <bpmn:documentation>Trigger: Capex request created; maintained throughout project lifecycle
Frequency: Continuous
Volume: All capex projects (~30–50/year)
Owner: FP&amp;A
Participants: FP&amp;A, Internal Audit, External Auditor
Source: workflow W1818 — Capex Approval Documentation &amp; Audit Trail</bpmn:documentation>
      <bpmn:laneSet id="W1818_LaneSet4">
        <bpmn:lane id="W1818_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1818_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1818_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1818_Lane2" name="System">
        <bpmn:flowNodeRef>W1818_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1818_Lane3" name="External Auditor">
        <bpmn:flowNodeRef>W1818_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1818_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1818_Start5" name="Capex request created; maintained throughout project lifecycle">
        <bpmn:outgoing>W1818_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1818_Task6" name="Required documentation per capex project: (a) original request with business…">
        <bpmn:documentation>Step 1: Required documentation per capex project: (a) original request with business case and financial evaluation, (b) approval documentation (system approval trail or board resolution), (c) vendor quotes and selection rationale, (d) POs linked to project, (e) change orders with approval, (f) progress reports and milestone confirmations, (g) completion certificate and asset turnover documentation per W1827, (h) post-implementation review per W2748
Responsible (R): FP&amp;A / Project Manager
Accountable (A): CFO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W1818_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1818_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1818_Task7" name="System maintains complete audit trail: (a) who submitted, reviewed, approved at…">
        <bpmn:documentation>Step 2: System maintains complete audit trail: (a) who submitted, reviewed, approved at each stage, (b) dates and timestamps, (c) version history for revised requests, (d) linked documents accessible from project record
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1818_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1818_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1818_Task8" name="External auditor reviews capex documentation during annual audit: (a) sample of…">
        <bpmn:documentation>Step 3: External auditor reviews capex documentation during annual audit: (a) sample of capex projects: verify approval per DOA, verify cost capitalization per PFRS, verify project completion and asset turnover, (b) assess internal controls over capex process
Responsible (R): External Auditor
Accountable (A): CFO
Duration: During annual audit</bpmn:documentation>
        <bpmn:incoming>W1818_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1818_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1818_End9" name="Complete">
        <bpmn:incoming>W1818_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1818_Annotation10">
        <bpmn:text>Controls: - CTL-361 (ensure controlled execution — Capital Expenditure Request &amp; Approval (PA-40.1).) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
