<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-40.1-capex-request-approval" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W1811" name="W1811. Capital Expenditure Request Submission" isExecutable="false">
      <bpmn:documentation>Trigger: Identified need for capital investment (new store, renovation, equipment, IT project)
Frequency: ~30–50 capex requests/year
Volume: ~10–15 new stores + ~20–30 renovation/IT projects = ~30–50 requests
Owner: Requesting Department Head
Participants: Requesting Department Head, VP Store Operations, COO, CIO
Source: workflow W1811 — Capital Expenditure Request Submission</bpmn:documentation>
      <bpmn:laneSet id="W1811_LaneSet3">
        <bpmn:lane id="W1811_Lane1" name="Department Head">
        <bpmn:flowNodeRef>W1811_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1811_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1811_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1811_Lane2" name="System">
        <bpmn:flowNodeRef>W1811_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1811_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1811_Start4" name="Identified need for capital investment (new store, renovation, equipment, IT project)">
        <bpmn:outgoing>W1811_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1811_Task5" name="Requesting Department Head submits capex request in ERP: (a) project name and…">
        <bpmn:documentation>Step 1: Requesting Department Head submits capex request in ERP: (a) project name and description, (b) business justification: why needed, what problem solved, what opportunity captured, (c) capex type: new store construction, store renovation, DC expansion, IT infrastructure, vehicle/fleet, equipment replacement, (d) estimated total cost (breakdown: materials, labor, equipment, services, contingency 10–15%), (e) expected timeline: start date, milestones, completion date, (f) expected benefits: revenue increase, cost reduction, risk mitigation, compliance requirement, (g) priority: mandatory (regulatory/safety), growth (new revenue), maintenance (renewal/replacement), discretionary
Responsible (R): Department Head
Accountable (A): VP / C-Suite sponsor
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1811_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1811_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1811_Task6" name="Supporting documentation attached: (a) for new stores: site plan, lease…">
        <bpmn:documentation>Step 2: Supporting documentation attached: (a) for new stores: site plan, lease summary, financial model per W1652, (b) for IT projects: vendor proposals, technical specifications, implementation plan, (c) for renovations: scope of work, contractor quotes, before/after photos, (d) for equipment: vendor quotes (minimum 2 for items &gt; PHP 500K), technical specifications, installation requirements
Responsible (R): Department Head
Accountable (A): —
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W1811_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1811_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1811_Task7" name="System validates completeness: (a) all required fields populated, (b)…">
        <bpmn:documentation>Step 3: System validates completeness: (a) all required fields populated, (b) supporting documents attached, (c) cost estimate within reasonable range (system flags outliers vs. historical benchmarks), (d) request routed to financial evaluation per W1812
Responsible (R): System
Accountable (A): —
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1811_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1811_Flow14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1811_End8" name="Complete">
        <bpmn:incoming>W1811_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1811_Annotation9">
        <bpmn:text>Controls: - CTL-361 (ensure controlled execution — Capital Expenditure Request &amp; Approval (PA-40.1).) | - operational: standard operating procedures; system-enforced validation rules
Owner: Requesting Department Head</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1811_Assoc10" sourceRef="W1811_Annotation9" targetRef="W1811_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W1811_Flow11" sourceRef="W1811_Start4" targetRef="W1811_Task5" />
      <bpmn:sequenceFlow id="W1811_Flow12" sourceRef="W1811_Task5" targetRef="W1811_Task6" />
      <bpmn:sequenceFlow id="W1811_Flow13" sourceRef="W1811_Task6" targetRef="W1811_Task7" />
      <bpmn:sequenceFlow id="W1811_Flow14" sourceRef="W1811_Task7" targetRef="W1811_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1811_diag">
      <bpmndi:BPMNPlane id="W1811_plane" bpmnElement="W_W1811">
        <bpmndi:BPMNShape id="W1811_Lane1_di" bpmnElement="W1811_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Lane2_di" bpmnElement="W1811_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Task5_di" bpmnElement="W1811_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Task6_di" bpmnElement="W1811_Task6"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Task7_di" bpmnElement="W1811_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Start4_di" bpmnElement="W1811_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_End8_di" bpmnElement="W1811_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1811_Annotation9_di" bpmnElement="W1811_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1811_Flow11_di" bpmnElement="W1811_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1811_Flow12_di" bpmnElement="W1811_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1811_Flow13_di" bpmnElement="W1811_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1811_Flow14_di" bpmnElement="W1811_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1811_Assoc10_di" bpmnElement="W1811_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1812" name="W1812. Capex Financial Evaluation &amp; Business Case Review" isExecutable="false">
      <bpmn:documentation>Trigger: Capex request submitted and validated (W1811)
Frequency: ~30–50 evaluations/year
Volume: 1 evaluation per request
Owner: FP&amp;A
Participants: FP&amp;A, Requesting Department Head, CFO
Source: workflow W1812 — Capex Financial Evaluation &amp; Business Case Review</bpmn:documentation>
      <bpmn:laneSet id="W1812_LaneSet2">
        <bpmn:lane id="W1812_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1812_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1812_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1812_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1812_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1812_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1812_Start3" name="Capex request submitted and validated (W1811)">
        <bpmn:outgoing>W1812_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1812_Task4" name="total investment cost">
        <bpmn:documentation>Step 1: FP&amp;A performs financial evaluation: (a) total investment cost: all capitalized costs including materials, labor, equipment, installation, testing, project management, (b) operating cash flows: incremental revenue, cost savings, or avoided costs per year for project life, (c) net present value (NPV): discount at company&#x27;s weighted average cost of capital (WACC ~10–12% for Philippine retail), (d) internal rate of return (IRR): target &gt; 15% for growth projects; no minimum for mandatory/regulatory, (e) payback period: target &lt; 3 years for stores; &lt; 2 years for IT/equipment, (f) sensitivity analysis: NPV at -10% revenue, +10% cost, 1-year delay
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 4–8 hours/request</bpmn:documentation>
        <bpmn:incoming>W1812_Flow10</bpmn:incoming>
        <bpmn:outgoing>W1812_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1812_Task5" name="FP&amp;A assesses strategic alignment: (a) maps to Board-approved strategic…">
        <bpmn:documentation>Step 2: FP&amp;A assesses strategic alignment: (a) maps to Board-approved strategic priorities per W1645, (b) evaluates against alternative uses of capital (opportunity cost), (c) considers timing: can this be deferred without significant impact? (d) reviews against annual capex budget affordability (total requested vs. available capital)
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 2 hours/request</bpmn:documentation>
        <bpmn:incoming>W1812_Flow11</bpmn:incoming>
        <bpmn:outgoing>W1812_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W1812_Task6" name="FP&amp;A prepares financial evaluation summary: (a) recommendation: approve…">
        <bpmn:documentation>Step 3: FP&amp;A prepares financial evaluation summary: (a) recommendation: approve, approve with conditions, defer, reject, (b) key assumptions and risks, (c) comparison to similar completed projects (actual vs. projected returns)
Responsible (R): FP&amp;A
Accountable (A): CFO
Duration: 1 day</bpmn:documentation>
        <bpmn:incoming>W1812_Flow12</bpmn:incoming>
        <bpmn:outgoing>W1812_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W1812_End7" name="Complete">
        <bpmn:incoming>W1812_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1812_Annotation8">
        <bpmn:text>Controls: - CTL-210 (ensure capex authorization &amp; commitment control.) | - operational: FP&amp;A review and approval gate
Owner: FP&amp;A</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1812_Assoc9" sourceRef="W1812_Annotation8" targetRef="W1812_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W1812_Flow10" sourceRef="W1812_Start3" targetRef="W1812_Task4" />
      <bpmn:sequenceFlow id="W1812_Flow11" sourceRef="W1812_Task4" targetRef="W1812_Task5" />
      <bpmn:sequenceFlow id="W1812_Flow12" sourceRef="W1812_Task5" targetRef="W1812_Task6" />
      <bpmn:sequenceFlow id="W1812_Flow13" sourceRef="W1812_Task6" targetRef="W1812_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1812_diag">
      <bpmndi:BPMNPlane id="W1812_plane" bpmnElement="W_W1812">
        <bpmndi:BPMNShape id="W1812_Lane1_di" bpmnElement="W1812_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_Task4_di" bpmnElement="W1812_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_Task5_di" bpmnElement="W1812_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_Task6_di" bpmnElement="W1812_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_Start3_di" bpmnElement="W1812_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_End7_di" bpmnElement="W1812_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1812_Annotation8_di" bpmnElement="W1812_Annotation8"><dc:Bounds x="160" y="290" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1812_Flow10_di" bpmnElement="W1812_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1812_Flow11_di" bpmnElement="W1812_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1812_Flow12_di" bpmnElement="W1812_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1812_Flow13_di" bpmnElement="W1812_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1812_Assoc9_di" bpmnElement="W1812_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1813" name="W1813. Capex Approval Workflow &amp; Authorization" isExecutable="false">
      <bpmn:documentation>Trigger: Financial evaluation completed (W1812)
Frequency: ~30–50 approvals/year
Volume: 1 approval per request
Owner: Approver per DOA matrix
Participants: Department Head, FP&amp;A, CFO, CEO, Board
Source: workflow W1813 — Capex Approval Workflow &amp; Authorization</bpmn:documentation>
      <bpmn:laneSet id="W1813_LaneSet4">
        <bpmn:lane id="W1813_Lane1" name="Approver per tier">
        <bpmn:flowNodeRef>W1813_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1813_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1813_Lane2" name="System">
        <bpmn:flowNodeRef>W1813_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1813_Task9</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W1813_Lane3" name="CFO">
        <bpmn:flowNodeRef>W1813_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1813_End10</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W1813_Start5" name="Financial evaluation completed (W1812)">
        <bpmn:outgoing>W1813_Flow13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W1813_Task6" name="Tiered approval per Delegation of Authority per W1732: (a) &lt; PHP 1M: CFO…">
        <bpmn:documentation>Step 1: Tiered approval per Delegation of Authority per W1732: (a) &lt; PHP 1M: CFO approval (based on FP&amp;A recommendation), (b) PHP 1M–10M: CEO approval (CFO endorses), (c) PHP 10M–50M: Board committee approval (Executive Committee), (d) &gt; PHP 50M: Full Board approval (presented at board meeting per W1714)
Responsible (R): Approver per tier
Accountable (A): Per DOA
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W1813_Flow13</bpmn:incoming>
        <bpmn:outgoing>W1813_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1813_Task7" name="Approval workflow in system: (a) request routed sequentially: FP&amp;A → CFO → CEO…">
        <bpmn:documentation>Step 2: Approval workflow in system: (a) request routed sequentially: FP&amp;A → CFO → CEO → Board committee → Board (depending on amount), (b) each approver reviews financial evaluation and supporting documents in system, (c) approver records decision: approved, approved with conditions, deferred, rejected — with comments, (d) system enforces approval limits (approver cannot exceed DOA threshold)
Responsible (R): System
Accountable (A): —
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W1813_Flow14</bpmn:incoming>
        <bpmn:outgoing>W1813_Flow15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W1813_Task8" name="Conditions of approval (if any): (a) reduce scope to fit budget, (b) obtain…">
        <bpmn:documentation>Step 3: Conditions of approval (if any): (a) reduce scope to fit budget, (b) obtain additional vendor quotes, (c) revise timeline, (d) phase the project over 2+ years, (e) funding source reallocation (defer another project)
Responsible (R): CFO / CEO
Accountable (A): Department Head
Duration: 1–3 days</bpmn:documentation>
        <bpmn:incoming>W1813_Flow15</bpmn:incoming>
        <bpmn:outgoing>W1813_Flow16</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="W1813_Task9" name="Approved request creates capex project in system: (a) unique project number…">
        <bpmn:documentation>Step 4: Approved request creates capex project in system: (a) unique project number (format: CPX-YYYY-NNN), (b) approved budget, (c) project timeline and milestones, (d) cost center and entity assignment, (e) budget reserved against annual capex plan per W1648
Responsible (R): System
Accountable (A): FP&amp;A
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W1813_Flow16</bpmn:incoming>
        <bpmn:outgoing>W1813_Flow17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W1813_End10" name="Complete">
        <bpmn:incoming>W1813_Flow17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W1813_Annotation11">
        <bpmn:text>Controls: - CTL-210 (ensure capex authorization &amp; commitment control.) | - operational: Approver per DOA matrix review and approval gate
Owner: Approver per DOA matrix</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W1813_Assoc12" sourceRef="W1813_Annotation11" targetRef="W1813_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W1813_Flow13" sourceRef="W1813_Start5" targetRef="W1813_Task6" />
      <bpmn:sequenceFlow id="W1813_Flow14" sourceRef="W1813_Task6" targetRef="W1813_Task7" />
      <bpmn:sequenceFlow id="W1813_Flow15" sourceRef="W1813_Task7" targetRef="W1813_Task8" />
      <bpmn:sequenceFlow id="W1813_Flow16" sourceRef="W1813_Task8" targetRef="W1813_Task9" />
      <bpmn:sequenceFlow id="W1813_Flow17" sourceRef="W1813_Task9" targetRef="W1813_End10" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W1813_diag">
      <bpmndi:BPMNPlane id="W1813_plane" bpmnElement="W_W1813">
        <bpmndi:BPMNShape id="W1813_Lane1_di" bpmnElement="W1813_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Lane2_di" bpmnElement="W1813_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Lane3_di" bpmnElement="W1813_Lane3" isHorizontal="true"><dc:Bounds x="160" y="420" width="1160" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Task6_di" bpmnElement="W1813_Task6"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Task7_di" bpmnElement="W1813_Task7"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Task8_di" bpmnElement="W1813_Task8"><dc:Bounds x="820" y="465" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Task9_di" bpmnElement="W1813_Task9"><dc:Bounds x="1030" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Start5_di" bpmnElement="W1813_Start5"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_End10_di" bpmnElement="W1813_End10"><dc:Bounds x="1260" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W1813_Annotation11_di" bpmnElement="W1813_Annotation11"><dc:Bounds x="160" y="630" width="360" height="60" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W1813_Flow13_di" bpmnElement="W1813_Flow13"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1813_Flow14_di" bpmnElement="W1813_Flow14"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1813_Flow15_di" bpmnElement="W1813_Flow15"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1813_Flow16_di" bpmnElement="W1813_Flow16"><di:waypoint x="1000" y="505" /><di:waypoint x="1030" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1813_Flow17_di" bpmnElement="W1813_Flow17"><di:waypoint x="1210" y="335" /><di:waypoint x="1260" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W1813_Assoc12_di" bpmnElement="W1813_Assoc12"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W1814" name="W1814. Capex Budget Allocation &amp; Commitment Tracking" isExecutable="false">
      <bpmn:documentation>Trigger: Capex request approved (W1813)
Frequency: Continuous
Volume: ~30–50 active capex projects at any time
Owner: FP&amp;A
Participants: FP&amp;A, CFO, Project Manager
Source: workflow W1814 — Capex Budget Allocation &amp; Commitment Tracking</bpmn:documentation>
      <bpmn:laneSet id="W1814_LaneSet4">
        <bpmn:lane id="W1814_Lane1" name="FP&amp;A">
        <bpmn:flowNodeRef>W1814_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1814_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W1814_Start5</bpmn:flowNodeRef>
