        <bpmndi:BPMNEdge id="W3706_Flow11_di" bpmnElement="W3706_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3706_Flow12_di" bpmnElement="W3706_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3706_Flow13_di" bpmnElement="W3706_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3706_Assoc9_di" bpmnElement="W3706_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3707" name="W3707. Revenue Assurance Analytics &amp; KPI Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: Reporting cycle; governance review
Frequency: Monthly + quarterly
Volume: Program KPIs and analytics
Owner: Revenue Assurance Lead / BI
Participants: Revenue Assurance Lead, BI (links to VS-28.1), Finance/FP&amp;A (links to VS-17.4), Audit (links to VS-21.3), Channel owners, Governance (links to VS-36)
Source: workflow W3707 — Revenue Assurance Analytics &amp; KPI Reporting</bpmn:documentation>
      <bpmn:laneSet id="W3707_LaneSet2">
        <bpmn:lane id="W3707_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3707_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3707_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3707_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3707_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3707_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3707_Start3" name="Reporting cycle; governance review">
        <bpmn:outgoing>W3707_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3707_Task4" name="Revenue Assurance Lead/BI maintain the revenue-assurance KPI dashboard: leakage…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/BI maintain the revenue-assurance KPI dashboard: leakage rate by channel/vector, leakage value recovered vs unrecovered, control-firing/effectiveness, exception-cycle-time, reconciliation integrity, and program maturity
Responsible (R): Revenue Assurance Lead / BI
Accountable (A): Revenue Assurance Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3707_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3707_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3707_Task5" name="Revenue Assurance Lead analyze leakage trends: by channel, vector, store…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead analyze leakage trends: by channel, vector, store, cashier, time-period; identify systemic vs isolated issues, control-effectiveness decay, and emerging new leakage patterns; benchmark leakage rate vs retail norms (1–3%)
Responsible (R): Revenue Assurance Lead / BI / Finance
Accountable (A): Revenue Assurance Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3707_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3707_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3707_Task6" name="Revenue Assurance Lead publish analytics to FP&amp;A (links to VS-17.4 —…">
        <bpmn:documentation>Step 3: Revenue Assurance Lead publish analytics to FP&amp;A (links to VS-17.4 — revenue-forecast/leakage adjustment), channel owners (for fix prioritization), audit (links to VS-21.3), and governance (links to W3689/VS-36); drive the leakage-reduction target
Responsible (R): Revenue Assurance Lead / Finance / BI
Accountable (A): Revenue Assurance Lead
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3707_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3707_End7" name="Complete">
        <bpmn:incoming>W3707_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3707_Annotation8">
        <bpmn:text>Controls: - CTL-585 (ensure controlled execution — Leakage Recovery, Revenue Analytics &amp; Continuous Assurance (PA-118.3).) | - operational: KPI dashboard; operational: benchmarking
Owner: Revenue Assurance Lead / BI</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3707_Assoc9" sourceRef="W3707_Annotation8" targetRef="W3707_Start3" associationDirection="None" />
