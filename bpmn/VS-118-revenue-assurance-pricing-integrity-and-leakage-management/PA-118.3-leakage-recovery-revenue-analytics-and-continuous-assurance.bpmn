        <bpmndi:BPMNEdge id="W3707_Flow13_di" bpmnElement="W3707_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3707_Assoc9_di" bpmnElement="W3707_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3708" name="W3708. Fraud, Collusion &amp; Abuse Revenue-Loss Investigation" isExecutable="false">
      <bpmn:documentation>Trigger: Suspected fraud/collusion/abuse (W3705); integrity anomaly
Frequency: On event
Volume: Investigation queue
Owner: Revenue Assurance Lead / Loss Prevention
Participants: Revenue Assurance Lead, Loss Prevention (links to VS-23), Internal Audit (links to VS-21.3), Legal (links to VS-100.3), HR (links to VS-19), Channel owners, POS/IT (links to VS-08/VS-27.3)
Source: workflow W3708 — Fraud, Collusion &amp; Abuse Revenue-Loss Investigation</bpmn:documentation>
      <bpmn:laneSet id="W3708_LaneSet2">
        <bpmn:lane id="W3708_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3708_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3708_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3708_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3708_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3708_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3708_Start3" name="Suspected fraud/collusion/abuse (W3705); integrity anomaly">
        <bpmn:outgoing>W3708_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3708_Task4" name="Revenue Assurance Lead/Loss Prevention investigate revenue-loss…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/Loss Prevention investigate revenue-loss fraud/collusion/abuse: cashier-customer sweethearting, refund/void fraud (links to W841), coupon/promo abuse (links to W1475), gift-card fraud (links to W1476), loyalty-points manipulation, pricing/override collusion, and external payment/chargeback fraud; gather transaction/ CCTV/ system evidence
Responsible (R): Revenue Assurance Lead / Loss Prevention / Audit
Accountable (A): Revenue Assurance Lead
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3708_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3708_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3708_Task5" name="Revenue Assurance Lead/Loss Prevention/HR manage confirmed fraud…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead/Loss Prevention/HR manage confirmed fraud: employee-disciplinary/legal action (links to VS-19/VS-84/VS-100), customer/law-enforcement escalation, recovery of stolen value, and control-hardening to prevent recurrence; coordinate with internal audit (links to VS-21.3)
Responsible (R): Revenue Assurance Lead / Loss Prevention / HR / Legal
Accountable (A): Revenue Assurance Lead
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3708_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3708_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3708_Task6" name="Revenue Assurance Lead quantify fraud-loss and recovery, feed the event to…">
