      <bpmndi:BPMNPlane id="W3706_plane" bpmnElement="W_W3706">
        <bpmndi:BPMNShape id="W3706_Lane1_di" bpmnElement="W3706_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
