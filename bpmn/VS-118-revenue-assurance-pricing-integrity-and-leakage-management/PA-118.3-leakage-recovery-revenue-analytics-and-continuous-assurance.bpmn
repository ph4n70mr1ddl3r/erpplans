      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3706" name="W3706. Revenue Leakage Recovery &amp; Corrective Action" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed recoverable leakage (W3705)
Frequency: On event
Volume: Per qualifying leakage event
Owner: Revenue Assurance Lead / Finance
Participants: Revenue Assurance Lead, Finance (links to VS-17.1), Channel owners, Customer Service (links to VS-13), Payments (links to VS-80), IT (links to VS-27.1), Audit (links to VS-21.3)
Source: workflow W3706 — Revenue Leakage Recovery &amp; Corrective Action</bpmn:documentation>
      <bpmn:laneSet id="W3706_LaneSet2">
        <bpmn:lane id="W3706_Lane1" name="Revenue Assurance Lead">
        <bpmn:flowNodeRef>W3706_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3706_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3706_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3706_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3706_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3706_Start3" name="Confirmed recoverable leakage (W3705)">
        <bpmn:outgoing>W3706_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3706_Task4" name="Revenue Assurance Lead/Finance recover leakage where recoverable: re-charge…">
        <bpmn:documentation>Step 1: Revenue Assurance Lead/Finance recover leakage where recoverable: re-charge under-charged transactions where identifiable, recover over-refunded/erroneous value, pursue third-party (acquirer/vendor) recovery for fee/chargeback discrepancies, and correct GL entries (links to VS-17.1)
Responsible (R): Revenue Assurance Lead / Finance / Channel owner
Accountable (A): Revenue Assurance Lead
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3706_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3706_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3706_Task5" name="Revenue Assurance Lead drive corrective action on root cause: system fix (with…">
        <bpmn:documentation>Step 2: Revenue Assurance Lead drive corrective action on root cause: system fix (with IT links to VS-27.1), process change, master-data correction (W3709), control addition/tuning (W3693), and training to prevent recurrence
Responsible (R): Revenue Assurance Lead / IT / Channel owner
Accountable (A): Revenue Assurance Lead
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3706_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3706_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3706_Task6" name="Revenue Assurance Lead/Audit verify recovery and corrective-action…">
        <bpmn:documentation>Step 3: Revenue Assurance Lead/Audit verify recovery and corrective-action effectiveness: confirm leakage stopped, recovery captured, control now detects it, and document the event in the leakage register; report to analytics (W3707) and audit (links to VS-21.3)
Responsible (R): Revenue Assurance Lead / Audit
Accountable (A): Revenue Assurance Lead
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W3706_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3706_End7" name="Complete">
        <bpmn:incoming>W3706_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3706_Annotation8">
        <bpmn:text>Controls: - CTL-585 (ensure controlled execution — Leakage Recovery, Revenue Analytics &amp; Continuous Assurance (PA-118.3).) | - operational: prevention focus; operational: corrective-action verification
Owner: Revenue Assurance Lead / Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3706_Assoc9" sourceRef="W3706_Annotation8" targetRef="W3706_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3706_Flow10" sourceRef="W3706_Start3" targetRef="W3706_Task4" />
      <bpmn:sequenceFlow id="W3706_Flow11" sourceRef="W3706_Task4" targetRef="W3706_Task5" />
      <bpmn:sequenceFlow id="W3706_Flow12" sourceRef="W3706_Task5" targetRef="W3706_Task6" />
      <bpmn:sequenceFlow id="W3706_Flow13" sourceRef="W3706_Task6" targetRef="W3706_End7" />
    </bpmn:process>
