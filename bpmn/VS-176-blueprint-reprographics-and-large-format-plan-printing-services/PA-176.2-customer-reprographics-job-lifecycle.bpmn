    <bpmn:process id="W_W5096" name="W5096. Customer Job Billing, Prepaid Account &amp; Credit-Term Management" isExecutable="false">
      <bpmn:documentation>Trigger: Job completion/billing; prepaid top-up; credit-term account
Frequency: Continuous
Volume: ~all jobs × billing
Owner: O2C (VS-16) / Store Services Lead
Participants: O2C (VS-16), Counter Associate, Trade Pro/Account (VS-43/VS-107), FP&amp;A (VS-17.4)
Source: workflow W5096 — Customer Job Billing, Prepaid Account &amp; Credit-Term Management</bpmn:documentation>
      <bpmn:laneSet id="W5096_LaneSet2">
        <bpmn:lane id="W5096_Lane1" name="O2C">
        <bpmn:flowNodeRef>W5096_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5096_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5096_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5096_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5096_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5096_Start3" name="Job completion/billing; prepaid top-up; credit-term account">
        <bpmn:outgoing>W5096_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5096_Task4" name="Bill the job: per-tariff billing (W5083), prepaid-account deduction or…">
        <bpmn:documentation>Step 1: Bill the job: per-tariff billing (W5083), prepaid-account deduction or credit-term/cash/card (VS-80), and tax (VAT — VS-79)
Responsible (R): O2C / Counter Associate
Accountable (A): O2C Manager / Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5096_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5096_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5096_Task5" name="Manage prepaid/credit accounts: prepaid top-up/float (trade-pro/B2B)…">
        <bpmn:documentation>Step 2: Manage prepaid/credit accounts: prepaid top-up/float (trade-pro/B2B), credit-term setup/limit (VS-68), and account statement
Responsible (R): O2C / Account Mgr
Accountable (A): O2C Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W5096_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5096_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5096_Task6" name="Reconcile &amp; report: job-revenue reconciliation, prepaid-float GL (VS-17)…">
        <bpmn:documentation>Step 3: Reconcile &amp; report: job-revenue reconciliation, prepaid-float GL (VS-17), margin analytics (W5099), and FP&amp;A (VS-17.4)
Responsible (R): O2C / FP&amp;A
Accountable (A): O2C Manager
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5096_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5096_End7" name="Complete">
        <bpmn:incoming>W5096_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5096_Annotation8">
        <bpmn:text>Controls: - CTL-759 (ensure controlled execution — Customer Reprographics Job Lifecycle (PA-176.2).) | - CTL-759: tariff-based billing (W5083); prepaid-float GL-reconciled (VS-17); credit-term controls (VS-68); VAT correct (VS-79)
Owner: O2C (VS-16) / Store Services Lead</bpmn:text>
      </bpmn:textAnnotation>
