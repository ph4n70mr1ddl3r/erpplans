    <bpmn:process id="W_W5092" name="W5092. Plan Copying, Binding, Folding &amp; Reproduction Service" isExecutable="false">
      <bpmn:documentation>Trigger: Copy/reproduce/finish order (multi-set, binding, folding)
Frequency: Continuous
Volume: ~hundreds–thousands of copy/finish jobs/month
Owner: Reprographics Operator / Store Services Lead
Participants: Operator, Counter Associate, Quality
Source: workflow W5092 — Plan Copying, Binding, Folding &amp; Reproduction Service</bpmn:documentation>
      <bpmn:laneSet id="W5092_LaneSet2">
        <bpmn:lane id="W5092_Lane1" name="Operator">
        <bpmn:flowNodeRef>W5092_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5092_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5092_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5092_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5092_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5092_Start3" name="Copy/reproduce/finish order (multi-set, binding, folding)">
        <bpmn:outgoing>W5092_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5092_Task4" name="Set up reproduction: copy-count, set collation, binding (staple/spiral/ velo)…">
        <bpmn:documentation>Step 1: Set up reproduction: copy-count, set collation, binding (staple/spiral/ velo), folding (engineering/half/roll) spec, and media (W5084)
Responsible (R): Operator
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5092_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5092_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5092_Task5" name="Reproduce &amp; finish: run copies, collate sets, bind, fold, and QA the finished…">
        <bpmn:documentation>Step 2: Reproduce &amp; finish: run copies, collate sets, bind, fold, and QA the finished set (completeness/order/finish quality)
Responsible (R): Operator / Quality
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5092_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5092_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5092_Task6" name="Log &amp; route: log job completion &amp; consumables (W5099), and route to…">
        <bpmn:documentation>Step 3: Log &amp; route: log job completion &amp; consumables (W5099), and route to pickup/delivery (W5094)
Responsible (R): Operator
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5092_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5092_End7" name="Complete">
        <bpmn:incoming>W5092_Flow13</bpmn:incoming>
      </bpmn:endEvent>
