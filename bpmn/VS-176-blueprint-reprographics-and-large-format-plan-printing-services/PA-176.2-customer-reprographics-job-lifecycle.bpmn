    <bpmn:process id="W_W5090" name="W5090. Large-Format Plan Printing, Plotting &amp; Print-Quality Control" isExecutable="false">
      <bpmn:documentation>Trigger: Confirmed job (W5089)
Frequency: Continuous
Volume: ~thousands of prints/month at maturity
Owner: Reprographics Operator / Store Services Lead
Participants: Operator, Counter Associate, Quality check, Metrology (VS-115)
Source: workflow W5090 — Large-Format Plan Printing, Plotting &amp; Print-Quality Control</bpmn:documentation>
      <bpmn:laneSet id="W5090_LaneSet2">
        <bpmn:lane id="W5090_Lane1" name="Operator">
        <bpmn:flowNodeRef>W5090_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5090_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5090_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5090_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5090_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5090_Start3" name="Confirmed job (W5089)">
        <bpmn:outgoing>W5090_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5090_Task4" name="Set up &amp; print: load media/ink (W5084), set print parameters…">
        <bpmn:documentation>Step 1: Set up &amp; print: load media/ink (W5084), set print parameters (scale/DPI/color/profile), send to plotter, and monitor the run for media/ink faults
Responsible (R): Operator
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5090_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5090_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5090_Task5" name="Quality-control: inspect output (scale accuracy W5097, color, line definition…">
        <bpmn:documentation>Step 2: Quality-control: inspect output (scale accuracy W5097, color, line definition, no banding/bleed), and re-print defects before finishing (W5092)
Responsible (R): Operator / Quality
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5090_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5090_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5090_Task6" name="Log &amp; handoff: log consumables consumed (W5084/W5099), record job completion…">
        <bpmn:documentation>Step 3: Log &amp; handoff: log consumables consumed (W5084/W5099), record job completion, and route to finishing/pickup (W5092/W5094)
Responsible (R): Operator
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5090_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5090_End7" name="Complete">
        <bpmn:incoming>W5090_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5090_Annotation8">
        <bpmn:text>Controls: - CTL-101 (ensure reprographics IP &amp; file-handling control.) | - CTL-759: QC before finishing (W5097); calibration current (VS-115/W5088); consumables logged (W5099)
Owner: Reprographics Operator / Store Services Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5090_Assoc9" sourceRef="W5090_Annotation8" targetRef="W5090_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5090_Flow10" sourceRef="W5090_Start3" targetRef="W5090_Task4" />
      <bpmn:sequenceFlow id="W5090_Flow11" sourceRef="W5090_Task4" targetRef="W5090_Task5" />
      <bpmn:sequenceFlow id="W5090_Flow12" sourceRef="W5090_Task5" targetRef="W5090_Task6" />
      <bpmn:sequenceFlow id="W5090_Flow13" sourceRef="W5090_Task6" targetRef="W5090_End7" />
    </bpmn:process>
