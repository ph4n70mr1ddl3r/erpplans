    <bpmn:process id="W_W5089" name="W5089. Customer Print-Job Intake, File Check, Quotation &amp; Order Confirmation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer job submission (counter or portal W5086)
Frequency: Continuous
Volume: ~thousands of jobs/month at maturity
Owner: Reprographics Counter Associate / Store Services Lead
Participants: Counter Associate, Trade Pro/Account (VS-43), Customer Service (VS-13), Legal (attestation — W5087)
Source: workflow W5089 — Customer Print-Job Intake, File Check, Quotation &amp; Order Confirmation</bpmn:documentation>
      <bpmn:laneSet id="W5089_LaneSet2">
        <bpmn:lane id="W5089_Lane1" name="Counter Associate">
        <bpmn:flowNodeRef>W5089_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5089_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5089_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5089_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5089_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5089_Start3" name="Customer job submission (counter or portal W5086)">
        <bpmn:outgoing>W5089_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5089_Task4" name="Intake &amp; capture: receive the file (counter upload or portal W5086), capture…">
        <bpmn:documentation>Step 1: Intake &amp; capture: receive the file (counter upload or portal W5086), capture job specs (size/media/color/copies/finishing/binding), and capture the customer authorship/IP attestation (W5087)
Responsible (R): Counter Associate / Customer Service
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5089_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5089_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5089_Task5" name="File check &amp; pre-flight: validate format (PDF/DWG/DXF), pre-flight…">
        <bpmn:documentation>Step 2: File check &amp; pre-flight: validate format (PDF/DWG/DXF), pre-flight (scale/size/color), detect corruption, and confirm printability before quoting
Responsible (R): Counter Associate / IT
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5089_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5089_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5089_Task6" name="Quote &amp; confirm: auto/assisted quote per tariff (W5083), confirm with customer…">
        <bpmn:documentation>Step 3: Quote &amp; confirm: auto/assisted quote per tariff (W5083), confirm with customer, take deposit/prepaid/credit (W5096), and release to production (W5090)
Responsible (R): Counter Associate / O2C
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5089_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5089_End7" name="Complete">
        <bpmn:incoming>W5089_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5089_Annotation8">
        <bpmn:text>Controls: - CTL-759 (ensure controlled execution — Customer Reprographics Job Lifecycle (PA-176.2).) | - CTL-759: attestation captured (W5087); pre-flight before quote; tariff-based pricing (W5083)
Owner: Reprographics Counter Associate / Store Services Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5089_Assoc9" sourceRef="W5089_Annotation8" targetRef="W5089_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5089_Flow10" sourceRef="W5089_Start3" targetRef="W5089_Task4" />
      <bpmn:sequenceFlow id="W5089_Flow11" sourceRef="W5089_Task4" targetRef="W5089_Task5" />
      <bpmn:sequenceFlow id="W5089_Flow12" sourceRef="W5089_Task5" targetRef="W5089_Task6" />
      <bpmn:sequenceFlow id="W5089_Flow13" sourceRef="W5089_Task6" targetRef="W5089_End7" />
    </bpmn:process>
