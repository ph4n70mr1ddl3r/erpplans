        <bpmn:flowNodeRef>W5098_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5098_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5098_Start5" name="Monthly analytics; downtime incident; capacity planning (W5103)">
        <bpmn:outgoing>W5098_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5098_Task6" name="Track performance KPIs: uptime, utilization (% busy), throughput (sqm/hr)…">
        <bpmn:documentation>Step 1: Track performance KPIs: uptime, utilization (% busy), throughput (sqm/hr), MTBF, and downtime hours per equipment/site
Responsible (R): Analytics / Facilities
Accountable (A): Director Store Services
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5098_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5098_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5098_Task7" name="Diagnose downtime: root-cause (breakdown/supply/PM), SLA adherence (W5088), and…">
        <bpmn:documentation>Step 2: Diagnose downtime: root-cause (breakdown/supply/PM), SLA adherence (W5088), and substitute-capacity effectiveness
Responsible (R): Facilities / IT / Analytics
Accountable (A): Director Store Services
Duration: Per incident</bpmn:documentation>
        <bpmn:incoming>W5098_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5098_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5098_Task8" name="Drive reliability &amp; capacity: PM/capex plan (W5088/W5082), capacity…">
        <bpmn:documentation>Step 3: Drive reliability &amp; capacity: PM/capex plan (W5088/W5082), capacity expansion/rebalancing (W5103), and feed program ROI (W5104)
Responsible (R): Director Store Services / Facilities / Analytics
Accountable (A): Director Store Services
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W5098_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5098_End9" name="Complete">
        <bpmn:incoming>W5098_Flow15</bpmn:incoming>
      </bpmn:endEvent>
