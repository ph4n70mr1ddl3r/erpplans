    <bpmn:process id="W_W5098" name="W5098. Reprographics Equipment Performance, Utilization &amp; Downtime Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly analytics; downtime incident; capacity planning (W5103)
Frequency: Monthly + event-driven
Volume: ~all plotters/scanners × monthly
Owner: Analytics/Facilities (VS-28/VS-138) / Director Store Services
Participants: Analytics (VS-28), Facilities (VS-138), IT (VS-27), Store Services Lead
Source: workflow W5098 — Reprographics Equipment Performance, Utilization &amp; Downtime Management</bpmn:documentation>
      <bpmn:laneSet id="W5098_LaneSet4">
        <bpmn:lane id="W5098_Lane1" name="Analytics">
