    <bpmn:process id="W_W5100" name="W5100. Customer Document Confidentiality, RA 10173 Data-Privacy &amp; Secure Disposal" isExecutable="false">
      <bpmn:documentation>Trigger: Job intake/retention (W5089); disposal cycle; privacy refresh; DSAR
Frequency: Continuous + periodic disposal
Volume: ~all stored customer documents
Owner: IT/Privacy (VS-27/VS-91) / Director Store Services
Participants: IT (VS-27), Privacy/DPO (VS-91), Legal (VS-100), Compliance (VS-22), Store Services Lead
Source: workflow W5100 — Customer Document Confidentiality, RA 10173 Data-Privacy &amp; Secure Disposal</bpmn:documentation>
      <bpmn:laneSet id="W5100_LaneSet3">
        <bpmn:lane id="W5100_Lane1" name="Privacy">
        <bpmn:flowNodeRef>W5100_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5100_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5100_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5100_Lane2" name="IT">
        <bpmn:flowNodeRef>W5100_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5100_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5100_Start4" name="Job intake/retention (W5089); disposal cycle; privacy refresh; DSAR">
        <bpmn:outgoing>W5100_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5100_Task5" name="Govern document confidentiality &amp; RA 10173: consent at intake (W5087/W5089)…">
        <bpmn:documentation>Step 1: Govern document confidentiality &amp; RA 10173: consent at intake (W5087/W5089), purpose/retention limits, access control on stored files (W5093), and sealed-bid/sensitive handling
Responsible (R): Privacy/DPO / IT / Legal
Accountable (A): Director Store Services / DPO
Duration: At setup + ongoing</bpmn:documentation>
        <bpmn:incoming>W5100_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5100_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5100_Task6" name="Secure-dispose: physical-document secure shred, digital-file secure-purge per…">
        <bpmn:documentation>Step 2: Secure-dispose: physical-document secure shred, digital-file secure-purge per retention policy, and chain-of-custody documentation
Responsible (R): IT / Privacy / Store Services Lead
Accountable (A): Director Store Services / DPO
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W5100_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5100_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5100_Task7" name="Handle DSAR/incident: data-subject access requests (RA 10173), breach response…">
