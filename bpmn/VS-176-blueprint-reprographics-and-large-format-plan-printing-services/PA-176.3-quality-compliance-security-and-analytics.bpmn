        <bpmn:flowNodeRef>W5102_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5102_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5102_Start4" name="Customer complaint/defect; VOC; rework">
        <bpmn:outgoing>W5102_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5102_Task5" name="Intake &amp; triage: capture complaint (quality/late/defect/billing), classify…">
        <bpmn:documentation>Step 1: Intake &amp; triage: capture complaint (quality/late/defect/billing), classify, route, and acknowledge within SLA (VS-13)
Responsible (R): Customer Service / Store Services Lead
Accountable (A): Customer Service Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5102_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5102_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5102_Task6" name="Resolve &amp; rework: address the issue (re-print W5090, refund W5096, expedite)…">
        <bpmn:documentation>Step 2: Resolve &amp; rework: address the issue (re-print W5090, refund W5096, expedite), root-cause the defect (links W5097/W5099), and confirm resolution with customer
Responsible (R): Store Services Lead / Operator / O2C
Accountable (A): Store Services Lead / Customer Service Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5102_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5102_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5102_Task7" name="Close &amp; learn: record VOC/resolution (VS-13), feed CX analytics &amp;…">
        <bpmn:documentation>Step 3: Close &amp; learn: record VOC/resolution (VS-13), feed CX analytics &amp; mystery-shopping (VS-146), and flag systemic defects to the program (W5104)
Responsible (R): Customer Service / Analytics
Accountable (A): Customer Service Manager
Duration: Per case</bpmn:documentation>
        <bpmn:incoming>W5102_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5102_End8" name="Complete">
        <bpmn:incoming>W5102_Flow14</bpmn:incoming>
      </bpmn:endEvent>
