    <bpmn:process id="W_W5097" name="W5097. Print Quality, Color/Scale Accuracy &amp; Dimensional Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Each completed job (W5090/W5092); calibration cycle; defect/complaint
Frequency: Per job + calibration cycle
Volume: ~all jobs × QC
Owner: Reprographics Operator / Quality / Metrology (VS-115)
Participants: Operator, Quality, Metrology (VS-115), Store Services Lead
Source: workflow W5097 — Print Quality, Color/Scale Accuracy &amp; Dimensional Verification</bpmn:documentation>
      <bpmn:laneSet id="W5097_LaneSet2">
        <bpmn:lane id="W5097_Lane1" name="Operator">
        <bpmn:flowNodeRef>W5097_Task4</bpmn:flowNodeRef>
