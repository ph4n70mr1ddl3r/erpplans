        <bpmn:outgoing>W5097_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5097_Task4" name="Verify print quality: line definition, color accuracy (profile), no…">
        <bpmn:documentation>Step 1: Verify print quality: line definition, color accuracy (profile), no banding/bleed/smudge, media integrity, and finishing quality (binding/folding)
Responsible (R): Operator / Quality
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5097_Flow10</bpmn:incoming>
        <bpmn:outgoing>W5097_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5097_Task5" name="Verify scale/dimensional accuracy: print-to-scale correctness (critical for…">
        <bpmn:documentation>Step 2: Verify scale/dimensional accuracy: print-to-scale correctness (critical for construction plans — a wrong scale is a jobsite error), using calibrated measurement (VS-115)
Responsible (R): Operator / Metrology
Accountable (A): Store Services Lead
Duration: Per job</bpmn:documentation>
        <bpmn:incoming>W5097_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5097_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5097_Task6" name="Defect handling &amp; rework: re-print defects (W5090), log defect rate, and feed…">
        <bpmn:documentation>Step 3: Defect handling &amp; rework: re-print defects (W5090), log defect rate, and feed calibration/maintenance (W5088) + analytics (W5099)
Responsible (R): Operator / Quality
Accountable (A): Store Services Lead
Duration: Per defect</bpmn:documentation>
        <bpmn:incoming>W5097_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5097_End7" name="Complete">
        <bpmn:incoming>W5097_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5097_Annotation8">
        <bpmn:text>Controls: - CTL-101 (ensure reprographics IP &amp; file-handling control.) | - CTL-760: QC before release; scale verified (VS-115); calibration current (W5088)
Owner: Reprographics Operator / Quality / Metrology (VS-115)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5097_Assoc9" sourceRef="W5097_Annotation8" targetRef="W5097_Start3" associationDirection="None" />
