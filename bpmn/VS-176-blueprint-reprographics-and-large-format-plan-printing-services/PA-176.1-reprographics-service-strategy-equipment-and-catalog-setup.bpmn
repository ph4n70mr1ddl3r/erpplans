    <bpmn:process id="W_W5082" name="W5082. Large-Format Printer/Plotter/Scanner Equipment Selection, Procurement &amp; Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy approval (W5081); new site; equipment refresh
Frequency: Per site + refresh cycle (~5–7 yr)
Volume: ~1 plotter + 1 large-format scanner per service site
Owner: Procurement/IT (VS-03/VS-34/VS-99) / Director Store Services
Participants: Procurement (VS-34), IT/IT-Asset (VS-99), Finance/Fixed-Asset (VS-35), Facilities (VS-138), vendor, Store Ops (VS-07)
Source: workflow W5082 — Large-Format Printer/Plotter/Scanner Equipment Selection, Procurement &amp; Setup</bpmn:documentation>
      <bpmn:laneSet id="W5082_LaneSet3">
        <bpmn:lane id="W5082_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W5082_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5082_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5082_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5082_Lane2" name="IT">
        <bpmn:flowNodeRef>W5082_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5082_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5082_Start4" name="Strategy approval (W5081); new site; equipment refresh">
        <bpmn:outgoing>W5082_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5082_Task5" name="Specify &amp; select equipment: large-format inkjet plotter (A0/A1, CAD/GIS)…">
        <bpmn:documentation>Step 1: Specify &amp; select equipment: large-format inkjet plotter (A0/A1, CAD/GIS), large-format scanner, finishing (folder/binder), spec (speed, media width, color accuracy, network/cloud), and vendor evaluation
Responsible (R): Procurement / IT / Director Store Services
Accountable (A): Director Store Services
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5082_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5082_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5082_Task6" name="Procure &amp; install: PO (VS-34), fixed-asset capitalise (VS-35)…">
        <bpmn:documentation>Step 2: Procure &amp; install: PO (VS-34), fixed-asset capitalise (VS-35), install/network-integrate (VS-27/VS-99), counter layout &amp; ventilation (VS-138), and acceptance test
Responsible (R): Procurement / IT / Facilities / Finance
Accountable (A): Director Store Services
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5082_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5082_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5082_Task7" name="Commission &amp; handover: calibrate (VS-115), load the print-management…">
        <bpmn:documentation>Step 3: Commission &amp; handover: calibrate (VS-115), load the print-management system/software (W5086), train counter staff (VS-19.4), and go-live sign-off
Responsible (R): IT / Director Store Services / Training
Accountable (A): Director Store Services
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W5082_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5082_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5082_End8" name="Complete">
        <bpmn:incoming>W5082_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5082_Annotation9">
        <bpmn:text>Controls: - CTL-758 (ensure controlled execution — Reprographics Service Strategy, Equipment &amp; Catalog Setup (PA-176.1).) | - CTL-758: equipment within VS-35/VS-34 capex matrix; calibrated (VS-115); IT-acceptance before go-live; staff trained (VS-19.4)
Owner: Procurement/IT (VS-03/VS-34/VS-99) / Director Store Services</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5082_Assoc10" sourceRef="W5082_Annotation9" targetRef="W5082_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W5082_Flow11" sourceRef="W5082_Start4" targetRef="W5082_Task5" />
      <bpmn:sequenceFlow id="W5082_Flow12" sourceRef="W5082_Task5" targetRef="W5082_Task6" />
      <bpmn:sequenceFlow id="W5082_Flow13" sourceRef="W5082_Task6" targetRef="W5082_Task7" />
      <bpmn:sequenceFlow id="W5082_Flow14" sourceRef="W5082_Task7" targetRef="W5082_End8" />
    </bpmn:process>
