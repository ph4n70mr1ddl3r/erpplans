    <bpmn:process id="W_W5084" name="W5084. Print Media, Toner/Ink &amp; Consumables Procurement &amp; Inventory Management" isExecutable="false">
      <bpmn:documentation>Trigger: Stock-low; min-max; supplier cycle
Frequency: Continuous replenishment
Volume: ~200–400 SKUs of media rolls/sheets + ink/toner + binding supplies across ~15–25 service sites
Owner: Procurement/Inventory (VS-34/VS-05) / Store Services Lead
Participants: Procurement (VS-34), Inventory (VS-05), Store Services Lead, Supplier (VS-03), FP&amp;A (cost — VS-17.4)
Source: workflow W5084 — Print Media, Toner/Ink &amp; Consumables Procurement &amp; Inventory Management</bpmn:documentation>
      <bpmn:laneSet id="W5084_LaneSet3">
        <bpmn:lane id="W5084_Lane1" name="Procurement">
        <bpmn:flowNodeRef>W5084_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5084_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W5084_Lane2" name="Inventory">
        <bpmn:flowNodeRef>W5084_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5084_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5084_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5084_Start4" name="Stock-low; min-max; supplier cycle">
        <bpmn:outgoing>W5084_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5084_Task5" name="Manage the consumables catalog &amp; sourcing: media (bond/vellum/photo/matte…">
