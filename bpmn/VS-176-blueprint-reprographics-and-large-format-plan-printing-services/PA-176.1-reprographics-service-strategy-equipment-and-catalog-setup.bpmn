      <bpmn:sequenceFlow id="W5083_Flow12" sourceRef="W5083_Task5" targetRef="W5083_Task6" />
      <bpmn:sequenceFlow id="W5083_Flow13" sourceRef="W5083_Task6" targetRef="W5083_End7" />
    </bpmn:process>
