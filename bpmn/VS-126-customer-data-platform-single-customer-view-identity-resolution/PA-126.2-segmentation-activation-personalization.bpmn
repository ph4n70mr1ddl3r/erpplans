        <bpmn:outgoing>W3890_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3890_Task4" name="CDP/IT expose the real-time customer profile and next-best-action (NBA) API to…">
        <bpmn:documentation>Step 1: CDP/IT expose the real-time customer profile and next-best-action (NBA) API to touchpoints: POS customer lookup + clienteling prompt (links to VS-08/VS-124), ecommerce logged-in experience (links to VS-10), app home (links to VS-75), contact-center screen-pop (links to VS-13) — within sub-second latency
Responsible (R): CDP / IT / EA
Accountable (A): CDP Lead
Duration: Maintained</bpmn:documentation>
        <bpmn:incoming>W3890_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3890_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3890_Task5" name="CDP/Data Science/Marketing define NBA logic: best next product/category to…">
        <bpmn:documentation>Step 2: CDP/Data Science/Marketing define NBA logic: best next product/category to attach, best offer (links to VS-58/VS-13 loyalty), best message, service opportunity (estimation links to VS-09.2, installation links to VS-12), and trade-pro value prop (links to VS-43) — governed and explainable
Responsible (R): CDP / Data Science / Marketing
Accountable (A): CDP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3890_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3890_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3890_Task6" name="CDP/Marketing capture NBA acceptance/outcomes, feed model learning (links to…">
        <bpmn:documentation>Step 3: CDP/Marketing capture NBA acceptance/outcomes, feed model learning (links to W3892/W3895), and tune offers by segment/channel
Responsible (R): CDP / Marketing / Data Science
Accountable (A): CDP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3890_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3890_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3890_End7" name="Complete">
        <bpmn:incoming>W3890_Flow13</bpmn:incoming>
      </bpmn:endEvent>
