      <bpmn:sequenceFlow id="W3896_Flow12" sourceRef="W3896_Task5" targetRef="W3896_Task6" />
      <bpmn:sequenceFlow id="W3896_Flow13" sourceRef="W3896_Task6" targetRef="W3896_End7" />
    </bpmn:process>
