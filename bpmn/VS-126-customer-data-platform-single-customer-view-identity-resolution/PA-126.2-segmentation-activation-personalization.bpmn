        <bpmn:outgoing>W3889_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3889_Task4" name="CDP/Marketing build and maintain segments on the profile (links to…">
        <bpmn:documentation>Step 1: CDP/Marketing build and maintain segments on the profile (links to W3884/W3887): RFM, lifecycle stage, value tier, trade-pro vs DIY, category-affinity (links to VS-01), channel-preference, win-back/lapse-risk, new-mover/home-builder, seasonal (links to VS-13.2), and ad-hoc campaign segments
Responsible (R): CDP / Marketing / Insights
Accountable (A): CDP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3889_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3889_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3889_Task5" name="CDP/Privacy enforce consent and suppression at segment build (links to W3885)…">
        <bpmn:documentation>Step 2: CDP/Privacy enforce consent and suppression at segment build (links to W3885), apply frequency caps and global suppression (do-not-contact, deceased, invalid), and document segment lineage for governance (links to VS-28.2)
Responsible (R): CDP / Privacy / Marketing
Accountable (A): CDP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3889_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3889_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3889_Task6" name="CDP/Marketing publish segment counts/quality for activation (links to W3891)…">
        <bpmn:documentation>Step 3: CDP/Marketing publish segment counts/quality for activation (links to W3891), monitor segment drift, and refresh/refine with insights (links to VS-28.1/VS-44)
Responsible (R): CDP / Marketing / Insights
Accountable (A): CDP Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3889_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3889_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3889_End7" name="Complete">
        <bpmn:incoming>W3889_Flow13</bpmn:incoming>
      </bpmn:endEvent>
