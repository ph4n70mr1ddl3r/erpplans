      <bpmn:sequenceFlow id="W3897_Flow12" sourceRef="W3897_Task5" targetRef="W3897_Task6" />
      <bpmn:sequenceFlow id="W3897_Flow13" sourceRef="W3897_Task6" targetRef="W3897_End7" />
    </bpmn:process>
