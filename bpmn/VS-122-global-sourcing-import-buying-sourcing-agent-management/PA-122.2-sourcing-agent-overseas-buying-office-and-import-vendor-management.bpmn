      <bpmn:startEvent id="W3793_Start3" name="Sourcing-model decision (W3787); agent contract cycle">
        <bpmn:outgoing>W3793_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3793_Task4" name="Global Sourcing/Procurement source and select sourcing agents: RFP…">
        <bpmn:documentation>Step 1: Global Sourcing/Procurement source and select sourcing agents: RFP, capability/country-coverage assessment, references, commercial model (commission, mark-up, fee), financial/compliance due diligence (links to VS-86.3), and shortlist/recommend per the sourcing-model decision (W3787)
Responsible (R): Global Sourcing / Procurement / Legal
Accountable (A): VP Merchandising
Duration: Per selection</bpmn:documentation>
        <bpmn:incoming>W3793_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3793_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3793_Task5" name="Global Sourcing/Legal contract the agent: scope of authority (sourcing, vendor…">
        <bpmn:documentation>Step 2: Global Sourcing/Legal contract the agent: scope of authority (sourcing, vendor management, consolidation, QC, logistics), commission/fee, exclusivity/territory, IP and BuildRight-owned specifications (links to VS-100.2), anti-bribery (links to VS-86.3), data protection (links to VS-91), audit rights, termination, and KPIs
Responsible (R): Global Sourcing / Legal
Accountable (A): VP Merchandising / CFO
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3793_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3793_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3793_Task6" name="Global Sourcing manage agent performance: KPI scorecard (savings, quality…">
        <bpmn:documentation>Step 3: Global Sourcing manage agent performance: KPI scorecard (savings, quality, on-time, vendor-base management, compliance), periodic business review, fee reconciliation, and corrective action / replacement when underperforming
Responsible (R): Global Sourcing / Quality / Finance
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3793_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3793_End7" name="Complete">
        <bpmn:incoming>W3793_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3793_Annotation8">
        <bpmn:text>Controls: - CTL-596 (ensure controlled execution — Sourcing Agent, Overseas Buying Office &amp; Import Vendor Management (PA-122.2).) | - operational: audit rights and direct vendor visibility (links to W3795/W3796); operational: ABC terms and due diligence (links to VS-86)
Owner: Global Sourcing / Procurement</bpmn:text>
      </bpmn:textAnnotation>
