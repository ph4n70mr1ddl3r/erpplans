        <bpmndi:BPMNEdge id="W3786_Flow11_di" bpmnElement="W3786_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3786_Flow12_di" bpmnElement="W3786_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3786_Flow13_di" bpmnElement="W3786_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3786_Assoc9_di" bpmnElement="W3786_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3787" name="W3787. Sourcing-Model Decision: Direct vs Sourcing Agent vs Overseas Buying Office" isExecutable="false">
      <bpmn:documentation>Trigger: Strategy (W3785); new category; model review
Frequency: Per category + on review
Volume: Enterprise sourcing-model portfolio
Owner: Global Sourcing / Procurement Strategy
Participants: Global Sourcing, Merchandising (links to VS-01), Procurement (links to VS-03/VS-34), Finance (links to VS-17.4), Legal (links to VS-100.3), Quality (links to VS-31), Compliance (links to VS-22)
Source: workflow W3787 — Sourcing-Model Decision: Direct vs Sourcing Agent vs Overseas Buying Office</bpmn:documentation>
      <bpmn:laneSet id="W3787_LaneSet2">
        <bpmn:lane id="W3787_Lane1" name="Global Sourcing">
        <bpmn:flowNodeRef>W3787_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3787_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3787_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3787_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3787_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3787_Start3" name="Strategy (W3785); new category; model review">
        <bpmn:outgoing>W3787_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3787_Task4" name="direct">
        <bpmn:documentation>Step 1: Global Sourcing/Strategy evaluate and decide the sourcing model per category/vendor: (a) direct import (BuildRight buys ex-works/FOB from the factory — highest control, lowest unit cost, highest overhead); (b) sourcing agent (a third-party agent sources, consolidates, and manages vendors on BuildRight&#x27;s behalf — links to W3793); (c) overseas buying office (BuildRight&#x27;s own staff/office in the source country — links to W3794); based on volume, complexity, control, cost, and capability
Responsible (R): Global Sourcing / Strategy / Finance
Accountable (A): VP Merchandising
Duration: Per category</bpmn:documentation>
        <bpmn:incoming>W3787_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3787_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3787_Task5" name="Global Sourcing/Legal structure the chosen model contractually: direct supply…">
        <bpmn:documentation>Step 2: Global Sourcing/Legal structure the chosen model contractually: direct supply agreement, sourcing-agent agreement (scope, commission, exclusivity, IP, anti-bribery links to VS-86.3, data links to VS-91), or overseas-office establishment/legal-entity (links to VS-100/VS-36); define KPIs and governance
Responsible (R): Global Sourcing / Legal
Accountable (A): VP Merchandising / CFO
Duration: Per model</bpmn:documentation>
        <bpmn:incoming>W3787_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3787_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3787_Task6" name="Global Sourcing/Finance publish a periodic sourcing-model ROI review (unit…">
        <bpmn:documentation>Step 3: Global Sourcing/Finance publish a periodic sourcing-model ROI review (unit cost, overhead, quality, control, risk by model) and recommend model migration (e.g., agent → direct as volume grows) to governance (links to W3808)
Responsible (R): Global Sourcing / Finance
Accountable (A): VP Merchandising
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3787_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3787_End7" name="Complete">
        <bpmn:incoming>W3787_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3787_Annotation8">
        <bpmn:text>Controls: - CTL-595 (ensure controlled execution — Global Sourcing Strategy, Source-Market &amp; Sourcing-Model Design (PA-122.1).) | - operational: model-decision framework; operational: governance and direct audits (links to W3796)
Owner: Global Sourcing / Procurement Strategy</bpmn:text>
      </bpmn:textAnnotation>
