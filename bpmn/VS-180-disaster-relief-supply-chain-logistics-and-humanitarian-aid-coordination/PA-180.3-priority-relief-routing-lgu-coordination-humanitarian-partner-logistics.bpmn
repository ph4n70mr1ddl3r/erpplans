    <bpmn:process id="W_W5195" name="W5195. NGO &amp; Corporate Foundation Emergency Logistics Sponsorship Matching" isExecutable="false">
      <bpmn:documentation>Trigger: NGO request to buy and ship relief materials; CSR foundation planning (VS-152)
Frequency: Event-driven
Volume: ~10–15 sponsorships matched annually
Owner: CSR Foundation Manager (VS-152) / B2B Account Manager
Participants: NGO Partner, Corporate Sponsors, Finance, Logistics
Source: workflow W5195 — NGO &amp; Corporate Foundation Emergency Logistics Sponsorship Matching</bpmn:documentation>
      <bpmn:laneSet id="W5195_LaneSet2">
        <bpmn:lane id="W5195_Lane1" name="CSR Foundation Manager">
        <bpmn:flowNodeRef>W5195_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5195_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5195_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5195_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5195_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5195_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5195_Start3" name="NGO request to buy and ship relief materials; CSR foundation planning (VS-152)">
        <bpmn:outgoing>W5195_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5195_Task4" name="Create corporate sponsorship matching program: match donor funds to…">
        <bpmn:documentation>Step 1: Create corporate sponsorship matching program: match donor funds to pre-positioned relief items at discounted rates.
Responsible (R): CSR Foundation Manager (VS-152) / B2B Account Manager
Accountable (A): CSR Foundation Manager (VS-152) / B2B Account Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5195_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5195_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5195_Task5" name="Coordinate materials booking: earmark stock in ERP for NGO account upon…">
        <bpmn:documentation>Step 2: Coordinate materials booking: earmark stock in ERP for NGO account upon donation fund confirmation.
Responsible (R): CSR Foundation Manager (VS-152) / B2B Account Manager
Accountable (A): CSR Foundation Manager (VS-152) / B2B Account Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5195_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5195_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5195_Task6" name="Arrange subsidized logistics: split transport costs between BuildRight CSR…">
        <bpmn:documentation>Step 3: Arrange subsidized logistics: split transport costs between BuildRight CSR foundation and the corporate sponsor.
Responsible (R): CSR Foundation Manager (VS-152) / B2B Account Manager
Accountable (A): CSR Foundation Manager (VS-152) / B2B Account Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5195_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5195_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5195_Task7" name="Compile post-delivery compliance reports (delivery photos, recipient counts)…">
        <bpmn:documentation>Step 4: Compile post-delivery compliance reports (delivery photos, recipient counts) and send to NGO/donor.
Responsible (R): CSR Foundation Manager (VS-152) / B2B Account Manager
Accountable (A): CSR Foundation Manager (VS-152) / B2B Account Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5195_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5195_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5195_End8" name="Complete">
        <bpmn:incoming>W5195_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5195_Annotation9">
        <bpmn:text>Controls: - CTL-772 (ensure controlled execution — Priority Relief Routing, LGU Coordination &amp; Humanitarian Partner Logistics (PA-180.3).) | - CTL-772: Sponsorship agreements audited by internal audit; fund matching verified against bank statements.
Owner: CSR Foundation Manager (VS-152) / B2B Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5195_Assoc10" sourceRef="W5195_Annotation9" targetRef="W5195_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5195_Flow11" sourceRef="W5195_Start3" targetRef="W5195_Task4" />
      <bpmn:sequenceFlow id="W5195_Flow12" sourceRef="W5195_Task4" targetRef="W5195_Task5" />
      <bpmn:sequenceFlow id="W5195_Flow13" sourceRef="W5195_Task5" targetRef="W5195_Task6" />
      <bpmn:sequenceFlow id="W5195_Flow14" sourceRef="W5195_Task6" targetRef="W5195_Task7" />
      <bpmn:sequenceFlow id="W5195_Flow15" sourceRef="W5195_Task7" targetRef="W5195_End8" />
    </bpmn:process>
