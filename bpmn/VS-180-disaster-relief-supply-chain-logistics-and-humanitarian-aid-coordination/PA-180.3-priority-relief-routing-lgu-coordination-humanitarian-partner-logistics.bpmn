      <bpmn:startEvent id="W5197_Start3" name="Post-storm damage assessment completion (VS-69); structural damage suspected">
        <bpmn:outgoing>W5197_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5197_Task4" name="Inspect store building envelope: check roof trusses, glass panels, warehouse…">
        <bpmn:documentation>Step 1: Inspect store building envelope: check roof trusses, glass panels, warehouse racking, solar panels, and electrical wiring.
Responsible (R): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Accountable (A): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5197_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5197_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5197_Task5" name="Verify utility safety: check for water damage in electrical panels, test…">
        <bpmn:documentation>Step 2: Verify utility safety: check for water damage in electrical panels, test generator transfer switch, and inspect sewage system.
Responsible (R): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Accountable (A): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5197_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5197_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5197_Task6" name="Draft structural integrity report; secure safety clearance from LGU Office of…">
        <bpmn:documentation>Step 3: Draft structural integrity report; secure safety clearance from LGU Office of Building Official (OBO).
Responsible (R): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Accountable (A): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5197_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5197_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5197_Task7" name="Re-commission POS registers and network systems (VS-27) before opening doors to…">
        <bpmn:documentation>Step 4: Re-commission POS registers and network systems (VS-27) before opening doors to retail customers.
Responsible (R): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Accountable (A): Facilities Manager (VS-138) / Structural Engineer (Contracted)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5197_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5197_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5197_End8" name="Complete">
        <bpmn:incoming>W5197_Flow15</bpmn:incoming>
      </bpmn:endEvent>
