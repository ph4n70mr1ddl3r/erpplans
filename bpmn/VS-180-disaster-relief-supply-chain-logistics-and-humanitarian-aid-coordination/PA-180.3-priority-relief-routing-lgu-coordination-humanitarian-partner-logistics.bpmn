    <bpmn:process id="W_W5193" name="W5193. LGU Disaster Operations Center (DRRMC) Collaboration &amp; Communication" isExecutable="false">
      <bpmn:documentation>Trigger: Activation of disaster response plan (VS-69); storm landfall imminent
Frequency: Continuous during disaster response
Volume: Coordination with ~20–30 municipal/provincial DRRMCs
Owner: Government Affairs Specialist / Regional Store Operations Manager
Participants: DRRMC Officers, Store Managers, LP team (VS-23)
Source: workflow W5193 — LGU Disaster Operations Center (DRRMC) Collaboration &amp; Communication</bpmn:documentation>
      <bpmn:laneSet id="W5193_LaneSet2">
        <bpmn:lane id="W5193_Lane1" name="Government Affairs Specialist">
        <bpmn:flowNodeRef>W5193_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5193_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5193_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5193_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5193_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5193_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5193_Start3" name="Activation of disaster response plan (VS-69); storm landfall imminent">
        <bpmn:outgoing>W5193_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5193_Task4" name="Establish contact with the LGU Disaster Risk Reduction and Management Council…">
        <bpmn:documentation>Step 1: Establish contact with the LGU Disaster Risk Reduction and Management Council (DRRMC) Command Center.
Responsible (R): Government Affairs Specialist / Regional Store Operations Manager
Accountable (A): Government Affairs Specialist / Regional Store Operations Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5193_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5193_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5193_Task5" name="Provide BuildRight point-of-contact, store emergency numbers, and inventory…">
        <bpmn:documentation>Step 2: Provide BuildRight point-of-contact, store emergency numbers, and inventory status list (generators, water, tools).
Responsible (R): Government Affairs Specialist / Regional Store Operations Manager
Accountable (A): Government Affairs Specialist / Regional Store Operations Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5193_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5193_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5193_Task6" name="Receive road status, utility updates, security briefs, and localized disaster…">
        <bpmn:documentation>Step 3: Receive road status, utility updates, security briefs, and localized disaster declarations from DRRMC.
Responsible (R): Government Affairs Specialist / Regional Store Operations Manager
Accountable (A): Government Affairs Specialist / Regional Store Operations Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5193_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5193_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5193_Task7" name="Coordinate joint efforts: arrange for store parking lots to be used as…">
        <bpmn:documentation>Step 4: Coordinate joint efforts: arrange for store parking lots to be used as evacuation staging, or set up mobile charging stations.
Responsible (R): Government Affairs Specialist / Regional Store Operations Manager
Accountable (A): Government Affairs Specialist / Regional Store Operations Manager
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5193_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5193_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5193_End8" name="Complete">
        <bpmn:incoming>W5193_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5193_Annotation9">
        <bpmn:text>Controls: - CTL-772 (ensure controlled execution — Priority Relief Routing, LGU Coordination &amp; Humanitarian Partner Logistics (PA-180.3).) | - CTL-772: Joint plans signed by Regional Manager; LGU authorization badges distributed to store staff.
Owner: Government Affairs Specialist / Regional Store Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5193_Assoc10" sourceRef="W5193_Annotation9" targetRef="W5193_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5193_Flow11" sourceRef="W5193_Start3" targetRef="W5193_Task4" />
