    <bpmn:process id="W_W5199" name="W5199. Humanitarian Delivery Cash Reconciliation &amp; Driver Safety Vetting" isExecutable="false">
      <bpmn:documentation>Trigger: Outbound relief delivery execution; COD transactions in affected zones
Frequency: Per dispatch batch
Volume: ~30–40 dispatches monitored per storm
Owner: COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Participants: Drivers, COD Cashier, Loss Prevention (VS-23), HR (VS-103)
Source: workflow W5199 — Humanitarian Delivery Cash Reconciliation &amp; Driver Safety Vetting</bpmn:documentation>
      <bpmn:laneSet id="W5199_LaneSet2">
        <bpmn:lane id="W5199_Lane1" name="COD Controller">
        <bpmn:flowNodeRef>W5199_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5199_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5199_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5199_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5199_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5199_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5199_Start3" name="Outbound relief delivery execution; COD transactions in affected zones">
        <bpmn:outgoing>W5199_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5199_Task4" name="Vet drivers for high-risk disaster routes: verify license status, health…">
        <bpmn:documentation>Step 1: Vet drivers for high-risk disaster routes: verify license status, health clearance, and defensive driving history.
Responsible (R): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Accountable (A): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5199_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5199_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5199_Task5" name="Issue cash box and mobile POS: instruct drivers on cash handling for COD relief…">
        <bpmn:documentation>Step 2: Issue cash box and mobile POS: instruct drivers on cash handling for COD relief orders (VS-142).
Responsible (R): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Accountable (A): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5199_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5199_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5199_Task6" name="Brief drivers on safety and route hazards: identify bridge washouts, landslide…">
        <bpmn:documentation>Step 3: Brief drivers on safety and route hazards: identify bridge washouts, landslide spots, and looting areas.
Responsible (R): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Accountable (A): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5199_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5199_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5199_Task7" name="Execute delivery; upon return, reconcile cash collection and mobile POS…">
        <bpmn:documentation>Step 4: Execute delivery; upon return, reconcile cash collection and mobile POS records; audit discrepancies (VS-23).
Responsible (R): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Accountable (A): COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5199_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5199_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5199_End8" name="Complete">
        <bpmn:incoming>W5199_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5199_Annotation9">
        <bpmn:text>Controls: - CTL-772 (ensure controlled execution — Priority Relief Routing, LGU Coordination &amp; Humanitarian Partner Logistics (PA-180.3).) | - CTL-772: Drivers vetted before dispatch; cash box counts verified by cashier and supervisor.
Owner: COD Controller (VS-142) / Workforce Vetting Specialist (VS-167)</bpmn:text>
      </bpmn:textAnnotation>
