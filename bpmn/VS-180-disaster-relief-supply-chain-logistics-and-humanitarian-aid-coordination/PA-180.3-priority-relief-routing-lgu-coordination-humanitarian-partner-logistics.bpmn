    <bpmn:process id="W_W5198" name="W5198. Emergency Fleet Fuel Allocation &amp; Auxiliary Power Logistics" isExecutable="false">
      <bpmn:documentation>Trigger: Widespread power grid failure post-disaster; fuel stations offline
Frequency: Event-driven post-disaster
Volume: Reconciliation covering affected DCs and store groups
Owner: Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Participants: Store Managers, DC Managers, Fuel Supplier, LP (VS-23)
Source: workflow W5198 — Emergency Fleet Fuel Allocation &amp; Auxiliary Power Logistics</bpmn:documentation>
      <bpmn:laneSet id="W5198_LaneSet2">
        <bpmn:lane id="W5198_Lane1" name="Fuel &amp; Fleet Cost Manager">
        <bpmn:flowNodeRef>W5198_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5198_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5198_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5198_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5198_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5198_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5198_Start3" name="Widespread power grid failure post-disaster; fuel stations offline">
        <bpmn:outgoing>W5198_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5198_Task4" name="Assess fuel status: audit diesel levels in store/DC backup generators and fleet…">
        <bpmn:documentation>Step 1: Assess fuel status: audit diesel levels in store/DC backup generators and fleet vehicles.
Responsible (R): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Accountable (A): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5198_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5198_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5198_Task5" name="Coordinate fuel tankers: purchase priority bulk diesel from partner oil…">
        <bpmn:documentation>Step 2: Coordinate fuel tankers: purchase priority bulk diesel from partner oil companies (VS-61) and direct deliveries to affected sites.
Responsible (R): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Accountable (A): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5198_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5198_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5198_Task6" name="Set up emergency fuel allocation rules: prioritize fuel for store generators…">
        <bpmn:documentation>Step 3: Set up emergency fuel allocation rules: prioritize fuel for store generators (to prevent server/security outages) and fleet trucks delivering relief kits.
Responsible (R): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Accountable (A): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5198_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5198_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5198_Task7" name="Log fuel consumption at stores/DCs; audit fuel transfers to prevent…">
        <bpmn:documentation>Step 4: Log fuel consumption at stores/DCs; audit fuel transfers to prevent siphoning/theft (VS-23).
Responsible (R): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Accountable (A): Fuel &amp; Fleet Cost Manager (VS-61) / Fleet Supervisor (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5198_Flow14</bpmn:incoming>
        <bpmn:outgoing>W5198_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W5198_End8" name="Complete">
        <bpmn:incoming>W5198_Flow15</bpmn:incoming>
      </bpmn:endEvent>
