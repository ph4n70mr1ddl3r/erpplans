    <bpmn:process id="W_W5197" name="W5197. Disaster Area Store Reopening Safety Clearance &amp; Structural Integrity Audit" isExecutable="false">
      <bpmn:documentation>Trigger: Post-storm damage assessment completion (VS-69); structural damage suspected
Frequency: Event-driven post-disaster
Volume: ~10–15 audits annually
Owner: Facilities Manager (VS-138) / Structural Engineer (Contracted)
Participants: Store Manager, Safety Officer (VS-24), LGU Building Official
Source: workflow W5197 — Disaster Area Store Reopening Safety Clearance &amp; Structural Integrity Audit</bpmn:documentation>
      <bpmn:laneSet id="W5197_LaneSet2">
        <bpmn:lane id="W5197_Lane1" name="Facilities Manager">
