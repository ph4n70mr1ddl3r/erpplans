    <bpmn:process id="W_W5184" name="W5184. DC-to-Store Emergency Transport Route Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Post-landfall road clearance reports; relief dispatch preparation
Frequency: Continuous post-disaster
Volume: ~50–100 dispatch routes managed per storm
Owner: Fleet Planner / Logistics Control Tower Lead (VS-06)
Participants: Drivers, LGU Road Officials, DPWH (Public Works)
Source: workflow W5184 — DC-to-Store Emergency Transport Route Optimization</bpmn:documentation>
      <bpmn:laneSet id="W5184_LaneSet2">
        <bpmn:lane id="W5184_Lane1" name="Fleet Planner">
        <bpmn:flowNodeRef>W5184_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5184_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5184_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5184_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5184_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5184_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5184_Start3" name="Post-landfall road clearance reports; relief dispatch preparation">
        <bpmn:outgoing>W5184_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5184_Task4" name="Monitor road closures: collect reports from DPWH, local news, and regional…">
        <bpmn:documentation>Step 1: Monitor road closures: collect reports from DPWH, local news, and regional store managers.
Responsible (R): Fleet Planner / Logistics Control Tower Lead (VS-06)
Accountable (A): Fleet Planner / Logistics Control Tower Lead (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5184_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5184_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5184_Task5" name="Determine optimized route: use navigation tools to bypass flooded roads…">
        <bpmn:documentation>Step 2: Determine optimized route: use navigation tools to bypass flooded roads, collapsed bridges, and landslide zones.
Responsible (R): Fleet Planner / Logistics Control Tower Lead (VS-06)
Accountable (A): Fleet Planner / Logistics Control Tower Lead (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5184_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5184_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5184_Task6" name="Brief drivers: provide route maps, emergency LGU contacts, satellite phones…">
        <bpmn:documentation>Step 3: Brief drivers: provide route maps, emergency LGU contacts, satellite phones, and road-clearance credentials.
Responsible (R): Fleet Planner / Logistics Control Tower Lead (VS-06)
Accountable (A): Fleet Planner / Logistics Control Tower Lead (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5184_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5184_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5184_Task7" name="Monitor truck GPS in real-time; coordinate backup routes if drivers report…">
        <bpmn:documentation>Step 4: Monitor truck GPS in real-time; coordinate backup routes if drivers report unexpected blockages.
Responsible (R): Fleet Planner / Logistics Control Tower Lead (VS-06)
Accountable (A): Fleet Planner / Logistics Control Tower Lead (VS-06)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5184_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5184_End8" name="Complete">
        <bpmn:incoming>W5184_Flow15</bpmn:incoming>
      </bpmn:endEvent>
