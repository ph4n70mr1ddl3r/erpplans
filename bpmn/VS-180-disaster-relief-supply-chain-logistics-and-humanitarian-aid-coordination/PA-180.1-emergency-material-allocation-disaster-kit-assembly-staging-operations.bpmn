    <bpmn:process id="W_W5183" name="W5183. Inter-Island Relief Freight Capacity Reservation &amp; Shipping Coordination" isExecutable="false">
      <bpmn:documentation>Trigger: Disaster staging plan activation (W5177); Luzon/NCR DC supplying Visayas/Mindanao stores
Frequency: Event-driven per inter-island transit
Volume: ~10–15 shipping charters annually
Owner: Outbound Logistics Manager / Freight Broker (VS-06)
Participants: Shipping Lines (e.g. 2GO, Chelsea), Port Authority, Customs Compliance (VS-87)
Source: workflow W5183 — Inter-Island Relief Freight Capacity Reservation &amp; Shipping Coordination</bpmn:documentation>
      <bpmn:laneSet id="W5183_LaneSet2">
        <bpmn:lane id="W5183_Lane1" name="Outbound Logistics Manager">
