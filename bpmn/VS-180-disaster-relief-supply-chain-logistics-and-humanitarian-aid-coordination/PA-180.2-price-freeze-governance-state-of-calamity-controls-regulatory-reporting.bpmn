        <bpmn:outgoing>W5189_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5189_Task4" name="Define quantity limit rules: set maximum allowable purchase quantities per…">
        <bpmn:documentation>Step 1: Define quantity limit rules: set maximum allowable purchase quantities per customer for basic necessities (e.g. max 5 sheets of GI roofing, 10 bags of cement, 1 generator).
Responsible (R): POS Administrator / IT Developer (VS-27)
Accountable (A): POS Administrator / IT Developer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5189_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5189_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5189_Task5" name="Configure limits in the POS software: block scanning of quantities above limit…">
        <bpmn:documentation>Step 2: Configure limits in the POS software: block scanning of quantities above limit in a single transaction/customer profile.
Responsible (R): POS Administrator / IT Developer (VS-27)
Accountable (A): POS Administrator / IT Developer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5189_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5189_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5189_Task6" name="Implement cashier override protocol: require manager PIN authorization (W5122)…">
        <bpmn:documentation>Step 3: Implement cashier override protocol: require manager PIN authorization (W5122) for legitimate trade-pro or LGU bulk sales.
Responsible (R): POS Administrator / IT Developer (VS-27)
Accountable (A): POS Administrator / IT Developer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5189_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5189_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5189_Task7" name="Display quantity limit advisories at checkout lanes and power aisles.">
        <bpmn:documentation>Step 4: Display quantity limit advisories at checkout lanes and power aisles.
Responsible (R): POS Administrator / IT Developer (VS-27)
Accountable (A): POS Administrator / IT Developer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5189_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5189_End8" name="Complete">
