    <bpmn:process id="W_W5187" name="W5187. Department of Trade and Industry (DTI) Price Compliance Reporting" isExecutable="false">
      <bpmn:documentation>Trigger: DTI request; weekly price monitoring requirements during State of Calamity
Frequency: Weekly during calamity period (up to 60 days)
Volume: ~80–120 reports filed annually
Owner: Regulatory Compliance Officer
Participants: Pricing Analyst (VS-01.2), Store Managers, DTI Inspectors
Source: workflow W5187 — Department of Trade and Industry (DTI) Price Compliance Reporting</bpmn:documentation>
      <bpmn:laneSet id="W5187_LaneSet2">
        <bpmn:lane id="W5187_Lane1" name="Regulatory Compliance Officer">
        <bpmn:flowNodeRef>W5187_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5187_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5187_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5187_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5187_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5187_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5187_Start3" name="DTI request; weekly price monitoring requirements during State of Calamity">
        <bpmn:outgoing>W5187_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5187_Task4" name="Aggregate price lists: compile actual POS transaction prices for basic…">
        <bpmn:documentation>Step 1: Aggregate price lists: compile actual POS transaction prices for basic commodities sold at affected stores.
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5187_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5187_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5187_Task5" name="Prepare the DTI Price Compliance Report matching actual retail prices to…">
        <bpmn:documentation>Step 2: Prepare the DTI Price Compliance Report matching actual retail prices to pre-calamity baselines.
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5187_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5187_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5187_Task6" name="File report with the local DTI provincial office and upload to the DTI…">
        <bpmn:documentation>Step 3: File report with the local DTI provincial office and upload to the DTI compliance portal.
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5187_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5187_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5187_Task7" name="Host DTI field inspectors at store sites; provide access to POS registers…">
        <bpmn:documentation>Step 4: Host DTI field inspectors at store sites; provide access to POS registers, inventory ledgers, and price displays.
Responsible (R): Regulatory Compliance Officer
Accountable (A): Regulatory Compliance Officer
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5187_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5187_End8" name="Complete">
        <bpmn:incoming>W5187_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5187_Annotation9">
        <bpmn:text>Controls: - CTL-83 (ensure calamity pricing &amp; relief-channel compliance.) | - CTL-771: Report signed off by LGU Liaison; copy of DTI inspection certificates filed in document control (VS-88).
Owner: Regulatory Compliance Officer</bpmn:text>
      </bpmn:textAnnotation>
