    <bpmn:process id="W_W5186" name="W5186. ERP Price Freeze Configuration &amp; Store-Level Price Lock Execution" isExecutable="false">
      <bpmn:documentation>Trigger: State of Calamity notification (W5185)
Frequency: Event-driven per calamity
Volume: ~15–20 configurations annually
Owner: Pricing Administrator / IT Systems Engineer (VS-27)
Participants: Pricing Analyst, POS Administrator (VS-08), Store Operations (VS-07)
Source: workflow W5186 — ERP Price Freeze Configuration &amp; Store-Level Price Lock Execution</bpmn:documentation>
      <bpmn:laneSet id="W5186_LaneSet2">
        <bpmn:lane id="W5186_Lane1" name="Pricing Administrator">
        <bpmn:flowNodeRef>W5186_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5186_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5186_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5186_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5186_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5186_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5186_Start3" name="State of Calamity notification (W5185)">
        <bpmn:outgoing>W5186_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W5186_Task4" name="Retrieve price list for the affected stores: lock selling prices of basic…">
        <bpmn:documentation>Step 1: Retrieve price list for the affected stores: lock selling prices of basic necessities and prime commodities (GI sheets, lumber, cement, nails, electrical wires) to their prevailing prices prior to calamity declaration.
Responsible (R): Pricing Administrator / IT Systems Engineer (VS-27)
Accountable (A): Pricing Administrator / IT Systems Engineer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5186_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5186_Flow11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5186_Task5" name="Configure price locks in ERP: disable manual price overrides and promotional…">
        <bpmn:documentation>Step 2: Configure price locks in ERP: disable manual price overrides and promotional discounts for frozen SKUs at the affected store group.
Responsible (R): Pricing Administrator / IT Systems Engineer (VS-27)
Accountable (A): Pricing Administrator / IT Systems Engineer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5186_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5186_Flow12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5186_Task6" name="Push price database updates to store POS terminals; verify update confirmation…">
        <bpmn:documentation>Step 3: Push price database updates to store POS terminals; verify update confirmation from all affected registers.
Responsible (R): Pricing Administrator / IT Systems Engineer (VS-27)
Accountable (A): Pricing Administrator / IT Systems Engineer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5186_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5186_Flow13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W5186_Task7" name="Instruct store staff to print and display the price freeze compliance list at…">
        <bpmn:documentation>Step 4: Instruct store staff to print and display the price freeze compliance list at store entrance and customer service counters.
Responsible (R): Pricing Administrator / IT Systems Engineer (VS-27)
Accountable (A): Pricing Administrator / IT Systems Engineer (VS-27)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5186_Flow14</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W5186_End8" name="Complete">
        <bpmn:incoming>W5186_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W5186_Annotation9">
        <bpmn:text>Controls: - CTL-771 (ensure controlled execution — Price Freeze Governance, State of Calamity Controls &amp; Regulatory Reporting (PA-180.2).) | - CTL-771: Price freeze database verified against pre-calamity transactional prices; audit trail archived.
Owner: Pricing Administrator / IT Systems Engineer (VS-27)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W5186_Assoc10" sourceRef="W5186_Annotation9" targetRef="W5186_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W5186_Flow11" sourceRef="W5186_Start3" targetRef="W5186_Task4" />
      <bpmn:sequenceFlow id="W5186_Flow12" sourceRef="W5186_Task4" targetRef="W5186_Task5" />
