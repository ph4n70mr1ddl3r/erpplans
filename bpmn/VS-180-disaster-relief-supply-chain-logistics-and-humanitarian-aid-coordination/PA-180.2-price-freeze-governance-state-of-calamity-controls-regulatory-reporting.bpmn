        <bpmn:outgoing>W5190_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5190_Task4" name="Monitor LGU announcements for regulatory tax/fee deferrals and permit…">
        <bpmn:documentation>Step 1: Monitor LGU announcements for regulatory tax/fee deferrals and permit extensions.
Responsible (R): LGU Compliance Liaison (VS-76)
Accountable (A): LGU Compliance Liaison (VS-76)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5190_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5190_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5190_Task5" name="Apply for extension: submit application to BPLO to defer local business tax…">
        <bpmn:documentation>Step 2: Apply for extension: submit application to BPLO to defer local business tax renewals and sanitary/environmental fees.
Responsible (R): LGU Compliance Liaison (VS-76)
Accountable (A): LGU Compliance Liaison (VS-76)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5190_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5190_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5190_Task6" name="Secure BPLO approval documents; update the centralized license calendar…">
        <bpmn:documentation>Step 3: Secure BPLO approval documents; update the centralized license calendar (VS-166) with extended deadlines.
Responsible (R): LGU Compliance Liaison (VS-76)
Accountable (A): LGU Compliance Liaison (VS-76)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5190_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5190_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5190_Task7" name="Track deferred liabilities: accrue unpaid local taxes in GL for payment…">
        <bpmn:documentation>Step 4: Track deferred liabilities: accrue unpaid local taxes in GL for payment post-calamity.
Responsible (R): LGU Compliance Liaison (VS-76)
Accountable (A): LGU Compliance Liaison (VS-76)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5190_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5190_End8" name="Complete">
        <bpmn:incoming>W5190_Flow15</bpmn:incoming>
      </bpmn:endEvent>
