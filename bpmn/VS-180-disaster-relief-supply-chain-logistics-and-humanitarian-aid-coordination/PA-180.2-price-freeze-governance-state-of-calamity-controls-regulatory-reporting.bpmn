        <bpmndi:BPMNEdge id="W5186_Assoc10_di" bpmnElement="W5186_Assoc10"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
