    <bpmn:process id="W_W5192" name="W5192. Disaster Tax Relief &amp; BIR Casualty Loss Deduction Certification" isExecutable="false">
      <bpmn:documentation>Trigger: Physical damage to stores or DCs; write-off of ruined inventory
Frequency: Annual tax return preparation (Q1)
Volume: ~5–10 loss certifications annually
Owner: Tax Manager (VS-79)
Participants: External Auditor, Store Manager, Loss Prevention (VS-23), Finance
Source: workflow W5192 — Disaster Tax Relief &amp; BIR Casualty Loss Deduction Certification</bpmn:documentation>
      <bpmn:laneSet id="W5192_LaneSet2">
        <bpmn:lane id="W5192_Lane1" name="Tax Manager">
        <bpmn:flowNodeRef>W5192_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W5192_Task5</bpmn:flowNodeRef>
