        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W5192_Start3" name="Physical damage to stores or DCs; write-off of ruined inventory">
        <bpmn:outgoing>W5192_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W5192_Task4" name="Conduct physical inventory of ruined and damaged stock; take photos and compile…">
        <bpmn:documentation>Step 1: Conduct physical inventory of ruined and damaged stock; take photos and compile police/LP reports (VS-23).
Responsible (R): Tax Manager (VS-79)
Accountable (A): Tax Manager (VS-79)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5192_Flow11</bpmn:incoming>
        <bpmn:outgoing>W5192_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5192_Task5" name="Draft inventory write-off report; post casualty loss adjustments in ERP asset…">
        <bpmn:documentation>Step 2: Draft inventory write-off report; post casualty loss adjustments in ERP asset ledger (VS-35).
Responsible (R): Tax Manager (VS-79)
Accountable (A): Tax Manager (VS-79)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5192_Flow12</bpmn:incoming>
        <bpmn:outgoing>W5192_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5192_Task6" name="File formal claim for Casualty Loss Deduction at the BIR Revenue District…">
        <bpmn:documentation>Step 3: File formal claim for Casualty Loss Deduction at the BIR Revenue District Office (RDO) within 45 days of disaster.
Responsible (R): Tax Manager (VS-79)
Accountable (A): Tax Manager (VS-79)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5192_Flow13</bpmn:incoming>
        <bpmn:outgoing>W5192_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W5192_Task7" name="Secure BIR Commissioner&#x27;s validation clearance; attach to corporate income tax…">
        <bpmn:documentation>Step 4: Secure BIR Commissioner&#x27;s validation clearance; attach to corporate income tax return to deduct losses from taxable income.
Responsible (R): Tax Manager (VS-79)
Accountable (A): Tax Manager (VS-79)
Duration: 1-2 hours</bpmn:documentation>
        <bpmn:incoming>W5192_Flow14</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W5192_End8" name="Complete">
        <bpmn:incoming>W5192_Flow15</bpmn:incoming>
      </bpmn:endEvent>
