    <bpmn:process id="W_W3083" name="W3083. Vendor-Funded Bundle Allowance &amp; Co-Op Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Vendor co-op / bundle allowance agreement
Frequency: Per agreement + claim cycle
Volume: Vendor-funded promos (per §13.3)
Owner: Vendor Management Manager
Participants: Vendor Mgmt, Trade Marketing, Finance/AP
Source: workflow W3083 — Vendor-Funded Bundle Allowance &amp; Co-Op Recovery</bpmn:documentation>
      <bpmn:laneSet id="W3083_LaneSet3">
        <bpmn:lane id="W3083_Lane1" name="Vendor Mgmt">
        <bpmn:flowNodeRef>W3083_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3083_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3083_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3083_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3083_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3083_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3083_Start4" name="Vendor co-op / bundle allowance agreement">
        <bpmn:outgoing>W3083_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3083_Task5" name="Vendor Mgmt/Trade Marketing negotiate vendor-funded bundle allowance and co-op…">
        <bpmn:documentation>Step 1: Vendor Mgmt/Trade Marketing negotiate vendor-funded bundle allowance and co-op terms; document in vendor agreement (links to VS-39)
Responsible (R): Vendor Mgmt / Trade Marketing
Accountable (A): Vendor Management Manager
Duration: Per agreement</bpmn:documentation>
        <bpmn:incoming>W3083_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3083_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3083_Task6" name="Finance/AP compute allowance earned from bundle sell-through; file…">
        <bpmn:documentation>Step 2: Finance/AP compute allowance earned from bundle sell-through; file claim/evidence to vendor; reconcile to AP per VS-39
Responsible (R): Finance / AP
Accountable (A): Finance Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3083_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3083_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3083_Task7" name="Vendor Mgmt pursue recovery; track co-op realization vs. deal; feed into vendor…">
        <bpmn:documentation>Step 3: Vendor Mgmt pursue recovery; track co-op realization vs. deal; feed into vendor scorecard and next-cycle negotiation (links to VS-67)
Responsible (R): Vendor Mgmt
Accountable (A): Vendor Management Manager
Duration: Per cycle</bpmn:documentation>
        <bpmn:incoming>W3083_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3083_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3083_End8" name="Complete">
        <bpmn:incoming>W3083_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3083_Annotation9">
        <bpmn:text>Controls: - CTL-507 (ensure controlled execution — Bundle Pricing, Promotion &amp; Performance Analytics (PA-92.3).) | - operational: evidence-based claims and tracking
Owner: Vendor Management Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3083_Assoc10" sourceRef="W3083_Annotation9" targetRef="W3083_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3083_Flow11" sourceRef="W3083_Start4" targetRef="W3083_Task5" />
      <bpmn:sequenceFlow id="W3083_Flow12" sourceRef="W3083_Task5" targetRef="W3083_Task6" />
      <bpmn:sequenceFlow id="W3083_Flow13" sourceRef="W3083_Task6" targetRef="W3083_Task7" />
      <bpmn:sequenceFlow id="W3083_Flow14" sourceRef="W3083_Task7" targetRef="W3083_End8" />
    </bpmn:process>
