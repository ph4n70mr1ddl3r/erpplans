      <bpmndi:BPMNPlane id="W3081_plane" bpmnElement="W_W3081">
        <bpmndi:BPMNShape id="W3081_Lane1_di" bpmnElement="W3081_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
