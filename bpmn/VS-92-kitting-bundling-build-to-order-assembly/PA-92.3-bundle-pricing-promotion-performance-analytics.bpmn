    <bpmn:process id="W_W3082" name="W3082. Dynamic Bundle Pricing, Quantity Break &amp; Tier Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Quantity-break or tiered bundle pricing configured
Frequency: Per pricing strategy
Volume: Quantity-break pricing (per §9.3)
Owner: Pricing Analyst
Participants: Pricing Analyst, IT/POS, Merchandising
Source: workflow W3082 — Dynamic Bundle Pricing, Quantity Break &amp; Tier Execution</bpmn:documentation>
      <bpmn:laneSet id="W3082_LaneSet4">
        <bpmn:lane id="W3082_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W3082_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3082_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3082_Lane2" name="IT">
        <bpmn:flowNodeRef>W3082_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3082_Lane3" name="Pricing">
        <bpmn:flowNodeRef>W3082_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3082_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3082_Start5" name="Quantity-break or tiered bundle pricing configured">
        <bpmn:outgoing>W3082_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3082_Task6" name="Pricing Analyst defines quantity-break/tier rules (e.g., buy 10+ get 5% off…">
        <bpmn:documentation>Step 1: Pricing Analyst defines quantity-break/tier rules (e.g., buy 10+ get 5% off, tiered bundle pricing) and margin floors per W3067
Responsible (R): Pricing Analyst
Accountable (A): Pricing Manager
Duration: Per rule</bpmn:documentation>
        <bpmn:incoming>W3082_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3082_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3082_Task7" name="IT/POS configure tier logic in POS/ecommerce; validate tier triggers correctly…">
        <bpmn:documentation>Step 2: IT/POS configure tier logic in POS/ecommerce; validate tier triggers correctly at threshold quantities
Responsible (R): IT / POS
Accountable (A): IT Operations Manager
Duration: Per rule</bpmn:documentation>
        <bpmn:incoming>W3082_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3082_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3082_Task8" name="Pricing reviews tier uptake and margin impact; adjusts thresholds to optimize…">
        <bpmn:documentation>Step 3: Pricing reviews tier uptake and margin impact; adjusts thresholds to optimize volume vs. margin
Responsible (R): Pricing
Accountable (A): Pricing Manager
Duration: Periodic</bpmn:documentation>
        <bpmn:incoming>W3082_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3082_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3082_End9" name="Complete">
        <bpmn:incoming>W3082_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3082_Annotation10">
        <bpmn:text>Controls: - CTL-507 (ensure controlled execution — Bundle Pricing, Promotion &amp; Performance Analytics (PA-92.3).) | - operational: margin floors and post-launch review
Owner: Pricing Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3082_Assoc11" sourceRef="W3082_Annotation10" targetRef="W3082_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3082_Flow12" sourceRef="W3082_Start5" targetRef="W3082_Task6" />
      <bpmn:sequenceFlow id="W3082_Flow13" sourceRef="W3082_Task6" targetRef="W3082_Task7" />
      <bpmn:sequenceFlow id="W3082_Flow14" sourceRef="W3082_Task7" targetRef="W3082_Task8" />
      <bpmn:sequenceFlow id="W3082_Flow15" sourceRef="W3082_Task8" targetRef="W3082_End9" />
    </bpmn:process>
