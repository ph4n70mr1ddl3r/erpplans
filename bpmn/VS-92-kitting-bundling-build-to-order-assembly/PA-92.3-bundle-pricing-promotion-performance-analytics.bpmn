    <bpmn:process id="W_W3088" name="W3088. Kit/Bundle Performance Review &amp; Portfolio Optimization" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly portfolio review
Frequency: Quarterly + seasonal
Volume: Full kit/bundle portfolio
Owner: VP Merchandising
Participants: VP Merchandising, Merchandising Analytics, Pricing, Marketing, Supply Chain
Source: workflow W3088 — Kit/Bundle Performance Review &amp; Portfolio Optimization</bpmn:documentation>
      <bpmn:laneSet id="W3088_LaneSet4">
        <bpmn:lane id="W3088_Lane1" name="Merchandising Analytics">
        <bpmn:flowNodeRef>W3088_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3088_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3088_Lane2" name="VP Merchandising">
        <bpmn:flowNodeRef>W3088_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3088_Lane3" name="Merchandising">
        <bpmn:flowNodeRef>W3088_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3088_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3088_Start5" name="Quarterly portfolio review">
        <bpmn:outgoing>W3088_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3088_Task6" name="Merchandising Analytics compile portfolio scorecard: sell-through, margin…">
        <bpmn:documentation>Step 1: Merchandising Analytics compile portfolio scorecard: sell-through, margin, cannibalization, attach, vendor allowance realization per kit
Responsible (R): Merchandising Analytics
Accountable (A): Merchandising Analytics Manager
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3088_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3088_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3088_Task7" name="VP Merchandising/Pricing review portfolio: grow winners, fix/adjust mid-tier…">
        <bpmn:documentation>Step 2: VP Merchandising/Pricing review portfolio: grow winners, fix/adjust mid-tier, discontinue underperformers (W3072); rationalize overlap
Responsible (R): VP Merchandising / Pricing
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3088_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3088_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3088_Task8" name="Merchandising/Supply Chain align next-cycle build plan to optimized portfolio…">
        <bpmn:documentation>Step 3: Merchandising/Supply Chain align next-cycle build plan to optimized portfolio; communicate changes to DC/Store Ops and Marketing
Responsible (R): Merchandising / Supply Chain
Accountable (A): VP Merchandising
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3088_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3088_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3088_End9" name="Complete">
        <bpmn:incoming>W3088_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3088_Annotation10">
        <bpmn:text>Controls: - CTL-507 (ensure controlled execution — Bundle Pricing, Promotion &amp; Performance Analytics (PA-92.3).) | - operational: quarterly rationalization
Owner: VP Merchandising</bpmn:text>
      </bpmn:textAnnotation>
