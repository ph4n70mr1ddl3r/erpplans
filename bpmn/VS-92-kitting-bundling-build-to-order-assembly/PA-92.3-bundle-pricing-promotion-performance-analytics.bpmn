    <bpmn:process id="W_W3081" name="W3081. Bundle Promotion Execution, Price Override &amp; POS Application" isExecutable="false">
      <bpmn:documentation>Trigger: Promotion event or price change
Frequency: Per promotion cycle
Volume: Bi-monthly sale events + monthly hot deals (per §13.3)
Owner: Pricing Manager
Participants: Pricing, Merchandising, Marketing, IT/POS, Ecommerce
Source: workflow W3081 — Bundle Promotion Execution, Price Override &amp; POS Application</bpmn:documentation>
      <bpmn:laneSet id="W3081_LaneSet3">
        <bpmn:lane id="W3081_Lane1" name="Pricing">
        <bpmn:flowNodeRef>W3081_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3081_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3081_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3081_Lane2" name="IT">
        <bpmn:flowNodeRef>W3081_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3081_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3081_Start4" name="Promotion event or price change">
        <bpmn:outgoing>W3081_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3081_Task5" name="Pricing configures bundle promotion in price book (links to W40): bundle…">
        <bpmn:documentation>Step 1: Pricing configures bundle promotion in price book (links to W40): bundle SKU/promo logic, price, validity, channel scope, and loyalty applicability
Responsible (R): Pricing
Accountable (A): Pricing Manager
Duration: Per promo</bpmn:documentation>
        <bpmn:incoming>W3081_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3081_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3081_Task6" name="IT/POS deploy price change to POS (600 terminals) and ecommerce/marketplace…">
        <bpmn:documentation>Step 2: IT/POS deploy price change to POS (600 terminals) and ecommerce/marketplace (links to VS-08/VS-10/VS-65); validate price applies correctly at scan
Responsible (R): IT / POS
Accountable (A): IT Operations Manager
Duration: Per promo</bpmn:documentation>
        <bpmn:incoming>W3081_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3081_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3081_Task7" name="Pricing/Store Ops monitor promotion execution; handle price overrides per…">
        <bpmn:documentation>Step 3: Pricing/Store Ops monitor promotion execution; handle price overrides per authorization (links to POS-010); correct configuration errors
Responsible (R): Pricing / Store Ops
Accountable (A): Pricing Manager
Duration: Per promo</bpmn:documentation>
        <bpmn:incoming>W3081_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3081_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3081_End8" name="Complete">
        <bpmn:incoming>W3081_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3081_Annotation9">
        <bpmn:text>Controls: - CTL-507 (ensure controlled execution — Bundle Pricing, Promotion &amp; Performance Analytics (PA-92.3).) | - operational: pre-launch test transactions
Owner: Pricing Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3081_Assoc10" sourceRef="W3081_Annotation9" targetRef="W3081_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3081_Flow11" sourceRef="W3081_Start4" targetRef="W3081_Task5" />
      <bpmn:sequenceFlow id="W3081_Flow12" sourceRef="W3081_Task5" targetRef="W3081_Task6" />
      <bpmn:sequenceFlow id="W3081_Flow13" sourceRef="W3081_Task6" targetRef="W3081_Task7" />
      <bpmn:sequenceFlow id="W3081_Flow14" sourceRef="W3081_Task7" targetRef="W3081_End8" />
    </bpmn:process>
