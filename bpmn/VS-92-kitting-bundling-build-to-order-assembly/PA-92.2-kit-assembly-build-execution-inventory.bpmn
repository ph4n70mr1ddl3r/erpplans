        <bpmn:outgoing>W3073_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3073_Task6" name="DC Ops/WMS generates kit-build work order per build plan (W3069); allocates and…">
        <bpmn:documentation>Step 1: DC Ops/WMS generates kit-build work order per build plan (W3069); allocates and picks components per BOM (W3066)
Responsible (R): DC Ops / WMS
Accountable (A): DC Operations Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3073_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3073_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3073_Task7" name="DC assembly staff build kits per work order; package, label, and apply kit SKU…">
        <bpmn:documentation>Step 2: DC assembly staff build kits per work order; package, label, and apply kit SKU barcode; stage finished kits to saleable inventory
Responsible (R): DC Assembly Staff
Accountable (A): DC Operations Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3073_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3073_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3073_Task8" name="WMS/Inventory Control confirms component consumption and finished-kit receipt…">
        <bpmn:documentation>Step 3: WMS/Inventory Control confirms component consumption and finished-kit receipt; updates kit and component inventory; closes work order
Responsible (R): WMS / Inventory Control
Accountable (A): DC Operations Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3073_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3073_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3073_End9" name="Complete">
        <bpmn:incoming>W3073_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3073_Annotation10">
        <bpmn:text>Controls: - CTL-506 (ensure controlled execution — Kit Assembly, Build Execution &amp; Inventory Management (PA-92.2).) | - operational: WMS-directed picking and QC (W3075)
Owner: DC Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
