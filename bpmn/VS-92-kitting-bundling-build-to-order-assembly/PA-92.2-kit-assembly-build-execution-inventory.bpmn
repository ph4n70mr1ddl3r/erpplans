    <bpmn:process id="W_W3075" name="W3075. Component Picking, Kit Quality Check &amp; Build Verification" isExecutable="false">
      <bpmn:documentation>Trigger: Kit build / pre-ship verification
Frequency: Per build
Volume: All kit builds
Owner: Quality Manager
Participants: Quality, DC Ops, Store Ops
Source: workflow W3075 — Component Picking, Kit Quality Check &amp; Build Verification</bpmn:documentation>
      <bpmn:laneSet id="W3075_LaneSet3">
        <bpmn:lane id="W3075_Lane1" name="DC Ops">
        <bpmn:flowNodeRef>W3075_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3075_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3075_Lane2" name="Quality">
        <bpmn:flowNodeRef>W3075_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3075_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3075_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3075_Start4" name="Kit build / pre-ship verification">
        <bpmn:outgoing>W3075_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3075_Task5" name="DC Ops/Store Staff pick components per WMS-directed BOM; scan-confirm each…">
        <bpmn:documentation>Step 1: DC Ops/Store Staff pick components per WMS-directed BOM; scan-confirm each component and quantity to prevent substitution errors
Responsible (R): DC Ops / Store Staff
Accountable (A): DC Operations Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3075_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3075_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3075_Task6" name="Quality inspects finished kit: correct components/quantities, packaging…">
        <bpmn:documentation>Step 2: Quality inspects finished kit: correct components/quantities, packaging integrity, labeling, and certification marks (per W447 for regulated)
Responsible (R): Quality
Accountable (A): Quality Manager
Duration: Per build/sample</bpmn:documentation>
        <bpmn:incoming>W3075_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3075_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3075_Task7" name="Quality/Inventory Control log build defects; route rejects to rework or…">
        <bpmn:documentation>Step 3: Quality/Inventory Control log build defects; route rejects to rework or disposition; feed defect rate to vendor/process improvement
Responsible (R): Quality / Inventory Control
Accountable (A): Quality Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3075_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3075_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3075_End8" name="Complete">
        <bpmn:incoming>W3075_Flow14</bpmn:incoming>
      </bpmn:endEvent>
