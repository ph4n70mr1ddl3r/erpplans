    <bpmn:process id="W_W3076" name="W3076. Kit Lot/Serial Tracking, Expiry &amp; Traceability" isExecutable="false">
      <bpmn:documentation>Trigger: Kit build with lot/serial/expiry-relevant components
Frequency: Per build
Volume: Kits with chemical/paint/electrical components
Owner: Inventory Control Manager
Participants: Inventory Control, DC Ops, Quality, IT
Source: workflow W3076 — Kit Lot/Serial Tracking, Expiry &amp; Traceability</bpmn:documentation>
      <bpmn:laneSet id="W3076_LaneSet4">
        <bpmn:lane id="W3076_Lane1" name="Inventory Control">
        <bpmn:flowNodeRef>W3076_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3076_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3076_Lane2" name="IT">
        <bpmn:flowNodeRef>W3076_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3076_Lane3" name="Quality">
        <bpmn:flowNodeRef>W3076_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3076_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3076_Start5" name="Kit build with lot/serial/expiry-relevant components">
        <bpmn:outgoing>W3076_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3076_Task6" name="Inventory Control/DC Ops capture component lot/serial at build; create kit…">
        <bpmn:documentation>Step 1: Inventory Control/DC Ops capture component lot/serial at build; create kit lot/serial inheriting earliest component expiry where relevant
Responsible (R): Inventory Control / DC Ops
Accountable (A): Inventory Control Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3076_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3076_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3076_Task7" name="IT/Inventory Control maintain kit-to-component lot/serial genealogy for…">
        <bpmn:documentation>Step 2: IT/Inventory Control maintain kit-to-component lot/serial genealogy for traceability supporting recalls (links to VS-89) and warranty (links to VS-53)
Responsible (R): IT / Inventory Control
Accountable (A): Inventory Control Manager
Duration: Per build</bpmn:documentation>
        <bpmn:incoming>W3076_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3076_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3076_Task8" name="Quality/Inventory Control monitor kit expiry (chemical/paint kits); enforce…">
        <bpmn:documentation>Step 3: Quality/Inventory Control monitor kit expiry (chemical/paint kits); enforce FEFO and expiry-based disposition (links to W1005)
Responsible (R): Quality / Inventory Control
Accountable (A): Quality Manager
Duration: Continuous</bpmn:documentation>
