    <bpmn:process id="W_W3074" name="W3074. Store-Level Kit Build, Display Assembly &amp; Light Value-Add" isExecutable="false">
      <bpmn:documentation>Trigger: Display bundle or store-assembled kit requirement
Frequency: Per store task / display refresh
Volume: 200 stores; display bundles and light assembly
Owner: Store Operations Manager
Participants: Store Mgr, Sales Associates, Stock Associates
Source: workflow W3074 — Store-Level Kit Build, Display Assembly &amp; Light Value-Add</bpmn:documentation>
      <bpmn:laneSet id="W3074_LaneSet3">
        <bpmn:lane id="W3074_Lane1" name="Store Mgr">
        <bpmn:flowNodeRef>W3074_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3074_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3074_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3074_Lane2" name="Sales">
        <bpmn:flowNodeRef>W3074_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3074_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3074_Start4" name="Display bundle or store-assembled kit requirement">
        <bpmn:outgoing>W3074_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3074_Task5" name="Store Mgr/Visual Merchandising receive display-assembly task (e.g., assembled…">
        <bpmn:documentation>Step 1: Store Mgr/Visual Merchandising receive display-assembly task (e.g., assembled grill display, furniture set, contractor combo display) via VS-55/VS-63
Responsible (R): Store Mgr / Visual Merch
Accountable (A): Store Operations Manager
Duration: Per task</bpmn:documentation>
        <bpmn:incoming>W3074_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3074_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3074_Task6" name="Sales/Stock Associates assemble display or store-assembled kit per…">
        <bpmn:documentation>Step 2: Sales/Stock Associates assemble display or store-assembled kit per instructions; apply price/label; position for sale; consume components in ERP
Responsible (R): Sales / Stock Associates
Accountable (A): Store Manager
Duration: Per task</bpmn:documentation>
        <bpmn:incoming>W3074_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3074_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3074_Task7" name="Store Mgr validates assembled display against planogram (links to VS-55)…">
        <bpmn:documentation>Step 3: Store Mgr validates assembled display against planogram (links to VS-55); manages display maintenance and disassembly for component recovery (W3078)
Responsible (R): Store Mgr
Accountable (A): Store Operations Manager
Duration: Per task</bpmn:documentation>
        <bpmn:incoming>W3074_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3074_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3074_End8" name="Complete">
        <bpmn:incoming>W3074_Flow14</bpmn:incoming>
      </bpmn:endEvent>
