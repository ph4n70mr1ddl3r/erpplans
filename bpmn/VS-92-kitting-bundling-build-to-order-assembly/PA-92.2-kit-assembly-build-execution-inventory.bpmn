    <bpmn:process id="W_W3073" name="W3073. Centralized Kit Build (DC) Work Order &amp; Assembly Execution" isExecutable="false">
      <bpmn:documentation>Trigger: Build plan / kit replenishment requirement
Frequency: Per build cycle
Volume: Pre-packaged kits built at 4 DCs
Owner: DC Operations Manager
Participants: DC Ops, WMS, Inventory Control, Quality
Source: workflow W3073 — Centralized Kit Build (DC) Work Order &amp; Assembly Execution</bpmn:documentation>
      <bpmn:laneSet id="W3073_LaneSet4">
        <bpmn:lane id="W3073_Lane1" name="DC Ops">
        <bpmn:flowNodeRef>W3073_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3073_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3073_Lane2" name="DC Assembly Staff">
        <bpmn:flowNodeRef>W3073_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3073_Lane3" name="WMS">
        <bpmn:flowNodeRef>W3073_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3073_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
