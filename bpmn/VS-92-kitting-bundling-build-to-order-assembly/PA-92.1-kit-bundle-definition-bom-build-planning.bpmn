    <bpmn:process id="W_W3072" name="W3072. Kit/Bundle Discontinuation, Liquidation &amp; Component Recovery" isExecutable="false">
      <bpmn:documentation>Trigger: Kit end-of-life or poor performance
Frequency: Event-driven + seasonal phase-out
Volume: Discontinued kits
Owner: Merchandising Planning Manager
Participants: Merchandising Planning, Supply Chain, DC Ops, Pricing, Finance
Source: workflow W3072 — Kit/Bundle Discontinuation, Liquidation &amp; Component Recovery</bpmn:documentation>
      <bpmn:laneSet id="W3072_LaneSet4">
        <bpmn:lane id="W3072_Lane1" name="Merchandising Planning">
        <bpmn:flowNodeRef>W3072_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3072_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3072_Lane2" name="Pricing">
        <bpmn:flowNodeRef>W3072_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3072_Lane3" name="DC Ops">
        <bpmn:flowNodeRef>W3072_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3072_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3072_Start5" name="Kit end-of-life or poor performance">
        <bpmn:outgoing>W3072_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3072_Task6" name="Merchandising Planning decides discontinuation; stops new builds and…">
        <bpmn:documentation>Step 1: Merchandising Planning decides discontinuation; stops new builds and replenishment; plans sell-through of finished kits and component recovery
Responsible (R): Merchandising Planning
Accountable (A): Merchandising Planning Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3072_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3072_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3072_Task7" name="Pricing/Marketing execute clearance markdown on remaining kit inventory (links…">
        <bpmn:documentation>Step 2: Pricing/Marketing execute clearance markdown on remaining kit inventory (links to VS-64); DC Ops/Store Ops clear shelf and ecommerce listing
Responsible (R): Pricing / Marketing / DC Ops
Accountable (A): Pricing Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3072_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3072_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3072_Task8" name="DC Ops tear down unsold kits per W3078, returning components to saleable stock…">
        <bpmn:documentation>Step 3: DC Ops tear down unsold kits per W3078, returning components to saleable stock; Finance reconciles write-down and component recovery value
Responsible (R): DC Ops / Finance
Accountable (A): DC Operations Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3072_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3072_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3072_End9" name="Complete">
        <bpmn:incoming>W3072_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3072_Annotation10">
        <bpmn:text>Controls: - CTL-76 (ensure kit build &amp; component inventory integrity.) | - operational: sell-through plan and tear-down recovery
Owner: Merchandising Planning Manager</bpmn:text>
      </bpmn:textAnnotation>
