    <bpmn:process id="W_W3066" name="W3066. Kit Bill of Materials (BOM), Component Mapping &amp; Yield Definition" isExecutable="false">
      <bpmn:documentation>Trigger: Kit concept approved
Frequency: Per kit + BOM change
Volume: Per active kit
Owner: Merchandising Planner
Participants: Merchandising Planner, Supply Chain, IT/Master Data
Source: workflow W3066 — Kit Bill of Materials (BOM), Component Mapping &amp; Yield Definition</bpmn:documentation>
      <bpmn:laneSet id="W3066_LaneSet4">
        <bpmn:lane id="W3066_Lane1" name="Merchandising Planner">
        <bpmn:flowNodeRef>W3066_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3066_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3066_Lane2" name="Supply Chain">
        <bpmn:flowNodeRef>W3066_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3066_Lane3" name="IT">
        <bpmn:flowNodeRef>W3066_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3066_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3066_Start5" name="Kit concept approved">
        <bpmn:outgoing>W3066_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3066_Task6" name="Merchandising Planner defines BOM: component SKUs, quantities, substitute…">
        <bpmn:documentation>Step 1: Merchandising Planner defines BOM: component SKUs, quantities, substitute components, and yield (kits per component set); validates component availability
Responsible (R): Merchandising Planner
Accountable (A): Merchandising Planning Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3066_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3066_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3066_Task7" name="Supply Chain validates component sourcing and lead time; flags single-source…">
        <bpmn:documentation>Step 2: Supply Chain validates component sourcing and lead time; flags single-source constraints; confirms build feasibility across DCs
Responsible (R): Supply Chain
Accountable (A): Supply Chain Planning Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3066_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3066_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3066_Task8" name="IT/Master Data configures kit BOM in ERP (phantom vs. stocked kit); sets…">
        <bpmn:documentation>Step 3: IT/Master Data configures kit BOM in ERP (phantom vs. stocked kit); sets component linkage and consumption logic; tests cost roll-up
Responsible (R): IT / Master Data
Accountable (A): Master Data Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3066_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3066_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3066_End9" name="Complete">
        <bpmn:incoming>W3066_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3066_Annotation10">
        <bpmn:text>Controls: - CTL-505 (ensure controlled execution — Kit &amp; Bundle Definition, BOM &amp; Build Planning (PA-92.1).) | - operational: validation and testing
Owner: Merchandising Planner</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3066_Assoc11" sourceRef="W3066_Annotation10" targetRef="W3066_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W3066_Flow12" sourceRef="W3066_Start5" targetRef="W3066_Task6" />
