    <bpmn:process id="W_W3067" name="W3067. Bundle Pricing, Margin Validation &amp; Component Cost Roll-Up" isExecutable="false">
      <bpmn:documentation>Trigger: Kit/BOM defined or price review
Frequency: Per kit + periodic review
Volume: Per active kit
Owner: Pricing Analyst
Participants: Pricing Analyst, Merchandising, Finance, Marketing
Source: workflow W3067 — Bundle Pricing, Margin Validation &amp; Component Cost Roll-Up</bpmn:documentation>
      <bpmn:laneSet id="W3067_LaneSet4">
        <bpmn:lane id="W3067_Lane1" name="Pricing Analyst">
        <bpmn:flowNodeRef>W3067_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3067_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3067_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3067_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3067_Lane3" name="Marketing">
        <bpmn:flowNodeRef>W3067_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3067_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3067_Start5" name="Kit/BOM defined or price review">
        <bpmn:outgoing>W3067_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3067_Task6" name="Pricing Analyst rolls up component landed cost to kit standard cost; compares…">
        <bpmn:documentation>Step 1: Pricing Analyst rolls up component landed cost to kit standard cost; compares to bundle price; validates target margin vs. category margin floor
Responsible (R): Pricing Analyst
Accountable (A): Pricing Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3067_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3067_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3067_Task7" name="Finance/Pricing review margin and cannibalization risk (bundle vs. component…">
        <bpmn:documentation>Step 2: Finance/Pricing review margin and cannibalization risk (bundle vs. component standalone); approve price or adjust
Responsible (R): Finance / Pricing
Accountable (A): Finance Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3067_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3067_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3067_Task8" name="Marketing/Pricing set promotional price tiers, quantity breaks, and channel…">
        <bpmn:documentation>Step 3: Marketing/Pricing set promotional price tiers, quantity breaks, and channel price where applicable; configure in price book (links to W40)
Responsible (R): Marketing / Pricing
Accountable (A): Pricing Manager
Duration: Per kit</bpmn:documentation>
        <bpmn:incoming>W3067_Flow14</bpmn:incoming>
        <bpmn:outgoing>W3067_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3067_End9" name="Complete">
        <bpmn:incoming>W3067_Flow15</bpmn:incoming>
      </bpmn:endEvent>
