      <bpmndi:BPMNPlane id="W4811_plane" bpmnElement="W_W4811">
        <bpmndi:BPMNShape id="W4811_Lane1_di" bpmnElement="W4811_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
