    <bpmn:process id="W_W4809" name="W4809. Locker Preventive Maintenance, Cleaning &amp; Hardware Health" isExecutable="false">
      <bpmn:documentation>Trigger: Calendar interval; platform health alert (W4807); post-storm (VS-69)
Frequency: Per bank monthly + continuous monitoring
Volume: ~all locker banks across the network
Owner: Locker Program Manager / Facilities (VS-138)
Participants: Facilities, Locker vendor (W4794), Store Ops (VS-07)
Source: workflow W4809 — Locker Preventive Maintenance, Cleaning &amp; Hardware Health</bpmn:documentation>
      <bpmn:laneSet id="W4809_LaneSet3">
        <bpmn:lane id="W4809_Lane1" name="Facilities">
        <bpmn:flowNodeRef>W4809_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4809_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4809_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4809_Lane2" name="IT">
        <bpmn:flowNodeRef>W4809_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4809_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4809_Start4" name="Calendar interval; platform health alert (W4807); post-storm (VS-69)">
        <bpmn:outgoing>W4809_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4809_Task5" name="Run the PM schedule per bank: lock/door mechanism test, compartment sensors…">
        <bpmn:documentation>Step 1: Run the PM schedule per bank: lock/door mechanism test, compartment sensors, screen/camera/reader functionality, refrigeration check (W4806) where applicable, structural/weatherproofing (outdoor), and firmware/platform health (W4807); trigger from the asset register
Responsible (R): Facilities / Locker Technician
Accountable (A): Locker Program Manager / Facilities Lead
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W4809_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4809_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4809_Task6" name="Monitor hardware health continuously via the platform (W4807): lock-failure…">
        <bpmn:documentation>Step 2: Monitor hardware health continuously via the platform (W4807): lock-failure rate, sensor faults, connectivity, and reader/camera issues; auto-flag degradation before failure; coordinate with the vendor SLA (W4794)
Responsible (R): IT / Facilities / Locker Program
Accountable (A): Locker Program Manager
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4809_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4809_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4809_Task7" name="Clean and maintain the bank: compartment interiors, screens, cameras…">
        <bpmn:documentation>Step 3: Clean and maintain the bank: compartment interiors, screens, cameras, signage/wayfinding (VS-14), and the surrounding area; post-typhoon inspection (VS-69) for outdoor lockers; keep the bank safe/presentable (CX VS-13)
Responsible (R): Facilities / Store Ops
Accountable (A): Facilities Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4809_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4809_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4809_End8" name="Complete">
        <bpmn:incoming>W4809_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4809_Annotation9">
        <bpmn:text>Controls: - CTL-724 (ensure controlled execution — Maintenance, Integration, Compliance &amp; Network Analytics (PA-164.3).) | - CTL-724: monthly PM per bank; locks/sensors/readers tested; bank cleaned/maintained; refrigeration checked (W4806)
Owner: Locker Program Manager / Facilities (VS-138)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4809_Assoc10" sourceRef="W4809_Annotation9" targetRef="W4809_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4809_Flow11" sourceRef="W4809_Start4" targetRef="W4809_Task5" />
      <bpmn:sequenceFlow id="W4809_Flow12" sourceRef="W4809_Task5" targetRef="W4809_Task6" />
      <bpmn:sequenceFlow id="W4809_Flow13" sourceRef="W4809_Task6" targetRef="W4809_Task7" />
      <bpmn:sequenceFlow id="W4809_Flow14" sourceRef="W4809_Task7" targetRef="W4809_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4809_diag">
      <bpmndi:BPMNPlane id="W4809_plane" bpmnElement="W_W4809">
        <bpmndi:BPMNShape id="W4809_Lane1_di" bpmnElement="W4809_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4809_Lane2_di" bpmnElement="W4809_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
