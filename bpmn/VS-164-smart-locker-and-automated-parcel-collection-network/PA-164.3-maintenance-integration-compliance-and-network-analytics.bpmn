        <bpmndi:BPMNEdge id="W4810_Flow11_di" bpmnElement="W4810_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4810_Flow12_di" bpmnElement="W4810_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4810_Flow13_di" bpmnElement="W4810_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4810_Assoc9_di" bpmnElement="W4810_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4811" name="W4811. Security, Vandalism, Theft &amp; Loss Prevention at Lockers" isExecutable="false">
      <bpmn:documentation>Trigger: Security event; tamper alert; theft/vandalism report; fault (W4810)
Frequency: Per event
Volume: ~20–60 security events/year scaling with network (esp. outdoor/off-site W4798)
Owner: LP Director (VS-23) / Locker Program
Participants: LP (VS-23), Store Ops (VS-07), Police (VS-159 pattern), Vendor, Insurance (VS-26)
Source: workflow W4811 — Security, Vandalism, Theft &amp; Loss Prevention at Lockers</bpmn:documentation>
      <bpmn:laneSet id="W4811_LaneSet2">
        <bpmn:lane id="W4811_Lane1" name="LP">
        <bpmn:flowNodeRef>W4811_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4811_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4811_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4811_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4811_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4811_Start3" name="Security event; tamper alert; theft/vandalism report; fault (W4810)">
        <bpmn:outgoing>W4811_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4811_Task4" name="Respond to the security event: tamper/vandalism/theft at a locker (especially…">
        <bpmn:documentation>Step 1: Respond to the security event: tamper/vandalism/theft at a locker (especially outdoor/off-site W4798); preserve camera evidence (VS-23), secure the bank, and assess customer/merchandise impact; coordinate with police for theft/vandalism (VS-159 pattern)
Responsible (R): LP / Store Ops / Police
Accountable (A): LP Director / Locker Program Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4811_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4811_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4811_Task5" name="Investigate: review camera/platform logs (who opened what, when — W4802…">
        <bpmn:documentation>Step 2: Investigate: review camera/platform logs (who opened what, when — W4802 authentication), determine whether it was customer-side fraud (VS-125 wrong-person pickup), external theft/vandalism, or an internal/process gap; recover stolen items/compartment access and manage the customer refund/replacement (VS-101/VS-32) for any loss
Responsible (R): LP / IT / CX / Police
Accountable (A): LP Director
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4811_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4811_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4811_Task6" name="Remediate and prevent: harden the affected bank/site (camera coverage…">
        <bpmn:documentation>Step 3: Remediate and prevent: harden the affected bank/site (camera coverage, anti-tamper, relocation if repeatedly targeted), update the security case, feed lessons to LP analytics (VS-23) and improvement (VS-133), and manage insurance claims (VS-26) for unrecovered loss
Responsible (R): LP / Facilities / Insurance
Accountable (A): LP Director / Locker Program Manager
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4811_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4811_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4811_End7" name="Complete">
        <bpmn:incoming>W4811_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4811_Annotation8">
        <bpmn:text>Controls: - CTL-724 (ensure controlled execution — Maintenance, Integration, Compliance &amp; Network Analytics (PA-164.3).) | - CTL-724: security events responded immediately; camera/auth evidence preserved; police engaged for theft; losses recovered/insured (VS-26)
Owner: LP Director (VS-23) / Locker Program</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4811_Assoc9" sourceRef="W4811_Annotation8" targetRef="W4811_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4811_Flow10" sourceRef="W4811_Start3" targetRef="W4811_Task4" />
      <bpmn:sequenceFlow id="W4811_Flow11" sourceRef="W4811_Task4" targetRef="W4811_Task5" />
      <bpmn:sequenceFlow id="W4811_Flow12" sourceRef="W4811_Task5" targetRef="W4811_Task6" />
      <bpmn:sequenceFlow id="W4811_Flow13" sourceRef="W4811_Task6" targetRef="W4811_End7" />
    </bpmn:process>
