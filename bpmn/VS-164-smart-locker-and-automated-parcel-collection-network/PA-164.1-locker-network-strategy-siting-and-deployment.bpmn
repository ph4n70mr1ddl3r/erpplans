      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4794" name="W4794. Locker-Vendor/Operator Selection &amp; Contracting" isExecutable="false">
      <bpmn:documentation>Trigger: Partner model selected (W4793); vendor contract expiry; expansion
Frequency: Per sourcing event + multi-year contract
Volume: ~1–3 locker-vendor/operator partners group-wide
Owner: Locker Program Manager / Procurement (VS-03/VS-34) / Legal (VS-100.3)
Participants: Locker vendors, IT (VS-27), Finance (VS-17), TPRM (VS-161)
Source: workflow W4794 — Locker-Vendor/Operator Selection &amp; Contracting</bpmn:documentation>
      <bpmn:laneSet id="W4794_LaneSet3">
        <bpmn:lane id="W4794_Lane1" name="Locker Program Manager">
        <bpmn:flowNodeRef>W4794_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4794_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4794_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4794_Lane2" name="Procurement">
        <bpmn:flowNodeRef>W4794_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4794_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4794_Start4" name="Partner model selected (W4793); vendor contract expiry; expansion">
        <bpmn:outgoing>W4794_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4794_Task5" name="Define vendor requirements: locker hardware (modular bank sizes…">
        <bpmn:documentation>Step 1: Define vendor requirements: locker hardware (modular bank sizes, indoor/outdoor-rated, PWD-accessible lower compartments, refrigerated for sensitive items if needed), management software/API (open API to ERP/ecommerce W4807, OCPP-style interoperability), access methods (app/QR/PIN/RFID per VS-75), uptime SLA, security (camera/tamper/anti-theft), and branding
Responsible (R): Locker Program Manager / IT / Procurement
Accountable (A): GM, Digital Commerce Inc.
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4794_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4794_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4794_Task6" name="Run sourcing &amp; contract: RFP, evaluate…">
        <bpmn:documentation>Step 2: Run sourcing &amp; contract: RFP, evaluate (technical/commercial/coverage/uptime/TPRM cyber &amp; financial DD VS-161), negotiate the agreement (own-purchase + SaaS, or fully-managed-service revenue-share, term/exit, SLA, data-sharing RA 10173 VS-91), and contract via Legal with TPRM provisions
Responsible (R): Procurement / Legal / TPRM / IT
Accountable (A): GM, Digital Commerce Inc. / Legal
Duration: Per event</bpmn:documentation>
        <bpmn:incoming>W4794_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4794_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4794_Task7" name="Onboard: site-access standards, insurance/indemnity (VS-26), DPA &amp; cyber…">
        <bpmn:documentation>Step 3: Onboard: site-access standards, insurance/indemnity (VS-26), DPA &amp; cyber (VS-91/VS-27.3), ERP/ecommerce/loyalty integration scope (W4807), and performance governance (W4814); manage ongoing and re-compete at term
Responsible (R): Locker Program Manager / Procurement / Legal
Accountable (A): GM, Digital Commerce Inc.
Duration: Per partner + continuous</bpmn:documentation>
        <bpmn:incoming>W4794_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4794_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4794_End8" name="Complete">
        <bpmn:incoming>W4794_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4794_Annotation9">
        <bpmn:text>Controls: - CTL-722 (ensure controlled execution — Locker Network Strategy, Siting &amp; Deployment (PA-164.1).) | - CTL-722: open API + cyber + accessibility required; SLA + TPRM DD + DPA in contract; re-compete at term
Owner: Locker Program Manager / Procurement (VS-03/VS-34) / Legal (VS-100.3)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4794_Assoc10" sourceRef="W4794_Annotation9" targetRef="W4794_Start4" associationDirection="None" />
