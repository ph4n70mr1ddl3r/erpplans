        <bpmndi:BPMNShape id="W4793_Task6_di" bpmnElement="W4793_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4793_Start3_di" bpmnElement="W4793_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
