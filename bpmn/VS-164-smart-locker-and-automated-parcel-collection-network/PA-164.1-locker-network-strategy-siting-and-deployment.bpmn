<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-164.1-locker-network-strategy-siting-and-deployment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W4793" name="W4793. Smart-Locker Network Strategy, Business Model &amp; Roadmap" isExecutable="false">
      <bpmn:documentation>Trigger: Program launch; annual strategy review; omnichannel growth (VS-10); new-store (VS-37)/remodel (VS-109)
Frequency: Annual + on launch
Volume: 1 group strategy; ~1–3 locker banks/site (in-store + parking + off-site) → group-wide locker network
Owner: GM, Digital Commerce Inc. / Smart-Locker Network Program Manager
Participants: Ecommerce (VS-10), Store Ops (VS-07), Real Estate (VS-97), Finance (VS-17.4), IT (VS-27)
Source: workflow W4793 — Smart-Locker Network Strategy, Business Model &amp; Roadmap</bpmn:documentation>
      <bpmn:laneSet id="W4793_LaneSet2">
        <bpmn:lane id="W4793_Lane1" name="Locker Program Manager">
        <bpmn:flowNodeRef>W4793_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4793_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4793_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4793_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4793_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4793_Start3" name="Program launch; annual strategy review; omnichannel growth (VS-10); new-store…">
        <bpmn:outgoing>W4793_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4793_Task4" name="Set the network strategy &amp; business model: locker types (in-store BOPIS…">
        <bpmn:documentation>Step 1: Set the network strategy &amp; business model: locker types (in-store BOPIS lockers, parking-lot drive-up lockers, off-site transit/condo/mall lockers), own-operate vs locker-vendor partnership (W4794), the use-case mix (BOPIS collection W4801, returns drop-off W4803, 3P parcel pickup W4805), pricing (free BOPIS vs fee-based 3P/oversize/overstay), and the off-site host-revenue model
Responsible (R): Locker Program Manager / Ecommerce / Finance
Accountable (A): GM, Digital Commerce Inc. / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4793_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4793_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4793_Task5" name="Build the strategic case: BOPIS convenience/conversion uplift (out-of-hours +…">
        <bpmn:documentation>Step 2: Build the strategic case: BOPIS convenience/conversion uplift (out-of-hours + no-queue), returns-friction reduction (VS-32), incremental footfall/basket from locker pickups, 3P-parcel-pickup revenue, capex/opex, and the customer-experience/competitive differentiation; define KPIs (lockers, pickup-success, returns via locker, 3P parcels, footfall-to-basket)
Responsible (R): Locker Program Manager / Finance / Analytics
Accountable (A): GM, Digital Commerce Inc. / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4793_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4793_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4793_Task6" name="Approve the multi-year roadmap &amp; capex envelope (W4800); integrate into…">
        <bpmn:documentation>Step 3: Approve the multi-year roadmap &amp; capex envelope (W4800); integrate into omnichannel strategy (VS-10), capex (VS-40/VS-112), and the store-remodel/new-store programs (VS-109/VS-37); sequence by BOPIS density and site economics
Responsible (R): Locker Program Manager / PMO / Strategy
Accountable (A): COO / CFO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4793_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4793_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4793_End7" name="Complete">
        <bpmn:incoming>W4793_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4793_Annotation8">
        <bpmn:text>Controls: - CTL-722 (ensure controlled execution — Locker Network Strategy, Siting &amp; Deployment (PA-164.1).) | - CTL-722: annual business case reviewed by CFO/COO; phased rollout gated on pickup/returns/3P KPIs; capex via VS-40 gate
Owner: GM, Digital Commerce Inc. / Smart-Locker Network Program Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4793_Assoc9" sourceRef="W4793_Annotation8" targetRef="W4793_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4793_Flow10" sourceRef="W4793_Start3" targetRef="W4793_Task4" />
      <bpmn:sequenceFlow id="W4793_Flow11" sourceRef="W4793_Task4" targetRef="W4793_Task5" />
      <bpmn:sequenceFlow id="W4793_Flow12" sourceRef="W4793_Task5" targetRef="W4793_Task6" />
      <bpmn:sequenceFlow id="W4793_Flow13" sourceRef="W4793_Task6" targetRef="W4793_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4793_diag">
      <bpmndi:BPMNPlane id="W4793_plane" bpmnElement="W_W4793">
        <bpmndi:BPMNShape id="W4793_Lane1_di" bpmnElement="W4793_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4793_Task4_di" bpmnElement="W4793_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
