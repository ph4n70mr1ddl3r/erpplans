        <bpmndi:BPMNShape id="W4795_End9_di" bpmnElement="W4795_End9"><dc:Bounds x="1050" y="487" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W4795_Annotation10_di" bpmnElement="W4795_Annotation10"><dc:Bounds x="160" y="630" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W4795_Flow12_di" bpmnElement="W4795_Flow12"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4795_Flow13_di" bpmnElement="W4795_Flow13"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4795_Flow14_di" bpmnElement="W4795_Flow14"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4795_Flow15_di" bpmnElement="W4795_Flow15"><di:waypoint x="1000" y="505" /><di:waypoint x="1050" y="505" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4795_Assoc11_di" bpmnElement="W4795_Assoc11"><di:waypoint x="340" y="630" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4796" name="W4796. Locker Hardware Specification, Procurement &amp; Asset Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Site approved (W4795); own-operate procurement; refresh
Frequency: Per procurement batch
Volume: ~20–40 locker banks per phase
Owner: Locker Program Manager / Procurement (VS-03/VS-34)
Participants: Locker vendors, IT (VS-27), Facilities (VS-138), Asset Mgmt (VS-35)
Source: workflow W4796 — Locker Hardware Specification, Procurement &amp; Asset Registration</bpmn:documentation>
