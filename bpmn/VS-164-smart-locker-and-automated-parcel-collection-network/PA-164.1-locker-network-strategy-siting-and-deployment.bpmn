        <bpmndi:BPMNEdge id="W4793_Flow10_di" bpmnElement="W4793_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W4793_Flow11_di" bpmnElement="W4793_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
