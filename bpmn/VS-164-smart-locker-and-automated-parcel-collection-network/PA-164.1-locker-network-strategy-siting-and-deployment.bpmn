      <bpmndi:BPMNPlane id="W4794_plane" bpmnElement="W_W4794">
        <bpmndi:BPMNShape id="W4794_Lane1_di" bpmnElement="W4794_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
