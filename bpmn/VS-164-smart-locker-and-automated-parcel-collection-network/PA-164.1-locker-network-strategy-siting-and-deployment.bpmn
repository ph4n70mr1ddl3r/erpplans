      <bpmn:sequenceFlow id="W4794_Flow12" sourceRef="W4794_Task5" targetRef="W4794_Task6" />
      <bpmn:sequenceFlow id="W4794_Flow13" sourceRef="W4794_Task6" targetRef="W4794_Task7" />
      <bpmn:sequenceFlow id="W4794_Flow14" sourceRef="W4794_Task7" targetRef="W4794_End8" />
    </bpmn:process>
