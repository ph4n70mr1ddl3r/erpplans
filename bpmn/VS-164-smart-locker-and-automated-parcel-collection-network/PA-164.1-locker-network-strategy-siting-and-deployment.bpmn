      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4795" name="W4795. Locker Site Selection, Placement &amp; Capacity Modeling" isExecutable="false">
      <bpmn:documentation>Trigger: Rollout phase (W4793); new-store (VS-37)/remodel (VS-109); off-site opportunity
Frequency: Per site + phased
Volume: ~205 in-store/parking candidates + select off-site locations
Owner: Locker Program Manager / Real Estate (VS-97) / Store Ops (VS-07)
Participants: Ecommerce (VS-10), Analytics (VS-28), Facilities (VS-138)
Source: workflow W4795 — Locker Site Selection, Placement &amp; Capacity Modeling</bpmn:documentation>
      <bpmn:laneSet id="W4795_LaneSet4">
        <bpmn:lane id="W4795_Lane1" name="Analytics">
        <bpmn:flowNodeRef>W4795_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4795_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4795_Lane2" name="Locker Program Manager">
        <bpmn:flowNodeRef>W4795_Task7</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4795_Lane3" name="Facilities">
        <bpmn:flowNodeRef>W4795_Task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4795_End9</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4795_Start5" name="Rollout phase (W4793); new-store (VS-37)/remodel (VS-109); off-site opportunity">
        <bpmn:outgoing>W4795_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4795_Task6" name="Model locker demand per site: BOPIS volume (VS-10), returns volume (VS-32)…">
        <bpmn:documentation>Step 1: Model locker demand per site: BOPIS volume (VS-10), returns volume (VS-32), customer density/demographics, footfall, dwell/basket potential, and off-site catchment (transit/condo/mall footfall for off-site lockers); estimate compartment-mix (small/medium/large/oversize) from the basket profile
Responsible (R): Analytics / Ecommerce / Real Estate
Accountable (A): Locker Program Manager
Duration: Per phase</bpmn:documentation>
        <bpmn:incoming>W4795_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4795_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4795_Task7" name="Select placement &amp; size: in-store (near entrance/customer-service for…">
        <bpmn:documentation>Step 2: Select placement &amp; size: in-store (near entrance/customer-service for BOPIS+returns), parking-lot drive-up (out-of-hours pickup), and off-site (transit/condo/mall host W4798); size the bank to peak BOPIS + 3P + buffer; sequence into the capex plan (W4800)
Responsible (R): Locker Program Manager / Real Estate / Store Ops
Accountable (A): GM, Digital Commerce Inc.
Duration: Per phase</bpmn:documentation>
        <bpmn:incoming>W4795_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4795_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4795_Task8" name="Confirm feasibility: space/footprint, power/network connectivity (W4797)…">
        <bpmn:documentation>Step 3: Confirm feasibility: space/footprint, power/network connectivity (W4797), PWD-accessible placement (RA 7277/BP 344), security/camera coverage (VS-23), weather protection for outdoor lockers, and integration with remodel (VS-109)/new-store (VS-37) scope
Responsible (R): Facilities / IT / Real Estate / LP
Accountable (A): Locker Program Manager
Duration: Per site</bpmn:documentation>
        <bpmn:incoming>W4795_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4795_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4795_End9" name="Complete">
        <bpmn:incoming>W4795_Flow15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4795_Annotation10">
        <bpmn:text>Controls: - CTL-722 (ensure controlled execution — Locker Network Strategy, Siting &amp; Deployment (PA-164.1).) | - CTL-722: sites sized to peak demand + buffer; PWD-accessible placement; connectivity confirmed; phased rollout
Owner: Locker Program Manager / Real Estate (VS-97) / Store Ops (VS-07)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4795_Assoc11" sourceRef="W4795_Annotation10" targetRef="W4795_Start5" associationDirection="None" />
      <bpmn:sequenceFlow id="W4795_Flow12" sourceRef="W4795_Start5" targetRef="W4795_Task6" />
      <bpmn:sequenceFlow id="W4795_Flow13" sourceRef="W4795_Task6" targetRef="W4795_Task7" />
      <bpmn:sequenceFlow id="W4795_Flow14" sourceRef="W4795_Task7" targetRef="W4795_Task8" />
      <bpmn:sequenceFlow id="W4795_Flow15" sourceRef="W4795_Task8" targetRef="W4795_End9" />
    </bpmn:process>
