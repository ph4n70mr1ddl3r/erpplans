    <bpmn:process id="W_W2493" name="W2493. Aging Report &amp; Provisioning Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly aging analysis
Frequency: Monthly; ~5,400 accounts
Volume: Monthly aging report
Owner: Finance Manager
Participants: Finance Mgr, Credit Analyst, Collections Specialist, CFO
Source: workflow W2493 — Aging Report &amp; Provisioning Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2493_LaneSet2">
        <bpmn:lane id="W2493_Lane1" name="System">
        <bpmn:flowNodeRef>W2493_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2493_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2493_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2493_Start3" name="Monthly aging analysis">
        <bpmn:outgoing>W2493_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2493_Task4" name="System generates AR aging report: current, 30, 60, 90, 120+ day buckets by…">
        <bpmn:documentation>Step 1: System generates AR aging report: current, 30, 60, 90, 120+ day buckets by account, region, and segment; Finance Manager calculates bad debt provision per PFRS 9 expected credit loss model; adjusts monthly
Responsible (R): System / Finance Manager
Accountable (A): CFO
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2493_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
