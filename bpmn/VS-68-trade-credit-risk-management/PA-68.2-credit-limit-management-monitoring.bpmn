<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-68.2-credit-limit-management-monitoring" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2486" name="W2486. Credit Limit Setting &amp; Approval" isExecutable="false">
      <bpmn:documentation>Trigger: New account approved or existing account review
Frequency: ~200–300 new + ~1,000 adjustments/month
Volume: ~1,200–1,300/month
Owner: Credit Analyst
Participants: Credit Analyst, Finance Mgr, Finance Dir, CFO
Source: workflow W2486 — Credit Limit Setting &amp; Approval</bpmn:documentation>
      <bpmn:laneSet id="W2486_LaneSet2">
        <bpmn:lane id="W2486_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W2486_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2486_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2486_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2486_Start3" name="New account approved or existing account review">
        <bpmn:outgoing>W2486_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2486_Task4" name="Credit Analyst recommends limit based on: risk score, financial capacity, order…">
        <bpmn:documentation>Step 1: Credit Analyst recommends limit based on: risk score, financial capacity, order history, relationship potential, credit insurance coverage; approval per matrix: Analyst ≤PHP 500K, Manager ≤PHP 2M, Director ≤PHP 10M, CFO &gt;PHP 10M
Responsible (R): Credit Analyst / Finance Manager / Finance Controller / CFO
Accountable (A): CFO
Duration: 30 min + approval chain</bpmn:documentation>
        <bpmn:incoming>W2486_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2486_End5" name="Complete">
        <bpmn:incoming>W2486_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2486_Annotation6">
        <bpmn:text>Controls: - CTL-212 (ensure trade-credit exposure control.) | - CTL-434 (credit-authorization — links to VS-16 / W24); Operational: Credit Analyst sign-off on the workflow output
Owner: Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2486_Assoc7" sourceRef="W2486_Annotation6" targetRef="W2486_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2486_Flow8" sourceRef="W2486_Start3" targetRef="W2486_Task4" />
      <bpmn:sequenceFlow id="W2486_Flow9" sourceRef="W2486_Task4" targetRef="W2486_End5" />
    </bpmn:process>
