      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2488" name="W2488. Credit Limit Increase Request" isExecutable="false">
      <bpmn:documentation>Trigger: Customer or Sales requests higher credit limit
Frequency: ~100–200 increase requests/month
Volume: ~100–200/month
Owner: Trade Account Manager
Participants: Trade Account Mgr, Credit Analyst, Finance Mgr
Source: workflow W2488 — Credit Limit Increase Request</bpmn:documentation>
      <bpmn:laneSet id="W2488_LaneSet2">
        <bpmn:lane id="W2488_Lane1" name="Trade Account Mgr">
        <bpmn:flowNodeRef>W2488_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2488_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2488_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2488_Start3" name="Customer or Sales requests higher credit limit">
        <bpmn:outgoing>W2488_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2488_Task4" name="Trade Account Manager submits request with justification: sales growth, payment…">
        <bpmn:documentation>Step 1: Trade Account Manager submits request with justification: sales growth, payment history, new project opportunity; Credit Analyst evaluates; approves or counteroffers; applies to account within 24 hours
Responsible (R): Trade Account Mgr / Credit Analyst
Accountable (A): Finance Manager
Duration: 2–4 hours per request</bpmn:documentation>
        <bpmn:incoming>W2488_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2488_End5" name="Complete">
        <bpmn:incoming>W2488_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2488_Annotation6">
        <bpmn:text>Controls: - CTL-434 (ensure controlled execution — Credit Limit Management &amp; Monitoring (PA-68.2).) | - CTL-434 (credit-authorization — links to VS-16 / W24); Operational: Trade Account Manager sign-off on the workflow output
Owner: Trade Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2488_Assoc7" sourceRef="W2488_Annotation6" targetRef="W2488_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2488_Flow8" sourceRef="W2488_Start3" targetRef="W2488_Task4" />
      <bpmn:sequenceFlow id="W2488_Flow9" sourceRef="W2488_Task4" targetRef="W2488_End5" />
    </bpmn:process>
