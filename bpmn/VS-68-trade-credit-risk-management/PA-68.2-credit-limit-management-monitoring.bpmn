      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2491" name="W2491. Customer Payment Behavior Scoring" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly payment behavior update
Frequency: Monthly; ~5,200 active accounts
Volume: ~5,200 scores/month
Owner: System / Credit Analyst
Participants: System, Credit Analyst, Collections Specialist
Source: workflow W2491 — Customer Payment Behavior Scoring</bpmn:documentation>
      <bpmn:laneSet id="W2491_LaneSet2">
        <bpmn:lane id="W2491_Lane1" name="System">
        <bpmn:flowNodeRef>W2491_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2491_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2491_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2491_Start3" name="Monthly payment behavior update">
        <bpmn:outgoing>W2491_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2491_Task4" name="System calculates payment behavior score: on-time payment %, average days past…">
        <bpmn:documentation>Step 1: System calculates payment behavior score: on-time payment %, average days past due, payment trend (improving/deteriorating), promise-to-pay fulfillment rate; feeds into composite risk score
Responsible (R): System
Accountable (A): Credit Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2491_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2491_End5" name="Complete">
        <bpmn:incoming>W2491_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2491_Annotation6">
        <bpmn:text>Controls: - CTL-153: consented scoring-data handling (data-privacy — links to VS-91 / W53, RA 10173); Operational: System / Credit Analyst sign-off on the workflow output
Owner: System / Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2491_Assoc7" sourceRef="W2491_Annotation6" targetRef="W2491_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2491_Flow8" sourceRef="W2491_Start3" targetRef="W2491_Task4" />
      <bpmn:sequenceFlow id="W2491_Flow9" sourceRef="W2491_Task4" targetRef="W2491_End5" />
    </bpmn:process>
