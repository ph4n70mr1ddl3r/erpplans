      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2487" name="W2487. Real-Time Credit Limit Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Order placed against trade account
Frequency: Continuous; ~3,500 AR invoices/month
Volume: ~3,500/month
Owner: System / Credit Analyst
Participants: System, Credit Analyst, Trade Account Mgr
Source: workflow W2487 — Real-Time Credit Limit Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2487_LaneSet2">
        <bpmn:lane id="W2487_Lane1" name="System">
        <bpmn:flowNodeRef>W2487_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2487_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2487_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2487_Start3" name="Order placed against trade account">
        <bpmn:outgoing>W2487_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2487_Task4" name="System monitors real-time: outstanding balance vs. credit limit; auto-blocks…">
        <bpmn:documentation>Step 1: System monitors real-time: outstanding balance vs. credit limit; auto-blocks orders exceeding limit; auto-flags accounts at 80% utilization for analyst review; sends alert to Trade Account Manager
Responsible (R): System
Accountable (A): Credit Analyst
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2487_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2487_End5" name="Complete">
        <bpmn:incoming>W2487_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2487_Annotation6">
        <bpmn:text>Controls: - CTL-212 (ensure trade-credit exposure control.) | - CTL-434 (credit-authorization — links to VS-16 / W24); Operational: System / Credit Analyst sign-off on the workflow output
Owner: System / Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2487_Assoc7" sourceRef="W2487_Annotation6" targetRef="W2487_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2487_Flow8" sourceRef="W2487_Start3" targetRef="W2487_Task4" />
      <bpmn:sequenceFlow id="W2487_Flow9" sourceRef="W2487_Task4" targetRef="W2487_End5" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2487_diag">
