    <bpmn:process id="W_W2489" name="W2489. Credit Limit Reduction &amp; Suspension" isExecutable="false">
      <bpmn:documentation>Trigger: Account risk increase detected
Frequency: ~20–30 reductions/suspensions/month
Volume: ~20–30/month
Owner: Credit Analyst
Participants: Credit Analyst, Finance Mgr, Trade Account Mgr, Head of Trade / Account Management
Source: workflow W2489 — Credit Limit Reduction &amp; Suspension</bpmn:documentation>
      <bpmn:laneSet id="W2489_LaneSet2">
        <bpmn:lane id="W2489_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W2489_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2489_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2489_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2489_Start3" name="Account risk increase detected">
        <bpmn:outgoing>W2489_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2489_Task4" name="Credit Analyst reduces or suspends limit based on: payment deterioration…">
        <bpmn:documentation>Step 1: Credit Analyst reduces or suspends limit based on: payment deterioration, credit bureau alert, financial statement weakness, industry downturn; notifies Trade Account Manager; manages customer relationship impact
Responsible (R): Credit Analyst
Accountable (A): Finance Controller
Duration: 1–2 hours per action</bpmn:documentation>
        <bpmn:incoming>W2489_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2489_End5" name="Complete">
        <bpmn:incoming>W2489_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2489_Annotation6">
        <bpmn:text>Controls: - CTL-434 (ensure controlled execution — Credit Limit Management &amp; Monitoring (PA-68.2).) | - CTL-434 (credit-authorization — links to VS-16 / W24); Operational: Credit Analyst sign-off on the workflow output
Owner: Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2489_Assoc7" sourceRef="W2489_Annotation6" targetRef="W2489_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2489_Flow8" sourceRef="W2489_Start3" targetRef="W2489_Task4" />
      <bpmn:sequenceFlow id="W2489_Flow9" sourceRef="W2489_Task4" targetRef="W2489_End5" />
    </bpmn:process>
