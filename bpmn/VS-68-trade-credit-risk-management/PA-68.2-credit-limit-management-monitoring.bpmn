    <bpmn:process id="W_W2490" name="W2490. Overdue Payment Monitoring &amp; Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Customer payment past due
Frequency: Daily monitoring; ~5–8% of accounts typically past due
Volume: ~260–416 past-due accounts at any time
Owner: Collections Specialist
Participants: Collections Specialist, Credit Analyst, Finance Mgr
Source: workflow W2490 — Overdue Payment Monitoring &amp; Escalation</bpmn:documentation>
      <bpmn:laneSet id="W2490_LaneSet2">
        <bpmn:lane id="W2490_Lane1" name="System">
        <bpmn:flowNodeRef>W2490_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2490_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2490_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2490_Start3" name="Customer payment past due">
        <bpmn:outgoing>W2490_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2490_Task4" name="System generates daily past-due report: aging buckets (30/60/90/120+ days)…">
        <bpmn:documentation>Step 1: System generates daily past-due report: aging buckets (30/60/90/120+ days); Collections Specialist contacts customers: 30-day (friendly reminder), 60-day (formal demand), 90-day (hold shipments), 120+ day (legal escalation)
Responsible (R): System / Collections Specialist
Accountable (A): Finance Manager
Duration: 2–3 hours/day</bpmn:documentation>
        <bpmn:incoming>W2490_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2490_End5" name="Complete">
        <bpmn:incoming>W2490_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2490_Annotation6">
        <bpmn:text>Controls: - CTL-212: duplicate-invoice/payment-application guard; Operational: Collections Specialist sign-off on the workflow output
Owner: Collections Specialist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2490_Assoc7" sourceRef="W2490_Annotation6" targetRef="W2490_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2490_Flow8" sourceRef="W2490_Start3" targetRef="W2490_Task4" />
      <bpmn:sequenceFlow id="W2490_Flow9" sourceRef="W2490_Task4" targetRef="W2490_End5" />
    </bpmn:process>
