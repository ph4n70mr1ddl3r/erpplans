    <bpmn:process id="W_W2495" name="W2495. Legal Collection Escalation" isExecutable="false">
      <bpmn:documentation>Trigger: Account reaches 120+ days and pre-legal exhausted
Frequency: ~20–30 legal escalations/year
Volume: ~20–30/year
Owner: Legal Counsel
Participants: Legal, Collections Mgr, Finance Dir, External Counsel
Source: workflow W2495 — Legal Collection Escalation</bpmn:documentation>
      <bpmn:laneSet id="W2495_LaneSet2">
        <bpmn:lane id="W2495_Lane1" name="Legal Counsel">
        <bpmn:flowNodeRef>W2495_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2495_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2495_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2495_Start3" name="Account reaches 120+ days and pre-legal exhausted">
        <bpmn:outgoing>W2495_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2495_Task4" name="Legal issues formal demand letter; if no response, files collection case with…">
        <bpmn:documentation>Step 1: Legal issues formal demand letter; if no response, files collection case with Philippine courts; manages legal process with external counsel; tracks cases through judicial system
Responsible (R): Legal Counsel
Accountable (A): VP Legal
Duration: 2–3 days per case + ongoing</bpmn:documentation>
        <bpmn:incoming>W2495_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2495_End5" name="Complete">
        <bpmn:incoming>W2495_Flow9</bpmn:incoming>
      </bpmn:endEvent>
