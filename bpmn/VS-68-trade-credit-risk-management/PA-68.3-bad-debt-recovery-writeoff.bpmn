    <bpmn:process id="W_W2499" name="W2499. Bad Debt Trend Analysis &amp; Prevention" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly trend analysis
Frequency: Monthly
Volume: Full portfolio: ~5,400 accounts
Owner: Credit Analyst
Participants: Credit Analyst, Finance Dir, Head of Trade / Account Management
Source: workflow W2499 — Bad Debt Trend Analysis &amp; Prevention</bpmn:documentation>
      <bpmn:laneSet id="W2499_LaneSet2">
        <bpmn:lane id="W2499_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W2499_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2499_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2499_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2499_Start3" name="Monthly trend analysis">
        <bpmn:outgoing>W2499_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2499_Task4" name="Analyzes: bad debt rate trend, default predictors, high-risk segments, industry…">
