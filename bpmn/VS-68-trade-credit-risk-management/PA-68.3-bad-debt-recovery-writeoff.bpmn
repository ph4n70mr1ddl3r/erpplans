    <bpmn:process id="W_W2498" name="W2498. Credit Insurance Claim Filing" isExecutable="false">
      <bpmn:documentation>Trigger: Insured account becomes uncollectible
Frequency: ~5–10 claims/year
Volume: ~5–10/year
Owner: Finance Analyst
Participants: Finance Analyst, Insurance Broker, Credit Insurer
Source: workflow W2498 — Credit Insurance Claim Filing</bpmn:documentation>
      <bpmn:laneSet id="W2498_LaneSet2">
        <bpmn:lane id="W2498_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2498_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2498_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2498_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2498_Start3" name="Insured account becomes uncollectible">
        <bpmn:outgoing>W2498_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2498_Task4" name="Analyst files credit insurance claim: customer details, outstanding amount…">
        <bpmn:documentation>Step 1: Analyst files credit insurance claim: customer details, outstanding amount, collection history, reason for non-payment; insurer investigates; approves claim per policy terms; payout received within 60–90 days
Responsible (R): Finance Analyst
Accountable (A): Finance Controller
Duration: 2–3 days per claim + 60–90 days</bpmn:documentation>
        <bpmn:incoming>W2498_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2498_End5" name="Complete">
