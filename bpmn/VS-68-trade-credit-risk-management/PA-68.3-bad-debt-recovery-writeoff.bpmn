    <bpmn:process id="W_W2494" name="W2494. Pre-Legal Collections &amp; Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: Account reaches 90+ days past due
Frequency: ~50–80 accounts in pre-legal at any time
Volume: ~50–80 accounts
Owner: Collections Manager
Participants: Collections Mgr, Credit Analyst, Legal, Head of Trade / Account Management
Source: workflow W2494 — Pre-Legal Collections &amp; Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W2494_LaneSet2">
        <bpmn:lane id="W2494_Lane1" name="Collections Manager">
        <bpmn:flowNodeRef>W2494_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2494_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2494_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2494_Start3" name="Account reaches 90+ days past due">
        <bpmn:outgoing>W2494_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2494_Task4" name="Collections Manager conducts intensive collection: phone, email, in-person…">
        <bpmn:documentation>Step 1: Collections Manager conducts intensive collection: phone, email, in-person visit for high-value accounts; negotiates payment plan (structured payments over 3–6 months); documents all collection activity
Responsible (R): Collections Manager
Accountable (A): Finance Controller
Duration: 4–6 hours/account</bpmn:documentation>
        <bpmn:incoming>W2494_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2494_End5" name="Complete">
        <bpmn:incoming>W2494_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2494_Annotation6">
        <bpmn:text>Controls: - CTL-435 (ensure controlled execution — Bad Debt Recovery &amp; Write-Off Management (PA-68.3).) | - operational: Collections Manager sign-off on the workflow output
Owner: Collections Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2494_Assoc7" sourceRef="W2494_Annotation6" targetRef="W2494_Start3" associationDirection="None" />
