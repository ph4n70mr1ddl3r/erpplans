<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-68.1-trade-credit-risk-assessment" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W2478" name="W2478. New Trade Account Credit Application" isExecutable="false">
      <bpmn:documentation>Trigger: New B2B customer applies for trade credit
Frequency: ~200–300 new credit applications/month
Volume: ~200–300/month
Owner: Credit Analyst
Participants: Credit Analyst, Trade Account Mgr, Finance Mgr
Source: workflow W2478 — New Trade Account Credit Application</bpmn:documentation>
      <bpmn:laneSet id="W2478_LaneSet3">
        <bpmn:lane id="W2478_Lane1" name="Trade Account Mgr">
        <bpmn:flowNodeRef>W2478_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2478_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2478_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W2478_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2478_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2478_Start4" name="New B2B customer applies for trade credit">
        <bpmn:outgoing>W2478_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2478_Task5" name="Trade Account Manager collects application: business registration (DTI/SEC)…">
        <bpmn:documentation>Step 1: Trade Account Manager collects application: business registration (DTI/SEC), financial statements, trade references, banking references; Credit Analyst verifies documents and runs background check
Responsible (R): Trade Account Mgr / Credit Analyst
Accountable (A): Finance Manager
Duration: 1–2 days</bpmn:documentation>
        <bpmn:incoming>W2478_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2478_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2478_Task6" name="Credit Analyst assesses risk: business viability, payment history (via credit…">
        <bpmn:documentation>Step 2: Credit Analyst assesses risk: business viability, payment history (via credit bureau), financial ratios (current ratio, debt-to-equity), industry risk, relationship potential; assigns risk score (A–E)
Responsible (R): Credit Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours</bpmn:documentation>
        <bpmn:incoming>W2478_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2478_End7" name="Complete">
        <bpmn:incoming>W2478_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2478_Annotation8">
        <bpmn:text>Controls: - CTL-212 (ensure trade-credit exposure control.) | - CTL-433 (credit-authorization — links to VS-16 / W24); Operational: Credit Analyst sign-off on the workflow output
Owner: Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2478_Assoc9" sourceRef="W2478_Annotation8" targetRef="W2478_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2478_Flow10" sourceRef="W2478_Start4" targetRef="W2478_Task5" />
      <bpmn:sequenceFlow id="W2478_Flow11" sourceRef="W2478_Task5" targetRef="W2478_Task6" />
      <bpmn:sequenceFlow id="W2478_Flow12" sourceRef="W2478_Task6" targetRef="W2478_End7" />
    </bpmn:process>
