    <bpmn:process id="W_W2481" name="W2481. Credit Bureau &amp; External Data Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly data refresh from credit bureaus
Frequency: Monthly; ~5,400 accounts
Volume: ~5,400 accounts refreshed/month
Owner: IT Integration Lead
Participants: IT Integration, Credit Analyst, Credit Bureau
Source: workflow W2481 — Credit Bureau &amp; External Data Integration</bpmn:documentation>
      <bpmn:laneSet id="W2481_LaneSet2">
