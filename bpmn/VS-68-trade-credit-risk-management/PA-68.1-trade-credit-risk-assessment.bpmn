    <bpmn:process id="W_W2482" name="W2482. Customer Financial Statement Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Customer provides updated financial statements
Frequency: Annual for top 200 accounts; on request for others
Volume: ~200+ analyses/year
Owner: Credit Analyst
Participants: Credit Analyst, Finance Manager
Source: workflow W2482 — Customer Financial Statement Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2482_LaneSet2">
        <bpmn:lane id="W2482_Lane1" name="Credit Analyst">
        <bpmn:flowNodeRef>W2482_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2482_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2482_End5</bpmn:flowNodeRef>
