    <bpmn:process id="W_W2479" name="W2479. Credit Scoring Model Maintenance" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly model recalibration
Frequency: Quarterly; model serves ~5,200 active accounts
Volume: Model recalibration quarterly
Owner: Credit Analyst / Data Scientist
Participants: Credit Analyst, Data Scientist, Finance Dir
Source: workflow W2479 — Credit Scoring Model Maintenance</bpmn:documentation>
      <bpmn:laneSet id="W2479_LaneSet2">
        <bpmn:lane id="W2479_Lane1" name="Data Scientist">
        <bpmn:flowNodeRef>W2479_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2479_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2479_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2479_Start3" name="Quarterly model recalibration">
        <bpmn:outgoing>W2479_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2479_Task4" name="Data Scientist recalibrates credit scoring model: updates weightings based on…">
        <bpmn:documentation>Step 1: Data Scientist recalibrates credit scoring model: updates weightings based on actual default experience, adds new predictive variables (payment trend, order frequency changes), backtests against portfolio performance
Responsible (R): Data Scientist / Credit Analyst
Accountable (A): Finance Controller
Duration: 3–5 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2479_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2479_End5" name="Complete">
        <bpmn:incoming>W2479_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2479_Annotation6">
        <bpmn:text>Controls: - CTL-433 (ensure controlled execution — Trade Credit Risk Assessment &amp; Scoring (PA-68.1).) | - CTL-433 (credit-authorization — links to VS-16 / W24); Operational: Credit Analyst / Data Scientist sign-off on the workflow output
Owner: Credit Analyst / Data Scientist</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2479_Assoc7" sourceRef="W2479_Annotation6" targetRef="W2479_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2479_Flow8" sourceRef="W2479_Start3" targetRef="W2479_Task4" />
      <bpmn:sequenceFlow id="W2479_Flow9" sourceRef="W2479_Task4" targetRef="W2479_End5" />
    </bpmn:process>
