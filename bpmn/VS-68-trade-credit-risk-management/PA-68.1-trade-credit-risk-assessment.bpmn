      </bpmn:startEvent>
      <bpmn:userTask id="W2482_Task4" name="Credit Analyst reviews financial statements: revenue trend, profitability…">
        <bpmn:documentation>Step 1: Credit Analyst reviews financial statements: revenue trend, profitability, liquidity ratios, leverage, cash flow adequacy; compares to industry benchmarks; adjusts risk score accordingly
Responsible (R): Credit Analyst
Accountable (A): Finance Manager
Duration: 2–4 hours/account</bpmn:documentation>
        <bpmn:incoming>W2482_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2482_End5" name="Complete">
