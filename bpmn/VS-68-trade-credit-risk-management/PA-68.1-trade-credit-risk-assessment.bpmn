      </bpmn:startEvent>
      <bpmn:serviceTask id="W2481_Task4" name="System pulls monthly credit bureau updates: credit score changes, legal…">
        <bpmn:documentation>Step 1: System pulls monthly credit bureau updates: credit score changes, legal filings, negative events; auto-flags accounts with significant score decline (&gt;20 points) for analyst review
Responsible (R): System / IT Integration Lead
Accountable (A): Credit Analyst
Duration: Automated + 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2481_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2481_End5" name="Complete">
