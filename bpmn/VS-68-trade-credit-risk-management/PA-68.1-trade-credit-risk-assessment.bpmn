      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2480" name="W2480. Existing Account Periodic Credit Review" isExecutable="false">
      <bpmn:documentation>Trigger: Annual review for all accounts; quarterly for high-risk
Frequency: Annual ~5,200 reviews; quarterly ~500 high-risk
Volume: ~5,200 annual + ~2,000 quarterly high-risk reviews
Owner: Credit Analyst
Participants: Credit Analyst, Trade Account Mgr, Finance Mgr
Source: workflow W2480 — Existing Account Periodic Credit Review</bpmn:documentation>
      <bpmn:laneSet id="W2480_LaneSet3">
        <bpmn:lane id="W2480_Lane1" name="System">
        <bpmn:flowNodeRef>W2480_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2480_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2480_Lane2" name="Credit Analyst">
        <bpmn:flowNodeRef>W2480_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2480_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2480_Start4" name="Annual review for all accounts; quarterly for high-risk">
        <bpmn:outgoing>W2480_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2480_Task5" name="System auto-triggers annual review: refreshes credit bureau data, analyzes…">
        <bpmn:documentation>Step 1: System auto-triggers annual review: refreshes credit bureau data, analyzes 12-month payment behavior, updates financial ratios, recalculates risk score; recommends credit limit adjustment (increase/decrease/maintain)
Responsible (R): System / Credit Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/account</bpmn:documentation>
        <bpmn:incoming>W2480_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2480_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="W2480_Task6" name="Quarterly high-risk reviews: accounts with score decline, late payments &gt;15%…">
        <bpmn:documentation>Step 2: Quarterly high-risk reviews: accounts with score decline, late payments &gt;15%, or exceeding 80% of credit limit; Credit Analyst conducts deep review; recommends corrective action
Responsible (R): Credit Analyst
Accountable (A): Finance Controller
Duration: 2–3 hours/account</bpmn:documentation>
        <bpmn:incoming>W2480_Flow11</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2480_End7" name="Complete">
        <bpmn:incoming>W2480_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2480_Annotation8">
        <bpmn:text>Controls: - CTL-212 (ensure trade-credit exposure control.) | - CTL-433 (credit-authorization — links to VS-16 / W24); Operational: Credit Analyst sign-off on the workflow output
Owner: Credit Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2480_Assoc9" sourceRef="W2480_Annotation8" targetRef="W2480_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2480_Flow10" sourceRef="W2480_Start4" targetRef="W2480_Task5" />
      <bpmn:sequenceFlow id="W2480_Flow11" sourceRef="W2480_Task5" targetRef="W2480_Task6" />
      <bpmn:sequenceFlow id="W2480_Flow12" sourceRef="W2480_Task6" targetRef="W2480_End7" />
    </bpmn:process>
