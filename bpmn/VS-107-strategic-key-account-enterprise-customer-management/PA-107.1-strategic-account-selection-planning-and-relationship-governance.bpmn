      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3427" name="W3427. Key Account Plan (KAP) Development &amp; Annual Joint Business Planning" isExecutable="false">
      <bpmn:documentation>Trigger: Annual planning (links to VS-33.1); account onboarding (W3426)
Frequency: Annual + mid-year refresh
Volume: One KAP per strategic account (~700 KAPs)
Owner: Account Manager
Participants: Account Manager, Executive Sponsor, Customer counterparts, Category/Specialist teams (links to VS-01/VS-66/VS-77), Finance (links to VS-17.4)
Source: workflow W3427 — Key Account Plan (KAP) Development &amp; Annual Joint Business Planning</bpmn:documentation>
      <bpmn:laneSet id="W3427_LaneSet2">
        <bpmn:lane id="W3427_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3427_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3427_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3427_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3427_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3427_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3427_Start3" name="Annual planning (links to VS-33.1); account onboarding (W3426)">
        <bpmn:outgoing>W3427_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3427_Task4" name="Account Manager build the Key Account Plan: customer profile and business…">
        <bpmn:documentation>Step 1: Account Manager build the Key Account Plan: customer profile and business context, wallet/share analysis, revenue/GM$ target and growth thesis, category/product opportunity (links to VS-01), project pipeline (links to VS-11.2/VS-77), competitor position, key stakeholders and relationship gaps (W3429), risks/issues, and 12-month action plan with owners
Responsible (R): Account Manager / Finance
Accountable (A): Head of Strategic Accounts
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3427_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3427_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3427_Task5" name="Account Manager/Sponsor conduct the Joint Business Planning (JBP) session with…">
        <bpmn:documentation>Step 2: Account Manager/Sponsor conduct the Joint Business Planning (JBP) session with the customer: align on mutual targets, project pipeline, pricing/contract terms (links to W3434), service-level expectations, product/category roadmap, and joint marketing/CSR (links to VS-14/VS-135); capture commitments and action items
Responsible (R): Account Manager / Sponsor / Customer
Accountable (A): Head of Strategic Accounts
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3427_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3427_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3427_Task6" name="Account Manager finalize and lock the KAP/JBP in CRM (links to VS-13.3)…">
        <bpmn:documentation>Step 3: Account Manager finalize and lock the KAP/JBP in CRM (links to VS-13.3), cascade targets to category/specialist teams (links to VS-01/VS-66/VS-77), integrate to the revenue/margin plan (links to VS-33.1/VS-101.3), and set the review cadence (W3430); refresh mid-year
Responsible (R): Account Manager
Accountable (A): Head of Strategic Accounts
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3427_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3427_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3427_End7" name="Complete">
        <bpmn:incoming>W3427_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3427_Annotation8">
        <bpmn:text>Controls: - CTL-550 (ensure controlled execution — Strategic Account Selection, Planning &amp; Relationship Governance (PA-107.1).) | - operational: cadence (W3430) and executive sponsorship; operational: JBP and finance integration
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3427_Assoc9" sourceRef="W3427_Annotation8" targetRef="W3427_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3427_Flow10" sourceRef="W3427_Start3" targetRef="W3427_Task4" />
      <bpmn:sequenceFlow id="W3427_Flow11" sourceRef="W3427_Task4" targetRef="W3427_Task5" />
      <bpmn:sequenceFlow id="W3427_Flow12" sourceRef="W3427_Task5" targetRef="W3427_Task6" />
      <bpmn:sequenceFlow id="W3427_Flow13" sourceRef="W3427_Task6" targetRef="W3427_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3427_diag">
      <bpmndi:BPMNPlane id="W3427_plane" bpmnElement="W_W3427">
        <bpmndi:BPMNShape id="W3427_Lane1_di" bpmnElement="W3427_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_Task4_di" bpmnElement="W3427_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_Task5_di" bpmnElement="W3427_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_Task6_di" bpmnElement="W3427_Task6"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_Start3_di" bpmnElement="W3427_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_End7_di" bpmnElement="W3427_End7"><dc:Bounds x="1050" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3427_Annotation8_di" bpmnElement="W3427_Annotation8"><dc:Bounds x="160" y="290" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3427_Flow10_di" bpmnElement="W3427_Flow10"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3427_Flow11_di" bpmnElement="W3427_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3427_Flow12_di" bpmnElement="W3427_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3427_Flow13_di" bpmnElement="W3427_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3427_Assoc9_di" bpmnElement="W3427_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3428" name="W3428. Account Team Structure, Assignment &amp; Executive Sponsorship" isExecutable="false">
      <bpmn:documentation>Trigger: Account onboarding (W3426); annual capacity planning; re-org
Frequency: Annual + on change
Volume: ~700 strategic accounts covered by the Trade/Account Management team (5, per §3.3) plus store/region trade leads, with KAPs limited to the top ~50–100 accounts
Owner: Head of Strategic Accounts
Participants: Head of Strategic Accounts, HR (links to VS-19), Head of Trade / Account Management, Executive Sponsors
Source: workflow W3428 — Account Team Structure, Assignment &amp; Executive Sponsorship</bpmn:documentation>
      <bpmn:laneSet id="W3428_LaneSet3">
        <bpmn:lane id="W3428_Lane1" name="Head of Strategic Accounts">
        <bpmn:flowNodeRef>W3428_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3428_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3428_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3428_Lane2" name="Sponsor">
        <bpmn:flowNodeRef>W3428_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3428_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3428_Start4" name="Account onboarding (W3426); annual capacity planning; re-org">
        <bpmn:outgoing>W3428_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3428_Task5" name="Head of Strategic Accounts design the account-team model: dedicated vs shared…">
        <bpmn:documentation>Step 1: Head of Strategic Accounts design the account-team model: dedicated vs shared account managers, specialist support (category links to VS-01, project links to VS-11.2/VS-66, credit links to VS-68, service links to VS-12), coverage ratios by tier, and the executive-sponsor mapping (C-suite/VP sponsors for top-tier); align to HR capacity (links to VS-19.3/VS-103.3)
Responsible (R): Head of Strategic Accounts / HR
Accountable (A): Head of Trade / Account Management / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3428_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3428_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3428_Task6" name="Head of Strategic Accounts assign account managers and sponsors to accounts…">
        <bpmn:documentation>Step 2: Head of Strategic Accounts assign account managers and sponsors to accounts (matching skills/relationships), document in CRM (links to VS-13.3) and HR systems (links to W292 employee master), and communicate assignments to teams and customers; resolve capacity gaps via hiring/reallocation (links to VS-19.1)
Responsible (R): Head of Strategic Accounts / HR
Accountable (A): Head of Trade / Account Management
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W3428_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3428_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3428_Task7" name="Executive Sponsors accept their accounts, engage on…">
        <bpmn:documentation>Step 3: Executive Sponsors accept their accounts, engage on introduction/relationship-building (W3429), and commit to the cadence (W3430); Head of Strategic Accounts monitor coverage health and rebalance as needed
Responsible (R): Sponsor / Head of Strategic Accounts
Accountable (A): COO
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W3428_Flow13</bpmn:incoming>
        <bpmn:outgoing>W3428_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W3428_End8" name="Complete">
        <bpmn:incoming>W3428_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3428_Annotation9">
        <bpmn:text>Controls: - CTL-550 (ensure controlled execution — Strategic Account Selection, Planning &amp; Relationship Governance (PA-107.1).) | - operational: capacity planning and tier-based coverage; operational: clear expectations and leadership accountability
Owner: Head of Strategic Accounts</bpmn:text>
      </bpmn:textAnnotation>
