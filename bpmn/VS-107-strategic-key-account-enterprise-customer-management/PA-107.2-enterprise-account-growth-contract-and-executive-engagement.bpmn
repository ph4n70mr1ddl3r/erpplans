      <bpmn:sequenceFlow id="W3440_Flow13" sourceRef="W3440_Task6" targetRef="W3440_Task7" />
      <bpmn:sequenceFlow id="W3440_Flow14" sourceRef="W3440_Task7" targetRef="W3440_End8" />
    </bpmn:process>
