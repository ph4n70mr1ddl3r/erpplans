<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-107.2-enterprise-account-growth-contract-and-executive-engagement" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3433" name="W3433. Share-of-Wallet, Opportunity &amp; White-Space Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: KAP development (W3427); annual/quarterly account review
Frequency: Quarterly
Volume: ~700 strategic accounts; focus on top tiers
Owner: Account Manager
Participants: Account Manager, Finance (links to VS-17.4), Market Intelligence (links to VS-44/VS-57/VS-33.3), Category (links to VS-01)
Source: workflow W3433 — Share-of-Wallet, Opportunity &amp; White-Space Analysis</bpmn:documentation>
      <bpmn:laneSet id="W3433_LaneSet2">
        <bpmn:lane id="W3433_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3433_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3433_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3433_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3433_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3433_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3433_Start3" name="KAP development (W3427); annual/quarterly account review">
        <bpmn:outgoing>W3433_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3433_Task4" name="Account Manager/Finance estimate the customer&#x27;s total addressable spend in…">
        <bpmn:documentation>Step 1: Account Manager/Finance estimate the customer&#x27;s total addressable spend in BuildRight&#x27;s categories (construction/renovation/operations) from project scale (links to VS-11.2/VS-66), industry benchmarks, and market intelligence (links to VS-44/VS-33.3); compute current share-of-wallet from actuals (links to VS-17.4/VS-13.3)
Responsible (R): Account Manager / Finance / MI
Accountable (A): Head of Strategic Accounts
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3433_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3433_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3433_Task5" name="Account Manager/Category identify white-space: categories/products not…">
        <bpmn:documentation>Step 2: Account Manager/Category identify white-space: categories/products not currently bought, project phases not served, geographies/sites not covered, and competitor-served spend; quantify the opportunity ($, GM$, strategic value) and prioritize
Responsible (R): Account Manager / Category
Accountable (A): Head of Strategic Accounts
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3433_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3433_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3433_Task6" name="Account Manager integrate the share-of-wallet and white-space opportunity into…">
        <bpmn:documentation>Step 3: Account Manager integrate the share-of-wallet and white-space opportunity into the KAP growth thesis (W3427), build the pursuit plan (links to W3436), and track share-growth over time; report to the QBR (W3430)
Responsible (R): Account Manager
Accountable (A): Head of Strategic Accounts
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3433_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3433_End7" name="Complete">
        <bpmn:incoming>W3433_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3433_Annotation8">
        <bpmn:text>Controls: - CTL-551 (ensure controlled execution — Enterprise Account Growth, Contract &amp; Executive Engagement (PA-107.2).) | - operational: triangulation and customer JBP; operational: pursuit plan and QBR tracking
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3433_Assoc9" sourceRef="W3433_Annotation8" targetRef="W3433_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W3433_Flow10" sourceRef="W3433_Start3" targetRef="W3433_Task4" />
      <bpmn:sequenceFlow id="W3433_Flow11" sourceRef="W3433_Task4" targetRef="W3433_Task5" />
      <bpmn:sequenceFlow id="W3433_Flow12" sourceRef="W3433_Task5" targetRef="W3433_Task6" />
      <bpmn:sequenceFlow id="W3433_Flow13" sourceRef="W3433_Task6" targetRef="W3433_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3433_diag">
      <bpmndi:BPMNPlane id="W3433_plane" bpmnElement="W_W3433">
        <bpmndi:BPMNShape id="W3433_Lane1_di" bpmnElement="W3433_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3433_Task4_di" bpmnElement="W3433_Task4"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
