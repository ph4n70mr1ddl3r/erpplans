        <bpmndi:BPMNEdge id="W3433_Assoc9_di" bpmnElement="W3433_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3434" name="W3434. Enterprise Pricing, Contract &amp; Trading-Terms Negotiation" isExecutable="false">
      <bpmn:documentation>Trigger: KAP/JBP (W3427); contract renewal; new large opportunity
Frequency: Per contract + periodic
Volume: ~200 enterprise contracts
Owner: Account Manager
Participants: Account Manager, Pricing (links to VS-01.2/VS-57), Legal (links to VS-100.3), Finance (links to VS-101.3/VS-68), Customer procurement
Source: workflow W3434 — Enterprise Pricing, Contract &amp; Trading-Terms Negotiation</bpmn:documentation>
      <bpmn:laneSet id="W3434_LaneSet3">
        <bpmn:lane id="W3434_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3434_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3434_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3434_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3434_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3434_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3434_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3434_Start4" name="KAP/JBP (W3427); contract renewal; new large opportunity">
        <bpmn:outgoing>W3434_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3434_Task5" name="Account Manager/Finance build the enterprise pricing/contract proposal…">
        <bpmn:documentation>Step 1: Account Manager/Finance build the enterprise pricing/contract proposal: volume/mix assumptions, tiered/rebate structure (links to VS-39), price relative to SRP/trade (links to VS-01.2/VS-11), margin impact (links to VS-101.3 W3286), credit terms (links to VS-16.1/VS-68), SLAs, and duration; align to authority matrix (links to VS-36)
Responsible (R): Account Manager / Pricing / Finance
Accountable (A): Head of Strategic Accounts
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3434_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3434_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3434_Task6" name="Account Manager/Legal negotiate trading terms with customer procurement…">
        <bpmn:documentation>Step 2: Account Manager/Legal negotiate trading terms with customer procurement: price/discount/rebate, volume commitment/take-or-pay, payment terms, exclusivity/preferred-supplier, SLA/penalty, termination, and risk allocation; execute the master agreement and price book (links to VS-100.3/W230/W402)
Responsible (R): Account Manager / Legal
Accountable (A): Head of Trade / Account Management / CFO
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3434_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3434_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3434_Task7" name="Finance/Master Data load the enterprise price book/contract into the ERP (links…">
        <bpmn:documentation>Step 3: Finance/Master Data load the enterprise price book/contract into the ERP (links to W289 pricing master, W402 contract master, VS-11.1/VS-163 project price books), validate application to orders (links to VS-11.2/VS-08), and monitor contract compliance and margin realization (W3441)
Responsible (R): Finance / Master Data / Sales Ops
Accountable (A): Finance Controller
Duration: Per contract</bpmn:documentation>
        <bpmn:incoming>W3434_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3434_End8" name="Complete">
        <bpmn:incoming>W3434_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3434_Annotation9">
        <bpmn:text>Controls: - CTL-551 (ensure controlled execution — Enterprise Account Growth, Contract &amp; Executive Engagement (PA-107.2).) | - operational: margin modeling and authority limits; operational: price-book loading and compliance monitoring
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3434_Assoc10" sourceRef="W3434_Annotation9" targetRef="W3434_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3434_Flow11" sourceRef="W3434_Start4" targetRef="W3434_Task5" />
      <bpmn:sequenceFlow id="W3434_Flow12" sourceRef="W3434_Task5" targetRef="W3434_Task6" />
      <bpmn:sequenceFlow id="W3434_Flow13" sourceRef="W3434_Task6" targetRef="W3434_Task7" />
      <bpmn:sequenceFlow id="W3434_Flow14" sourceRef="W3434_Task7" targetRef="W3434_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3434_diag">
      <bpmndi:BPMNPlane id="W3434_plane" bpmnElement="W_W3434">
        <bpmndi:BPMNShape id="W3434_Lane1_di" bpmnElement="W3434_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3434_Lane2_di" bpmnElement="W3434_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3434_Task5_di" bpmnElement="W3434_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
