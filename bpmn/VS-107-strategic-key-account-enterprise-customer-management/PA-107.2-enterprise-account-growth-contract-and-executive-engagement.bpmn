        <bpmndi:BPMNShape id="W3434_Task7_di" bpmnElement="W3434_Task7"><dc:Bounds x="820" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3434_Start4_di" bpmnElement="W3434_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3434_End8_di" bpmnElement="W3434_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3434_Annotation9_di" bpmnElement="W3434_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3434_Flow11_di" bpmnElement="W3434_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3434_Flow12_di" bpmnElement="W3434_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3434_Flow13_di" bpmnElement="W3434_Flow13"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3434_Flow14_di" bpmnElement="W3434_Flow14"><di:waypoint x="1000" y="335" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3434_Assoc10_di" bpmnElement="W3434_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3435" name="W3435. Solutioning &amp; Value-Proposition Development for Strategic Accounts" isExecutable="false">
      <bpmn:documentation>Trigger: White-space opportunity (W3433); complex customer need; RFP
Frequency: Opportunity-driven
Volume: Top opportunities
Owner: Account Manager
Participants: Account Manager, Category/Specialist (links to VS-01/VS-66/VS-70/VS-78), Design Services (links to VS-66), Installation (links to VS-12), Finance
Source: workflow W3435 — Solutioning &amp; Value-Proposition Development for Strategic Accounts</bpmn:documentation>
      <bpmn:laneSet id="W3435_LaneSet3">
        <bpmn:lane id="W3435_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3435_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3435_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3435_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3435_Lane2" name="Specialist">
        <bpmn:flowNodeRef>W3435_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3435_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3435_Start4" name="White-space opportunity (W3433); complex customer need; RFP">
        <bpmn:outgoing>W3435_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3435_Task5" name="Account Manager/Specialist diagnose the customer&#x27;s need/outcome (e.g., a…">
        <bpmn:documentation>Step 1: Account Manager/Specialist diagnose the customer&#x27;s need/outcome (e.g., a developer&#x27;s multi-tower fit-out, a hospital&#x27;s solar+generator system, a factory&#x27;s MRO supply): pain points, success criteria, decision process, and Total Cost of Ownership; document the solutioning brief
Responsible (R): Account Manager / Specialist
Accountable (A): Head of Strategic Accounts
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W3435_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3435_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3435_Task6" name="Specialist/Design build the value proposition and solution: product/category…">
        <bpmn:documentation>Step 2: Specialist/Design build the value proposition and solution: product/category mix (links to VS-01), services (links to VS-12 installation/VS-66 design/VS-70 solar/VS-78 green), logistics/staging (links to VS-77/VS-74), financing (links to VS-38/VS-96), and the quantified value (cost savings, single-source, schedule, warranty); package into a proposal
Responsible (R): Specialist / Design / Finance
Accountable (A): Head of Strategic Accounts
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W3435_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3435_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3435_Task7" name="Account Manager present the solution, refine based on feedback, and convert to…">
        <bpmn:documentation>Step 3: Account Manager present the solution, refine based on feedback, and convert to a contract (W3434) and project/order (links to VS-11.2/VS-66/VS-46); capture the solution IP for reuse and feed customer insight to innovation (W3440)
Responsible (R): Account Manager / Specialist
Accountable (A): Head of Strategic Accounts
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W3435_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3435_End8" name="Complete">
        <bpmn:incoming>W3435_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3435_Annotation9">
        <bpmn:text>Controls: - CTL-551 (ensure controlled execution — Enterprise Account Growth, Contract &amp; Executive Engagement (PA-107.2).) | - operational: diagnosis and refinement; operational: TCO/margin modeling
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3435_Assoc10" sourceRef="W3435_Annotation9" targetRef="W3435_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3435_Flow11" sourceRef="W3435_Start4" targetRef="W3435_Task5" />
      <bpmn:sequenceFlow id="W3435_Flow12" sourceRef="W3435_Task5" targetRef="W3435_Task6" />
      <bpmn:sequenceFlow id="W3435_Flow13" sourceRef="W3435_Task6" targetRef="W3435_Task7" />
      <bpmn:sequenceFlow id="W3435_Flow14" sourceRef="W3435_Task7" targetRef="W3435_End8" />
    </bpmn:process>
