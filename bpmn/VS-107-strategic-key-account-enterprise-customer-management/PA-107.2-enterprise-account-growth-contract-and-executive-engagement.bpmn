      <bpmndi:BPMNPlane id="W3435_plane" bpmnElement="W_W3435">
        <bpmndi:BPMNShape id="W3435_Lane1_di" bpmnElement="W3435_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Lane2_di" bpmnElement="W3435_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Task5_di" bpmnElement="W3435_Task5"><dc:Bounds x="400" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Task6_di" bpmnElement="W3435_Task6"><dc:Bounds x="610" y="295" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Task7_di" bpmnElement="W3435_Task7"><dc:Bounds x="820" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Start4_di" bpmnElement="W3435_Start4"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_End8_di" bpmnElement="W3435_End8"><dc:Bounds x="1050" y="317" width="36" height="36" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3435_Annotation9_di" bpmnElement="W3435_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3435_Flow11_di" bpmnElement="W3435_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3435_Flow12_di" bpmnElement="W3435_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3435_Flow13_di" bpmnElement="W3435_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3435_Flow14_di" bpmnElement="W3435_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3435_Assoc10_di" bpmnElement="W3435_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3436" name="W3436. Strategic Project Pursuit, Bid Strategy &amp; Win-Plan" isExecutable="false">
      <bpmn:documentation>Trigger: Large opportunity/RFP; government bid (links to VS-46)
Frequency: Opportunity-driven
Volume: Top pursuits/year
Owner: Account Manager
Participants: Account Manager, Bid/Proposal (links to VS-11.2 W162/W166), Pricing, Finance, Legal, Executive Sponsor
Source: workflow W3436 — Strategic Project Pursuit, Bid Strategy &amp; Win-Plan</bpmn:documentation>
      <bpmn:laneSet id="W3436_LaneSet3">
        <bpmn:lane id="W3436_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3436_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3436_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3436_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3436_Lane2" name="Sponsor">
        <bpmn:flowNodeRef>W3436_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3436_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3436_Start4" name="Large opportunity/RFP; government bid (links to VS-46)">
        <bpmn:outgoing>W3436_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3436_Task5" name="Account Manager qualify the pursuit: fit/strategic value, win-probability…">
        <bpmn:documentation>Step 1: Account Manager qualify the pursuit: fit/strategic value, win-probability, profitability, competition, resource/capacity, and risk (links to VS-21.2); make a bid/no-bid recommendation to the deal-review (links to VS-33.2)
Responsible (R): Account Manager / Finance
Accountable (A): Head of Strategic Accounts
Duration: Per pursuit</bpmn:documentation>
        <bpmn:incoming>W3436_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3436_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3436_Task6" name="Account Manager/Bid build the win-plan and bid: competitive positioning (links…">
        <bpmn:documentation>Step 2: Account Manager/Bid build the win-plan and bid: competitive positioning (links to VS-57/VS-33.3), pricing (links to W3434/VS-01.2), solution (W3435), project plan (links to VS-11.2/VS-77), risk mitigation, and stakeholder strategy (W3429); prepare the proposal/quotation (links to VS-11.2 W162) or government bid (links to VS-46)
Responsible (R): Account Manager / Bid / Specialist
Accountable (A): Head of Trade / Account Management
Duration: Per pursuit</bpmn:documentation>
        <bpmn:incoming>W3436_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3436_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3436_Task7" name="Executive Sponsor/Account Manager engage customer decision-makers through the…">
        <bpmn:documentation>Step 3: Executive Sponsor/Account Manager engage customer decision-makers through the evaluation, address objections, negotiate (links to W3434), and win (or capture loss lessons); transition the won deal to project execution (links to VS-11.2/VS-66/VS-77) and update the KAP (W3427)
Responsible (R): Sponsor / Account Manager
Accountable (A): Head of Trade / Account Management / COO
Duration: Per pursuit</bpmn:documentation>
        <bpmn:incoming>W3436_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3436_End8" name="Complete">
        <bpmn:incoming>W3436_Flow14</bpmn:incoming>
      </bpmn:endEvent>
