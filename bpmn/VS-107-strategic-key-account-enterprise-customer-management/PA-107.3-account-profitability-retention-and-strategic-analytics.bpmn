    <bpmn:process id="W_W3442" name="W3442. Strategic Account Revenue Forecasting &amp; Pipeline Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly forecast (links to VS-33.2/VS-101); pipeline review
Frequency: Monthly + weekly pipeline
Volume: ~700 accounts; full pipeline
Owner: Account Manager
Participants: Account Manager, Sales Ops, FP&amp;A (links to VS-17.4), Merchandising Finance, CRM (links to VS-13.3)
Source: workflow W3442 — Strategic Account Revenue Forecasting &amp; Pipeline Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3442_LaneSet3">
        <bpmn:lane id="W3442_Lane1" name="Account Manager">
        <bpmn:flowNodeRef>W3442_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3442_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3442_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3442_Lane2" name="Sales Ops">
        <bpmn:flowNodeRef>W3442_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3442_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3442_Start4" name="Monthly/quarterly forecast (links to VS-33.2/VS-101); pipeline review">
        <bpmn:outgoing>W3442_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3442_Task5" name="Account Manager maintain the account pipeline and forecast in CRM (links to…">
        <bpmn:documentation>Step 1: Account Manager maintain the account pipeline and forecast in CRM (links to VS-13.3/W103): qualified opportunities (links to W3433/W3436), stage, probability, value, close-date, and risk; refresh weekly; reconcile to project pipeline (links to VS-11.2/VS-66)
Responsible (R): Account Manager / Sales Ops
Accountable (A): Head of Strategic Accounts
Duration: Weekly</bpmn:documentation>
        <bpmn:incoming>W3442_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3442_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3442_Task6" name="Sales Ops/FP&amp;A aggregate the strategic-account pipeline/forecast, validate…">
        <bpmn:documentation>Step 2: Sales Ops/FP&amp;A aggregate the strategic-account pipeline/forecast, validate against the revenue/margin plan (links to VS-33.1/VS-101.3) and historical accuracy, and identify gaps/concentration/risk; produce the forecast view for executives
Responsible (R): Sales Ops / FP&amp;A
Accountable (A): Head of Strategic Accounts
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3442_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3442_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3442_Task7" name="Account Manager/Head of Strategic Accounts act on forecast risk: accelerate…">
        <bpmn:documentation>Step 3: Account Manager/Head of Strategic Accounts act on forecast risk: accelerate at-risk deals (links to W3436), backfill pipeline gaps, and align supply/logistics capacity to forecast (links to VS-02/VS-06/VS-77); report forecast performance to the executive review (links to VS-33.2)
Responsible (R): Account Manager / Sales Ops
Accountable (A): Head of Trade / Account Management / COO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3442_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3442_End8" name="Complete">
        <bpmn:incoming>W3442_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3442_Annotation9">
        <bpmn:text>Controls: - CTL-552 (ensure controlled execution — Account Profitability, Retention &amp; Strategic Analytics (PA-107.3).) | - operational: stage discipline and accuracy tracking; operational: pipeline diversification
Owner: Account Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3442_Assoc10" sourceRef="W3442_Annotation9" targetRef="W3442_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3442_Flow11" sourceRef="W3442_Start4" targetRef="W3442_Task5" />
      <bpmn:sequenceFlow id="W3442_Flow12" sourceRef="W3442_Task5" targetRef="W3442_Task6" />
      <bpmn:sequenceFlow id="W3442_Flow13" sourceRef="W3442_Task6" targetRef="W3442_Task7" />
      <bpmn:sequenceFlow id="W3442_Flow14" sourceRef="W3442_Task7" targetRef="W3442_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3442_diag">
      <bpmndi:BPMNPlane id="W3442_plane" bpmnElement="W_W3442">
        <bpmndi:BPMNShape id="W3442_Lane1_di" bpmnElement="W3442_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W3442_Lane2_di" bpmnElement="W3442_Lane2" isHorizontal="true"><dc:Bounds x="160" y="250" width="950" height="170" /></bpmndi:BPMNShape>
