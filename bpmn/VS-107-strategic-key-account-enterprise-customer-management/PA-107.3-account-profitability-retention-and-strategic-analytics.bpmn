        <bpmndi:BPMNShape id="W3442_Annotation9_di" bpmnElement="W3442_Annotation9"><dc:Bounds x="160" y="460" width="360" height="72" /></bpmndi:BPMNShape>
        <bpmndi:BPMNEdge id="W3442_Flow11_di" bpmnElement="W3442_Flow11"><di:waypoint x="326" y="165" /><di:waypoint x="400" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3442_Flow12_di" bpmnElement="W3442_Flow12"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3442_Flow13_di" bpmnElement="W3442_Flow13"><di:waypoint x="790" y="335" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3442_Flow14_di" bpmnElement="W3442_Flow14"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3442_Assoc10_di" bpmnElement="W3442_Assoc10"><di:waypoint x="340" y="460" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3443" name="W3443. Account Performance Scorecard &amp; Tier Health Assessment" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly/quarterly review; re-tier (W3425)
Frequency: Monthly + quarterly
Volume: ~700 strategic accounts
Owner: Head of Strategic Accounts
Participants: Head of Strategic Accounts, Account Managers, Finance (links to VS-17.4), CRM/BI (links to VS-28.1)
Source: workflow W3443 — Account Performance Scorecard &amp; Tier Health Assessment</bpmn:documentation>
      <bpmn:laneSet id="W3443_LaneSet2">
        <bpmn:lane id="W3443_Lane1" name="Head of Strategic Accounts">
        <bpmn:flowNodeRef>W3443_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3443_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3443_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3443_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3443_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3443_Start3" name="Monthly/quarterly review; re-tier (W3425)">
        <bpmn:outgoing>W3443_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3443_Task4" name="Head of Strategic Accounts/BI publish the account scorecard per account/tier…">
        <bpmn:documentation>Step 1: Head of Strategic Accounts/BI publish the account scorecard per account/tier: revenue/GM$ vs KAP target (W3427), share-of-wallet (W3433), profitability (W3441), pipeline coverage (W3442), service-level/CSAT (links to VS-13.1/W65), credit/AR health (links to VS-68/VS-16), and at-risk signals (W3446); monthly
Responsible (R): Head of Strategic Accounts / BI
Accountable (A): Head of Trade / Account Management
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3443_Flow10</bpmn:incoming>
        <bpmn:outgoing>W3443_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3443_Task5" name="Head of Strategic Accounts assess tier health: accounts over-/under-performing…">
        <bpmn:documentation>Step 2: Head of Strategic Accounts assess tier health: accounts over-/under-performing tier expectations, tier-misalignment candidates (W3425), and resource-allocation adequacy (W3428); recommend re-tier, resource, or intervention
Responsible (R): Head of Strategic Accounts
Accountable (A): Head of Trade / Account Management / COO
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3443_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3443_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3443_Task6" name="Head of Strategic Accounts conduct the portfolio review with Account Managers…">
        <bpmn:documentation>Step 3: Head of Strategic Accounts conduct the portfolio review with Account Managers: per-account health, action plans, escalations, and resource decisions; track action closure and report portfolio health to executives (links to VS-33.2)
Responsible (R): Head of Strategic Accounts
Accountable (A): Head of Trade / Account Management
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3443_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3443_End7" name="Complete">
        <bpmn:incoming>W3443_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3443_Annotation8">
        <bpmn:text>Controls: - CTL-552 (ensure controlled execution — Account Profitability, Retention &amp; Strategic Analytics (PA-107.3).) | - operational: focused tier-relevant KPIs; operational: balanced scorecard and net-profitability view (W3441)
Owner: Head of Strategic Accounts</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3443_Assoc9" sourceRef="W3443_Annotation8" targetRef="W3443_Start3" associationDirection="None" />
