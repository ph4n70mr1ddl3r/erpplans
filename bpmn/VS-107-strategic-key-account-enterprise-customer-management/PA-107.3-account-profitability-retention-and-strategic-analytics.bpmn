<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PA-107.3-account-profitability-retention-and-strategic-analytics" targetNamespace="https://erpplans.local/bpmn" exporter="erpplans generate-bpmn.py" exporterVersion="1.0">
    <bpmn:process id="W_W3441" name="W3441. Account-Level Profitability, Cost-to-Serve &amp; Margin Analytics" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly close (links to VS-17.1); KAP/QBR (W3427/W3430)
Frequency: Monthly + quarterly
Volume: ~700 strategic accounts
Owner: Merchandising Finance
Participants: Merchandising Finance, Account Managers, FP&amp;A (links to VS-17.4), Logistics Finance (links to W277), BI (links to VS-28.1)
Source: workflow W3441 — Account-Level Profitability, Cost-to-Serve &amp; Margin Analytics</bpmn:documentation>
      <bpmn:laneSet id="W3441_LaneSet3">
        <bpmn:lane id="W3441_Lane1" name="Merchandising Finance">
        <bpmn:flowNodeRef>W3441_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3441_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3441_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3441_Lane2" name="Account Manager">
        <bpmn:flowNodeRef>W3441_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3441_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3441_Start4" name="Monthly close (links to VS-17.1); KAP/QBR (W3427/W3430)">
        <bpmn:outgoing>W3441_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3441_Task5" name="Merchandising Finance/BI compute account-level profitability: revenue, GM$ and…">
        <bpmn:documentation>Step 1: Merchandising Finance/BI compute account-level profitability: revenue, GM$ and GM% (net of discounts/rebates links to VS-39/VS-11.1, landed cost links to VS-02.2/VS-87), cost-to-serve (logistics links to VS-06/VS-74/VS-77 staging, special handling, account-team cost, financing/credit cost links to VS-68), returns (links to VS-32), and net contribution; allocate shared costs fairly
Responsible (R): Merchandising Finance / BI
Accountable (A): Head of Strategic Accounts
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3441_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3441_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3441_Task6" name="Merchandising Finance/Account Manager analyze profitability drivers…">
        <bpmn:documentation>Step 2: Merchandising Finance/Account Manager analyze profitability drivers: product/category mix (links to VS-01/VS-101.3), pricing-vs-tier (links to W3434/VS-01.2), service mix, project margin (links to VS-11.2/VS-40), and cost-to-serve hotspots; flag unprofitable accounts for action
Responsible (R): Merchandising Finance / Account Manager
Accountable (A): Head of Strategic Accounts
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3441_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3441_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3441_Task7" name="Account Manager use profitability analytics to inform pricing/contract renewal…">
        <bpmn:documentation>Step 3: Account Manager use profitability analytics to inform pricing/contract renewal (W3434), mix-shift, service redesign, and tier reassignment (W3425); report profitability to the QBR (W3430) and finance review (links to VS-17.4/VS-101.3)
Responsible (R): Account Manager / Merchandising Finance
Accountable (A): Head of Strategic Accounts
Duration: Quarterly</bpmn:documentation>
        <bpmn:incoming>W3441_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3441_End8" name="Complete">
        <bpmn:incoming>W3441_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3441_Annotation9">
        <bpmn:text>Controls: - CTL-552 (ensure controlled execution — Account Profitability, Retention &amp; Strategic Analytics (PA-107.3).) | - operational: driver-based allocation; operational: net-profitability view
Owner: Merchandising Finance</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W3441_Assoc10" sourceRef="W3441_Annotation9" targetRef="W3441_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W3441_Flow11" sourceRef="W3441_Start4" targetRef="W3441_Task5" />
      <bpmn:sequenceFlow id="W3441_Flow12" sourceRef="W3441_Task5" targetRef="W3441_Task6" />
      <bpmn:sequenceFlow id="W3441_Flow13" sourceRef="W3441_Task6" targetRef="W3441_Task7" />
      <bpmn:sequenceFlow id="W3441_Flow14" sourceRef="W3441_Task7" targetRef="W3441_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W3441_diag">
      <bpmndi:BPMNPlane id="W3441_plane" bpmnElement="W_W3441">
        <bpmndi:BPMNShape id="W3441_Lane1_di" bpmnElement="W3441_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
