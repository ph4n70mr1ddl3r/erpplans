      <bpmn:sequenceFlow id="W3443_Flow11" sourceRef="W3443_Task4" targetRef="W3443_Task5" />
      <bpmn:sequenceFlow id="W3443_Flow12" sourceRef="W3443_Task5" targetRef="W3443_Task6" />
      <bpmn:sequenceFlow id="W3443_Flow13" sourceRef="W3443_Task6" targetRef="W3443_End7" />
    </bpmn:process>
