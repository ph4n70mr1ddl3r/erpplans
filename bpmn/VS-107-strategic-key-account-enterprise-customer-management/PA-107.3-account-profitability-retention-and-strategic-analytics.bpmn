        <bpmndi:BPMNEdge id="W3443_Flow11_di" bpmnElement="W3443_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3443_Flow12_di" bpmnElement="W3443_Flow12"><di:waypoint x="790" y="165" /><di:waypoint x="820" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3443_Flow13_di" bpmnElement="W3443_Flow13"><di:waypoint x="1000" y="165" /><di:waypoint x="1050" y="165" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W3443_Assoc9_di" bpmnElement="W3443_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W3444" name="W3444. Strategic Account Credit, Concentration &amp; Receivable Risk Management" isExecutable="false">
      <bpmn:documentation>Trigger: Account credit decision (links to VS-68); portfolio concentration review
Frequency: Per account + monthly portfolio
Volume: ~5,200 AR accounts; ~200 corporate strategic (links to VS-16.3)
Owner: AR/Credit Manager
Participants: AR/Credit Manager (links to VS-16/VS-68), Account Manager, Finance (links to VS-17), Treasury (links to VS-18/VS-105)
Source: workflow W3444 — Strategic Account Credit, Concentration &amp; Receivable Risk Management</bpmn:documentation>
      <bpmn:laneSet id="W3444_LaneSet3">
        <bpmn:lane id="W3444_Lane1" name="AR">
        <bpmn:flowNodeRef>W3444_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3444_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3444_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W3444_Lane2" name="Finance">
        <bpmn:flowNodeRef>W3444_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W3444_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W3444_Start4" name="Account credit decision (links to VS-68); portfolio concentration review">
        <bpmn:outgoing>W3444_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W3444_Task5" name="AR/Credit assess strategic-account credit (links to VS-68.1 risk scoring…">
        <bpmn:documentation>Step 1: AR/Credit assess strategic-account credit (links to VS-68.1 risk scoring, VS-16.1 credit application): financial health, payment history, project/contract exposure, industry risk, and collateral/guarantees; set/approve credit limit per authority (links to VS-68.2)
Responsible (R): AR/Credit Manager
Accountable (A): CFO (per authority)
Duration: Per account</bpmn:documentation>
        <bpmn:incoming>W3444_Flow11</bpmn:incoming>
        <bpmn:outgoing>W3444_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3444_Task6" name="Finance/Treasury monitor concentration risk: top-account exposure vs portfolio…">
        <bpmn:documentation>Step 2: Finance/Treasury monitor concentration risk: top-account exposure vs portfolio limits, segment/entity concentration (links to VS-72), and single-name exposure; alert on threshold breach and recommend mitigation (credit reduction, insurance links to VS-26, factoring/SCF links to VS-105)
Responsible (R): Finance / Treasury
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3444_Flow12</bpmn:incoming>
        <bpmn:outgoing>W3444_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W3444_Task7" name="AR/Credit/Account Manager manage receivable risk on strategic accounts…">
        <bpmn:documentation>Step 3: AR/Credit/Account Manager manage receivable risk on strategic accounts: collection (links to VS-16.2 W108), dispute resolution (links to VS-90/W244), credit-hold coordination with sales (links to W3431), and bad-debt provisioning (links to VS-68.3/W81); report credit risk to the portfolio review (W3443)
Responsible (R): AR/Credit / Account Manager
Accountable (A): CFO
Duration: Monthly</bpmn:documentation>
        <bpmn:incoming>W3444_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W3444_End8" name="Complete">
        <bpmn:incoming>W3444_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W3444_Annotation9">
        <bpmn:text>Controls: - CTL-87 (ensure key-account credit concentration &amp; ethics governance.) | - operational: limits and diversification; operational: authority matrix and coordination (W3431)
Owner: AR/Credit Manager</bpmn:text>
      </bpmn:textAnnotation>
