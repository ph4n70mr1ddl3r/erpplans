    <bpmn:process id="W_W4062" name="W4062. Process Automation &amp; Digitization Opportunity Scoping" isExecutable="false">
      <bpmn:documentation>Trigger: Mining/analysis identifies manual/repetitive work; automation candidate
Frequency: Per opportunity + periodic portfolio review
Volume: Enterprise automation pipeline (RPA, IDP, workflow, integration)
Owner: OpEx Process Lead / Automation CoE (links to VS-30.2)
Participants: OpEx CoE, Automation CoE (VS-30.2), Enterprise Architecture (VS-113), IT (VS-27), Finance (VS-17.4)
Source: workflow W4062 — Process Automation &amp; Digitization Opportunity Scoping</bpmn:documentation>
      <bpmn:laneSet id="W4062_LaneSet2">
        <bpmn:lane id="W4062_Lane1" name="OpEx">
        <bpmn:flowNodeRef>W4062_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4062_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4062_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4062_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4062_End7</bpmn:flowNodeRef>
