        <bpmn:outgoing>W4062_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4062_Task4" name="OpEx scope the automation opportunity: the manual steps, volume/effort…">
        <bpmn:documentation>Step 1: OpEx scope the automation opportunity: the manual steps, volume/effort, variability, systems/data involved, and the candidate technology (RPA, IDP/OCR, workflow, API integration)
Responsible (R): OpEx / Automation CoE
Accountable (A): Process Owner
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4062_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4062_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4062_Task5" name="OpEx/Finance build the business case (effort saved, accuracy/revenue benefit…">
        <bpmn:documentation>Step 2: OpEx/Finance build the business case (effort saved, accuracy/revenue benefit, TCO links to VS-135, sustainability), and route build vs buy to innovation/EA (VS-30/VS-113)
Responsible (R): OpEx / Finance / EA
Accountable (A): COO / CIO
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4062_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4062_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4062_Task6" name="OpEx hand off approved automations to the build pipeline (VS-30.2 RPA lifecycle…">
        <bpmn:documentation>Step 3: OpEx hand off approved automations to the build pipeline (VS-30.2 RPA lifecycle / VS-113 integration), and track realized benefit (W4065)
Responsible (R): OpEx / Automation CoE
Accountable (A): COO
Duration: Per opportunity</bpmn:documentation>
        <bpmn:incoming>W4062_Flow12</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4062_End7" name="Complete">
        <bpmn:incoming>W4062_Flow13</bpmn:incoming>
      </bpmn:endEvent>
