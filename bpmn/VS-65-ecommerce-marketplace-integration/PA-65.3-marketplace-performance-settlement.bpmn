    <bpmn:process id="W_W2422" name="W2422. Marketplace Financial Reconciliation" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly settlement cycle
Frequency: Monthly; 1–2 platforms
Volume: ~1–2 reconciliations/month
Owner: Finance Analyst
Participants: Finance Analyst, Ecommerce Dir, Treasury
Source: workflow W2422 — Marketplace Financial Reconciliation</bpmn:documentation>
      <bpmn:laneSet id="W2422_LaneSet2">
        <bpmn:lane id="W2422_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2422_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2422_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2422_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2422_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2422_Start3" name="Monthly settlement cycle">
        <bpmn:outgoing>W2422_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2422_Task4" name="Analyst reconciles: marketplace settlement report vs. BuildRight order records…">
        <bpmn:documentation>Step 1: Analyst reconciles: marketplace settlement report vs. BuildRight order records; verifies: gross sales, marketplace commission, shipping fee deductions, promotional subsidies, refunds, net settlement
Responsible (R): Finance Analyst
Accountable (A): Finance Manager
Duration: 4–6 hours/month</bpmn:documentation>
        <bpmn:incoming>W2422_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2422_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2422_Task5" name="Disputes discrepancies with marketplace (missing orders, incorrect commissions…">
        <bpmn:documentation>Step 2: Disputes discrepancies with marketplace (missing orders, incorrect commissions, unauthorized refunds); resolves within marketplace dispute window (typically 30 days)
Responsible (R): Finance Analyst
Accountable (A): GM, Digital Commerce Inc.
Duration: 2–3 hours/month</bpmn:documentation>
        <bpmn:incoming>W2422_Flow10</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2422_End6" name="Complete">
        <bpmn:incoming>W2422_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2422_Annotation7">
        <bpmn:text>Controls: - CTL-426 (ensure controlled execution — Marketplace Performance &amp; Settlement (PA-65.3).) | - operational: Finance Analyst sign-off on the workflow output
Owner: Finance Analyst</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2422_Assoc8" sourceRef="W2422_Annotation7" targetRef="W2422_Start3" associationDirection="None" />
