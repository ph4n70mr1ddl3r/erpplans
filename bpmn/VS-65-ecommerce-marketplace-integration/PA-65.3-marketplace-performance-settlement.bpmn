      </bpmn:laneSet>
      <bpmn:startEvent id="W2427_Start3" name="Quarterly analysis cycle — Marketplace Customer Acquisition">
        <bpmn:outgoing>W2427_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2427_Task4" name="Analyzes: new customers acquired via marketplace, conversion to BuildRight…">
        <bpmn:documentation>Step 1: Analyzes: new customers acquired via marketplace, conversion to BuildRight loyalty program, repeat purchase on marketplace vs. migration to own site, lifetime value comparison
Responsible (R): CRM Manager
Accountable (A): VP Marketing
Duration: 2–3 days/quarter</bpmn:documentation>
        <bpmn:incoming>W2427_Flow8</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W2427_End5" name="Complete">
