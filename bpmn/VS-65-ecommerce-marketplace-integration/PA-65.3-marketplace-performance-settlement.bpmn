    <bpmn:process id="W_W2423" name="W2423. Marketplace Commission &amp; Fee Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly cost analysis
Frequency: Monthly; 1–2 platforms
Volume: ~1–2 analyses/month
Owner: Finance Analyst
Participants: Finance Analyst, Ecommerce Dir, VP Marketing
Source: workflow W2423 — Marketplace Commission &amp; Fee Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2423_LaneSet2">
        <bpmn:lane id="W2423_Lane1" name="Finance Analyst">
        <bpmn:flowNodeRef>W2423_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2423_Start3</bpmn:flowNodeRef>
