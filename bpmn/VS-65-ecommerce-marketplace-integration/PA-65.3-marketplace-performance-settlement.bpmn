    <bpmn:process id="W_W2427" name="W2427. Marketplace Customer Acquisition Analysis" isExecutable="false">
      <bpmn:documentation>Trigger: Quarterly analysis cycle — Marketplace Customer Acquisition
Frequency: Quarterly
Volume: Marketplace customer base
Owner: CRM Manager
Participants: CRM Mgr, Analytics Manager, Ecommerce Dir
Source: workflow W2427 — Marketplace Customer Acquisition Analysis</bpmn:documentation>
      <bpmn:laneSet id="W2427_LaneSet2">
        <bpmn:lane id="W2427_Lane1" name="CRM Manager">
        <bpmn:flowNodeRef>W2427_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2427_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2427_End5</bpmn:flowNodeRef>
