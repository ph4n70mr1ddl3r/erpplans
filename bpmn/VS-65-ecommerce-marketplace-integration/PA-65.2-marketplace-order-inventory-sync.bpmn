    <bpmn:process id="W_W2419" name="W2419. Marketplace Listing Quality Management" isExecutable="false">
      <bpmn:documentation>Trigger: Monthly listing audit
Frequency: Monthly; ~5,000–10,000 listings per platform
Volume: ~5K–10K listings
Owner: Ecommerce Catalog Manager
Participants: Catalog Mgr, Digital Marketing, Analytics Manager
Source: workflow W2419 — Marketplace Listing Quality Management</bpmn:documentation>
      <bpmn:laneSet id="W2419_LaneSet2">
        <bpmn:lane id="W2419_Lane1" name="Catalog Manager">
        <bpmn:flowNodeRef>W2419_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2419_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2419_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2419_Start3" name="Monthly listing audit">
        <bpmn:outgoing>W2419_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2419_Task4" name="Catalog Manager audits listings: image quality, title optimization, description…">
