    <bpmn:process id="W_W2417" name="W2417. Marketplace Return &amp; Refund Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Marketplace return initiated by customer
Frequency: ~5–8% return rate; ~300–800 returns/month
Volume: ~300–800/month
Owner: Customer Service Agent
Participants: CSA, Returns Mgr, Marketplace Portal
Source: workflow W2417 — Marketplace Return &amp; Refund Processing</bpmn:documentation>
      <bpmn:laneSet id="W2417_LaneSet2">
        <bpmn:lane id="W2417_Lane1" name="CSA">
        <bpmn:flowNodeRef>W2417_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2417_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2417_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2417_Start3" name="Marketplace return initiated by customer">
        <bpmn:outgoing>W2417_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2417_Task4" name="Customer initiates return via marketplace; system receives return notification…">
        <bpmn:documentation>Step 1: Customer initiates return via marketplace; system receives return notification; CSA reviews and approves/contests; customer ships item back; system processes refund upon receipt
Responsible (R): CSA / System
Accountable (A): Returns Manager
Duration: 5–10 min + 3–7 days</bpmn:documentation>
        <bpmn:incoming>W2417_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2417_End5" name="Complete">
        <bpmn:incoming>W2417_Flow9</bpmn:incoming>
      </bpmn:endEvent>
