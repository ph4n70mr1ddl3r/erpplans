    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2415" name="W2415. Marketplace Inventory Synchronization" isExecutable="false">
      <bpmn:documentation>Trigger: Real-time inventory sync
Frequency: Continuous; every 15 minutes
Volume: ~35,000 SKUs × 1–2 platforms
Owner: IT Integration Lead
Participants: IT Integration, Inventory Mgr, Ecommerce Ops
Source: workflow W2415 — Marketplace Inventory Synchronization</bpmn:documentation>
      <bpmn:laneSet id="W2415_LaneSet2">
        <bpmn:lane id="W2415_Lane1" name="System">
        <bpmn:flowNodeRef>W2415_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2415_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2415_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2415_Start3" name="Real-time inventory sync">
        <bpmn:outgoing>W2415_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2415_Task4" name="System pushes inventory availability to marketplace every 15 minutes…">
        <bpmn:documentation>Step 1: System pushes inventory availability to marketplace every 15 minutes: BuildRight available quantity minus marketplace allocation; prevents overselling; handles sync errors and reconciles discrepancies
Responsible (R): System / IT Integration Lead
Accountable (A): Inventory Manager
Duration: Automated + 2–3 hours/week</bpmn:documentation>
        <bpmn:incoming>W2415_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2415_End5" name="Complete">
        <bpmn:incoming>W2415_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2415_Annotation6">
        <bpmn:text>Controls: - CTL-425 (ensure controlled execution — Marketplace Order &amp; Inventory Sync (PA-65.2).) | - operational: inventory-count integrity; Operational: IT Integration Lead sign-off on the workflow output
Owner: IT Integration Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2415_Assoc7" sourceRef="W2415_Annotation6" targetRef="W2415_Start3" associationDirection="None" />
