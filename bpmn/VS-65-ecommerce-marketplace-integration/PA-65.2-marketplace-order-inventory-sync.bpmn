    <bpmn:process id="W_W2414" name="W2414. Marketplace Order Download &amp; Processing" isExecutable="false">
      <bpmn:documentation>Trigger: Continuous order sync from marketplace
Frequency: Continuous; ~5,000–10,000 marketplace orders/month
Volume: ~5K–10K/month across platforms
Owner: Order Management System
Participants: OMS, Ecommerce Ops, DC Ops, Logistics
Source: workflow W2414 — Marketplace Order Download &amp; Processing</bpmn:documentation>
      <bpmn:laneSet id="W2414_LaneSet2">
        <bpmn:lane id="W2414_Lane1" name="System">
        <bpmn:flowNodeRef>W2414_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2414_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2414_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2414_Start3" name="Continuous order sync from marketplace">
        <bpmn:outgoing>W2414_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2414_Task4" name="System downloads marketplace orders via API; converts to BuildRight fulfillment…">
        <bpmn:documentation>Step 1: System downloads marketplace orders via API; converts to BuildRight fulfillment orders; reserves inventory; routes to fulfillment source (DC, store, vendor) per VS-60 routing logic
Responsible (R): System
Accountable (A): Ecommerce Operations Manager
Duration: Automated</bpmn:documentation>
        <bpmn:incoming>W2414_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2414_End5" name="Complete">
        <bpmn:incoming>W2414_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2414_Annotation6">
        <bpmn:text>Controls: - CTL-425 (ensure controlled execution — Marketplace Order &amp; Inventory Sync (PA-65.2).) | - operational: Order Management System sign-off on the workflow output
Owner: Order Management System</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2414_Assoc7" sourceRef="W2414_Annotation6" targetRef="W2414_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W2414_Flow8" sourceRef="W2414_Start3" targetRef="W2414_Task4" />
      <bpmn:sequenceFlow id="W2414_Flow9" sourceRef="W2414_Task4" targetRef="W2414_End5" />
    </bpmn:process>
