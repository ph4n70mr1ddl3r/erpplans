    <bpmn:process id="W_W2416" name="W2416. Marketplace Fulfillment &amp; Shipping" isExecutable="false">
      <bpmn:documentation>Trigger: Marketplace order requires fulfillment
Frequency: ~5,000–10,000 orders/month
Volume: ~5K–10K/month
Owner: Ecommerce Operations Manager
Participants: Ecom Ops Mgr, DC Ops, Marketplace Logistics
Source: workflow W2416 — Marketplace Fulfillment &amp; Shipping</bpmn:documentation>
      <bpmn:laneSet id="W2416_LaneSet3">
        <bpmn:lane id="W2416_Lane1" name="System">
        <bpmn:flowNodeRef>W2416_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2416_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2416_Lane2" name="DC Ops">
        <bpmn:flowNodeRef>W2416_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2416_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2416_Start4" name="Marketplace order requires fulfillment">
        <bpmn:outgoing>W2416_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2416_Task5" name="Fulfillment: (a) marketplace-managed logistics (FBS/LazMall) — system generates…">
        <bpmn:documentation>Step 1: Fulfillment: (a) marketplace-managed logistics (FBS/LazMall) — system generates marketplace shipping label; (b) seller-managed — system routes per VS-60 to optimal source
Responsible (R): System / Ecom Ops Manager
Accountable (A): VP Supply Chain
Duration: Varies</bpmn:documentation>
        <bpmn:incoming>W2416_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2416_Flow10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="W2416_Task6" name="DC/store picks, packs, ships; system pushes tracking number to marketplace…">
        <bpmn:documentation>Step 2: DC/store picks, packs, ships; system pushes tracking number to marketplace; customer tracks via marketplace app; delivery confirmation auto-updates order status
Responsible (R): DC Ops / System
Accountable (A): Ecom Ops Manager
Duration: 1–5 days</bpmn:documentation>
        <bpmn:incoming>W2416_Flow11</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2416_End7" name="Complete">
        <bpmn:incoming>W2416_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2416_Annotation8">
        <bpmn:text>Controls: - CTL-425 (ensure controlled execution — Marketplace Order &amp; Inventory Sync (PA-65.2).) | - operational: Ecommerce Operations Manager sign-off on the workflow output
Owner: Ecommerce Operations Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2416_Assoc9" sourceRef="W2416_Annotation8" targetRef="W2416_Start4" associationDirection="None" />
