    <bpmn:process id="W_W2418" name="W2418. Marketplace Pricing Sync &amp; Competitor Monitoring" isExecutable="false">
      <bpmn:documentation>Trigger: Daily price sync; continuous monitoring
Frequency: Daily; ~5,000–10,000 SKUs per platform
Volume: ~5K–10K SKUs
Owner: Pricing Analyst
Participants: Pricing Analyst, Ecommerce Dir, IT
Source: workflow W2418 — Marketplace Pricing Sync &amp; Competitor Monitoring</bpmn:documentation>
      <bpmn:laneSet id="W2418_LaneSet2">
        <bpmn:lane id="W2418_Lane1" name="System">
        <bpmn:flowNodeRef>W2418_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2418_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2418_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2418_Start3" name="Daily price sync; continuous monitoring">
        <bpmn:outgoing>W2418_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="W2418_Task4" name="System syncs BuildRight prices to marketplace (adjusted for commission)…">
        <bpmn:documentation>Step 1: System syncs BuildRight prices to marketplace (adjusted for commission); Analyst monitors competitor pricing on marketplace; recommends price adjustments for competitive positioning
Responsible (R): System / Pricing Analyst
Accountable (A): GM, Digital Commerce Inc.
Duration: 1–2 hours/day</bpmn:documentation>
        <bpmn:incoming>W2418_Flow8</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:endEvent id="W2418_End5" name="Complete">
        <bpmn:incoming>W2418_Flow9</bpmn:incoming>
      </bpmn:endEvent>
