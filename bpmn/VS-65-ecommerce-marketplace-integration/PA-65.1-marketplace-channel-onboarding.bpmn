        <bpmndi:BPMNEdge id="W2408_Flow11_di" bpmnElement="W2408_Flow11"><di:waypoint x="580" y="165" /><di:waypoint x="610" y="335" /></bpmndi:BPMNEdge>
        <bpmndi:BPMNEdge id="W2408_Flow12_di" bpmnElement="W2408_Flow12"><di:waypoint x="790" y="335" /><di:waypoint x="840" y="335" /></bpmndi:BPMNEdge>
