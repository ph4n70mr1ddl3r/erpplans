    <bpmn:process id="W_W2407" name="W2407. Marketplace Store Setup &amp; Branding" isExecutable="false">
      <bpmn:documentation>Trigger: Marketplace platform approved; store setup begins
Frequency: Per platform (~1–2/year)
Volume: ~1–2 setups/year
Owner: Digital Marketing Manager
Participants: Digital Marketing Mgr, Ecommerce Dir, Brand Manager
Source: workflow W2407 — Marketplace Store Setup &amp; Branding</bpmn:documentation>
      <bpmn:laneSet id="W2407_LaneSet2">
        <bpmn:lane id="W2407_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W2407_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2407_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2407_End5</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2407_Start3" name="Marketplace platform approved; store setup begins">
        <bpmn:outgoing>W2407_Flow8</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2407_Task4" name="Digital Marketing creates marketplace storefront: BuildRight branding, banner…">
        <bpmn:documentation>Step 1: Digital Marketing creates marketplace storefront: BuildRight branding, banner images, product categories, store policies, customer service info, shipping options; launches store in compliance with marketplace guidelines
Responsible (R): Digital Marketing Manager
Accountable (A): GM, Digital Commerce Inc.
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2407_Flow8</bpmn:incoming>
        <bpmn:outgoing>W2407_Flow9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2407_End5" name="Complete">
        <bpmn:incoming>W2407_Flow9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2407_Annotation6">
        <bpmn:text>Controls: - CTL-424 (ensure controlled execution — Marketplace Channel Onboarding &amp; Configuration (PA-65.1).) | - operational: Digital Marketing Manager sign-off on the workflow output
Owner: Digital Marketing Manager</bpmn:text>
      </bpmn:textAnnotation>
