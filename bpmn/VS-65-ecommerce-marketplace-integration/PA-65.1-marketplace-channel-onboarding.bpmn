    <bpmn:process id="W_W2406" name="W2406. Marketplace Platform Selection &amp; Registration" isExecutable="false">
      <bpmn:documentation>Trigger: Strategic decision to add marketplace channel
Frequency: Ad-hoc; 1–2 new platforms/year
Volume: 1–2 platforms/year
Owner: GM, Digital Commerce Inc.
Participants: Ecommerce Dir, Legal, Finance, VP Marketing
Source: workflow W2406 — Marketplace Platform Selection &amp; Registration</bpmn:documentation>
      <bpmn:laneSet id="W2406_LaneSet3">
        <bpmn:lane id="W2406_Lane1" name="GM, Digital Commerce Inc.">
        <bpmn:flowNodeRef>W2406_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2406_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2406_Lane2" name="Legal">
        <bpmn:flowNodeRef>W2406_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2406_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2406_Start4" name="Strategic decision to add marketplace channel">
        <bpmn:outgoing>W2406_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2406_Task5" name="GM, Digital Commerce Inc. evaluates marketplace: audience fit (home…">
        <bpmn:documentation>Step 1: GM, Digital Commerce Inc. evaluates marketplace: audience fit (home improvement/DIY buyers), commission structure (5–15%), logistics integration, competition, brand control; presents recommendation to VP Marketing
Responsible (R): GM, Digital Commerce Inc.
Accountable (A): VP Marketing
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2406_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2406_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2406_Task6" name="Legal reviews marketplace seller agreement: terms, IP protection, dispute…">
        <bpmn:documentation>Step 2: Legal reviews marketplace seller agreement: terms, IP protection, dispute resolution, data sharing; Finance sets up financial controls; IT begins integration planning
Responsible (R): Legal / Finance / IT
Accountable (A): GM, Digital Commerce Inc.
Duration: 5–10 days</bpmn:documentation>
        <bpmn:incoming>W2406_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2406_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2406_End7" name="Complete">
        <bpmn:incoming>W2406_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2406_Annotation8">
        <bpmn:text>Controls: - CTL-424 (ensure controlled execution — Marketplace Channel Onboarding &amp; Configuration (PA-65.1).) | - operational: GM, Digital Commerce Inc. sign-off on the workflow output
Owner: GM, Digital Commerce Inc.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2406_Assoc9" sourceRef="W2406_Annotation8" targetRef="W2406_Start4" associationDirection="None" />
