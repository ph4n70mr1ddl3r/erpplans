        <bpmndi:BPMNShape id="W2409_Task5_di" bpmnElement="W2409_Task5"><dc:Bounds x="610" y="125" width="180" height="80" /></bpmndi:BPMNShape>
        <bpmndi:BPMNShape id="W2409_Start3_di" bpmnElement="W2409_Start3"><dc:Bounds x="290" y="147" width="36" height="36" /></bpmndi:BPMNShape>
