      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2409" name="W2409. Marketplace API Integration" isExecutable="false">
      <bpmn:documentation>Trigger: Catalog and pricing configured; integration begins
Frequency: Per platform (~1–2/year)
Volume: ~1–2 integrations/year
Owner: IT Integration Lead
Participants: IT Integration Lead, Ecommerce Dir, Marketplace Tech Team
Source: workflow W2409 — Marketplace API Integration</bpmn:documentation>
      <bpmn:laneSet id="W2409_LaneSet2">
        <bpmn:lane id="W2409_Lane1" name="IT Integration Lead">
        <bpmn:flowNodeRef>W2409_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2409_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2409_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2409_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2409_Start3" name="Catalog and pricing configured; integration begins">
        <bpmn:outgoing>W2409_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2409_Task4" name="IT configures API integration: product catalog sync, inventory sync, order…">
        <bpmn:documentation>Step 1: IT configures API integration: product catalog sync, inventory sync, order download, shipment update push, price sync, return status sync; tests in sandbox; certifies with marketplace
Responsible (R): IT Integration Lead
Accountable (A): CIO
Duration: 10–15 days</bpmn:documentation>
        <bpmn:incoming>W2409_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2409_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2409_Task5" name="Monitors integration health: sync latency, error rate, data accuracy; addresses…">
        <bpmn:documentation>Step 2: Monitors integration health: sync latency, error rate, data accuracy; addresses issues within marketplace SLA (typically 24 hours)
Responsible (R): IT Integration Lead
Accountable (A): GM, Digital Commerce Inc.
Duration: Ongoing</bpmn:documentation>
        <bpmn:incoming>W2409_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2409_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2409_End6" name="Complete">
        <bpmn:incoming>W2409_Flow11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2409_Annotation7">
        <bpmn:text>Controls: - CTL-424 (ensure controlled execution — Marketplace Channel Onboarding &amp; Configuration (PA-65.1).) | - operational: IT Integration Lead sign-off on the workflow output
Owner: IT Integration Lead</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2409_Assoc8" sourceRef="W2409_Annotation7" targetRef="W2409_Start3" associationDirection="None" />
