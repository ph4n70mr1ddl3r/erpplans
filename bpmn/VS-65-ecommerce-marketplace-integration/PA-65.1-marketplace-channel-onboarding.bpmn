      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2408" name="W2408. Marketplace Catalog &amp; Pricing Configuration" isExecutable="false">
      <bpmn:documentation>Trigger: Store setup complete; catalog upload
Frequency: Initial setup + ongoing catalog updates
Volume: ~5,000–10,000 SKUs per marketplace
Owner: Ecommerce Catalog Manager
Participants: Catalog Mgr, Pricing Analyst, IT Integration
Source: workflow W2408 — Marketplace Catalog &amp; Pricing Configuration</bpmn:documentation>
      <bpmn:laneSet id="W2408_LaneSet3">
        <bpmn:lane id="W2408_Lane1" name="Catalog Manager">
        <bpmn:flowNodeRef>W2408_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2408_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W2408_Lane2" name="Pricing Analyst">
        <bpmn:flowNodeRef>W2408_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2408_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2408_Start4" name="Store setup complete; catalog upload">
        <bpmn:outgoing>W2408_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2408_Task5" name="Catalog Manager selects SKUs for marketplace: excludes consignment, heavy/bulky…">
        <bpmn:documentation>Step 1: Catalog Manager selects SKUs for marketplace: excludes consignment, heavy/bulky items (unless marketplace supports), low-margin items; creates marketplace-specific listings with optimized titles, descriptions, images
Responsible (R): Catalog Manager
Accountable (A): GM, Digital Commerce Inc.
Duration: 5–10 days initial</bpmn:documentation>
        <bpmn:incoming>W2408_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2408_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2408_Task6" name="Pricing Analyst sets marketplace prices: BuildRight price + marketplace…">
        <bpmn:documentation>Step 2: Pricing Analyst sets marketplace prices: BuildRight price + marketplace commission adjustment; competitive pricing vs. marketplace competitors; configures shipping fee structure
Responsible (R): Pricing Analyst
Accountable (A): GM, Digital Commerce Inc.
Duration: 2–3 days</bpmn:documentation>
        <bpmn:incoming>W2408_Flow11</bpmn:incoming>
        <bpmn:outgoing>W2408_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2408_End7" name="Complete">
        <bpmn:incoming>W2408_Flow12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W2408_Annotation8">
        <bpmn:text>Controls: - CTL-200 (ensure marketplace order &amp; settlement reconciliation.) | - CTL-424 (price-change authorization — links to VS-08 / W40); Operational: Ecommerce Catalog Manager sign-off on the workflow output
Owner: Ecommerce Catalog Manager</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W2408_Assoc9" sourceRef="W2408_Annotation8" targetRef="W2408_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W2408_Flow10" sourceRef="W2408_Start4" targetRef="W2408_Task5" />
      <bpmn:sequenceFlow id="W2408_Flow11" sourceRef="W2408_Task5" targetRef="W2408_Task6" />
      <bpmn:sequenceFlow id="W2408_Flow12" sourceRef="W2408_Task6" targetRef="W2408_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W2408_diag">
