    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W2410" name="W2410. Marketplace Promotional Campaign Setup" isExecutable="false">
      <bpmn:documentation>Trigger: Marketplace mega-sale event (e.g., 11.11, 12.12)
Frequency: 6–8 mega-sale events/year per marketplace
Volume: 6–8 events × platforms
Owner: Digital Marketing Manager
Participants: Digital Marketing Mgr, Pricing Analyst, Ecommerce Dir
Source: workflow W2410 — Marketplace Promotional Campaign Setup</bpmn:documentation>
      <bpmn:laneSet id="W2410_LaneSet2">
        <bpmn:lane id="W2410_Lane1" name="Digital Marketing Manager">
        <bpmn:flowNodeRef>W2410_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2410_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2410_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W2410_End6</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W2410_Start3" name="Marketplace mega-sale event (e.g., 11.11, 12.12)">
        <bpmn:outgoing>W2410_Flow9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W2410_Task4" name="Digital Marketing plans marketplace campaign: selects products for flash deals…">
        <bpmn:documentation>Step 1: Digital Marketing plans marketplace campaign: selects products for flash deals, sets discount levels, allocates co-op marketing budget; configures in marketplace seller center
Responsible (R): Digital Marketing Manager
Accountable (A): VP Marketing
Duration: 3–5 days/event</bpmn:documentation>
        <bpmn:incoming>W2410_Flow9</bpmn:incoming>
        <bpmn:outgoing>W2410_Flow10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W2410_Task5" name="Monitors campaign performance in real-time: sales velocity, conversion rate…">
        <bpmn:documentation>Step 2: Monitors campaign performance in real-time: sales velocity, conversion rate, customer reviews; adjusts pricing and inventory allocation as needed during event
Responsible (R): Digital Marketing Manager
Accountable (A): GM, Digital Commerce Inc.
Duration: 1–3 days per event</bpmn:documentation>
        <bpmn:incoming>W2410_Flow10</bpmn:incoming>
        <bpmn:outgoing>W2410_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W2410_End6" name="Complete">
        <bpmn:incoming>W2410_Flow11</bpmn:incoming>
      </bpmn:endEvent>
