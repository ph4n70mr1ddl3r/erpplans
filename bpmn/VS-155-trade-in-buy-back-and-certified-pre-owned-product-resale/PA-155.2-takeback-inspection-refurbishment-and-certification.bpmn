    <bpmn:process id="W_W4588" name="W4588. Refurbishment Processing (Repair, Refinish, Parts Replacement)" isExecutable="false">
      <bpmn:documentation>Trigger: Triage to refurbish (W4587)
Frequency: Per item
Volume: Refurbishment processing across triaged items
Owner: Service Center (VS-12.1)
Participants: Quality (VS-31), Inventory/parts (VS-05), Vendor service (VS-03), Finance (VS-17)
Source: workflow W4588 — Refurbishment Processing (Repair, Refinish, Parts Replacement)</bpmn:documentation>
      <bpmn:laneSet id="W4588_LaneSet2">
        <bpmn:lane id="W4588_Lane1" name="Service Center">
        <bpmn:flowNodeRef>W4588_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4588_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4588_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4588_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4588_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4588_Start3" name="Triage to refurbish (W4587)">
        <bpmn:outgoing>W4588_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4588_Task4" name="Service Center diagnose &amp; execute refurbishment (repair, replace worn parts…">
        <bpmn:documentation>Step 1: Service Center diagnose &amp; execute refurbishment (repair, replace worn parts from stock VS-05 or vendor VS-03, refinish/clean, re-battery for cordless), per grade target (W4579)
Responsible (R): Service Center / Vendor
Accountable (A): Service Center Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4588_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4588_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4588_Task5" name="Service Center/Quality verify refurbishment meets function/cosmetic standard…">
        <bpmn:documentation>Step 2: Service Center/Quality verify refurbishment meets function/cosmetic standard (VS-31), capturing parts/labor cost for unit economics (W4582/W4591)
Responsible (R): Service Center / Quality
Accountable (A): Service Center Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4588_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4588_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4588_Task6" name="Service Center route the refurbished item to certification (W4589), with HSE…">
