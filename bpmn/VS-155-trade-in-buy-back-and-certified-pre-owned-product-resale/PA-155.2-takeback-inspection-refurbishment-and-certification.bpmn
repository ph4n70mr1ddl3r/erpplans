      <bpmn:startEvent id="W4592_Start3" name="Refurbishment ops (W4588); HSE cycle; incident">
        <bpmn:outgoing>W4592_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4592_Task4" name="HSE/Service Center set refurbisher safety standards (electrical test safety…">
        <bpmn:documentation>Step 1: HSE/Service Center set refurbisher safety standards (electrical test safety, battery/lithium handling VS-114, PPE, ergonomic), per VS-24/DG rules
Responsible (R): HSE / Service Center
Accountable (A): HSE Lead / Service Center Manager
Duration: Annual + ongoing</bpmn:documentation>
        <bpmn:incoming>W4592_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4592_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4592_Task5" name="HSE/Occupational Health train technicians, monitor exposures (electrical…">
        <bpmn:documentation>Step 2: HSE/Occupational Health train technicians, monitor exposures (electrical, chemical, battery), and manage incidents (VS-24/VS-83)
Responsible (R): HSE / Occupational Health / Service Center
Accountable (A): HSE Lead
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4592_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4592_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4592_Task6" name="HSE/DG manage refurbishment hazmat (battery/chemical storage, e-waste disposal…">
        <bpmn:documentation>Step 3: HSE/DG manage refurbishment hazmat (battery/chemical storage, e-waste disposal VS-114/VS-73), and ensure compliance/audit (VS-22/VS-21)
Responsible (R): HSE / DG / Compliance
Accountable (A): HSE Lead / VP Legal
Duration: Continuous</bpmn:documentation>
        <bpmn:incoming>W4592_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4592_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4592_End7" name="Complete">
        <bpmn:incoming>W4592_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4592_Annotation8">
        <bpmn:text>Controls: - CTL-696 (ensure controlled execution — Take-Back, Inspection, Refurbishment &amp; Certification (PA-155.2).) | - CTL-696: refurbisher safety standards (VS-24/VS-114); technicians trained/PPE&#x27;d; hazmat compliantly handled (VS-114/VS-73)
Owner: HSE (VS-24) / Service Center (VS-12.1)</bpmn:text>
      </bpmn:textAnnotation>
