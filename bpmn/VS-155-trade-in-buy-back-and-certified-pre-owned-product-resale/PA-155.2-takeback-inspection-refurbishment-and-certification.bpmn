        <bpmndi:BPMNEdge id="W4586_Assoc9_di" bpmnElement="W4586_Assoc9"><di:waypoint x="340" y="290" /><di:waypoint x="308" y="183" /></bpmndi:BPMNEdge>
      </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
    <bpmn:process id="W_W4587" name="W4587. Triage, Routing &amp; Disposition Decision" isExecutable="false">
      <bpmn:documentation>Trigger: Intake inspection complete (W4586)
Frequency: Per item
Volume: Triage/disposition across intake items
Owner: Service Center (VS-12.1) / Merchandising
Participants: Quality (VS-31), Finance (VS-17.4), Circular (VS-73)
Source: workflow W4587 — Triage, Routing &amp; Disposition Decision</bpmn:documentation>
      <bpmn:laneSet id="W4587_LaneSet3">
        <bpmn:lane id="W4587_Lane1" name="Service Center">
        <bpmn:flowNodeRef>W4587_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4587_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4587_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4587_Lane2" name="Finance">
        <bpmn:flowNodeRef>W4587_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4587_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4587_Start4" name="Intake inspection complete (W4586)">
        <bpmn:outgoing>W4587_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4587_Task5" name="Service Center/Merchandising triage each item to a disposition…">
        <bpmn:documentation>Step 1: Service Center/Merchandising triage each item to a disposition (refurbish-to-certify W4588, parts-harvest W4590, recycle/dispose VS-73) based on inspection (W4586) &amp; unit economics (W4582)
Responsible (R): Service Center / Merchandising
Accountable (A): Service Center Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4587_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4587_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4587_Task6" name="Finance/Service Center confirm the disposition is economic (refurb cost vs…">
        <bpmn:documentation>Step 2: Finance/Service Center confirm the disposition is economic (refurb cost vs resale value W4582), re-routing uneconomic items to parts/recycle
Responsible (R): Finance / Service Center
Accountable (A): CFO / VP Merch
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4587_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4587_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4587_Task7" name="Service Center route the item (to refurb bench W4588, parts W4590, or recycle…">
        <bpmn:documentation>Step 3: Service Center route the item (to refurb bench W4588, parts W4590, or recycle VS-73), recording the disposition for analytics (W4599) &amp; inventory (VS-05)
Responsible (R): Service Center
Accountable (A): Service Center Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4587_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4587_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4587_End8" name="Complete">
        <bpmn:incoming>W4587_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4587_Annotation9">
        <bpmn:text>Controls: - CTL-696 (ensure controlled execution — Take-Back, Inspection, Refurbishment &amp; Certification (PA-155.2).) | - CTL-696: disposition economics-driven (W4582); routes correct (refurb/parts/recycle); recorded for analytics/inventory
Owner: Service Center (VS-12.1) / Merchandising</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4587_Assoc10" sourceRef="W4587_Annotation9" targetRef="W4587_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4587_Flow11" sourceRef="W4587_Start4" targetRef="W4587_Task5" />
      <bpmn:sequenceFlow id="W4587_Flow12" sourceRef="W4587_Task5" targetRef="W4587_Task6" />
      <bpmn:sequenceFlow id="W4587_Flow13" sourceRef="W4587_Task6" targetRef="W4587_Task7" />
      <bpmn:sequenceFlow id="W4587_Flow14" sourceRef="W4587_Task7" targetRef="W4587_End8" />
    </bpmn:process>
