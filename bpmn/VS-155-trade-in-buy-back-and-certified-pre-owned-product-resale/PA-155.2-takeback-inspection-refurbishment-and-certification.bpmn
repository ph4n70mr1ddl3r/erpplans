    <bpmn:process id="W_W4586" name="W4586. Intake Inspection, Safety Screen &amp; Data Wipe" isExecutable="false">
      <bpmn:documentation>Trigger: Take-back custody (W4585)
Frequency: Per item
Volume: Inspections across intake items
Owner: Service Center (VS-12.1) / Quality (VS-31)
Participants: Stores (VS-07), HSE (VS-24), Privacy (VS-91), DG (VS-114)
Source: workflow W4586 — Intake Inspection, Safety Screen &amp; Data Wipe</bpmn:documentation>
      <bpmn:laneSet id="W4586_LaneSet2">
        <bpmn:lane id="W4586_Lane1" name="Service Center">
        <bpmn:flowNodeRef>W4586_Task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4586_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4586_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4586_Start3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4586_End7</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4586_Start3" name="Take-back custody (W4585)">
        <bpmn:outgoing>W4586_Flow10</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4586_Task4" name="Service Center/Quality inspect the item (function, cosmetic, completeness…">
        <bpmn:documentation>Step 1: Service Center/Quality inspect the item (function, cosmetic, completeness, age/condition per W4579 grading) and safety-screen (no recalled VS-89, no DG/battery hazard VS-114, electrical safety)
Responsible (R): Service Center / Quality
Accountable (A): Service Center Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4586_Flow10</bpmn:incoming>
        <bpmn:outgoing>W4586_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4586_Task5" name="Service Center/Privacy perform data wipe/factory reset on smart…">
        <bpmn:documentation>Step 2: Service Center/Privacy perform data wipe/factory reset on smart appliances/tools with stored data (VS-91 RA 10173), documenting sanitization
Responsible (R): Service Center / Privacy
Accountable (A): Service Center Manager / DPO
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4586_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4586_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4586_Task6" name="Service Center/HSE handle any intake hazmat (battery/chemical VS-114/VS-24)…">
        <bpmn:documentation>Step 3: Service Center/HSE handle any intake hazmat (battery/chemical VS-114/VS-24) safely, and route the item to triage (W4587)
Responsible (R): Service Center / HSE
Accountable (A): Service Center Manager / HSE Lead
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4586_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4586_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4586_End7" name="Complete">
        <bpmn:incoming>W4586_Flow13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4586_Annotation8">
        <bpmn:text>Controls: - CTL-82 (ensure trade-in device integrity &amp; data wipe.) | - CTL-696: safety-screened (no recalled/DG/unsafe VS-89/VS-114); data wiped (VS-91); hazmat handled (VS-24)
Owner: Service Center (VS-12.1) / Quality (VS-31)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4586_Assoc9" sourceRef="W4586_Annotation8" targetRef="W4586_Start3" associationDirection="None" />
      <bpmn:sequenceFlow id="W4586_Flow10" sourceRef="W4586_Start3" targetRef="W4586_Task4" />
      <bpmn:sequenceFlow id="W4586_Flow11" sourceRef="W4586_Task4" targetRef="W4586_Task5" />
      <bpmn:sequenceFlow id="W4586_Flow12" sourceRef="W4586_Task5" targetRef="W4586_Task6" />
      <bpmn:sequenceFlow id="W4586_Flow13" sourceRef="W4586_Task6" targetRef="W4586_End7" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4586_diag">
      <bpmndi:BPMNPlane id="W4586_plane" bpmnElement="W_W4586">
        <bpmndi:BPMNShape id="W4586_Lane1_di" bpmnElement="W4586_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
