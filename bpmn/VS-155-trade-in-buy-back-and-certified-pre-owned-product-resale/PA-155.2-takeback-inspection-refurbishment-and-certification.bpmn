    <bpmn:process id="W_W4592" name="W4592. Refurbisher Safety, HSE &amp; Hazmat Handling" isExecutable="false">
      <bpmn:documentation>Trigger: Refurbishment ops (W4588); HSE cycle; incident
Frequency: Continuous + on incident
Volume: Refurbisher HSE across service centers
Owner: HSE (VS-24) / Service Center (VS-12.1)
Participants: Quality (VS-31), DG (VS-114), Occupational Health (VS-83), Compliance (VS-22)
Source: workflow W4592 — Refurbisher Safety, HSE &amp; Hazmat Handling</bpmn:documentation>
      <bpmn:laneSet id="W4592_LaneSet2">
        <bpmn:lane id="W4592_Lane1" name="HSE">
        <bpmn:flowNodeRef>W4592_Task4</bpmn:flowNodeRef>
