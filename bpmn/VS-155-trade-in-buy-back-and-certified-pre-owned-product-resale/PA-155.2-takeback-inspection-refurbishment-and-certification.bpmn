    <bpmn:process id="W_W4585" name="W4585. Customer Take-Back Intake &amp; Custody Transfer" isExecutable="false">
      <bpmn:documentation>Trigger: Customer trade-in acceptance (W4580); buy-back
Frequency: Per item
Volume: Take-back intakes across stores/service centers
Owner: Stores (VS-07) / Service Center (VS-12.1)
Participants: POS (VS-08), Inventory (VS-05), Compliance (VS-22), Customer
Source: workflow W4585 — Customer Take-Back Intake &amp; Custody Transfer</bpmn:documentation>
      <bpmn:laneSet id="W4585_LaneSet3">
        <bpmn:lane id="W4585_Lane1" name="Stores">
        <bpmn:flowNodeRef>W4585_Task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4585_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4585_Start4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4585_Lane2" name="Inventory">
        <bpmn:flowNodeRef>W4585_Task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4585_End8</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="W4585_Start4" name="Customer trade-in acceptance (W4580); buy-back">
        <bpmn:outgoing>W4585_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4585_Task5" name="Stores/Service Center take physical custody of the trade-in item, verify…">
        <bpmn:documentation>Step 1: Stores/Service Center take physical custody of the trade-in item, verify ownership/identity (anti-theft — avoid receiving stolen goods VS-23), and confirm eligibility (W4578)
Responsible (R): Stores / Service Center
Accountable (A): Store Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4585_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4585_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4585_Task6" name="Stores/POS issue the trade-in credit (W4580), record the take-back (customer…">
        <bpmn:documentation>Step 2: Stores/POS issue the trade-in credit (W4580), record the take-back (customer, item, valuation, channel), and transfer title/ownership to BuildRight
Responsible (R): Stores / POS / Compliance
Accountable (A): Store Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4585_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4585_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4585_Task7" name="Inventory/Stores move the item to pre-owned intake stock (VS-05/W4584) and…">
        <bpmn:documentation>Step 3: Inventory/Stores move the item to pre-owned intake stock (VS-05/W4584) and route to inspection (W4586), with custody chain documented
Responsible (R): Inventory / Stores
Accountable (A): Inventory Manager
Duration: Per item</bpmn:documentation>
        <bpmn:incoming>W4585_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4585_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4585_End8" name="Complete">
        <bpmn:incoming>W4585_Flow14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:textAnnotation id="W4585_Annotation9">
        <bpmn:text>Controls: - CTL-696 (ensure controlled execution — Take-Back, Inspection, Refurbishment &amp; Certification (PA-155.2).) | - CTL-696: ownership/identity verified (anti-theft VS-23); eligibility confirmed (W4578); title transferred &amp; documented
Owner: Stores (VS-07) / Service Center (VS-12.1)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="W4585_Assoc10" sourceRef="W4585_Annotation9" targetRef="W4585_Start4" associationDirection="None" />
      <bpmn:sequenceFlow id="W4585_Flow11" sourceRef="W4585_Start4" targetRef="W4585_Task5" />
      <bpmn:sequenceFlow id="W4585_Flow12" sourceRef="W4585_Task5" targetRef="W4585_Task6" />
      <bpmn:sequenceFlow id="W4585_Flow13" sourceRef="W4585_Task6" targetRef="W4585_Task7" />
      <bpmn:sequenceFlow id="W4585_Flow14" sourceRef="W4585_Task7" targetRef="W4585_End8" />
    </bpmn:process>
    <bpmndi:BPMNDiagram id="W4585_diag">
      <bpmndi:BPMNPlane id="W4585_plane" bpmnElement="W_W4585">
        <bpmndi:BPMNShape id="W4585_Lane1_di" bpmnElement="W4585_Lane1" isHorizontal="true"><dc:Bounds x="160" y="80" width="950" height="170" /></bpmndi:BPMNShape>
