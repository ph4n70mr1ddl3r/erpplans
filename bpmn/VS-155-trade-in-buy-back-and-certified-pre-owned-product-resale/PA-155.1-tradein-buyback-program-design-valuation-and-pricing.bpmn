        <bpmn:outgoing>W4578_Flow11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4578_Task5" name="Merchandising/Service Center set product eligibility (brands/models accepted…">
        <bpmn:documentation>Step 1: Merchandising/Service Center set product eligibility (brands/models accepted, age/condition floor, safety/DG exclusions — no trade-in of DG/chemicals/recalled VS-89), per W4577 scope
Responsible (R): Merchandising / Service Center / Quality
Accountable (A): VP Merch
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4578_Flow11</bpmn:incoming>
        <bpmn:outgoing>W4578_Flow11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4578_Task6" name="Merchandising/Stores set take-back channels (in-store counter, service center…">
        <bpmn:documentation>Step 2: Merchandising/Stores set take-back channels (in-store counter, service center VS-12.1, ecommerce mail-in), the customer journey, and any logistics for mail-in (VS-06)
Responsible (R): Merchandising / Stores / Logistics
Accountable (A): VP Merch / COO
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4578_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4578_Flow12</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4578_Task7" name="Compliance/Legal ensure take-back is consumer-protection-compliant (clear…">
        <bpmn:documentation>Step 3: Compliance/Legal ensure take-back is consumer-protection-compliant (clear terms, no obligation, RA 7394), and aligned to returns (VS-32) and quality (VS-31)
Responsible (R): Compliance / Legal
Accountable (A): VP Legal
Duration: Annual</bpmn:documentation>
        <bpmn:incoming>W4578_Flow13</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:endEvent id="W4578_End8" name="Complete">
        <bpmn:incoming>W4578_Flow14</bpmn:incoming>
      </bpmn:endEvent>
