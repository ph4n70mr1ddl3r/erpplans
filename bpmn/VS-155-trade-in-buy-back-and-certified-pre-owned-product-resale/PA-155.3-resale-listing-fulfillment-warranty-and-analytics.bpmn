    <bpmn:process id="W_W4594" name="W4594. Resale Order, Pricing Integrity &amp; Checkout" isExecutable="false">
      <bpmn:documentation>Trigger: Customer purchase of certified pre-owned
Frequency: Per order
Volume: Resale orders across channels
Owner: POS (VS-08) / Ecommerce (VS-10) / Pricing
Participants: Revenue Assurance (VS-118), Finance (VS-17/VS-79), CRM (VS-13)
Source: workflow W4594 — Resale Order, Pricing Integrity &amp; Checkout</bpmn:documentation>
      <bpmn:laneSet id="W4594_LaneSet4">
        <bpmn:lane id="W4594_Lane1" name="POS">
        <bpmn:flowNodeRef>W4594_Task6</bpmn:flowNodeRef>
