    <bpmn:process id="W_W4595" name="W4595. Pre-Owned Fulfillment, Pickup &amp; Delivery" isExecutable="false">
      <bpmn:documentation>Trigger: Resale order (W4594)
Frequency: Per order
Volume: Fulfillment across pre-owned orders
Owner: Stores (VS-07) / Logistics (VS-06) / Ecommerce (VS-10)
Participants: Inventory (VS-05), Omnichannel (VS-60), Customer Support (VS-13)
Source: workflow W4595 — Pre-Owned Fulfillment, Pickup &amp; Delivery</bpmn:documentation>
      <bpmn:laneSet id="W4595_LaneSet4">
        <bpmn:lane id="W4595_Lane1" name="Stores">
        <bpmn:flowNodeRef>W4595_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4595_Start5</bpmn:flowNodeRef>
