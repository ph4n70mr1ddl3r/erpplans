    <bpmn:process id="W_W4596" name="W4596. Certified Pre-Owned Warranty Claim &amp; Service" isExecutable="false">
      <bpmn:documentation>Trigger: Customer warranty claim on certified pre-owned
Frequency: Per claim
Volume: Warranty claims across sold pre-owned units
Owner: Warranty (VS-53) / Service Center (VS-12.1)
Participants: Customer Support (VS-13), Quality (VS-31), Finance (VS-17)
Source: workflow W4596 — Certified Pre-Owned Warranty Claim &amp; Service</bpmn:documentation>
      <bpmn:laneSet id="W4596_LaneSet4">
        <bpmn:lane id="W4596_Lane1" name="Warranty">
        <bpmn:flowNodeRef>W4596_Task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W4596_Start5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="W4596_Lane2" name="Service Center">
        <bpmn:flowNodeRef>W4596_Task7</bpmn:flowNodeRef>
