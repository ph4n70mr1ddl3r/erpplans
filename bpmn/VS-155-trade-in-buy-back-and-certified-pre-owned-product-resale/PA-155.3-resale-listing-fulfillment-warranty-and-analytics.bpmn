        <bpmn:outgoing>W4594_Flow12</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="W4594_Task6" name="POS/Ecommerce process the certified-pre-owned order (correct SKU/serial W4584…">
        <bpmn:documentation>Step 1: POS/Ecommerce process the certified-pre-owned order (correct SKU/serial W4584, price W4581, warranty W4583 disclosure), with pricing integrity (VS-118)
Responsible (R): POS / Ecommerce
Accountable (A): Store Manager / Ecommerce Lead
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4594_Flow12</bpmn:incoming>
        <bpmn:outgoing>W4594_Flow13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4594_Task7" name="Revenue Assurance/Pricing verify price/grade/serial correctness (no new-price…">
        <bpmn:documentation>Step 2: Revenue Assurance/Pricing verify price/grade/serial correctness (no new-price on pre-owned, no serial mismatch), and capture the sale for analytics (W4599)
Responsible (R): Revenue Assurance / Pricing
Accountable (A): VP Merch
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4594_Flow13</bpmn:incoming>
        <bpmn:outgoing>W4594_Flow14</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="W4594_Task8" name="Finance/Tax account the resale (COGS = acquisition+refurb W4582, revenue, VAT…">
        <bpmn:documentation>Step 3: Finance/Tax account the resale (COGS = acquisition+refurb W4582, revenue, VAT VS-79), per VS-17 distinct pre-owned accounting
Responsible (R): Finance / Tax
Accountable (A): CFO
Duration: Per order</bpmn:documentation>
        <bpmn:incoming>W4594_Flow14</bpmn:incoming>
        <bpmn:outgoing>W4594_Flow15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="W4594_End9" name="Complete">
        <bpmn:incoming>W4594_Flow15</bpmn:incoming>
      </bpmn:endEvent>
