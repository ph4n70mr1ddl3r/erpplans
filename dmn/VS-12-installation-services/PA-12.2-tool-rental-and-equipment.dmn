<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-12.2-tool-rental-and-equipment"
             name="PA 12.2 tool rental and equipment"
             namespace="https://erpplans.local/dmn/PA-12.2-tool-rental-and-equipment"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_W1375_01" name="Authorization threshold — W1375">
    <description>Source: VS-12-installation-services/PA-12.2-tool-rental-and-equipment.md · workflow W1375 · step row (authorization thresholds)
Note: 6 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: If not returned within 10 days of original due date: (a) case escalated to Rental Fleet Manager at HQ; (b) Rental Fleet Manager reviews: equipment value, customer history, contact attempts, any dispute or complaint linked to the rental; (c) if equipment value &lt; PHP 20,000: Rental Fleet Manager authorizes write-off as loss per W92; equipment removed from rental fleet; (d) if equipment value ≥ PHP 20,000: case escalated to VP Legal for formal recovery action (demand letter from legal counsel, potential small claims filing) | Rental Fleet Manager / VP Legal | VP Supply Chain | 30 min/case</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W1375_01_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W1375_01_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W1375_01_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W1375_01_Rule01">
        <inputEntry><text>&lt; 20000</text></inputEntry>
        <outputEntry><text>&quot;Rental Fleet Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W1375_01_Rule02">
        <inputEntry><text>&gt;= 20000</text></inputEntry>
        <outputEntry><text>&quot;VP Legal for for&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_W1375_01_di" dmnElementRef="Decision_W1375_01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
