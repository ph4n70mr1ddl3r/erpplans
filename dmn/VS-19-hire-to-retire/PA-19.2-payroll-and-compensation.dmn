<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-19.2-payroll-and-compensation"
             name="PA 19.2 payroll and compensation"
             namespace="https://erpplans.local/dmn/PA-19.2-payroll-and-compensation"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Statutory Compliance Calendar — Frequency">
    <description>Source: VS-19-hire-to-retire/PA-19.2-payroll-and-compensation.md · section “Statutory Compliance Calendar” · rule table
Source table: Statutory Obligation | Frequency | Deadline | Remittance Method | Responsible | Cross-Reference</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T01_In01" label="Frequency">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Statutory Obligation" name="StatutoryObligation" typeRef="string"/>
      <output id="Decision_T01_Out02" label="Deadline" name="Deadline" typeRef="string"/>
      <output id="Decision_T01_Out03" label="Remittance Method" name="RemittanceMethod" typeRef="string"/>
      <output id="Decision_T01_Out04" label="Responsible" name="Responsible" typeRef="string"/>
      <output id="Decision_T01_Out05" label="Cross-Reference" name="CrossReference" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;SSS employee + employer contributions&quot;</text></outputEntry>
        <outputEntry><text>&quot;Last day of following month (or 10th of second month per SSS schedule)&quot;</text></outputEntry>
        <outputEntry><text>&quot;PRN via SSS online portal or bank&quot;</text></outputEntry>
        <outputEntry><text>&quot;Payroll Officer&quot;</text></outputEntry>
        <outputEntry><text>&quot;W10.11&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;PhilHealth contributions&quot;</text></outputEntry>
        <outputEntry><text>&quot;Every 10th of the following month&quot;</text></outputEntry>
        <outputEntry><text>&quot;Electronic remittance via PhilHealth portal&quot;</text></outputEntry>
        <outputEntry><text>&quot;Payroll Officer&quot;</text></outputEntry>
        <outputEntry><text>&quot;W10.11&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Pag-IBIG contributions&quot;</text></outputEntry>
        <outputEntry><text>&quot;Every 10th of the following month&quot;</text></outputEntry>
        <outputEntry><text>&quot;Online remittance via Pag-IBIG portal&quot;</text></outputEntry>
        <outputEntry><text>&quot;Payroll Officer&quot;</text></outputEntry>
        <outputEntry><text>&quot;W10.11&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;BIR Withholding Tax on Compensation (1601-C)&quot;</text></outputEntry>
        <outputEntry><text>&quot;10th of following month&quot;</text></outputEntry>
        <outputEntry><text>&quot;eFPS / eBIRForms&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9A.16&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule05">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;BIR Expanded Withholding Tax (1601-EQ)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Last day of month following quarter close&quot;</text></outputEntry>
        <outputEntry><text>&quot;eFPS / eBIRForms&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9A.16a&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule06">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;BIR VAT Return (2550M)&quot;</text></outputEntry>
        <outputEntry><text>&quot;20th or 25th of following month (per BIR filing threshold)&quot;</text></outputEntry>
        <outputEntry><text>&quot;eFPS / eBIRForms&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9A.16&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule07">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;BIR Quarterly VAT / Income Tax (2550Q / 1702Q)&quot;</text></outputEntry>
        <outputEntry><text>&quot;25th of month following quarter end&quot;</text></outputEntry>
        <outputEntry><text>&quot;eFPS / eBIRForms&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9A.16&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule08">
        <inputEntry><text>&quot;Per LGU calendar (annual or quarterly)&quot;</text></inputEntry>
        <outputEntry><text>&quot;Local Business Tax per LGU&quot;</text></outputEntry>
        <outputEntry><text>&quot;Per LGU deadline&quot;</text></outputEntry>
        <outputEntry><text>&quot;Per LGU (online, OTC, or LGU office)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9A.16c&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule09">
        <inputEntry><text>&quot;Annual&quot;</text></inputEntry>
        <outputEntry><text>&quot;13th Month Pay distribution&quot;</text></outputEntry>
        <outputEntry><text>&quot;On or before December 24&quot;</text></outputEntry>
        <outputEntry><text>&quot;Via payroll run&quot;</text></outputEntry>
        <outputEntry><text>&quot;Payroll Officer&quot;</text></outputEntry>
        <outputEntry><text>&quot;W10, W9B.18&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule10">
        <inputEntry><text>&quot;Annual&quot;</text></inputEntry>
        <outputEntry><text>&quot;BIR Annual Income Tax Return (1702RT)&quot;</text></outputEntry>
        <outputEntry><text>&quot;April 15 (or as extended)&quot;</text></outputEntry>
        <outputEntry><text>&quot;eFPS / eBIRForms&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;W9B.21&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
