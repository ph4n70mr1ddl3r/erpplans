<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-17.2-consolidation-and-intercompany"
             name="PA 17.2 consolidation and intercompany"
             namespace="https://erpplans.local/dmn/PA-17.2-consolidation-and-intercompany"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Intercompany Flows — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.2-consolidation-and-intercompany.md · section “Intercompany Flows” · rule table
Source table: Flow | From → To | Nature | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T01_In01" label="Frequency">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Flow" name="Flow" typeRef="string"/>
      <output id="Decision_T01_Out02" label="From → To" name="FromTo" typeRef="string"/>
      <output id="Decision_T01_Out03" label="Nature" name="Nature" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Store rent&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc. → Property Mgmt Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Monthly lease payments&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;DC warehousing fees&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc. → Logistics Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Storage and distribution fees&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Ecommerce fulfillment&quot;</text></outputEntry>
        <outputEntry><text>&quot;Digital Commerce Inc. → Depot Inc. (BOPIS) or Logistics Inc. (delivery)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Fulfillment fees per order&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Ecommerce payment collection&quot;</text></outputEntry>
        <outputEntry><text>&quot;Digital Commerce Inc. → Depot Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Remittance of in-store BOPIS revenue&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule05">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Management fees&quot;</text></outputEntry>
        <outputEntry><text>&quot;All subsidiaries → Holdings Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Corporate overhead allocation&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule06">
        <inputEntry><text>&quot;As needed&quot;</text></inputEntry>
        <outputEntry><text>&quot;Intercompany loans&quot;</text></outputEntry>
        <outputEntry><text>&quot;Holdings → subsidiaries as needed&quot;</text></outputEntry>
        <outputEntry><text>&quot;Cash advances / funding&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T02" name="Goods-Based IC Trigger Scenarios — Scenario">
    <description>Source: VS-17-record-to-report/PA-17.2-consolidation-and-intercompany.md · section “Goods-Based IC Trigger Scenarios” · rule table
Source table: Scenario | From | To | Trigger | IC Pricing Basis | Approval</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_T02_In01" label="Scenario">
        <inputExpression id="Decision_T02_InExpr01" typeRef="string">
          <text>Scenario</text>
        </inputExpression>
      </input>
      <input id="Decision_T02_In02" label="Trigger">
        <inputExpression id="Decision_T02_InExpr02" typeRef="string">
          <text>Trigger</text>
        </inputExpression>
      </input>
      <output id="Decision_T02_Out01" label="Approval" name="Approval" typeRef="string"/>
      <output id="Decision_T02_Out02" label="From" name="From" typeRef="string"/>
      <output id="Decision_T02_Out03" label="To" name="To" typeRef="string"/>
      <output id="Decision_T02_Out04" label="IC Pricing Basis" name="ICPricingBasis" typeRef="string"/>
      <rule id="Decision_T02_Rule01">
        <inputEntry><text>&quot;Property Mgr Inc. purchases building materials for property maintenance or tenant improvements&quot;</text></inputEntry>
        <inputEntry><text>&quot;Property Mgr Inc. submits material requisition for repair/renovation of leased premises (BuildRight stores, DC facilities, or HQ office)&quot;</text></inputEntry>
        <outputEntry><text>&quot;Property Mgr Inc. Facilities Coordinator + Depot Inc. Category Manager&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Property Mgr Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc. cost + 5% markup (arm&#x27;s-length; below retail SRP)&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule02">
        <inputEntry><text>&quot;Digital Commerce Inc. purchases office supplies or IT peripherals for internal use&quot;</text></inputEntry>
        <inputEntry><text>&quot;Digital Commerce Inc. office manager requests items not available through standard IT procurement&quot;</text></inputEntry>
        <outputEntry><text>&quot;Digital Commerce Inc. Dept. Head&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Digital Commerce Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Standard SRP (small volumes; immaterial)&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule03">
        <inputEntry><text>&quot;Logistics Inc. purchases warehouse supplies (racking, safety equipment, packaging materials) from Depot Inc. inventory&quot;</text></inputEntry>
        <inputEntry><text>&quot;DC Supervisor identifies need for operational supplies stocked in Depot Inc. inventory&quot;</text></inputEntry>
        <outputEntry><text>&quot;Logistics Inc. DC Manager + Depot Inc. Category Manager&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Logistics Inc.&quot;</text></outputEntry>
        <outputEntry><text>&quot;Depot Inc. cost + 5% markup&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T03" name="Annual IC Transfer Pricing Review (continued) — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.2-consolidation-and-intercompany.md · section “Annual IC Transfer Pricing Review (continued)” · rule table
Source table: Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T03_In01" label="Frequency">
        <inputExpression id="Decision_T03_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T03_Out01" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T03_Out02" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T03_Out03" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T03_Rule01">
        <inputEntry><text>&quot;Annually (during budget cycle, W26)&quot;</text></inputEntry>
        <outputEntry><text>&quot;CFO and Controller review all IC pricing schedules (store rent, DC fees, ecommerce fulfillment, management fees, IC loans, ecommerce payment collection) against market benchmarks and arm&#x27;s-length principles&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO + Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T03_Rule02">
        <inputEntry><text>&quot;Annually&quot;</text></inputEntry>
        <outputEntry><text>&quot;Update transfer pricing rules in system for new fiscal year; prepare and store transfer pricing documentation per BIR RR 02-2013 requirements&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T03_Rule03">
        <inputEntry><text>&quot;Annually&quot;</text></inputEntry>
        <outputEntry><text>&quot;CFO approves updated IC pricing; system updates IC invoice generation rules effective new fiscal year&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_W14_04" name="Authorization threshold — W14">
    <description>Source: VS-17-record-to-report/PA-17.2-consolidation-and-intercompany.md · workflow W14 · step row (authorization thresholds)
Verbatim: If IC value &gt; PHP 50,000: approval required from requesting entity Finance Manager and Depot Inc. Category Manager; if &lt; PHP 50,000: auto-approved within contract parameters | Approver(s) | CFO | 15 min</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W14_04_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W14_04_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W14_04_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W14_04_Rule01">
        <inputEntry><text>&lt; 50000</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W14_04_Rule02">
        <inputEntry><text>&gt; 50000</text></inputEntry>
        <outputEntry><text>&quot;Finance Manager and Depot Inc. Category Manager&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_T02_di" dmnElementRef="Decision_T02">
        <dc:Bounds x="420" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_T03_di" dmnElementRef="Decision_T03">
        <dc:Bounds x="680" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W14_04_di" dmnElementRef="Decision_W14_04">
        <dc:Bounds x="940" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
