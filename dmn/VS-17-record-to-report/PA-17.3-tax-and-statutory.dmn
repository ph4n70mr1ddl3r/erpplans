<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-17.3-tax-and-statutory"
             name="PA 17.3 tax and statutory"
             namespace="https://erpplans.local/dmn/PA-17.3-tax-and-statutory"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Quarterly / Annual Filing Additions — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.3-tax-and-statutory.md · section “Quarterly / Annual Filing Additions” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T01_In01" label="Frequency">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T01_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T01_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T01_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;11&quot;</text></outputEntry>
        <outputEntry><text>&quot;Quarterly income tax return (BIR Form 1702Q): Tax Accountant prepares quarterly corporate income tax return per entity: taxable income, tax due, quarterly installment; validates against quarterly financial statements (W9A)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;Annual&quot;</text></inputEntry>
        <outputEntry><text>&quot;12&quot;</text></outputEntry>
        <outputEntry><text>&quot;Annual income tax return (BIR Form 1702RT): Tax Accountant prepares annual corporate income tax return per entity; incorporates year-end adjustments from W9B; cross-references with external auditor&#x27;s tax computations (W95)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller / CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;Annual (January)&quot;</text></inputEntry>
        <outputEntry><text>&quot;13&quot;</text></outputEntry>
        <outputEntry><text>&quot;Annual information returns (BIR Forms 1604-C, 1604-E): Tax Accountant prepares and files annual alphalist of employees and payees; reconciles with full-year withholding records&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;14&quot;</text></outputEntry>
        <outputEntry><text>&quot;Local business tax reconciliation: Tax Accountant reconciles quarterly LBT payments per LGU (from W9A.16c) against LGU assessment; prepares any variance explanations; LGU assessments reconciled during W54 permit renewals&quot;</text></outputEntry>
        <outputEntry><text>&quot;Tax Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
