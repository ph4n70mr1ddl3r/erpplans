<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-17.4-fpanda-and-reporting"
             name="PA 17.4 fpanda and reporting"
             namespace="https://erpplans.local/dmn/PA-17.4-fpanda-and-reporting"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Approval Matrix — Amount">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Approval Matrix” · rule table
Source table: Amount | Approval Required</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_T01_In01" label="Amount">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Approval Required" name="ApprovalRequired" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;≤ PHP 100,000&quot;</text></inputEntry>
        <outputEntry><text>&quot;Finance Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;PHP 100,001 – 500,000&quot;</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;PHP 500,001 – 5,000,000&quot;</text></inputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;&gt; PHP 5,000,000&quot;</text></inputEntry>
        <outputEntry><text>&quot;Board of Directors&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T02" name="Daily — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Daily” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T02_In01" label="Frequency">
        <inputExpression id="Decision_T02_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T02_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T02_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T02_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T02_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T02_Rule01">
        <inputEntry><text>&quot;Daily (automated)&quot;</text></inputEntry>
        <outputEntry><text>&quot;1&quot;</text></outputEntry>
        <outputEntry><text>&quot;System generates daily flash report (auto-distributed by 7:00 AM): total chain revenue, transactions, avg ticket, same-store sales vs. prior year, top/bottom 10 stores&quot;</text></outputEntry>
        <outputEntry><text>&quot;System&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule02">
        <inputEntry><text>&quot;5 min/day&quot;</text></inputEntry>
        <outputEntry><text>&quot;2&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO reviews daily flash on mobile dashboard&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
        <outputEntry><text>&quot;—&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule03">
        <inputEntry><text>&quot;Daily (automated)&quot;</text></inputEntry>
        <outputEntry><text>&quot;3&quot;</text></outputEntry>
        <outputEntry><text>&quot;System generates daily inventory exception report: negative stock alerts, stockouts at store level, critical DC shortages&quot;</text></outputEntry>
        <outputEntry><text>&quot;System&quot;</text></outputEntry>
        <outputEntry><text>&quot;Supply Planning Manager&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T03" name="Weekly — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Weekly” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T03_In01" label="Frequency">
        <inputExpression id="Decision_T03_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T03_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T03_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T03_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T03_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T03_Rule01">
        <inputEntry><text>&quot;Weekly (automated)&quot;</text></inputEntry>
        <outputEntry><text>&quot;4&quot;</text></outputEntry>
        <outputEntry><text>&quot;Week-on-week sales report by store, category, and channel (POS vs. ecommerce); auto-distributed every Monday&quot;</text></outputEntry>
        <outputEntry><text>&quot;System&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T03_Rule02">
        <inputEntry><text>&quot;Weekly&quot;</text></inputEntry>
        <outputEntry><text>&quot;5&quot;</text></outputEntry>
        <outputEntry><text>&quot;Supply chain KPI report: fill rate, on-time delivery (DC→store), PO overdue rate, forecast accuracy&quot;</text></outputEntry>
        <outputEntry><text>&quot;Demand Planner&quot;</text></outputEntry>
        <outputEntry><text>&quot;Supply Planning Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T03_Rule03">
        <inputEntry><text>&quot;Weekly&quot;</text></inputEntry>
        <outputEntry><text>&quot;6&quot;</text></outputEntry>
        <outputEntry><text>&quot;AP aging summary: total payables, overdue invoices, payment run schedule&quot;</text></outputEntry>
        <outputEntry><text>&quot;AP Supervisor&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T03_Rule04">
        <inputEntry><text>&quot;Weekly&quot;</text></inputEntry>
        <outputEntry><text>&quot;7&quot;</text></outputEntry>
        <outputEntry><text>&quot;Treasury: weekly cash flow forecast (W30 step 8)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Treasury Analyst&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T04" name="Monthly — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Monthly” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T04_In01" label="Frequency">
        <inputExpression id="Decision_T04_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T04_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T04_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T04_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T04_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T04_Rule01">
        <inputEntry><text>&quot;Monthly (by day 5)&quot;</text></inputEntry>
        <outputEntry><text>&quot;8&quot;</text></outputEntry>
        <outputEntry><text>&quot;Financial statements per entity and consolidated (from W9 close process)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Chief Accountant&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule02">
        <inputEntry><text>&quot;Monthly (by day 7)&quot;</text></inputEntry>
        <outputEntry><text>&quot;9&quot;</text></outputEntry>
        <outputEntry><text>&quot;Budget vs. actual variance report per entity, per department (from W26)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule03">
        <inputEntry><text>&quot;Monthly (by day 7)&quot;</text></inputEntry>
        <outputEntry><text>&quot;10&quot;</text></outputEntry>
        <outputEntry><text>&quot;Store P&amp;L: revenue, COGS, gross margin, labor cost, occupancy, shrinkage, EBITDA per store&quot;</text></outputEntry>
        <outputEntry><text>&quot;System&quot;</text></outputEntry>
        <outputEntry><text>&quot;VP Store Operations&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule04">
        <inputEntry><text>&quot;Monthly (by day 7)&quot;</text></inputEntry>
        <outputEntry><text>&quot;11&quot;</text></outputEntry>
        <outputEntry><text>&quot;Merchandising performance: category sales, margin, inventory turns, sell-through, vendor rebate realization&quot;</text></outputEntry>
        <outputEntry><text>&quot;Pricing Analyst&quot;</text></outputEntry>
        <outputEntry><text>&quot;VP Merchandising&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule05">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;12&quot;</text></outputEntry>
        <outputEntry><text>&quot;AR aging and collections performance: DSO, overdue %, write-offs&quot;</text></outputEntry>
        <outputEntry><text>&quot;AR Supervisor&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule06">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;13&quot;</text></outputEntry>
        <outputEntry><text>&quot;HR metrics: turnover rate, time-to-fill, absenteeism, overtime hours, headcount vs. plan&quot;</text></outputEntry>
        <outputEntry><text>&quot;HR Head&quot;</text></outputEntry>
        <outputEntry><text>&quot;CHRO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule07">
        <inputEntry><text>&quot;Monthly (by day 10)&quot;</text></inputEntry>
        <outputEntry><text>&quot;14&quot;</text></outputEntry>
        <outputEntry><text>&quot;Management committee meeting: CFO presents consolidated results; Department Heads present functional KPIs&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO / Dept. Heads&quot;</text></outputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T04_Rule08">
        <inputEntry><text>&quot;Automated + 2 hours/month review&quot;</text></inputEntry>
        <outputEntry><text>&quot;14a&quot;</text></outputEntry>
        <outputEntry><text>&quot;Store utility consumption report: system aggregates per-store utility expense (electricity, water, internet) from non-PO invoice data (W7C); benchmarks kWh per sqm per store per month; flags stores with utility consumption &gt; 20% above peer average (same store format, same region) for investigation — potential causes include equipment malfunction (W47), HVAC inefficiency, or unauthorized usage; Store Manager receives monthly utility scorecard as part of Store Performance Scorecard (W67); Facilities Coordinator investigates flagged stores and recommends corrective action (equipment upgrade, behavioral changes)&quot;</text></outputEntry>
        <outputEntry><text>&quot;System / Facilities Coordinator&quot;</text></outputEntry>
        <outputEntry><text>&quot;VP Store Operations&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T05" name="Quarterly — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Quarterly” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T05_In01" label="Frequency">
        <inputExpression id="Decision_T05_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T05_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T05_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T05_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T05_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T05_Rule01">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;15&quot;</text></outputEntry>
        <outputEntry><text>&quot;Board pack preparation: consolidated financials, management discussion &amp; analysis, KPI scorecard, risk register update&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller + CFO&quot;</text></outputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T05_Rule02">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;16&quot;</text></outputEntry>
        <outputEntry><text>&quot;Vendor performance scorecard review (W44)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Buyer&quot;</text></outputEntry>
        <outputEntry><text>&quot;VP Merchandising&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T05_Rule03">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;17&quot;</text></outputEntry>
        <outputEntry><text>&quot;Budget revision (if material changes warranted) (W26 step 13)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T05_Rule04">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;18&quot;</text></outputEntry>
        <outputEntry><text>&quot;Document retention compliance review: Controller verifies that all document types (invoices, receipts, delivery receipts, import docs, capex records) meet 10-year BIR retention requirements; confirms expired documents are archived and accessible; flags any gaps in document attachment compliance&quot;</text></outputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T05_Rule05">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;19&quot;</text></outputEntry>
        <outputEntry><text>&quot;Credit note / debit note aging review: Chief Accountant presents summary of unapplied AP and AR credit memos &gt; 60 days; Controller reviews resolution status; material unresolved items escalated to CFO&quot;</text></outputEntry>
        <outputEntry><text>&quot;Chief Accountant / Controller&quot;</text></outputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T06" name="Ad-Hoc — Frequency">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · section “Ad-Hoc” · rule table
Source table: # | Activity | Role (R) | Role (A) | Frequency</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_T06_In01" label="Frequency">
        <inputExpression id="Decision_T06_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T06_Out01" label="#" name="Input" typeRef="string"/>
      <output id="Decision_T06_Out02" label="Activity" name="Activity" typeRef="string"/>
      <output id="Decision_T06_Out03" label="Role (R)" name="RoleR" typeRef="string"/>
      <output id="Decision_T06_Out04" label="Role (A)" name="RoleA" typeRef="string"/>
      <rule id="Decision_T06_Rule01">
        <inputEntry><text>&quot;As needed (~20/month)&quot;</text></inputEntry>
        <outputEntry><text>&quot;20&quot;</text></outputEntry>
        <outputEntry><text>&quot;Department Heads request ad-hoc reports from BI Analyst or self-service via report builder&quot;</text></outputEntry>
        <outputEntry><text>&quot;Dept. Heads / BI Analyst&quot;</text></outputEntry>
        <outputEntry><text>&quot;—&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T06_Rule02">
        <inputEntry><text>&quot;As needed&quot;</text></inputEntry>
        <outputEntry><text>&quot;21&quot;</text></outputEntry>
        <outputEntry><text>&quot;BI Analyst creates custom analyses: product affinity, customer segmentation, promotional lift analysis, geographic trends&quot;</text></outputEntry>
        <outputEntry><text>&quot;BI Analyst&quot;</text></outputEntry>
        <outputEntry><text>&quot;Requestor&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_W39_07" name="Authorization threshold — W39">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · workflow W39 · step row (authorization thresholds)
Note: 1 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Disposal request routed for approval per tier: (a) NBV ≤ PHP 50,000: Controller, (b) NBV PHP 50,001–500,000: CFO, (c) NBV &gt; PHP 500,000: CEO, (d) Land/building: Board | Approver | Approver | 15–30 min</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W39_07_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W39_07_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W39_07_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W39_07_Rule01">
        <inputEntry><text>&lt;= 50000</text></inputEntry>
        <outputEntry><text>&quot;Controller&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W39_07_Rule02">
        <inputEntry><text>[50001..500000]</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W39_07_Rule03">
        <inputEntry><text>&gt; 500000</text></inputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_W638_08" name="Authorization threshold — W638">
    <description>Source: VS-17-record-to-report/PA-17.4-fpanda-and-reporting.md · workflow W638 · step row (authorization thresholds)
Verbatim: System auto-routes JE for approval based on approval matrix: routine entries &lt; PHP 500K → Accounting Manager; entries PHP 500K–5M → Finance Manager; entries &gt; PHP 5M or top-side consolidation entries → CFO | System | Accounting Manager | Automated</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W638_08_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W638_08_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W638_08_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W638_08_Rule01">
        <inputEntry><text>&lt; 500000</text></inputEntry>
        <outputEntry><text>&quot;Accounting Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W638_08_Rule02">
        <inputEntry><text>[500000..5000000]</text></inputEntry>
        <outputEntry><text>&quot;Finance Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W638_08_Rule03">
        <inputEntry><text>&gt; 5000000</text></inputEntry>
        <outputEntry><text>&quot;CFO + Accounting Manager&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
