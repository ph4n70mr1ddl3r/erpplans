      <dmndi:DMNShape id="Decision_W2B_02_di" dmnElementRef="Decision_W2B_02">
        <dc:Bounds x="420" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W60_03_di" dmnElementRef="Decision_W60_03">
        <dc:Bounds x="680" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W62_04_di" dmnElementRef="Decision_W62_04">
        <dc:Bounds x="940" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W62B_05_di" dmnElementRef="Decision_W62B_05">
        <dc:Bounds x="160" y="220" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
