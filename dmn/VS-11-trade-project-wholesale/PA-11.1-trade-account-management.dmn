<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-11.1-trade-account-management"
             name="PA 11.1 trade account management"
             namespace="https://erpplans.local/dmn/PA-11.1-trade-account-management"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_W1394_01" name="Authorization threshold — W1394">
    <description>Source: VS-11-trade-project-wholesale/PA-11.1-trade-account-management.md · workflow W1394 · step row (authorization thresholds)
Note: 5 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Approval: tier changes and limit adjustments approved per authority matrix: (a) Tier upgrade + limit increase ≤ PHP 500K: Credit Manager approves; (b) Tier upgrade + limit increase &gt; PHP 500K: CFO approves; (c) Tier downgrade: Credit Manager approves (no escalation needed — Credit Manager has authority to tighten terms); (d) account suspension: per W1395 | Credit Manager / CFO | CFO | 5–10 min/account</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W1394_01_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W1394_01_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W1394_01_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W1394_01_Rule01">
        <inputEntry><text>&lt;= 500000</text></inputEntry>
        <outputEntry><text>&quot;Credit Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W1394_01_Rule02">
        <inputEntry><text>&gt; 500000</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_W1394_01_di" dmnElementRef="Decision_W1394_01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
