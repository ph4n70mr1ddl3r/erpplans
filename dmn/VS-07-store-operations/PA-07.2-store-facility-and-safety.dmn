<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-07.2-store-facility-and-safety"
             name="PA 07.2 store facility and safety"
             namespace="https://erpplans.local/dmn/PA-07.2-store-facility-and-safety"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Preventive Maintenance Schedule — Frequency">
    <description>Source: VS-07-store-operations/PA-07.2-store-facility-and-safety.md · section “Preventive Maintenance Schedule” · rule table
Source table: Equipment / System | Frequency | Responsible | Notes</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_T01_In01" label="Frequency">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Equipment / System" name="EquipmentSystem" typeRef="string"/>
      <output id="Decision_T01_Out02" label="Responsible" name="Responsible" typeRef="string"/>
      <output id="Decision_T01_Out03" label="Notes" name="Notes" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;Quarterly filter change; annual service&quot;</text></inputEntry>
        <outputEntry><text>&quot;HVAC units&quot;</text></outputEntry>
        <outputEntry><text>&quot;External contractor&quot;</text></outputEntry>
        <outputEntry><text>&quot;Critical for customer comfort; store sells HVAC — reputation risk if own units fail&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;Annual inspection per BFP requirement&quot;</text></inputEntry>
        <outputEntry><text>&quot;Fire suppression / extinguishers&quot;</text></outputEntry>
        <outputEntry><text>&quot;Certified inspector&quot;</text></outputEntry>
        <outputEntry><text>&quot;Regulatory compliance; non-negotiable&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;Monthly cleaning and calibration&quot;</text></inputEntry>
        <outputEntry><text>&quot;Paint mixing station&quot;</text></outputEntry>
        <outputEntry><text>&quot;Maintenance / Utility&quot;</text></outputEntry>
        <outputEntry><text>&quot;Accuracy affects customer satisfaction&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;Weekly blade inspection; monthly sharpening/replace&quot;</text></inputEntry>
        <outputEntry><text>&quot;Lumber cutting equipment&quot;</text></outputEntry>
        <outputEntry><text>&quot;Maintenance / Utility&quot;</text></outputEntry>
        <outputEntry><text>&quot;Safety-critical; dull blades are injury risk&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule05">
        <inputEntry><text>&quot;Quarterly cleaning and cable check&quot;</text></inputEntry>
        <outputEntry><text>&quot;POS terminals and peripherals&quot;</text></outputEntry>
        <outputEntry><text>&quot;IT + Maintenance&quot;</text></outputEntry>
        <outputEntry><text>&quot;Cross-reference W48&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule06">
        <inputEntry><text>&quot;Bi-annual servicing&quot;</text></inputEntry>
        <outputEntry><text>&quot;Roll-up doors / loading docks&quot;</text></outputEntry>
        <outputEntry><text>&quot;External contractor&quot;</text></outputEntry>
        <outputEntry><text>&quot;Security and receiving operations&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule07">
        <inputEntry><text>&quot;Annual inspection&quot;</text></inputEntry>
        <outputEntry><text>&quot;Electrical panel and generators (if applicable)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Licensed electrician&quot;</text></outputEntry>
        <outputEntry><text>&quot;Safety compliance&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule08">
        <inputEntry><text>&quot;Monthly treatment&quot;</text></inputEntry>
        <outputEntry><text>&quot;Pest control&quot;</text></outputEntry>
        <outputEntry><text>&quot;External contractor (pest control vendor)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Health and sanitation&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule09">
        <inputEntry><text>&quot;Per accumulation or quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Hazardous waste disposal&quot;</text></outputEntry>
        <outputEntry><text>&quot;Licensed DENR-accredited transporter&quot;</text></outputEntry>
        <outputEntry><text>&quot;Regulatory compliance (DENR/EMB)&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule10">
        <inputEntry><text>&quot;Monthly contractor maintenance; annual DOLE-accredited inspection&quot;</text></inputEntry>
        <outputEntry><text>&quot;Elevators / escalators (if applicable)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Licensed elevator contractor&quot;</text></outputEntry>
        <outputEntry><text>&quot;Regulatory compliance&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
