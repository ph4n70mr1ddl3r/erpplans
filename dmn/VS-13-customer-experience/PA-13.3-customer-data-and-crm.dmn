<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-13.3-customer-data-and-crm"
             name="PA 13.3 customer data and crm"
             namespace="https://erpplans.local/dmn/PA-13.3-customer-data-and-crm"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Measurement Methods — Frequency">
    <description>Source: VS-13-customer-experience/PA-13.3-customer-data-and-crm.md · section “Measurement Methods” · rule table
Source table: Method | Frequency | Sample | Channel</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T01_In01" label="Frequency">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Method" name="Method" typeRef="string"/>
      <output id="Decision_T01_Out02" label="Sample" name="Sample" typeRef="string"/>
      <output id="Decision_T01_Out03" label="Channel" name="Channel" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;Continuous&quot;</text></inputEntry>
        <outputEntry><text>&quot;POS receipt survey&quot;</text></outputEntry>
        <outputEntry><text>&quot;Every transaction (opt-in)&quot;</text></outputEntry>
        <outputEntry><text>&quot;QR code printed on every receipt linking to 3-question mobile survey; incentivized with 50 loyalty points per completed survey&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;Continuous&quot;</text></inputEntry>
        <outputEntry><text>&quot;Post-visit email&quot;</text></outputEntry>
        <outputEntry><text>&quot;Loyalty members who made a purchase&quot;</text></outputEntry>
        <outputEntry><text>&quot;Automated email 24 hours after purchase with 5-question NPS-style survey&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;Continuous&quot;</text></inputEntry>
        <outputEntry><text>&quot;Ecommerce post-order survey&quot;</text></outputEntry>
        <outputEntry><text>&quot;All completed ecommerce orders&quot;</text></outputEntry>
        <outputEntry><text>&quot;Automated email after delivery confirmation with product and delivery satisfaction rating&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Mystery shopping&quot;</text></outputEntry>
        <outputEntry><text>&quot;All 200 stores, 2–3 visits/store/month (per W566)&quot;</text></outputEntry>
        <outputEntry><text>&quot;External mystery shopping agency evaluates store experience against standardized checklist (greeting, product knowledge, wait time, checkout, store cleanliness)&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule05">
        <inputEntry><text>&quot;Annual&quot;</text></inputEntry>
        <outputEntry><text>&quot;Annual customer survey&quot;</text></outputEntry>
        <outputEntry><text>&quot;10,000–20,000 loyalty members&quot;</text></outputEntry>
        <outputEntry><text>&quot;Comprehensive brand perception and satisfaction survey via email/app notification&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_T02" name="Feedback Loop Tracking Dashboard — Frequency">
    <description>Source: VS-13-customer-experience/PA-13.3-customer-data-and-crm.md · section “Feedback Loop Tracking Dashboard” · rule table
Source table: Metric | Source | Frequency | Target</description>
    <decisionTable hitPolicy="C">
      <input id="Decision_T02_In01" label="Frequency">
        <inputExpression id="Decision_T02_InExpr01" typeRef="string">
          <text>Frequency</text>
        </inputExpression>
      </input>
      <output id="Decision_T02_Out01" label="Metric" name="Metric" typeRef="string"/>
      <output id="Decision_T02_Out02" label="Source" name="Source" typeRef="string"/>
      <output id="Decision_T02_Out03" label="Target" name="Target" typeRef="string"/>
      <rule id="Decision_T02_Rule01">
        <inputEntry><text>&quot;Monthly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Quick win resolution rate&quot;</text></outputEntry>
        <outputEntry><text>&quot;W87.4&quot;</text></outputEntry>
        <outputEntry><text>&quot;≥ 90% within 1-week SLA&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule02">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Process improvement implementation rate&quot;</text></outputEntry>
        <outputEntry><text>&quot;W87.7&quot;</text></outputEntry>
        <outputEntry><text>&quot;≥ 80% of approved improvements implemented on schedule&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule03">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Training completion rate for CX-targeted programs&quot;</text></outputEntry>
        <outputEntry><text>&quot;W87.8&quot;</text></outputEntry>
        <outputEntry><text>&quot;100% completion by target date&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule04">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;CSAT/NPS improvement vs. prior quarter&quot;</text></outputEntry>
        <outputEntry><text>&quot;W65&quot;</text></outputEntry>
        <outputEntry><text>&quot;Positive trend in bottom 10 stores&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule05">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Complaint reduction in top 5 root causes&quot;</text></outputEntry>
        <outputEntry><text>&quot;W41&quot;</text></outputEntry>
        <outputEntry><text>&quot;≥ 15% reduction per quarter&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T02_Rule06">
        <inputEntry><text>&quot;Quarterly&quot;</text></inputEntry>
        <outputEntry><text>&quot;Revenue at risk from unresolved feedback&quot;</text></outputEntry>
        <outputEntry><text>&quot;W87.5c&quot;</text></outputEntry>
        <outputEntry><text>&quot;Decreasing trend&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_T02_di" dmnElementRef="Decision_T02">
        <dc:Bounds x="420" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
