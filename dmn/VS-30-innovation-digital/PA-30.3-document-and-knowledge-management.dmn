<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-30.3-document-and-knowledge-management"
             name="PA 30.3 document and knowledge management"
             namespace="https://erpplans.local/dmn/PA-30.3-document-and-knowledge-management"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_W686_01" name="Authorization threshold — W686">
    <description>Source: VS-30-innovation-digital/PA-30.3-document-and-knowledge-management.md · workflow W686 · step row (authorization thresholds)
Note: 1 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Originator submits document: user creates or uploads document in ERP (contract, PO, expense report, BIR filing); system auto-classifies document type and identifies required approval chain based on DOA matrix (e.g., PO &lt;PHP 50K: Store Manager approves; PHP 50K-500K: Category Manager + Procurement Manager; &gt;PHP 500K: VP Supply Chain + CFO) | Originator | Department Head | 5 min</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W686_01_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W686_01_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W686_01_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W686_01_Rule01">
        <inputEntry><text>&lt; 50000</text></inputEntry>
        <outputEntry><text>&quot;Store Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W686_01_Rule02">
        <inputEntry><text>[50000..500000]</text></inputEntry>
        <outputEntry><text>&quot;Category Manager + Procurement Manager&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W686_01_Rule03">
        <inputEntry><text>&gt; 500000</text></inputEntry>
        <outputEntry><text>&quot;VP Supply Chain + CFO + Department Head&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_W688_02" name="Authorization threshold — W688">
    <description>Source: VS-30-innovation-digital/PA-30.3-document-and-knowledge-management.md · workflow W688 · step row (authorization thresholds)
Note: 1 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Approval &amp; execution: final contract routed for approval per DOA matrix per W686: contract value &lt;PHP 1M: Department Head + Legal Counsel; PHP 1M-10M: VP + CFO; &gt;PHP 10M: CEO + Board resolution per W243; executed via digital signature per W686 or wet-ink notarization if required by law (Philippine notarization required for real property leases &gt;1 year, government contracts above threshold) | Legal Counsel | VP Legal / CEO | 1-3 days</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W688_02_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W688_02_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W688_02_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W688_02_Rule01">
        <inputEntry><text>&lt; 1000000</text></inputEntry>
        <outputEntry><text>&quot;Department Head&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W688_02_Rule02">
        <inputEntry><text>[1000000..10000000]</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W688_02_Rule03">
        <inputEntry><text>&gt; 10000000</text></inputEntry>
        <outputEntry><text>&quot;CEO + Board&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_W686_01_di" dmnElementRef="Decision_W686_01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W688_02_di" dmnElementRef="Decision_W688_02">
        <dc:Bounds x="420" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
