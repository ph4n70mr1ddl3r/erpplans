<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-02.3-supply-chain-orchestration-and-risk"
             name="PA 02.3 supply chain orchestration and risk"
             namespace="https://erpplans.local/dmn/PA-02.3-supply-chain-orchestration-and-risk"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_W1436_01" name="Authorization threshold — W1436">
    <description>Source: VS-02-supply-planning/PA-02.3-supply-chain-orchestration-and-risk.md · workflow W1436 · step row (authorization thresholds)
Note: 3 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Forward buy authorization: For recommended forward buys: (a) Category Manager calculates forward buy quantity (3–6 months supply for A-items expected to spike), (b) Finance Controller evaluates working capital impact and storage capacity at DCs, (c) VP Merchandising approves forward buy up to PHP 10M; CFO approves PHP 10–50M; CEO approves &gt; PHP 50M, (d) Purchasing Manager issues forward buy PO with negotiated price lock | Category Manager / Finance Controller | VP Merchandising / CFO | 2 hours</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W1436_01_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W1436_01_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W1436_01_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W1436_01_Rule01">
        <inputEntry><text>&lt;= 10000000</text></inputEntry>
        <outputEntry><text>&quot;VP Merchandising&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W1436_01_Rule02">
        <inputEntry><text>(10000000..50000000]</text></inputEntry>
        <outputEntry><text>&quot;CFO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W1436_01_Rule03">
        <inputEntry><text>&gt; 50000000</text></inputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_W1436_01_di" dmnElementRef="Decision_W1436_01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
