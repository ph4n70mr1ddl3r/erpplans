<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="https://www.omg.org/spec/DMN/20181101/DC/"
             xmlns:di="https://www.omg.org/spec/DMN/20181101/DI/"
             id="Definitions_PA-09.1-custom-fabrication-and-processing"
             name="PA 09.1 custom fabrication and processing"
             namespace="https://erpplans.local/dmn/PA-09.1-custom-fabrication-and-processing"
             exporter="erpplans generate-dmn.py" exporterVersion="1.0">
  <decision id="Decision_T01" name="Loyalty Program Economics — Value">
    <description>Source: VS-09-in-store-services/PA-09.1-custom-fabrication-and-processing.md · section “Loyalty Program Economics” · rule table
Source table: Parameter | Value | Notes</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_T01_In01" label="Value">
        <inputExpression id="Decision_T01_InExpr01" typeRef="string">
          <text>Value</text>
        </inputExpression>
      </input>
      <output id="Decision_T01_Out01" label="Parameter" name="Parameter" typeRef="string"/>
      <output id="Decision_T01_Out02" label="Notes" name="Notes" typeRef="string"/>
      <rule id="Decision_T01_Rule01">
        <inputEntry><text>&quot;1 point per PHP 100 spent&quot;</text></inputEntry>
        <outputEntry><text>&quot;Earn rate&quot;</text></outputEntry>
        <outputEntry><text>&quot;Applied to transaction value after discounts, before VAT&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule02">
        <inputEntry><text>&quot;PHP 1.00 per point&quot;</text></inputEntry>
        <outputEntry><text>&quot;Redemption value&quot;</text></outputEntry>
        <outputEntry><text>&quot;Each point can be redeemed for PHP 1.00 discount at checkout&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule03">
        <inputEntry><text>&quot;1% of qualifying transaction value&quot;</text></inputEntry>
        <outputEntry><text>&quot;Face value of points&quot;</text></outputEntry>
        <outputEntry><text>&quot;Face value = (1 point × PHP 1.00) ÷ PHP 100 = 1% of spend&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule04">
        <inputEntry><text>&quot;~0.75–0.85% of qualifying transaction value&quot;</text></inputEntry>
        <outputEntry><text>&quot;PFRS 15 deferred revenue allocation&quot;</text></outputEntry>
        <outputEntry><text>&quot;Standalone selling price allocation = face value (1%) × expected redemption rate (~75–85%); this is the actual amount allocated to deferred revenue at POS earning; the ~1.0% face value is NOT the PFRS 15 allocation rate — the allocation rate is lower because ~15–25% of points are expected to expire unredeemed (breakage) and are excluded from the standalone selling price of the points&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule05">
        <inputEntry><text>&quot;~29M points (PHP ~2.9B qualifying loyalty-earning revenue ÷ PHP 100; ≈343M/year per W1316)&quot;</text></inputEntry>
        <outputEntry><text>&quot;Estimated monthly points earned&quot;</text></outputEntry>
        <outputEntry><text>&quot;Before breakage adjustment&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule06">
        <inputEntry><text>&quot;~PHP 22–25M/month (PHP ~2.9B qualifying loyalty-earning revenue × ~0.75–0.85% allocation, consistent with the points row above)&quot;</text></inputEntry>
        <outputEntry><text>&quot;Estimated monthly deferred revenue allocation (PFRS 15)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Monthly flow: new deferred revenue from points earned; recognized proportionally at redemption or as breakage at expiry&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule07">
        <inputEntry><text>&quot;~PHP 150–600M (outstanding unredeemed points × PHP 1.00 × expected redemption rate ~75–85%, net of redemptions within the 24-month expiry window)&quot;</text></inputEntry>
        <outputEntry><text>&quot;Estimated cumulative loyalty points liability (balance sheet)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Cumulative stock: outstanding points not yet redeemed or expired; reconciled monthly by Cost Accountant per W17.11a&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule08">
        <inputEntry><text>&quot;Recognized at 24-month expiry per W17.11&quot;</text></inputEntry>
        <outputEntry><text>&quot;Breakage (unredeemed expired points)&quot;</text></outputEntry>
        <outputEntry><text>&quot;Historically ~15–25% of points expire unredeemed&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_T01_Rule09">
        <inputEntry><text>&quot;Bronze: 0–PHP 50K/year; Silver: PHP 50K–150K; Gold: PHP 150K–300K; Platinum: &gt; PHP 300K&quot;</text></inputEntry>
        <outputEntry><text>&quot;Tier upgrade thresholds&quot;</text></outputEntry>
        <outputEntry><text>&quot;Based on trailing 12-month spend&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Decision_W960_02" name="Authorization threshold — W960">
    <description>Source: VS-09-in-store-services/PA-09.1-custom-fabrication-and-processing.md · workflow W960 · step row (authorization thresholds)
Note: 8 non-monetary tier(s) in the source list are excluded from this amount-based table.
Verbatim: Working Capital Approval &amp; Procurement: (a) Finance reviews buffer stock investment: total buffer value, incremental carrying cost, and cash flow impact per W233; (b) tiered approval: (i) buffer value ≤ PHP 20M → VP Supply Chain approves; (ii) PHP 20–50M → COO approves; (iii) &gt; PHP 50M → CEO approves; (c) Procurement executes seasonal buy orders per W2: (i) import orders (45–90 day lead time) placed 3–4 months before season; (ii) local orders placed 4–6 weeks before season; (iii) blanket PO releases (W2C) for guaranteed sellers with vendor volume commitment; (d) vendor delivery scheduled to arrive at DC 2–4 weeks before projected demand start | Finance / Procurement | COO / CEO | 4–8 hours…</description>
    <decisionTable hitPolicy="U">
      <input id="Decision_W960_02_In01" label="Amount (PHP)">
        <inputExpression id="Decision_W960_02_InExpr01" typeRef="number">
          <text>Amount</text>
        </inputExpression>
      </input>
      <output id="Decision_W960_02_Out01" label="Approver" name="Approver" typeRef="string"/>
      <rule id="Decision_W960_02_Rule01">
        <inputEntry><text>&lt;= 20000000</text></inputEntry>
        <outputEntry><text>&quot;VP Supply Chain&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W960_02_Rule02">
        <inputEntry><text>(20000000..50000000]</text></inputEntry>
        <outputEntry><text>&quot;COO&quot;</text></outputEntry>
      </rule>
      <rule id="Decision_W960_02_Rule03">
        <inputEntry><text>&gt; 50000000</text></inputEntry>
        <outputEntry><text>&quot;CEO&quot;</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="Diagram_1">
      <dmndi:DMNShape id="Decision_T01_di" dmnElementRef="Decision_T01">
        <dc:Bounds x="160" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="Decision_W960_02_di" dmnElementRef="Decision_W960_02">
        <dc:Bounds x="420" y="80" width="200" height="90"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
